+(ns logseq.db-sync.worker.graph-insights
+  "Read-only aggregations behind the semantic API's getPageBacklinks, getGraphHealth and
+  listKnowledgeIndex: how a page is used, grouped by relation; graph-health checks; and the
+  pages of a knowledge-base index. Every function takes an immutable db and returns entities;
+  the semantic handler shapes the responses.
+
+  These read the whole graph, so filters read datoms rather than entity attributes: an
+  entity lookup costs tens of microseconds, which adds up to seconds over a few thousand
+  pages and their blocks."
+  (:require [clojure.string :as string]
+            [datascript.core :as d]
+            [logseq.db.frontend.class :as db-class]))
+
+(def default-summary-prefix
+  "A page's summary is its first top-level block when that block starts with this text."
+  "**Summary:**")
+
+(defn- attr-value
+  "The value of a cardinality-one attribute, from its datom."
+  [db e attr]
+  (:v (first (d/datoms db :eavt e attr))))
+
+(defn stored-title
+  "The title as stored, with links as [[uuid]]."
+  [db e]
+  (attr-value db e :block/title))
+
+(defn- hidden-id?
+  "As entity-util/hidden?: the entity or one of its parents is hidden or in the recycle bin."
+  [db e]
+  (loop [e e
+         seen #{}]
+    (cond
+      (or (nil? e) (contains? seen e)) false
+      (or (attr-value db e :logseq.property/hide?) (attr-value db e :logseq.property/deleted-at)) true
+      :else (recur (attr-value db e :block/parent) (conj seen e)))))
+
+(defn- visible-ids [db datoms]
+  (->> datoms (map :e) (remove #(hidden-id? db %))))
+
+(defn- tagged-ids [db class-ident]
+  (visible-ids db (d/datoms db :avet :block/tags (d/entid db class-ident))))
+
+(defn- built-in-id? [db e]
+  (true? (attr-value db e :logseq.property/built-in?)))
+
+(defn- entities [db ids]
+  (map #(d/entity db %) ids))
+
+;; Usage of a page
+;; ===============
+
+(defn ref-property-idents
+  "Visible properties whose values reference entities, so a value can be a page. Tags are
+  their own relation."
+  [db]
+  (->> (tagged-ids db :logseq.class/Property)
+       (keep #(attr-value db % :db/ident))
+       (filter #(= :db.type/ref (get-in (:schema db) [% :db/valueType])))
+       (remove #{:block/tags})
+       vec))
+
+(defn- value-block-property
+  "The property a block stores one text value of; such a block belongs to its parent."
+  [db e]
+  (when-not (attr-value db e :block/closed-value-property)
+    (attr-value db e :logseq.property/created-from-property)))
+
+(defn page-usage
+  "How `page` is used, by relation:
+  - :references  blocks and pages whose own text links it as [[page]];
+  - :tagged      entities tagged with it (only classes have them);
+  - :property-values  {:property :holder} pairs where a property of the holder has the page as
+                 its value, or a text value that links it;
+  - :other       entities Logseq records as referencing it for another reason, such as using it
+                 as a property key or a date property pointing at a journal.
+  :total counts distinct entities across all relations. `ref-properties` is `ref-property-idents`."
+  [db page ref-properties]
+  (let [page-id (:db/id page)
+        ;; A `#[[uuid]]` inline tag is a tag, not a text link.
+        link-re (re-pattern (str "(?:^|[^#])\\[\\[" (:block/uuid page) "\\]\\]"))
+        links? #(some->> (stored-title db %) (re-find link-re))
+        ref-ids (visible-ids db (d/datoms db :avet :block/refs page-id))
+        tagged (visible-ids db (d/datoms db :avet :block/tags page-id))
+        direct-values (for [ident ref-properties
+                            holder (visible-ids db (d/datoms db :avet ident page-id))]
+                        [(d/entid db ident) holder])
+        text-value? #(and (value-block-property db %) (links? %))
+        text-values (for [block ref-ids
+                          :when (text-value? block)
+                          :let [holder (attr-value db block :block/parent)]
+                          :when (not (hidden-id? db holder))]
+                      [(value-block-property db block) holder])
+        property-values (distinct (concat direct-values text-values))
+        references (filter #(and (not (value-block-property db %)) (links? %)) ref-ids)
+        explained (into #{} (concat references tagged (map second property-values)))
+        other (remove #(or (contains? explained %) (text-value? %)) ref-ids)]
+    {:references (entities db references)
+     :tagged (entities db tagged)
+     :property-values (map (fn [[property holder]] {:property (d/entity db property) :holder (d/entity db holder)})
+                           property-values)
+     :other (entities db other)
+     :total (count (into explained other))}))
+
+;; Pages, classes and summaries
+;; ============================
+
+(defn- user-page-ids
+  "Non-journal pages people wrote: no built-in pages and no author pages the server creates."
+  [db]
+  (->> (tagged-ids db :logseq.class/Page)
+       (remove #(built-in-id? db %))
+       (remove #(attr-value db % :logseq.property.user/name))))
+
+(defn user-pages [db]
+  (entities db (user-page-ids db)))
+
+(defn first-top-level-block
+  "The page's first top-level block by order, as an entity id. Property value blocks and child
+  pages (which have no :block/page) are not part of the page's body."
+  [db page]
+  (->> (d/datoms db :avet :block/parent (:db/id page))
+       (map (fn [{:keys [e]}] [(attr-value db e :block/order) e]))
+       (sort-by first)
+       (some (fn [[_ e]]
+               (when (and (attr-value db e :block/page)
+                          (nil? (attr-value db e :logseq.property/created-from-property))
+                          (not (hidden-id? db e)))
+                 e)))))
+
+(defn- summary-block
+  "The page's first top-level block when its text starts with `prefix` and goes on after it."
+  [db page prefix]
+  (when-let [block (first-top-level-block db page)]
+    (let [text (or (stored-title db block) "")]
+      (when (and (string/starts-with? text prefix)
+                 (not (string/blank? (subs text (count prefix)))))
+        block))))
+
+(defn page-summary
+  "The text after `prefix` in the page's first top-level block, with links shown as titles; nil
+  when that block does not start with `prefix` or has nothing after it."
+  [db page prefix]
+  (when-let [block (summary-block db page prefix)]
+    (let [title (:block/title (d/entity db block))]
+      (string/trim (if (string/starts-with? title prefix) (subs title (count prefix)) title)))))
+
+(def ^:private structural-classes #{:logseq.class/Page :logseq.class/Root})
+
+(defn- page-tag-ids
+  "The page's tags other than the Page class every page has."
+  [db page]
+  (let [structural (set (map #(d/entid db %) structural-classes))]
+    (->> (d/datoms db :eavt (:db/id page) :block/tags)
+         (map :v)
+         (remove structural)
+         sort)))
+
+(defn page-tags [db page]
+  (entities db (page-tag-ids db page)))
+
+(defn class-lineage-fn
+  "A function from a class id to the class followed by every class it extends, without Page and
+  Root Tag. Memoized: build one per request."
+  [db]
+  (memoize (fn [class-id]
+             (let [class (d/entity db class-id)]
+               (->> (cons class (db-class/get-class-extends class))
+                    (remove #(contains? structural-classes (:db/ident %)))
+                    (distinct)
+                    vec)))))
+
+(defn page-classes
+  "The page's tags, each followed by the classes it extends."
+  [db lineage page]
+  (distinct (mapcat lineage (page-tag-ids db page))))
+
+(defn knowledge-index-pages
+  "User pages for the knowledge index: none tagged with, or with a tag extending, a class whose
+  title is in `excluded-titles` (lower-case)."
+  [db lineage excluded-titles]
+  (remove (fn [page]
+            (some #(contains? excluded-titles (string/lower-case (:block/title %)))
+                  (page-classes db lineage page)))
+          (user-pages db)))
+
+;; Health checks
+;; =============
+
+(defn orphan-tags
+  "User classes nothing is tagged with and no class extends."
+  [db]
+  (->> (tagged-ids db :logseq.class/Tag)
+       (remove #(built-in-id? db %))
+       (remove (fn [class-id]
+                 (or (seq (visible-ids db (d/datoms db :avet :block/tags class-id)))
+                     (seq (visible-ids db (d/datoms db :avet :logseq.property.class/extends class-id))))))
+       (entities db)))
+
+(defn orphan-properties
+  "User properties no entity has a value for."
+  [db]
+  (->> (tagged-ids db :logseq.class/Property)
+       (remove #(built-in-id? db %))
+       (filter #(empty? (d/datoms db :aevt (attr-value db % :db/ident))))
+       (entities db)))
+
+(defn duplicate-titles
+  "Pages, journals, tags and properties whose stored titles are equal ignoring case, as groups of
+  two or more entities. Groups made only of built-in entities are left out."
+  [db]
+  (->> [:logseq.class/Page :logseq.class/Journal :logseq.class/Tag :logseq.class/Property]
+       (mapcat #(tagged-ids db %))
+       (distinct)
+       (group-by #(string/lower-case (or (stored-title db %) "")))
+       (vals)
+       (filter #(and (> (count %) 1) (not-every? (fn [e] (built-in-id? db e)) %)))
+       (map #(entities db (sort %)))))
+
+(defn pages-without-summary [db prefix]
+  (remove #(summary-block db % prefix) (user-pages db)))
+
+(defn pages-without-tags [db]
+  (filter #(empty? (page-tag-ids db %)) (user-pages db)))
