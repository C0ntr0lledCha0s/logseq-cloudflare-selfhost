+(ns logseq.db-sync.semantic-index-health-test
+  (:require ["better-sqlite3" :as sqlite3]
+            [cljs.test :refer [async deftest is]]
+            [clojure.string :as string]
+            [datascript.core :as d]
+            [logseq.db-sync.storage :as storage]
+            [logseq.db-sync.worker.handler.sync :as sync-handler]
+            [logseq.db-sync.worker.routes.semantic :as semantic-routes]
+            [logseq.db.sqlite.build :as sqlite-build]
+            [logseq.db.sqlite.export :as sqlite-export]
+            [logseq.outliner.pipeline :as outliner-pipeline]
+            [promesa.core :as p]))
+
+(def sqlite (if (find-ns 'nbb.core) (aget sqlite3 "default") sqlite3))
+
+(defn- select-sql? [sql]
+  (string/starts-with? (-> sql string/trim string/lower-case) "select"))
+
+(defn- with-memory-sql-async [f]
+  (let [db (new sqlite ":memory:" nil)
+        sql #js {:_db db
+                 :transaction (fn [f] ((.transaction db f)))
+                 :exec (fn [sql-str & args]
+                         (let [^js stmt (.prepare db sql-str)]
+                           (if (select-sql? sql-str)
+                             (.apply (.-all stmt) stmt (to-array args))
+                             (do (.apply (.-run stmt) stmt (to-array args)) nil))))
+                 :close (fn [] (.close db))}]
+    (-> (f sql)
+        (p/finally #(.close sql)))))
+
+(defn- semantic-json-request [path method body]
+  (js/Request. (str "http://localhost" path)
+               (clj->js (cond-> {:method method
+                                 :headers {"content-type" "application/json"}}
+                          body (assoc :body (js/JSON.stringify (clj->js body)))))))
+
+(defn- json-body [response]
+  (p/let [text (.text response)]
+    (js->clj (js/JSON.parse text) :keywordize-keys true)))
+
+(defn- rebuild-refs!
+  "Gives every block the :block/refs Logseq's pipeline would: text links, tags and property values."
+  [conn]
+  (let [db @conn
+        refs-fn (outliner-pipeline/db-rebuild-block-refs-fn db)]
+    (d/transact! conn (->> (d/datoms db :avet :block/uuid)
+                           (keep (fn [datom]
+                                   (let [refs (refs-fn (d/entity db (:e datom)))]
+                                     (when (seq refs) {:db/id (:e datom) :block/refs refs}))))
+                           vec))))
+
+(def ^:private ids
+  {:acme (random-uuid) :roadmap (random-uuid) :meeting (random-uuid) :notes (random-uuid)
+   :secret (random-uuid) :project-page (random-uuid)
+   :roadmap-summary (random-uuid) :meeting-block (random-uuid)})
+
+(defn- seeded-graph
+  "Acme (a Company, which extends Organization) is linked from Roadmap's summary and a Meeting
+  block, is Roadmap's client, and is mentioned in Notes page's text property value."
+  []
+  (let [conn (sqlite-export/create-conn)
+        {:keys [acme roadmap meeting notes secret project-page roadmap-summary meeting-block]} ids
+        {:keys [init-tx block-props-tx]}
+        (sqlite-build/build-blocks-tx
+         {:properties {:user.property/client {:logseq.property/type :node}
+                       :user.property/notes {:logseq.property/type :default}
+                       :user.property/unused {:logseq.property/type :default}}
+          :classes {:user.class/Organization {}
+                    :user.class/Company {:build/class-extends [:user.class/Organization]}
+                    :user.class/Project {}
+                    :user.class/Private {}
+                    :user.class/Dormant {}}
+          :pages-and-blocks
+          [{:page {:block/title "Acme" :block/uuid acme :build/keep-uuid? true
+                   :build/tags [:user.class/Company]}
+            :blocks [{:block/title "**Summary:** A client."}
+                     {:block/title "Second block"}]}
+           {:page {:block/title "Roadmap" :block/uuid roadmap :build/keep-uuid? true
+                   :build/tags [:user.class/Project]
+                   :build/properties {:user.property/client [:block/uuid acme]}}
+            :blocks [{:block/title (str "**Summary:** Plan for [[" acme "]].")
+                      :block/uuid roadmap-summary :build/keep-uuid? true}]}
+           {:page {:block/title "Meeting" :block/uuid meeting :build/keep-uuid? true}
+            :blocks [{:block/title (str "Discussed [[" acme "]]")
+                      :block/uuid meeting-block :build/keep-uuid? true}]}
+           {:page {:block/title "Notes page" :block/uuid notes :build/keep-uuid? true
+                   :build/properties {:user.property/notes (str "about [[" acme "]]")}}
+            :blocks [{:block/title "No summary here"}]}
+           {:page {:block/title "Secret" :block/uuid secret :build/keep-uuid? true
+                   :build/tags [:user.class/Private]}
+            :blocks [{:block/title "**Summary:** Not for the index."}]}
+           {:page {:block/title "Project" :block/uuid project-page :build/keep-uuid? true}}
+           {:page {:build/journal 20261104}
+            :blocks [{:block/title (str "Journal note on [[" acme "]]")}]}]})]
+    (d/transact! conn init-tx)
+    (d/transact! conn block-props-tx)
+    (rebuild-refs! conn)
+    conn))
+
+(defn- run-requests [sql conn paths]
+  (storage/init-schema! sql)
+  (let [self #js {:sql sql :conn conn :schema-ready true}]
+    (p/all (map (fn [path]
+                  (p/let [response (sync-handler/handle-http self (semantic-json-request path "GET" nil))
+                          body (json-body response)]
+                    {:status (.-status response) :body body}))
+                paths))))
+
+(defn- titles [items] (set (map :title items)))
+
+(deftest semantic-page-backlinks-group-references-by-relation-test
+  (async done
+         (with-memory-sql-async
+           (fn [sql]
+             (let [conn (seeded-graph)
+                   company-id (:block/uuid (d/entity @conn :user.class/Company))
+                   {:keys [acme roadmap notes roadmap-summary meeting-block]} ids]
+               (-> (p/let [[acme-response company-response limited not-found]
+                           (run-requests sql conn
+                                         [(str "/semantic/pages/" acme "/backlinks?graph-id=graph-1")
+                                          (str "/semantic/pages/" company-id "/backlinks?graph-id=graph-1")
+                                          (str "/semantic/pages/" acme "/backlinks?graph-id=graph-1&limit=1")
+                                          (str "/semantic/pages/" (random-uuid) "/backlinks?graph-id=graph-1")])
+                           body (:body acme-response)]
+                     (is (= 200 (:status acme-response)))
+                     (is (= {:uuid (str acme) :kind "page" :title "Acme"}
+                            (select-keys (:page body) [:uuid :kind :title])))
+                     (is (= 3 (get-in body [:references :count])) "summary block, meeting block, journal block")
+                     (is (contains? (set (map :uuid (get-in body [:references :items]))) (str roadmap-summary)))
+                     (is (contains? (set (map :uuid (get-in body [:references :items]))) (str meeting-block)))
+                     (is (= "Meeting" (:page-title (first (filter #(= (str meeting-block) (:uuid %))
+                                                                  (get-in body [:references :items]))))))
+                     (is (= 0 (get-in body [:tagged :count])))
+                     (is (= 2 (get-in body [:property-values :count])))
+                     (is (= #{[(str roadmap) "user.property/client"] [(str notes) "user.property/notes"]}
+                            (set (map (juxt :uuid (comp :ident :property)) (get-in body [:property-values :items]))))
+                         "a text property value that links the page counts for the page that holds it")
+                     (is (= 5 (:total body)))
+                     (is (= ["Acme"] (map :title (get-in company-response [:body :tagged :items]))))
+                     (is (= 1 (get-in company-response [:body :tagged :count])))
+                     (is (= 1 (count (get-in limited [:body :references :items]))))
+                     (is (= 3 (get-in limited [:body :references :count])) "counts stay complete under a limit")
+                     (is (= 404 (:status not-found))))
+                   (p/then (fn [] (done)))
+                   (p/catch (fn [error] (is false (str error)) (done)))))))))
+
+(deftest semantic-graph-health-reports-orphans-duplicates-and-page-gaps-test
+  (async done
+         (with-memory-sql-async
+           (fn [sql]
+             (let [conn (seeded-graph)]
+               (-> (p/let [[all first-page bad-check bad-cursor e2ee recent blank-prefix]
+                           (run-requests sql conn
+                                         ["/semantic/health?graph-id=graph-1"
+                                          "/semantic/health?graph-id=graph-1&checks=pages-without-summary&limit=2"
+                                          "/semantic/health?graph-id=graph-1&checks=orphan-tags,bogus"
+                                          "/semantic/health?graph-id=graph-1&checks=orphan-tags,orphan-properties&cursor=abc"
+                                          "/semantic/health?graph-id=graph-1&graph-e2ee=true"
+                                          (str "/semantic/health?graph-id=graph-1&checks=pages-without-tags&updated-after="
+                                               (+ (js/Date.now) 60000))
+                                          "/semantic/health?graph-id=graph-1&summary-prefix="])
+                           cursor (get-in first-page [:body :checks :pages-without-summary :next-cursor])
+                           [second-page] (run-requests sql conn
+                                                       [(str "/semantic/health?graph-id=graph-1&checks=pages-without-summary&limit=2&cursor="
+                                                             (js/encodeURIComponent cursor))])
+                           checks (get-in all [:body :checks])]
+                     (is (= 200 (:status all)))
+                     (is (= #{:orphan-tags :orphan-properties :duplicate-titles :pages-without-summary :pages-without-tags}
+                            (set (keys checks))))
+                     (is (= #{"Dormant"} (titles (get-in checks [:orphan-tags :items])))
+                         "classes with holders or subclasses are not orphans; built-in classes are left out")
+                     (is (= ["user.property/unused"] (map :ident (get-in checks [:orphan-properties :items]))))
+                     (is (= 1 (get-in checks [:duplicate-titles :count])))
+                     (is (= "project" (string/lower-case (:title (first (get-in checks [:duplicate-titles :items]))))))
+                     (is (= #{"page" "tag"} (set (map :kind (:entities (first (get-in checks [:duplicate-titles :items])))))))
+                     (is (= #{"Meeting" "Notes page" "Project"} (titles (get-in checks [:pages-without-summary :items])))
+                         "journals, tagged-private pages with a summary and property value blocks do not count")
+                     (is (= 3 (get-in checks [:pages-without-summary :count])))
+                     (is (= #{"Meeting" "Notes page" "Project"} (titles (get-in checks [:pages-without-tags :items]))))
+                     (is (= ["Meeting" "Notes page"] (map :title (get-in first-page [:body :checks :pages-without-summary :items]))))
+                     (is (= [:pages-without-summary] (keys (get-in first-page [:body :checks]))))
+                     (is (string? cursor))
+                     (is (= ["Project"] (map :title (get-in second-page [:body :checks :pages-without-summary :items]))))
+                     (is (nil? (get-in second-page [:body :checks :pages-without-summary :next-cursor])))
+                     (is (= 0 (get-in recent [:body :checks :pages-without-tags :count])) "updated-after narrows page checks")
+                     (is (= [400 400 409 400] (map :status [bad-check bad-cursor e2ee blank-prefix]))))
+                   (p/then (fn [] (done)))
+                   (p/catch (fn [error] (is false (str error)) (done)))))))))
+
+(deftest semantic-knowledge-index-lists-summarised-pages-test
+  (async done
+         (with-memory-sql-async
+           (fn [sql]
+             (let [conn (seeded-graph)
+                   {:keys [acme]} ids]
+               (-> (p/let [[index unfiltered first-page e2ee]
+                           (run-requests sql conn
+                                         ["/semantic/knowledge-index?graph-id=graph-1&exclude-tags=private&limit=200"
+                                          "/semantic/knowledge-index?graph-id=graph-1&limit=200"
+                                          "/semantic/knowledge-index?graph-id=graph-1&exclude-tags=Private&limit=2"
+                                          "/semantic/knowledge-index?graph-id=graph-1&graph-e2ee=true"])
+                           cursor (get-in first-page [:body :next-cursor])
+                           [second-page] (run-requests sql conn
+                                                       [(str "/semantic/knowledge-index?graph-id=graph-1&exclude-tags=Private&limit=2&cursor="
+                                                             (js/encodeURIComponent cursor))])
+                           pages (get-in index [:body :pages])
+                           by-title (into {} (map (juxt :title identity)) pages)
+                           entry (get by-title "Acme")]
+                     (is (= 200 (:status index)))
+                     (is (= ["Acme" "Meeting" "Notes page" "Project" "Roadmap"] (map :title pages))
+                         "journals, built-in pages and pages tagged with an excluded tag are left out")
+                     (is (contains? (titles (get-in unfiltered [:body :pages])) "Secret"))
+                     (is (= (str acme) (:uuid entry)))
+                     (is (= ["Company"] (map :title (:tags entry))))
+                     (is (= ["Company" "Organization"] (:classes entry)) "a class's ancestors follow its own title")
+                     (is (= "A client." (:summary entry)))
+                     (is (= "Plan for [[Acme]]." (:summary (get by-title "Roadmap"))) "summaries show links as titles")
+                     (is (not (contains? (get by-title "Meeting") :summary)))
+                     (is (= 5 (:reference-count entry)))
+                     (is (number? (:updated-at entry)))
+                     (is (= ["Acme" "Meeting"] (map :title (get-in first-page [:body :pages]))))
+                     (is (= ["Notes page" "Project"] (map :title (get-in second-page [:body :pages]))))
+                     (is (= 409 (:status e2ee))))
+                   (p/then (fn [] (done)))
+                   (p/catch (fn [error] (is false (str error)) (done)))))))))
+
+(deftest semantic-insight-operations-are-documented-read-routes-test
+  (let [paths (:paths (semantic-routes/openapi-document "https://issuer.example"))
+        operation (fn [path] (get-in paths [path :get]))
+        parameter-names (fn [path] (set (map :name (:parameters (operation path)))))]
+    (is (= "getPageBacklinks" (:operationId (operation "/api/v1/graphs/{graph-id}/pages/{page-id}/backlinks"))))
+    (is (= #{"graph-id" "page-id" "limit"} (parameter-names "/api/v1/graphs/{graph-id}/pages/{page-id}/backlinks")))
+    (is (= "getGraphHealth" (:operationId (operation "/api/v1/graphs/{graph-id}/health"))))
+    (is (= #{"graph-id" "checks" "limit" "cursor" "summary-prefix" "created-after" "updated-after"}
+           (parameter-names "/api/v1/graphs/{graph-id}/health")))
+    (is (= "listKnowledgeIndex" (:operationId (operation "/api/v1/graphs/{graph-id}/knowledge-index"))))
+    (is (= #{"graph-id" "limit" "cursor" "exclude-tags" "summary-prefix"}
+           (parameter-names "/api/v1/graphs/{graph-id}/knowledge-index")))
+    (is (every? #(= [{:oauth ["logseq/read"]}] (:security (operation %)))
+                ["/api/v1/graphs/{graph-id}/pages/{page-id}/backlinks"
+                 "/api/v1/graphs/{graph-id}/health"
+                 "/api/v1/graphs/{graph-id}/knowledge-index"]))
+    (is (= {:method "GET" :handler :semantic/knowledge-index}
+           (select-keys (semantic-routes/match-internal "GET" "/semantic/knowledge-index") [:method :handler])))))
