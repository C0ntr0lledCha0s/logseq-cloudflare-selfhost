+;; getPageBacklinks, getGraphHealth and listKnowledgeIndex read the whole graph through
+;; graph-insights. They read titles and text, so they refuse E2EE graphs like getPageOutline.
+
+(defn- page-ref-response [page]
+  (cond-> {:uuid (uuid-string (:block/uuid page))
+           :kind (block-kind page)
+           :title (:block/title page)}
+    (:block/updated-at page) (assoc :updated-at (:block/updated-at page))))
+
+(defn- holder-response [entity]
+  (cond-> (select-keys (block-response entity) [:uuid :kind :title :page-id])
+    (:block/page entity) (assoc :page-title (:block/title (:block/page entity)))))
+
+(defn- recent-first
+  "Most recently updated first. Each key is read once, not on every comparison."
+  ([entities] (recent-first identity entities))
+  ([entity-fn items]
+   (->> items
+        (map (fn [item]
+               (let [entity (entity-fn item)]
+                 [[(- (or (:block/updated-at entity) 0)) (- (:db/id entity))] item])))
+        (sort-by first)
+        (map second))))
+
+(defn- usage-group [entities limit response-fn]
+  {:count (count entities)
+   :items (mapv response-fn (take limit entities))})
+
+(defn- page-backlinks-response [db page limit]
+  (let [{:keys [references tagged property-values other total]}
+        (graph-insights/page-usage db page (graph-insights/ref-property-idents db))]
+    {:page (page-ref-response page)
+     :total total
+     :references (usage-group (recent-first references) limit holder-response)
+     :tagged (usage-group (recent-first tagged) limit holder-response)
+     :property-values (usage-group (recent-first :holder property-values)
+                                   limit
+                                   (fn [{:keys [property holder]}]
+                                     (assoc (holder-response holder)
+                                            :property {:uuid (uuid-string (:block/uuid property))
+                                                       :ident (entity-ident property)
+                                                       :title (:block/title property)})))
+     :other (usage-group (recent-first other) limit holder-response)}))
+
+(defn- title-key [db entity]
+  [(string/lower-case (or (graph-insights/stored-title db (:db/id entity)) "")) (uuid-string (:block/uuid entity))])
+
+(defn- paginate-by
+  "One page of `items` in `key-fn` order after `cursor`, a key-fn value. Each key is computed
+  once: a title read renders its links, which is too slow to repeat inside a sort."
+  [key-fn items limit cursor]
+  (let [keyed (sort-by first (map (juxt key-fn identity) items))
+        remaining (cond->> keyed
+                    cursor (drop-while #(not (pos? (compare (first %) cursor)))))
+        selected (vec (take (inc limit) remaining))
+        page (vec (take limit selected))]
+    (cond-> {:items (mapv second page) :count (count keyed)}
+      (> (count selected) limit) (assoc :next-cursor (encode-cursor (first (last page)))))))
+
+(def ^:private health-checks
+  ["orphan-tags" "orphan-properties" "duplicate-titles" "pages-without-summary" "pages-without-tags"])
+
+(defn- comma-list [^js url param]
+  (let [raw (.get (.-searchParams url) param)]
+    (when (seq raw) (vec (distinct (string/split raw #","))))))
+
+(defn- health-check [db check {:keys [prefix time-filters limit cursor]}]
+  (let [by-title (fn [entities] (paginate-by (partial title-key db) entities limit cursor))
+        pages-check (fn [pages]
+                      (update (by-title (filter #(after-time-filters? % time-filters) pages))
+                              :items #(mapv page-ref-response %)))
+        duplicate-key (fn [group] [(string/lower-case (or (:block/title (first group)) "")) ""])]
+    (case check
+      "orphan-tags" (update (by-title (graph-insights/orphan-tags db)) :items #(mapv tag-response %))
+      "orphan-properties" (update (by-title (graph-insights/orphan-properties db)) :items #(mapv property-response %))
+      "duplicate-titles" (update (paginate-by duplicate-key (graph-insights/duplicate-titles db) limit cursor)
+                                 :items #(mapv (fn [group]
+                                                 {:title (:block/title (first group))
+                                                  :entities (mapv page-ref-response group)})
+                                               %))
+      "pages-without-summary" (pages-check (graph-insights/pages-without-summary db prefix))
+      "pages-without-tags" (pages-check (graph-insights/pages-without-tags db)))))
+
+(defn- knowledge-index-entry [db {:keys [ref-properties lineage prefix]} page]
+  (let [summary (graph-insights/page-summary db page prefix)]
+    (cond-> {:uuid (uuid-string (:block/uuid page))
+             :title (:block/title page)
+             :tags (mapv tag-response (graph-insights/page-tags db page))
+             :classes (mapv :block/title (graph-insights/page-classes db lineage page))
+             :reference-count (:total (graph-insights/page-usage db page ref-properties))
+             :created-at (:block/created-at page)
+             :updated-at (:block/updated-at page)}
+      summary (assoc :summary summary))))
+
+(defn- handle-insights [{:keys [^js url db handler path-params e2ee?]}]
+  (let [{:keys [limit raw-cursor cursor]} (pagination-options url)
+        prefix (or (.get (.-searchParams url) "summary-prefix") graph-insights/default-summary-prefix)]
+    (cond
+      e2ee? (http/error-response "graph insights are unavailable for E2EE graphs" 409)
+      (nil? limit) (http/bad-request "invalid limit")
+      (and raw-cursor (nil? cursor)) (http/bad-request "invalid cursor")
+      (string/blank? prefix) (http/bad-request "invalid summary-prefix")
+      :else
+      (case handler
+        :semantic/pages-backlinks
+        (let [page (find-visible-entity db (:page-id path-params))]
+          (if (entity-util/page? page)
+            (http/json-response nil (page-backlinks-response db page limit))
+            (http/not-found)))
+
+        :semantic/graph-health
+        (let [checks (or (comma-list url "checks") health-checks)
+              time-filters (time-filter-options url)]
+          (cond
+            (not-every? (set health-checks) checks) (http/bad-request "invalid checks")
+            (and cursor (not= 1 (count checks))) (http/bad-request "cursor needs exactly one check")
+            (:invalid? time-filters) (http/bad-request "invalid time filter")
+            :else
+            (let [options {:prefix prefix :time-filters time-filters :limit limit :cursor cursor}]
+              (http/json-response nil {:checks (into {} (map (fn [check] [check (health-check db check options)]))
+                                                     checks)}))))
+
+        :semantic/knowledge-index
+        (let [excluded (set (map string/lower-case (comma-list url "exclude-tags")))
+              lineage (graph-insights/class-lineage-fn db)
+              options {:ref-properties (graph-insights/ref-property-idents db)
+                       :lineage lineage
+                       :prefix prefix}
+              {:keys [items next-cursor]} (paginate-by (partial title-key db)
+                                                       (graph-insights/knowledge-index-pages db lineage excluded)
+                                                       limit cursor)]
+          (http/json-response nil (cond-> {:pages (mapv #(knowledge-index-entry db options %) items)}
+                                    next-cursor (assoc :next-cursor next-cursor))))))))
+
+(def ^:private insight-handlers
+  #{:semantic/pages-backlinks :semantic/graph-health :semantic/knowledge-index})
+
 (def ^:private page-handlers
   #{:semantic/pages-list :semantic/pages-create :semantic/pages-blocks :semantic/pages-outline
     :semantic/pages-references :semantic/pages-get
@@ -1840,6 +1978,7 @@
     (contains? asset-handlers handler) (handle-assets context)
     (contains? property-and-search-handlers handler) (handle-properties-and-search context)
     (contains? bulk-handlers handler) (handle-bulk context)
+    (contains? insight-handlers handler) (handle-insights context)
     :else (http/not-found)))
 
