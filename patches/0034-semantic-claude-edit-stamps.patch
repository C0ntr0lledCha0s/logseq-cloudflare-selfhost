+;; Claude edit stamps (patch 0034). A write whose request carries x-logseq-edit-stamp: claude (the
+;; connector sends it when the graph's "Mark Claude's edits" setting is on) is flagged :stamp? in
+;; its creator. On a flagged write, authored-write! makes sure the two hidden stamp properties
+;; exist, in the write's own transaction: editedBy, a choice property whose one choice, claude,
+;; has a fixed UUID, and claudeEditedAt, a datetime. Both are found by ident and the choice by its
+;; UUID, never by title. A property in their way refuses the write with a 409 before anything is
+;; stored, so a stamp never lands in an owner's own property. E2EE graphs are never flagged: the
+;; choice's title would be plaintext there.
+
+(def ^:private stamp-header-value "claude")
+
+(def ^:private editedby-ident :user.property/claude-editedBy)
+
+(def ^:private stamp-property-idents
+  "Each stamp property's ident, with the title it is created with and the type it must have."
+  {editedby-ident {:title "editedBy" :type :default}
+   :user.property/claude-editedAt {:title "claudeEditedAt" :type :datetime}})
+
+;; Fixed, so every write finds the same choice; written once, never derived from a title.
+(def ^:private editedby-choice-uuid #uuid "3072a652-18e8-4dcb-bb37-e1aa38c8e3e9")
+
+(defn- stamp-header?
+  "Whether every x-logseq-edit-stamp value is exactly claude (Headers joins repeats with \", \")."
+  [request]
+  (when-let [value (.get (.-headers request) "x-logseq-edit-stamp")]
+    (every? #(= stamp-header-value %) (.split value ", "))))
+
+(defn- stamp-property-conflict [entity]
+  (str "edit stamps: property " (:block/title entity) " (" (entity-ident entity) ") is not the stamp"
+       " property; rename it in the app or turn off \"Mark Claude's edits\" for this graph"))
+
+(defn- stamp-choice-conflict [db]
+  (let [choice (d/entity db [:block/uuid editedby-choice-uuid])
+        property (d/entity db editedby-ident)]
+    (cond
+      (and choice (not (contains? (set (map :db/ident (:block/closed-value-property choice))) editedby-ident)))
+      (str "edit stamps: the claude choice's UUID (" editedby-choice-uuid ") is held by "
+           (if-let [owner (first (:block/closed-value-property choice))]
+             (str "a choice of " (:block/title owner) " (" (entity-ident owner) ")")
+             (str "a " (block-kind choice)))
+           ", not by editedBy; turn off \"Mark Claude's edits\" for this graph")
+
+      ;; Re-adding the choice would collide with the owner's own claude choice.
+      (and property (nil? choice)
+           (some #(= stamp-header-value (str (db-property/closed-value-content (d/entity db (:e %)))))
+                 (d/datoms db :avet :block/closed-value-property (:db/id property))))
+      (str "edit stamps: editedBy has a claude choice that isn't the stamp's (" editedby-choice-uuid
+           "); delete it in the app or turn off \"Mark Claude's edits\" for this graph"))))
+
+(defn- check-stamp-schema
+  "nil when the stamp properties can be used or created in `db`, else the 409 that refuses the write:
+  an ident holding a property of another type or cardinality (or not a property), another property
+  with a stamp property's title (compared as :block/name; pages and tags don't count), or the
+  choice's UUID held by anything but an editedBy choice."
+  [db]
+  (when-let [error (or (some (fn [[ident {:keys [title type]}]]
+                               (or (when-let [own (d/entity db ident)]
+                                     (when-not (and (property? own)
+                                                    (= type (:logseq.property/type own))
+                                                    (not (db-property/many? own)))
+                                       (stamp-property-conflict own)))
+                                   (some (fn [datom]
+                                           (let [holder (d/entity db (:e datom))]
+                                             (when (and (property? holder) (not= ident (:db/ident holder)))
+                                               (stamp-property-conflict holder))))
+                                         (d/datoms db :avet :block/name (common-util/page-name-sanity-lc title)))))
+                             stamp-property-idents)
+                       (stamp-choice-conflict db))]
+    {:status 409 :error error}))
+
+(defn- refuse-stamp-conflict! [db]
+  (when-let [conflict (check-stamp-schema db)]
+    (throw (ex-info (:error conflict) {::stamp-conflict conflict}))))
+
+(defn- stamp-conflict-response
+  "The 409 for a write refused by refuse-stamp-conflict!, or nil for any other error."
+  [error]
+  (when-let [{:keys [error status]} (::stamp-conflict (ex-data error))]
+    (http/error-response error status)))
+
+(defn- ensure-stamp-schema!
+  "Creates whichever stamp property or choice is missing, on `conn` (the write's tx-conn), hidden.
+  An existing property is left as the owner has it (an unhidden one stays unhidden). Returns the
+  ids of editedBy, claudeEditedAt and the claude choice."
+  [conn]
+  (doseq [[ident {:keys [title type]}] stamp-property-idents]
+    (when-not (d/entity @conn ident)
+      (outliner-property/upsert-property! conn ident {:logseq.property/type type
+                                                      :db/cardinality :db.cardinality/one}
+                                          {:property-name title
+                                           :properties {:logseq.property/hide? true}})))
+  (when-not (d/entity @conn [:block/uuid editedby-choice-uuid])
+    (outliner-property/upsert-closed-value! conn editedby-ident {:id editedby-choice-uuid
+                                                                 :value stamp-header-value}))
+  (mapv #(:db/id (d/entity @conn %))
+        [editedby-ident :user.property/claude-editedAt [:block/uuid editedby-choice-uuid]]))
+
+(def ^:private stamp-qualifying-attributes
+  "Block attributes whose added datom makes a block a stamp target. Besides these, a property
+  attribute (stamp-property-attribute?) or :block/tags (the Tags property) qualifies added or
+  retracted, so removing a value or a tag stamps the block that held it. :block/page (children a
+  cross-page move carries along), :block/refs, :block/path-refs, the timestamps and :block/tx-id
+  don't: the outliner writes them for blocks the caller didn't change."
+  #{:block/title :block/parent :block/order})
+
+(defn- stamp-property-attribute?
+  "Whether `attribute` holds a property value: user, library, plugin or built-in, as upstream's
+  db-property/property? tells them apart (a namespace containing .property)."
+  [attribute]
+  (when-let [space (and (keyword? attribute) (namespace attribute))]
+    (db-property/user-property-namespace? space)))
+
+(defn- stamp-qualifying-datom? [{:keys [a added]}]
+  (or (= :block/tags a)
+      (stamp-property-attribute? a)
+      (and added (contains? stamp-qualifying-attributes a))))
+
+(defn- stamp-target?
+  "Whether `entity` (in the db after the write) is a block a stamp may go on: a block on a page that
+  doesn't hold a property's value. Pages, tags and properties have no :block/page; closed values
+  (choices) and property value blocks carry :logseq.property/created-from-property. A deleted block
+  has no entity there and is never a target."
+  [entity]
+  (and (:block/page entity)
+       (nil? (:logseq.property/created-from-property entity))))
+
+(defn- stamp-tx
+  "The stamp datoms for a flagged write: editedBy = the claude choice and claudeEditedAt = `now` on
+  each block a datom of the write's `tx-data` qualifies (stamp-qualifying-datom?) and that is a
+  stamp-target? in `after`, two datoms per block however many of its datoms qualify."
+  [after tx-data now]
+  (when-let [choice-id (:db/id (d/entity after [:block/uuid editedby-choice-uuid]))]
+    (into []
+          (comp (filter stamp-qualifying-datom?)
+                (map :e)
+                (distinct)
+                (filter #(stamp-target? (d/entity after %)))
+                (mapcat (fn [e] [[:db/add e editedby-ident choice-id]
+                                 [:db/add e :user.property/claude-editedAt now]])))
+          tx-data)))
+
+;; The Claude Activity page (patch 0034, stage 3). The first flagged write also creates a page titled
+;; Claude Activity holding two advanced-query blocks, last day and last week, that list stamped blocks
+;; as a table (the View Type property's default) sorted by claudeEditedAt, newest first. The query text is pinned against UPSTREAM_REF
+;; in semantic-edit-stamps-test. :-1d-ms and :-7d-ms resolve, where the query runs, to local midnight
+;; one and seven days back in epoch milliseconds, which is what claudeEditedAt holds. A page, tag or
+;; property (anything holding the :block/name) already titled Claude Activity is left alone.
+
+(def ^:private activity-page-title "Claude Activity")
+
+(defn- activity-query-text
+  "An advanced query for blocks whose editedBy is the claude choice (by its fixed UUID) and whose
+  claudeEditedAt is at or after the time `input` resolves to."
+  [input]
+  (str "{:query [:find (pull ?b [*])\n"
+       "         :in $ ?since\n"
+       "         :where\n"
+       "         [?b " editedby-ident " ?by]\n"
+       "         [?by :block/uuid #uuid \"" editedby-choice-uuid "\"]\n"
+       "         [?b :user.property/claude-editedAt ?at]\n"
+       "         [(>= ?at ?since)]]\n"
+       " :inputs [" input "]\n"
+       " :remove-block-children? false}"))
+
+(def ^:private activity-queries
+  [{:title "Edited by Claude since yesterday" :text (activity-query-text :-1d-ms)}
+   {:title "Edited by Claude in the last 7 days" :text (activity-query-text :-7d-ms)}])
+
+(defn- ensure-activity-page!
+  "Creates the Claude Activity page on `conn` (the write's tx-conn) unless something already holds
+  its :block/name. The query blocks take order keys after the graph's max key (seeded by `handle`),
+  so they never share a key with an existing block."
+  [conn]
+  (when (empty? (d/datoms @conn :avet :block/name (common-util/page-name-sanity-lc activity-page-title)))
+    (let [[_ page-uuid] (outliner-page/create! conn activity-page-title {})
+          blocks (mapv (fn [{:keys [title]}]
+                         {:block/uuid (random-uuid) :block/title title :block/order (db-order/gen-key)})
+                       activity-queries)]
+      (outliner-core/insert-blocks! conn blocks (d/entity @conn [:block/uuid page-uuid])
+                                    {:sibling? false :bottom? true :keep-uuid? true :keep-block-order? true})
+      (doseq [[{:keys [text]} {:block/keys [uuid]}] (map vector activity-queries blocks)]
+        (let [id (:db/id (d/entity @conn [:block/uuid uuid]))]
+          ;; As the app's advanced-query command makes one: tagged Query, the text in a code block.
+          (outliner-property/set-block-property! conn id :block/tags :logseq.class/Query)
+          (outliner-property/set-block-property! conn id :logseq.property/query text)
+          (let [query-id (:db/id (:logseq.property/query (d/entity @conn id)))]
+            (outliner-property/set-block-property! conn query-id :logseq.property.node/display-type :code)
+            (outliner-property/set-block-property! conn query-id :logseq.property.code/lang "clojure"))
+          (ldb/transact! conn [[:db/add id :logseq.property.table/sorting
+                                [{:id :user.property/claude-editedAt :asc? false}]]]))))))
+
+(defn- stamp-property-refusal
+  "Why a property write naming `property-ident` is refused: the stamp properties are set by the
+  server only, with or without the edit-stamp header. nil for any other property."
+  [property-ident]
+  (when-let [{:keys [title]} (get stamp-property-idents property-ident)]
+    (str title " is set by the server and can't be written")))
+
