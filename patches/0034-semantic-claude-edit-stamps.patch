+;; ---------------------------------------------------------------------------------------------
+;; Stage 3: the Claude Activity page. The first flagged write also creates a page titled Claude
+;; Activity, unless a page, tag or property already holds the title (compared as :block/name), with
+;; two advanced-query blocks listing stamped blocks newest first as tables. The query text is pinned
+;; here: a change to it in the patch fails these tests and needs a fresh check in the app.
+
+(def ^:private pinned-day-query
+  (str "{:query [:find (pull ?b [*])\n"
+       "         :in $ ?since\n"
+       "         :where\n"
+       "         [?b :user.property/claude-editedBy ?by]\n"
+       "         [?by :block/uuid #uuid \"3072a652-18e8-4dcb-bb37-e1aa38c8e3e9\"]\n"
+       "         [?b :user.property/claude-editedAt ?at]\n"
+       "         [(>= ?at ?since)]]\n"
+       " :inputs [:-1d-ms]\n"
+       " :remove-block-children? false}"))
+
+(def ^:private pinned-week-query
+  (string/replace pinned-day-query ":-1d-ms" ":-7d-ms"))
+
+(def ^:private pinned-titles ["Edited by Claude since yesterday" "Edited by Claude in the last 7 days"])
+
+(defn- query-text [block] (:block/title (:logseq.property/query block)))
+
+(defn- run-pinned-query
+  "Runs `block`'s stored query as the app does (frontend.worker.handler.query/execute-custom-query:
+  read the text, resolve each input, d/q), then orders the rows as the app's table view does, with
+  the query block as the view (logseq.db.common.view/get-view-data). Returns UUIDs, in view order."
+  [db block]
+  (let [{:keys [query inputs]} (common-util/safe-read-string {:log-error? false} (query-text block))
+        resolved (mapv #(db-inputs/resolve-input db % {}) inputs)
+        ;; One pulled block per row, as the app's query-tuples reads them.
+        ids (map (comp :db/id first) (apply d/q query db resolved))
+        {:keys [data]} (db-view/get-view-data db (:db/id block) {:view-feature-type :query-result
+                                                                 :query-entity-ids ids})]
+    (mapv #(:block/uuid (d/entity db %)) data)))
+
+;; Before the fix the write made no page:
+;;   expected: (some? page)  actual: (not (some? nil))
+(deftest first-stamped-write-creates-the-activity-page-once-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self a b c]}]
+        (p/let [unflagged (update-block! self c "C edited" signed)
+                _ (is (nil? (activity-page @conn)) "an unflagged write makes no page")
+                first-write (update-block! self a "A edited" stamped)
+                db @conn
+                page (activity-page db)
+                blocks (activity-blocks db)
+                write-tx (title-tx conn a)
+                second-db (p/let [_ (update-block! self b "B edited" stamped)] @conn)]
+          (is (= [200 200] [(:status unflagged) (:status first-write)]))
+          (is (some? page))
+          (is (= "Claude Activity" (:block/title page)))
+          (is (= 1 (count (d/datoms db :avet :block/name "claude activity"))) "one page")
+          (testing "two query blocks holding the pinned text"
+            (is (= pinned-titles (map :block/title blocks)))
+            (is (= [pinned-day-query pinned-week-query] (map query-text blocks)))
+            (doseq [block blocks]
+              (is (= #{:logseq.class/Query} (set (map :db/ident (:block/tags block)))))
+              (is (= :code (:logseq.property.node/display-type (:logseq.property/query block)))
+                  "an advanced query, shown as code")
+              (is (= "clojure" (:logseq.property.code/lang (:logseq.property/query block))))
+              (is (= :logseq.property.view/type.table (:db/ident (:logseq.property.view/type block)))
+                  "a table: View Type's default")
+              (is (= [{:id at-ident :asc? false}] (:logseq.property.table/sorting block))
+                  "newest claudeEditedAt first")))
+          (testing "in the write's own transaction"
+            (is (= #{write-tx} (set (map :tx (d/datoms db :eavt (:db/id page))))))
+            (is (= #{write-tx} (set (map :tx (mapcat #(d/datoms db :eavt (:db/id %)) blocks))))))
+          (testing "nothing on the page is stamped"
+            (is (= #{a} (set (keys (stamps db))))))
+          (testing "a second flagged write adds no page or block"
+            (is (= 1 (count (d/datoms second-db :avet :block/name "claude activity"))))
+            (is (= (map :block/uuid blocks) (map :block/uuid (activity-blocks second-db))))
+            (is (= #{a b} (set (keys (stamps second-db))))))
+          (is (empty? (validation-errors db (cons (:db/id page) (map :db/id blocks))))))))))
+
+;; Before the fix the write made no page, so there were no keys to compare:
+;;   expected: (= 2 (count orders))  actual: (not (= 2 0))
+(deftest activity-query-blocks-sort-after-the-seeded-max-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self a notes]}]
+        ;; A key near the top of the range, so a key taken from the empty page ("a0") would fall
+        ;; below it.
+        (let [top "yzzzzzzzzzzzzzzzzzzzzzzzzz"]
+          (is (db-order/validate-order-key? top))
+          (d/transact! conn [{:block/uuid (random-uuid) :block/title "high" :block/order top
+                              :block/page [:block/uuid notes] :block/parent [:block/uuid notes]
+                              :block/created-at 1 :block/updated-at 1}])
+          (p/let [existing (set (map :v (d/datoms @conn :avet :block/order)))
+                  response (update-block! self a "A edited" stamped)
+                  orders (map :block/order (activity-blocks @conn))]
+            (is (= 200 (:status response)))
+            (is (= 2 (count orders)))
+            (is (every? #(pos? (compare % top)) orders) (pr-str orders))
+            (is (every? (fn [order] (every? #(pos? (compare order %)) existing)) orders))
+            (is (= orders (sort orders)) "the day view first")
+            (is (every? #(= 1 (count (d/datoms @conn :avet :block/order %))) orders)
