+;; A property delete changes the holder by retraction only; a block whose only change is a
+;; :block/refs retraction (it linked to a block that was deleted) is not stamped.
+;; Before the fix the holder was not stamped:
+;;   expected: (= #{a} (set (keys (stamps @conn))))  actual: (not (= #{#uuid "…"} #{}))
+(deftest retractions-stamp-only-property-holders-test
+  (async done
+    (with-graph done
+      (fn [_]
+        (p/let [{:keys [conn self a b c]} (seed-stamp-graph)
+                _ (set-mood! self a "happy")
+                ;; B links to C through :block/refs only, as a stale ref would.
+                _ (d/transact! conn [[:db/add [:block/uuid b] :block/refs [:block/uuid c]]])
+                deleted (request! self "DELETE" (str "/semantic/blocks/" a "/properties/" mood-param) nil
+                                  :headers stamped)
+                _ (is (= 200 (:status deleted)) (pr-str deleted))
+                _ (is (nil? (get (d/entity @conn [:block/uuid a]) mood-ident)))
+                _ (is (= #{a} (set (keys (stamps @conn)))))
+                removed (request! self "DELETE" (str "/semantic/blocks/" c) nil :headers stamped)]
+          (is (= 200 (:status removed)) (pr-str removed))
+          (is (empty? (:block/refs (d/entity @conn [:block/uuid b]))) "B's ref to C was retracted")
+          (is (= #{a} (set (keys (stamps @conn)))) "B is not stamped"))))))
