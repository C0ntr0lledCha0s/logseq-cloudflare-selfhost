+          (is (string/starts-with? (str (get-in private-tag [:body :error])) "entry 1: Tags: "))
+          (is (= 400 (:status choice)) (pr-str choice))
+          (is (string/starts-with? (str (get-in choice [:body :error])) "entry 1: "))
