+(defn- answering-stamp-conflicts
+  "Calls `respond`, answering a write refused by refuse-stamp-conflict! (thrown, or rejected in a
+  promise) with its 409; other errors propagate."
+  [respond]
+  (let [answer (fn [error] (or (stamp-conflict-response error) (throw error)))]
+    (try
+      (let [response (respond)]
+        (if (p/promise? response) (p/catch response answer) response))
+      (catch :default error
+        (answer error)))))
