+;; A client replaying the logged, normalized tx-data ends up with the same stamps, schema included.
+;; Before the fix the client had no stamp either:
+;;   expected: (some? server)  actual: (not (some? nil))
+(deftest stamped-writes-replay-on-a-client-test
+  (async done
+    (with-graph done
+      (fn [_]
+        (p/let [{:keys [conn self notes a d n]} (assoc (seed-stamp-graph) :n (random-uuid))
+                client (d/conn-from-db @conn)
+                logged (atom [])
+                _ (d/listen! conn ::log (fn [{:keys [db-after db-before tx-data]}]
+                                          (swap! logged conj (db-normalize/normalize-tx-data db-after db-before tx-data))))
+                _ (update-block! self a "A edited" stamped)
+                _ (request! self "POST" "/semantic/block-trees"
+                            {:target-id (str notes) :blocks [{:uuid (str n) :title "N"}]} :headers stamped)
+                _ (request! self "POST" "/semantic/block-moves"
+                            {:block-ids [(str d)] :target-id (str notes) :position "last-child"} :headers stamped)
+                _ (d/unlisten! conn ::log)
+                _ (doseq [tx-data @logged] (d/transact! client tx-data))
+                view (fn [db] (into {} (map (fn [[id {:keys [by at]}]]
+                                              [id {:by (:block/uuid (d/entity db by)) :at at}]))
+                                    (stamps db)))
+                server (view @conn)]
+          (is (= 3 (count @logged)) "one transaction per write")
+          (is (= #{a n d} (set (keys server))))
+          (is (every? #(= choice-uuid (:by %)) (vals server)))
+          (is (= server (view @client))))))))
