+;; Before the fix the write made no page, so there were no query blocks to run:
+;;   expected: (= 2 (count blocks))  actual: (not (= 2 0))
+(deftest pinned-activity-queries-return-the-right-rows-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self a notes]}]
+        (p/let [response (update-block! self a "A edited" stamped)
+                db @conn
+                blocks (activity-blocks db)
+                _ (is (= 200 (:status response)))
+                _ (is (= 2 (count blocks)))
+                ;; A second editedBy choice, as an owner might add: blocks holding it aren't Claude's.
+                _ (outliner-property/upsert-closed-value! conn by-ident {:value "owner"})
+                decoy-choice (some #(when (= "owner" (db-property/closed-value-content %)) (:db/id %))
+                                   (closed-values @conn (d/entity @conn by-ident)))
+                choice-id (:db/id (d/entity @conn [:block/uuid choice-uuid]))
+                now (.now js/Date)
+                hour 3600000
+                ages {:now 60000 :h23 (* 23 hour) :h24 (* 24 hour) :d6 (* 6 24 hour) :d8 (* 8 24 hour)}
+                ids (into {} (map (fn [k] [k (random-uuid)])) (concat (keys ages) [:unstamped :decoy :no-time]))
+                block (fn [k text] {:block/uuid (ids k) :block/title text :block/order (db-order/gen-key)
+                                    :block/page [:block/uuid notes] :block/parent [:block/uuid notes]
+                                    :block/created-at 1 :block/updated-at 1})
+                _ (d/transact! conn (map (fn [k] (block k (name k))) (keys ids)))
+                ;; A's own stamp is from the write; drop it so the rows are only the ones below.
+                _ (d/transact! conn [[:db/retract [:block/uuid a] by-ident]
+                                     [:db/retract [:block/uuid a] at-ident]])
+                _ (d/transact! conn (concat
+                                     (mapcat (fn [[k age]] [[:db/add [:block/uuid (ids k)] by-ident choice-id]
+                                                            [:db/add [:block/uuid (ids k)] at-ident (- now age)]])
+                                             ages)
+                                     [[:db/add [:block/uuid (ids :decoy)] by-ident decoy-choice]
+                                      [:db/add [:block/uuid (ids :decoy)] at-ident now]
+                                      ;; editedAt without editedBy, and editedBy without editedAt
+                                      [:db/add [:block/uuid (ids :unstamped)] at-ident now]
+                                      [:db/add [:block/uuid (ids :no-time)] by-ident choice-id]]))
+                db @conn
+                [day week] (map #(run-pinned-query db %) (activity-blocks db))
+                since-day (db-inputs/resolve-input db :-1d-ms {})
+                since-week (db-inputs/resolve-input db :-7d-ms {})
