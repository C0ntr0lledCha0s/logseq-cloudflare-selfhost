+                                      {:entries [{:block-id (str b) :property-id "block/tags" :value "Food"}
+                                                 {:block-id (str a) :property-id "block/tags" :value ["Journal"]}]}
+                                      :headers stamped)
+                choice (request! self "POST" "/semantic/block-properties/batch-set"
+                                 {:entries [{:block-id (str a) :property-id "block/tags" :value "Food"}
+                                            {:block-id (str b) :property-id "logseq.property/priority" :value "Someday"}]}
+                                 :headers stamped)
