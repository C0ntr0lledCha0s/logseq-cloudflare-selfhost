+(defn- conflict-message [property-title ident]
+  (str "edit stamps: property " property-title " (" ident ") is not the stamp property; rename it or"
+       " turn off \"Mark Claude's edits\" for this graph"))
+
+(defn- user-property! [conn ident schema property-title]
+  (outliner-property/upsert-property! conn ident (merge {:logseq.property/type :default} schema)
+                                      {:property-name property-title}))
+
+;; Before the fix every case wrote the block and answered 200, e.g. for the decoy:
+;;   expected: (= 409 (:status response))  actual: (not (= 409 200))
+(deftest conflicting-stamp-properties-refuse-with-nothing-written-test
+  (async done
+   (-> (p/doseq [[label setup expected]
+              [["a decoy property titled editedBy"
+                (fn [conn] (user-property! conn nil {} "editedBy"))
+                (fn [conn] (let [decoy (first (filter ldb/property? (map #(d/entity @conn (:e %))
+                                                                         (d/datoms @conn :avet :block/name "editedby"))))]
+                             (conflict-message "editedBy" (subs (str (:db/ident decoy)) 1))))]
+               ["a decoy property titled claudeEditedAt, in another case"
+                (fn [conn] (user-property! conn nil {:logseq.property/type :datetime} "ClaudeEditedAt"))
+                (fn [conn] (let [decoy (first (filter ldb/property? (map #(d/entity @conn (:e %))
+                                                                         (d/datoms @conn :avet :block/name "claudeeditedat"))))]
+                             (conflict-message "ClaudeEditedAt" (subs (str (:db/ident decoy)) 1))))]
+               ["claudeEditedAt's ident holding a number property"
+                (fn [conn] (user-property! conn at-ident {:logseq.property/type :number} "claudeEditedAt"))
+                (constantly (conflict-message "claudeEditedAt" "user.property/claude-editedAt"))]
+               ["claudeEditedAt's ident holding a many-valued datetime"
+                (fn [conn] (user-property! conn at-ident {:logseq.property/type :datetime
+                                                         :db/cardinality :db.cardinality/many} "claudeEditedAt"))
+                (constantly (conflict-message "claudeEditedAt" "user.property/claude-editedAt"))]
+               ["editedBy's ident holding a many-valued property"
+                (fn [conn] (user-property! conn by-ident {:db/cardinality :db.cardinality/many} "editedBy"))
+                (constantly (conflict-message "editedBy" "user.property/claude-editedBy"))]
+               ["editedBy's ident holding a text (number) property"
+                (fn [conn] (user-property! conn by-ident {:logseq.property/type :number} "editedBy"))
+                (constantly (conflict-message "editedBy" "user.property/claude-editedBy"))]
+               ["the choice's UUID under another property"
+                (fn [conn]
+                  (let [mood (user-property! conn nil {} "mood")]
+                    (outliner-property/upsert-closed-value! conn (:db/ident mood) {:id choice-uuid :value "claude"})))
+                (fn [conn] (str "edit stamps: the claude choice's UUID (" choice-uuid ") is held by "
+                                "a choice of mood (" (subs (str (first (owners (d/entity @conn [:block/uuid choice-uuid])))) 1)
+                                "), not by editedBy; turn off \"Mark Claude's edits\" for this graph"))]
+               ["the choice's UUID held by a block"
+                (fn [conn]
+                  (let [page (:db/id (first (filter ldb/page? (map #(d/entity @conn (:e %))
+                                                                   (d/datoms @conn :avet :block/name "notes")))))]
+                    (d/transact! conn [{:block/uuid choice-uuid :block/title "claude" :block/order "a9"
+                                        :block/page page :block/parent page
+                                        :block/created-at 1 :block/updated-at 1}])))
+                (constantly (str "edit stamps: the claude choice's UUID (" choice-uuid ") is held by "
+                                 "a block, not by editedBy; turn off \"Mark Claude's edits\" for this graph"))]
+               ["another claude choice on editedBy while the fixed one is missing"
+                (fn [conn]
+                  (user-property! conn by-ident {} "editedBy")
+                  (outliner-property/upsert-closed-value! conn by-ident {:value "claude"}))
+                (constantly (str "edit stamps: editedBy has a claude choice that isn't the stamp's ("
+                                 choice-uuid "); delete it or turn off \"Mark Claude's edits\" for this graph"))]]]
+      (p/let [{:keys [conn self a]} (seed-graph)
+              _ (setup conn)
+              before (snapshot conn)
+              response (update-block! self a "A edited" stamped)]
+        (testing label
+          (is (= 409 (:status response)) (pr-str response))
+          (is (= (expected conn) (get-in response [:body :error])))
+          (is (= before (snapshot conn)) "nothing is transacted")
+          (is (= "A" (title conn a))))))
+       (p/catch #(is false (str %)))
+       (p/finally done))))
