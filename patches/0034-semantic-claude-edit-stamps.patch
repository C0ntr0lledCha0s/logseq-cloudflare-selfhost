+(defn- ops-of!
+  "Runs `(write graph)` with a listener on the graph's conn and returns the :outliner-op of each
+  transaction it commits: the op storage writes to tx_log and pulling clients replay."
+  [{:keys [conn] :as graph} write]
+  (let [ops (atom [])]
+    (d/listen! conn ::ops #(swap! ops conj (:outliner-op (:tx-meta %))))
+    (-> (p/let [response (write graph)]
+          (is (<= 200 (:status response) 299) (pr-str response))
+          @ops)
+        (p/finally #(d/unlisten! conn ::ops)))))
+
+;; Each write kind, as (fn [graph headers]) on a fresh graph. The flagged run is the graph's first
+;; flagged write, so it is the one that creates the stamp schema.
+(def ^:private write-kinds
+  {:save-block (fn [{:keys [self a]} headers] (update-block! self a "A edited" headers))
+   :delete-blocks (fn [{:keys [self a]} headers]
+                    (request! self "DELETE" (str "/semantic/blocks/" a) nil :headers headers))
+   :delete-blocks-batch (fn [{:keys [self a b]} headers]
+                          (request! self "DELETE" "/semantic/blocks" {:block-ids [(str a) (str b)]}
+                                    :headers headers))
+   :move-blocks (fn [{:keys [self a c]} headers]
+                  (request! self "POST" "/semantic/block-moves"
+                            {:block-ids [(str a)] :target-id (str c) :position "after"} :headers headers))
+   :create-page (fn [{:keys [self]} headers]
+                  (request! self "POST" "/semantic/pages" {:title "Fresh page"} :headers headers))
+   :batch-set-property (fn [{:keys [self a]} headers]
+                         (request! self "POST" "/semantic/block-properties/batch-set"
+                                   {:entries [{:block-id (str a) :property-id "logseq.property/heading"
+                                               :value 2}]}
+                                   :headers headers))})
+
+;; Before the fix the first flagged write committed under the op of the schema's last upsert:
+;;   expected: (= [:save-block] flagged)  actual: (not (= [:save-block] [:upsert-closed-value]))
+(deftest first-flagged-write-keeps-its-own-outliner-op-test
+  (async done
+    (let [seen (atom [])]
+      (-> (reduce (fn [chain [kind write]]
+                    (p/let [_ chain
+                            unflagged (ops-of! (seed-graph) #(write % signed))
+                            graph (seed-graph)
+                            flagged (ops-of! graph #(write % stamped))]
+                      (swap! seen conj kind)
+                      (testing (name kind)
+                        (is (= 1 (count unflagged)) (pr-str unflagged))
+                        (is (some? (first unflagged)) "the unflagged write carries an op")
+                        (is (= unflagged flagged) "the first flagged write commits under its own op")
+                        (is (some? (:by (schema-entities @(:conn graph)))) "and it created the schema"))))
+                  (p/resolved nil) write-kinds)
+          (p/then #(is (= (set (keys write-kinds)) (set @seen)) "every write kind ran"))
+          (p/catch #(is false (str % (some-> % .-stack))))
+          (p/finally done)))))
+
+;; ---------------------------------------------------------------------------------------------
+;; Stage 2: the stamp. A flagged write stamps each block it creates or changes with editedBy (the
+;; claude choice) and claudeEditedAt, in its own transaction. Pages, tags, properties, closed values,
+;; property value blocks, siblings and children a move carries along are never stamped. The property
+;; tools refuse to write the two stamp properties, with or without the header.
+
+(def ^:private mood-ident :user.property/mood)
+(def ^:private mood-param (js/encodeURIComponent "user.property/mood"))
+
+(defn- seed-stamp-graph
+  "seed-graph plus a page Other holding D, whose children are E and F, with G under E; and a text
+  property mood (:user.property/mood)."
+  [& [ids]]
+  (let [{:keys [conn] :as graph} (seed-graph (seq (take 4 ids)))
+        [other d e f g] (or (seq (drop 4 ids)) (repeatedly 5 random-uuid))
+        block (fn [id t order parent]
+                {:block/uuid id :block/title t :block/order order :block/page [:block/uuid other]
+                 :block/parent [:block/uuid parent] :block/created-at 1 :block/updated-at 1})]
+    (d/transact! conn [(raw-page other "Other")])
+    (d/transact! conn [(block d "D" "a0" other)])
+    (d/transact! conn [(block e "E" "a0" d) (block f "F" "a1" d)])
+    (d/transact! conn [(block g "G" "a0" e)])
+    (user-property! conn mood-ident {} "mood")
+    (assoc graph :other other :d d :e e :f f :g g)))
+
+(defn- stamps
+  "Each block holding claudeEditedAt, by UUID: its editedBy value's db id, its claudeEditedAt, and
+  the tx of each stamp datom."
+  [db]
+  (into {}
+        (map (fn [datom]
+               (let [by (first (d/datoms db :eavt (:e datom) by-ident))]
+                 [(:block/uuid (d/entity db (:e datom)))
+                  {:by (:v by) :by-tx (:tx by) :at (:v datom) :at-tx (:tx datom)}])))
+        (holders-of db at-ident)))
+
+(defn- activity-page
+  "The Claude Activity page the patch made: the page holding \"claude activity\" as :block/name whose
+  blocks are Query-tagged. nil when there is none."
+  [db]
+  (some (fn [datom]
+          (let [page (d/entity db (:e datom))]
+            (when (some #(= :logseq.class/Query (:db/ident %)) (mapcat :block/tags (:block/_page page)))
+              page)))
+        (d/datoms db :avet :block/name "claude activity")))
+
+(defn- activity-blocks
+  "The Activity page's top-level blocks, in page order."
+  [db]
+  (when-let [page (activity-page db)]
+    (sort-by :block/order (filter #(= (:db/id page) (:db/id (:block/parent %))) (:block/_page page)))))
+
+(defn- traced!
+  "Runs (write) and returns its response, the transactions it committed and the call's time window."
+  [conn write]
+  (let [reports (atom [])
+        t0 (.now js/Date)]
+    (d/listen! conn ::traced #(swap! reports conj %))
+    (-> (p/let [response (write)]
+          {:response response :reports @reports :t0 t0 :t1 (.now js/Date)})
+        (p/finally #(d/unlisten! conn ::traced)))))
+
+(defn- stamp-datoms [reports]
+  (filter #(and (:added %) (contains? #{by-ident at-ident} (:a %))) (mapcat :tx-data reports)))
+
+(defn- check-stamps!
+  "That the traced write stamped exactly the blocks `expected` (UUIDs), each with the claude choice and
+  a claudeEditedAt inside the call's window, two datoms per block, in the transaction that changed the
+  block. The write commits `transactions` transactions (capture makes today's journal first)."
+  [conn {:keys [response reports t0 t1]} expected & {:keys [transactions] :or {transactions 1}}]
+  (let [db @conn
+        choice-id (:db/id (d/entity db [:block/uuid choice-uuid]))
+        added (stamp-datoms reports)
+        ;; The tx of the block's own change: any datom on it in the write that isn't a stamp.
+        change-tx (fn [id]
+                    (let [e (:db/id (d/entity db [:block/uuid id]))]
+                      (some #(when (and (= e (:e %)) (not (contains? #{by-ident at-ident} (:a %)))) (:tx %))
+                            (mapcat :tx-data reports))))
+        all (stamps db)]
+    (is (<= 200 (:status response) 299) (pr-str response))
+    (is (= transactions (count reports)) "the write's transactions")
+    (is (some? choice-id) "the schema exists")
+    (is (= (set expected) (set (keys all))) "exactly these blocks are stamped")
+    (is (= (set expected) (set (map #(:block/uuid (d/entity db (:e %))) added))))
+    (is (= (* 2 (count expected)) (count added)) "two stamp datoms per block")
+    (is (= (set (map :e (holders-of db by-ident))) (set (map :e (holders-of db at-ident))))
+        "editedBy and claudeEditedAt are on the same blocks")
+    (doseq [id expected
+            :let [{:keys [by at by-tx at-tx]} (get all id)]]
+      (testing (str (title conn id))
+        (is (= choice-id by) "editedBy is the claude choice")
+        (is (and (number? at) (<= t0 at t1)) (str "claudeEditedAt " at " is in [" t0 ", " t1 "]"))
+        (is (some? (change-tx id)))
+        (is (= (change-tx id) by-tx at-tx) "the stamp shares the write's tx id")))))
+
+(defn- set-mood! [self id value]
+  (request! self "PUT" (str "/semantic/blocks/" id "/properties/" mood-param) {:value value} :headers signed))
+
+(defn- asset-upload! [self page headers]
+  (request! self "POST"
+            (str "/semantic/assets?file-name=photo.png&title=Photo&size=4&page-id=" page
+                 "&checksum=" (apply str (repeat 64 "b")))
+            nil :headers headers :content-type "application/octet-stream"
+            :raw-body (js/Blob. #js [(js/Uint8Array. #js [1 2 3 4])])))
+
+(defn- response-uuid [response]
+  (uuid (get-in response [:body :uuid])))
+
+;; Each write route: [label setup write expected transactions?]. setup runs unflagged and returns more
+;; keys for the graph; write is the flagged call; expected gives the UUIDs it must stamp, and nothing
+;; else; transactions is how many the call commits when it isn't one.
+(defn- write-routes []
+  (let [[n1 n2 n3] (repeatedly 3 random-uuid)]
+    [["insertBlockTree, a parent and its child, appended after A, B and C"
+      nil
+      (fn [{:keys [self notes]}]
+        (request! self "POST" "/semantic/block-trees"
+                  {:target-id (str notes)
+                   :blocks [{:uuid (str n1) :title "N1" :children [{:uuid (str n2) :title "N2"}]}]}
+                  :headers stamped))
+      (constantly #{n1 n2})]
+     ["insertBlockChildren"
+      nil
+      (fn [{:keys [self b]}]
+        (request! self "POST" (str "/semantic/blocks/" b "/children")
+                  {:position "append" :blocks [{:uuid (str n1) :title "N1"}]} :headers stamped))
+      (constantly #{n1})]
+     ["batchInsertBlockTrees, into Notes and into a page it creates"
+      nil
+      (fn [{:keys [self notes]}]
+        (request! self "POST" "/semantic/block-trees/batch"
+                  {:entries [{:target-id (str notes)
+                              :blocks [{:uuid (str n1) :title "N1" :children [{:uuid (str n2) :title "N2"}]}]}
+                             {:page "Fresh" :blocks [{:uuid (str n3) :title "N3"}]}]}
+                  :headers stamped))
+      (constantly #{n1 n2 n3})]
+     ["captureToToday, which creates today's journal"
+      nil
+      (fn [{:keys [self]}]
+        (request! self "POST" "/semantic/capture" {:blocks [{:uuid (str n1) :title "Captured"}]} :headers stamped))
+      (constantly #{n1})
+      2]
+     ["createTask"
+      nil
+      (fn [{:keys [self notes]}]
+        (request! self "POST" "/semantic/tasks" {:title "Call Sam" :page-id (str notes) :status "todo"
+                                                 :priority "high"}
+                  :headers stamped))
+      (fn [_ response] #{(response-uuid response)})]
+     ["updateBlock"
+      nil
+      (fn [{:keys [self a]}] (update-block! self a "A edited" stamped))
+      (fn [{:keys [a]} _] #{a})]
+     ["setBlockProperty, a text value (stored in a property value block)"
+      nil
+      (fn [{:keys [self a]}]
+        (request! self "PUT" (str "/semantic/blocks/" a "/properties/" mood-param) {:value "happy"}
+                  :headers stamped))
+      (fn [{:keys [a]} _] #{a})]
+     ["setBlockProperty, tags"
+      (fn [{:keys [self]}] (request! self "POST" "/semantic/tags" {:title "Food"}))
+      (fn [{:keys [self a]}]
+        (request! self "PUT" (str "/semantic/blocks/" a "/properties/" (js/encodeURIComponent "block/tags"))
+                  {:value "Food"} :headers stamped))
+      (fn [{:keys [a]} _] #{a})]
+     ["setBlockProperty, a choice"
+      nil
+      (fn [{:keys [self a]}]
+        (request! self "PUT" (str "/semantic/blocks/" a "/properties/" (js/encodeURIComponent "logseq.property/priority"))
+                  {:value "High"} :headers stamped))
+      (fn [{:keys [a]} _] #{a})]
+     ["batchSetBlockProperty, on a block and on a page"
+      nil
+      (fn [{:keys [self a notes]}]
+        (request! self "POST" "/semantic/block-properties/batch-set"
+                  {:entries [{:block-id (str a) :property-id "user.property/mood" :value "calm"}
+                             {:block-id (str notes) :property-id "user.property/mood" :value "busy"}]}
+                  :headers stamped))
+      (fn [{:keys [a]} _] #{a})]
+     ["deleteBlockProperty"
+      (fn [{:keys [self a]}] (set-mood! self a "happy"))
+      (fn [{:keys [self a]}]
+        (request! self "DELETE" (str "/semantic/blocks/" a "/properties/" mood-param) nil :headers stamped))
+      (fn [{:keys [a]} _] #{a})]
+     ["batchDeleteBlockProperty"
+      (fn [{:keys [self a b]}] (p/do (set-mood! self a "happy") (set-mood! self b "sad")))
+      (fn [{:keys [self a b]}]
+        (request! self "POST" "/semantic/block-properties/batch-delete"
+                  {:entries [{:block-id (str a) :property-id "user.property/mood"}
+                             {:block-id (str b) :property-id "user.property/mood"}]}
+                  :headers stamped))
+      (fn [{:keys [a b]} _] #{a b})]
+     ["deleteBlockProperty, the block's tags (a retraction only)"
+      (fn [{:keys [self a]}]
+        (p/do (request! self "POST" "/semantic/tags" {:title "Food"})
+              (request! self "PUT" (str "/semantic/blocks/" a "/properties/" (js/encodeURIComponent "block/tags"))
+                        {:value "Food"} :headers signed)))
+      (fn [{:keys [self a]}]
+        (request! self "DELETE" (str "/semantic/blocks/" a "/properties/" (js/encodeURIComponent "block/tags")) nil
+                  :headers stamped))
+      (fn [{:keys [a]} _] #{a})]
+     ["batchSetBlockProperty, a reset to fewer tags (a retraction only)"
+      (fn [{:keys [self a]}]
+        (p/do (request! self "POST" "/semantic/tags" {:title "Food"})
+              (request! self "POST" "/semantic/tags" {:title "Recipe"})
+              (request! self "PUT" (str "/semantic/blocks/" a "/properties/" (js/encodeURIComponent "block/tags"))
+                        {:value ["Food" "Recipe"]} :headers signed)))
+      (fn [{:keys [self a]}]
+        (request! self "POST" "/semantic/block-properties/batch-set"
+                  {:isResetExistingValues true
+                   :entries [{:block-id (str a) :property-id "block/tags" :value ["Food"]}]}
+                  :headers stamped))
+      (fn [{:keys [a]} _] #{a})]
+     ;; Class sweep: a value of every property type, and a property of every namespace kind (user,
+     ;; built-in, a built-in in a sub-namespace, library, plugin), changes the holder through its
+     ;; property attribute alone.
