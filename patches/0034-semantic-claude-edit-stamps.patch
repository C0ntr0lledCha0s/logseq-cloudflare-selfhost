+(def ^:private fixed-ids (vec (repeatedly 9 random-uuid)))
+
+;; The first flagged write (which creates the schema) and a later one answer exactly as the same
+;; write without the header, on two graphs seeded alike.
+;; Before the fix these passed (nothing was added); they pin that stamping adds nothing to responses.
+(deftest responses-are-unchanged-by-the-stamp-test
+  (async done
+    (let [[t1 t2] (repeatedly 2 random-uuid)
+          calls [["updateBlock" (fn [{:keys [self a]} headers] (update-block! self a "A edited" headers))]
+                 ["insertBlockTree"
+                  (fn [{:keys [self notes]} headers]
+                    (request! self "POST" "/semantic/block-trees"
+                              {:target-id (str notes) :verbose true
+                               :blocks [{:uuid (str t1) :title "T1" :children [{:uuid (str t2) :title "T2"}]}]}
+                              :headers headers))]
+                 ["batchMoveBlocks"
+                  (fn [{:keys [self notes a d]} headers]
+                    (request! self "POST" "/semantic/block-moves/batch"
+                              {:moves [{:block-ids [(str a)] :target-id (str notes) :position "last-child"}
+                                       {:block-ids [(str d)] :target-id (str a) :position "after"}]}
+                              :headers headers))]
+                 ["setBlockProperty"
+                  (fn [{:keys [self b]} headers]
+                    (request! self "PUT" (str "/semantic/blocks/" b "/properties/" mood-param) {:value "ok"}
+                              :headers headers))]]]
+      (-> (p/let [plain (seed-stamp-graph fixed-ids)
+                  flagged (seed-stamp-graph fixed-ids)
+                  results (p/loop [[[label call] & more] calls acc []]
+                            (if-not label
+                              acc
+                              (p/let [without (call plain signed)
+                                      with (call flagged stamped)]
+                                (p/recur more (conj acc [label without with])))))]
+            (is (seq (stamps @(:conn flagged))) "the flagged graph was stamped")
+            (is (some? (activity-page @(:conn flagged))) "the flagged graph's first write made the page (stage 3)")
+            (is (nil? (activity-page @(:conn plain))))
+            (is (empty? (holders-of @(:conn plain) at-ident)))
+            (doseq [[label without with] results]
+              (testing label
+                (is (<= 200 (:status without) 299) (pr-str without))
+                (is (= without with)))))
+          (p/catch #(is false (str % (some-> % .-stack))))
+          (p/finally done)))))
