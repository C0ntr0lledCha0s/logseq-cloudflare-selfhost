+            (is (= :default (:logseq.property/type by)))
+            (is (= :db.cardinality/one (:db/cardinality by)))
+            (is (true? (:logseq.property/hide? by)))
+            (is (= [choice-uuid] (map :block/uuid (closed-values db by))) "one choice, under the fixed UUID")
+            (is (= "claude" (db-property/closed-value-content choice))))
+          (testing "claudeEditedAt"
+            (is (= "claudeEditedAt" (:block/title at)))
+            (is (= :datetime (:logseq.property/type at)))
+            (is (= :db.cardinality/one (:db/cardinality at)))
+            (is (true? (:logseq.property/hide? at))))
+          (testing "in the write's own transaction"
+            (is (= #{write-tx} (set (map :tx (mapcat #(d/datoms db :eavt %) schema-ids))))))
+          (is (empty? (validation-errors db schema-ids)))
+          (testing "only the written block is stamped (stage 2)"
+            (is (= #{(:db/id (d/entity db [:block/uuid a]))} (set (map :e (holders-of db by-ident)))))
+            (is (= #{(:db/id (d/entity db [:block/uuid a]))} (set (map :e (holders-of db at-ident)))))))))))
