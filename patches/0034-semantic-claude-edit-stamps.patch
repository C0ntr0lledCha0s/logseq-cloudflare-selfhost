+;; With the schema already in place (A stamped by a first flagged write), writes that aren't flagged
+;; stamp nothing. Before the fix these passed too (nothing stamped anything); they pin that the stamp
+;; follows the flag, not the schema.
+(deftest only-flagged-writes-stamp-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self a b notes]}]
+        (p/let [_ (update-block! self a "A edited" stamped)
+                _ (is (= #{a} (set (keys (stamps @conn)))))
+                responses (p/all
+                           (for [[label headers e2ee? dry?]
+                                 [["no header" signed false false]
+                                  ["another value" (conj signed ["x-logseq-edit-stamp" "Claude"]) false false]
+                                  ["no actor" [["x-logseq-edit-stamp" "claude"]] false false]
+                                  ["a dry run" stamped false true]
+                                  ["an E2EE graph" stamped true false]]]
+                             (p/let [response (request! self "POST" (str "/semantic/block-moves" (when dry? "?dry-run=true"))
+                                                        {:block-ids [(str b)] :target-id (str notes) :position "last-child"}
+                                                        :headers headers :e2ee? e2ee?)]
+                               [label response])))]
+          (doseq [[label response] responses]
+            (testing label (is (= 200 (:status response)) (pr-str response))))
+          (is (= #{a} (set (keys (stamps @conn)))) "B is not stamped"))))))
