+;; Before the fix both writes transacted the same number of datoms, but the first assertion of the
+;; test above already failed; this one pins that only the first flagged write adds schema.
+(deftest second-stamped-write-creates-nothing-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self a b c]}]
+        (let [sizes (atom [])]
+          (p/let [_ (update-block! self a "A edited" stamped)
+                  schema-tx (title-tx conn a)
+                  _ (d/listen! conn ::sizes #(swap! sizes conj (count (:tx-data %))))
+                  second-write (update-block! self b "B edited" stamped)
+                  unflagged (update-block! self c "C edited" signed)
+                  {:keys [by at choice]} (schema-entities @conn)]
+            (d/unlisten! conn ::sizes)
+            (is (= [200 200] [(:status second-write) (:status unflagged)]))
+            (is (= 2 (count @sizes)))
+            (is (= (+ 2 (second @sizes)) (first @sizes))
+                "once the schema exists a flagged write adds only its block's two stamp datoms")
+            (is (= #{schema-tx} (set (map :tx (mapcat #(d/datoms @conn :eavt (:db/id %)) [by at choice])))))))))))
+
+;; Before the fix: no case created schema, so these passed; the repeated-header case failed:
