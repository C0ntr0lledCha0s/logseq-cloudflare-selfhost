+;; What the refusal must not catch: other property writes on a stamped block, a re-send, a reset
+;; and a property whose title only starts like a stamp property, with and without the header. The
+;; stamp survives them all.
+;; Before the fix these answered 2xx too; they pin the refusal's reach.
+(deftest property-writes-on-stamped-blocks-still-work-test
+  (async done
+    (with-graph done
+      (fn [_]
+        (p/let [{:keys [conn self a b]} (seed-stamp-graph)
+                _ (update-block! self a "A edited" stamped)
+                at (:at (get (stamps @conn) a))
+                _ (user-property! conn :user.property/edited-by-me {} "editedByMe")
+                results (p/loop [[headers & more] [signed stamped] acc []]
+                          (if-not headers
+                            acc
+                            (p/let [set-one (request! self "PUT" (str "/semantic/blocks/" a "/properties/" mood-param)
+                                                      {:value "happy"} :headers headers)
+                                    resent (request! self "PUT" (str "/semantic/blocks/" a "/properties/" mood-param)
+                                                     {:value "happy"} :headers headers)
+                                    lookalike (request! self "PUT" (str "/semantic/blocks/" a "/properties/editedByMe")
+                                                        {:value "me"} :headers headers)
+                                    reset (request! self "POST" "/semantic/block-properties/batch-set"
+                                                    {:isResetExistingValues true
+                                                     :entries [{:block-id (str a) :property-id "user.property/mood" :value "calm"}
+                                                               {:block-id (str b) :property-id "user.property/mood" :value "calm"}]}
+                                                    :headers headers)
+                                    deleted (request! self "DELETE" (str "/semantic/blocks/" a "/properties/" mood-param)
+                                                      nil :headers headers)
+                                    batch-deleted (request! self "POST" "/semantic/block-properties/batch-delete"
+                                                            {:entries [{:block-id (str b) :property-id "user.property/mood"}
+                                                                       {:block-id (str a) :property-id "editedByMe"}]}
+                                                            :headers headers)]
+                              (p/recur more (conj acc [(if (= headers signed) "unflagged" "flagged")
+                                                       {:set set-one :resent resent :lookalike lookalike :reset reset
+                                                        :deleted deleted :batch-deleted batch-deleted}])))))]
+          (doseq [[label calls] results
+                  [call response] calls]
+            (testing (str label " " (name call))
+              (is (= 200 (:status response)) (pr-str response))))
+          (is (some? (get (stamps @conn) a)) "A keeps its stamp")
+          (is (<= at (:at (get (stamps @conn) a)))))))))
