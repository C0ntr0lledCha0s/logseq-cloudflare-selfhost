+;; Before the fix every write left every block unstamped, e.g. for updateBlock:
+;;   expected: (= (set expected) (set (keys all)))  actual: (not (= #{#uuid "…"} #{}))
+(deftest every-write-route-stamps-exactly-its-own-blocks-test
+  (async done
+    (let [ran (atom 0)
+          routes (write-routes)]
+      (-> (p/doseq [[label setup write expected transactions] routes]
+            (p/let [graph (seed-stamp-graph)
+                    more (when setup (setup graph))
+                    graph (merge graph (when (map? more) more))
+                    traced (traced! (:conn graph) #(write graph))]
+              (swap! ran inc)
+              (testing label
+                (check-stamps! (:conn graph) traced (expected graph (:response traced))
+                               :transactions (or transactions 1)))))
+          (p/then #(is (= (count routes) @ran) "every route ran"))
+          (p/catch #(is false (str % (some-> % .-stack))))
+          (p/finally done)))))
+
+;; Siblings, a moved block's carried descendants and the page are named here as well as by the exact
+;; set above, so a mutation that stamps them is reported by name.
+;; Before the fix nothing was stamped, so the first assertion failed:
+;;   expected: (= #{d} (set (keys (stamps @conn))))  actual: (not (= #{#uuid "…"} #{}))
+(deftest moves-stamp-the-moved-block-only-test
+  (async done
+    (with-graph done
+      (fn [_]
+        (p/let [{:keys [conn self notes other a b c d e f g]} (seed-stamp-graph)
+                cross (request! self "POST" "/semantic/block-moves"
+                                {:block-ids [(str d)] :target-id (str notes) :position "last-child"}
+                                :headers stamped)
+                _ (is (= 200 (:status cross)) (pr-str cross))
+                _ (is (= #{d} (set (keys (stamps @conn)))))
+                _ (testing "descendants carried to the new page are not stamped"
+                    (doseq [id [e f g]]
+                      (is (= notes (:block/uuid (:block/page (d/entity @conn [:block/uuid id])))))
+                      (is (nil? (get (stamps @conn) id)) (title conn id))))
+                reorder (request! self "POST" "/semantic/block-moves"
+                                  {:block-ids [(str c)] :target-id (str a) :position "before"}
+                                  :headers stamped)]
+          (is (= 200 (:status reorder)) (pr-str reorder))
+          (testing "siblings of a reordered block are not stamped"
+            (is (= #{c d} (set (keys (stamps @conn)))))
+            (doseq [id [a b]] (is (nil? (get (stamps @conn) id)) (title conn id))))
+          (testing "pages are not stamped"
+            (doseq [id [notes other]] (is (nil? (get (stamps @conn) id))))))))))
