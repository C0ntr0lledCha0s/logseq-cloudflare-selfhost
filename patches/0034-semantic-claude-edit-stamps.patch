+;; The insert inputs that take a properties object (a batch entry's own properties, on an existing
+;; block, an existing page or a page the call creates, and a BlockTree node's properties at any depth,
+;; through insertBlockTree, insertBlockChildren, captureToToday and a batch entry's blocks) refuse
+;; the stamp properties too, named by title, ident or UUID, with or without the header, also when
+;; another property comes first in the object. The refusal names the entry or node; nothing is written.
+;; Before the fix these answered 201 and stored the caller's values, e.g.:
+;;   expected: (= [400 "entries[0]: editedBy is set by the server and can't be written"] ...)
+;;   actual: (not (= [400 ...] [201 nil]))
+(deftest insert-properties-cannot-name-the-stamp-properties-test
+  (async done
+    (with-graph done
+      (fn [_]
+        (p/let [{:keys [conn self notes a b]} (seed-stamp-graph)
+                _ (update-block! self a "A edited" stamped)
+                {:keys [by at]} (schema-entities @conn)
+                names {"editedBy" ["editedBy" "user.property/claude-editedBy" (str (:block/uuid by))]
+                       "claudeEditedAt" ["claudeEditedAt" "user.property/claude-editedAt" (str (:block/uuid at))]}
+                values {"editedBy" "claude" "claudeEditedAt" 1}
+                ;; Capture makes today's journal before it checks its blocks, so make it first.
+                _ (request! self "POST" "/semantic/capture" {:blocks [{:title "today"}]} :headers signed)
+                before (snapshot conn)
+                stamps-before (stamps @conn)
+                calls (fn [id value]
+                        ;; Another property first, so the refusal isn't only for a lone key.
+                        (let [props (array-map "user.property/mood" "ok" id value)
+                              node [{:title "N" :properties props}]]
+                          [["batch entry on an existing block" "entries[0]"
+                            "POST" "/semantic/block-trees/batch"
+                            {:entries [{:target-id (str b) :properties props}]}]
+                           ["batch entry on an existing block, with blocks" "entries[0]"
+                            "POST" "/semantic/block-trees/batch"
+                            {:entries [{:target-id (str b) :properties props :blocks [{:title "x"}]}]}]
+                           ["batch entry on a page" "entries[1]"
+                            "POST" "/semantic/block-trees/batch"
+                            {:entries [{:target-id (str notes) :blocks [{:title "y"}]}
+                                       {:target-id (str notes) :properties props :blocks [{:title "x"}]}]}]
+                           ["batch entry on a page it creates" "entries[0]"
+                            "POST" "/semantic/block-trees/batch"
+                            {:entries [{:page "Fresh" :properties props :blocks [{:title "x"}]}]}]
+                           ["batch entry's node" "entries[0].blocks[0]"
+                            "POST" "/semantic/block-trees/batch"
+                            {:entries [{:target-id (str notes) :blocks node}]}]
+                           ["insertBlockTree node" "blocks[0]"
+                            "POST" "/semantic/block-trees" {:target-id (str notes) :blocks node}]
+                           ["insertBlockTree child node" "blocks[0].children[0]"
+                            "POST" "/semantic/block-trees"
+                            {:target-id (str notes) :blocks [{:title "P" :children node}]}]
+                           ["insertBlockChildren node" "blocks[0]"
+                            "POST" (str "/semantic/blocks/" b "/children") {:position "append" :blocks node}]
+                           ["captureToToday node" "blocks[0]"
+                            "POST" "/semantic/capture" {:blocks node}]]))
+                results (p/all
+                         (for [headers [signed stamped]
+                               [property-title ids] names
+                               id ids
+                               [call-label path method url body] (calls id (get values property-title))]
+                           (p/let [response (request! self method url body :headers headers)]
+                             [(str call-label ", " property-title " as " id (when (= headers stamped) ", flagged"))
+                              (str path ": " property-title " is set by the server and can't be written")
+                              response])))]
+          (doseq [[label expected response] results]
+            (is (= [400 expected] [(:status response) (get-in response [:body :error])]) label))
+          (is (= before (snapshot conn)) "nothing is written")
+          (is (= stamps-before (stamps @conn)) "no stamp is set or changed"))))))
