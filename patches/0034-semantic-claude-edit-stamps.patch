+;; The stamp properties can't be written through the property tools, given by title, ident or UUID,
+;; with or without the header; the refusal names the entry and nothing is written.
+;; Before the fix the writes went through, e.g.:
+;;   expected: (= 400 (:status response))  actual: (not (= 400 200))
+(deftest the-stamp-properties-cannot-be-written-test
+  (async done
+    (with-graph done
+      (fn [_]
+        (p/let [{:keys [conn self a b c]} (seed-stamp-graph)
+                _ (update-block! self a "A edited" stamped)
+                {:keys [by at]} (schema-entities @conn)
+                ;; Every way a property can be named, for each stamp property.
+                names {"editedBy" ["editedBy" "user.property/claude-editedBy" (str (:block/uuid by))]
+                       "claudeEditedAt" ["claudeEditedAt" "user.property/claude-editedAt" (str (:block/uuid at))]}
+                values {"editedBy" "claude" "claudeEditedAt" 1700000000000}
+                before (snapshot conn)
+                refusals (p/all
+                          (for [headers [signed stamped]
+                                [property-title ids] names
+                                id ids
+                                :let [param (js/encodeURIComponent id)
+                                      value (get values property-title)
+                                      label (str property-title " as " id (when (= headers stamped) ", flagged"))]]
+                            (p/let [set-one (request! self "PUT" (str "/semantic/blocks/" b "/properties/" param)
+                                                      {:value value} :headers headers)
+                                    delete-one (request! self "DELETE" (str "/semantic/blocks/" a "/properties/" param)
+                                                         nil :headers headers)
+                                    batch-set (request! self "POST" "/semantic/block-properties/batch-set"
+                                                        {:entries [{:block-id (str b) :property-id "user.property/mood" :value "ok"}
+                                                                   {:block-id (str c) :property-id id :value value}]}
+                                                        :headers headers)
+                                    batch-set-first (request! self "POST" "/semantic/block-properties/batch-set"
+                                                              {:entries [{:block-id (str c) :property-id id :value value}
+                                                                         {:block-id (str b) :property-id "user.property/mood" :value "ok"}]}
+                                                              :headers headers)
+                                    batch-delete (request! self "POST" "/semantic/block-properties/batch-delete"
+                                                           {:entries [{:block-id (str b) :property-id "user.property/mood"}
+                                                                      {:block-id (str a) :property-id id}]}
+                                                           :headers headers)]
+                              [label property-title {:set set-one :delete delete-one :batch-set batch-set
+                                                     :batch-set-first batch-set-first :batch-delete batch-delete}])))]
+          (doseq [[label property-title {:keys [set delete batch-set batch-set-first batch-delete]}] refusals]
+            (testing label
+              (doseq [[call response entry] [["set" set 0] ["delete" delete 0] ["batch set" batch-set 1]
+                                             ["batch set, refused entry first" batch-set-first 0]
+                                             ["batch delete" batch-delete 1]]]
+                (is (= [400 (server-message entry property-title)]
+                       [(:status response) (get-in response [:body :error])])
+                    call))))
+          (is (= before (snapshot conn)) "nothing is written")
+          (testing "two stamp properties in one batch: the first is named, in either order"
+            (p/let [both (request! self "POST" "/semantic/block-properties/batch-set"
+                                   {:entries [{:block-id (str b) :property-id "claudeEditedAt" :value 1}
+                                              {:block-id (str b) :property-id "editedBy" :value "claude"}]})
+                    reversed (request! self "POST" "/semantic/block-properties/batch-delete"
+                                       {:entries [{:block-id (str a) :property-id "editedBy"}
+                                                  {:block-id (str a) :property-id "claudeEditedAt"}]})]
+              (is (= (server-message 0 "claudeEditedAt") (get-in both [:body :error])))
+              (is (= (server-message 0 "editedBy") (get-in reversed [:body :error])))
+              (is (= before (snapshot conn))))))))))
