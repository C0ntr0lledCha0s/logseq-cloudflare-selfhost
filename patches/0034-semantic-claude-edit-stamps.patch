+;; A move whose new order key equals the block's old one changes only :block/parent; the block is
+;; still stamped. The block's order is set to the key the move will generate first.
+(deftest a-move-that-changes-only-the-parent-stamps-test
+  (async done
+    (with-graph done
+      (fn [_]
+        (p/let [{:keys [conn self a b]} (seed-stamp-graph)
+                probe (d/conn-from-db @conn)
+                ;; The key a move to B's first child gets, found on a copy.
+                _ (request! #js {:conn probe :sql (test-sql/make-sql) :schema-ready true
+                                 :env #js {"TIMEZONE" "UTC"}}
+                            "POST" "/semantic/block-moves"
+                            {:block-ids [(str a)] :target-id (str b) :position "last-child"})
+                key (:block/order (d/entity @probe [:block/uuid a]))
+                _ (d/transact! conn [[:db/add [:block/uuid a] :block/order key]])
+                traced (traced! conn #(request! self "POST" "/semantic/block-moves"
+                                                {:block-ids [(str a)] :target-id (str b) :position "last-child"}
+                                                :headers stamped))
+                a-id (:db/id (d/entity @conn [:block/uuid a]))
+                changed (set (keep #(when (and (= a-id (:e %)) (:added %)) (:a %)) (mapcat :tx-data (:reports traced))))]
+          (is (= b (:block/uuid (:block/parent (d/entity @conn [:block/uuid a])))))
+          (is (contains? changed :block/parent))
+          (is (not (contains? changed :block/order)) (str "only the parent changed: " (pr-str changed)))
+          (check-stamps! conn traced #{a}))))))
