+(def ^:private property-types [:default :number :node :url :date :datetime :checkbox])
+
+;; Class sweep: the check is about any property in the way, whatever its type. Each type as a decoy
+;; titled editedBy, and as what a stamp ident holds when it isn't the stamp's type; plus an ident
+;; held by something that isn't a property.
+;; Before the fix each case answered 200, e.g. "decoy editedBy :number":
+;;   expected: (= 409 (:status response))  actual: (not (= 409 200))
+(deftest every-property-type-in-the-way-refuses-test
+  (async done
+   (-> (p/doseq [[label setup]
+                 (concat
+                  (for [type property-types]
+                    [(str "decoy editedBy " type)
+                     #(user-property! % nil {:logseq.property/type type} "editedBy")])
+                  (for [type (remove #{:default} property-types)]
+                    [(str "editedBy's ident holding " type)
+                     #(user-property! % by-ident {:logseq.property/type type} "editedBy")])
+                  (for [type (remove #{:datetime} property-types)]
+                    [(str "claudeEditedAt's ident holding " type)
+                     #(user-property! % at-ident {:logseq.property/type type} "claudeEditedAt")])
+                  [["claudeEditedAt's ident held by a page"
+                    #(d/transact! % [(raw-page (random-uuid) "Edited at" :db/ident at-ident)])]
+                   ;; Only the property check refuses this one: the type is the stamp's.
+                   ["claudeEditedAt's ident held by a page that has a datetime type"
+                    #(d/transact! % [(raw-page (random-uuid) "Edited at" :db/ident at-ident
+                                               :logseq.property/type :datetime)])]])]
+         (p/let [{:keys [conn self a]} (seed-graph)
+                 _ (setup conn)
+                 before (snapshot conn)
+                 response (update-block! self a "A edited" stamped)]
+           (testing label
+             (is (= 409 (:status response)) (pr-str response))
+             (is (string/starts-with? (str (get-in response [:body :error])) "edit stamps: property "))
+             (is (= before (snapshot conn)))
+             (is (= "A" (title conn a))))))
+       (p/catch #(is false (str %)))
+       (p/finally done))))
+
+;; The check runs on the graph before the write, so even a write that would move the decoy out of
+;; the way (renaming it) is refused while stamping is on; the owner renames it in the app or turns
+;; stamping off, as the message says.
+;; Before the fix the rename answered 200.
+(deftest a-flagged-rename-of-the-decoy-is-refused-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self]}]
+        (p/let [decoy (request! self "POST" "/semantic/properties" {:title "editedBy" :type "default"})
+                before (snapshot conn)
+                renamed (request! self "PATCH" (str "/semantic/properties/" (get-in decoy [:body :uuid]))
+                                  {:title "Edited by me"} :headers stamped)
+                unflagged (request! self "PATCH" (str "/semantic/properties/" (get-in decoy [:body :uuid]))
+                                    {:title "Edited by me"} :headers signed)]
+          (is (= 201 (:status decoy)) (pr-str decoy))
+          (is (= 409 (:status renamed)) (pr-str renamed))
+          (is (= 200 (:status unflagged)) (pr-str unflagged))
+          (is (not= before (snapshot conn)) "only the unflagged rename was written")
+          (is (no-schema? conn)))))))
+
+;; The check also runs on the write's own result, so a call that would itself make a decoy (a new
+;; property titled editedBy, or a rename to claudeEditedAt) is refused whole.
+;; Before the fix both calls answered 2xx and the property was stored:
+;;   expected: (= 409 (:status created))  actual: (not (= 409 201))
+(deftest a-write-that-makes-a-decoy-is-refused-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self]}]
+        (p/let [mood (request! self "POST" "/semantic/properties" {:title "mood" :type "default"})
+                before (snapshot conn)
+                created (request! self "POST" "/semantic/properties" {:title "editedBy" :type "default"}
+                                  :headers stamped)
+                after-create (snapshot conn)
+                renamed (request! self "PATCH" (str "/semantic/properties/" (get-in mood [:body :uuid]))
+                                  {:title "claudeEditedAt"} :headers stamped)]
+          (is (= 201 (:status mood)) (pr-str mood))
+          (is (= 409 (:status created)) (pr-str created))
+          (is (string/starts-with? (str (get-in created [:body :error])) "edit stamps: property editedBy ("))
+          (is (= before after-create) "nothing is transacted")
+          (is (= 409 (:status renamed)) (pr-str renamed))
+          (is (string/starts-with? (str (get-in renamed [:body :error])) "edit stamps: property claudeEditedAt ("))
+          (is (= before (snapshot conn)))
+          (is (= "mood" (:block/title (d/entity @conn [:block/uuid (uuid (get-in mood [:body :uuid]))])))))))))
+
+;; An asset upload stores the file before its write; a conflict still answers 409, not the
+;; route's 500, and the stored file is removed.
+;; Before the fix: expected (= 409 (:status response)), actual (not (= 409 201)).
+(deftest asset-upload-conflict-answers-409-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self notes deleted]}]
+        (user-property! conn nil {} "editedBy")
+        (p/let [before (snapshot conn)
+                response (request! self "POST"
+                                   (str "/semantic/assets?file-name=photo.png&title=Photo&size=4&page-id=" notes
+                                        "&checksum=" (apply str (repeat 64 "a")))
+                                   nil :headers stamped :content-type "application/octet-stream"
+                                   :raw-body (js/Blob. #js [(js/Uint8Array. #js [1 2 3 4])]))]
+          (is (= 409 (:status response)) (pr-str response))
+          (is (string/starts-with? (str (get-in response [:body :error])) "edit stamps: property editedBy ("))
+          (is (= before (snapshot conn)))
+          (is (= 1 (count @deleted)) "the uploaded file is removed"))))))
+
+;; What the refusal must not catch. Before the fix each of these answered 2xx (and they still do);
+;; they pin that the 409 is only for a property in the way.
+(deftest writes-the-conflict-check-lets-through-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self a b c]}]
+        ;; A page titled editedBy and a tag titled claudeEditedAt are not properties.
+        (d/transact! conn [(raw-page (random-uuid) "editedBy")])
+        (p/let [tag (request! self "POST" "/semantic/tags" {:title "claudeEditedAt"})
+                first-write (update-block! self a "A edited" stamped)
+                _ (testing "a page and a tag holding the titles"
+                    (is (= 201 (:status tag)) (pr-str tag))
+                    (is (= 200 (:status first-write)) (pr-str first-write))
+                    (is (some? (:by (schema-entities @conn)))))
+                by-id (:db/id (:by (schema-entities @conn)))
+                ;; The owner renames the stamp property in the app: it is still the stamp property.
+                _ (d/transact! conn [{:db/ident by-ident :block/title "Edited by" :block/name "edited by"}])
+                renamed-own (update-block! self b "B edited" stamped)
+                resent (update-block! self b "B edited" stamped)
+                replaced (request! self "POST" "/semantic/block-properties/batch-set"
+                                   {:isResetExistingValues true
+                                    :entries [{:block-id (str c) :property-id "block/tags" :value "claudeEditedAt"}]}
+                                   :headers stamped)
+                ;; Without the flag a decoy doesn't matter.
+                decoy (user-property! conn nil {} "editedBy")
+                unflagged (update-block! self c "C edited" signed)]
+          (is (some? decoy))
+          (is (= 200 (:status renamed-own)) (pr-str renamed-own))
+          (is (= 200 (:status resent)) (pr-str resent))
+          (is (= 200 (:status replaced)) (pr-str replaced))
+          (is (= 200 (:status unflagged)) (pr-str unflagged))
+          (is (= "Edited by" (:block/title (d/entity @conn by-ident))) "the owner's title is kept")
+          (is (= by-id (:db/id (d/entity @conn by-ident))) "the stamp property isn't recreated"))))))
+
+;; Before the fix nothing was created, so nothing was recreated:
+;;   expected: (some? by)  actual: (not (some? nil))
+(deftest deleted-schema-is-recreated-and-unhiding-is-kept-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self a b c]}]
+        (p/let [_ (update-block! self a "A edited" stamped)
+                {:keys [by at]} (schema-entities @conn)
+                ;; The app won't delete a hidden property, so the owner unhides each first.
+                _ (d/transact! conn [[:db/retract (:db/id by) :logseq.property/hide? true]
+                                     [:db/retract (:db/id at) :logseq.property/hide? true]])
+                _ (is (true? (outliner-page/delete! conn (:block/uuid by))))
+                _ (is (true? (outliner-page/delete! conn (:block/uuid at))))
+                _ (testing "the owner deleted both properties"
+                    (is (nil? (d/entity @conn by-ident)))
+                    (is (nil? (d/entity @conn at-ident))))
+                recreated (update-block! self b "B edited" stamped)
+                {:keys [by at choice]} (schema-entities @conn)]
+          (is (= 200 (:status recreated)) (pr-str recreated))
+          (is (true? (:logseq.property/hide? by)))
+          (is (true? (:logseq.property/hide? at)))
+          (is (= :datetime (:logseq.property/type at)))
+          (is (= #{by-ident} (owners choice)) "the choice is back under its UUID")
+          (p/let [_ (d/transact! conn [[:db/retract (:db/id by) :logseq.property/hide? true]])
+                  _ (d/transact! conn [[:db/retractEntity (:db/id choice)]])
+                  _ (is (nil? (d/entity @conn [:block/uuid choice-uuid])) "the owner deleted the choice")
+                  again (update-block! self c "C edited" stamped)
+                  {:keys [by at choice]} (schema-entities @conn)]
+            (is (= 200 (:status again)) (pr-str again))
+            (is (nil? (:logseq.property/hide? by)) "an unhidden property stays unhidden")
+            (is (true? (:logseq.property/hide? at)))
+            (is (= #{by-ident} (owners choice)))
+            (is (= [choice-uuid] (map :block/uuid (closed-values @conn by))))
+            (is (= (title-tx conn c) (:tx (first (d/datoms @conn :eavt (:db/id choice) :block/closed-value-property))))
+                "the choice is re-added in the write's transaction")))))))
+
+;; Before the fix these passed too (nothing created schema); they pin that a dry run's schema is
+;; discarded with its throwaway copy, and that a refusal still answers 4xx naming the entry.
+(deftest dry-run-and-refusals-leave-no-schema-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self a b notes]}]
+        (p/let [food (request! self "POST" "/semantic/tags" {:title "Food"})
+                dry (request! self "POST" "/semantic/block-moves?dry-run=true"
+                              {:block-ids [(str a)] :target-id (str notes) :position "last-child"}
+                              :headers stamped)
+                _ (testing "a dry run"
+                    (is (= 200 (:status dry)) (pr-str dry))
+                    (is (no-schema? conn)))
+                before (snapshot conn)
+                single (request! self "PUT" (str "/semantic/blocks/" a "/properties/" (js/encodeURIComponent "block/tags"))
+                                 {:value "Journal"} :headers stamped)
+                batch (request! self "POST" "/semantic/block-properties/batch-set"
+                                {:entries [{:block-id (str b) :property-id "block/tags" :value "Food"}
+                                           {:block-id (str a) :property-id "block/tags" :value ["Journal"]}]}
+                                :headers stamped)]
+          (is (= 201 (:status food)))
+          (is (= 400 (:status single)) (pr-str single))
+          (is (string/starts-with? (str (get-in single [:body :error])) "Tags: "))
+          (is (= 400 (:status batch)) (pr-str batch))
+          (is (string/starts-with? (str (get-in batch [:body :error])) "entry 1: Tags: "))
+          (is (= before (snapshot conn)))
+          (is (no-schema? conn)))))))
