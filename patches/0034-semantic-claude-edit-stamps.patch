+(ns logseq.db-sync.semantic-edit-stamps-test
+  "Claude edit stamps (patch 0034), stage 1: the flag and the schema. A write whose request carries
+  x-logseq-edit-stamp: claude, from a real actor on a graph that isn't E2EE, creates two hidden
+  properties in its own transaction: editedBy (:user.property/claude-editedBy, a :default choice
+  property whose one choice, claude, has a fixed UUID) and claudeEditedAt
+  (:user.property/claude-editedAt, :datetime). A property that is in their way (a decoy titled
+  editedBy, an ident of the wrong type, the choice's UUID held elsewhere) refuses the write with a
+  409 before anything is stored. The probes at the top settle the spec's section 9 facts against
+  UPSTREAM_REF. Stage 2 (at the end): a flagged write stamps each block it creates or changes with
+  editedBy and claudeEditedAt in its own transaction, and the property tools refuse the two stamp
+  properties. Stage 3 (at the end): the first flagged write also creates a Claude Activity page with
+  a last-day and a last-week query block, unless a page, tag or property already holds that title.
+  The graph has a page Notes with blocks A, B and C."
+  (:require [cljs.test :refer [async deftest is testing]]
+            [clojure.string :as string]
+            [datascript.core :as d]
+            [logseq.common.util :as common-util]
+            [logseq.db :as ldb]
+            [logseq.db-sync.common :as common]
+            [logseq.db-sync.test-sql :as test-sql]
+            [logseq.db-sync.worker.auth :as auth]
+            [logseq.db-sync.worker.dispatch :as dispatch]
+            [logseq.db-sync.worker.handler.index :as index-handler]
+            [logseq.db-sync.worker.handler.sync :as sync-handler]
+            [logseq.db.common.normalize :as db-normalize]
+            [logseq.db.common.order :as db-order]
+            [logseq.db.common.view :as db-view]
+            [logseq.db.frontend.inputs :as db-inputs]
+            [logseq.db.frontend.property :as db-property]
+            [logseq.db.frontend.rules :as rules]
+            [logseq.db.frontend.validate :as db-validate]
+            [logseq.db.sqlite.export :as sqlite-export]
+            [logseq.outliner.core :as outliner-core]
+            [logseq.outliner.page :as outliner-page]
+            [logseq.outliner.property :as outliner-property]
+            [promesa.core :as p]))
+
+(def ^:private by-ident :user.property/claude-editedBy)
+(def ^:private at-ident :user.property/claude-editedAt)
+;; The patch's fixed UUID for the claude choice, pinned here so a change to it is seen.
+(def ^:private choice-uuid #uuid "3072a652-18e8-4dcb-bb37-e1aa38c8e3e9")
+
+(def ^:private actor
+  (js/encodeURIComponent
+   (js/JSON.stringify #js {"sub" "6f2c1a90-5b1e-4c7a-9d3e-2a1b0c9d8e7f"
+                           "cognito:username" "Owner" "email" "owner@example.com"})))
+
+(def ^:private signed [["x-logseq-sync-actor" actor]])
+(def ^:private stamped (conj signed ["x-logseq-edit-stamp" "claude"]))
+
+(defn- json-body [^js response]
+  (p/let [text (.text response)]
+    (when (seq text)
+      (try (js->clj (js/JSON.parse text) :keywordize-keys true)
+           (catch :default _ text)))))
+
+(defn- request!
+  "One semantic API request through the real handler; returns {:status :body}. `headers` is a list
+  of [name value] pairs, appended in order, so a name may repeat."
+  [self method path body & {:keys [headers e2ee? content-type raw-body]}]
+  (p/let [url (str "http://localhost" path (if (string/includes? path "?") "&" "?") "graph-id=graph-1"
+                   (when e2ee? "&graph-e2ee=true"))
+          js-headers (js/Headers. #js {"content-type" (or content-type "application/json")})
+          _ (doseq [[k v] headers] (.append js-headers k v))
+          response (sync-handler/handle-http
+                    self
+                    (js/Request. url (clj->js (cond-> {:method method :headers js-headers}
+                                                body (assoc :body (js/JSON.stringify (clj->js body)))
+                                                raw-body (assoc :body raw-body)))))
+          parsed (json-body response)]
+    {:status (.-status response) :body parsed}))
+
+(defn- snapshot
+  "What a refused call must leave unchanged: the graph's last tx and its datom count."
+  [conn]
+  {:max-tx (:max-tx @conn) :datoms (count (d/datoms @conn :eavt))})
+
+(defn- schema-entities [db]
+  {:by (d/entity db by-ident) :at (d/entity db at-ident) :choice (d/entity db [:block/uuid choice-uuid])})
+
+(defn- no-schema? [conn]
+  (every? nil? (vals (schema-entities @conn))))
+
+(defn- title [conn id] (:block/title (d/entity @conn [:block/uuid id])))
+
+(defn- title-tx
+  "The tx that last wrote block `id`'s title."
+  [conn id]
+  (:tx (first (d/datoms @conn :eavt (:db/id (d/entity @conn [:block/uuid id])) :block/title))))
+
+(defn- closed-values [db property]
+  (when property
+    (map #(d/entity db (:e %)) (d/datoms db :avet :block/closed-value-property (:db/id property)))))
+
+(defn- owners
+  "The idents of the properties the closed value `choice` belongs to (the attribute is many)."
+  [choice]
+  (set (map :db/ident (:block/closed-value-property choice))))
+
+(defn- holders-of
+  "The entities holding a value of the property `ident` (read from :eavt, since the attribute may
+  not exist yet)."
+  [db ident]
+  (filter #(= ident (:a %)) (d/datoms db :eavt)))
+
+(defn- raw-page [id page-title & {:as more}]
+  (merge {:block/uuid id :block/name (string/lower-case page-title) :block/title page-title
+          :block/tags #{:logseq.class/Page} :block/created-at 1 :block/updated-at 1}
+         more))
+
+(defn- seed-graph
+  "A graph with page Notes holding blocks A, B and C. `ids` fixes their UUIDs ([notes a b c]), so
+  two graphs can be compared."
+  [& [ids]]
+  (let [conn (sqlite-export/create-conn)
+        deleted (atom [])
+        bucket #js {:put (fn [_ _ _] (p/resolved #js {}))
+                    :delete (fn [key] (swap! deleted conj key) (p/resolved nil))}
+        self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true
+                  :env #js {"TIMEZONE" "UTC" "LOGSEQ_SYNC_ASSETS" bucket}}
+        [notes a b c] (or ids (repeatedly 4 random-uuid))]
+    (d/transact! conn [(raw-page notes "Notes")])
+    (d/transact! conn (map-indexed (fn [i [id t]]
+                                     {:block/uuid id :block/title t :block/order (str "a" i)
+                                      :block/page [:block/uuid notes] :block/parent [:block/uuid notes]
+                                      :block/created-at 1 :block/updated-at 1})
+                                   [[a "A"] [b "B"] [c "C"]]))
+    {:conn conn :self self :notes notes :a a :b b :c c :deleted deleted}))
+
+(defn- with-graph [done run]
+  (-> (p/let [graph (seed-graph)] (run graph))
+      (p/catch #(is false (str % (some-> % .-stack))))
+      (p/finally done)))
+
+(defn- update-block! [self id text headers]
+  (request! self "PATCH" (str "/semantic/blocks/" id) {:title text} :headers headers))
+
+(defn- validation-errors
+  "db validation errors for the entities `ids`."
+  [db ids]
+  (let [ids (set ids)]
+    (filter #(contains? ids (:db/id (:entity %))) (:errors (db-validate/validate-db db)))))
+
+;; ---------------------------------------------------------------------------------------------
+;; Probes (spec section 9, step 1). Each settles a fact about UPSTREAM_REF; the result is recorded
+;; in the spec's "As built" notes.
+
+(defn- ok-json-response []
+  (js/Response. (js/JSON.stringify #js {:ok true})
+                #js {:status 200 :headers #js {"content-type" "application/json"}}))
+
+;; Before the fix the request reached the DO with both headers, but the write created no schema:
+;;   expected: (some? (:by (schema-entities @conn)))  actual: (not (some? nil))
+(deftest header-survives-dispatch-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn a]}]
+        (let [forwarded (atom [])
+              handler-self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true
+                                :env #js {"TIMEZONE" "UTC"}}
+              env #js {"DB" #js {}
+                       "SEMANTIC_WRITE_RATE_LIMITER" #js {:limit (fn [_] (p/resolved #js {:success true}))}
+                       "LOGSEQ_SYNC_DO" #js {:idFromName identity
+                                             :get (fn [_]
+                                                    #js {:fetch (fn [request]
+                                                                  (swap! forwarded conj request)
+                                                                  (sync-handler/handle-http handler-self request))})}}
+              request (js/Request. (str "http://localhost/api/v1/graphs/graph-1/blocks/" a)
+                                   #js {:method "PATCH"
+                                        :headers #js {"authorization" "Bearer semantic-token"
+                                                      "content-type" "application/json"
+                                                      "x-logseq-edit-stamp" "claude"
+                                                      ;; A caller's own actor header is replaced.
+                                                      "x-logseq-sync-actor" "%7B%22sub%22%3A%22spoofed%22%7D"}
+                                        :body (js/JSON.stringify #js {:title "A via dispatch"})})
+              claims #js {"sub" "6f2c1a90-5b1e-4c7a-9d3e-2a1b0c9d8e7f" "scope" "logseq/write"
+                          "cognito:username" "Owner" "email" "owner@example.com"}]
+          (p/with-redefs [auth/auth-claims (fn [_ _] (p/resolved claims))
+                          index-handler/graph-access-response (fn [_ _ _] (p/resolved (ok-json-response)))
+                          common/<d1-all (fn [& _] (p/resolved #js {:results #js [#js {:graph_e2ee 0}]}))]
+            (p/let [response (dispatch/handle-worker-fetch request env)
+                    seen (first @forwarded)]
+              (is (= 200 (.-status response)))
+              (is (= 1 (count @forwarded)))
+              (is (= "claude" (some-> seen .-headers (.get "x-logseq-edit-stamp"))))
+              (is (= "6f2c1a90-5b1e-4c7a-9d3e-2a1b0c9d8e7f"
+                     (some-> seen .-headers (.get "x-logseq-sync-actor") js/decodeURIComponent js/JSON.parse
+                             (aget "sub"))))
+              (is (= "A via dispatch" (title conn a)))
+              (is (some? (:by (schema-entities @conn))) "the DO handler read the stamp header"))))))))
+
+;; Probe: db validation accepts a :user.property/ ident without upstream's random suffix, and a
+;; closed value with a UUID chosen by the caller. So the :plugin.property.claude/ fallback isn't
+;; needed.
+(deftest fixed-user-property-ident-validates-test
+  (let [conn (sqlite-export/create-conn)
+        by (outliner-property/upsert-property! conn by-ident {:logseq.property/type :default
+                                                              :db/cardinality :db.cardinality/one}
+                                               {:property-name "editedBy"
+                                                :properties {:logseq.property/hide? true}})
+        _ (outliner-property/upsert-closed-value! conn by-ident {:id choice-uuid :value "claude"})
+        at (outliner-property/upsert-property! conn at-ident {:logseq.property/type :datetime}
+                                               {:property-name "claudeEditedAt"
+                                                :properties {:logseq.property/hide? true}})
+        choice (d/entity @conn [:block/uuid choice-uuid])]
+    (is (= by-ident (:db/ident by)) "no random suffix")
+    (is (= at-ident (:db/ident at)))
+    (is (= #{by-ident} (owners choice)))
+    (is (empty? (validation-errors @conn [(:db/id by) (:db/id at) (:db/id choice)])))))
+
+;; Probe: hide? only hides a property in the app's block view; an advanced query over the ident,
+;; raw or through the query DSL's property rule, still matches the block.
+(deftest hidden-property-still-matches-an-advanced-query-test
+  (let [conn (sqlite-export/create-conn)
+        page (random-uuid)
+        block (random-uuid)
+        _ (outliner-property/upsert-property! conn by-ident {:logseq.property/type :default}
+                                              {:property-name "editedBy"
+                                               :properties {:logseq.property/hide? true}})
+        _ (outliner-property/upsert-closed-value! conn by-ident {:id choice-uuid :value "claude"})
+        _ (outliner-property/upsert-property! conn at-ident {:logseq.property/type :datetime}
+                                              {:property-name "claudeEditedAt"
+                                               :properties {:logseq.property/hide? true}})
+        _ (d/transact! conn [(raw-page page "Notes")])
+        _ (d/transact! conn [{:block/uuid block :block/title "stamped" :block/order "a0"
+                              :block/page [:block/uuid page] :block/parent [:block/uuid page]
+                              :block/created-at 1 :block/updated-at 1}])
+        choice-id (:db/id (d/entity @conn [:block/uuid choice-uuid]))
+        _ (d/transact! conn [[:db/add [:block/uuid block] by-ident choice-id]
+                             [:db/add [:block/uuid block] at-ident 1700000000000]])
+        raw (d/q '[:find [?uuid ...]
+                   :in $ ?choice
+                   :where [?b :user.property/claude-editedBy ?choice]
+                   [?b :user.property/claude-editedAt ?t]
+                   [?b :block/uuid ?uuid]]
+                 @conn [:block/uuid choice-uuid])
+        dsl (d/q '[:find [?uuid ...]
+                   :in $ %
+                   :where (property ?b :user.property/claude-editedBy "claude")
+                   [?b :block/uuid ?uuid]]
+                 @conn (rules/extract-rules rules/db-query-dsl-rules [:property]
+                                            {:deps rules/rules-dependencies}))]
+    (is (true? (:logseq.property/hide? (d/entity @conn by-ident))))
+    (is (= [block] raw))
+    (is (= [block] dsl))))
