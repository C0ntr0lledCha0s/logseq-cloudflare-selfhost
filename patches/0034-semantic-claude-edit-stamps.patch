+;; Probe: which relative time inputs the query engine at UPSTREAM_REF resolves, and to what.
+;; claudeEditedAt holds epoch milliseconds, so Stage 3's windows need inputs that resolve to a
+;; number of milliseconds: :-1d-ms and :-7d-ms (midnight, local time, 1 and 7 days back) and
+;; :right-now-ms. :-1d and :-7d resolve to a YYYYMMDD day (for journal days), :today to today's
+;; day, and :1d-before is the deprecated spelling of :-1d.
+(deftest query-time-inputs-test
+  (let [db @(sqlite-export/create-conn)
+        resolve (fn [input] (db-inputs/resolve-input db input {}))
+        day? (fn [v] (and (integer? v) (<= 19000101 v 30001231)))
+        ms? (fn [v] (and (integer? v) (> v 1000000000000)))
+        now (.now js/Date)
+        midnight (fn [days-back] (.setHours (js/Date. (- now (* days-back 86400000))) 0 0 0 0))]
+    (testing "inputs that resolve to a day"
+      (doseq [input [:-1d :-7d :today :1d-before :7d-before]]
+        (is (day? (resolve input)) (str input))))
+    (testing "inputs that resolve to epoch milliseconds"
+      (doseq [input [:-1d-ms :-7d-ms :right-now-ms :start-of-today-ms :1d-before-ms]]
+        (is (ms? (resolve input)) (str input))))
+    (testing ":-Nd-ms is local midnight N days back, so the day view starts at yesterday 00:00"
+      (is (= (midnight 1) (resolve :-1d-ms)))
+      (is (= (midnight 7) (resolve :-7d-ms))))
+    (testing "an unknown input comes back unresolved"
+      (is (= :-1h-ms (resolve :-1h-ms))))))
+
+;; ---------------------------------------------------------------------------------------------
+;; The flag and the schema.
+
+;; Before the fix the write succeeded and created nothing:
+;;   expected: (= "editedBy" (:block/title by))  actual: (not (= "editedBy" nil))
+(deftest first-stamped-write-creates-the-hidden-schema-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self a]}]
+        (p/let [response (update-block! self a "A edited" stamped)
+                db @conn
+                {:keys [by at choice]} (schema-entities db)
+                write-tx (title-tx conn a)
+                schema-ids [(:db/id by) (:db/id at) (:db/id choice)]]
+          (is (= 200 (:status response)))
+          (is (= "A edited" (title conn a)))
+          (testing "editedBy"
