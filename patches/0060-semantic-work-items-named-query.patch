+(defn work-items
+  "LC-138: the entities tagged tag (or a tag extending it) that aren't private, each tagged datom
+  charged to :items. open (default true, but false when number is given) keeps those whose status
+  isn't Done or Canceled; number keeps the one whose number_property value is it; parent keeps
+  those whose parent_property value is parent, or whose parent block or page is. Each row is
+  [order number status priority phase components depends-on item]: number from number_property,
+  status and priority by title, phase and components by their values' titles, and depends-on as
+  each dependency's number (its title when it has none). Sorted by priority (Urgent first, none
+  last) then number, by number, or by number descending; order is the row's place in that sort.
+  An optional property the graph doesn't have (phase_property, component_property,
+  depends_property, parent_property) gives empty values."
+  [ctx {:keys [tag parent open number sort number_property parent_property component_property
+               phase_property depends_property]}]
+  (let [{:keys [db]} ctx
+        private? (private-fn ctx)
+        finished (into #{} (keep #(d/entid db %)) [:logseq.property/status.done :logseq.property/status.canceled])
+        title-of (fn [e] (or (first-value* ctx e :block/title) ""))
+        refs (fn [e attr] (if attr (visible-values ctx private? e attr) []))
+        number-of (fn [e]
+                    (when number_property
+                      (when-let [v (first-value* ctx e number_property)]
+                        (if (number? (first-value* ctx v :logseq.property/value))
+                          (first-value* ctx v :logseq.property/value)
+                          nil))))
+        open? (if (some? open) open (nil? number))
+        rows (into []
+                   (keep (fn [e]
+                           (let [status (first-value* ctx e :logseq.property/status)
+                                 n (number-of e)]
+                             (when (and (not (private? e))
+                                        (or (not open?) (not (contains? finished status)))
+                                        (or (nil? number) (= number n))
+                                        (or (nil? parent)
+                                            (some #(= parent %) (refs e parent_property))
+                                            (= parent (first-value* ctx e :block/parent))
+                                            (= parent (first-value* ctx e :block/page))))
+                               (let [priority (first-value* ctx e :logseq.property/priority)
+                                     rank (get priority-rank (some->> priority (#(first-value* ctx % :db/ident))) 4)]
+                                 {:e e :number n :rank rank
+                                  :status (some-> status title-of)
+                                  :priority (some-> priority title-of)
+                                  :phase (some-> (first (refs e phase_property)) title-of)
+                                  :components (mapv title-of (refs e component_property))
+                                  :depends (mapv #(or (number-of %) (title-of %)) (refs e depends_property))})))))
+                   (tagged ctx private? tag :items))
+        big js/Number.MAX_SAFE_INTEGER
+        sorted (sort-by (case sort
+                          "number" (fn [r] [(or (:number r) big) (:e r)])
+                          "number-desc" (fn [r] [(- (or (:number r) (- big))) (:e r)])
+                          (fn [r] [(:rank r) (or (:number r) big) (:e r)]))
+                        rows)]
+    (vec (map-indexed (fn [i {:keys [e number status priority phase components depends]}]
+                        [(inc i) number status priority phase components depends e])
+                      sorted))))
+
