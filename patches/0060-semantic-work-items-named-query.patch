+(defn- resolve-entity-param
+  "An :entity param's value (LC-138's parent): the db id of the one visible page or block `value`
+  names, by UUID or by title as client-candidates finds it (a page wins over blocks of the same
+  title), echoed as {:title :uuid}. Refused, naming params.<name>, when it names none or several."
+  [db private? {param-name :name} value]
+  (let [field (str "params." param-name)
+        found (fn [e] {:input (:db/id e) :echo {:title (or (:block/title e) "") :uuid (str (:block/uuid e))}})]
+    (cond
+      (or (not (string? value)) (= "" value)) {:error (str field ": must be a page or block title or UUID (a string)")}
+      (common-util/uuid-string? value)
+      (let [e (d/entity db [:block/uuid (uuid (string/lower-case value))])]
+        (if (and e (not (entity-util/hidden? e)) (not (private? (:db/id e))))
+          (found e)
+          {:error (str field ": no page or block with UUID " value)}))
+      :else
+      (let [candidates (client-candidates db value private?)
+            pages (filter #(= "page" (client-kind %)) candidates)]
+        (cond
+          (empty? candidates) {:error (str field ": no page or block titled " (pr-str value))}
+          (empty? (next candidates)) (found (first candidates))
+          (= 1 (count pages)) (found (first pages))
+          :else {:error (str field ": " (pr-str value) " matches " (count candidates) " entities; give the one you mean by UUID")})))))
+
