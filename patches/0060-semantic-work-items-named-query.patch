diff --git a/deps/db-sync/test/logseq/db_sync/semantic_work_items_query_test.cljs b/deps/db-sync/test/logseq/db_sync/semantic_work_items_query_test.cljs
new file mode 100644
index 0000000..efd3ee0
--- /dev/null
+++ b/deps/db-sync/test/logseq/db_sync/semantic_work_items_query_test.cljs
@@ -0,0 +1,123 @@
+(ns logseq.db-sync.semantic-work-items-query-test
+  "run_named_query work-items (LC-138): one row per work item (blocks tagged Work Item, or a tag
+  extending it), with its number, status, priority, phase, components and dependencies, matched by
+  property title so any graph can use it. Open items by default, ordered by priority then number;
+  number picks one item whatever its status; sort number-desc with limit 1 gives the highest number;
+  parent keeps the items under one page or Epic; private items never appear."
+  (:require [cljs.test :refer [async deftest is testing]]
+            [clojure.string :as string]
+            [datascript.core :as d]
+            [logseq.db-sync.test-sql :as test-sql]
+            [logseq.db-sync.worker.handler.sync :as sync-handler]
+            [logseq.db.sqlite.export :as sqlite-export]
+            [logseq.outliner.page :as outliner-page]
+            [promesa.core :as p]))
+
+(defn- request!
+  [self method path body]
+  (p/let [url (str "http://localhost" path (if (string/includes? path "?") "&" "?") "graph-id=graph-1")
+          response (sync-handler/handle-http
+                    self
+                    (js/Request. url (clj->js (cond-> {:method method
+                                                       :headers {"content-type" "application/json"}}
+                                                (some? body) (assoc :body (js/JSON.stringify (clj->js body)))))))
+          text (.text response)]
+    {:status (.-status response)
+     :body (when (seq text)
+             (try (js->clj (js/JSON.parse text) :keywordize-keys true)
+                  (catch :default _ text)))}))
+
+(defn- ok! [response status]
+  (p/let [response response]
+    (is (= status (:status response)) (pr-str response))
+    response))
+
+(defn- with-items
+  "A tracker page with Work Item, Bug (extends it), Epic (extends it) and Private, the properties
+  itemNumber (number), component (text, many), dependsOn (node, many) and parent-work (node), and:
+  LC-1 Work Item, Low, Backlog; LC-2 Bug, Done; LC-3 Bug, High, Todo, component api, dependsOn
+  LC-1; LC-4 Epic, Medium, Todo; LC-5 Bug under epic LC-4 (parent-work), Medium, Doing; LC-6 Bug
+  tagged Private too; and a plain Task with no Work Item tag."
+  [done run]
+  (-> (p/let [conn (sqlite-export/create-conn)
+              [_ page-id] (outliner-page/create! conn "Tracker" {})
+              self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true}
+              _ (ok! (request! self "POST" "/semantic/tags" {:title "Work Item" :extends ["logseq.class/Task"]}) 201)
+              _ (ok! (request! self "POST" "/semantic/tags" {:title "Bug" :extends ["Work Item"]}) 201)
+              _ (ok! (request! self "POST" "/semantic/tags" {:title "Epic" :extends ["Work Item"]}) 201)
+              _ (ok! (request! self "POST" "/semantic/tags" {:title "Private"}) 201)
+              _ (ok! (request! self "POST" "/semantic/properties" {:title "itemNumber" :type "number"}) 201)
+              _ (ok! (request! self "POST" "/semantic/properties" {:title "component" :type "default" :cardinality "db.cardinality/many"}) 201)
+              _ (ok! (request! self "POST" "/semantic/properties" {:title "dependsOn" :type "node" :cardinality "db.cardinality/many"}) 201)
+              _ (ok! (request! self "POST" "/semantic/properties" {:title "parent-work" :type "node"}) 201)
+              item (fn [n tags status priority & {:as more}]
+                     {:title (str "LC-" n ": item " n)
+                      :properties (merge {"Tags" tags "itemNumber" n "logseq.property/status" status}
+                                         (when priority {"logseq.property/priority" priority})
+                                         more)})
+              _ (ok! (request! self "POST" "/semantic/block-trees"
+                               {:target-id (str page-id)
+                                :blocks [(item 1 ["Work Item"] "Backlog" "Low")
+                                         (item 2 ["Bug"] "Done" "High")
+                                         (item 4 ["Epic"] "Todo" "Medium")
+                                         (item 6 ["Bug" "Private"] "Todo" "High")
+                                         {:title "plain task" :properties {"logseq.property/status" "Todo"}}]})
+                     201)
+              uuid-of (fn [title] (str (:block/uuid (d/entity @conn (ffirst (d/q '[:find ?b :in $ ?t :where [?b :block/title ?t]] @conn title))))))
+              _ (ok! (request! self "POST" "/semantic/block-trees"
+                               {:target-id (str page-id)
+                                :blocks [(item 3 ["Bug"] "Todo" "High" "component" ["api"] "dependsOn" [(uuid-of "LC-1: item 1")])
+                                         (item 5 ["Bug"] "Doing" "Medium" "parent-work" (uuid-of "LC-4: item 4"))]})
+                     201)]
+        (run {:self self :conn conn :uuid-of uuid-of}))
+      (p/catch #(is false (str "unexpected error: " %)))
+      (p/finally done)))
+
+(defn- work-items! [self params & {:keys [limit]}]
+  (request! self "POST" "/semantic/named-queries/work-items" (cond-> {:params params} limit (assoc :limit limit))))
+
+(defn- numbers [response]
+  (let [columns (get-in response [:body :columns])
+        i (.indexOf (clj->js columns) "number")]
+    (mapv #(nth % i) (get-in response [:body :rows]))))
+
+(deftest work-items-lists-open-items-by-priority-then-number-test
+  (async done
+    (with-items done
+      (fn [{:keys [self uuid-of]}]
+        (p/let [response (work-items! self {})]
+          (is (= 200 (:status response)) (pr-str (:body response)))
+          (is (= ["order" "number" "status" "priority" "phase" "component" "depends-on" "item"] (get-in response [:body :columns])))
+          (is (= [3 4 5 1] (numbers response)) "High, then Medium by number, then Low; Done, private and untagged left out")
+          (testing "each row carries its values, and the item's uuid and title"
+            (let [[order number status priority _phase component depends item] (first (get-in response [:body :rows]))]
+              (is (= [1 3 "Todo" "High" ["api"] [1]] [order number status priority component depends]))
+              (is (= {:block/uuid (uuid-of "LC-3: item 3") :block/title "LC-3: item 3"} item)))))))))
+
+(deftest work-items-number-sort-tag-and-parent-test
+  (async done
+    (with-items done
+      (fn [{:keys [self]}]
+        (p/let [by-number (work-items! self {:number 2})
+                highest (work-items! self {:sort "number-desc"} :limit 1)
+                with-done (work-items! self {:open false})
+                bugs (work-items! self {:tag "Bug"})
+                epic (work-items! self {:parent "LC-4: item 4"})]
+          (is (= [2] (numbers by-number)) "number finds the item whatever its status")
+          (is (= [5] (numbers highest)) "number-desc with limit 1 gives the highest number among open items")
+          (is (= [2 3 4 5 1] (numbers with-done)) "open false keeps Done items too")
+          (is (= [3 5] (numbers bugs)) "a tag keeps its own items and those of tags extending it")
+          (is (= [5] (numbers epic)) "parent keeps the items whose parent-work is that block"))))))
+
+(deftest work-items-refuses-bad-params-naming-them-test
+  (async done
+    (with-items done
+      (fn [{:keys [self]}]
+        (p/let [responses (p/all [(work-items! self {:sort "newest"})
+                                  (work-items! self {:number "two"})
+                                  (work-items! self {:open "yes"})
+                                  (work-items! self {:parent "no such page"})
+                                  (work-items! self {:number_property "noSuchProperty"})])]
+          (doseq [[param {:keys [status body]}] (map vector ["sort" "number" "open" "parent" "number_property"] responses)]
+            (is (= 400 status) (str param ": " (pr-str body)))
+            (is (string/includes? (str (:error body)) (str "params." param)) (str param ": " (pr-str body)))))))))
