+        post (get-in document [:paths "/api/v1/graphs/{graph-id}/query" :post])
+        truncated (get-in document [:components :schemas :DatalogQueryResponse :properties :truncated])]
+    (doseq [phrase ["scan cap" "20,000 datoms" "422" "truncated" "byte-cap" "100,000 characters" "at most 2 levels deep"
+                    "at most 50 values" "refs as numbers" "left recursion" "row cap" "2,500 rows"
+                    "20,000 rows while joining (the join cap" "(the value cap)" "Recycle bin"
+                    "str, + and keyword take at most one ?variable" "at most 20 values and 4,000 characters"
+                    "(at most 4,000 characters)" "each character of text inside them counts as a value"]]
+      (is (string/includes? (:description post) phrase) phrase))
+    (testing "query, inputs and rules each carry the 4,000-character cap, so the connector refuses a longer one early"
+      (let [props (get-in post [:requestBody :content "application/json" :schema :properties])]
+        (is (= [4000 4000 4000] (mapv #(get-in props [% :maxLength]) [:query :inputs :rules])) (pr-str props))))
+    (is (= ["limit" "byte-cap"] (get-in truncated [:properties :by :enum])))
+    (is (string/includes? (get-in post [:responses "422" :description] "") "scan cap"))
+    (is (string/includes? (get-in post [:responses "422" :description] "") "20,000 datoms"))
+    (is (string/includes? (get-in post [:responses "422" :description] "") "2,500 rows (the row cap)"))
+    (testing "the tool text says which named query can reach the scan cap, and how a walk up stays under it"
+      (let [named (get-in document [:paths "/api/v1/graphs/{graph-id}/named-queries/{name}" :post :description])]
+        (is (not (string/includes? (:description post) "stay within the caps")))
+        (is (string/includes? (:description post) "[(get-some $ ?b :block/parent) [_ ?x]]"))
+        (is (string/includes? named "more than about 20,000 blocks it can answer 422"))))))
+
