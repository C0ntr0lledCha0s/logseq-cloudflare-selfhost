@@ -0,0 +1,427 @@
+(ns logseq.db-sync.worker.named-queries
+  "The named queries runNamedQuery runs (patch 0039), as server code that walks Datascript's
+  indexes, not as Datalog. Each entry is {:title :description :columns :bounds :run :params}; the
+  handler resolves the params (each {:name :type :default :bounds}, or :required instead of a
+  default) and calls run-named on the db value, never the conn:
+
+  - :tag resolves by UUID, ident or title (case-insensitive) to the tag and every tag extending it;
+  - :property resolves by UUID, ident or title to the property's ident (:types limits its type);
+  - :days is an integer within :bounds and becomes a cutoff in ms (now less that many days).
+
+  What each walk reads, and the bound that stops it (default-bounds, set by the bench):
+
+  - projects-untouched reads the entities tagged tag through AVET (:tagged), keeps the stale pages
+    that aren't private, and reads each one's blocks through AVET :block/page (:page-blocks),
+    stopping at the first fresh block that isn't private;
+  - meetings-without-decision reads the entities tagged meeting_tag created within days
+    (:meetings), then the entities tagged decision_tag (:decisions), and walks up :block/parent
+    from each decision that isn't private into one shared set (:ancestor-steps), through its page
+    and any page above it, so a decision at any depth costs one step per ancestor no other walk has
+    reached;
+  - open-tasks-by-client reads the entities tagged Task (:tasks), and for each open one (:open-tasks)
+    its client_property values, else its page's;
+  - pages-missing-property reads the entities tagged tag (:tagged) and each page's property values.
+
+  Every datom read goes through datoms* or first-value* and counts toward :reads (the backstop over
+  every read, privacy walks included); a candidate bound counts candidates only, so it can stop a
+  query before :reads does. A charge past any bound throws {::bound {:query :bound
+  :value}}, which the handler answers with bound-message's 422; no rows found so far are returned.
+  Nothing reads the clock: the Worker's does not move during synchronous work.
+
+  Privacy follows the handler's private filter without building the private set: private? (built
+  per request by private-fn) answers as (contains? (private-ids db) e) does, so a private or
+  recycled entity is never a candidate, and visible-ref? hides a ref value (a tag, a client, a
+  property value) to one, as d/filter hid its datom."
+  (:require [clojure.string :as string]
+            [datascript.core :as d]
+            [logseq.db-sync.worker.graph-insights :as graph-insights]))
+
+;; Counted index reads
+;; ===================
+;;
+;; A named query walks Datascript's indexes through a context `ctx`, {:db :query :bounds :work}:
+;; the db value (never the conn), the query's name, its bounds (a map of bound name to number) and
+;; :work, a volatile map of what each bound has counted so far. Every datom read goes through
+;; datoms* or first-value*, which charge :reads, and a query charges its candidate bounds itself
+;; with charge!, which counts toward that bound only. A charge that passes a bound throws, so work is bounded by counts, never by the
+;; clock (which does not move during synchronous CPU work in a Worker).
+
+(def default-bounds
+  "Each bound's value, set from the release bundle (scripts/release-query-check.mjs and the bench's
+  --named mode). :reads is the backstop over every read, privacy walks included: a counted read
+  costs about 4 us there (3.6 to 4.8 us warm, by query), so 100,000 reads took 360 to 480 ms and
+  meetings-without-decision on 20,000 pages unbounded took 800 ms, while at 30,000 reads each query
+  stops after 90 to 120 ms. The rest count a query's candidates only, never toward :reads, so each
+  can stop its query before the backstop does: a task and its status, a block and its updated-at,
+  or a tagged decision cost 1 or 2 reads, so 10,000 of them are at most 20,000 reads. A shape that
+  reads more per candidate (about 12 per tagged page and per meeting, 10 to 17 per open task, 5 or
+  more per decision walked up its parents) can meet the backstop first, and its advice fits the
+  query."
+  {:meetings 2000
+   :decisions 10000
+   :ancestor-steps 10000
+   :tagged 2500
+   :page-blocks 10000
+   :tasks 10000
+   :open-tasks 2000
+   :reads 30000})
+
+(defn- bump! [{:keys [bounds work] :as ctx} bound n]
+  (let [limit (get bounds bound)
+        counted (get (vswap! work update bound (fnil + 0) n) bound)]
+    (when (nil? limit)
+      (throw (js/Error. (str "named query: no bound " bound))))
+    (when (> counted limit)
+      (throw (ex-info (str (:query ctx) " stopped at its " (name bound) " bound")
+                      {::bound {:query (:query ctx) :bound bound :value limit}})))))
+
+(defn charge!
+  "Counts `n` toward `bound` only: :reads counts the datoms read (datoms*, first-value*), not the
+  candidates a query charges, so a candidate bound can stop a query before :reads does. Past the
+  bound, throws (ex-info … {::bound {:query :bound :value}}) naming it and its value: at the bound
+  is allowed, one past it is not."
+  [ctx bound n]
+  (bump! ctx bound n))
+
+(defn datoms*
+  "d/datoms over `index` and `components`, as a lazy sequence that charges one read per datom
+  realised, not for the range: taking 3 of 10 charges 3."
+  [ctx index & components]
+  (letfn [(step [s]
+            (lazy-seq
+             (when-let [s (seq s)]
+               (charge! ctx :reads 1)
+               (cons (first s) (step (rest s))))))]
+    (step (apply d/datoms (:db ctx) index components))))
+
+(defn first-value*
+  "The first value of `attr` on entity `e`, or nil; charges one read."
+  [ctx e attr]
+  (charge! ctx :reads 1)
+  (:v (first (d/datoms (:db ctx) :eavt e attr))))
+
+;; Privacy without the private set
+;; ===============================
+
+(defn private-fn
+  "A memoised `private?` for one request, giving the answer (contains? (private-ids db) e) gives
+  without building the set. An entity is a root when it has deleted-at (the Recycle bin) or a tag
+  that is a class whose lineage (the class and every class it extends) holds one titled private
+  in any case; it is private when it is a root or its :block/parent or :block/page is private. The
+  walk up is iterative, each read charged to :reads, and memoised, so each distinct ancestor costs
+  one walk per request; each class's verdict is memoised too."
+  [{:keys [db] :as ctx}]
+  (let [lineage (graph-insights/class-lineage-fn db)
+        tag-class (d/entid db :logseq.class/Tag)
+        class-memo (volatile! {})
+        private-class? (fn [c]
+                         (let [known (get @class-memo c ::unknown)]
+                           (if (not= ::unknown known)
+                             known
+                             (let [_ (charge! ctx :reads 1)
+                                   class? (some? (first (d/datoms db :eavt c :block/tags tag-class)))
+                                   classes (when class? (lineage c))
+                                   _ (charge! ctx :reads (count classes))
+                                   v (boolean (some #(= "private" (some-> (:block/title %) string/lower-case)) classes))]
+                               (vswap! class-memo assoc c v)
+                               v))))
+        root? (fn [e]
+                (or (some? (first-value* ctx e :logseq.property/deleted-at))
+                    (boolean (some (comp private-class? :v) (datoms* ctx :eavt e :block/tags)))))
+        memo (volatile! {})]
+    (fn private? [e]
+      (let [known (get @memo e)]
+        (if (some? known)
+          known
+          ;; Depth first up the parent and page edges, with an explicit stack: an entity is decided
+          ;; once both its parent and its page are. An entity met again while its own walk is open
+          ;; (a cycle, which the outliner never writes) counts as not private for that edge.
+          (loop [stack [e] open {}]
+            (if-let [x (peek stack)]
+              (cond
+                (contains? @memo x) (recur (pop stack) open)
+                (contains? open x)
+                (let [ups (get open x)
+                      v (boolean (some #(get @memo %) ups))]
+                  (vswap! memo assoc x v)
+                  (recur (pop stack) (dissoc open x)))
+                (root? x) (do (vswap! memo assoc x true) (recur (pop stack) open))
+                :else
+                (let [ups (keep identity [(first-value* ctx x :block/parent) (first-value* ctx x :block/page)])
+                      todo (remove #(or (contains? @memo %) (contains? open %)) ups)]
+                  (recur (into stack todo) (assoc open x ups))))
+              (get @memo e))))))))
+
+(defn visible-ref?
+  "True when ref value `v` may be shown: where d/filter hid a ref datom to a private entity (tags,
+  client values, property values), a named query asks this."
+  [private? v]
+  (not (private? v)))
+
+;; The four queries
+;; =================
+;;
+;; Each walk takes `ctx` and the resolved inputs by param name (a tag param is its id and the ids of
+;; the tags extending it, a property param its ident, days a cutoff in ms) and returns rows of
+;; [sort-key eid], or [eid]; the handler sorts them, cuts them to limit and pulls the kept rows.
+;; Each charges its candidate bounds as it reaches a candidate, before working on it.
+
+(defn- tagged
+  "The distinct entities tagged with one of `tag-ids`, in index order; a private tag is left out, as
+  the private filter hid its datoms. With `bound`, each tagged datom read is charged to it."
+  [ctx private? tag-ids bound]
+  (let [seen (volatile! #{})]
+    (persistent!
+     (reduce (fn [acc tag]
+               (if (private? tag)
+                 acc
+                 (reduce (fn [acc datom]
+                           (when bound (charge! ctx bound 1))
+                           (let [e (:e datom)]
+                             (if (contains? @seen e)
+                               acc
+                               (do (vswap! seen conj e) (conj! acc e)))))
+                         acc (datoms* ctx :avet :block/tags tag))))
+             (transient []) (distinct (seq tag-ids))))))
+
+(defn- ref-attr? [db attr] (= :db.type/ref (get-in (d/schema db) [attr :db/valueType])))
+
+(defn- visible-values
+  "`e`'s values of `attr` that the private filter would show: a ref value only when it isn't private."
+  [ctx private? e attr]
+  (let [ref? (ref-attr? (:db ctx) attr)]
+    (into [] (comp (map :v) (filter #(or (not ref?) (visible-ref? private? %)))) (datoms* ctx :eavt e attr))))
+
+(defn- stamp [ctx e attr] (or (first-value* ctx e attr) 0))
+
+(defn projects-untouched
+  "Pages tagged tag (or a tag extending it) whose own updated-at is before the cutoff, with no
+  block on the page updated since that isn't private: each tagged entity is charged to :tagged and
+  each block read on a stale page to :page-blocks, stopping at the first fresh one. Rows
+  [updated-at page]."
+  [ctx {:keys [tag days]}]
+  (let [private? (private-fn ctx)
+        cutoff days
+        fresh? (fn [b]
+                 (and (>= (stamp ctx b :block/updated-at) cutoff)
+                      (not (private? b))))]
+    (into []
+          (keep (fn [p]
+                  (when (nil? (first-value* ctx p :block/page))
+                    (let [updated (stamp ctx p :block/updated-at)]
+                      (when (and (< updated cutoff)
+                                 (not (private? p))
+                                 (not (some (fn [datom] (charge! ctx :page-blocks 1) (fresh? (:e datom)))
+                                            (datoms* ctx :avet :block/page p))))
+                        [updated p])))))
+          (tagged ctx private? tag :tagged))))
+
+(defn meetings-without-decision
+  "Pages and blocks tagged meeting_tag (or a tag extending it) created at or after the cutoff that
+  aren't private, each charged to :meetings, with no block or page tagged decision_tag below them.
+  Every decision that isn't private, each tagged datom charged to :decisions, is walked up
+  :block/parent into one shared set, each step charged to :ancestor-steps: through its blocks, its
+  page and any page that page sits under (a namespace child's :block/parent is its parent page), as
+  the Datalog's above rule walked. A walk stops at the first ancestor already in the set, and the
+  decision itself goes in only as another decision's ancestor. A meeting not in the set is a row
+  [created-at meeting], at any depth."
+  [ctx {:keys [meeting_tag decision_tag days]}]
+  (let [private? (private-fn ctx)
+        candidates (into []
+                         (keep (fn [m]
+                                 (let [created (stamp ctx m :block/created-at)]
+                                   (when (>= created days)
+                                     (charge! ctx :meetings 1)
+                                     (when-not (private? m) [created m])))))
+                         (tagged ctx private? meeting_tag nil))]
+    (if (empty? candidates)
+      []
+      (let [decided (volatile! #{})]
+        (doseq [d (tagged ctx private? decision_tag :decisions)]
+          (when-not (private? d)
+            (loop [x (first-value* ctx d :block/parent)]
+              (when (and (some? x) (not (contains? @decided x)))
+                (charge! ctx :ancestor-steps 1)
+                (vswap! decided conj x)
+                (recur (first-value* ctx x :block/parent))))))
+        (into [] (remove (fn [[_ m]] (contains? @decided m))) candidates)))))
+
+(defn open-tasks-by-client
+  "Blocks tagged Task (only Task, as the Datalog matched it), each charged to :tasks, whose status is
+  not Done or Canceled and that aren't private, each charged to :open-tasks. A task's clients are
+  its visible values of client_property, else its page's, else none (\"\"); a client is its
+  value's :block/title, \"\" without one. Rows [client task], one per distinct pair, so two
+  clients with one title give one row."
+  [ctx {:keys [client_property]}]
+  (let [{:keys [db]} ctx
+        private? (private-fn ctx)
+        task-class (d/entid db :logseq.class/Task)
+        finished (into #{} (keep #(d/entid db %)) [:logseq.property/status.done :logseq.property/status.canceled])
+        title (fn [c] (or (first-value* ctx c :block/title) ""))]
+    (if (or (nil? task-class) (private? task-class))
+      []
+      (into []
+            (comp
+             (mapcat (fn [datom]
+                       (charge! ctx :tasks 1)
+                       (let [t (:e datom)]
+                         (when-not (or (contains? finished (first-value* ctx t :logseq.property/status))
+                                       (private? t))
+                           (charge! ctx :open-tasks 1)
+                           (let [own (visible-values ctx private? t client_property)
+                                 page (when (empty? own) (first-value* ctx t :block/page))
+                                 clients (cond (seq own) own
+                                               page (visible-values ctx private? page client_property)
+                                               :else [])]
+                             (if (seq clients)
+                               (map (fn [c] [(title c) t]) clients)
+                               [["" t]]))))))
+             (distinct))
+            (datoms* ctx :avet :block/tags task-class)))))
+
+(defn pages-missing-property
+  "Pages tagged tag (or a tag extending it), each tagged entity charged to :tagged, that aren't
+  private and have no visible value for property. Rows [page]."
+  [ctx {:keys [tag property]}]
+  (let [private? (private-fn ctx)]
+    (into []
+          (keep (fn [p]
+                  (when (and (nil? (first-value* ctx p :block/page))
+                             (not (private? p))
+                             (empty? (visible-values ctx private? p property)))
+                    [p])))
+          (tagged ctx private? tag :tagged))))
+
+;; Plans and refusals
+;; ==================
+
+(defn- format-count [n]
+  (string/replace (str n) #"\B(?=(\d{3})+(?!\d))" ","))
+
+(def ^:private reads-counted "reads (its reads bound, the backstop over every read)")
+
+(def ^:private stops
+  "Per query: each bound's refusal, as [what it counted, after the number] and the advice."
+  {"projects-untouched"
+   {:advice "give a narrower tag or a larger days"
+    :bounds {:tagged ["stopped after" "tagged pages and blocks (its tagged bound)" "give a narrower tag"]
+             :page-blocks ["stopped after reading" "blocks on pages not updated within days (its page-blocks bound)"]
+             :reads ["stopped after" reads-counted]}}
+   "meetings-without-decision"
+   {:advice "give a smaller days or a narrower meeting_tag or decision_tag"
+    :bounds {:meetings ["stopped after" "meetings created within days (its meetings bound)" "give a smaller days or a narrower meeting_tag"]
+             :decisions ["stopped after" "blocks tagged decision_tag (its decisions bound)" "give a narrower decision_tag"]
+             :ancestor-steps ["stopped after" "steps up from blocks tagged decision_tag (its ancestor-steps bound)"]
+             :reads ["stopped after" reads-counted]}}
+   "open-tasks-by-client"
+   {:advice "mark finished tasks Done or Canceled, or list one client's tasks with datalog_query"
+    :bounds {:tasks ["stopped after" "blocks tagged Task (its tasks bound)" "list one client's tasks with datalog_query"]
+             :open-tasks ["found more than" "open tasks (its open-tasks bound)"]
+             :reads ["stopped after" reads-counted "list one client's tasks with datalog_query"]}}
+   "pages-missing-property"
+   {:advice "give a narrower tag"
+    :bounds {:tagged ["stopped after" "tagged pages and blocks (its tagged bound)"]
+             :reads ["stopped after" reads-counted]}}})
+
+(defn bound-message
+  "The 422 for a ::bound refusal: the query, what the bound counted and its value, the bound's
+  name, and how to narrow the call."
+  [{:keys [query bound value]}]
+  (let [{:keys [advice bounds]} (get stops query)
+        [verb counted own-advice] (get bounds bound)]
+    (str query " " verb " " (format-count value) " " counted "; " (or own-advice advice))))
+
+(defn- tag-text [{:keys [title includes]}]
+  (if (seq includes)
+    (str title " (or a tag extending it: " (string/join ", " includes) ")")
+    title))
+
+(defn- bound-text [bounds bound] (str "(" (name bound) " bound " (format-count (get bounds bound)) ")"))
+
+(defn plan-text
+  "The steps `query-name` takes with its resolved `params` (as the response echoes them), each with
+  the bound that stops it and its value in `bounds`."
+  [query-name params bounds]
+  (let [b (partial bound-text bounds)
+        days (fn [k] (str (get params k) " days"))
+        reads (str " Every read counts " (b :reads) "; a bound passed answers 422 naming it, never part of the rows.")]
+    (case query-name
+      "projects-untouched"
+      (str "1. Read the pages and blocks tagged " (tag-text (get params "tag")) ", each counted " (b :tagged) "."
+           " 2. Keep the pages whose own updated-at is more than " (days "days") " ago, leaving out private ones and the Recycle bin."
+           " 3. Read each kept page's blocks, each counted " (b :page-blocks) ", stopping at the first one updated within "
+           (days "days") " that isn't private. 4. A page with no such block is a row, oldest first." reads)
+      "meetings-without-decision"
+      (str "1. Read the pages and blocks tagged " (tag-text (get params "meeting_tag")) " created within " (days "days")
+           ", each counted " (b :meetings) ", leaving out private ones and the Recycle bin."
+           " 2. Read the blocks tagged " (tag-text (get params "decision_tag")) ", each counted " (b :decisions)
+           ", keeping the ones that aren't private."
+           " 3. Walk up from each through its parents, its page and any page above it, each step counted " (b :ancestor-steps)
+           ", stopping at a block already reached. 4. A meeting no walk reached is a row, oldest first." reads)
+      "open-tasks-by-client"
+      (str "1. Read the blocks tagged Task, each counted " (b :tasks) "."
+           " 2. Keep those whose status isn't Done or Canceled and that aren't private, each counted " (b :open-tasks) "."
+           " 3. Read each one's " (get-in params ["client_property" :title]) " values, else its page's, leaving out private ones;"
+           " each value's title is a client (empty when there is none). 4. One row per client and task, by client title." reads)
+      "pages-missing-property"
+      (str "1. Read the pages and blocks tagged " (tag-text (get params "tag")) ", each counted " (b :tagged) "."
+           " 2. Keep the pages that aren't private and have no value for " (get-in params ["property" :title])
+           " that isn't private. 3. Each is a row, in creation order." reads))))
+
+;; The entries
+;; ===========
+
+(def ^:private days-bounds [1 3650])
+
+(def named-queries
+  (array-map
+   "projects-untouched"
+   {:title "Projects untouched"
+    :description "Pages tagged tag (or a tag extending it) whose own updated-at is older than days, with no block on the page updated since."
+    :columns ["updated-at" "page"]
+    :bounds [:tagged :page-blocks :reads]
+    :run projects-untouched
+    :params [{:name "tag" :type :tag :default "Project"}
+             {:name "days" :type :days :default 30 :bounds days-bounds}]}
+
+   "meetings-without-decision"
+   {:title "Meetings without a decision"
+    :description "Pages or blocks tagged meeting_tag, created within days, with no block below them (at any depth) tagged decision_tag."
+    :columns ["created-at" "meeting"]
+    :bounds [:meetings :decisions :ancestor-steps :reads]
+    :run meetings-without-decision
+    :params [{:name "meeting_tag" :type :tag :default "Business Meeting"}
+             {:name "decision_tag" :type :tag :default "Decision" :binding :set}
+             {:name "days" :type :days :default 90 :bounds days-bounds}]}
+
+   "open-tasks-by-client"
+   {:title "Open tasks by client"
+    :description "Blocks tagged Task whose status is not Done or Canceled, with each client from the task's own client_property, else each from its page's (empty when neither has one), sorted by client title: a task with two clients is a row under each."
+    :columns ["client" "task"]
+    :bounds [:tasks :open-tasks :reads]
+    :run open-tasks-by-client
+    ;; The client is read as the value's :block/title, so the property's values must be entities
+    ;; with a title: not a number (its value is :logseq.property/value) and not a raw value.
+    :params [{:name "client_property" :type :property :default "forClient"
+              :types #{:default :url :date :node :asset :entity :class :page :property}}]}
+
+   "pages-missing-property"
