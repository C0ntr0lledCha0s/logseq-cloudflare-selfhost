+                     ["a limit on a single attribute" (form '[[:block/title :limit 5]])
+                      "find: pull ?b: Expected limit attribute having :db.cardinality/many, got: :block/title"]
+                     ["a limit on the reverse of a single attribute" (form '[(limit :block/_parent 5)])
+                      "find: pull ?b: Expected limit attribute having :db.cardinality/many, got: :block/parent"]
+                     ["an option with no value" (form '[[:block/title :as]])
+                      "find: pull ?b: Expected even number of opts"]
+                     ["an unknown option" (form '[[:block/title :sort 1]])
+                      "find: pull ?b: Expected one of :as, :limit, :default, :xform"]
+                     ["a nested pattern on a value attribute" (form '[{:block/title [:block/uuid]}])
+                      "find: pull ?b: Expected attribute having :db.type/ref"]]]
+          (p/doseq [[label q message] cases]
+            (p/let [before (snapshot conn)
+                    response (query! self q :inputs (when (some #{'?p} (flatten q)) '[[:block/title]]))]
+              (testing label
+                (is (refused? response message) (pr-str response))
+                (is (= before (snapshot conn)))
+                (is (false? (:private-set-built? @datalog/last-run)) "refused before the private set is built"))))
+          (is (some? find-notes)))))))
+
+(deftest pull-many-attributes-bounded-test
+  ;; Each way of naming a many attribute returns at most 50 values, and each pattern the refusals
+  ;; sit next to still runs.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self notes]}]
+        (p/let [[many] (insert! self notes [{:title (str "zq many " (string/join " " (map #(str "[[zq r" (pad2 %) "]]") (range 60))))}])
+                [parent] (insert! self notes [{:title "zq parent of 60"}])
+                _ (bulk! self (:uuid parent) 60 #(str "zq kid " (pad2 %)))
+                _ (bulk! self notes 60 #(str "zq citing " (pad2 %) " [[zq Cited]]"))
+                _ (assert (= 60 (count (:block/refs (d/entity @conn [:block/uuid (uuid (:uuid many))])))))
+                by-title (fn [pattern title]
+                           (query! self (vec (concat [:find (list 'pull '?b pattern)]
+                                                     [:where ['?b :block/title '?t] [(list 'clojure.string/starts-with? '?t title)]]))))
+                bare (by-title '[:block/refs] "zq many")
+                star (by-title '[*] "zq many")
+                nested (by-title '[{:block/refs [:block/title]}] "zq many")
+                renamed (by-title '[[:block/refs :as "r"]] "zq many")
+                defaulted (by-title '[(default :block/refs [])] "zq many")
+                limited (by-title '[(limit :block/refs 50)] "zq many")
+                limited-5 (by-title '[[:block/refs :limit 5]] "zq many")
+                star-nested (by-title '[{:block/refs [*]}] "zq many")
+                kids (by-title '[{:block/_parent [:block/title]}] "zq parent of 60")
+                kids-renamed (by-title '[[:block/_parent :as "kids"]] "zq parent of 60")
+                cited (by-title '[{:block/_refs [:block/title]}] "zq Cited")
+                depth-2 (by-title '[:block/title {:block/parent [:block/title :block/order]}] "zq kid 00")]
+          (doseq [[label response k n] [["a bare many attribute" bare :block/refs 50]
+                                        ["a many attribute under *" star :block/refs 50]
+                                        ["a many attribute with a nested pattern" nested :block/refs 50]
+                                        ["a many attribute renamed with :as" renamed :r 50]
+                                        ["a many attribute with a default" defaulted :block/refs 50]
+                                        ["(limit :block/refs 50)" limited :block/refs 50]
+                                        ["[:block/refs :limit 5]" limited-5 :block/refs 5]
+                                        ["a many attribute pulled with [*]" star-nested :block/refs 50]
+                                        ["a reverse ref of a single attribute" kids :block/_parent 50]
+                                        ["a renamed reverse ref" kids-renamed :kids 50]
+                                        ["a reverse ref of a many attribute" cited :block/_refs 50]]]
+            (testing label
+              (is (= 200 (:status response)) (pr-str (:status response) (:body response)))
+              (is (= n (count (get-in response [:body :rows 0 0 k]))) (pr-str (keys (get-in response [:body :rows 0 0]))))))
+          (testing "depth 2 runs"
+            (is (= [200 [[{:block/title "zq kid 00"
+                           :block/parent {:block/title "zq parent of 60" :block/order (:block/order (d/entity @conn [:block/uuid (uuid (:uuid parent))]))}}]]]
+                   [(:status depth-2) (get-in depth-2 [:body :rows])])
+                (pr-str depth-2))))))))
