+(defn- long-title [i] (str "zq long " (pad2 i) " " (apply str (repeat 3000 "x"))))
+
+(deftest byte-cap-test
+  (async done
+    (with-graph done
+      (fn [{:keys [self notes]}]
+        (p/let [_ (bulk! self notes 60 long-title)
+                _ (insert! self notes [{:title (str "zq huge " (apply str (repeat 120000 "y")))}])
+                long-q '[:find ?t :where [?e :block/title ?t] [(clojure.string/starts-with? ?t "zq long")]]
+                response (query! self long-q :limit 200)
+                pulled (query! self '[:find (pull ?e [:block/title]) :where [?e :block/title ?t]
+                                      [(clojure.string/starts-with? ?t "zq long")]]
+                               :limit 200)
+                huge (query! self '[:find ?t :where [?e :block/title ?t] [(clojure.string/starts-with? ?t "zq huge")]])
+                ;; [["zq edge yyy…"]] is 99,900 characters: under the cap alone, over it with the response around it.
+                _ (insert! self notes [{:title (str "zq edge " (apply str (repeat (- 99900 4 8) "y")))}])
+                edge (query! self '[:find ?t :where [?e :block/title ?t] [(clojure.string/starts-with? ?t "zq edge")]])]
+          (testing "60 titles of 3,000 characters stop before 100,000 characters, whole rows only"
+            (is (= 200 (:status response)) (pr-str (:status response)))
+            (is (<= (count (:text response)) 100000) (count (:text response)))
+            (let [{:keys [rows returned total-rows truncated]} (:body response)]
+              (is (= 60 total-rows))
+              (is (< 20 returned 60) returned)
+              (is (= returned (count rows)))
+              (is (= (mapv #(vector (long-title %)) (range returned)) rows) "each row is whole, in order")
+              (is (= "byte-cap" (:by truncated)))
+              (is (= (str "returned " returned " of 60 rows (the byte cap, about 100,000 characters of JSON);"
+                          " pull fewer attributes, narrow the query or lower limit")
+                     (:note truncated)))))
+          (testing "pulled rows are cut the same way"
+            (is (= 200 (:status pulled)))
+            (is (<= (count (:text pulled)) 100000) (count (:text pulled)))
+            (is (= "byte-cap" (get-in pulled [:body :truncated :by])))
+            (is (= (mapv #(vector {:block/title (long-title %)}) (range (get-in pulled [:body :returned])))
+                   (get-in pulled [:body :rows]))))
+          (testing "a row that fits alone but not with the rest of the response is left out: the cap counts the whole JSON"
+            (is (= 200 (:status edge)) (pr-str (:status edge)))
+            (is (<= (count (:text edge)) 100000) (count (:text edge)))
+            (is (= [0 "byte-cap"] [(get-in edge [:body :returned]) (get-in edge [:body :truncated :by])])))
+          (testing "a single row over the cap gives zero rows and the note, not a cut row"
+            (is (= 200 (:status huge)) (pr-str (:status huge)))
+            (is (<= (count (:text huge)) 100000))
+            (is (= {:rows [] :returned 0 :total-rows 1
+                    :truncated {:by "byte-cap"
+                                :note (str "returned 0 of 1 rows (the byte cap, about 100,000 characters of JSON);"
+                                           " pull fewer attributes, narrow the query or lower limit")}}
+                   (select-keys (:body huge) [:rows :returned :total-rows :truncated])))))))))
