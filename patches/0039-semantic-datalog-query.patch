+(deftest byte-cap-test
+  (async done
+    (with-graph done
+      (fn [{:keys [self notes]}]
+        (p/let [_ (bulk! self notes 60 long-title)
+                _ (insert! self notes [{:title (str "zq huge " (apply str (repeat 120000 "y")))}])
+                long-q '[:find ?t :where [?e :block/title ?t] [(clojure.string/starts-with? ?t "zq long")]]
+                response (query! self long-q :limit 200)
