+(deftest recycled-left-out-test
+  ;; delete_page moves a page to the Recycle bin (it gains deleted-at and keeps its tags and blocks),
+  ;; and delete_block moves a block there. list_tasks and the other reads leave them out, and so do
+  ;; datalog_query and every named query.
+  (async done
+    (with-named done
+      (fn [{:keys [conn self]}]
+        (p/let [id-of (fn [title] (ffirst (d/q '[:find ?u :in $ ?t :where [?b :block/title ?t] [?b :block/uuid ?u]] @conn title)))
+                block-of id-of
+                del! (fn [path] (ok! (request! self "DELETE" path nil) 200))
+                _ (del! (str "/semantic/pages/" (id-of "zq Stale Project")))
+                _ (del! (str "/semantic/pages/" (id-of "zq Other Work")))
+                _ (del! (str "/semantic/pages/" (id-of "zq Meeting Undecided")))
+                _ (del! (str "/semantic/blocks/" (block-of "zq task page client")))
+                _ (assert (some? (:logseq.property/deleted-at (d/entity @conn [:block/uuid (id-of "zq Stale Project")]))))
+                tasks (request! self "GET" "/semantic/tasks" nil)
+                projects (named! self "projects-untouched" nil)
+                missing (named! self "pages-missing-property" {:params {:tag "Project" :property "forClient"}})
+                open (named! self "open-tasks-by-client" nil)
+                meetings (named! self "meetings-without-decision" nil)
+                titles (query! self '[:find ?t :where [?e :block/title ?t] [(clojure.string/starts-with? ?t "zq")]] :limit 200)
+                recycled #{"zq Stale Project" "zq stale notes" "zq Other Work" "zq task no client"
+                           "zq Meeting Undecided" "zq agenda" "zq task page client"}]
+          (doseq [r [projects missing open meetings titles]] (is (= 200 (:status r)) (pr-str r)))
+          (testing "list_tasks leaves the recycled tasks out"
+            (is (empty? (filter #(string/includes? (:text tasks) %) ["zq task no client" "zq task page client"])) (:text tasks)))
+          (testing "every named query leaves recycled pages, their blocks and recycled blocks out"
+            (is (= #{"zq Stale Client Project"} (set (row-titles projects 1))) (pr-str (:body projects)))
+            (is (= #{"zq Fresh Child Project" "zq Stale Client Project"} (set (row-titles missing 0))) (pr-str (:body missing)))
+            (is (= [["zq Beta" "zq task own client"]]
+                   (mapv (fn [[c t]] [c (:block/title t)]) (get-in open [:body :rows])))
+                (pr-str (:body open)))
+            (is (= #{"zq retro"} (set (row-titles meetings 1))) (pr-str (:body meetings))))
+          (testing "datalog_query leaves them out too"
+            (is (= #{} (set (filter recycled (map first (get-in titles [:body :rows])))))
+                (pr-str (get-in titles [:body :rows])))
+            (is (contains? (set (map first (get-in titles [:body :rows]))) "zq Fresh Project") "the rest still answer")))))))
+
+(deftest named-defaults-unresolved-test
+  ;; A graph without the default tags: the defaults name tags it doesn't have, so the call is a
+  ;; 400 naming each param, never empty rows.
+  (async done
+    (-> (p/let [conn (sqlite-export/create-conn)
+                self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true}
+                meetings (named! self "meetings-without-decision" nil)
+                projects (named! self "projects-untouched" nil)
+                tasks (named! self "open-tasks-by-client" nil)]
+          (is (refused? meetings "params.meeting_tag: no tag titled Business Meeting"
+                        "params.decision_tag: no tag titled Decision") (pr-str meetings))
+          (is (refused? projects "params.tag: no tag titled Project") (pr-str projects))
+          (is (refused? tasks "params.client_property: no property titled forClient") (pr-str tasks))
+          (is (false? (:private-set-built? @datalog/last-run)) "nothing ran"))
+        (p/catch #(is false (str % "\n" (.-stack %))))
+        (p/finally done))))
+
+(deftest named-unknown-name-test
+  (async done
+    (with-named done
+      (fn [{:keys [self]}]
+        (p/let [responses (p/all (map #(named! self % nil) ["Projects-Untouched" "projects_untouched" "datalog" "projects-untouched-x"]))]
+          (doseq [r responses]
+            (is (= 404 (:status r)) (pr-str r))
+            (is (string/includes? (str (get-in r [:body :error]))
+                                  (str "(names: " (string/join ", " names) ")")) (pr-str r))))))))
+
+(deftest named-route-test
+  (let [operation (semantic-routes/match-public "POST" "/api/v1/graphs/graph-1/named-queries/projects-untouched")
+        document (semantic-routes/openapi-document "https://issuer.example")
+        post (get-in document [:paths "/api/v1/graphs/{graph-id}/named-queries/{name}" :post])
+        schema (get-in post [:requestBody :content "application/json" :schema])
+        datalog-post (get-in document [:paths "/api/v1/graphs/{graph-id}/query" :post])]
+    (is (= {:handler :semantic/named-query :operation-id "runNamedQuery" :scope "logseq/read" :rate-class :read
+            :internal-path "/semantic/named-queries/:name" :path-params {:graph-id "graph-1" :name "projects-untouched"}}
+           (select-keys operation [:handler :operation-id :scope :rate-class :internal-path :path-params])))
+    (is (= "runNamedQuery" (:operationId post)))
+    (is (= #{"params" "limit" "dry-run"} (set (map name (keys (:properties schema))))))
+    (is (false? (:additionalProperties schema)))
+    (is (false? (get-in post [:requestBody :required])) "the body is optional: every param has a default or is named")
+    (is (= ["graph-id" "name"] (mapv :name (filter #(= "path" (:in %)) (:parameters post)))))
+    (doseq [phrase (concat names ["Project" "Business Meeting" "Decision" "forClient" "days" "30" "90"
+                                  "can be overridden" "params.<name>" "404" "Private" "E2EE"])]
+      (is (string/includes? (:description post) phrase) phrase))
+    (is (contains? (:responses post) "404"))
+    (is (string/includes? (:description datalog-post) "run_named_query"))))
+
+(deftest every-entry-validates-test
+  (is (= (set names) (set (keys named-queries/named-queries))))
+  (doseq [[query-name {:keys [query rules params]}] named-queries/named-queries]
+    (let [normalised (datalog/normalise-query query)
+          inputs (mapv (fn [{:keys [type binding]}]
+                         (case type
+                           :tag (if (= :set binding) #{1} [1])
+                           :days 0
+                           :property :block/title))
+                       params)]
+      (is (:ok normalised) (str query-name ": " (:error normalised)))
+      (is (nil? (datalog/validate-query (:ok normalised) rules inputs)) query-name))))
+
+(deftest named-dry-run-test
+  (async done
+    (with-named done
+      (fn [{:keys [self]}]
+        (p/let [response (named! self "meetings-without-decision" {:dry-run true})]
+          (is (= 200 (:status response)) (pr-str response))
+          (is (true? (get-in response [:body :dry-run])))
+          (is (= "meetings-without-decision" (get-in response [:body :name])))
+          (is (string/includes? (get-in response [:body :query]) ":block/tags"))
+          (is (string/includes? (get-in response [:body :rules]) "above"))
+          (is (string? (get-in response [:body :inputs])))
+          (is (nil? (get-in response [:body :rows])))
+          (is (= {:private-set-built? false :scanned 0 :joined 0 :pulled 0} @datalog/last-run)))))))
+
+(deftest named-e2ee-test
+  (async done
+    (with-named done
+      (fn [{:keys [self]}]
+        (p/let [response (named! self "projects-untouched" nil true)
+                unknown (named! self "nope" nil true)]
+          (is (= [409 "run_named_query is unavailable on an E2EE graph (titles are ciphertext)"]
+                 [(:status response) (get-in response [:body :error])]) (pr-str response))
+          (is (= 409 (:status unknown)) "before the name is looked up")
+          (is (false? (:private-set-built? @datalog/last-run))))))))
+
+(deftest named-limit-test
+  (async done
+    (with-named done
+      (fn [{:keys [self]}]
+        (p/let [response (named! self "open-tasks-by-client" {:limit 1})
+                most (named! self "open-tasks-by-client" {:limit 200})]
+          (is (= [200 1 3 "limit"]
+                 [(:status response) (get-in response [:body :returned]) (get-in response [:body :total-rows])
+                  (get-in response [:body :truncated :by])]) (pr-str response))
+          (is (= 3 (get-in most [:body :returned])))
+          (testing "the counts and the note come before rows, though the echo makes the response a large map"
+            (let [text (:text response)
+                  at (fn [k] (string/index-of text (str "\"" k "\":")))]
+              (doseq [k ["name" "params" "columns" "total-rows" "returned" "truncated"]]
+                (is (< (at k) (at "rows")) (str k " before rows: " text))))))))))
+
+(deftest named-queries-at-scale-test
+  ;; Datascript joins a pattern to two or more bound rows by scanning its whole attribute, and the
+  ;; scan cap counts that scan. A walk down from each meeting through :block/parent scanned every
+  ;; block once per level, so a graph of a few thousand blocks answered 422. 6,000 plain blocks
+  ;; (none tagged), under a meeting page, under a meeting block and on a page that is neither a
+  ;; meeting nor a project, must leave every named query's answer as it was.
+  (async done
+    (with-named done
+      (fn [{:keys [self undecided retro other-work]}]
+        (p/let [;; One at a time: last-run holds the latest request's count.
+                run-all (fn [] (p/let [projects (named! self "projects-untouched" nil)
+                                       meetings (named! self "meetings-without-decision" nil)
+                                       meetings (assoc meetings :scanned (:scanned @datalog/last-run))
+                                       tasks (named! self "open-tasks-by-client" nil)
+                                       missing (named! self "pages-missing-property" {:params {:tag "Project" :property "forClient"}})]
+                                 [projects meetings tasks missing]))
+                before (run-all)
+                _ (bulk! self undecided 2000 #(str "zq meeting filler " %))
+                _ (bulk! self retro 2000 #(str "zq retro filler " %))
+                _ (bulk! self other-work 2000 #(str "zq other filler " %))
+                after (run-all)
+                answer (fn [r] [(:status r) (get-in r [:body :error]) (get-in r [:body :rows])])]
+          (doseq [[query-name b a] (map vector names before after)]
+            (testing (str query-name " answers the same rows with 6,000 more blocks")
+              (is (= 200 (:status b)) (pr-str b))
+              (is (= (answer b) (answer a)) (pr-str (answer a)))))
+          (testing "meetings-without-decision reads no more datoms for blocks that aren't decisions"
+            (is (= (:scanned (nth before 1)) (:scanned (nth after 1)))
+                (pr-str [(:scanned (nth before 1)) (:scanned (nth after 1))]))))))))
