+                       ["no tag" "pages-missing-property" {:params {:property "forClient"}} "params.tag: required"]
+                       ["no property" "pages-missing-property" {:params {:tag "Project"}} "params.property: required"]
+                       ["neither" "pages-missing-property" nil "params.tag: required"]
+                       ["a tag that isn't one" "projects-untouched" {:params {:tag "Projet"}} "params.tag: no tag titled Projet"]
+                       ["a page title as a tag" "projects-untouched" {:params {:tag "zq Acme"}} "params.tag: no tag titled zq Acme"]
+                       ["a tag given as a number" "projects-untouched" {:params {:tag 3}} "params.tag: must be a tag title, UUID or ident"]
+                       ["a property that isn't one" "pages-missing-property" {:params {:tag "Project" :property "forClent"}}
+                        "params.property: no property titled forClent"]
+                       ["params not an object" "projects-untouched" {:params ["Project"]} "params: must be an object"]
+                       ["a body field it doesn't take" "projects-untouched" {:query "[:find ?e]"} "query: not a field"]
+                       ["limit 0" "projects-untouched" {:limit 0} "limit: must be an integer from 1 to 200"]]
+                responses (p/all (map (fn [[_ query-name body]] (named! self query-name body)) cases))]
+          (doseq [[[label _ _ message] response] (map vector cases responses)]
+            (is (refused? response message) (str label ": " (pr-str response))))
+          (testing "every refusal is a 400, never rows"
