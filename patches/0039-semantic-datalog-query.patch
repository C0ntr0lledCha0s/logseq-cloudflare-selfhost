+(deftest pull-reads-only-its-entity-test
+  ;; On a filtered db Datascript pulls a pattern without * by seeking from the entity to the end of
+  ;; the index, so a pull of an early entity would count every later datom against the scan cap.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self]}]
+        (p/let [plain (query! self '[:find ?c :where [?c :db/ident :logseq.class/Tag]])
+                plain-scanned (:scanned @datalog/last-run)
+                titled (query! self '[:find (pull ?c [:block/title]) :where [?c :db/ident :logseq.class/Tag]])
+                titled-scanned (:scanned @datalog/last-run)
+                nested (query! self '[:find (pull ?c [:block/title {:block/tags [:block/title]}])
+                                      :where [?c :db/ident :logseq.class/Tag]])
+                nested-scanned (:scanned @datalog/last-run)
+                tag-datoms (count (d/datoms @conn :eavt (d/entid @conn :logseq.class/Tag)))]
+          (is (= [200 200 200] (map :status [plain titled nested])))
+          (is (= [[{:block/title "Tag"}]] (get-in titled [:body :rows])) (pr-str titled))
+          (is (= [[{:block/title "Tag" :block/tags [{:block/title "Tag"}]}]] (get-in nested [:body :rows])) (pr-str nested))
+          (testing "the pull reads the entity's own datoms, not the rest of the index"
+            (is (<= (- titled-scanned plain-scanned) tag-datoms) [plain-scanned titled-scanned tag-datoms])
+            (is (< nested-scanned 100) nested-scanned)))))))
