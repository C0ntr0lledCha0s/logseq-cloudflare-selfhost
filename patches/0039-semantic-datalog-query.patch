+;; Caps (stage 2): the scan cap, bounded pulls and the byte cap
+;; =============================================================
+
+(defn- cap-message [n]
+  (str "query stopped after scanning " n " datoms (the scan cap); narrow it with a tag, page or attribute value,"
+       " or use a named query"))
+
+(defn- set-scan-cap!
+  "The test-only scan cap the handler reads from the Durable Object (`self`), in place of the
+  constant; nil restores the constant. No request can set it."
+  [self n]
+  (unchecked-set self "datalogScanCap" n))
+
+(defn- bulk!
+  "`n` blocks under `parent`, titled by `title-fn` of their index, in one block-trees batch."
+  [self parent n title-fn]
+  (insert! self parent (vec (for [i (range n)] {:title (title-fn i)}))))
+
+(defn- pad2 [i] (.padStart (str i) 2 "0"))
+
+(defn- value-cap-message []
+  (str "query rows hold more than 20,000 values inside collections (the value cap, which counts each character"
+       " of text as a value); return the parts you need rather than the whole collection, or narrow the query"))
+
+(deftest value-cap-test
+  ;; A collection from inputs, bound to a variable that every row returns, is printed once per row
+  ;; by the sort and the serialiser. Past the value cap (items inside the rows' collections, nested
+  ;; ones included, and each character of text inside them, all rows together) the query answers
+  ;; 422 before the sort. Inputs are at most 4,000 characters, so each case below fits in them and
+  ;; reaches the cap only through the 40 rows that repeat it.
+  (async done
+    (with-graph done
+      (fn [{:keys [self notes]}]
+        (p/let [_ (bulk! self notes 40 #(str "zq vc " (pad2 %)))
+                q '[:find ?t ?x :in $ ?x :where [?e :block/title ?t] [(clojure.string/starts-with? ?t "zq vc")]
+                    [(get-else $ ?e :block/uuid ?x) ?u]]
+                text (apply str (repeat 3000 "y"))
+                cases [["600 numbers (24,000 in all)" [(vec (repeat 600 0))]]
+                       ["20 vectors of 30 numbers (800 at the top level, 24,800 in all)" [(vec (repeat 20 (vec (repeat 30 0))))]]
+                       ["a map of 10 keys to vectors of 50 numbers" [(into {} (for [i (range 10)] [i (vec (repeat 50 0))]))]]
+                       ["a set of 600 numbers" [(set (range 600))]]
+                       ["one string of 3,000 characters" [[text]]]
+                       ["one keyword of 3,000 characters" [[(keyword text)]]]
+                       ["one symbol of 3,000 characters" [[(symbol text)]]]
+                       ["a string of 3,000 characters nested two deep" [[[text]]]]]
+                over (p/all (for [[_ inputs] cases] (query! self q :inputs inputs)))
+                under (query! self q :inputs [(vec (range 10))])
+                short-text (query! self q :inputs [(vec (repeat 10 "zq"))])
+                one-row (query! self '[:find ?x . :in $ ?x :where [?e :block/title "zq Notes"]
+                                       [(get-else $ ?e :block/uuid ?x) ?u]]
+                                :inputs [(vec (repeat 600 0))])
+                one-row-text (query! self '[:find ?x . :in $ ?x :where [?e :block/title "zq Notes"]
+                                            [(get-else $ ?e :block/uuid ?x) ?u]]
+                                     :inputs [[text]])]
+          (doseq [[[label inputs] response] (map vector cases over)]
+            (testing (str label ", repeated across 40 rows, answers 422 naming the cap")
+              (is (<= (count (pr-str inputs)) 4000) label)
+              (is (= [422 (value-cap-message)] [(:status response) (get-in response [:body :error])])
+                  (pr-str (:status response) (subs (:text response) 0 (min 300 (count (:text response))))))))
+          (testing "the same query with a small collection, and a large one in one row, answer"
+            (is (= [200 40] [(:status under) (get-in under [:body :total-rows])]) (pr-str (:status under)))
+            (is (= [200 40] [(:status short-text) (get-in short-text [:body :total-rows])]) (pr-str (:status short-text)))
+            (is (= [200 1] [(:status one-row) (get-in one-row [:body :total-rows])]) (pr-str (:status one-row)))
+            (is (= [200 1] [(:status one-row-text) (get-in one-row-text [:body :total-rows])]) (pr-str (:status one-row-text)))))))))
+
+(deftest scan-cap-test
+  ;; About 49,000 datoms added through the real outliner put the graph above the 20,000 scan cap
+  ;; (set from scripts/bench-datalog-query.mjs).
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self notes]}]
+        (p/let [_ (bulk! self notes 7000 #(str "zq filler " %))
