--- /dev/null
+++ b/deps/db-sync/src/logseq/db_sync/worker/handler/datalog.cljs
@@ -0,0 +1,1159 @@
+(ns logseq.db-sync.worker.handler.datalog
+  "Read-only Datalog over the semantic API (patch 0039, datalogQuery).
+
+  Read-only by construction: the query, inputs and rules are read as EDN (nothing is evaluated;
+  only #uuid and #inst tags), a static validator refuses write forms, functions off the allow-list,
+  functions in variable position (so none can be passed through inputs), sources other than $,
+  undefined rules and cross products, and what passes runs with d/q on a d/filter view of the db,
+  never on the conn. The filter hides private content: anything tagged with a class titled Private
+  (any case) or a class extending one, every block on a private page or under a private block, and
+  every ref to one of those, so neither results, pulls (reverse refs included), missing?, get-else
+  nor aggregates can see it. Content in the Recycle bin is hidden the same way: anything with
+  deleted-at, every block on such a page or under such a block, and every ref to one of those. Rows
+  are sorted with a type rank, so mixed types never make compare throw, and cut to limit.
+
+  Bounded by work, not time (the Worker clock does not move during synchronous CPU work): the filter
+  counts every datom it is asked about, kept or dropped, and past the scan cap the query stops and
+  answers 422. A join can build far more rows than it reads datoms (a self-join through one tag on
+  n entities gives n² rows), so Datascript's join-tuples and -collect-tuples, through which every
+  joined row is built, count them while a query runs, and past the join cap the query stops and answers 422. Every row
+  is sorted before limit applies, so past the row cap the query answers 422 before the sort, and
+  so do rows whose collections (from inputs) hold more than the value cap, which counts each
+  character of text inside them. query, inputs and rules are each at most 4,000 characters, refused
+  before they are parsed, and the left-recursion check is linear in the rules' size. No allowed function
+  builds a value larger than its arguments: the collection constructors are refused, and str, +
+  and keyword (which join strings) take at most one variable. A rule that calls back into itself (directly or through
+  other rules) before a data pattern binds one of the call's variables would expand without reading
+  datoms, so the cap could not stop it; it is refused with 400 before the query runs. Each (pull ?x pattern) in :find runs as ?x, and the pattern (at most 2 levels deep,
+  no recursion, at most 50 values per many attribute) is pulled only for the rows kept after the
+  limit. Rows are added to the response until its JSON would pass the byte cap, so the connector
+  never cuts it mid-row, and the response sets rows last, after the counts and the note."
+  (:require [cljs.reader :as reader]
+            [cljs.tools.reader.edn :as edn]
+            [cljs.tools.reader.reader-types :as reader-types]
+            [clojure.string :as string]
+            [datascript.core :as d]
+            [datascript.pull-parser :as pull-parser]
+            [datascript.query :as dq]
+            [logseq.db-sync.common :as common]
+            [logseq.db-sync.worker.graph-insights :as graph-insights]
+            [logseq.db-sync.worker.http :as http]
+            [logseq.db-sync.worker.named-queries :as named-queries]
+            [logseq.db.frontend.class :as db-class]
+            [promesa.core :as p]))
+
+(def scan-cap
+  "Datoms the private filter may be asked about per request; past it the query answers 422. Set
+  from scripts/bench-datalog-query.mjs: at 5,000 pages a counted shape at the cap, plus the private
+  set, takes about 92 ms warm under Node, the slowest request README records as tolerated."
+  20000)
+(def row-cap
+  "Rows the query may match before they are sorted; past it the query answers 422. Set from
+  scripts/bench-datalog-query.mjs: the sort costs about 10 µs a row (up to 22 µs on a two-column
+  self-join), so 2,500 rows add about 25 ms to the 47 ms private set at 5,000 pages, under the
+  92 ms tail. The rows are counted after d/q has built them, so this bounds the sort, not the join."
+  2500)
+(def join-cap
+  "Rows Datascript may build while joining a query's clauses (hash joins, products, or-join and
+  not-join branches, rule calls, collection bindings); past it the query answers 422. A joined row
+  costs about what a scanned datom does, so it matches the scan cap: a self-join through a tag on
+  150 blocks stops here after about 0.1 s instead of building 3,375,000 rows in 21 s."
+  20000)
+(def value-cap
+  "Items inside the collections among the matched rows' values, all rows together; past it the query
+  answers 422 before the sort, which prints each collection once per row. Only inputs supply
+  collections, since no allowed function builds one."
+  20000)
+(def byte-cap 100000)
+(def default-limit 50)
+(def max-limit 200)
+(def max-query-chars 4000)
+(def max-field-chars
+  "Characters inputs and rules may each hold, like query: past it the field is refused before it is
+  parsed. Validation walks every rule, and the value cap counts every character of input text, so
+  neither field may grow without bound."
+  4000)
+(def max-inputs 20)
+(def max-pull-depth 2)
+(def many-attr-limit 50)
+
+(def allowed-fns
+  "The functions and predicates a clause may call, by symbol: Datascript's query-fns less the ones
+  that cost CPU without scanning datoms (rand, range, the regex functions, which also invite ReDoS),
+  build large strings (clojure.string's join, replace, split and the like), build collections
+  (vector, list, set, hash-map, array-map, tuple: chained, each doubles a value at every clause) or
+  print. str, + and keyword stay, with at most one variable (`joining-fns`). Deny by default: a
+  built-in a Datascript bump adds stays refused until it is added here."
+  '#{= == not= != < > <= >= + - * / quot rem mod inc dec max min
+     zero? pos? neg? even? odd? compare
+     true? false? nil? some? not and or complement identical?
+     identity keyword name namespace type
+     count not-empty empty? contains? str subs get
+     -differ? get-else get-some missing? ground untuple
+     clojure.string/blank? clojure.string/includes? clojure.string/starts-with?
+     clojure.string/ends-with? clojure.string/lower-case clojure.string/upper-case
+     clojure.string/capitalize clojure.string/index-of clojure.string/last-index-of
+     clojure.string/trim clojure.string/trim-newline clojure.string/triml clojure.string/trimr
+     number? integer? string? boolean? keyword?})
+
+(def ^:private joining-fns
+  "Allowed functions whose result can be as long as all their arguments together: str, keyword with
+  two arguments, and + on strings (JavaScript joins them). Called with two or more variables, a
+  chain of them doubles a value at every clause, so each takes at most one variable, the other
+  arguments literals."
+  '#{str + keyword})
+
+(def ^:private allowed-aggregates
+  "Datascript's aggregates less rand and sample (random rows) and the custom `aggregate`, which would
+  take a function from inputs."
+  '#{sum avg median variance stddev distinct min max count count-distinct})
+
+(def ^:private allowed-list (string/join ", " (sort-by str allowed-fns)))
+
+(def ^:private query-keys [:find :in :where :keys :strs :syms :with])
+
+(def ^:private write-keywords
+  #{:db/add :db/retract :db/retractEntity :db/retractAttribute :db/cas})
+
+(def last-run
+  "What the latest request did, for tests: whether it built the private set, how many datoms the
+  filter was asked about and how many pulls ran. Reset at the start of every request."
+  (atom {:private-set-built? false :scanned 0 :joined 0 :pulled 0}))
+
+(defn- refusal [status message] {::status status ::error message})
+
+(defn- refusal? [x] (and (map? x) (contains? x ::error)))
+
+(defn- format-count [n]
+  (string/replace (str n) #"\B(?=(\d{3})+(?!\d))" ","))
+
+;; Parsing
+;; =======
+
+(defn parse-edn
+  "Reads `s`, the body field `field`, as one EDN form: {:ok form} or {:error message} naming the
+  field and, for a syntax error, the line and column. Only #uuid and #inst tags are read; nothing is
+  evaluated."
+  [field s]
+  (let [rdr (reader-types/indexing-push-back-reader s)
+        eof (js-obj)
+        opts {:eof eof
+              ;; cljs.reader's own #uuid and #inst readers; the EDN reader has none by default.
+              :readers {'uuid (get @reader/*tag-table* 'uuid)
+                        'inst (get @reader/*tag-table* 'inst)}
+              :default (fn [tag _]
+                         (throw (ex-info "bad tag" {::bad-tag tag})))}
+        position (fn [data]
+                   (str " at line " (or (:line data) (reader-types/get-line-number rdr))
+                        ", column " (or (:col data) (:column data) (reader-types/get-column-number rdr))))]
+    (try
+      (let [form (edn/read opts rdr)]
+        (cond
+          (identical? eof form) {:error (str field ": empty; give an EDN form")}
+          (not (identical? eof (edn/read opts rdr)))
+          {:error (str field ": unexpected text after the form" (position nil) "; give one EDN form")}
+          :else {:ok form}))
+      (catch :default e
+        (let [data (ex-data e)]
+          (if-let [tag (::bad-tag data)]
+            {:error (str field ": reader tag #" tag " is not allowed (only #uuid and #inst)")}
+            {:error (str field ": EDN parse error" (position data) ": " (ex-message e))}))))))
+
+;; Write forms
+;; ===========
+
+(defn- write-form-errors
+  "Every write-shaped value in `form` (a transaction keyword, any :db.fn/ keyword, or a map with
+  :db/id), each as `field: … is a write form`."
+  [field form]
+  (->> (tree-seq coll? seq form)
+       (keep (fn [x]
+               (cond
+                 (and (keyword? x) (or (contains? write-keywords x) (= "db.fn" (namespace x))))
+                 (str field ": " x " is a write form; datalog_query is read-only")
+                 (and (map? x) (contains? x :db/id))
+                 (str field ": a map with :db/id is a write form; datalog_query is read-only"))))
+       distinct))
+
+;; Query shape
+;; ===========
+
+(defn- variable? [x] (and (symbol? x) (nil? (namespace x)) (string/starts-with? (name x) "?")))
+
+(defn- source? [x] (and (symbol? x) (nil? (namespace x)) (string/starts-with? (name x) "$")))
+
+(defn- vars-in [form] (set (filter variable? (tree-seq coll? seq form))))
+
+(defn normalise-query
+  "The query as a map of `query-keys` to vectors: {:ok map} or {:error message}. The vector form
+  [:find … :where …] is split at its keywords."
+  [q]
+  (let [unknown (fn [k] (if (= :rules k)
+                          "query: :rules is not a query key; pass rules in the rules field"
+                          (str "query: " (pr-str k) " is not a query key (keys: "
+                               (string/join ", " (map str query-keys)) ")")))]
+    (cond
+      (map? q)
+      (if-let [bad (seq (remove (set query-keys) (keys q)))]
+        {:error (string/join "; " (map unknown bad))}
+        (if-let [bad (seq (remove (comp sequential? val) q))]
+          {:error (string/join "; " (map #(str "query: " (key %) " must be a vector") bad))}
+          {:ok (update-vals q vec)}))
+
+      (vector? q)
+      (if-not (keyword? (first q))
+        {:error "query: give [:find … :where …] or {:find […] :where […]}"}
+        (let [parts (partition-by keyword? q)
+              pairs (partition-all 2 parts)
+              errors (concat
+                      (for [[ks _] pairs, k (butlast ks)] (str "query: " (pr-str k) " has no values"))
+                      (for [[ks _] pairs, k ks :when (not (contains? (set query-keys) k))] (unknown k))
+                      (for [[k n] (frequencies (map (comp last first) pairs)) :when (> n 1)]
+                        (str "query: " (pr-str k) " is given " n " times")))]
+          (if (seq errors)
+            {:error (string/join "; " (distinct errors))}
+            {:ok (into {} (map (fn [[ks vs]] [(last ks) (vec vs)])) pairs)})))
+
+      :else {:error "query: give [:find … :where …] or {:find […] :where […]}"})))
+
+(defn- clause-kind [clause]
+  (cond
+    (vector? clause) (if (seq? (first clause)) (if (next clause) :fn :pred) :pattern)
+    (seq? clause) (let [[head] clause]
+                    (cond
+                      (source? head) :sourced
+                      (contains? '#{not not-join or or-join and} head) head
+                      (symbol? head) :rule
+                      :else :invalid))
+    :else :invalid))
+
+(declare clause-errors)
+
+(defn- source-errors [label form]
+  (for [s (distinct (filter #(and (source? %) (not= '$ %)) (tree-seq coll? seq form)))]
+    (str label ": source " s " is not allowed; only the default source $")))
+
+(defn- function-error [label f]
+  (cond
+    (variable? f) (str label ": " f " is a variable in function position; functions can't be passed as inputs")
+    (not (symbol? f)) (str label ": " (pr-str f) " in function position is not a function name")
+    (not (contains? allowed-fns f)) (str label ": function " f " is not allowed (allowed: " allowed-list ")")))
+
+(defn- joining-error [label f args]
+  (when (and (contains? joining-fns f) (< 1 (count (filter variable? args))))
+    (str label ": " f " takes at most one ?variable (the other arguments literals), because joining values can"
+         " double one at every clause")))
+
+(defn- clause-errors
+  "Why `clause` can't run, each prefixed with `label`; `rule-names` are the rules it may call."
+  [label rule-names clause]
+  (let [nested (fn [clauses] (mapcat #(clause-errors label rule-names %) clauses))]
+    (case (clause-kind clause)
+      (:fn :pred) (let [[[f & args]] clause]
+                    (concat (keep identity [(or (function-error label f) (joining-error label f args))])
+                            (source-errors label args)))
+      :pattern (source-errors label clause)
+      :sourced (concat (source-errors label [(first clause)]) (clause-errors label rule-names (apply list (rest clause))))
+      (not or and) (nested (rest clause))
+      (not-join or-join) (nested (drop 2 clause))
+      :rule (concat (when-not (contains? rule-names (first clause))
+                      [(str label ": rule " (first clause) " is not defined in rules")])
+                    (source-errors label (rest clause)))
+      [(str label ": " (pr-str clause) " is not a clause")])))
+
+(defn- clause-vars
+  "The variables `clause` joins: a predicate joins none (it filters a cross product, it doesn't
+  join one); or-join and not-join join their declared variables; anything else joins every variable
+  it holds."
+  [clause]
+  (case (clause-kind clause)
+    :pred #{}
+    (not-join or-join) (vars-in (second clause))
+    :sourced (clause-vars (apply list (rest clause)))
+    (vars-in clause)))
+
+(defn- cross-product-error
+  "The refusal when the where clauses fall into more than one group of clauses sharing variables."
+  [where]
+  (let [parent (volatile! {})
+        root (fn root [v] (let [p (get @parent v v)] (if (= p v) v (root p))))
+        union! (fn [a b] (let [ra (root a) rb (root b)] (when (not= ra rb) (vswap! parent assoc ra rb))))
+        ;; Every union happens before any root is read.
+        grouped (vec (keep-indexed (fn [i clause]
+                                     (when-let [vs (seq (clause-vars clause))]
+                                       (doseq [v (rest vs)] (union! (first vs) v))
+                                       [(inc i) (first vs)]))
+                                   where))
+        firsts (reduce (fn [acc [i v]] (let [r (root v)] (if (contains? acc r) acc (assoc acc r i))))
+                       {} grouped)]
+    (when (> (count firsts) 1)
+      (let [[a b] (sort (vals firsts))]
+        (str "where: clauses " a " and " b " share no variable (a cross product); join them through a shared variable")))))
+
+(defn- recursion-limit? [v] (or (= '... v) (= "..." v) (number? v)))
+
+(defn- legacy-expr? [spec head] (and (sequential? spec) (contains? #{head (name head)} (first spec))))
+
+(defn- spec-attr
+  "The attribute an attr-spec names: the keyword itself, the attribute of (limit a n) or
+  (default a v), or the head of [a :opt v …]."
+  [spec]
+  (cond
+    (or (legacy-expr? spec 'limit) (legacy-expr? spec 'default)) (spec-attr (second spec))
+    (sequential? spec) (spec-attr (first spec))
+    :else spec))
+
+(defn- many-limit-error [label attr n]
+  (when-not (and (integer? n) (<= 1 n many-attr-limit))
+    (str label ": " (pr-str (spec-attr attr)) " takes a limit from 1 to " many-attr-limit " (got " (pr-str n) ")")))
+
+(defn- recursion-error [label what]
+  (str label ": " what " is a recursive pull (... or a recursion number); nest a pattern instead, at most "
+       max-pull-depth " levels deep"))
+
+(defn- attr-spec-errors
+  "Why an attr-spec can't be pulled: a many-attribute limit outside 1 to 50 (or nil, no limit), an
+  :xform (a function call), or ... in the place of an attribute."
+  [label spec]
+  (cond
+    (= '... spec) [(recursion-error label "...")]
+    (legacy-expr? spec 'limit) (let [[_ attr n] spec]
+                                 (concat (attr-spec-errors label attr) (keep identity [(many-limit-error label attr n)])))
+    (legacy-expr? spec 'default) (attr-spec-errors label (second spec))
+    (sequential? spec) (concat (attr-spec-errors label (first spec))
+                               (keep (fn [[k v]]
+                                       (case k
+                                         :limit (many-limit-error label (first spec) v)
+                                         :xform (str label ": :xform on " (pr-str (spec-attr spec)) " is not allowed")
+                                         nil))
+                                     (partition 2 (rest spec))))
+    :else nil))
+
+(defn validate-pull-pattern
+  "Why `pattern` can't be pulled, each prefixed with `label`: it is not a literal vector, it nests
+  deeper than max-pull-depth, it recurses (... or a recursion number), or a many attribute's limit
+  is outside 1 to many-attr-limit."
+  [label pattern]
+  (letfn [(walk [pattern depth via]
+            (if (> depth max-pull-depth)
+              [(str label ": " (pr-str via) " nests the pattern " depth " levels deep (at most " max-pull-depth ")")]
+              (mapcat (fn [spec]
+                        (if (map? spec)
+                          (mapcat (fn [[k v]]
+                                    (concat (attr-spec-errors label k)
+                                            (cond
+                                              (recursion-limit? v) [(recursion-error label (pr-str {k v}))]
+                                              (sequential? v) (walk v (inc depth) (spec-attr k)))))
+                                  spec)
+                          (attr-spec-errors label spec)))
+                      pattern)))]
+    (if (vector? pattern)
+      (distinct (walk pattern 1 nil))
+      [(str label ": the pattern must be a literal vector, e.g. [:block/title :block/uuid] (got " (pr-str pattern) ")")])))
+
+(defn- pull-errors [args]
+  (let [[v pattern & extra] (if (source? (first args)) (rest args) args)
+        label (str "find: pull " (pr-str v))]
+    (concat (source-errors "find" args)
+            (cond
+              (not (variable? v)) [(str label ": the pulled entity must be a ?variable")]
+              (seq extra) [(str label ": pull takes a ?variable and a pattern")]
+              :else (validate-pull-pattern label pattern)))))
+
+(defn- find-errors [find]
+  (for [element find
+        :when (seq? element)
+        :let [[f & args] element]
+        error (cond
+                (= 'pull f) (pull-errors args)
+                (variable? f) [(str "find: " f " is a variable in function position; functions can't be passed as inputs")]
+                (not (contains? allowed-aggregates f))
+                [(str "find: aggregate " (pr-str f) " is not allowed (allowed: pull, "
+                      (string/join ", " (sort-by str allowed-aggregates)) ")")]
+                :else (source-errors "find" args))]
+    error))
+
+(defn- in-errors
+  "Problems with :in, and the number of inputs it binds after $ and %."
+  [in rules?]
+  (let [bindings (remove #{'$ '%} in)
+        sources (filter source? in)]
+    {:errors (concat
+              (when (and (seq in) (not= '$ (first in))) [":in: must start with $"])
+              (for [s (distinct sources) :when (not= '$ s)]
+                (str ":in: source " s " is not allowed; only the default source $"))
+              (when (and (some #{'%} in) (not rules?)) [":in: % needs rules; give rules or remove %"])
+              (when (and rules? (not (some #{'%} in))) ["rules: given, but :in has no %; add % to :in"]))
+     :bound (count (remove source? bindings))}))
+
+(defn- rule-names [rules] (set (keep #(when (and (vector? %) (seq? (first %))) (ffirst %)) rules)))
+
+(defn- rules-errors [rules]
+  (if-not (vector? rules)
+    ["rules: must be an EDN vector of rules, each [(name ?args) clauses…]"]
+    (let [names (rule-names rules)]
+      (mapcat (fn [i rule]
+                (if-not (and (vector? rule) (seq? (first rule)) (symbol? (ffirst rule)))
+                  [(str "rules " (inc i) ": must be [(name ?args) clauses…]")]
+                  (let [rule-name (ffirst rule)]
+                    (mapcat (fn [j clause] (clause-errors (str "rules: rule " rule-name " clause " (inc j)) names clause))
+                            (range) (rest rule)))))
+              (range) rules))))
+
+;; Recursion the scan cap can't stop
+;; ==================================
+;; Datascript expands a rule call into its branches before it reads anything. A rule that calls back
+;; into itself (directly or through other rules) before reading a datom bound to that call keeps
+;; adding branches while the filter is asked about few datoms, so the scan cap never stops it; a
+;; left-recursive closure ran past 120 s at a cap of 100. Every such cycle is refused up front.
+;; A get-some binds like a data pattern: it reads its entity's datom through the filter (counted)
+;; and drops the row when there is none, so a walk up through it, [(get-some $ ?b :block/parent)
+;; [_ ?x]] (above ?x ?a), stops where the data does. Other functions can bind a value without
+;; reading one (get-else's default, ground, identity), so they bind nothing here.
+
+(declare body-calls)
+
+(defn- clause-calls
+  "The rule calls in `clause` as [[callee guarded?] …], and the variables bound after it. `bound`
+  holds the variables a data pattern, a get-some (or a call to a rule `settled?` says can't call
+  back) bound earlier; a call is guarded when it holds one of them. Each or branch starts from
+  `bound`, and or-join and not-join see only their declared variables."
+  [clause bound settled?]
+  (case (clause-kind clause)
+    :pattern [[] (into bound (vars-in clause))]
+    :fn [[] (if (= 'get-some (ffirst clause)) (into bound (vars-in (second clause))) bound)]
+    :sourced (clause-calls (apply list (rest clause)) bound settled?)
+    :rule (let [callee (first clause)
+                vs (vars-in (rest clause))]
+            [[[callee (boolean (some bound vs))]] (if (settled? callee) (into bound vs) bound)])
+    (and not) [(body-calls (rest clause) bound settled?) bound]
+    or [(mapcat #(body-calls [%] bound settled?) (rest clause)) bound]
+    or-join (let [inner (set (filter (vars-in (second clause)) bound))]
+              [(mapcat #(body-calls [%] inner settled?) (drop 2 clause)) bound])
+    not-join [(body-calls (drop 2 clause) (set (filter (vars-in (second clause)) bound)) settled?) bound]
+    [[] bound]))
+
+(defn- body-calls
+  "The rule calls in `clauses`, read in order from `bound`, as [[callee guarded?] …]."
+  [clauses bound settled?]
+  (first (reduce (fn [[calls bound] clause]
+                   (let [[more bound'] (clause-calls clause bound settled?)]
+                     [(into calls more) bound']))
+                 [[] bound] clauses)))
+
+(defn- strongly-connected
+  "The strongly connected components of the graph `edges` (node → successors) reached from `nodes`,
+  each a set, by Tarjan's algorithm: one walk, so the check stays linear in the rules' size."
+  [nodes edges]
+  (let [index (volatile! {}) low (volatile! {}) stack (volatile! []) on-stack (volatile! #{})
+        counter (volatile! 0) components (volatile! [])
+        visit (fn visit [v]
+                (vswap! index assoc v @counter)
+                (vswap! low assoc v @counter)
+                (vswap! counter inc)
+                (vswap! stack conj v)
+                (vswap! on-stack conj v)
+                (doseq [w (edges v)]
+                  (cond
+                    (not (contains? @index w)) (do (visit w) (vswap! low update v min (get @low w)))
+                    (contains? @on-stack w) (vswap! low update v min (get @index w))))
+                (when (= (get @low v) (get @index v))
+                  (loop [component #{}]
+                    (let [w (peek @stack)]
+                      (vswap! stack pop)
+                      (vswap! on-stack disj w)
+                      (if (= w v)
+                        (vswap! components conj (conj component w))
+                        (recur (conj component w)))))))]
+    (doseq [v nodes :when (not (contains? @index v))] (visit v))
+    @components))
+
+(defn- left-recursion-errors
+  "One refusal per rule cycle whose every call comes before a data pattern binds one of its
+  variables, named from the first rule defined in it. Linear in the rules' size: one components
+  pass over the calls, one over the unguarded calls, and one search per cycle within its component."
+  [rules]
+  (let [branches (keep (fn [rule]
+                         (when (and (vector? rule) (seq? (first rule)) (symbol? (ffirst rule)))
+                           [(ffirst rule) (rest rule)]))
+                       rules)
+        order (distinct (map first branches))
+        callees (reduce (fn [m [r body]] (update m r (fnil into #{}) (map first (body-calls body #{} (constantly false)))))
+                        {} branches)
+        ;; A callee reaches back to its caller exactly when both are in one component.
+        component-of (into {} (for [c (strongly-connected order callees), r c] [r c]))
+        unguarded (reduce (fn [m [r body]]
+                            (let [settled? #(not (contains? (component-of %) r))]
+                              (update m r (fnil into #{})
+                                      (keep (fn [[callee guarded?]] (when-not guarded? callee))
+                                            (body-calls body #{} settled?)))))
+                          {} branches)
+        position (into {} (map-indexed (fn [i r] [r i]) order))
+        cycle-from (fn [r within]
+                     ;; Breadth first from r inside its component, each rule's calls in name order.
+                     (loop [queue (conj cljs.core/PersistentQueue.EMPTY r) parent {}]
+                       (when-let [v (peek queue)]
+                         (let [nexts (filter within (sort-by str (unguarded v)))]
+                           (if (some #{r} nexts)
+                             (conj (vec (reverse (take-while some? (iterate parent v)))) r)
+                             (let [fresh (remove #(or (= r %) (contains? parent %)) nexts)]
+                               (recur (into (pop queue) fresh) (into parent (map (fn [w] [w v])) fresh))))))))
+        cyclic (for [c (strongly-connected order unguarded)
+                     :let [r (apply min-key #(get position % js/Infinity) c)]
+                     :when (or (next c) (contains? (unguarded r) r))]
+                 [r c])]
+    (for [[r c] (sort-by #(get position (first %) js/Infinity) cyclic)
+          :let [cycle (cycle-from r c)]
+          :when cycle]
+      (str "rules: rule " r " recurses (" (string/join " → " cycle) ") before a data"
+           " pattern binds any of the call's variables; the scan cap can't stop that,"
+           " so start the rule with a data pattern (or a get-some) that binds one, e.g."
+           " [?b :block/parent ?x] (under ?x ?p)"))))
+
+(defn- relation-find
+  "A :find in any of Datascript's shapes as a relation find: [?x .] and [[?x ...]] become [?x], and
+  [[?x ?y]] becomes [?x ?y]."
+  [find]
+  (cond
+    (and (= 2 (count find)) (= '. (second find))) [(first find)]
+    (and (= 1 (count find)) (vector? (first find))) (vec (remove #{'...} (first find)))
+    :else find))
+
+(defn validate-query
+  "nil when `q` (normalised) may run with `rules` and `inputs`, else one message listing every
+  clause's refusal."
+  [q rules inputs]
+  (let [where (:where q)
+        names (rule-names rules)
+        {in-problems :errors bound :bound} (in-errors (or (:in q) '[$]) (some? rules))
+        errors (concat
+                in-problems
+                (when (and (empty? in-problems) (not= bound (count inputs)))
+                  [(str "inputs: " (count inputs) " value" (when (not= 1 (count inputs)) "s") " given, but :in binds "
+                        bound " after $")])
+                (when (empty? (:find q)) ["query: :find is required"])
+                (find-errors (:find q))
+                (let [columns (count (relation-find (:find q)))]
+                  (for [k [:keys :strs :syms]
+                        :let [names (get q k)]
+                        :when (and names (not= (count names) columns))]
+                    (str "query: " k " names " (count names) " columns for " columns " find elements")))
+                (mapcat (fn [i clause] (clause-errors (str "where " (inc i)) names clause)) (range) where)
+                (when rules (rules-errors rules))
+                (when (vector? rules) (left-recursion-errors rules)))]
+    (if (seq errors)
+      (string/join "; " (distinct errors))
+      (cross-product-error where))))
+
+;; The private filter
+;; ==================
+
+(defn ref-attrs
+  "The attributes whose values are entity ids."
+  [db]
+  (set (keep (fn [[attr props]] (when (= :db.type/ref (:db/valueType props)) attr)) (d/schema db))))
+
+(defn private-ids
+  "Every entity a query must not see: whatever is tagged with a class titled private (any case) or
+  with a class extending one, whatever is in the Recycle bin (has deleted-at, as delete_page and
+  delete_block leave it), every block whose page is one of those, and every descendant of those. A
+  property value block is under its owner, so it follows its owner."
+  [db]
+  (let [lineage (graph-insights/class-lineage-fn db)
+        tag-class (d/entid db :logseq.class/Tag)
+        classes (map :e (d/datoms db :avet :block/tags tag-class))
+        private-class? (fn [class-id]
+                         (some #(= "private" (some-> (:block/title %) string/lower-case)) (lineage class-id)))
+        roots (concat (->> classes
+                           (filter private-class?)
+                           (mapcat #(d/datoms db :avet :block/tags %))
+                           (map :e))
+                      (map :e (d/datoms db :aevt :logseq.property/deleted-at)))
+        children (fn [id] (concat (map :e (d/datoms db :avet :block/parent id))
+                                  (map :e (d/datoms db :avet :block/page id))))]
+    (loop [seen (transient #{}) queue (vec roots)]
+      (if-let [id (peek queue)]
+        (if (contains? seen id)
+          (recur seen (pop queue))
+          (recur (conj! seen id) (into (pop queue) (children id))))
+        (persistent! seen)))))
+
+(def ^:private join-limit
+  "The join cap while run-query's d/q runs, else nil: join-tuples counts only then."
+  (volatile! nil))
+
+(def ^:private joined (volatile! 0))
+
+(defn- count-join! []
+  (when-some [cap @join-limit]
+    (when (> (vswap! joined inc) cap)
+      (throw (ex-info "join cap" {::join-cap cap})))))
+
+(defonce ^:private count-joins
+  ;; Datascript builds every joined row with join-tuples (hash-join and prod-rel), and the rows of
+  ;; relations that share no variable, such as a rule body's, with -collect-tuples, so counting
+  ;; both bounds a join before its rows exist. Outside run-query they only call through.
+  (let [join-tuples dq/join-tuples
+        collect-tuples dq/-collect-tuples]
+    (set! dq/join-tuples
+          (fn [t1 idxs1 t2 idxs2]
+            (count-join!)
+            (join-tuples t1 idxs1 t2 idxs2)))
+    (set! dq/-collect-tuples
+          (fn [acc rel len copy-map]
+            (eduction (map (fn [tuple] (count-join!) tuple)) (collect-tuples acc rel len copy-map))))
+    true))
+
+(defn- item-weight
+  "What one item inside a collection counts toward the value cap: a string, keyword or symbol each
+  character of its text (the sort prints it whole, once per row), anything else 1."
+  [x]
+  (cond
+    (string? x) (max 1 (count x))
+    (or (keyword? x) (symbol? x)) (max 1 (count (str x)))
+    :else 1))
+
+(defn- collection-items
+  "Items inside the collections among `rows`' values, nested ones included and text by its length
+  (`item-weight`), all rows together, counted until past `cap`."
+  [rows cap]
+  (let [n (volatile! 0)
+        walk (fn walk [v]
+               (when (coll? v)
+                 (reduce (fn [_ x] (if (> (vswap! n + (item-weight x)) cap) (reduced nil) (walk x))) nil v)))]
+    (doseq [row rows, v row :while (<= @n cap)] (walk v))
+    @n))
+
+(defn query-filter
+  "`db` filtered to hide `private` entities and refs to them; `counter` (a volatile) counts every
+  datom the filter is asked about, kept or dropped, and past `cap` the filter throws
+  {::scan-cap cap}."
+  [db private refs counter cap]
+  (d/filter db (fn [_ datom]
+                 (when (> (vswap! counter inc) cap)
+                   (throw (ex-info "scan cap" {::scan-cap cap})))
+                 (not (or (contains? private (:e datom))
+                          (and (contains? refs (:a datom)) (contains? private (:v datom))))))))
+
+;; Running
+;; =======
+
+(defn type-rank
+  "Sort rank of a value's type, so values of different types order without compare throwing."
+  [v]
+  (cond
+    (nil? v) 0
+    (boolean? v) 1
+    (number? v) 2
+    (string? v) 3
+    (keyword? v) 4
+    (uuid? v) 5
+    :else 6))
+
+(defn- sort-key [v]
+  (let [rank (type-rank v)]
+    [rank (if (= 6 rank) (pr-str v) v)]))
+
+(defn sort-rows
+  "`rows` in a deterministic order: column by column, by type rank, then value."
+  [rows]
+  (->> rows
+       (map (fn [row] [(mapv sort-key row) row]))
+       (sort-by first (fn [a b]
+                        (or (some (fn [[[ra va] [rb vb]]]
+                                    (let [c (if (= ra rb) (compare va vb) (compare ra rb))]
+                                      (when-not (zero? c) c)))
+                                  (map vector a b))
+                            0)))
+       (mapv second)))
+
+(defn- keyword-text [k] (subs (str k) 1))
+
+(defn serialise
+  "A result value as JSON-ready data: keywords as text without the colon, uuids as text and a ref
+  ({:db/id n}, as a pull gives one) as its number."
+  [v]
+  (cond
+    (keyword? v) (keyword-text v)
+    (and (map? v) (= [:db/id] (keys v))) (:db/id v)
+    (uuid? v) (str v)
+    (symbol? v) (str v)
+    (instance? js/Date v) (.getTime v)
+    (map? v) (into {} (map (fn [[k x]] [(if (keyword? k) (keyword-text k) (str k)) (serialise x)])) v)
+    (coll? v) (mapv serialise v)
+    :else v))
+
+(defn- query-args [in fdb rules inputs]
+  (loop [[b & more] (or (seq in) '[$]) inputs inputs args []]
+    (cond
+      (nil? b) args
+      (= '$ b) (recur more inputs (conj args fdb))
+      (= '% b) (recur more inputs (conj args rules))
+      :else (recur more (rest inputs) (conj args (first inputs))))))
+
+(defn- query-error-message
+  "A Datascript error from running the caller's query as a 400 message, or nil for anything else."
+  [e]
+  (when-let [data (ex-data e)]
+    (when (keyword? (:error data))
+      (str "query: " (ex-message e)))))
+
+(defn- scan-cap-message [cap]
+  (str "query stopped after scanning " (format-count cap) " datoms (the scan cap); narrow it with a tag, page or"
+       " attribute value, or use a named query"))
+
+(defn- row-cap-message [rows cap]
+  (str "query matched " (format-count rows) " rows, more than the row cap of " (format-count cap)
+       "; every row is sorted before limit applies, so narrow it with a tag, page or attribute value,"
+       " or count them with an aggregate such as (count ?b)"))
+
+(defn- join-cap-message [cap]
+  (str "query stopped after joining " (format-count cap) " rows (the join cap); a join through a shared value,"
+       " such as two blocks with the same tag, matches every pair, so bind one side or narrow it with a tag, page"
+       " or attribute value"))
+
+(defn- value-cap-message [cap]
+  (str "query rows hold more than " (format-count cap) " values inside collections (the value cap, which counts"
+       " each character of text as a value); return the"
+       " parts you need rather than the whole collection, or narrow the query"))
+
+(defn- run-refusal
+  "An error raised while running the caller's query or its pulls: the scan cap and the join cap as
+  422, anything else as a 400 naming it. Never a 500."
+  [e]
+  (let [data (ex-data e)]
+    (cond
+      (::scan-cap data) (refusal 422 (scan-cap-message (::scan-cap data)))
+      (::join-cap data) (refusal 422 (join-cap-message (::join-cap data)))
+      :else (refusal 400 (or (query-error-message e) (str "query: failed while running: " (ex-message e)))))))
+
+(defn rewrite-pulls
+  "The relation find `find` with each (pull ?x pattern) replaced by ?x: {:find [...] :pulls {column
+  pattern}}."
+  [find]
+  (reduce (fn [acc el]
+            (if (and (seq? el) (= 'pull (first el)))
+              (let [[v pattern] (if (source? (second el)) (drop 2 el) (rest el))]
+                (-> acc
+                    (assoc-in [:pulls (count (:find acc))] pattern)
+                    (update :find conj v)))
+              (update acc :find conj el)))
+          {:find [] :pulls {}}
+          find))
+
+(defn- reverse-attr? [attr] (and (keyword? attr) (string/starts-with? (name attr) "_")))
+
+(defn- many-attr? [schema attr]
+  (and (keyword? attr) (= :db.cardinality/many (get-in schema [attr :db/cardinality]))))
+
+(defn- take-many
+  "A reverse ref's values cut to many-attr-limit: Datascript takes no :limit on the reverse of a
+  cardinality-one attribute (:block/_parent), so the pull cuts it."
+  [v]
+  (if (sequential? v) (vec (take many-attr-limit v)) v))
+
+(defn- bound-attr-spec
+  "`spec` with many-attr-limit as the limit of a many attribute (or a reverse ref) that has none."
+  [schema spec]
+  (let [bounded (fn [attr opts]
+                  (cond
+                    (reverse-attr? attr)
+                    (let [forward (keyword (namespace attr) (subs (name attr) 1))]
+                      (if (many-attr? schema forward)
+                        (into [attr :limit many-attr-limit] opts)
+                        (into [attr :xform take-many] opts)))
+                    (many-attr? schema attr) (into [attr :limit many-attr-limit] opts)
+                    :else nil))]
+    (cond
+      (keyword? spec) (or (bounded spec []) spec)
+      (legacy-expr? spec 'limit) spec
+      (legacy-expr? spec 'default) (let [[_ attr v] spec] (list 'default (bound-attr-spec schema attr) v))
+      (and (sequential? spec) (keyword? (first spec)))
+      (let [opts (vec (rest spec))]
+        (if (some #{:limit} (take-nth 2 opts)) spec (or (bounded (first spec) opts) spec)))
+      :else spec)))
+
+(defn- spec-key
+  "The key an attr-spec's value comes back under: its :as, else its attribute."
+  [spec]
+  (cond
+    (or (legacy-expr? spec 'limit) (legacy-expr? spec 'default)) (spec-key (second spec))
+    (sequential? spec) (get (into {} (map vec (partition 2 (rest spec)))) :as (first spec))
+    :else spec))
+
+(def ^:private wildcard? #{'* "*" :*})
+
+(defn- bound-pattern
+  "{:pattern :shape}: `pattern` with every many attribute limited to many-attr-limit, including
+  those * pulls, and with * added to every level that lacks it, and the shape that trims the pull
+  back to what `pattern` asked for. On a filtered db Datascript reads a level without * by seeking
+  from the entity to the end of the index (the scan cap would count every datom after it); with *
+  it reads the entity's own datoms only."
+  [schema many-attrs pattern]
+  (let [specs (mapcat #(if (map? %) (keys %) [%]) (remove wildcard? pattern))
+        named (set (map spec-attr specs))
+        nested (into {} (for [spec pattern :when (map? spec), [k v] spec :when (sequential? v)]
+                          [k (bound-pattern schema many-attrs v)]))
+        bounded (mapv (fn [spec]
+                        (if (map? spec)
+                          (into {} (map (fn [[k v]] [(bound-attr-spec schema k) (if-let [n (get nested k)] (:pattern n) v)]))
+                                spec)
+                          (bound-attr-spec schema spec)))
+                      pattern)]
+    {:pattern (-> bounded
+                  (cond-> (not (some wildcard? pattern)) (conj '*))
+                  (into (for [attr many-attrs :when (not (contains? named attr))] [attr :limit many-attr-limit])))
+     :shape {:keys (when-not (some wildcard? pattern) (set (map spec-key specs)))
+             :nested (into {} (map (fn [[k n]] [(spec-key k) (:shape n)])) nested)}}))
+
+(defn- trim-pulled
+  "A pulled value cut back to `shape`: only the keys the caller's pattern named (all of them at a
+  level with *), an empty map as nil, as Datascript answers a pull that finds nothing."
+  [shape v]
+  (cond
+    (map? v) (not-empty
+              (into {} (keep (fn [[k x]]
+                               (when (or (nil? (:keys shape)) (contains? (:keys shape) k))
+                                 (when-some [x (if-let [s (get-in shape [:nested k])] (trim-pulled s x) x)]
+                                   [k x]))))
+                    v))
+    (sequential? v) (not-empty (into [] (keep #(trim-pulled shape %)) v))
+    :else v))
+
+(defn- json-length [x] (.-length (js/JSON.stringify (clj->js x))))
+
+(defn- limit-note [kept total limit]
+  (str "returned " (format-count kept) " of " (format-count total) " rows (limit " limit ", maximum " max-limit
+       "); narrow the query or add a :where clause"))
+
+(defn- byte-cap-note [kept total]
+  (str "returned " (format-count kept) " of " (format-count total) " rows (the byte cap, about "
+       (format-count byte-cap) " characters of JSON); pull fewer attributes, narrow the query or lower limit"))
+
+(defn- cut-to-byte-cap
+  "The leading whole `rows` whose JSON, with `base` (the response without rows, its notes at their
+  longest), stays within byte-cap."
+  [base rows]
+  (let [budget (- byte-cap (json-length (assoc base :rows [])))]
+    (loop [kept (transient []) used 0 rows rows]
+      (if-let [[row & more] (seq rows)]
+        (let [used' (+ used (json-length row) (if (pos? (count kept)) 1 0))]
+          (if (> used' budget)
+            (persistent! kept)
+            (recur (conj! kept row) used' more)))
+        (persistent! kept)))))
+
+(defn run-query
+  "Runs the normalised, validated query `q` on `db` filtered for privacy, with pulls run on the kept
+  rows only; returns {:columns :rows :total-rows :returned :truncated?} merged with `echo` (the
+  fields the response repeats, counted in the byte cap), or a refusal. `scan-cap` replaces the
+  constant, and `row-cap` and `join-cap` the other caps (tests)."
+  [db {:keys [query inputs rules limit echo] :as opts}]
+  (let [cap (or (:scan-cap opts) scan-cap)
+        max-rows (or (:row-cap opts) row-cap)
+        max-joined (or (:join-cap opts) join-cap)
+        original (relation-find (:find query))
+        {find :find pulls :pulls} (rewrite-pulls original)
+        schema (d/schema db)
+        many-attrs (sort (keep (fn [[attr props]] (when (many-attr? schema attr) attr)) schema))
+        pulls (update-vals pulls #(bound-pattern schema many-attrs %))
+        pull-problem (some (fn [[i {:keys [pattern]}]]
+                             (try (pull-parser/parse-pattern db pattern) nil
+                                  (catch :default e (str "find: pull " (nth find i) ": " (ex-message e)))))
+                           pulls)]
+    (if pull-problem
+      (refusal 400 pull-problem)
+      (let [private (private-ids db)
+            _ (swap! last-run assoc :private-set-built? true)
+            counter (volatile! 0)
+            fdb (query-filter db private (ref-attrs db) counter cap)
+            runnable (-> query (dissoc :keys :strs :syms) (assoc :find find))
+            columns (or (some->> (or (:keys query) (:strs query) (:syms query)) (mapv str))
+                        (mapv pr-str original))
+            result (try
+                     (let [matched (try
+                                     (vreset! joined 0)
+                                     (vreset! join-limit max-joined)
+                                     (apply d/q runnable (query-args (:in query) fdb rules inputs))
+                                     (finally
+                                       (vreset! join-limit nil)
+                                       (swap! last-run assoc :joined @joined)))]
+                       (cond
+                         (> (count matched) max-rows)
+                         (refusal 422 (row-cap-message (count matched) max-rows))
+
+                         (> (collection-items matched value-cap) value-cap)
+                         (refusal 422 (value-cap-message value-cap))
+
+                         :else
+                         (let [rows (sort-rows (map vec matched))
+                               kept (subvec rows 0 (min limit (count rows)))]
+                           {:total (count rows)
+                            :kept (mapv (fn [row]
+                                          (reduce-kv (fn [row i {:keys [pattern shape]}]
+                                                       (swap! last-run update :pulled inc)
+                                                       (assoc row i (trim-pulled shape (d/pull fdb pattern (nth row i)))))
+                                                     row pulls))
+                                        kept)})))
+                     (catch :default e (run-refusal e))
+                     (finally (swap! last-run assoc :scanned @counter)))]
+        (if (refusal? result)
+          result
+          (let [{:keys [total kept]} result
+                rows (mapv serialise kept)
+                base (merge echo {:columns columns :total-rows total :returned total
+                                  :truncated {:by "byte-cap"
+                                              :note (max-key count (byte-cap-note total total) (limit-note total total limit))}})
+                fitted (cut-to-byte-cap base rows)]
+            (merge echo
+                   (cond-> {:columns columns
+                            :rows fitted
+                            :total-rows total
+                            :returned (count fitted)}
+                     (< (count fitted) (count rows))
+                     (assoc :truncated {:by "byte-cap" :note (byte-cap-note (count fitted) total)})
+
+                     (and (= (count fitted) (count rows)) (> total limit))
+                     (assoc :truncated {:by "limit" :note (limit-note (count fitted) total limit)})))))))))
+
+;; The handler
+;; ===========
+
+(def ^:private body-fields #{:query :inputs :rules :limit :dry-run})
+
+(defn- body-errors [body]
+  (if-not (map? body)
+    ["body: give a JSON object with query"]
+    (let [{:keys [query inputs rules limit]} body]
+      (cond-> (mapv #(str (name %) ": not a field; the body takes query, inputs, rules, limit and dry-run")
+                    (remove body-fields (keys body)))
+        (not (string? query)) (conj "query: required, an EDN string")
+        (and (string? query) (> (count query) max-query-chars))
+        (conj (str "query: at most " (format-count max-query-chars) " characters (got " (format-count (count query)) ")"))
+        (and (contains? body :inputs) (not (string? inputs))) (conj "inputs: must be an EDN string")
+        (and (string? inputs) (> (count inputs) max-field-chars))
+        (conj (str "inputs: at most " (format-count max-field-chars) " characters (got " (format-count (count inputs)) ")"))
+        (and (contains? body :rules) (not (string? rules))) (conj "rules: must be an EDN string")
+        (and (string? rules) (> (count rules) max-field-chars))
+        (conj (str "rules: at most " (format-count max-field-chars) " characters (got " (format-count (count rules)) ")"))
+        (and (contains? body :limit) (not (and (integer? limit) (<= 1 limit max-limit))))
+        (conj (str "limit: must be an integer from 1 to " max-limit))
+        (and (contains? body :dry-run) (not (boolean? (:dry-run body)))) (conj "dry-run: must be true or false")))))
+
+(defn- checked-query
+  "`query` (as parsed) with `inputs` and `rules` checked as every query is before it runs, write
+  forms first and then the validator: {:query (normalised) :given :inputs :rules} or a refusal."
+  [query inputs rules]
+  (let [writes (concat (write-form-errors "query" query)
+                       (write-form-errors "inputs" inputs)
+                       (write-form-errors "rules" rules))
+        normalised (normalise-query query)
+        invalid (or (:error normalised)
+                    (validate-query (:ok normalised) rules inputs))
+        problems (cond-> (vec writes) invalid (conj invalid))]
+    (if (seq problems)
+      (refusal 400 (string/join "; " problems))
+      {:query (:ok normalised) :given query :inputs inputs :rules rules})))
+
+(defn- parse-request
+  "The body's query, inputs and rules parsed, normalised and validated: {:query :inputs :rules
+  :given} or a refusal."
+  [body]
+  (let [problems (body-errors body)]
+    (if (seq problems)
+      (refusal 400 (string/join "; " problems))
+      (let [parsed (cond-> {:query (parse-edn "query" (:query body))}
+                     (:inputs body) (assoc :inputs (parse-edn "inputs" (:inputs body)))
+                     (:rules body) (assoc :rules (parse-edn "rules" (:rules body))))
+            parse-problems (keep :error (vals parsed))
+            {:keys [query inputs rules]} (update-vals parsed :ok)
+            shape-problems (concat
+                            (when (and (contains? parsed :inputs) (not (vector? inputs)) (empty? parse-problems))
+                              ["inputs: must be an EDN vector"])
+                            (when (and (vector? inputs) (> (count inputs) max-inputs))
+                              [(str "inputs: at most " max-inputs " values (got " (count inputs) ")")]))]
+        (if (seq (concat parse-problems shape-problems))
+          (refusal 400 (string/join "; " (concat parse-problems shape-problems)))
+          (checked-query query (or inputs []) rules))))))
+
+(defn- rows-last
+  "`result` as a JS object with rows set last, so its JSON ends with them: the connector cuts a long
+  result from the end, and total-rows, returned and truncated must survive any cut. A map is no
+  use here: past 8 keys (a named query's echo) it keeps no order, and the response's postwalk
+  rebuilds it."
+  [result]
+  (let [o #js {}]
+    (doseq [[k v] (dissoc result :rows)] (unchecked-set o (name k) (clj->js v)))
+    (when (contains? result :rows) (unchecked-set o "rows" (clj->js (:rows result))))
+    o))
+
+(defn- respond [result]
+  (if (refusal? result)
+    (http/error-response (::error result) (::status result))
+    (http/json-response :semantic/datalog-query (rows-last result))))
+
+(defn- test-cap
+  "A cap a test set on the Durable Object (`datalogScanCap`, `datalogRowCap`, `datalogJoinCap`), in place of the
+  constant. No request can set it."
+  [^js self field]
+  (let [cap (some-> self (unchecked-get field))]
+    (when (and (integer? cap) (not (neg? cap))) cap)))
+
+(defn handle-query
+  "POST /query: refuses an E2EE graph first, then a body, query, inputs or rules that can't run,
+  and otherwise answers the dry run or the rows."
+  [{:keys [request db e2ee? self]}]
+  (reset! last-run {:private-set-built? false :scanned 0 :joined 0 :pulled 0})
+  (if e2ee?
+    (http/error-response "datalog_query is unavailable on an E2EE graph (titles are ciphertext)" 409)
+    (p/let [body (-> (p/let [json (common/read-json request)] (js->clj json :keywordize-keys true))
+                     (p/catch (fn [_] ::malformed)))]
+      (if (= ::malformed body)
+        (http/bad-request "body: give a JSON object with query")
+        (let [parsed (parse-request body)]
+          (respond
+           (cond
+             (refusal? parsed) parsed
+             (true? (:dry-run body)) {:dry-run true
+                                      :query (pr-str (:given parsed))
+                                      :inputs (pr-str (:inputs parsed))
+                                      :rules (pr-str (or (:rules parsed) []))}
+             :else (run-query db {:query (:query parsed) :inputs (:inputs parsed) :rules (:rules parsed)
+                                  :limit (or (:limit body) default-limit)
+                                  :scan-cap (test-cap self "datalogScanCap")
+                                  :row-cap (test-cap self "datalogRowCap")
+                                  :join-cap (test-cap self "datalogJoinCap")
+                                  :echo {:query (pr-str (:given parsed)) :inputs (pr-str (:inputs parsed))}}))))))))
+
+;; Named queries
+;; =============
+
+(def ^:private day-ms 86400000)
+
+(defn- resolve-tag-param
+  "A :tag param's value: the tag `value` names (by `resolve-tag`) and every tag extending it."
+  [db resolve-tag {:keys [binding] param-name :name} value]
+  (let [field (str "params." param-name)]
+    (if-not (string? value)
+      {:error (str field ": must be a tag title, UUID or ident (a string)")}
+      (if-let [tag (resolve-tag db value)]
+        (let [children (map #(d/entity db %) (db-class/get-structured-children db (:db/id tag)))
+              ids (vec (sort (cons (:db/id tag) (map :db/id children))))]
+          {:input (if (= :set binding) (set ids) ids)
+           :echo {:title (:block/title tag)
+                  :ident (keyword-text (:db/ident tag))
+                  :includes (vec (sort (map :block/title children)))}})
+        {:error (str field ": no tag titled " value)}))))
+
+(defn- resolve-property-param
+  "A :property param's value: the ident of the property `value` names (by `resolve-property`),
+  whose type is one of `types` when the param limits them."
+  [db resolve-property {:keys [types] param-name :name} value]
+  (let [field (str "params." param-name)]
+    (if-not (string? value)
+      {:error (str field ": must be a property title, UUID or ident (a string)")}
+      (if-let [property (resolve-property db value)]
+        (let [type (or (:logseq.property/type property) :default)]
+          (if (and types (not (contains? types type)))
+            {:error (str field ": " (:block/title property) " is a " (name type) " property; give one whose values"
+                         " are pages or text (a node, default, url or date property)")}
+            {:input (:db/ident property)
+             :echo {:title (:block/title property)
+                    :ident (keyword-text (:db/ident property))
+                    :type (name type)}}))
+        {:error (str field ": no property titled " value)}))))
+
+(defn- resolve-days-param
+  "A :days param's value: a cutoff `value` days before `now`, in ms."
+  [now {:keys [bounds] param-name :name} value]
+  (let [[lo hi] bounds]
+    (if (and (integer? value) (<= lo value hi))
+      {:input (- now (* value day-ms)) :echo value}
+      {:error (str "params." param-name ": must be " lo "-" hi)})))
+
+(defn resolve-params
+  "The inputs of named query `entry` from the `given` params (keyword keys) and the defaults:
+  {:inputs [one per param, in order] :params {name echo}} or {:errors [message …]}, each message
+  naming params.<name>. Tags resolve with `resolve-tag` and properties with `resolve-property`
+  (the semantic API's own resolvers); a default that no longer resolves is an error like any other."
+  [db {:keys [resolve-tag resolve-property now]} query-name entry given]
+  (let [params (:params entry)
+        known (set (map (comp keyword :name) params))
+        unknown (for [k (keys given) :when (not (contains? known k))]
+                  (str "params." (name k) ": not a param of " query-name " (params: "
+                       (string/join ", " (map :name params)) ")"))
+        resolved (for [{:keys [type required] param-name :name :as param} params
+                       :let [k (keyword param-name)
+                             value (get given k (:default param))]]
+                   (cond
+                     (and required (not (contains? given k)))
+                     {:error (str "params." param-name ": required; give a "
+                                  (if (= :tag type) "tag" "property") " title, UUID or ident")}
+                     (= :tag type) (resolve-tag-param db resolve-tag param value)
+                     (= :property type) (resolve-property-param db resolve-property param value)
+                     (= :days type) (resolve-days-param now param value)))
+        errors (concat unknown (keep :error resolved))]
+    (if (seq errors)
+      {:errors (vec errors)}
+      {:inputs (mapv :input resolved)
+       :params (into {} (map (fn [{param-name :name} {:keys [echo]}] [param-name echo]) params resolved))})))
+
+(def ^:private named-body-fields #{:params :limit :dry-run})
+
+(defn- named-body-errors [body]
+  (if-not (map? body)
+    ["body: give a JSON object with params, limit or dry-run"]
+    (let [{:keys [params limit]} body]
+      (cond-> (mapv #(str (name %) ": not a field; the body takes params, limit and dry-run")
+                    (remove named-body-fields (keys body)))
+        (and (contains? body :params) (not (map? params)))
+        (conj "params: must be an object of param values, e.g. {\"days\": 30}")
+        (and (contains? body :limit) (not (and (integer? limit) (<= 1 limit max-limit))))
+        (conj (str "limit: must be an integer from 1 to " max-limit))
+        (and (contains? body :dry-run) (not (boolean? (:dry-run body)))) (conj "dry-run: must be true or false")))))
+
+(defn- named-response [result]
+  (if (refusal? result)
+    (http/error-response (::error result) (::status result))
+    (http/json-response :semantic/named-query (rows-last result))))
+
+(defn handle-named-query
+  "POST /named-queries/:name: refuses an E2EE graph first, then a name that isn't one (404 listing
+  the names), a body or params that can't be used (each naming params.<name>), and otherwise
+  resolves the params with `resolve-tag` and `resolve-property` and runs the entry as datalogQuery
+  runs a query: the same write-form check, validator, private filter and caps. The response is
+  datalogQuery's plus name, the resolved params (titles and idents) and rules."
+  [{:keys [request db e2ee? self path-params resolve-tag resolve-property]}]
+  (reset! last-run {:private-set-built? false :scanned 0 :joined 0 :pulled 0})
+  (let [query-name (:name path-params)
+        entry (get named-queries/named-queries query-name)]
+    (cond
+      e2ee? (http/error-response "run_named_query is unavailable on an E2EE graph (titles are ciphertext)" 409)
+      (nil? entry) (http/error-response (str "no named query " query-name " (names: "
+                                             (string/join ", " (keys named-queries/named-queries)) ")")
+                                        404)
+      :else
+      (p/let [body (-> (p/let [json (common/read-json request)] (js->clj json :keywordize-keys true))
+                       (p/catch (fn [_] ::malformed)))]
+        (let [body (if (nil? body) {} body)
+              problems (if (= ::malformed body) ["body: give a JSON object with params, limit or dry-run"] (named-body-errors body))]
+          (named-response
+           (if (seq problems)
+             (refusal 400 (string/join "; " problems))
+             (let [{:keys [errors inputs params]} (resolve-params db {:resolve-tag resolve-tag
+                                                                      :resolve-property resolve-property
+                                                                      :now (.now js/Date)}
+                                                                  query-name entry (or (:params body) {}))
+                   checked (when-not errors (checked-query (:query entry) inputs (:rules entry)))
+                   echo {:name query-name :params params :query (pr-str (:query entry))
+                         :inputs (pr-str inputs) :rules (pr-str (or (:rules entry) []))}]
+               (cond
+                 errors (refusal 400 (string/join "; " errors))
+                 (refusal? checked) checked
+                 (true? (:dry-run body)) (assoc echo :dry-run true)
+                 :else (run-query db {:query (:query checked) :inputs inputs :rules (:rules entry)
+                                      :limit (or (:limit body) default-limit)
+                                      :scan-cap (test-cap self "datalogScanCap")
+                                      :row-cap (test-cap self "datalogRowCap")
+                                      :join-cap (test-cap self "datalogJoinCap")
+                                      :echo echo}))))))))))
