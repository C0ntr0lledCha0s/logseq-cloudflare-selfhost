+(deftest every-entry-validates-test
+  ;; The shipped entries run as code; the legacy Datalog without rules (kept here for the parity
+  ;; test) still passes the validator, so the parity test compares against queries datalog_query
+  ;; would run. meetings-without-decision's took rules, which datalog_query refuses, so the parity
+  ;; test runs it with d/q directly.
+  (is (= (set names) (set (keys named-queries/named-queries))))
+  (doseq [[query-name entry] named-queries/named-queries]
+    (is (fn? (:run entry)) query-name)
+    (is (not-any? #(contains? entry %) [:query :rules]) query-name)
+    (is (= (mapv :name (:params entry)) (mapv :name (:params (get legacy-named-queries query-name)))) query-name)
+    (is (= (:columns entry) (mapv str (get-in legacy-named-queries [query-name :query :keys]))) query-name))
+  (doseq [[query-name {:keys [query rules params]}] legacy-named-queries]
+    (let [normalised (datalog/normalise-query query)
+          inputs (mapv (fn [{:keys [type binding]}]
+                         (case type
+                           :tag (if (= :set binding) #{1} [1])
+                           :days 0
+                           :property :block/title))
+                       params)]
+      (is (:ok normalised) (str query-name ": " (:error normalised)))
+      (if rules
+        (is (string/starts-with? (str (datalog/validate-query (:ok normalised) inputs))
+                                 ":in: % is not accepted; datalog_query takes no rules")
+            query-name)
+        (is (nil? (datalog/validate-query (:ok normalised) inputs)) query-name)))))
+
