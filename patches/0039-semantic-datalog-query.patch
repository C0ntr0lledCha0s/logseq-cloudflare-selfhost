+        schema (get-in post [:requestBody :content "application/json" :schema])]
+    (is (= {:handler :semantic/datalog-query :operation-id "datalogQuery" :scope "logseq/read" :rate-class :read
+            :internal-path "/semantic/query"}
+           (select-keys operation [:handler :operation-id :scope :rate-class :internal-path])))
+    (is (= "datalogQuery" (:operationId post)))
+    (is (= #{"query" "inputs" "rules" "limit" "dry-run"} (set (map name (keys (:properties schema))))))
+    (is (= ["query"] (:required schema)))
+    (is (false? (:additionalProperties schema)))
+    (doseq [phrase ["read-only" "Private" "E2EE" ":block/uuid" "share a variable" "default 50"]]
+      (is (string/includes? (:description post) phrase) phrase))))
