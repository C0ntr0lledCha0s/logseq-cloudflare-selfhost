+(deftest pull-shapes-still-run-test
+  ;; Pull forms next to the new refusals run as before: an explicit $, two pulls, a pull beside its
+  ;; own variable or an aggregate, and the pull in either column.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self notes public-note]}]
+        (let [notes-id (:db/id (d/entity @conn [:block/uuid notes]))
+              note-id (:db/id (d/entity @conn [:block/uuid public-note]))
+              cases [["an explicit $" '[:find (pull $ ?b [:block/title]) :where [?b :block/title "zq Notes"]]
+                      [[{:block/title "zq Notes"}]]]
+                     ["the pull and its variable" '[:find ?b (pull ?b [:block/title]) :where [?b :block/title "zq Notes"]]
+                      [[notes-id {:block/title "zq Notes"}]]]
+                     ["the pull first, then a value" '[:find (pull ?b [:block/title]) ?t :where [?b :block/title "zq Public note"]
+                                                       [?b :block/page ?p] [?p :block/title ?t]]
+                      [[{:block/title "zq Public note"} "zq Notes"]]]
+                     ["a value first, then the pull" '[:find ?t (pull ?b [:block/title]) :where [?b :block/title "zq Public note"]
+                                                       [?b :block/page ?p] [?p :block/title ?t]]
+                      [["zq Notes" {:block/title "zq Public note"}]]]
+                     ["two pulls, swapped" '[:find (pull ?p [:block/title]) (pull ?b [:db/id]) :where [?b :block/title "zq Public note"]
+                                             [?b :block/page ?p]]
+                      [[{:block/title "zq Notes"} note-id]]]
+                     ["a pull beside an aggregate" '[:find (pull ?p [:block/title]) (count ?b) :where [?p :block/title "zq Notes"]
+                                                     [?b :block/parent ?p]]
+                      [[{:block/title "zq Notes"} 2]]]
+                     ["a pull with :keys" '[:find (pull ?b [:block/title]) ?t :keys page title :where [?b :block/title "zq Notes"]
+                                            [?b :block/title ?t]]
+                      [[{:block/title "zq Notes"} "zq Notes"]]]
+                     ["a pull of a ref, at the depth limit" '[:find (pull ?b [{:block/page [:block/title]}]) :where
+                                                               [?b :block/title "zq Public note"]]
+                      [[{:block/page {:block/title "zq Notes"}}]]]]]
+          (p/doseq [[label q rows] cases]
+            (p/let [response (query! self q)]
+              (testing label
+                (is (= [200 rows] [(:status response) (get-in response [:body :rows])]) (pr-str response))))))))))
