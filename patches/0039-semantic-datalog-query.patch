+              form (fn [pattern] (vec (concat [:find (list 'pull '?b pattern)] '[:where [?b :block/title "zq Notes"]])))
+              cases [["depth 3" (form '[{:block/parent [{:block/parent [:block/title]}]}])
+                      "find: pull ?b: :block/parent nests the pattern 3 levels deep (at most 2)"]
+                     ["depth 3 through a reverse ref" (form '[{:block/_parent [{:block/_parent [:block/title]}]}])
+                      "find: pull ?b: :block/_parent nests the pattern 3 levels deep (at most 2)"]
+                     ["... as a map value" (form '[{:block/parent ...}])
+                      "find: pull ?b: {:block/parent ...} is a recursive pull"]
+                     ["\"...\" as a map value" (form '[{:block/parent "..."}])
+                      "find: pull ?b: {:block/parent \"...\"} is a recursive pull"]
+                     ["... as an element" (form '[:block/parent ...])
+                      "find: pull ?b: ... is a recursive pull"]
