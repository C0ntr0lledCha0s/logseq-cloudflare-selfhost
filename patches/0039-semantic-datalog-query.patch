+;; The width cap (patch 0039, named queries as code, stage 4)
+;; ===========================================================
+
+(def ^:private width-advice
+  (str "return extra attributes with (pull ?b [...]) in :find, which runs only on the kept rows, bind fewer"
+       " values with functions, or narrow the rows first"))
+
+(defn- width-cap-message [n]
+  (str "query stopped after function bindings copied " n " values (the width cap): each function binding copies"
+       " every column of every row, so many bindings over many rows cost rows x columns (from a page and its"
+       " blocks, 8 bindings fit about 1,900 rows and 12 about 1,000); " width-advice))
+
+(defn- fn-bindings-message [n]
+  (str "query has " n " function bindings, more than the 12 the width cap allows: each function binding copies"
+       " every column of every row bound so far; " width-advice))
+
+(defn- set-width-cap!
+  "The test-only width cap the handler reads from the Durable Object (`self`), in place of the
+  constant; nil restores the constant. No request can set it."
+  [self n]
+  (unchecked-set self "datalogWidthCap" n))
+
+(defn- on-page
+  "A query counting the blocks on page `title`, with `clauses` (EDN strings) after the three data
+  patterns that bind ?p, ?e and ?t."
+  [title clauses]
+  (str "[:find (count ?e) . :where [?p :block/title \"" title "\"] [?e :block/page ?p] [?e :block/title ?t] "
+       (string/join " " clauses) "]"))
+
+(defn- identity-clauses [n] (for [i (range n)] (str "[(identity ?t) ?r" i "]")))
+
+(deftest width-cap-f1-test
+  ;; Each function binding copies every column of every row (bind-by-fn builds one prod-rel per row
+  ;; and sums them), so n bindings over r rows copy about r x n^2 / 2 values while every other cap
+  ;; stays low: 175 [(identity ?t) ?rN] clauses over the 100 blocks of one page answered 200 after
+  ;; about 1.9 s (the 99 over 200 rows stopped at the join cap after 1.4 s, the 20 includes? answered
+  ;; 200 after 0.2 s). A query of more than 12 function bindings (here 176, 100 and 21, the title's
+  ;; included) answers the width cap's 422 before it runs: no private set, no datom, no charge.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self]}]
+        (p/let [p100 (page-id! self "zq Width 100")
+                _ (bulk! self p100 100 #(str "zq w100 " %))
+                p200 (page-id! self "zq Width 200")
+                _ (bulk! self p200 200 #(str "zq w200 " %))
+                p500 (page-id! self "zq Width 500")
+                _ (bulk! self p500 500 #(str "zq w500 " %))
+                before (snapshot conn)
+                cases [["175 identity clauses over 100 blocks" (on-page "zq Width 100" (identity-clauses 175))]
+                       ["99 identity clauses over 200 blocks" (on-page "zq Width 200" (identity-clauses 99))]
+                       ["20 bound includes? over 500 blocks"
+                        (on-page "zq Width 500" (for [i (range 20)] (str "[(clojure.string/includes? ?t \"zq\") ?b" i "]")))]]
+                ;; Each shape runs twice and the second run is timed: the first wide query after the
+                ;; bulk inserts above also pays for V8 compiling Datascript's relation code and for
+                ;; collecting the inserts' garbage (40 to 70 ms more), which the cap does not bound.
+                first-runs (one-by-one! (for [[_ q] cases] #(query! self q)))
+                responses (one-by-one! (for [[_ q] cases] #(query! self q)))]
+          (doseq [[[label q] first-run response] (map vector cases first-runs responses)]
+            (println "width-cap-f1:" label (:status response) (:ms first-run) "ms, then" (:ms response) "ms")
+            (testing (str label ": 422 naming the width cap, within 150 ms")
+              (is (<= (count q) 4000) (str label " " (count q)))
+              (doseq [r [first-run response]]
+                (is (= [422 (fn-bindings-message (count (re-seq #"\[\(" q)))] [(:status r) (get-in r [:body :error])])
+                    (head-of r)))
+              (is (< (:ms response) 150) (head-of response))))
+          (testing "refused before it ran: no private set, no datom, no width charged"
+            (is (= {:private-set-built? false :scanned 0 :width 0}
+                   (select-keys @datalog/last-run [:private-set-built? :scanned :width]))))
+          (is (= before (snapshot conn))))))))
+
+(def ^:private per-row-columns
+  "The per-row shape of review round 1 (r1-correctness-1): a page's blocks with six columns bound by
+  get-else and get-some, and two more for eight."
+  ["[(get-else $ ?b :block/title \"\") ?t]" "[(get-else $ ?b :block/order \"\") ?o]"
+   "[(get-else $ ?b :block/created-at 0) ?c]" "[(get-else $ ?b :block/updated-at 0) ?u]"
+   "[(get-else $ ?p :block/title \"\") ?pt]" "[(get-some $ ?b :block/parent) [_ ?par]]"
+   "[(get-else $ ?b :logseq.property/status \"\") ?s]" "[(get-else $ ?b :logseq.property/priority \"\") ?pr]"])
+
+(defn- per-row-query [title n]
+  (let [cols (take n per-row-columns)
+        vars (map #(second (re-find #"\) \[?_? ?(\?[a-z]+)\]?\]$" %)) cols)]
+    (str "[:find ?b " (string/join " " vars) " :where [?p :block/title \"" title "\"] [?b :block/page ?p] "
+         (string/join " " cols) "]")))
+
+(deftest width-cap-per-row-shapes-test
+  ;; Review round 1 (r1-correctness-1): the width cap of 40,000 refused 6 get-else/get-some columns
+  ;; over 1,500 blocks (charge 49,500) after doing almost all of the work. The per-row shapes a
+  ;; caller writes must answer: 6 columns over 1,500 and 2,000 blocks, 8 over 1,500. (At 2,500 blocks
+  ;; 6 columns reach the join cap, which counts about rows x (bindings + 2), on the base too.)
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self]}]
+        (p/let [big (page-id! self "zq Big")
+                _ (bulk! self big 1500 #(str "zq big " %))
+                full (page-id! self "zq Full")
+                _ (bulk! self full 2000 #(str "zq full " %))
+                before (snapshot conn)
+                six (query! self (per-row-query "zq Big" 6) :limit 200)
+                six-width (:width @datalog/last-run)
+                six-full (query! self (per-row-query "zq Full" 6) :limit 200)
+                six-full-width (:width @datalog/last-run)
+                eight (query! self (per-row-query "zq Big" 8) :limit 200)
+                eight-width (:width @datalog/last-run)]
+          (println "width-per-row: widths" six-width six-full-width eight-width)
+          (testing "6 columns over 1,500 blocks answer 200 with every row counted"
+            (is (= [200 1500 7] [(:status six) (get-in six [:body :total-rows]) (count (get-in six [:body :rows 0]))])
+                (head-of six))
+            (is (= (* 1500 (+ 3 4 5 6 7 8)) six-width)))
+          (testing "6 columns over 2,000 blocks answer 200"
+            (is (= [200 2000] [(:status six-full) (get-in six-full [:body :total-rows])]) (head-of six-full))
+            (is (= (* 2000 (+ 3 4 5 6 7 8)) six-full-width)))
+          (testing "8 columns over 1,500 blocks answer 200"
+            (is (= [200 1500 9] [(:status eight) (get-in eight [:body :total-rows]) (count (get-in eight [:body :rows 0]))])
+                (head-of eight))
+            (is (= (* 1500 (+ 3 4 5 6 7 8 9 10)) eight-width)))
+          (is (= before (snapshot conn))))))))
+
+(deftest width-cap-twelve-wide-test
+  ;; The most bindings a query may hold, over 1,200 rows (under the join cap), stops at the width cap
+  ;; while it runs, naming the cap and the pull it should use instead.
+  (async done
+    (with-graph done
+      (fn [{:keys [self]}]
+        (p/let [full (page-id! self "zq Full")
+                _ (bulk! self full 1200 #(str "zq full " %))
+                q (on-page "zq Full" (identity-clauses 12))
+                [first-run r] (one-by-one! (repeat 2 #(query! self q)))]
+          (println "width-twelve-wide:" (:ms first-run) "ms, then" (:ms r) "ms, width" (:width @datalog/last-run))
+          (is (= [422 (width-cap-message (format-n datalog/width-cap))] [(:status r) (get-in r [:body :error])])
+              (head-of r))
+          (is (string/includes? (get-in r [:body :error]) "(pull ?b [...])"))
+          (is (< datalog/width-cap (:width @datalog/last-run)) "stopped by the running charge")
+          (is (< (:ms r) 400) (head-of r)))))))
+
+(deftest width-fn-binding-count-test
+  ;; Every function-binding form counts toward the 12, at any depth: a scalar, a tuple, a collection
+  ;; and a relation binding, and one inside not, a sourced not, not-join, or, or-join and and. A predicate binds
+  ;; nothing and doesn't count. 12 answer; one more of each kind answers the 422 before running.
+  (async done
+    (with-graph done
+      (fn [{:keys [self]}]
+        (p/let [page (page-id! self "zq Width 100")
+                _ (bulk! self page 100 #(str "zq w100 " %))
+                eleven (identity-clauses 11)
+                ;; on-page's own clauses bind none; the title comes from a data pattern.
+                run (fn [clauses & {:keys [inputs]}]
+                      (p/let [q (if inputs
+                                  (string/replace (on-page "zq Width 100" clauses) ". :where" ". :in $ ?xs :where")
+                                  (on-page "zq Width 100" clauses))
+                              r (query! self q :inputs inputs)]
+                        [(:status r) (get-in r [:body :error]) (get-in r [:body :rows 0 0])]))
+                twelve (run (conj (vec eleven) "[(identity ?t) ?last]"))
+                twelve-and-preds (run (into (conj (vec eleven) "[(identity ?t) ?last]")
+                                            ["[(clojure.string/starts-with? ?t \"zq\")]" "(not [(= ?t \"x\")])"]))
+                kinds [["a scalar" ["[(identity ?t) ?a]" "[(identity ?t) ?b]"]]
+                       ["a tuple" ["[(identity ?t) ?a]" "[(get-some $ ?e :block/parent) [_ ?q]]"]]
+                       ["a collection" ["[(identity ?t) ?a]" "[(get-else $ ?e :block/journal-day ?xs) [?x ...]]"] [1 2]]
+                       ["a relation" ["[(identity ?t) ?a]" "[(get-else $ ?e :block/journal-day ?xs) [[?x ?y]]]"] [[1 2]]]
+                       ["inside not" ["[(identity ?t) ?a]" "(not [(identity ?t) ?n] [(= ?n \"x\")])"]]
+                       ["inside a sourced not" ["[(identity ?t) ?a]" "($ not [(identity ?t) ?n] [(= ?n \"x\")])"]]
+                       ["inside not-join" ["[(identity ?t) ?a]" "(not-join [?t] [(identity ?t) ?n] [(= ?n \"x\")])"]]
+                       ["inside or, both branches" ["(or [(identity ?t) ?n] [(str ?t) ?n])"]]
+                       ["inside or-join" ["[(identity ?t) ?a]" "(or-join [?t] (and [(identity ?t) ?n] [(= ?n ?t)]) [(= ?t \"x\")])"]]]
+                ;; Each case is 11 identity clauses and its own: 13 bindings in all.
+                over (reduce (fn [acc [_ extra inputs]]
+                               (p/let [results acc
+                                       result (run (into (vec eleven) extra) :inputs (when inputs [inputs]))]
+                                 (conj results result)))
+                             (p/resolved []) kinds)]
+          (testing "12 function bindings answer, and predicates beside them don't count"
+            (is (= [200 nil 100] twelve))
+            (is (= [200 nil 100] twelve-and-preds)))
+          (doseq [[[label] result] (map vector kinds over)]
+            (testing (str "a 13th binding, " label ", answers 422 before running")
+              (is (= [422 (fn-bindings-message 13) nil] result)))))))))
+
+
+;; Review round 2 (r2-tests-1): the function-binding limit is a static rule, so a dry run, which
+;; checks the query without running it, must answer the same 422 the real call would.
+(deftest dry-run-applies-fn-binding-limit-test
+  (async done
+    (with-graph done
+      (fn [{:keys [self]}]
+        (p/let [_ (reset! datalog/last-run nil)
+                twelve (query! self (on-page "zq Notes" (identity-clauses 12)) :dry-run true)
+                thirteen (query! self (on-page "zq Notes" (identity-clauses 13)) :dry-run true)
+                after-dry-run @datalog/last-run
+                nested (query! self (on-page "zq Notes" (concat (identity-clauses 12) ["(not [(identity ?t) ?n] [(= ?n \"x\")])"]))
+                               :dry-run true)
+                real (query! self (on-page "zq Notes" (identity-clauses 13)))]
+          (testing "12 function bindings pass the dry run"
+            (is (= [200 true] [(:status twelve) (get-in twelve [:body :dry-run])]) (pr-str twelve)))
+          (testing "13 answer the 422 the real call answers, and nothing runs"
+            (is (= [422 (fn-bindings-message 13)] [(:status thirteen) (get-in thirteen [:body :error])]) (pr-str thirteen))
+            (is (= [422 (fn-bindings-message 13)] [(:status real) (get-in real [:body :error])]) (pr-str real))
+            (is (= {:private-set-built? false :scanned 0 :joined 0 :width 0 :pulled 0} after-dry-run)))
+          (testing "a binding nested inside not counts in the dry run too"
+            (is (= [422 (fn-bindings-message 13)] [(:status nested) (get-in nested [:body :error])]) (pr-str nested))))))))
+
+(deftest width-cap-legitimate-test
+  ;; A few function bindings over the row cap's rows stay far under the width cap, a query of data
+  ;; patterns only charges nothing, the charge starts afresh on every request, and narrowing the rows
+  ;; before the bindings charges less than binding first.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self]}]
+        (p/let [wide (page-id! self "zq Wide")
+                _ (bulk! self wide 2500 #(str "zq wide " %))
+                before (snapshot conn)
+                three '[:find (count ?e) . :where [?e :block/title ?t] [(clojure.string/starts-with? ?t "zq wide ")]
+                        [(identity ?t) ?a] [(clojure.string/lower-case ?t) ?b] [(get-else $ ?e :block/uuid "") ?c]]
+                [first-run second-run third-run] (one-by-one! (repeat 3 #(query! self three)))
+                three-width (:width @datalog/last-run)
+                patterns (query! self '[:find ?e ?t :where [?p :block/title "zq Wide"] [?e :block/page ?p] [?e :block/title ?t]])
+                patterns-width (:width @datalog/last-run)
+                narrow-first (query! self '[:find (count ?e) . :where [?e :block/title ?t]
+                                            [(clojure.string/starts-with? ?t "zq wide 1")] [(identity ?t) ?a]])
+                narrow-width (:width @datalog/last-run)
+                bind-first (query! self '[:find (count ?e) . :where [?e :block/title ?t] [(identity ?t) ?a]
+                                          [(clojure.string/starts-with? ?t "zq wide 1")]])
+                bind-width (:width @datalog/last-run)]
+          (testing "3 bindings over 2,500 rows, at width 5, answer 200, every time they are sent"
+            (doseq [response [first-run second-run third-run]]
+              (is (= [200 2500] [(:status response) (get-in response [:body :rows 0 0])]) (head-of response)))
+            (is (= (* 2500 (+ 3 4 5)) three-width) (pr-str three-width)))
+          (testing "data patterns only, over the row cap's rows, charge nothing"
+            (is (= [200 2500] [(:status patterns) (get-in patterns [:body :total-rows])]) (head-of patterns))
+            (is (= 0 patterns-width)))
+          (testing "either clause order answers; narrowing first charges less"
+            (is (= [200 1111] [(:status narrow-first) (get-in narrow-first [:body :rows 0 0])]) (head-of narrow-first))
+            (is (= [200 1111] [(:status bind-first) (get-in bind-first [:body :rows 0 0])]) (head-of bind-first))
+            (is (= (* 1111 3) narrow-width) (pr-str narrow-width))
+            (is (< narrow-width bind-width) (pr-str [narrow-width bind-width])))
+          (is (= before (snapshot conn))))))))
