+(deftest private-fn-is-memoised-test
+  ;; Asking about every block of a 40-level chain, deepest first, walks each ancestor once: reads
+  ;; grow with the chain, not its square. Without the memo the deepest block's walk would be
+  ;; repeated for each block above it.
+  (async done
+    (-> (p/let [conn (sqlite-export/create-conn)
+                self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true}
+                _ (tag-pairs! self ["zq Chain Top" "zq Chain End"])
+                page (p/let [r (ok! (request! self "POST" "/semantic/pages" {:title "zq Chain"}) 201)] (uuid-of r))
+                _ (deep-chain! self page "zq level" 40 "zq Chain Top" "zq Chain End")]
+          (let [db @conn
+                chain (->> (d/q '[:find ?e ?t :where [?e :block/title ?t] [(clojure.string/starts-with? ?t "zq level ")]] db)
+                           (sort-by #(js/parseInt (subs (second %) 9)))
+                           (mapv first))
+                ctx (walk-ctx db)
+                private? (named-queries/private-fn ctx)]
+            (is (= 40 (count chain)))
+            (is (every? false? (map private? (reverse chain))))
+            (let [reads (work ctx :reads)]
+              (is (<= reads (* 8 41)) (str "reads linear in the chain: " reads))
+              (is (every? false? (map private? chain)))
+              (is (= reads (work ctx :reads)) "asking again reads nothing"))))
+        (p/catch #(is false (str % "\n" (.-stack %))))
+        (p/finally done))))
