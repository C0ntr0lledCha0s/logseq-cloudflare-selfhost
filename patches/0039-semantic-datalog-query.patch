+(deftest caps-documented-test
+  (let [document (semantic-routes/openapi-document "https://issuer.example")
+        post (get-in document [:paths "/api/v1/graphs/{graph-id}/query" :post])
+        truncated (get-in document [:components :schemas :DatalogQueryResponse :properties :truncated])]
+    (doseq [phrase ["scan cap" "20,000 datoms" "422" "truncated" "byte-cap" "100,000 characters" "at most 2 levels deep"
+                    "at most 50 values" "refs as numbers" "left recursion"]]
+      (is (string/includes? (:description post) phrase) phrase))
+    (is (= ["limit" "byte-cap"] (get-in truncated [:properties :by :enum])))
+    (is (string/includes? (get-in post [:responses "422" :description] "") "scan cap"))
+    (is (string/includes? (get-in post [:responses "422" :description] "") "20,000 datoms"))))
