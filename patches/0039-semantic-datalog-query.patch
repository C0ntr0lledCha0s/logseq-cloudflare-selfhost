+                     ["a relation" '[:find ?t ?k :in $ [[?t ?k]] :where [?e :block/title ?t]] '[[["zq Notes" 1]]] [["zq Notes" 1]]]
+                     ["a tuple" '[:find ?t :in $ [?t ?u] :where [?e :block/title ?t] [?e :block/title ?u]] '[["zq Notes" "zq Notes"]] notes-only]
+                     ["% before the inputs" '[:find ?t :in $ % ?tag :where (tagged ?e ?tag) [?e :block/title ?t]] '["Project"]
+                      [["zq Public Plans"]]]
+                     ["% after the inputs" '[:find ?t :in $ ?tag % :where (tagged ?e ?tag) [?e :block/title ?t]] '["Project"]
+                      [["zq Public Plans"]]]
+                     [":db/id in a pull pattern" '[:find (pull ?e [:block/title]) :where [?e :block/title "zq Notes"] [?e :db/ident ?i]]
+                      nil []]
+                     ["$ named in a pattern and in get-else" '[:find ?t ?o :where [$ ?e :block/title "zq Notes"] [?e :block/title ?t]
+                                                                [(get-else $ ?e :logseq.property/icon "none") ?o]]
+                      nil [["zq Notes" "none"]]]
+                     ["a chain whose join comes last" '[:find ?t :where [?b :block/title ?t] [?p :block/title "zq Notes"]
+                                                         [?b :block/parent ?p] [(clojure.string/starts-with? ?t "zq Public")]]
+                      nil [["zq Public note"]]]
+                     ["the same chain reversed" '[:find ?t :where [?b :block/parent ?p] [?p :block/title "zq Notes"]
+                                                   [?b :block/title ?t] [(clojure.string/starts-with? ?t "zq Public")]]
+                      nil [["zq Public note"]]]
+                     ["a function binding joins" '[:find ?t :where [?e :block/title ?t] [(clojure.string/lower-case ?t) ?l]
+                                                    [?p :block/name ?l] [(= ?l "zq notes")]]
+                      nil notes-only]
+                     ["a scalar find" '[:find ?t . :where [?e :block/title "zq Notes"] [?e :block/title ?t]] nil notes-only]
+                     ["a collection find" '[:find [?t ...] :where [?e :block/title ?t] [(clojure.string/starts-with? ?t "zq Public")]]
+                      nil [["zq Public Plans"] ["zq Public child"] ["zq Public note"]]]
+                     ["an aggregate" '[:find (count ?e) :where [?e :block/title ?t] [(clojure.string/starts-with? ?t "zq Public")]]
+                      nil [[3]]]]
+              rules '[[(tagged ?e ?tag) [?e :block/tags ?c] [?c :block/title ?tag]]]]
+          (p/doseq [[label form inputs rows] cases]
+            (p/let [response (query! self form :inputs inputs :rules (when (some #{'%} (flatten form)) rules))]
+              (testing label
+                (is (= [200 rows] [(:status response) (get-in response [:body :rows])]) (pr-str response))))))))))
+
+(deftest datascript-errors-are-400-test
+  ;; An error Datascript raises while running the caller's query is the caller's: a 400 naming it.
+  (async done
+    (with-graph done
+      (fn [{:keys [self]}]
+        (p/let [unbound (query! self '[:find ?t :where [(clojure.string/starts-with? ?t "zq")] [?e :block/title ?t]])]
+          (is (refused? unbound "query: Insufficient bindings: #{?t} not bound in [(clojure.string/starts-with? ?t")
+              (pr-str unbound)))))))
+
+(deftest pull-keeps-db-id-test
+  ;; :db/id as a pull attribute is a read, not the :db/id map a write would send.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self notes]}]
+        (p/let [response (query! self '[:find (pull ?e [:db/id :block/title]) :where [?e :block/title "zq Notes"]])]
+          (is (= [200 [[{:db/id (:db/id (d/entity @conn [:block/uuid notes])) :block/title "zq Notes"}]]]
+                 [(:status response) (get-in response [:body :rows])])
+              (pr-str response)))))))
+
+(deftest private-page-without-parent-chain-test
+  ;; A block whose :block/page is private is hidden even when its :block/parent chain doesn't reach
+  ;; the page (a stale page ref, as an uploaded graph can hold): the page rule, not only the
+  ;; descendant walk, hides it.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self private-plans public-note]}]
+        (d/transact! conn [{:block/uuid (random-uuid) :block/title "zq stale private block"
+                            :block/page [:block/uuid private-plans] :block/parent [:block/uuid public-note]
+                            :block/order "a1" :block/created-at 1 :block/updated-at 1}])
+        (p/let [response (query! self zq-titles :limit 200)]
+          (is (= 200 (:status response)) (pr-str response))
+          (is (not (string/includes? (:text response) "zq stale private block")) (:text response)))))))
