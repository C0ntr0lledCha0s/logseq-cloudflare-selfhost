+    :description "Pages tagged tag (or a tag extending it) that have no value for property."
+    :columns ["page"]
+    :bounds [:tagged :reads]
+    :run pages-missing-property
+    :params [{:name "tag" :type :tag :required true}
+             {:name "property" :type :property :required true}]}))
+
+(defn run-named
+  "Runs named query `query-name` on `db` (a db value, never the conn) with `resolved`
+  ({:inputs {param-name input} :params {param-name echo}}) under `bounds`, counting into `work` (a
+  volatile map; a new one when not given): {:rows :work :plan}. Past a bound it throws
+  (ex-info … {::bound {:query :bound :value}}); the rows found so far are never returned."
+  ([query-name db resolved bounds] (run-named query-name db resolved bounds (volatile! {})))
+  ([query-name db {:keys [inputs params]} bounds work]
+   (let [{:keys [run]} (get named-queries query-name)
+         ctx {:db db :query query-name :bounds bounds :work work}
+         rows (run ctx inputs)]
+     {:rows rows :work @work :plan (plan-text query-name params bounds)})))
