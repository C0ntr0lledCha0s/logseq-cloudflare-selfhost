+(deftest get-some-step-counts-test
+  ;; A step up through get-some reads one datom per row through the filter, so every datom it reads
+  ;; counts toward the scan cap. (This was rule-recursion-through-get-some-test, whose walk up was a
+  ;; rule; a query takes no rules now, so it steps up with get-some clauses instead.)
+  (async done
+    (with-graph done
+      (fn [{:keys [self conn]}]
+        (p/let [before (snapshot conn)
+                q '[:find ?t :where [?b :block/title "zq Public child"] [(get-some $ ?b :block/parent) [_ ?a]]
+                    [(get-some $ ?a :block/parent) [_ ?g]] [?g :block/title ?t]]
+                walked (query! self q)
+                _ (set-scan-cap! self 2)
+                capped (query! self q)
+                _ (set-scan-cap! self nil)]
+          (testing "two steps up from a block reach its parent's parent, the page"
+            (is (= [200 [["zq Notes"]]] [(:status walked) (get-in walked [:body :rows])]) (pr-str walked)))
+          (testing "every datom get-some reads counts towards the scan cap"
+            (is (= [422 (cap-message "2")] [(:status capped) (get-in capped [:body :error])]) (pr-str capped)))
+          (is (= before (snapshot conn))))))))
