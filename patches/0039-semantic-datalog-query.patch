+(deftest cross-product-test
+  (async done
+    (with-graph done
+      (fn [{:keys [self]}]
+        (p/let [disjoint (query! self '[:find ?a ?b :where [?a :block/title "zq Notes"] [?b :block/title "zq Public Plans"]])
+                third (query! self '[:find ?a ?b :where [?a :block/title ?t] [?b :block/title ?u] [(= ?t "zq Notes")]])
+                pred-only (query! self '[:find ?a ?b :where [?a :block/created-at ?x] [?b :block/created-at ?y] [(< ?x ?y)]])
+                rule-join (query! self '[:find ?ta ?tb :in $ % :where [?a :block/title ?ta] [?b :block/title ?tb]
+                                         [(= ?tb "zq Notes")] (child ?a ?b)]
+                                  :rules '[[(child ?a ?b) [?a :block/parent ?b]]])
+                or-join (query! self '[:find ?ta ?tb :where [?a :block/title ?ta] [?b :block/title "zq Notes"]
+                                       [?b :block/title ?tb]
+                                       (or-join [?a ?b] [?a :block/parent ?b] [?a :block/page ?b])])
+                not-join (query! self '[:find ?ta :where [?a :block/title ?ta] [?a :block/page ?p]
+                                        [?p :block/title "zq Notes"] [?b :block/title "zq Public note"]
+                                        (not-join [?a ?b] [?a :block/parent ?b])])]
+          (is (refused? disjoint "where: clauses 1 and 2 share no variable (a cross product); join them through a shared variable")
+              (pr-str disjoint))
+          (is (refused? third "where: clauses 1 and 2 share no variable") (pr-str third))
+          (testing "a predicate filters a cross product, it doesn't join one"
+            (is (refused? pred-only "where: clauses 1 and 2 share no variable") (pr-str pred-only)))
+          (testing "a rule call and an or-join join their arguments"
+            (is (= 200 (:status rule-join)) (pr-str rule-join))
+            (is (contains? (set (get-in rule-join [:body :rows])) ["zq Public note" "zq Notes"]))
+            (is (= 200 (:status or-join)) (pr-str or-join))
+            (is (contains? (set (get-in or-join [:body :rows])) ["zq Public child" "zq Notes"])))
+          (testing "not-join's variables join"
+            (is (= 200 (:status not-join)) (pr-str not-join))
+            (is (not (contains? (set (map first (get-in not-join [:body :rows]))) "zq Public child")))))))))
