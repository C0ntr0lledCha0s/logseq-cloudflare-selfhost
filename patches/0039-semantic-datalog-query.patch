+;; Named queries as code (stage 2): the four queries walk the indexes under named bounds
+;; ====================================================================================
+
+(defn- set-bounds!
+  "The test-only named-query bounds the handler reads from the Durable Object (`self`); nil
+  restores the defaults. No request can set them."
+  [self m]
+  (unchecked-set self "namedQueryBounds" (when m (clj->js m))))
+
+(defn- chain
+  "A block tree: blocks titled `titles`, each the only child of the one before, the last holding
+  `leaves` (block maps)."
+  [titles leaves]
+  (let [[t & more] titles]
+    (cond-> {:title t}
+      more (assoc :children [(chain more leaves)])
+      (and (not more) (seq leaves)) (assoc :children (vec leaves)))))
+
+(defn- tagged-block [title tags & children]
+  (cond-> {:title title :properties {"block/tags" (vec tags)}}
+    (seq children) (assoc :children (vec children))))
+
+(defn- page-id! [self title]
+  (p/let [r (ok! (request! self "POST" "/semantic/pages" {:title title}) 201)] (uuid-of r)))
+
+(defn- tag-in-batches!
+  "Adds tag `title` to every page or block in `ids`, 100 to a batch-set call."
+  [self ids title]
+  (reduce (fn [acc batch]
+            (p/let [_ acc]
+              (ok! (request! self "POST" "/semantic/block-properties/batch-set"
+                             {:entries (vec (for [id batch] {:block-id (str id) :property-id "block/tags" :value [title]}))})
+                   200)))
+          (p/resolved nil) (partition-all 100 ids)))
+
+(defn- meeting-group!
+  "Spec §8 item 1's layout under tags `meet` and `dec` (created here): `m` meetings, alternately a
+  page of their own and a block on a shared log page, and `d` decisions, each `depth` levels below
+  the meeting or page top it sits under. Half the decisions are spread over the first half of the
+  meetings (decisions beside the other meeting blocks on the log page, not under them); the rest
+  sit `depth` levels down on a page with no meeting. Returns the titles of the meetings no
+  decision is under."
+  [self prefix m d depth]
+  (p/let [meet (str prefix " Meet")
+          dec-tag (str prefix " Dec")
+          _ (tag-pairs! self [meet dec-tag])
+          log (page-id! self (str prefix " log"))
+          other (page-id! self (str prefix " other"))
+          half (quot m 2)
+          under (quot d 2)
+          decision (fn [j] (tagged-block (str prefix " decision " j) [dec-tag]))
+          levels (fn [label] (mapv #(str prefix " " label " level " %) (range 1 depth)))
+          own (group-by #(mod % half) (range under))
+          _ (reduce (fn [acc i]
+                      (p/let [_ acc
+                              title (str prefix " meeting " i)
+                              leaves (mapv decision (get own i))
+                              body (chain (levels (str "m" i)) (if (seq leaves) leaves [{:title (str prefix " m" i " leaf")}]))]
+                        (if (even? i)
+                          (p/let [page (page-id! self title)
+                                  _ (set-tags! self page [meet])]
+                            (insert! self page [body]))
+                          (insert! self log [(assoc (tagged-block title [meet]) :children [body])]))))
+                    (p/resolved nil) (range m))
+          _ (insert! self other [(chain (levels "other") (mapv decision (range under d)))])]
+    (set (for [i (range m) :when (empty? (get own i))] (str prefix " meeting " i)))))
+
+(defn- deep-meetings!
+  "`m` meeting blocks tagged `meet` on one page, each with `n` decisions tagged `dec` `depth` levels
+  below it, and one more meeting with a chain that deep and no decision. Returns that one's title."
+  [self prefix m n depth]
+  (p/let [meet (str prefix " Meet")
+          dec-tag (str prefix " Dec")
+          _ (tag-pairs! self [meet dec-tag])
+          page (page-id! self (str prefix " page"))
+          _ (reduce (fn [acc i]
+                      (p/let [_ acc]
+                        (insert! self page [(assoc (tagged-block (str prefix " meeting " i) [meet])
+                                                   :children [(chain (mapv #(str prefix " m" i " level " %) (range 1 depth))
+                                                                     (mapv #(tagged-block (str prefix " m" i " decision " %) [dec-tag]) (range n)))])])))
+                    (p/resolved nil) (range m))
+          _ (insert! self page [(assoc (tagged-block (str prefix " undecided") [meet])
+                                       :children [(chain (mapv #(str prefix " u level " %) (range 1 (inc depth))) [])])])]
+    #{(str prefix " undecided")}))
+
+(defn- answer-of [r] [(:status r) (get-in r [:body :error])])
+
+(deftest named-scale-meetings-test
+  ;; Review 2's F2 sizes. The Datalog not-join joined every meeting in the window to every
+  ;; decision and walked each pair up, so 10 meetings and 200 decisions 6 levels down stopped at
+  ;; the join cap. The walk up from each decision into one shared set costs one step per distinct
+  ;; ancestor, so every size answers, at any depth.
+  (async done
+    (-> (p/let [conn (sqlite-export/create-conn)
+                self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true}
+                a (meeting-group! self "zq ga" 10 200 6)
+                b (meeting-group! self "zq gb" 50 40 6)
+                c (meeting-group! self "zq gc" 5 400 6)
+                deep (deep-meetings! self "zq gd" 20 3 40)
+                _ (tag-pairs! self ["zq ge Meet" "zq ge Dec"])
+                deepest-page (page-id! self "zq ge page")
+                _ (deep-chain! self deepest-page "zq ge level" 181 "zq ge Meet" "zq ge Dec")
+                [lone] (insert! self deepest-page [(tagged-block "zq ge lone meeting" ["zq ge Meet"])])
+                filler (page-id! self "zq filler")
+                _ (bulk! self filler 5000 #(str "zq filler " %))
+                cases [["10 meetings x 200 decisions, 6 levels down" "zq ga" a]
+                       ["50 meetings x 40 decisions, 6 levels down" "zq gb" b]
+                       ["5 meetings x 400 decisions, 6 levels down" "zq gc" c]
+                       ["20 meetings x 3 decisions, 40 levels down" "zq gd" deep]
+                       ["a decision 180 levels down" "zq ge" #{(:title lone)}]]
+                responses (one-by-one! (for [[_ prefix] cases] #(meetings! self (str prefix " Meet") (str prefix " Dec"))))]
+          (doseq [[[label _ expected] r] (map vector cases responses)]
+            (println "named-scale-meetings:" label (:status r) (:ms r) "ms" (pr-str (get-in r [:body :work])))
+            (testing label
+              (is (= [200 nil] (answer-of r)) (head-of r))
+              (is (= expected (set (row-titles r 1))) (head-of r))
+              (is (= (count expected) (get-in r [:body :total-rows])) (head-of r)))))
+        (p/catch #(is false (str % "\n" (.-stack %))))
+        (p/finally done))))
+
+(deftest named-scale-f3-test
+  ;; Review 2's F3 sizes on one graph of 20,000 filler blocks: 150 open tasks across 3 clients (75
+  ;; with the client on the task, 75 on its page), 700 tagged pages none of which has the property
+  ;; (the Datalog scanned its tag past the scan cap), and 50 stale project pages, 10 of them with a
+  ;; fresh block (the Datalog read every block's page to check them).
+  (async done
+    (-> (p/let [conn (sqlite-export/create-conn)
+                self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true}
+                _ (tag-pairs! self ["zq Proj" "zq Area"])
+                for-client (ok! (request! self "POST" "/semantic/properties" {:title "zq for client" :type "node"}) 201)
+                client-path (js/encodeURIComponent (get-in for-client [:body :ident]))
+                _ (ok! (request! self "POST" "/semantic/properties" {:title "zq area owner" :type "node"}) 201)
+                client! (fn [id client] (ok! (request! self "PUT" (str "/semantic/blocks/" id "/properties/" client-path) {:value client}) 200))
+                clients ["zq Client 0" "zq Client 1" "zq Client 2"]
+                _ (p/all (map #(page-id! self %) clients))
+                ;; Tasks: pages 0-14 carry the client, pages 15-29 leave it to each task.
+                work-pages (reduce (fn [acc i] (p/let [acc acc id (page-id! self (str "zq work " i))] (conj acc id)))
+                                   (p/resolved []) (range 30))
+                expected-tasks
+                (reduce (fn [acc [i page]]
+                          (p/let [acc acc
+                                  _ (when (< i 15) (client! page (clients (mod i 3))))
+                                  pairs (reduce (fn [acc k]
+                                                  (p/let [acc acc
+                                                          title (str "zq task " i "-" k)
+                                                          r (ok! (request! self "POST" "/semantic/tasks" {:title title :page-id (str page) :status (["todo" "doing" "backlog"] (mod k 3))}) 201)
+                                                          client (clients (mod (+ i k) 3))
+                                                          _ (when (>= i 15) (client! (uuid-of r) client))]
+                                                    (conj acc [(if (< i 15) (clients (mod i 3)) client) title])))
+                                                (p/resolved acc) (range 5))
+                                  _ (ok! (request! self "POST" "/semantic/tasks" {:title (str "zq task done " i) :page-id (str page) :status (["done" "canceled"] (mod i 2))}) 201)]
+                            pairs))
+                        (p/resolved []) (map-indexed vector work-pages))
+                ;; 700 pages tagged zq Area without zq area owner.
+                area-pages (reduce (fn [acc i] (p/let [acc acc id (page-id! self (str "zq area " i))] (conj acc id)))
+                                   (p/resolved []) (range 700))
+                _ (tag-in-batches! self area-pages "zq Area")
+                ;; 50 stale projects, 3 blocks each; 10 keep one fresh block.
+                projects (reduce (fn [acc i] (p/let [acc acc id (page-id! self (str "zq project " i))] (conj acc id)))
+                                 (p/resolved []) (range 50))
+                _ (tag-in-batches! self projects "zq Proj")
+                project-blocks (reduce (fn [acc [i page]]
+                                         (p/let [acc acc
+                                                 blocks (insert! self page (vec (for [k (range 3)] {:title (str "zq project " i " block " k)})))]
+                                           (conj acc (mapv (comp uuid :uuid) blocks))))
+                                       (p/resolved []) (map-indexed vector projects))
+                filler (reduce (fn [acc i] (p/let [acc acc id (page-id! self (str "zq filler page " i))] (conj acc id)))
+                               (p/resolved []) (range 4))
+                _ (reduce (fn [acc page] (p/let [_ acc] (bulk! self page 5000 #(str "zq filler " %))))
+                          (p/resolved nil) filler)]
+          (age! conn :block/updated-at 60 (concat projects (mapcat (fn [i blocks] (if (< i 10) (rest blocks) blocks))
+                                                                   (range) project-blocks)))
+          (p/let [[tasks areas untouched]
+                  (one-by-one! [#(named! self "open-tasks-by-client" {:params {:client_property "zq for client"} :limit 200})
+                                #(named! self "pages-missing-property" {:params {:tag "zq Area" :property "zq area owner"} :limit 200})
+                                #(named! self "projects-untouched" {:params {:tag "zq Proj" :days 30} :limit 200})])]
+            (doseq [[label r] [["150 open tasks" tasks] ["700 tagged pages" areas] ["50 stale projects over 20,000 blocks" untouched]]]
+              (println "named-scale-f3:" label (:status r) (:ms r) "ms" (pr-str (get-in r [:body :work]))))
+            (testing "150 open tasks across 3 clients, task-level and page-level"
+              (is (= [200 nil] (answer-of tasks)) (head-of tasks))
+              (is (= (sort expected-tasks) (sort (mapv (fn [[c t]] [c (:block/title t)]) (get-in tasks [:body :rows])))) (head-of tasks))
+              (is (= 150 (get-in tasks [:body :total-rows]))))
+            (testing "700 tagged pages missing the property: every one counted, the first 200 by creation"
+              (is (= [200 nil] (answer-of areas)) (head-of areas))
+              (is (= [700 200 "limit"] [(get-in areas [:body :total-rows]) (get-in areas [:body :returned])
+                                        (get-in areas [:body :truncated :by])]) (head-of areas))
+              (is (= (mapv #(str "zq area " %) (range 200)) (row-titles areas 0)) (head-of areas)))
+            (testing "50 stale projects over 20,000 blocks: the 40 without a fresh block"
+              (is (= [200 nil] (answer-of untouched)) (head-of untouched))
+              (is (= (set (map #(str "zq project " %) (range 10 50))) (set (row-titles untouched 1))) (head-of untouched))
+              (is (= 40 (get-in untouched [:body :total-rows]))))))
+        (p/catch #(is false (str % "\n" (.-stack %))))
+        (p/finally done))))
+
+;; Parity with the Datalog the queries replace
+;; ---------------------------------------------
+
+(defn- test-resolvers
+  "Tag and property resolvers for resolve-params: by exact title (the handler's own also take a
+  UUID, an ident or another case; parity needs only one)."
+  []
+  {:resolve-tag (fn [db v]
+                  (some->> (d/q '[:find ?e . :in $ ?t :where [?e :block/title ?t] [?e :block/tags ?c] [?c :db/ident :logseq.class/Tag]] db v)
+                           (d/entity db)))
+   :resolve-property (fn [db v]
+                       (some->> (d/q '[:find ?e . :in $ ?t :where [?e :block/title ?t] [?e :logseq.property/type _]] db v)
+                                (d/entity db)))})
+
+(defn- legacy-rows
+  "`query-name`'s legacy Datalog run with d/q over the private filter, as run-query ran it: pulls
+  replaced by their entity, rows sorted by sort-rows; the last column then as the entity's uuid."
+  [db query-name params]
+  (let [entry (get legacy-named-queries query-name)
+        {:keys [inputs errors]} (datalog/resolve-params db (assoc (test-resolvers) :now (.now js/Date)) query-name entry params)
+        _ (assert (nil? errors) (pr-str errors))
+        fdb (datalog/query-filter db (datalog/private-ids db) (datalog/ref-attrs db) (volatile! 0) js/Number.MAX_SAFE_INTEGER)
+        query (:query entry)
+        q (-> query (dissoc :keys) (assoc :find (:find (datalog/rewrite-pulls (:find query)))))
+        args (cond-> [fdb] (:rules entry) (conj (:rules entry)))]
+    (->> (apply d/q q (into args inputs))
+         (map vec)
+         datalog/sort-rows
+         (mapv (fn [row] (update row (dec (count row)) #(str (:block/uuid (d/entity db %)))))))))
+
+(defn- code-rows
+  "The rows of a named-query response, the pulled column as its uuid."
+  [response]
+  (mapv (fn [row] (update row (dec (count row)) :block/uuid)) (get-in response [:body :rows])))
+
+(defn- parity!
+  "Runs each of `calls` ([query-name params]) through the handler (limit 200) and with the legacy
+  Datalog, and asserts the same rows in the same order; `label` names the graph."
+  [conn self label calls]
+  (reduce (fn [acc [query-name params]]
+            (p/let [counts acc
+                    r (named! self query-name {:params params :limit 200})
+                    legacy (legacy-rows @conn query-name params)]
+              (testing (str label ", " query-name " " (pr-str params))
+                (is (= 200 (:status r)) (head-of r))
+                (is (< (count legacy) 200) "every row fits in one response")
+                (is (= legacy (code-rows r)) (pr-str {:legacy legacy :code (code-rows r)})))
+              (conj counts (count legacy))))
+          (p/resolved []) calls))
+
+(defn- seed-review-focus!
+  "On a seed-named graph, the inputs the spec implies and no headline test exercises (plan review
+  focus 1-4 and 7-10), each under its own titles."
+  [{:keys [conn self]}]
+  (p/let [clients (ok! (request! self "POST" "/semantic/properties" {:title "zq clients" :type "node" :cardinality "db.cardinality/many"}) 201)
+          clients-path (js/encodeURIComponent (get-in clients [:body :ident]))
+          put! (fn [id path value] (ok! (request! self "PUT" (str "/semantic/blocks/" id "/properties/" path) {:value value}) 200))
+          ;; 1. A meeting block that is itself tagged Decision, with nothing below it.
+          f1 (page-id! self "zq F1")
+          _ (insert! self f1 [(tagged-block "zq f1 meeting decision" ["Business Meeting" "Decision"])])
+          ;; 2. A decision beside a meeting block, and one under a sibling meeting.
+          f2 (page-id! self "zq F2")
+          _ (insert! self f2 [(tagged-block "zq f2 meeting a" ["Business Meeting"] (tagged-block "zq f2 decision a" ["Decision"]))
+                              (tagged-block "zq f2 meeting b" ["Business Meeting"] {:title "zq f2 notes b"})
+                              (tagged-block "zq f2 beside" ["Decision"])])
+          ;; 3. A meeting nested in a meeting, sharing the walk up, and a sibling meeting under the
+          ;;    outer one whose walk stops at the outer one.
+          f3 (page-id! self "zq F3")
+          _ (insert! self f3 [(tagged-block "zq f3 outer" ["Business Meeting"]
+                                            (tagged-block "zq f3 inner" ["Business Meeting"]
+                                                          {:title "zq f3 x" :children [(tagged-block "zq f3 decision" ["Decision"])
+                                                                                       (tagged-block "zq f3 decision two" ["Key Decision"])]})
+                                            (tagged-block "zq f3 sibling" ["Business Meeting"]
+                                                          {:title "zq f3 y" :children [(tagged-block "zq f3 sibling decision" ["Decision"])]}))])
+          ;; 4. A private decision under a public meeting, and a decision under a private block.
+          f4 (page-id! self "zq F4")
+          _ (insert! self f4 [(tagged-block "zq f4 meeting" ["Business Meeting"] (tagged-block "zq f4 private decision" ["Decision" "Private"]))
+                              (tagged-block "zq f4 meeting two" ["Business Meeting"]
+                                            (tagged-block "zq f4 hidden" ["Private"] (tagged-block "zq f4 under hidden" ["Decision"])))])
+          ;; 7. Two clients with one title, a private client beside a public one, and a private
+          ;;    client alone (on a page with a client, and on one without).
+          twin-page (page-id! self "zq Twin")
+          twins (page-id! self "zq Twins")
+          [twin-block] (insert! self twins [{:title "zq Twin"}])
+          hidden-client (page-id! self "zq Hidden Client")
+          _ (set-tags! self hidden-client ["Private"])
+          acme (ffirst (d/q '[:find ?u :where [?p :block/title "zq Acme"] [?p :block/uuid ?u]] @conn))
+          beta (ffirst (d/q '[:find ?u :where [?p :block/title "zq Beta"] [?p :block/uuid ?u]] @conn))
+          f7 (page-id! self "zq F7")
+          f7-client (page-id! self "zq F7 client page")
+          _ (put! f7-client clients-path [(str beta)])
+          task! (fn [title page] (p/let [r (ok! (request! self "POST" "/semantic/tasks" {:title title :page-id (str page) :status "todo"}) 201)] (uuid-of r)))
+          twin-task (task! "zq f7 twin task" f7)
+          _ (put! twin-task clients-path [(str twin-page) (:uuid twin-block)])
+          mixed-task (task! "zq f7 mixed task" f7)
+          _ (put! mixed-task clients-path [(str acme) (str hidden-client)])
+          fallback-task (task! "zq f7 fallback task" f7-client)
+          _ (put! fallback-task clients-path [(str hidden-client)])
+          empty-task (task! "zq f7 empty task" f7)
+          _ (put! empty-task clients-path [(str hidden-client)])
+          ;; 8. A client value with no title.
+          untitled (page-id! self "zq Untitled Client")
+          untitled-task (task! "zq f8 untitled task" f7)
+          _ (put! untitled-task clients-path [(str untitled)])
+          ;; 9. A stale project whose only fresh block is private.
+          f9 (page-id! self "zq F9 Project")
+          _ (set-tags! self f9 ["Project"])
+          [f9-block] (insert! self f9 [(tagged-block "zq f9 private" ["Private"])])
+          ;; 10. A recycled stale project, and a recycled decision under a meeting.
+          f10 (page-id! self "zq F10 Project")
+          _ (set-tags! self f10 ["Project"])
+          [f10-meeting] (insert! self f2 [(tagged-block "zq f10 meeting" ["Business Meeting"] (tagged-block "zq f10 decision" ["Decision"]))])
+          _ (ok! (request! self "DELETE" (str "/semantic/blocks/" (get-in f10-meeting [:children 0 :uuid])) nil) 200)
+          _ (ok! (request! self "DELETE" (str "/semantic/pages/" f10) nil) 200)]
+    (d/transact! conn [[:db.fn/retractAttribute [:block/uuid untitled] :block/title]])
+    (age! conn :block/updated-at 60 [f9 f10])
+    {:clients (get-in clients [:body :ident]) :f9-block (:uuid f9-block)}))
+
+(deftest named-review-focus-test
+  (async done
+    (with-named done
+      (fn [{:keys [conn self] :as graph}]
+        (p/let [_ (seed-review-focus! graph)
+                meetings (named! self "meetings-without-decision" {:limit 200})
+                tasks (named! self "open-tasks-by-client" {:params {:client_property "zq clients"} :limit 200})
+                projects (named! self "projects-untouched" {:limit 200})
+                meeting-titles (set (row-titles meetings 1))
+                pairs (set (mapv (fn [[c t]] [c (:block/title t)]) (get-in tasks [:body :rows])))]
+          (is (= [200 200 200] (map :status [meetings tasks projects])) (pr-str (map head-of [meetings tasks projects])))
+          (testing "1. a meeting block tagged Decision itself, with nothing below it, is a row"
+            (is (contains? meeting-titles "zq f1 meeting decision")))
+          (testing "2. a decision beside a meeting block doesn't decide it; one under a sibling meeting decides only that one"
+            (is (contains? meeting-titles "zq f2 meeting b"))
+            (is (not (contains? meeting-titles "zq f2 meeting a"))))
+          (testing "3. nested meetings share the walk up, and the outer one stays decided"
+            (is (empty? (filter #(string/starts-with? % "zq f3") meeting-titles)) (pr-str meeting-titles)))
+          (testing "4. a private decision, or one under a private block, decides nothing"
+            (is (contains? meeting-titles "zq f4 meeting"))
+            (is (contains? meeting-titles "zq f4 meeting two")))
+          (testing "7. two clients with one title are one row; a private client is left out, falling back to the page's, else empty"
+            (is (= #{["zq Twin" "zq f7 twin task"]} (set (filter #(= "zq f7 twin task" (second %)) pairs))))
+            (is (= #{["zq Acme" "zq f7 mixed task"]} (set (filter #(= "zq f7 mixed task" (second %)) pairs))))
+            (is (= #{["zq Beta" "zq f7 fallback task"]} (set (filter #(= "zq f7 fallback task" (second %)) pairs))))
+            (is (= #{["" "zq f7 empty task"]} (set (filter #(= "zq f7 empty task" (second %)) pairs))))
+            (is (not (string/includes? (:text tasks) "zq Hidden Client"))))
+          (testing "8. a client value with no title is the empty client"
+            (is (= #{["" "zq f8 untitled task"]} (set (filter #(= "zq f8 untitled task" (second %)) pairs)))))
+          (testing "9. a stale project whose only fresh block is private is still a row"
+            (is (contains? (set (row-titles projects 1)) "zq F9 Project")))
+          (testing "10. a recycled project is never a row, and a recycled decision decides nothing"
+            (is (not (contains? (set (row-titles projects 1)) "zq F10 Project")))
+            (is (contains? meeting-titles "zq f10 meeting")))
+          (parity! conn self "review focus"
+                   [["projects-untouched" {}] ["projects-untouched" {:days 1}] ["meetings-without-decision" {}]
+                    ["meetings-without-decision" {:days 365}] ["open-tasks-by-client" {}]
+                    ["open-tasks-by-client" {:client_property "zq clients"}]
+                    ["pages-missing-property" {:tag "Project" :property "forClient"}]
+                    ["pages-missing-property" {:tag "Business Meeting" :property "zq clients"}]]))))))
+
+(defn- extend-for-named!
+  "Adds to a seed-random-graph graph what the named queries read, shaped by `seed`: tags zq Meet,
+  zq Dec, zq Key Dec (extends zq Dec) and zq Sub Project (extends zq Project); a many node property
+  zq client; meetings, decisions and projects on random pages and blocks (added to their tags, so
+  the random private tags stay); tasks of every status with clients on tasks and pages, one client
+  private; and created-at and updated-at stamps moved back by random whole days."
+  [{:keys [conn self]} seed]
+  (let [rand (prng (+ 1000 seed))
+        pick (fn [xs] (when (seq xs) (xs (rand (count xs)))))]
+    (p/let [tag! (fn [body] (ok! (request! self "POST" "/semantic/tags" body) 201))
+            _ (tag! {:title "zq Meet"})
+            _ (tag! {:title "zq Dec"})
+            _ (tag! {:title "zq Key Dec" :extends ["zq Dec"]})
+            _ (tag! {:title "zq Sub Project" :extends ["zq Project"]})
+            prop (ok! (request! self "POST" "/semantic/properties" {:title "zq client" :type "node" :cardinality "db.cardinality/many"}) 201)
+            path (js/encodeURIComponent (get-in prop [:body :ident]))
+            db @conn
+            live? (fn [e] (let [ent (d/entity db e)]
+                            (and (nil? (:logseq.property/deleted-at ent)) (nil? (:logseq.property/deleted-at (:block/page ent))))))
+            uuid-of-e (fn [e] (:block/uuid (d/entity @conn e)))
+            pages (vec (sort (d/q '[:find [?e ...] :where [?e :block/title ?t] [(clojure.string/starts-with? ?t "zq page ")] [(missing? $ ?e :block/page)]] db)))
+            blocks (vec (sort (d/q '[:find [?e ...] :where [?e :block/title ?t] [(clojure.string/starts-with? ?t "zq b")] [?e :block/page _]] db)))
+            pages (filterv live? pages)
+            blocks (filterv live? blocks)
+            nodes (into pages blocks)
+            add-tag! (fn [e title]
+                       (ok! (request! self "POST" "/semantic/block-properties/batch-set"
+                                      {:entries [{:block-id (str (uuid-of-e e)) :property-id "block/tags" :value [title]}]})
+                            200))
+            meetings (vec (distinct (repeatedly 4 #(pick nodes))))
+            decisions (vec (distinct (repeatedly 6 #(pick blocks))))
+            projects (vec (distinct (concat (repeatedly 3 #(pick pages)) [(pick blocks)])))
+            _ (reduce (fn [acc [e t]] (p/let [_ acc] (add-tag! e t)))
+                      (p/resolved nil)
+                      (concat (map #(vector % "zq Meet") meetings)
+                              (map #(vector % (if (even? (rand 2)) "zq Dec" "zq Key Dec")) decisions)
+                              (map #(vector % (if (even? (rand 2)) "zq Project" "zq Sub Project")) projects)))
+            client-pages (p/all (for [k (range 3)] (page-id! self (str "zq cl " seed " " k))))
+            _ (set-tags! self (client-pages 2) [(:block/title (d/entity db (ffirst (d/q '[:find ?e :where [?e :block/title ?t] [?e :block/tags ?c] [?c :db/ident :logseq.class/Tag] [(contains? #{"Private" "PRIVATE" "private"} ?t)]] db))))])
+            put! (fn [id value] (ok! (request! self "PUT" (str "/semantic/blocks/" id "/properties/" path) {:value value}) 200))
+            _ (reduce (fn [acc page]
+                        (p/let [_ acc]
+                          (when (zero? (rand 2)) (put! (uuid-of-e page) [(str (pick client-pages))]))))
+                      (p/resolved nil) pages)
+            tasks (reduce (fn [acc i]
+                            (p/let [acc acc
+                                    r (ok! (request! self "POST" "/semantic/tasks"
+                                                     {:title (str "zq task " seed " " i) :page-id (str (uuid-of-e (pick pages)))
+                                                      :status (["todo" "doing" "done" "canceled" "backlog"] (rand 5))})
+                                           201)
+                                    task (uuid-of r)
+                                    n (rand 3)
+                                    _ (when (pos? n) (put! task (vec (distinct (repeatedly n #(str (pick client-pages)))))))]
+                              (conj acc task)))
+                          (p/resolved []) (range 8))]
+      (age! conn :block/created-at 100 (keep #(when (zero? (rand 2)) (uuid-of-e %)) meetings))
+      (let [db @conn
+            on-page (fn [p] (map uuid-of-e (d/q '[:find [?b ...] :in $ ?p :where [?b :block/page ?p]] db p)))]
+        (age! conn :block/updated-at 60
+              (mapcat (fn [p] (case (rand 3)
+                                0 (cons (uuid-of-e p) (on-page p))
+                                1 [(uuid-of-e p)]
+                                []))
+                      projects)))
+      tasks)))
+
+(deftest named-parity-test
+  ;; On 30 seeded graphs (Stage 1's, extended with meetings, decisions at random depths, projects,
+  ;; tasks and clients), every query's rows and their order equal the legacy Datalog's over the
+  ;; private filter.
+  (async done
+    (-> (reduce
+         (fn [acc seed]
+           (p/let [counts acc
+                   graph (seed-random-graph seed)
+                   _ (extend-for-named! graph seed)
+                   n (parity! (:conn graph) (:self graph) (str "seed " seed)
+                              [["projects-untouched" {:tag "zq Project" :days 30}]
+                               ["meetings-without-decision" {:meeting_tag "zq Meet" :decision_tag "zq Dec" :days 90}]
+                               ["meetings-without-decision" {:meeting_tag "zq Meet" :decision_tag "zq Key Dec" :days 3650}]
+                               ["open-tasks-by-client" {:client_property "zq client"}]
+                               ["pages-missing-property" {:tag "zq Project" :property "zq client"}]
+                               ["pages-missing-property" {:tag "zq Topic" :property "zq client"}]])]
+             (conj counts n)))
+         (p/resolved []) (range 1 31))
+        (p/then (fn [counts]
+                  (testing "the seeded graphs give each call rows to compare on most seeds"
+                    (doseq [[i label] (map-indexed vector ["projects-untouched" "meetings Dec" "meetings Key Dec" "open tasks" "missing zq Project"])]
+                      (is (<= 15 (count (filter #(pos? (nth % i)) counts))) (str label ": " (pr-str (map #(nth % i) counts))))))))
+        (p/catch #(is false (str % "\n" (.-stack %))))
+        (p/finally done))))
+
+(deftest named-parity-seed-named-test
+  (async done
+    (with-named done
+      (fn [{:keys [conn self]}]
+        (parity! conn self "seed-named"
+                 [["projects-untouched" {}] ["projects-untouched" {:days 1}] ["projects-untouched" {:tag "Client Project"}]
+                  ["meetings-without-decision" {}] ["meetings-without-decision" {:days 365}]
+                  ["meetings-without-decision" {:decision_tag "Key Decision"}]
+                  ["open-tasks-by-client" {}]
+                  ["pages-missing-property" {:tag "Project" :property "forClient"}]])))))
+
+;; Review round 1 (r1-tests-1): `tagged` reads one AVET datom per tag, so an entity tagged both a tag
+;; and a tag extending it is read twice; the walks must still count it once, as the Datalog's set did.
+(deftest named-double-tagged-test
+  (async done
+    (with-named done
+      (fn [{:keys [conn self]}]
+        (p/let [_ (ok! (request! self "POST" "/semantic/tags" {:title "zq Board Meeting" :extends ["Business Meeting"]}) 201)
+                project (page-id! self "zq Double Project")
+                _ (set-tags! self project ["Project" "Client Project"])
+                meeting (page-id! self "zq Double Meeting")
+                _ (insert! self meeting [{:title "zq double agenda"}])
+                _ (set-tags! self meeting ["Business Meeting" "zq Board Meeting"])
+                decided (page-id! self "zq Double Decided")
+                [decision] (insert! self decided [{:title "zq double decision"}])
+                _ (set-tags! self decided ["Business Meeting"])
+                _ (set-tags! self (:uuid decision) ["Decision" "Key Decision"])
+                _ (age! conn :block/updated-at 60 [project])
+                projects (named! self "projects-untouched" {:limit 200})
+                missing (named! self "pages-missing-property" {:params {:tag "Project" :property "forClient"} :limit 200})
+                meetings (named! self "meetings-without-decision" {:limit 200})
+                key-meetings (named! self "meetings-without-decision" {:params {:decision_tag "Key Decision"} :limit 200})
+                once (fn [response col title]
+                       (testing (str title " is one row, and total-rows counts it once")
+                         (is (= 200 (:status response)) (head-of response))
+                         (is (= 1 (count (filter #{title} (row-titles response col)))) (pr-str (row-titles response col)))
+                         (is (= (count (get-in response [:body :rows])) (get-in response [:body :total-rows]))
+                             (pr-str (select-keys (:body response) [:total-rows :returned])))))]
+          (once projects 1 "zq Double Project")
+          (once missing 0 "zq Double Project")
+          (once meetings 1 "zq Double Meeting")
+          (testing "a decision tagged Decision and Key Decision decides its meeting once"
+            (is (not (contains? (set (row-titles meetings 1)) "zq Double Decided")))
+            (is (not (contains? (set (row-titles key-meetings 1)) "zq Double Decided"))))
+          (parity! conn self "double tagged"
+                   [["projects-untouched" {}] ["pages-missing-property" {:tag "Project" :property "forClient"}]
+                    ["pages-missing-property" {:tag "Business Meeting" :property "forClient"}]
+                    ["meetings-without-decision" {}] ["meetings-without-decision" {:decision_tag "Key Decision"}]]))))))
+
+;; Review round 2 (r2-correctness-1): the legacy `above` rule walked :block/parent from a decision
+;; through its page to any page above it, so a decision on a page nested under a meeting page (a
+;; namespace child, whose :block/parent the outliner's split-namespace sets to the parent page), or
+;; a page tagged Decision whose parent is the meeting page, decided the meeting. The walk must too.
+(deftest named-decision-under-nested-page-test
+  (async done
+    (with-named done
+      (fn [{:keys [conn self undecided]}]
+        (let [parent! (fn [child parent]
+                        (d/transact! conn [[:db/add [:block/uuid (uuid (str child))] :block/parent
+                                            [:block/uuid (uuid (str parent))]]]))]
+          (p/let [;; A decision block on a child page of a meeting page.
+                  child (page-id! self "zq Minutes Child")
+                  _ (parent! child undecided)
+                  [child-decision] (insert! self child [{:title "zq child decision"}])
+                  _ (set-tags! self (:uuid child-decision) ["Decision"])
+                  ;; A Key Decision two pages down: a grandchild page of a meeting page.
+                  grand-meeting (page-id! self "zq Grand Meeting")
+                  _ (set-tags! self grand-meeting ["Business Meeting"])
+                  middle (page-id! self "zq Grand Middle")
+                  _ (parent! middle grand-meeting)
+                  grandchild (page-id! self "zq Grand Child")
+                  _ (parent! grandchild middle)
+                  [deep] (insert! self grandchild [{:title "zq grand notes" :children [{:title "zq grand decision"}]}])
+                  _ (set-tags! self (get-in deep [:children 0 :uuid]) ["Key Decision"])
+                  ;; A page tagged Decision whose parent is a meeting page.
+                  page-meeting (page-id! self "zq Page Decided Meeting")
+                  _ (set-tags! self page-meeting ["Business Meeting"])
+                  decision-page (page-id! self "zq Decision Page")
+                  _ (parent! decision-page page-meeting)
+                  _ (set-tags! self decision-page ["Decision"])
+                  ;; Control: a child page under a meeting, with no decision on it.
+                  bare-meeting (page-id! self "zq Bare Meeting")
+                  _ (set-tags! self bare-meeting ["Business Meeting"])
+                  bare-child (page-id! self "zq Bare Child")
+                  _ (parent! bare-child bare-meeting)
+                  _ (insert! self bare-child [{:title "zq bare notes"}])
+                  meetings (named! self "meetings-without-decision" {:limit 200})
+                  key-meetings (named! self "meetings-without-decision" {:params {:decision_tag "Key Decision"} :limit 200})
+                  titles (set (row-titles meetings 1))]
+            (is (= [200 200] (map :status [meetings key-meetings])) (pr-str (map head-of [meetings key-meetings])))
+            (testing "a decision on a child page, a grandchild page, or a child page tagged Decision decides the meeting"
+              (is (not (contains? titles "zq Meeting Undecided")) (pr-str titles))
+              (is (not (contains? titles "zq Grand Meeting")) (pr-str titles))
+              (is (not (contains? titles "zq Page Decided Meeting")) (pr-str titles)))
+            (testing "a child page with no decision decides nothing"
+              (is (contains? titles "zq Bare Meeting") (pr-str titles)))
+            (testing "under Key Decision only the Key Decision's meeting is decided"
+              (is (= #{"zq Meeting Undecided" "zq Page Decided Meeting" "zq Bare Meeting"}
+                     (set (filter #{"zq Meeting Undecided" "zq Grand Meeting" "zq Page Decided Meeting" "zq Bare Meeting"}
+                                  (row-titles key-meetings 1))))))
+            (parity! conn self "nested pages"
+                     [["meetings-without-decision" {}] ["meetings-without-decision" {:days 365}]
+                      ["meetings-without-decision" {:decision_tag "Key Decision"}]])))))))
+
+;; Bounds, clock, read-only and the response
+;; -----------------------------------------
+
+(def ^:private named-bound-cases
+  "Each query's bounds, a call that charges each of them on seed-named, and the 422 each answers,
+  with the bound's value at %s."
+  [["projects-untouched" nil
+    {:tagged "projects-untouched stopped after %s tagged pages and blocks (its tagged bound); give a narrower tag"
+     :page-blocks "projects-untouched stopped after reading %s blocks on pages not updated within days (its page-blocks bound); give a narrower tag or a larger days"
+     :reads "projects-untouched stopped after %s reads (its reads bound, the backstop over every read); give a narrower tag or a larger days"}]
+   ["meetings-without-decision" nil
+    {:meetings "meetings-without-decision stopped after %s meetings created within days (its meetings bound); give a smaller days or a narrower meeting_tag"
+     :decisions "meetings-without-decision stopped after %s blocks tagged decision_tag (its decisions bound); give a narrower decision_tag"
+     :ancestor-steps "meetings-without-decision stopped after %s steps up from blocks tagged decision_tag (its ancestor-steps bound); give a smaller days or a narrower meeting_tag or decision_tag"
+     :reads "meetings-without-decision stopped after %s reads (its reads bound, the backstop over every read); give a smaller days or a narrower meeting_tag or decision_tag"}]
+   ["open-tasks-by-client" nil
+    {:tasks "open-tasks-by-client stopped after %s blocks tagged Task (its tasks bound); list one client's tasks with datalog_query"
+     :open-tasks "open-tasks-by-client found more than %s open tasks (its open-tasks bound); mark finished tasks Done or Canceled, or list one client's tasks with datalog_query"
+     :reads "open-tasks-by-client stopped after %s reads (its reads bound, the backstop over every read); list one client's tasks with datalog_query"}]
+   ["pages-missing-property" {:params {:tag "Project" :property "forClient"}}
+    {:tagged "pages-missing-property stopped after %s tagged pages and blocks (its tagged bound); give a narrower tag"
+     :reads "pages-missing-property stopped after %s reads (its reads bound, the backstop over every read); give a narrower tag"}]])
+
+(defn- bound-text [template n] (string/replace template "%s" (format-n n)))
+
+(deftest named-bound-messages-test
+  ;; The spec's four messages, word for word, at the default bounds (the numbers the release bundle
+  ;; set in stage 5).
+  (doseq [[query-name bound text]
+          [["meetings-without-decision" :meetings "meetings-without-decision stopped after 2,000 meetings created within days (its meetings bound); give a smaller days or a narrower meeting_tag"]
+           ["projects-untouched" :page-blocks "projects-untouched stopped after reading 10,000 blocks on pages not updated within days (its page-blocks bound); give a narrower tag or a larger days"]
+           ["open-tasks-by-client" :open-tasks "open-tasks-by-client found more than 2,000 open tasks (its open-tasks bound); mark finished tasks Done or Canceled, or list one client's tasks with datalog_query"]
+           ["pages-missing-property" :tagged "pages-missing-property stopped after 2,500 tagged pages and blocks (its tagged bound); give a narrower tag"]]]
+    (is (= text (named-queries/bound-message {:query query-name :bound bound :value (get named-queries/default-bounds bound)})))))
+
+(deftest named-bounds-test
+  ;; Each bound, set through namedQueryBounds to exactly what the query counts on seed-named,
+  ;; answers the same rows; one lower answers the bound's own 422, and last-run shows the count
+  ;; reached one past it.
+  (async done
+    (with-named done
+      (fn [{:keys [conn self]}]
+        (-> (reduce
+             (fn [acc [query-name body messages]]
+               (reduce
+                (fn [acc [bound template]]
+                  (p/let [_ acc
+                          _ (set-bounds! self nil)
+                          free (named! self query-name body)
+                          counted (get-in @datalog/last-run [:named-work bound])
+                          _ (set-bounds! self {bound counted})
+                          at (named! self query-name body)
+                          _ (set-bounds! self {bound (dec counted)})
+                          before (snapshot conn)
+                          over (named! self query-name body)
+                          over-work (get-in @datalog/last-run [:named-work bound])
+                          after (snapshot conn)
+                          _ (set-bounds! self nil)]
+                    (testing (str query-name ", its " (name bound) " bound")
+                      (is (= 200 (:status free)) (head-of free))
+                      (is (pos-int? counted) (pr-str (:named-work @datalog/last-run)))
+                      (is (= [200 (get-in free [:body :rows])] [(:status at) (get-in at [:body :rows])]) (str "at the bound: " (head-of at)))
+                      (is (= [422 (bound-text template (dec counted))] (answer-of over)) (head-of over))
+                      (is (= counted over-work) "work shows the bound + 1")
+                      (is (nil? (get-in over [:body :rows])) "no rows found so far")
+                      (is (= before after)))))
+                acc messages))
+             (p/resolved nil) named-bound-cases)
+            (p/finally #(set-bounds! self nil)))))))
+
+;; Review round 1 (r1-light-1): the candidate bounds (tasks, page-blocks, decisions) must be able to
+;; stop a query before the reads backstop does, so their 422 names what to narrow. Each runs on the
+;; shape that reaches it most directly (finished tasks, one stale page of many blocks, decisions
+;; side by side), with every bound at a tenth of its default: reads per candidate don't depend on
+;; the scale, and the fixed reads (tags, classes) weigh more at a tenth, so this is the harder case.
+(deftest named-candidate-bounds-trip-before-reads-test
+  (async done
+    (-> (p/let [conn (sqlite-export/create-conn)
+                self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true}
+                tenth (fn [bound] (quot (get named-queries/default-bounds bound) 10))
+                over (fn [bound] (inc (tenth bound)))
+                _ (tag-pairs! self ["zq tb Proj" "zq tb Meet" "zq tb Dec"])
+                _ (ok! (request! self "POST" "/semantic/properties" {:title "forClient" :type "node"}) 201)
+                ;; Finished tasks, one past the tasks bound.
+                task-page (page-id! self "zq tb tasks")
+                _ (insert! self task-page (vec (for [i (range (over :tasks))]
+                                                 {:title (str "zq tb task " i)
+                                                  :properties {"block/tags" ["Task"] "logseq.property/status" "Done"}})))
+                ;; A stale project page with one block past the page-blocks bound, every one stale.
+                project (page-id! self "zq tb project")
+                _ (set-tags! self project ["zq tb Proj"])
+                blocks (bulk! self project (over :page-blocks) #(str "zq tb block " %))
+                ;; A meeting, and decisions side by side on another page, one past the decisions bound.
+                meeting (page-id! self "zq tb meeting")
+                _ (set-tags! self meeting ["zq tb Meet"])
+                decisions (page-id! self "zq tb decisions")
+                _ (insert! self decisions (vec (for [i (range (over :decisions))] (tagged-block (str "zq tb decision " i) ["zq tb Dec"]))))
+                _ (age! conn :block/updated-at 60 (cons project (map :uuid blocks)))
+                bounds (into {} (map (juxt identity tenth)) (keys named-queries/default-bounds))
+                cases [[:tasks "open-tasks-by-client" nil]
+                       [:page-blocks "projects-untouched" {:params {:tag "zq tb Proj"}}]
+                       [:decisions "meetings-without-decision" {:params {:meeting_tag "zq tb Meet" :decision_tag "zq tb Dec"}}]]
+                responses (one-by-one! (for [[_ query-name body] cases]
+                                         #(p/let [_ (set-bounds! self bounds)
+                                                  r (named! self query-name body)
+                                                  work (:named-work @datalog/last-run)]
+                                            (assoc r :work work))))]
+          (set-bounds! self nil)
+          (doseq [[[bound query-name] r] (map vector cases responses)]
+            (testing (str query-name " stops at its " (name bound) " bound, before reads")
+              (is (= 422 (:status r)) (head-of r))
+              (is (string/includes? (str (get-in r [:body :error])) (str "(its " (name bound) " bound)"))
+                  (pr-str (get-in r [:body :error]) (:work r)))
+              (is (< (get-in r [:work :reads] 0) (tenth :reads)) (pr-str (:work r))))))
+        (p/catch #(is false (str % "\n" (.-stack %))))
+        (p/finally done))))
+
+(deftest named-no-clock-test
+  ;; No walk reads the clock: a run calls Date.now exactly as often as its dry run, which only
+  ;; resolves the params (days becomes a cutoff from one Date.now).
+  (async done
+    (with-named done
+      (fn [{:keys [self]}]
+        (let [original (.-now js/Date)
+              calls (atom 0)
+              counted (fn [thunk] (p/let [_ (reset! calls 0) r (thunk)] [r @calls]))]
+          (set! (.-now js/Date) (fn [] (swap! calls inc) (original)))
+          (-> (reduce (fn [acc [query-name body]]
+                        (p/let [_ acc
+                                [dry dry-calls] (counted #(named! self query-name (assoc body :dry-run true)))
+                                [run run-calls] (counted #(named! self query-name body))]
+                          (is (= [200 200] [(:status dry) (:status run)]) (head-of run))
+                          (is (= dry-calls run-calls) (str query-name ": " dry-calls " calls in the dry run, " run-calls " in the run"))))
+                      (p/resolved nil)
+                      (for [[query-name body] named-bound-cases] [query-name (or body {})]))
+              (p/finally #(set! (.-now js/Date) original))))))))
+
+(deftest named-read-only-test
+  ;; The walks read a db value and never the conn: max-tx and the datom count are unchanged after
+  ;; every query, answered or refused at a bound.
+  (async done
+    (with-named done
+      (fn [{:keys [conn self]}]
+        (reduce (fn [acc [query-name body]]
+                  (p/let [_ acc
+                          before (snapshot conn)
+                          answered (named! self query-name body)
+                          _ (set-bounds! self {:reads 1})
+                          refused (named! self query-name body)
+                          _ (set-bounds! self nil)]
+                    (is (= [200 422] [(:status answered) (:status refused)]) (head-of refused))
+                    (is (= before (snapshot conn)) query-name)))
+                (p/resolved nil)
+                (for [[query-name body] named-bound-cases] [query-name body]))))))
+
+(deftest named-contract-test
+  (async done
+    (with-named done
+      (fn [{:keys [self]}]
+        (p/let [limited (named! self "open-tasks-by-client" {:limit 1})
+                runs (p/all (for [[query-name body] named-bound-cases] (named! self query-name body)))
+                _ (set-bounds! self {:meetings 0 :reads 0})
+                dry (named! self "meetings-without-decision" {:dry-run true})
+                dry-work (:named-work @datalog/last-run)
+                refused (named! self "meetings-without-decision" nil)
+                _ (set-bounds! self nil)
+                e2ee-unknown (named! self "nope" nil true)
+                unknown (named! self "nope" nil)
+                bad-days (named! self "projects-untouched" {:params {:days 0}})]
+          (testing "keys in order, rows last, and no Datalog echo"
+            (let [text (:text limited)
+                  at (fn [k] (string/index-of text (str "\"" k "\":")))]
+              (is (= ["name" "params" "columns" "total-rows" "returned" "truncated" "plan" "work" "rows"]
+                     (vec (sort-by at (filter at ["name" "params" "columns" "total-rows" "returned" "truncated" "plan" "work" "rows" "query" "inputs" "rules"])))))
+              (is (= "rows" (last (js-keys (js/JSON.parse text)))))))
+          (testing "the limit note is unchanged"
+            (is (= {:by "limit" :note "returned 1 of 3 rows (limit 1, maximum 200); narrow the query or add a :where clause"}
+                   (get-in limited [:body :truncated]))))
+          (doseq [[[query-name _ messages] r] (map vector named-bound-cases runs)]
+            (testing (str query-name ": plan names each bound and its number, work counts each bound and reads")
+              (is (= 200 (:status r)) (head-of r))
+              (doseq [bound (keys messages)]
+                (is (string/includes? (get-in r [:body :plan]) (str (name bound) " bound " (format-n (get named-queries/default-bounds bound))))
+                    (str (name bound) ": " (get-in r [:body :plan]))))
+              (is (= (set (keys messages)) (set (keys (get-in r [:body :work])))) (pr-str (get-in r [:body :work])))
+              (is (every? nat-int? (vals (get-in r [:body :work]))))
+              (is (pos-int? (get-in r [:body :work :reads])))
+              (is (not-any? #(contains? (:body r) %) [:query :inputs :rules :bounds :dry-run]))))
+          (testing "dry run: name, params, plan and bounds, nothing read, a bound of 0 ignored"
+            (is (= 200 (:status dry)) (head-of dry))
+            (is (= [:name :params :plan :bounds :dry-run] (mapv keyword (js-keys (js/JSON.parse (:text dry))))))
+            (is (= {:meetings 0 :decisions 10000 :ancestor-steps 10000 :reads 0} (get-in dry [:body :bounds])))
+            (is (= {} dry-work))
+            (is (= 422 (:status refused)) "the same bound refuses the run"))
+          (testing "E2EE before the name, then the 404 and the params 400 unchanged"
+            (is (= 409 (:status e2ee-unknown)))
+            (is (= 404 (:status unknown)))
+            (is (refused? bad-days "params.days: must be 1-3650"))))))))
+
+(deftest named-byte-cap-test
+  ;; The byte cap cuts a named query's rows as it cuts datalog_query's, with the same note.
+  (async done
+    (with-named done
+      (fn [{:keys [self]}]
+        (p/let [_ (ok! (request! self "POST" "/semantic/tags" {:title "zq Long"}) 201)
+                pages (reduce (fn [acc i] (p/let [acc acc id (page-id! self (long-title i))] (conj acc id)))
+                              (p/resolved []) (range 40))
+                _ (tag-in-batches! self pages "zq Long")
+                r (named! self "pages-missing-property" {:params {:tag "zq Long" :property "forClient"} :limit 200})
+                kept (get-in r [:body :returned])]
+          (is (= 200 (:status r)) (head-of r))
+          (is (< 0 kept 40) (pr-str kept))
+          (is (= 40 (get-in r [:body :total-rows])))
+          (is (= {:by "byte-cap"
+                  :note (str "returned " kept " of 40 rows (the byte cap, about 100,000 characters of JSON); pull fewer"
+                             " attributes, narrow the query or lower limit")}
+                 (get-in r [:body :truncated])))
+          (is (<= (count (:text r)) 100000)))))))
+
+(deftest named-response-documented-test
+  ;; runNamedQuery's text names every bound with the number default-bounds gives it, so the help
+  ;; and Claude read the numbers the server uses.
+  (let [document (semantic-routes/openapi-document "https://issuer.example")
+        post (get-in document [:paths "/api/v1/graphs/{graph-id}/named-queries/{name}" :post])
+        description (:description post)
+        n (fn [bound] (format-n (get named-queries/default-bounds bound)))
+        response (get-in document [:components :schemas :NamedQueryResponse :properties])]
+    (doseq [phrase [(str (n :meetings) " meetings created within days (its meetings bound)")
+                    (str (n :decisions) " blocks tagged decision_tag (its decisions bound)")
+                    (str (n :ancestor-steps) " steps up from blocks tagged decision_tag (its ancestor-steps bound)")
+                    (str (n :tagged) " tagged pages and blocks (its tagged bound)")
+                    (str (n :page-blocks) " blocks on pages not updated within days (its page-blocks bound)")
+                    (str (n :tasks) " blocks tagged Task (its tasks bound)")
+                    (str (n :open-tasks) " open tasks (its open-tasks bound)")
+                    (str (n :reads) " reads (its reads bound")
+                    "a decision at any depth" "plan" "work" "422 naming the bound"
+                    "Runs one of four read-only queries as server code, not Datalog"]]
+      (is (string/includes? description phrase) phrase))
+    (doseq [gone ["rule cap" "levels deep" "scan cap" "query, inputs and rules as EDN"]]
+      (is (not (string/includes? description gone)) gone))
+    (is (string/includes? (get-in post [:responses "422" :description] "") "named bound"))
+    (is (not (string/includes? (get-in post [:responses "422" :description] "") "rule cap")))
+    (is (= #{:plan :work} (set (filter #{:plan :work :query :inputs :rules} (keys response))))
+        (pr-str (keys response)))
+    (is (contains? response :bounds) "the dry run's bounds")))
+
