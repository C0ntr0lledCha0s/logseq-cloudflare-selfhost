+(deftest pull-pattern-refusals-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self]}]
+        (let [find-notes (fn [pattern] (list '[:find] (list 'pull '?b pattern) :where '[?b :block/title "zq Notes"]))
+              form (fn [pattern] (vec (concat [:find (list 'pull '?b pattern)] '[:where [?b :block/title "zq Notes"]])))
+              cases [["depth 3" (form '[{:block/parent [{:block/parent [:block/title]}]}])
+                      "find: pull ?b: :block/parent nests the pattern 3 levels deep (at most 2)"]
+                     ["depth 3 through a reverse ref" (form '[{:block/_parent [{:block/_parent [:block/title]}]}])
+                      "find: pull ?b: :block/_parent nests the pattern 3 levels deep (at most 2)"]
+                     ["... as a map value" (form '[{:block/parent ...}])
+                      "find: pull ?b: {:block/parent ...} is a recursive pull"]
+                     ["\"...\" as a map value" (form '[{:block/parent "..."}])
+                      "find: pull ?b: {:block/parent \"...\"} is a recursive pull"]
+                     ["... as an element" (form '[:block/parent ...])
+                      "find: pull ?b: ... is a recursive pull"]
+                     ["a recursion number" (form '[{:block/_parent 3}])
+                      "find: pull ?b: {:block/_parent 3} is a recursive pull"]
+                     ["(limit :block/refs 51)" (form '[(limit :block/refs 51)])
+                      "find: pull ?b: :block/refs takes a limit from 1 to 50 (got 51)"]
+                     ["[:block/refs :limit 51]" (form '[[:block/refs :limit 51]])
+                      "find: pull ?b: :block/refs takes a limit from 1 to 50 (got 51)"]
+                     ["[\"limit\" :block/refs 51]" (form '[["limit" :block/refs 51]])
+                      "find: pull ?b: :block/refs takes a limit from 1 to 50 (got 51)"]
+                     ["(limit :block/refs nil), no limit" (form '[(limit :block/refs nil)])
+                      "find: pull ?b: :block/refs takes a limit from 1 to 50 (got nil)"]
+                     ["a limit on a map key" (form '[{(limit :block/refs 51) [:block/title]}])
+                      "find: pull ?b: :block/refs takes a limit from 1 to 50 (got 51)"]
+                     ["a limit at depth 2" (form '[{:block/page [(limit :block/tags 51)]}])
+                      "find: pull ?b: :block/tags takes a limit from 1 to 50 (got 51)"]
+                     [":xform" (form '[[:block/title :xform clojure.string/upper-case]])
+                      "find: pull ?b: :xform on :block/title is not allowed"]
+                     ["a pattern from inputs" '[:find (pull ?b ?p) :in $ ?p :where [?b :block/title "zq Notes"]]
+                      "find: pull ?b: the pattern must be a literal vector"]
+                     ["a pattern that is a keyword" (form :block/title)
+                      "find: pull ?b: the pattern must be a literal vector"]
+                     ["a pull of a constant" '[:find (pull 1 [:block/title]) :where [?b :block/title "zq Notes"]]
+                      "find: pull 1: the pulled entity must be a ?variable"]
+                     ;; Datascript's own pattern errors, checked before anything runs.
+                     ["a limit on a single attribute" (form '[[:block/title :limit 5]])
+                      "find: pull ?b: Expected limit attribute having :db.cardinality/many, got: :block/title"]
+                     ["a limit on the reverse of a single attribute" (form '[(limit :block/_parent 5)])
+                      "find: pull ?b: Expected limit attribute having :db.cardinality/many, got: :block/parent"]
+                     ["an option with no value" (form '[[:block/title :as]])
+                      "find: pull ?b: Expected even number of opts"]
+                     ["an unknown option" (form '[[:block/title :sort 1]])
+                      "find: pull ?b: Expected one of :as, :limit, :default, :xform"]
+                     ["a nested pattern on a value attribute" (form '[{:block/title [:block/uuid]}])
+                      "find: pull ?b: Expected attribute having :db.type/ref"]]]
+          (p/doseq [[label q message] cases]
+            (p/let [before (snapshot conn)
+                    response (query! self q :inputs (when (some #{'?p} (flatten q)) '[[:block/title]]))]
+              (testing label
+                (is (refused? response message) (pr-str response))
+                (is (= before (snapshot conn)))
+                (is (false? (:private-set-built? @datalog/last-run)) "refused before the private set is built"))))
+          (is (some? find-notes)))))))
