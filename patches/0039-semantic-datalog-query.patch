+(deftest find-shapes-test
+  ;; Scalar, collection and aggregate finds go through the same sort, limit and byte cap as a relation.
+  (async done
+    (with-graph done
+      (fn [{:keys [self notes]}]
+        (p/let [_ (bulk! self notes 60 #(str "zq bulk " (pad2 %)))
+                _ (bulk! self notes 60 long-title)
+                where '[:where [?e :block/title ?t] [(clojure.string/starts-with? ?t "zq bulk")]]
+                long-where '[:where [?e :block/title ?t] [(clojure.string/starts-with? ?t "zq long")]]
+                shape (fn [find w & {:as more}] (apply query! self (vec (concat [:find] find w)) (mapcat identity more)))
+                relation (shape '[?t] where)
+                scalar (shape '[?t .] where)
+                collection (shape '[[?t ...]] where)
+                aggregate (shape '[?t (count ?e)] where)
+                long-relation (shape '[?t] long-where :limit 200)
+                long-scalar (shape '[?t .] long-where :limit 200)
+                long-collection (shape '[[?t ...]] long-where :limit 200)
+                long-aggregate (shape '[?t (count ?e)] long-where :limit 200)
+                cut (fn [r] (select-keys (:body r) [:total-rows :returned :truncated]))]
+          (testing "the limit cuts each shape alike"
+            (is (= [200 200 200 200] (map :status [relation scalar collection aggregate])))
+            (is (= (cut relation) (cut scalar) (cut collection)))
+            (is (= 50 (get-in relation [:body :returned])))
+            (is (= (get-in relation [:body :rows]) (get-in scalar [:body :rows]) (get-in collection [:body :rows])))
+            (is (= (mapv #(vector (str "zq bulk " (pad2 %)) 1) (range 50)) (get-in aggregate [:body :rows])))
+            (is (= (cut relation) (cut aggregate))))
+          (testing "the byte cap cuts each shape alike"
+            (is (= "byte-cap" (get-in long-relation [:body :truncated :by])))
+            (is (= (cut long-relation) (cut long-scalar) (cut long-collection)))
+            (is (= "byte-cap" (get-in long-aggregate [:body :truncated :by])))
+            (doseq [r [long-relation long-scalar long-collection long-aggregate]]
+              (is (<= (count (:text r)) 100000)))))))))
+
+(deftest serialisation-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self notes public-note public-plans]}]
+        (p/let [attrs (query! self '[:find ?a :where [?e :block/title "zq Notes"] [?e ?a]] :limit 200)
+                uuids (query! self '[:find ?u :where [?e :block/title "zq Notes"] [?e :block/uuid ?u]])
+                idents (query! self '[:find ?i :where [?c :db/ident ?i] [?c :block/title "Tag"]])
+                pulled (query! self '[:find (pull ?b [:block/uuid :block/page :block/parent])
+                                      :where [?b :block/title "zq Public note"]])
+                tags (query! self '[:find (pull ?p [:block/tags]) :where [?p :block/title "zq Public Plans"]])
+                notes-id (:db/id (d/entity @conn [:block/uuid notes]))
+                tag-ids (sort (map :db/id (:block/tags (d/entity @conn [:block/uuid public-plans]))))]
+          (testing "keywords come back as text without the colon"
+            (is (contains? (set (map first (get-in attrs [:body :rows]))) "block/title") (pr-str attrs))
+            (is (= [["logseq.class/Tag"]] (get-in idents [:body :rows])) (pr-str idents)))
+          (testing "uuids come back as text"
+            (is (= [[(str notes)]] (get-in uuids [:body :rows])) (pr-str uuids)))
+          (testing "refs come back as numbers"
+            (is (= [[{:block/uuid (str public-note) :block/page notes-id :block/parent notes-id}]]
+                   (get-in pulled [:body :rows]))
+                (pr-str pulled)))
+          (testing "a many ref comes back as a vector of numbers"
+            (is (= 2 (count tag-ids)) "Project and Page")
+            (is (= tag-ids (sort (get-in tags [:body :rows 0 0 :block/tags]))) (pr-str tags))))))))
