+;; Values that grow without reading data
+;; =====================================
+
+(defn- doubling-chain
+  "A query that calls `f` as (f ?vi ?vi) at each of `n` clauses, so each clause doubles the value
+  before it: it reads one datom and matches one row."
+  [f n]
+  (str "[:find ?v" n " . :where [?e :db/ident :logseq.class/Tag] [(identity ?e) ?v0] "
+       (string/join " " (for [i (range n)] (str "[(" f " ?v" i " ?v" i ") ?v" (inc i) "]")))
+       "]"))
+
+(defn- growth-message [f]
+  (str "where 3: " f " takes at most one ?variable (the other arguments literals), because joining"
+       " values can double one at every clause"))
+
+(deftest value-growth-refused-test
+  ;; 20 chained [(vector ?vi ?vi) ?vi+1] clauses (571 characters) read 1 datom and matched 1 row,
+  ;; but sorting and serialising the 2^20 leaves took 3 s and 865 MB; str and + double a string the
+  ;; same way. Every function that can build a value larger than its arguments is refused before
+  ;; the query runs: the collection constructors outright, and str, + and keyword when they join
+  ;; two or more variables.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self]}]
+        (p/let [before (snapshot conn)
+                constructors ["vector" "tuple" "list" "set" "hash-map" "array-map"]
+                joiners ["str" "+" "keyword"]
+                refused (p/all (for [f (concat constructors joiners)] (query! self (doubling-chain f 12))))
+                one-var (query! self '[:find ?s ?n ?k :where [?e :block/title "zq Notes"] [?e :block/title ?t]
+                                       [(str "<" ?t ">") ?s] [(count ?t) ?c] [(+ ?c 1 2) ?n]
+                                       [(keyword "zq" ?t) ?k]])]
+          (doseq [[f response] (map vector constructors refused)]
+            (testing (str f ": refused naming the function, never run")
+              (is (refused? response (str "where 3: function " f " is not allowed")) (pr-str (:status response) (:text response)))))
+          (doseq [[f response] (map vector joiners (drop (count constructors) refused))]
+            (testing (str f " with two variables: refused naming the clause")
+              (is (refused? response (growth-message f)) (pr-str (:status response) (:text response)))))
+          (testing "str, + and keyword with one variable and literals still run"
+            (is (= 200 (:status one-var)) (pr-str one-var))
+            (is (= "<zq Notes>" (ffirst (get-in one-var [:body :rows]))) (pr-str (:body one-var))))
+          (is (= before (snapshot conn))))))))
+
