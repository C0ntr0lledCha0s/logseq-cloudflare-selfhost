+(defn- capturing-console-error
+  "Runs `f` (returning a promise) with console.error recorded; resolves to [result errors]."
+  [f]
+  (let [original (.-error js/console)
+        errors (atom [])]
+    (aset js/console "error" (fn [& args] (swap! errors conj (pr-str args))))
+    (-> (p/let [result (f)] [result @errors])
+        (p/finally #(aset js/console "error" original)))))
+
+(defn- snapshot [conn]
+  {:max-tx (:max-tx @conn) :datoms (count (d/datoms @conn :eavt))})
+
+(deftest create-page-refuses-a-character-the-outliner-refuses-test
+  ;; The outliner refuses "/" (and "#") in a page title only once the write has started, which
+  ;; answered 500 "server error" with a console.error. createPage now refuses up front with 400.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn call]}]
+        (p/let [refused [["a/b" "/"]
+                         ["zq Plans/2026/Q4" "/"]
+                         ["[[zq x/y]]" "/"]
+                         ["  zq spaced/out  " "/"]
+                         ["zq a#b" "#"]]
+                before (snapshot conn)
+                [results errors] (capturing-console-error
+                                  #(p/all (map (fn [[title _]] (call "POST" "/pages" {:title title})) refused)))]
+          (doseq [[[title character] [status body]] (map vector refused results)]
+            (testing title
+              (is (= 400 status))
+              (is (= (str "title: a page title can't include \"" character "\" (" title ")") (:error body)))))
+          (is (= before (snapshot conn)) "nothing was written")
+          (is (empty? errors) "no console.error")
+          (testing "titles the outliner accepts are still created"
+            (p/let [[lead-status lead] (call "POST" "/pages" {:title "/zq lead"})
+                    [trail-status trail] (call "POST" "/pages" {:title "zq trail/"})
+                    [plain-status _] (call "POST" "/pages" {:title "zq plain"})
+                    [again-status again] (call "POST" "/pages" {:title "zq plain"})
+                    [date-status date] (call "POST" "/pages" {:title "11/17/2026"})]
+              (is (= [201 "zq lead"] [lead-status (:title lead)]) "boundary slashes are trimmed, as in the editor")
+              (is (= [201 "zq trail"] [trail-status (:title trail)]))
+              (is (= 201 plain-status))
+              (is (= 409 again-status) "a re-sent title is still a conflict, not a character refusal")
+              (is (string/includes? (:error again) "page \"zq plain\""))
+              (is (not= 400 date-status) (str "a date title keeps its slashes: " (pr-str date))))))))))
+
+(deftest create-page-character-check-keeps-other-errors-test
+  ;; Only the outliner's "/" and "#" notifications become the title's character 400. Another
+  ;; notification keeps its own message (as `rejecting` answers it elsewhere), and any other error
+  ;; stays a 500; nothing is written either way.
+  (async done
+    (let [original outliner-validate/validate-page-title-characters
+          mode (atom nil)]
+      (set! outliner-validate/validate-page-title-characters
+            (fn [title meta-m]
+              (case @mode
+                :error (throw (js/Error. "zq broken check"))
+                :other (throw (ex-info "zq other" {:type :notification
+                                                   :payload {:message "zq another refusal"
+                                                             :i18n-key :page.validation/name-blank}}))
+                (original title meta-m))))
+      (with-graph (fn [] (set! outliner-validate/validate-page-title-characters original) (done))
+        (fn [{:keys [conn call]}]
+          (p/let [before (snapshot conn)
+                  _ (reset! mode :error)
+                  [[error-status _] _] (capturing-console-error #(call "POST" "/pages" {:title "zq plain"}))
+                  _ (reset! mode :other)
+                  [other-status other] (call "POST" "/pages" {:title "zq plain"})
+                  _ (reset! mode nil)]
+            (is (= 500 error-status))
+            (is (= [400 "zq another refusal"] [other-status (:error other)]))
+            (is (= before (snapshot conn)) "nothing was written")))))))
