+                                         [(= ?tb "zq Notes")] (child ?a ?b)]
+                                  :rules '[[(child ?a ?b) [?a :block/parent ?b]]])
+                or-join (query! self '[:find ?ta ?tb :where [?a :block/title ?ta] [?b :block/title "zq Notes"]
