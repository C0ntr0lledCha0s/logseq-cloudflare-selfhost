diff --git a/deps/db-sync/test/logseq/db_sync/semantic_datalog_query_test.cljs b/deps/db-sync/test/logseq/db_sync/semantic_datalog_query_test.cljs
new file mode 100644
index 0000000..4cc58e6
--- /dev/null
+++ b/deps/db-sync/test/logseq/db_sync/semantic_datalog_query_test.cljs
@@ -0,0 +1,599 @@
+(ns logseq.db-sync.semantic-datalog-query-test
+  "Read-only Datalog over the semantic API (patch 0039, datalogQuery). POST /query reads the query,
+  inputs and rules as EDN (nothing is evaluated), refuses write forms, functions off the allow-list,
+  functions bound through inputs, sources other than $, undefined rules and cross products, each
+  naming the clause, and runs what passes on a d/filter view of the db that hides private content:
+  anything tagged with a class titled Private (any case) or a class extending one, the blocks on a
+  private page, every block under a private block, and any ref to one of those. Rows are sorted with
+  a type rank and cut to limit. E2EE graphs answer 409 before anything is parsed; dry-run answers the
+  EDN without building the private set or running the query.
+
+  Fixtures are written through the real handler: tags Private, Secret (extends Private), Hush
+  (extends Secret), Project and Topic; pages zq Public Plans (Project), zq Private Plans (Private),
+  zq Secret Plans (Secret, Project), zq Hush Plans (Hush, Project) and zq Notes. zq Private Plans
+  holds a block that refs zq Public Plans and a rating value; zq Notes holds zq Hidden note (tagged
+  Private) with a child tagged Topic, zq Public note with a child, and a block that refs zq Private
+  Plans. Every fixture title holds zq, so a query can pick them out."
+  (:require [cljs.test :refer [async deftest is testing]]
+            [clojure.string :as string]
+            [datascript.built-ins :as built-ins]
+            [datascript.core :as d]
+            [logseq.db-sync.test-sql :as test-sql]
+            [logseq.db-sync.worker.handler.datalog :as datalog]
+            [logseq.db-sync.worker.handler.sync :as sync-handler]
+            [logseq.db-sync.worker.routes.semantic :as semantic-routes]
+            [logseq.db.sqlite.export :as sqlite-export]
+            [logseq.outliner.property :as outliner-property]
+            [promesa.core :as p]))
+
+(defn- request!
+  "One semantic API request through the real handler; returns {:status :body :text}. With e2ee?,
+  the request carries graph-e2ee=true as the index's flag reaches the DO."
+  ([self method path body] (request! self method path body false))
+  ([self method path body e2ee?]
+   (p/let [url (str "http://localhost" path (if (string/includes? path "?") "&" "?") "graph-id=graph-1"
+                    (when e2ee? "&graph-e2ee=true"))
+           response (sync-handler/handle-http
+                     self
+                     (js/Request. url (clj->js (cond-> {:method method
+                                                        :headers {"content-type" "application/json"}}
+                                                 (some? body) (assoc :body (js/JSON.stringify (clj->js body)))))))
+           text (.text response)]
+     {:status (.-status response)
+      :text text
+      :body (when (seq text)
+              (try (js->clj (js/JSON.parse text) :keywordize-keys true)
+                   (catch :default _ text)))})))
+
+(defn- edn [form] (if (string? form) form (pr-str form)))
+
+(defn- query!
+  "POST /query with `form` (an EDN string, or a form printed as EDN) and the other body fields."
+  [self form & {:keys [inputs rules e2ee?] :as more}]
+  (request! self "POST" "/semantic/query"
+            (cond-> (merge {:query (edn form)} (dissoc more :inputs :rules :e2ee?))
+              (some? inputs) (assoc :inputs (edn inputs))
+              (some? rules) (assoc :rules (edn rules)))
+            e2ee?))
+
+(defn- snapshot
+  "What a refused call must leave unchanged: the graph's last tx and its datom count."
+  [conn]
+  {:max-tx (:max-tx @conn) :datoms (count (d/datoms @conn :eavt))})
+
+(defn- ok!
+  "`response` (or a promise of it), asserted to have `status`."
+  [response status]
+  (p/let [response response]
+    (assert (= status (:status response)) (pr-str response))
+    response))
+
+(defn- uuid-of [response] (uuid (get-in response [:body :uuid])))
+
+(defn- set-tags! [self id titles]
+  (ok! (request! self "PUT" (str "/semantic/blocks/" id "/properties/" (js/encodeURIComponent "block/tags"))
+                 {:value titles})
+       200))
+
+(defn- insert! [self target blocks]
+  (p/let [response (ok! (request! self "POST" "/semantic/block-trees" {:target-id (str target) :blocks blocks}) 201)]
+    (get-in response [:body :blocks])))
+
+(defn- title-of
+  "The title as stored: an entity's :block/title shows a ref's title, the datom holds its uuid."
+  [conn id]
+  (:v (first (d/datoms @conn :eavt (:db/id (d/entity @conn [:block/uuid id])) :block/title))))
+
+(defn- seed-graph
+  "A conn with the fixtures the namespace docstring names, and the handler context to call it
+  through."
+  []
+  (p/let [conn (sqlite-export/create-conn)
+          self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true}
+          tag! (fn [body] (p/let [r (ok! (request! self "POST" "/semantic/tags" body) 201)] (uuid-of r)))
+          page! (fn [title] (p/let [r (ok! (request! self "POST" "/semantic/pages" {:title title}) 201)] (uuid-of r)))
+          private-tag (tag! {:title "Private"})
+          _secret-tag (tag! {:title "Secret" :extends ["Private"]})
+          _hush-tag (tag! {:title "Hush" :extends ["Secret"]})
+          _project-tag (tag! {:title "Project"})
+          _topic-tag (tag! {:title "Topic"})
+          public-plans (page! "zq Public Plans")
+          private-plans (page! "zq Private Plans")
+          secret-plans (page! "zq Secret Plans")
+          hush-plans (page! "zq Hush Plans")
+          notes (page! "zq Notes")
+          _ (set-tags! self public-plans ["Project"])
+          _ (set-tags! self private-plans ["Private"])
+          _ (set-tags! self secret-plans ["Secret" "Project"])
+          _ (set-tags! self hush-plans ["Hush" "Project"])
+          [plan-block] (insert! self private-plans [{:title "zq private plan block, see [[zq Public Plans]]"}])
+          [hidden public-note see] (insert! self notes [{:title "zq Hidden note" :children [{:title "zq Hidden child"}]}
+                                                         {:title "zq Public note" :children [{:title "zq Public child"}]}
+                                                         {:title "zq See [[zq Private Plans]]"}])
+          _ (set-tags! self (:uuid hidden) ["Private"])
+          _ (set-tags! self (get-in hidden [:children 0 :uuid]) ["Topic"])
+          rating (outliner-property/upsert-property!
+                  conn nil {:logseq.property/type :default :db/cardinality :db.cardinality/one}
+                  {:property-name "rating"})
+          rating-path (js/encodeURIComponent (subs (str (:db/ident rating)) 1))
+          _ (ok! (request! self "PUT" (str "/semantic/blocks/" private-plans "/properties/" rating-path) {:value "zq five stars"}) 200)
+          _ (ok! (request! self "PUT" (str "/semantic/blocks/" public-plans "/properties/" rating-path) {:value "zq four stars"}) 200)]
+    {:conn conn :self self :private-tag private-tag
+     :public-plans public-plans :private-plans private-plans :secret-plans secret-plans
+     :hush-plans hush-plans :notes notes
+     :plan-block (uuid (:uuid plan-block)) :hidden (uuid (:uuid hidden))
+     :hidden-child (uuid (get-in hidden [:children 0 :uuid]))
+     :public-note (uuid (:uuid public-note)) :public-child (uuid (get-in public-note [:children 0 :uuid]))
+     :see (uuid (:uuid see)) :rating (:db/ident rating)}))
+
+(defn- with-graph [done run]
+  (-> (p/let [graph (seed-graph)] (run graph))
+      (p/catch #(is false (str % "\n" (.-stack %))))
+      (p/finally done)))
+
+(def ^:private private-titles
+  ["zq Private Plans" "zq Secret Plans" "zq Hush Plans" "zq private plan block" "zq Hidden note"
+   "zq Hidden child" "zq five stars"])
+
+(defn- leaks
+  "The private fixture titles that appear anywhere in `text`."
+  [text]
+  (filterv #(string/includes? text %) private-titles))
+
+(defn- refused?
+  "A 400 whose error holds every one of `parts`."
+  [response & parts]
+  (and (= 400 (:status response))
+       (every? #(string/includes? (str (get-in response [:body :error])) %) parts)))
+
+(def ^:private zq-titles '[:find ?t :where [?e :block/title ?t] [(clojure.string/includes? ?t "zq")]])
+
+;; Before patch 0039 there is no such route: every request below answers 404 {:error "not found"}.
+
+(deftest read-only-refusals-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self]}]
+        (let [cases [["transact! by name" "where 1: function transact! is not allowed (allowed: "
+                      {:form '[:find ?b :where [(transact! ?b)]]}]
+                     ["a namespaced transact!" "where 2: function datascript.core/transact! is not allowed"
+                      {:form '[:find ?b :where [?b :block/title ?t] [(datascript.core/transact! ?b)]]}]
+                     ["a function name given as a string" "where 2: \"transact!\" in function position is not a function name"
+                      {:form '[:find ?b :where [?b :block/title ?t] [("transact!" ?t)]]}]
+                     [":db/add in inputs" "inputs: :db/add is a write form; datalog_query is read-only"
+                      {:form '[:find ?t :in $ ?x :where [?e :block/title ?t]]
+                       :inputs '[[:db/add 1 :block/title "x"]]}]
+                     ["a nested :db/add in an inputs collection" "inputs: :db/add is a write form"
+                      {:form '[:find ?t :in $ [?x ...] :where [?e :block/title ?t] [(= ?t ?x)]]
+                       :inputs '[[[:db/add 1 :block/title "x"]]]}]
+                     ["a :db/id map in inputs" "inputs: a map with :db/id is a write form"
+                      {:form '[:find ?t :in $ ?x :where [?e :block/title ?t]]
+                       :inputs '[{:db/id 1 :block/title "x"}]}]
+                     [":db/retractEntity in the query" "query: :db/retractEntity is a write form; datalog_query is read-only"
+                      {:form '[:find ?e :where [?e :block/title :db/retractEntity]]}]
+                     [":db.fn/call in an or-join" "query: :db.fn/call is a write form"
+                      {:form '[:find ?e :where [?e :block/title ?t] (or-join [?e] [?e :db.fn/call ?t] [?e :block/name ?t])]}]
+                     [":db/add in a rule body" "rules: :db/add is a write form"
+                      {:form '[:find ?e :in $ % :where (w ?e)] :rules '[[(w ?e) [?e :db/add ?x]]]}]
+                     ["?f bound through inputs" "where 2: ?f is a variable in function position; functions can't be passed as inputs"
+                      {:form '[:find ?e :in $ ?f :where [?e :block/title ?t] [(?f ?t)]]
+                       :inputs '[clojure.core/identity]}]
+                     ["range" "where 2: function range is not allowed"
+                      {:form '[:find ?n :where [?e :block/title ?t] [(range 1000000) [?n ...]]]}]
+                     ["re-find" "where 2: function re-find is not allowed"
+                      {:form '[:find ?t :where [?e :block/title ?t] [(re-find "zq" ?t)]]}]
+                     ["rand" "where 2: function rand is not allowed"
+                      {:form '[:find ?e ?r :where [?e :block/title ?t] [(rand) ?r]]}]
+                     ["rand as an aggregate" "find: aggregate rand is not allowed"
+                      {:form '[:find (rand ?t) :where [?e :block/title ?t]]}]
+                     ["clojure.string/join" "where 2: function clojure.string/join is not allowed"
+                      {:form '[:find ?s :where [?e :block/title ?t] [(clojure.string/join ?t ?t) ?s]]}]
+                     ["re-find inside not-join" "where 2: function re-find is not allowed"
+                      {:form '[:find ?e :where [?e :block/title ?t] (not-join [?t] [(re-find "x" ?t)])]}]
+                     ["rand inside or" "where 2: function rand is not allowed"
+                      {:form '[:find ?e :where [?e :block/title ?t] (or [(rand) ?t] [?e :block/name ?t])]}]
+                     ["re-find in a rule body" "rules: rule bad clause 2: function re-find is not allowed"
+                      {:form '[:find ?e :in $ % :where (bad ?e)]
+                       :rules '[[(bad ?e) [?e :block/title ?t] [(re-find "x" ?t)]]]}]
+                     ["an input-bound aggregate" "find: ?f is a variable in function position"
+                      {:form '[:find (?f ?t) :in $ ?f :where [?e :block/title ?t]] :inputs '[count]}]]]
+          (p/doseq [[label message {:keys [form inputs rules]}] cases]
+            (p/let [before (snapshot conn)
+                    response (query! self form :inputs inputs :rules rules)]
+              (testing label
+                (is (refused? response message) (pr-str response))
+                (is (= before (snapshot conn)) "max-tx and the datom count are unchanged")
+                (is (false? (:private-set-built? @datalog/last-run)) "a refused call never builds the private set")))))))))
