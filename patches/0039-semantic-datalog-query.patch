+(deftest named-bounds-field-test
+  ;; namedQueryBounds is a test field on the Durable Object, read the way test-cap reads
+  ;; datalogScanCap: only known bound names with non-negative whole numbers; anything else is
+  ;; dropped, never a 500. No request can set it.
+  (let [defaults named-queries/default-bounds
+        bounds (fn [v] (datalog/named-bounds (if (= ::unset v) #js {} #js {:namedQueryBounds v})))]
+    (testing "the defaults, with nothing set"
+      (is (= defaults (bounds ::unset)))
+      (is (= defaults (datalog/named-bounds nil))))
+    (testing "a known name overrides its default"
+      (is (= (assoc defaults :tagged 3) (bounds #js {:tagged 3})))
+      (is (= (assoc defaults :ancestor-steps 0 :reads 7) (bounds #js {"ancestor-steps" 0 :reads 7}))))
+    (testing "unknown names, strings, negatives, fractions and non-numbers are dropped"
+      (is (= (assoc defaults :tagged 3)
+             (bounds #js {:tagged 3 :bogus 5 :meetings "7" :decisions -1 :tasks 2.5 :open-tasks nil
+                          :page-blocks true :reads #js [1]}))))
+    (testing "a field that is not an object gives the defaults"
+      (doseq [v ["tagged" 3 #js [3] true]]
+        (is (= defaults (bounds v)) (pr-str v))))
+    (testing "the default bounds, as the release bundle set them (stage 5)"
+      (is (= {:meetings 2000 :decisions 10000 :ancestor-steps 10000 :tagged 2500 :page-blocks 10000
+              :tasks 10000 :open-tasks 2000 :reads 30000}
+             defaults)))))
