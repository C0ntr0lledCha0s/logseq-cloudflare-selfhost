+(deftest named-guards-test
+  ;; Rules no other test pins (found by the stage's mutation step): a tag param that is itself
+  ;; private hides its datoms, as the private filter did; a private Task class hides every task; no
+  ;; meeting in the window reads no decision; and a decision on a page without a meeting is walked
+  ;; up to its page (as the Datalog's above rule walked every decision), deciding nothing.
+  (async done
+    (with-named done
+      (fn [{:keys [conn self]}]
+        (p/let [_ (ok! (request! self "POST" "/semantic/tags" {:title "zq Hidden Kind"}) 201)
+                hidden-kind (ffirst (d/q '[:find ?u :where [?e :block/title "zq Hidden Kind"] [?e :block/uuid ?u]] @conn))
+                kind-page (page-id! self "zq kind page")
+                _ (set-tags! self kind-page ["zq Hidden Kind"])
+                _ (set-tags! self hidden-kind ["Private"])
+                hidden-tag (named! self "pages-missing-property" {:params {:tag "zq Hidden Kind" :property "forClient"}})
+                hidden-tag-parity (parity! conn self "private tag" [["pages-missing-property" {:tag "zq Hidden Kind" :property "forClient"}]])
+                _ (ok! (request! self "POST" "/semantic/tags" {:title "zq Empty Meet"}) 201)
+                empty-window (named! self "meetings-without-decision" {:params {:meeting_tag "zq Empty Meet"}})
+                empty-work (:named-work @datalog/last-run)
+                before (named! self "meetings-without-decision" nil)
+                before-work (:named-work @datalog/last-run)
+                elsewhere (page-id! self "zq No Meeting")
+                _ (insert! self elsewhere [(chain (mapv #(str "zq elsewhere " %) (range 5)) [(tagged-block "zq elsewhere decision" ["Decision"])])])
+                after (named! self "meetings-without-decision" nil)
+                after-work (:named-work @datalog/last-run)
+                private-tag-id (ffirst (d/q '[:find ?e :where [?e :block/title "Private"] [?e :block/tags ?c] [?c :db/ident :logseq.class/Tag]] @conn))
+                _ (d/transact! conn [[:db/add (d/entid @conn :logseq.class/Task) :block/tags private-tag-id]])
+                tasks (named! self "open-tasks-by-client" nil)]
+          (testing "a private tag given as the tag param matches nothing, as the Datalog's filter hid its datoms"
+            (is (= [200 []] [(:status hidden-tag) (get-in hidden-tag [:body :rows])]) (head-of hidden-tag))
+            (is (= [0] hidden-tag-parity)))
+          (testing "no meeting in the window answers at once, reading no decision"
+            (is (= [200 []] [(:status empty-window) (get-in empty-window [:body :rows])]) (head-of empty-window))
+            (is (= [0 0 0] (mapv #(get empty-work % 0) [:meetings :decisions :ancestor-steps])) (pr-str empty-work)))
+          (testing "a decision on a page with no meeting is walked up its 5 blocks and its page, and decides nothing"
+            (is (= (get-in before [:body :rows]) (get-in after [:body :rows])))
+            (is (= (inc (:decisions before-work)) (:decisions after-work)) (pr-str [before-work after-work]))
+            (is (= (+ 6 (:ancestor-steps before-work)) (:ancestor-steps after-work)) (pr-str [before-work after-work])))
+          (testing "a private Task class hides every task (the Datalog, over the filter, couldn't even resolve
+                    :logseq.class/Task, and answered 400)"
+            (is (= [200 []] [(:status tasks) (get-in tasks [:body :rows])]) (head-of tasks))))))))
