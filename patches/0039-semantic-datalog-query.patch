+      (fn [{:keys [self]}]
+        (p/let [unbound (query! self '[:find ?t :where [(clojure.string/starts-with? ?t "zq")] [?e :block/title ?t]])]
+          (is (refused? unbound "query: Insufficient bindings: #{?t} not bound in [(clojure.string/starts-with? ?t")
+              (pr-str unbound)))))))
+
+(deftest pull-keeps-db-id-test
+  ;; :db/id as a pull attribute is a read, not the :db/id map a write would send.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self notes]}]
+        (p/let [response (query! self '[:find (pull ?e [:db/id :block/title]) :where [?e :block/title "zq Notes"]])]
+          (is (= [200 [[{:db/id (:db/id (d/entity @conn [:block/uuid notes])) :block/title "zq Notes"}]]]
+                 [(:status response) (get-in response [:body :rows])])
+              (pr-str response)))))))
+
+(deftest private-page-without-parent-chain-test
+  ;; A block whose :block/page is private is hidden even when its :block/parent chain doesn't reach
+  ;; the page (a stale page ref, as an uploaded graph can hold): the page rule, not only the
+  ;; descendant walk, hides it.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self private-plans public-note]}]
+        (d/transact! conn [{:block/uuid (random-uuid) :block/title "zq stale private block"
+                            :block/page [:block/uuid private-plans] :block/parent [:block/uuid public-note]
+                            :block/order "a1" :block/created-at 1 :block/updated-at 1}])
+        (p/let [response (query! self zq-titles :limit 200)]
+          (is (= 200 (:status response)) (pr-str response))
+          (is (not (string/includes? (:text response) "zq stale private block")) (:text response)))))))
+
+
+;; Caps (stage 2): the scan cap, bounded pulls and the byte cap
+;; =============================================================
+
+(defn- cap-message [n]
+  (str "query stopped after scanning " n " datoms (the scan cap); narrow it with a tag, page or attribute value,"
+       " or use a named query"))
+
+(defn- set-scan-cap!
+  "The test-only scan cap the handler reads from the Durable Object (`self`), in place of the
+  constant; nil restores the constant. No request can set it."
+  [self n]
+  (unchecked-set self "datalogScanCap" n))
+
+(defn- bulk!
+  "`n` blocks under `parent`, titled by `title-fn` of their index, in one block-trees batch."
+  [self parent n title-fn]
+  (insert! self parent (vec (for [i (range n)] {:title (title-fn i)}))))
+
+(defn- pad2 [i] (.padStart (str i) 2 "0"))
+
+(defn- value-cap-message []
+  (str "query rows hold more than 20,000 values inside collections (the value cap, which counts each character"
+       " of text as a value); return the parts you need rather than the whole collection, or narrow the query"))
+
+(deftest value-cap-test
+  ;; A collection from inputs, bound to a variable that every row returns, is printed once per row
+  ;; by the sort and the serialiser. Past the value cap (items inside the rows' collections, nested
+  ;; ones included, and each character of text inside them, all rows together) the query answers
+  ;; 422 before the sort. Inputs are at most 4,000 characters, so each case below fits in them and
+  ;; reaches the cap only through the 40 rows that repeat it.
+  (async done
+    (with-graph done
+      (fn [{:keys [self notes]}]
+        (p/let [_ (bulk! self notes 40 #(str "zq vc " (pad2 %)))
+                q '[:find ?t ?x :in $ ?x :where [?e :block/title ?t] [(clojure.string/starts-with? ?t "zq vc")]
+                    [(get-else $ ?e :block/uuid ?x) ?u]]
+                text (apply str (repeat 3000 "y"))
+                cases [["600 numbers (24,000 in all)" [(vec (repeat 600 0))]]
+                       ["20 vectors of 30 numbers (800 at the top level, 24,800 in all)" [(vec (repeat 20 (vec (repeat 30 0))))]]
+                       ["a map of 10 keys to vectors of 50 numbers" [(into {} (for [i (range 10)] [i (vec (repeat 50 0))]))]]
+                       ["a set of 600 numbers" [(set (range 600))]]
+                       ["one string of 3,000 characters" [[text]]]
+                       ["one keyword of 3,000 characters" [[(keyword text)]]]
+                       ["one symbol of 3,000 characters" [[(symbol text)]]]
+                       ["a string of 3,000 characters nested two deep" [[[text]]]]]
+                over (p/all (for [[_ inputs] cases] (query! self q :inputs inputs)))
+                under (query! self q :inputs [(vec (range 10))])
+                short-text (query! self q :inputs [(vec (repeat 10 "zq"))])
+                one-row (query! self '[:find ?x . :in $ ?x :where [?e :block/title "zq Notes"]
+                                       [(get-else $ ?e :block/uuid ?x) ?u]]
+                                :inputs [(vec (repeat 600 0))])
+                one-row-text (query! self '[:find ?x . :in $ ?x :where [?e :block/title "zq Notes"]
+                                            [(get-else $ ?e :block/uuid ?x) ?u]]
+                                     :inputs [[text]])]
+          (doseq [[[label inputs] response] (map vector cases over)]
+            (testing (str label ", repeated across 40 rows, answers 422 naming the cap")
+              (is (<= (count (pr-str inputs)) 4000) label)
+              (is (= [422 (value-cap-message)] [(:status response) (get-in response [:body :error])])
+                  (pr-str (:status response) (subs (:text response) 0 (min 300 (count (:text response))))))))
+          (testing "the same query with a small collection, and a large one in one row, answer"
+            (is (= [200 40] [(:status under) (get-in under [:body :total-rows])]) (pr-str (:status under)))
+            (is (= [200 40] [(:status short-text) (get-in short-text [:body :total-rows])]) (pr-str (:status short-text)))
+            (is (= [200 1] [(:status one-row) (get-in one-row [:body :total-rows])]) (pr-str (:status one-row)))
+            (is (= [200 1] [(:status one-row-text) (get-in one-row-text [:body :total-rows])]) (pr-str (:status one-row-text)))))))))
+
+(defn- one-by-one!
+  "Runs each of `thunks` (each a function returning a promise of a response) after the one before
+  has answered, so each elapsed time is its own; the responses, each with :ms."
+  [thunks]
+  (reduce (fn [acc thunk]
+            (p/let [responses acc
+                    start (.now js/Date)
+                    response (thunk)]
+              (conj responses (assoc response :ms (- (.now js/Date) start)))))
+          (p/resolved [])
+          thunks))
+
+(defn- head-of [response]
+  (pr-str (:status response) (:ms response) "ms" (subs (str (:text response)) 0 (min 300 (count (str (:text response)))))))
+
+(def ^:private collection-takers
+  "and, contains?, count, empty?, false?, get, get-else, get-some, ground, identical?, identity, missing?, nil?, not, not-empty, or, some?, true?, type and untuple")
+
+(defn- collection-message [f]
+  (str "function " f " was given a collection from inputs, which it would print or walk whole once per joined row"
+       " (only " collection-takers " take one); bind its items with [?x ...] in :in, or test membership with"
+       " (contains? ?x ?v)"))
+
+(defn- aggregate-collection-message [f]
+  (str "aggregate " f " was given a collection from inputs, which it would print or walk whole once per row"
+       " (only count, count-distinct and distinct take one); bind its items with [?x ...] in :in"))
+
+(defn- ca-query
+  "A query over the `zq ca` blocks that binds the collection inputs `colls` (symbols) to every row
+  through get-else, finds `find` and adds `more` where clauses."
+  [find colls more]
+  (vec (concat [:find] find [:in '$] colls
+               [:where '[?e :block/title ?t] '[(clojure.string/starts-with? ?t "zq ca ")]]
+               (for [[i c] (map-indexed vector colls)] [(list 'get-else '$ '?e :block/uuid c) (symbol (str "?u" i))])
+               more)))
+
+(def ^:private collection-taker-cases
+  "Each function that may take a collection, with clauses that give it one and bind ?n."
+  [["count" '[[(count ?x) ?n]]]
+   ["contains?" '[[(contains? ?x 0)] [(count ?x) ?n]]]
+   ["get" '[[(get ?x 0) ?n]]]
+   ["empty?" '[[(empty? ?x) ?n]]]
+   ["not-empty" '[[(not-empty ?x) ?y] [(count ?y) ?n]]]
+   ["identity" '[[(identity ?x) ?y] [(count ?y) ?n]]]
+   ["ground" '[[(ground ?x) ?y] [(count ?y) ?n]]]
+   ["untuple" '[[(untuple ?x) ?y] [(count ?y) ?n]]]
+   ["get-else" '[[(get-else $ ?e :block/title ?x) ?y] [(count ?y) ?n]]]
+   ["get-some" '[[(get-some $ ?e :block/title ?x) ?y] [(count ?y) ?n]]]
+   ["nil?" '[[(nil? ?x) ?n]]]
+   ["some?" '[[(some? ?x)] [(count ?x) ?n]]]
+   ["true?" '[[(true? ?x) ?n]]]
+   ["false?" '[[(false? ?x) ?n]]]
+   ["identical?" '[[(identical? ?x ?x) ?n]]]
+   ["type" '[[(type ?x) ?y] [(some? ?y) ?n]]]
+   ["and" '[[(and ?x true) ?n]]]
+   ["or" '[[(or ?x false) ?y] [(count ?y) ?n]]]
+   ["not" '[[(not ?x) ?n]]]])
+
+(deftest collection-arguments-refused-test
+  ;; A collection from inputs, given to a function that prints or walks it (str, arithmetic,
+  ;; comparison, the string functions), costs its size once per joined row: [(str ?x) ?s] over
+  ;; 1,900 numbers on 2,400 blocks took about 2 s, and 3.6 s with :find ?s . on 7,000 blocks before
+  ;; the join cap fired, while the value cap counts only the collections the rows return. Any
+  ;; function given one answers 422 naming it, unless it only looks into one; aggregates other
+  ;; than count, count-distinct and distinct refuse collection values the same way.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self notes]}]
+        (p/let [_ (bulk! self notes 2400 #(str "zq ca " %))
+                before (snapshot conn)
+                big [(vec (repeat 1900 0))]
+                pair [(vec (repeat 950 0)) (vec (repeat 950 0))]
+                one (fn [label f clause & {:keys [find] :or {find '[?t ?s]}}]
+                      [label (collection-message f) (ca-query find '[?x] [clause]) big])
+                two (fn [f clause] [(str f " on two collections") (collection-message f) (ca-query '[?t] '[?x ?y] [clause]) pair])
+                agg (fn [f] [(str "aggregate " f) (aggregate-collection-message f)
+                             (ca-query ['?t (list f '?x)] '[?x] []) big])
+                cases [(one "str in :find ?t ?s" "str" '[(str ?x) ?s])
+                       (one "str in :find ?s ." "str" '[(str ?x) ?s] :find '[?s .])
+                       (one "keyword" "keyword" '[(keyword ?x) ?s])
+                       (one "+" "+" '[(+ ?x 1) ?s])
+                       (one "-" "-" '[(- ?x 1) ?s])
+                       (one "*" "*" '[(* ?x 2) ?s])
+                       (one "/" "/" '[(/ ?x 2) ?s])
+                       (one "inc" "inc" '[(inc ?x) ?s])
+                       (one "dec" "dec" '[(dec ?x) ?s])
+                       (one "max" "max" '[(max ?x 1) ?s])
+                       (one "min" "min" '[(min ?x 1) ?s])
+                       (one "quot" "quot" '[(quot ?x 2) ?s])
+                       (one "rem" "rem" '[(rem ?x 2) ?s])
+                       (one "mod" "mod" '[(mod ?x 2) ?s])
+                       (one "pos?" "pos?" '[(pos? ?x)] :find '[?t])
+                       (one "neg?" "neg?" '[(neg? ?x)] :find '[?t])
+                       (one "blank?" "clojure.string/blank?" '[(clojure.string/blank? ?x)] :find '[?t])
+                       (one "index-of" "clojure.string/index-of" '[(clojure.string/index-of ?x "1") ?s])
+                       (one "last-index-of" "clojure.string/last-index-of" '[(clojure.string/last-index-of ?x "1") ?s])
+                       (two "=" '[(= ?x ?y)])
+                       (two "not=" '[(not= ?x ?y)])
+                       (two "compare" '[(compare ?x ?y) ?s])
+                       (two "<" '[(< ?x ?y)])
+                       (two "-differ?" '[(-differ? ?x ?y)])
+                       (agg 'sum) (agg 'avg) (agg 'median) (agg 'variance) (agg 'stddev) (agg 'min) (agg 'max)]
+                refused (one-by-one! (for [[_ _ q inputs] cases] #(query! self q :inputs inputs)))
+                takers (one-by-one!
+                        (for [[_ clauses] collection-taker-cases]
+                          #(query! self (ca-query '[?t ?n] '[?x] clauses) :inputs big)))
+                counted (query! self (ca-query '[?t (count ?x) (count-distinct ?x)] '[?x] []) :inputs big)
+                missing (query! self '[:find ?n :in $ ?x :where [?e :block/title "zq Notes"] [(missing? $ ?e :block/uuid ?x) ?n]]
+                                :inputs big)
+                gathered (query! self (ca-query '[(distinct ?x)] '[?x] []) :inputs big)
+                items (query! self '[:find (count ?v) (count-distinct ?v) (sum ?v) :in $ [?v ...]
+                                     :where [?e :block/title "zq Notes"] [(get-else $ ?e :block/uuid ?v) ?u]]
+                              :inputs [(vec (range 900))])
+                outside (d/q '[:find ?s . :in $ ?x :where [(str ?x) ?s]] @conn [1 2])
+                outside-sum (d/q '[:find (sum ?x) . :in $ [?x ...]] @conn [[1 2]])]
+          (doseq [[[label message _ inputs] response] (map vector cases refused)]
+            (testing (str label ": 422 naming the function, under 500 ms")
+              (is (<= (count (pr-str inputs)) 4000) label)
+              (is (= [422 message] [(:status response) (get-in response [:body :error])]) (head-of response))
+              (is (< (:ms response) 500) (head-of response))))
+          (doseq [[[f] response] (map vector collection-taker-cases takers)]
+            (testing (str f " still takes a collection")
+              (is (= [200 2400] [(:status response) (get-in response [:body :total-rows])]) (head-of response))))
+          (testing "missing? still takes a collection (on one block: missing? on all 2,400 reaches the scan cap)"
+            (is (= [200 [[false]]] [(:status missing) (get-in missing [:body :rows])]) (head-of missing)))
+          (testing "count and count-distinct still take collection values, and distinct gathers them"
+            (is (= [200 2400] [(:status counted) (get-in counted [:body :total-rows])]) (head-of counted))
+            (is (= [200 [[[(vec (repeat 1900 0))]]]] [(:status gathered) (get-in gathered [:body :rows])]) (head-of gathered)))
+          (testing "count, count-distinct and sum over items bound with [?v ...] answer"
+            (is (= [200 [[900 900 404550]]] [(:status items) (get-in items [:body :rows])]) (head-of items)))
+          (testing "outside the handler Datascript calls the functions as before"
+            (is (= "[1 2]" outside))
+            (is (= "0[1 2]" outside-sum) (pr-str outside-sum)))
+          (is (= before (snapshot conn))))))))
+
+(defn- text-cap-message [n]
+  (str "query stopped after functions built " n " characters of text (the text cap); return the values"
+       " themselves rather than text built from them, or narrow the query"))
+
+(defn- set-text-cap!
+  "The test-only text cap the handler reads from the Durable Object (`self`), in place of the
+  constant; nil restores the constant. No request can set it."
+  [self n]
+  (unchecked-set self "datalogTextCap" n))
+
+(def ^:private pass-through-cases
+  "Each function or aggregate that passes a value through, with :find, clauses over the ten
+  `zq bound` titles (?e, ?t) and the rows it answers."
+  [["identity" '[?y] '[[(identity ?t) ?y]] 10]
+   ["ground" '[?y] '[[(ground ?t) ?y]] 10]
+   ["untuple" '[?y] '[[(untuple ?t) ?y]] 10]
+   ["get" '[?t ?y] '[[(get ?t 0) ?y]] 10]
+   ["get-else" '[?y] '[[(get-else $ ?e :block/title "") ?y]] 10]
+   ["get-some" '[?y] '[[(get-some $ ?e :block/title) [?a ?y]]] 10]
+   ["not-empty" '[?y] '[[(not-empty ?t) ?y]] 10]
+   ["the max aggregate" '[(max ?t)] '[] 1]
+   ["the min aggregate" '[(min ?t)] '[] 1]])
+
+(deftest text-cap-test
+  ;; Text a function builds costs its length once per joined row: str, keyword, subs, + and the
+  ;; case and trim functions over a 3,990-character input on 1,400 blocks build 5.6 million
+  ;; characters. Every character a function or aggregate returns counts toward the text cap of
+  ;; 5,000,000 per query; past it the query stops with 422. Functions that pass a value through
+  ;; (identity, ground, untuple, get, get-else, get-some, not-empty, max, min) build none.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self notes]}]
+        (p/let [_ (bulk! self notes 1400 #(str "zq tc " %))
+                _ (bulk! self notes 10 #(str "zq bound " %))
+                before (snapshot conn)
+                text (apply str (repeat 1995 "aB"))
+                tc (fn [find clauses] (vec (concat [:find] find '[:in $ ?x :where [?e :block/title ?t]
+                                                                 [(clojure.string/starts-with? ?t "zq tc ")]
+                                                                 [(get-else $ ?e :block/uuid ?x) ?u]]
+                                                   clauses)))
+                cases [["str" '[[(str ?x) ?s]]]
+                       ["keyword" '[[(keyword ?x) ?s]]]
+                       ["subs" '[[(subs ?x 1) ?s]]]
+                       ["+ on text" '[[(+ ?x "!") ?s]]]
+                       ["lower-case" '[[(clojure.string/lower-case ?x) ?s]]]
+                       ["upper-case" '[[(clojure.string/upper-case ?x) ?s]]]
+                       ["capitalize" '[[(clojure.string/capitalize ?x) ?s]]]
+                       ["trim" '[[(clojure.string/trim ?x) ?s]]]]
+                over (one-by-one! (concat (for [[_ clauses] cases] #(query! self (tc '[?t ?s] clauses) :inputs [text]))
+                                          [#(query! self (tc '[?t (sum ?x)] []) :inputs [text])]))
+                short (query! self '[:find ?t ?l :where [?e :block/title ?t] [(clojure.string/starts-with? ?t "zq tc ")]
+                                     [(clojure.string/lower-case ?t) ?l]])
+                bound '[:find ?l :where [?e :block/title ?t] [(clojure.string/starts-with? ?t "zq bound ")]
+                        [(clojure.string/lower-case ?t) ?l]]
+                _ (set-text-cap! self 100)
+                at-cap (query! self bound)
+                _ (set-text-cap! self 99)
+                over-cap (query! self bound)
+                passed (query! self '[:find ?g ?i :where [?e :block/title ?t] [(clojure.string/starts-with? ?t "zq bound ")]
+                                      [(get-else $ ?e :block/title "") ?g] [(identity ?t) ?i]])
+                _ (set-text-cap! self 0)
+                pass-through (one-by-one!
+                              (for [[_ find clauses] pass-through-cases]
+                                #(query! self (vec (concat [:find] find '[:where [?e :block/title ?t]
+                                                                          [(clojure.string/starts-with? ?t "zq bound ")]]
+                                                           clauses)))))
+                _ (set-text-cap! self nil)]
+          (is (<= (count (pr-str [text])) 4000))
+          (doseq [[label response] (map vector (concat (map first cases) ["(sum ?x) over text"]) over)]
+            (testing (str label ": 422 naming the text cap, under 500 ms")
+              (is (= [422 (text-cap-message "5,000,000")] [(:status response) (get-in response [:body :error])])
+                  (head-of response))
+              (is (< (:ms response) 500) (head-of response))))
+          (testing "lower-casing short titles answers"
+            (is (= [200 1400] [(:status short) (get-in short [:body :total-rows])]) (head-of short)))
+          (testing "ten 10-character titles build exactly 100 characters: they answer at a cap of 100"
+            (is (= [200 10] [(:status at-cap) (get-in at-cap [:body :total-rows])]) (head-of at-cap)))
+          (testing "and stop at a cap of 99"
+            (is (= [422 (text-cap-message "99")] [(:status over-cap) (get-in over-cap [:body :error])]) (head-of over-cap)))
+          (testing "get-else and identity pass values through and build no text"
+            (is (= [200 10] [(:status passed) (get-in passed [:body :total-rows])]) (head-of passed)))
+          (doseq [[[label _ _ rows] response] (map vector pass-through-cases pass-through)]
+            (testing (str label " builds no text: it answers at a text cap of 0")
+              (is (= [200 rows] [(:status response) (get-in response [:body :total-rows])]) (head-of response))))
+          (is (= before (snapshot conn))))))))
+
+(def ^:private pathological-text
+  "3,990 spaces and then x: a regex like /[\\s\\xa0]+$/ retries the run of spaces from every start,
+  so a function backed by one costs the square of its length."
+  (str (apply str (repeat 3990 " ")) "x"))
+
+(def ^:private string-fn-clauses
+  "A clause per allowed clojure.string function, calling it on ?x. A function added to the
+  allow-list without a clause here fails string-functions-linear-test."
+  {'clojure.string/blank? '[(clojure.string/blank? ?x)]
+   'clojure.string/includes? '[(clojure.string/includes? ?x "y")]
+   'clojure.string/starts-with? '[(clojure.string/starts-with? ?x "y")]
+   'clojure.string/ends-with? '[(clojure.string/ends-with? ?x "y")]
+   'clojure.string/lower-case '[(clojure.string/lower-case ?x) ?s]
+   'clojure.string/upper-case '[(clojure.string/upper-case ?x) ?s]
+   'clojure.string/capitalize '[(clojure.string/capitalize ?x) ?s]
+   'clojure.string/index-of '[(clojure.string/index-of ?x "y") ?s]
+   'clojure.string/last-index-of '[(clojure.string/last-index-of ?x "y") ?s]
+   'clojure.string/trim '[(clojure.string/trim ?x) ?s]
+   'clojure.string/trim-newline '[(clojure.string/trim-newline ?x) ?s]
+   'clojure.string/triml '[(clojure.string/triml ?x) ?s]
+   'clojure.string/trimr '[(clojure.string/trimr ?x) ?s]})
+
+(deftest string-functions-linear-test
+  ;; cljs trimr is goog.string.trimRight, str.replace(/[\s\xa0]+$/, ""): on 3,990 spaces and then x
+  ;; the regex retries the run from every start, so 300 rows took 3.3 s (11.8 s for 1,111 rows on
+  ;; 5,000 blocks) and the text cap only stopped it after about 13 s. Inside a query trimr is
+  ;; String.prototype.trimEnd, which trims the same characters (JavaScript's \s includes \xa0) in
+  ;; one pass. Every allowed clojure.string function runs on that input, one row per block, within
+  ;; 500 ms.
+  (async done
+    (with-graph done
+      (fn [{:keys [self notes]}]
+        (p/let [_ (bulk! self notes 300 #(str "zq lin " %))
+                fns (sort-by str (filter #(= "clojure.string" (namespace %)) datalog/allowed-fns))
+                responses (one-by-one!
+                           (for [f fns :let [clause (get string-fn-clauses f)] :when clause]
+                             #(query! self [:find '?t :in '$ '?x :where '[?e :block/title ?t]
+                                            '[(clojure.string/starts-with? ?t "zq lin ")]
+                                            '[(get-else $ ?e :block/uuid ?x) ?u] clause]
+                                      :inputs [pathological-text])))
+                trimmed (one-by-one!
+                         (for [text ["ab  " "ab \t \n" "  ab" "ab" "   "]]
+                           #(query! self '[:find ?s . :in $ ?x :where [?e :block/title "zq Notes"]
+                                           [(get-else $ ?e :block/uuid ?x) ?u] [(clojure.string/trimr ?x) ?s]]
+                                    :inputs [text])))]
+          (is (<= (count (pr-str [pathological-text])) 4000))
+          (testing "every allowed clojure.string function has a case, so one added later is timed here"
+            (is (= (set fns) (set (keys string-fn-clauses)))))
+          (doseq [[f response] (map vector fns responses)]
+            (testing (str f " on 3,990 spaces and x, over 300 rows: answers within 500 ms")
+              (is (= 200 (:status response)) (head-of response))
+              (is (< (:ms response) 500) (head-of response))))
+          (testing "trimr still trims trailing whitespace, a no-break space included, and nothing else"
+            (is (= [["ab"] ["ab"] ["  ab"] ["ab"] [""]]
+                   (mapv #(get-in % [:body :rows 0]) trimmed))
+                (pr-str (mapv head-of trimmed)))))))))
+
+(defn- format-n [n] (.toLocaleString n "en-US"))
+
+(defn- call-cap-message [n]
+  (str "query stopped after " n " function calls (the call cap); each function or predicate clause runs once per"
+       " joined row, so narrow the rows with a tag, page or attribute value first, or use fewer clauses"))
+
+(defn- set-call-cap!
+  "The test-only call cap the handler reads from the Durable Object (`self`), in place of the
+  constant; nil restores the constant. No request can set it."
+  [self n]
+  (unchecked-set self "datalogCallCap" n))
+
+(deftest call-cap-test
+  ;; Predicates build nothing, so neither the text cap nor the join cap counted them: 105
+  ;; [(clojure.string/includes? ?x "a")] clauses on a 3,990-character ?x, over 5,000 rows, made
+  ;; 525,000 calls and answered 200. Every call of a function, predicate or aggregate counts
+  ;; toward the call cap (20,000 per query); past it the query stops with 422.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self notes]}]
+        (p/let [_ (bulk! self notes 5000 #(str "zq cc " %))
+                before (snapshot conn)
+                text (str (apply str (repeat 3989 "b")) "a")
+                many (vec (concat '[:find (count ?e) . :in $ ?x :where [?e :block/title ?t]
+                                    [(clojure.string/starts-with? ?t "zq cc ")] [(get-else $ ?e :block/uuid ?x) ?u]]
+                                  (repeat 105 '[(clojure.string/includes? ?x "a")])))
+                [over] (one-by-one! [#(query! self many :inputs [text])])
+                over-run @datalog/last-run
+                few (query! self '[:find (count ?e) . :where [?e :block/title ?t] [(clojure.string/starts-with? ?t "zq cc 1")]])
+                few-calls (:calls @datalog/last-run)
+                bound '[:find ?t :where [?e :block/title ?t] [(clojure.string/starts-with? ?t "zq cc 1")]
+                        [(clojure.string/ends-with? ?t "1")]]
+                uncapped (query! self bound)
+                calls (:calls @datalog/last-run)
+                _ (set-call-cap! self calls)
+                at-cap (query! self bound)
+                _ (set-call-cap! self (dec calls))
+                over-cap (query! self bound)
+                _ (set-call-cap! self nil)]
+          (is (<= (count (pr-str many)) 4000) (str (count (pr-str many))))
+          (testing "105 predicate clauses over 5,000 rows stop at the call cap, quickly"
+            (is (= [422 (call-cap-message "20,000")] [(:status over) (get-in over [:body :error])]) (head-of over))
+            (is (= 20001 (:calls over-run)) "it stops at the first call past the cap")
+            (is (< (:ms over) 500) (head-of over)))
+          (testing "one predicate over the graph's titles answers, and its calls are counted"
+            (is (= 200 (:status few)) (head-of few))
+            (is (< 5000 few-calls 20000) (pr-str few-calls)))
+          (testing "a query that makes exactly the cap's calls answers, and one call over answers 422"
+            (is (= 200 (:status uncapped)) (head-of uncapped))
+            (is (= [200 (get-in uncapped [:body :rows])] [(:status at-cap) (get-in at-cap [:body :rows])]) (head-of at-cap))
+            (is (= [422 (call-cap-message (format-n (dec calls)))] [(:status over-cap) (get-in over-cap [:body :error])])
+                (head-of over-cap)))
+          (is (= before (snapshot conn))))))))
+
+(defn- work-cap-message [n]
+  (str "query stopped after " n " rows of relation work (the work cap): each not, not-join, or and or-join"
+       " joins, subtracts or sums every row bound so far, so narrow the rows first with a tag, page or attribute"
+       " value, or use fewer such clauses"))
+
+(defn- set-work-cap!
+  "The test-only work cap the handler reads from the Durable Object (`self`), in place of the
+  constant; nil restores the constant. No request can set it."
+  [self n]
+  (unchecked-set self "datalogWorkCap" n))
+
+(defn- clauses-str [n clause] (string/join " " (repeat n clause)))
+
+(deftest work-cap-test
+  ;; not, not-join, or-join and rule calls join, subtract and sum whole relations (hash-join,
+  ;; subtract-rel, sum-rel, prod-rel). When their inner clauses match nothing, nothing goes through
+  ;; join-tuples, reads a datom or calls a function, so the scan, join and call caps stayed still:
+  ;; 155 (not [?e :block/tags 0]) over 5,000 rows took 403 ms, 300 negated rule calls 1.1 s, and
+  ;; nots nested through rules 10 x 10 x 10 2.8 s (10 x 10 x 10 x 10: 26 s). Every relation
+  ;; operation charges the rows it walks to the work cap (200,000 per query) while a query runs,
+  ;; and past it the query stops with 422. A query takes no rules (caller-rules-refused-test), so
+  ;; the rule cases those times came from no longer run at all.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self notes]}]
+        (p/let [_ (bulk! self notes 5000 #(str "zq rw " %))
+                before (snapshot conn)
+                head "[:find (count ?e) . :where [?e :block/title ?t] "
+                cases [["155 flat nots" (str head (clauses-str 155 "(not [?e :block/tags 0])") "]") nil]
+                       ["110 not-joins" (str head (clauses-str 110 "(not-join [?e] [?e :block/tags 0])") "]") nil]
+                       ["65 negated or-joins whose branches match nothing"
+                        (str head (clauses-str 65 "(not (or-join [?e] [?e :block/tags 0] [?e :block/refs 0]))") "]") nil]]
+                refused (one-by-one! (for [[_ q] cases] #(query! self q)))
+                ordinary (one-by-one!
+                          [#(query! self '[:find (count ?e) . :where [?e :block/title ?t] [(clojure.string/starts-with? ?t "zq rw 1")]
+                                           (not [?e :block/tags ?x] [?x :block/title "Topic"])])
+                           #(query! self '[:find (count ?e) . :where [?e :block/title ?t] [(clojure.string/starts-with? ?t "zq rw 1")]
+                                           (or-join [?e] [?e :block/parent ?p] (not [?e :block/tags 0]))])])
+                small '[:find ?t :where [?e :block/title ?t] [(clojure.string/starts-with? ?t "zq rw 10")]
+                        (not [?e :block/tags 0]) (or-join [?e] [?e :block/tags 0] (not [?e :block/tags 0]))]
+                uncapped (query! self small)
+                work (:work @datalog/last-run)
+                _ (set-work-cap! self work)
+                at-cap (query! self small)
+                _ (set-work-cap! self (dec work))
+                over-cap (query! self small)
+                _ (set-work-cap! self nil)]
+          (doseq [[[label q] response] (map vector cases refused)]
+            (testing (str label ": 422 naming the work cap, within 500 ms")
+              (is (<= (count q) 4000) (str label " " (count q)))
+              (is (= [422 (work-cap-message "200,000")] [(:status response) (get-in response [:body :error])])
+                  (head-of response))
+              (is (< (:ms response) 500) (head-of response))))
+          (testing "ordinary not and or-join queries still answer"
+            (doseq [response ordinary]
+              (is (= [200 1111] [(:status response) (get-in response [:body :rows 0 0])]) (head-of response))))
+          (testing "a query whose relation work is exactly the cap answers, and one row over answers 422"
+            (is (= [200 111] [(:status uncapped) (get-in uncapped [:body :total-rows])]) (head-of uncapped))
+            (is (< 0 work 200000) (pr-str work))
+            (is (= [200 111] [(:status at-cap) (get-in at-cap [:body :total-rows])]) (head-of at-cap))
+            (is (= [422 (work-cap-message (format-n (dec work)))] [(:status over-cap) (get-in over-cap [:body :error])])
+                (head-of over-cap)))
+          (is (= before (snapshot conn))))))))
+
+(defn- rule-tree
+  "EDN rules for a tree `levels` deep with `fanout` branches per level: (r<levels> ?e) expands to
+  fanout^levels leaves, each `leaf` (clauses matching nothing), without reading a datom."
+  [levels fanout leaf]
+  (str "[[(r0 ?e) " leaf "] "
+       (string/join " " (for [k (range 1 (inc levels)) _ (range fanout)] (str "[(r" k " ?e) (r" (dec k) " ?e)]")))
+       "]"))
+
+(deftest caller-rules-refused-test
+  ;; A tree of caller rules expands without reading data: 10^5 leaves took 5.5 s, and the work cap
+  ;; stopped larger trees only after about 10 s, blocking the graph's sync the whole time
+  ;; (docs/spikes/2026-11-09-safe-caller-datalog-queries.md). datalog_query takes no rules: a body
+  ;; with rules, % in :in, a rule call and a :rules key in the query each answer 400 at once,
+  ;; naming the field and run_named_query, before anything runs.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self notes]}]
+        (p/let [_ (bulk! self notes 5000 #(str "zq rc " %))
+                before (snapshot conn)
+                tree-q "[:find (count ?e) . :in $ % :where [?e :block/title ?t] (r4 ?e)]"
+                deep-q "[:find (count ?e) . :in $ % :where [?e :block/title ?t] (r5 ?e)]"
+                nots-q (str "[:find (count ?e) . :in $ % :where [?e :block/title ?t] " (clauses-str 10 "(not (r ?e))") "]")
+                nots-rules (str "[[(r ?e) " (clauses-str 10 "(not (s ?e))") " [?e :block/tags 0]]"
+                                " [(s ?e) " (clauses-str 10 "(not [?e :block/tags 0])") " [?e :block/tags 0]]]")
+                tagged "[[(tagged ?e ?tag) [?e :block/tags ?c] [?c :block/title ?tag]]]"
+                body-cases [["a 4-level rule tree, fanout 10 (10^4 two-clause leaves)"
+                             #(query! self tree-q :rules (rule-tree 4 10 "[?e :block/title ?x] [?e :block/tags 0]"))]
+                            ["a 5-level rule tree, fanout 10, with one-clause leaves (10^5 leaves)"
+                             #(query! self deep-q :rules (rule-tree 5 10 "[?e :block/tags 0]"))]
+                            ["nots nested through rules, 10 x 10 x 10" #(query! self nots-q :rules nots-rules)]
+                            ["an ordinary rule" #(query! self "[:find ?t :in $ % :where (tagged ?e \"Project\") [?e :block/title ?t]]"
+                                                         :rules tagged)]
+                            ["empty rules and no %" #(query! self zq-titles :rules "[]")]
+                            ["rules that aren't EDN text" #(request! self "POST" "/semantic/query" {:query (edn zq-titles) :rules ["x"]})]
+                            ["rules with dry-run" #(query! self tree-q :rules tagged :dry-run true)]]
+                query-cases [["% in :in without rules" ":in: % is not accepted; "
+                              #(query! self "[:find ?t :in $ % :where [?e :block/title ?t]]")]
+                             ["% after an input" ":in: % is not accepted; "
+                              #(query! self "[:find ?t :in $ ?x % :where [?e :block/title ?x] [?e :block/title ?t]]" :inputs "[\"zq Notes\"]")]
+                             ["% in the map form's :in" ":in: % is not accepted; "
+                              #(query! self "{:find [?t] :in [$ %] :where [[?e :block/title ?t]]}")]
+                             ["a rule call without %" "where 2: (linked …) calls a rule; "
+                              #(query! self "[:find ?t :where [?e :block/title ?t] (linked ?e)]")]
+                             ["a rule call inside not" "where 2: (r …) calls a rule; "
+                              #(query! self "[:find ?t :where [?e :block/title ?t] (not (r ?e))]")]
+                             ["a rule call inside an or-join branch" "where 2: (r …) calls a rule; "
+                              #(query! self "[:find ?t :where [?e :block/title ?t] (or-join [?e] (r ?e) [?e :block/name ?n])]")]
+                             ["a rule call inside an or branch" "where 2: (r …) calls a rule; "
+                              #(query! self "[:find ?t :where [?e :block/title ?t] (or (r ?e) [?e :block/name \"zq Notes\"])]")]
+                             ["a rule call inside and inside or" "where 2: (r …) calls a rule; "
+                              #(query! self "[:find ?t :where [?e :block/title ?t] (or (and (r ?e)) [?e :block/name \"zq Notes\"])]")]
+                             ["a rule call inside not-join" "where 2: (r …) calls a rule; "
+                              #(query! self "[:find ?t :where [?e :block/title ?t] (not-join [?e] (r ?e))]")]
+                             ["a rule call with the source $" "where 2: (linked …) calls a rule; "
+                              #(query! self "[:find ?t :where [?e :block/title ?t] ($ linked ?e)]")]
+                             ["a rule call as the only clause" "where 1: (linked …) calls a rule; "
+                              #(query! self "[:find ?e :where (linked ?e)]")]
+                             ["% and a rule call together" ":in: % is not accepted; "
+                              #(query! self "[:find ?t :in $ % :where [?e :block/title ?t] (linked ?e)]")]
+                             ["a :rules key in the map form" "query: :rules is not a query key; "
+                              #(query! self "{:find [?t] :rules [] :where [[?e :block/title ?t]]}")]]
+                body-refused (one-by-one! (map second body-cases))
+                query-refused (one-by-one! (map #(nth % 2) query-cases))
+                last-run @datalog/last-run]
+          (doseq [[[label] response] (map vector body-cases body-refused)]
+            (testing (str label ": 400 naming the rules field and run_named_query, within 100 ms")
+              (is (= [400 (no-rules-message "rules: not accepted; ")] [(:status response) (get-in response [:body :error])])
+                  (head-of response))
+              (is (< (:ms response) 100) (head-of response))))
+          (doseq [[[label prefix] response] (map vector query-cases query-refused)]
+            (testing (str label ": 400 naming the clause and run_named_query")
+              (is (refused? response (no-rules-message prefix)) (head-of response))
+              (is (< (:ms response) 100) (head-of response))))
+          (testing "no refusal describes rules walking ancestors or names a rule depth"
+            (doseq [response (concat body-refused query-refused)
+                    gone ["ancestor" "vetted rules" "walks up" "levels deep" "rule cap"]]
+              (is (not (string/includes? (get-in response [:body :error]) gone)) gone)))
+          (testing "nothing ran: no private set built, no datom scanned, nothing written"
+            (is (= {:private-set-built? false :scanned 0} (select-keys last-run [:private-set-built? :scanned])))
+            (is (= before (snapshot conn))))
+          (testing "queries without rules that the refusal could catch still answer 200: not, not-join, or,
+                    or-join with and, a get-some step up, inputs after $, a collection binding, a re-send"
+            (p/let [ok (one-by-one!
+                        (for [[q inputs] [["[:find ?t :where [?e :block/title ?t] [(clojure.string/includes? ?t \"zq Notes\")] (not [?e :block/tags 0])]"]
+                                          ["[:find ?t :where [?e :block/title ?t] [(clojure.string/includes? ?t \"zq Notes\")] (not-join [?e] [?e :block/tags 0])]"]
+                                          ["[:find ?t :where [?e :block/name \"zq notes\"] [?e :block/title ?t] (or [?e :block/tags 0] [?e :block/name \"zq notes\"])]"]
+                                          ["[:find ?t :where [?e :block/name \"zq notes\"] [?e :block/title ?t] (or-join [?e] (and [?e :block/name ?n] [(some? ?n)]) [?e :block/tags 0])]"]
+                                          ["[:find ?pt :where [?b :block/title \"zq Public note\"] [(get-some $ ?b :block/page) [_ ?p]] [?p :block/title ?pt]]"]
+                                          ["[:find ?t :in $ ?n :where [?e :block/name ?n] [?e :block/title ?t]]" "[\"zq notes\"]"]
+                                          ["[:find ?t :in $ [?n ...] :where [?e :block/name ?n] [?e :block/title ?t]]" "[[\"zq notes\"]]"]
+                                          ["[:find ?t :in $ [?n ...] :where [?e :block/name ?n] [?e :block/title ?t]]" "[[\"zq notes\"]]"]]]
+                          #(query! self q :inputs inputs)))]
+              (doseq [response ok]
+                (is (= 200 (:status response)) (head-of response))
+                (is (= [["zq Notes"]] (get-in response [:body :rows])) (head-of response))))))))))
+
+(deftest no-rule-hook-test
+  ;; Only the named queries had rules, and they run as code now (patch 0039 stage 3), so nothing
+  ;; wraps Datascript's rule-gen-guards and a query counts no rule work.
+  (async done
+    (with-graph done
+      (fn [{:keys [self]}]
+        (let [before dq/rule-gen-guards]
+          (testing "rule-gen-guards is Datascript's own, not a wrapper from this patch"
+            (is (not (string/includes? (str before) "db_sync")) (str before)))
+          (p/let [response (query! self zq-titles)
+                  run @datalog/last-run
+                  named (request! self "POST" "/semantic/named-queries/pages-missing-property"
+                                  {:params {:tag "Project" :property "rating"}})]
+            (is (= 200 (:status response)) (head-of response))
+            (is (contains? #{200 400} (:status named)) (head-of named))
+            (testing "a query leaves rule-gen-guards as it found it, and last-run counts no rule work"
+              (is (identical? before dq/rule-gen-guards))
+              (is (contains? run :work) (pr-str run))
+              (is (not (contains? run :rule-work)) (pr-str run)))))))))
+
+(deftest work-charges-test
+  ;; Each relation operation charges the rows it walks, so each is pinned by a query whose work
+  ;; comes from it, with the row counts read back through the handler: T entities with a title and
+  ;; U with a uuid.
+  ;; - a join of two patterns: one hash-join of T and U rows;
+  ;; - (not [?e :block/tags 0]): a hash-join of T rows with the empty match, then subtract-rel of
+  ;;   the empty match from T rows;
+  ;; - [(identity ?e) ?x]: per row a prod-rel of 1 by 1 row, then sum-rel adding T-1 single rows to
+  ;;   the vector it grows (which it reuses, uncharged).
+  (async done
+    (with-graph done
+      (fn [{:keys [self]}]
+        (p/let [run (fn [q] (p/let [r (query! self q)] [(:status r) (get-in r [:body :rows 0 0]) (:work @datalog/last-run)]))
+                [_ t title-work] (run '[:find (count ?e) . :where [?e :block/title ?t]])
+                [_ u uuid-work] (run '[:find (count ?e) . :where [?e :block/uuid ?u]])
+                joined (run '[:find (count ?e) . :where [?e :block/title ?t] [?e :block/uuid ?u]])
+                negated (run '[:find (count ?e) . :where [?e :block/title ?t] (not [?e :block/tags 0])])
+                bound (run '[:find (count ?e) . :where [?e :block/title ?t] [(identity ?e) ?x]])]
+          (testing "one pattern does no relation work"
+            (is (= [0 0] [title-work uuid-work])))
+          (is (< 100 t u) (pr-str [t u]))
+          (testing "a join charges both relations"
+            (is (= [200 t (+ t u)] joined)))
+          (testing "a not charges its join and its subtraction"
+            (is (= [200 t (* 2 t)] negated)))
+          (testing "a function binding charges its products and its sums"
+            (is (= [200 t (dec (* 3 t))] bound))))))))
+
+(deftest scan-cap-test
+  ;; About 49,000 datoms added through the real outliner put the graph above the 20,000 scan cap
+  ;; (set from scripts/bench-datalog-query.mjs).
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self notes]}]
+        (p/let [_ (bulk! self notes 7000 #(str "zq filler " %))
+                before (snapshot conn)
+                _ (assert (> (:datoms before) 20000) (pr-str before))
+                everything (query! self '[:find ?e ?a ?v :where [?e ?a ?v]])
+                scanned (:scanned @datalog/last-run)
+                ;; Every title datom is read (under the scan cap); 1,111 rows match (under the row cap).
+                titles (query! self '[:find ?b :where [?b :block/title ?t] [(clojure.string/starts-with? ?t "zq filler 1")]])]
+          (testing "an unconstrained query over a graph above the cap answers 422 naming the cap, never 500"
+            (is (= [422 (cap-message "20,000")] [(:status everything) (get-in everything [:body :error])])
+                (pr-str (:status everything) (subs (:text everything) 0 (min 300 (count (:text everything))))))
+            (is (= 20001 scanned) "it stops at the first datom past the cap")
+            (is (= before (snapshot conn))))
+          (testing "a query under the cap on the same graph still answers rows"
+            (is (= [200 1111] [(:status titles) (get-in titles [:body :total-rows])]) (pr-str (:status titles)))
+            (is (= 50 (get-in titles [:body :returned])))))))))
+
+(deftest scan-cap-exact-test
+  ;; The cap counts every datom the filter is asked about across the whole query, kept or dropped.
+  (async done
+    (with-graph done
+      (fn [{:keys [self private-plans]}]
+        (p/let [q '[:find ?t :where [?p :block/title "zq Notes"] [?b :block/parent ?p] [?b :block/title ?t]]
+                uncapped (query! self q)
+                scanned (:scanned @datalog/last-run)
+                _ (set-scan-cap! self scanned)
+                at-cap (query! self q)
+                _ (set-scan-cap! self (dec scanned))
+                over-cap (query! self q)
+                over-scanned (:scanned @datalog/last-run)
+                _ (set-scan-cap! self nil)
+                private-only '[:find ?t :in $ ?u :where [?e :block/uuid ?u] [?e :block/title ?t]]
+                hidden (query! self private-only :inputs (str "[#uuid \"" private-plans "\"]"))
+                hidden-scanned (:scanned @datalog/last-run)
+                _ (set-scan-cap! self 0)
+                hidden-capped (query! self private-only :inputs (str "[#uuid \"" private-plans "\"]"))
+                _ (set-scan-cap! self nil)]
+          (is (= 200 (:status uncapped)) (pr-str uncapped))
+          (is (> scanned 3) "the three clauses scan more than one datom each between them")
+          (testing "a query that scans exactly the cap answers its rows"
+            (is (= [200 (get-in uncapped [:body :rows])] [(:status at-cap) (get-in at-cap [:body :rows])]) (pr-str at-cap)))
+          (testing "one datom over the cap answers 422 naming the cap"
+            (is (= [422 (cap-message (str (dec scanned)))] [(:status over-cap) (get-in over-cap [:body :error])])
+                (pr-str over-cap))
+            (is (= scanned over-scanned)))
+          (testing "datoms the private filter drops count too"
+            (is (= [200 []] [(:status hidden) (get-in hidden [:body :rows])]) (pr-str hidden))
+            (is (pos? hidden-scanned))
+            (is (= [422 (cap-message "0")] [(:status hidden-capped) (get-in hidden-capped [:body :error])])
+                (pr-str hidden-capped))))))))
+
+(deftest scan-cap-is-per-request-test
+  (async done
+    (with-graph done
+      (fn [{:keys [self]}]
+        (p/let [first-run (query! self zq-titles :limit 200)
+                scanned (:scanned @datalog/last-run)
+                _ (set-scan-cap! self scanned)
+                second-run (query! self zq-titles :limit 200)
+                third-run (query! self zq-titles :limit 200)
+                _ (set-scan-cap! self nil)]
+          (is (= 200 (:status first-run)))
+          (testing "two calls in a row, each under the cap, both answer rows: the count starts again per request"
+            (is (= [200 200] [(:status second-run) (:status third-run)]) (pr-str third-run))
+            (is (= (get-in first-run [:body :rows]) (get-in third-run [:body :rows])))))))))
