+        (is (string/includes? (:description post) "bind fewer values with functions or narrow the rows first"))
+        (is (string/includes? (:description post) "return extra attributes with (pull ?b [...]) in :find"))
+        (is (string/includes? (:description post) (str "at most " datalog/max-fn-bindings " function bindings")))
+        (is (string/includes? (get-in post [:responses "422" :description] "")
+                              (str "had function bindings copy more than " n " values (the width cap)")))))
+    (testing "no rule cap, rule depth or ancestor walk is described: datalog_query takes no rules"
+      (doseq [text [(:description post) (get-in post [:responses "422" :description] "")
+                    (get-in post [:responses "400" :description] "")]
