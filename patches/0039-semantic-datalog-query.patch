+;; Named queries (POST /named-queries/:name, runNamedQuery)
+;; =========================================================
+;; Before stage 4 there is no such route: every request below answers 404 {:error "not found"}.
+
+(def ^:private day-ms 86400000)
+
+(defn- named!
+  "POST /named-queries/`query-name` with `body` (a map, or nil for no body)."
+  ([self query-name body] (named! self query-name body false))
+  ([self query-name body e2ee?]
+   (request! self "POST" (str "/semantic/named-queries/" query-name) body e2ee?)))
+
+(defn- age!
+  "Fixture time: sets `attr` of the entities with `uuids` to `days` days ago, the way an entity
+  written that long ago holds it. The API stamps every write with now, so a stale page can only be
+  made by moving its stamp."
+  [conn attr days uuids]
+  (let [at (- (.now js/Date) (* days day-ms))]
+    (d/transact! conn (vec (for [u uuids] [:db/add [:block/uuid (uuid (str u))] attr at])))))
+
+(defn- row-titles
+  "The :block/title of the pulled column `col` of each row, in row order."
+  [response col]
+  (mapv #(get-in % [col :block/title]) (get-in response [:body :rows])))
+
+(defn- seed-named
+  "Fixtures for the named queries, written through the real handler (only stamps are moved, by
+  age!): tags Private, Project, Client Project (extends Project), Business Meeting, Decision and
+  Key Decision (extends Decision); a node property forClient; project pages, meetings as pages and
+  as blocks, and tasks with every status and client placement."
+  []
+  (p/let [conn (sqlite-export/create-conn)
+          self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true}
+          tag! (fn [body] (p/let [r (ok! (request! self "POST" "/semantic/tags" body) 201)] (uuid-of r)))
+          page! (fn [title] (p/let [r (ok! (request! self "POST" "/semantic/pages" {:title title}) 201)] (uuid-of r)))
+          task! (fn [title page status]
+                  (p/let [r (ok! (request! self "POST" "/semantic/tasks" {:title title :page-id (str page) :status status}) 201)]
+                    (uuid-of r)))
+          _ (tag! {:title "Private"})
+          project-tag (tag! {:title "Project"})
+          _ (tag! {:title "Client Project" :extends ["Project"]})
+          _ (tag! {:title "Business Meeting"})
+          _ (tag! {:title "Decision"})
+          _ (tag! {:title "Key Decision" :extends ["Decision"]})
+          for-client (ok! (request! self "POST" "/semantic/properties" {:title "forClient" :type "node"}) 201)
+          for-client-path (js/encodeURIComponent (get-in for-client [:body :ident]))
+          client! (fn [id client]
+                    (ok! (request! self "PUT" (str "/semantic/blocks/" id "/properties/" for-client-path) {:value client}) 200))
+          _ (page! "zq Acme")
+          _ (page! "zq Beta")
+          ;; Projects
+          stale (page! "zq Stale Project")
+          [stale-block] (insert! self stale [{:title "zq stale notes"}])
+          fresh-child (page! "zq Fresh Child Project")
+          [fresh-child-block] (insert! self fresh-child [{:title "zq fresh child notes"}])
+          fresh (page! "zq Fresh Project")
+          client-project (page! "zq Stale Client Project")
+          private-project (page! "zq Stale Private Project")
+          project-block-page (page! "zq Project Blocks")
+          [project-block] (insert! self project-block-page [{:title "zq stale project block"}])
+          _ (set-tags! self stale ["Project"])
+          _ (set-tags! self fresh-child ["Project"])
+          _ (set-tags! self fresh ["Project"])
+          _ (set-tags! self client-project ["Client Project"])
+          _ (set-tags! self private-project ["Project" "Private"])
+          _ (set-tags! self (:uuid project-block) ["Project"])
+          _ (client! fresh "zq Acme")
+          ;; Meetings
+          undecided (page! "zq Meeting Undecided")
+          _ (insert! self undecided [{:title "zq agenda"}])
+          decided (page! "zq Meeting Decided")
+          [deep] (insert! self decided [{:title "zq discussion" :children [{:title "zq detail" :children [{:title "zq ship it"}]}]}])
+          old-meeting (page! "zq Old Meeting")
+          log (page! "zq Meeting Log")
+          [standup retro other-decision key-meeting]
+          (insert! self log [{:title "zq standup" :children [{:title "zq notes" :children [{:title "zq agreed"}]}]}
+                             {:title "zq retro" :children [{:title "zq went well"}]}
+                             {:title "zq unrelated decision"}
+                             {:title "zq planning" :children [{:title "zq key call"}]}])
+          _ (set-tags! self undecided ["Business Meeting"])
+          _ (set-tags! self decided ["Business Meeting"])
+          _ (set-tags! self old-meeting ["Business Meeting"])
+          _ (set-tags! self (get-in deep [:children 0 :children 0 :uuid]) ["Decision"])
+          _ (set-tags! self (:uuid standup) ["Business Meeting"])
+          _ (set-tags! self (get-in standup [:children 0 :children 0 :uuid]) ["Decision"])
+          _ (set-tags! self (:uuid retro) ["Business Meeting"])
+          _ (set-tags! self (:uuid other-decision) ["Decision"])
+          _ (set-tags! self (:uuid key-meeting) ["Business Meeting"])
+          _ (set-tags! self (get-in key-meeting [:children 0 :uuid]) ["Key Decision"])
+          ;; Tasks
+          client-work (page! "zq Client Work")
+          other-work (page! "zq Other Work")
+          _ (client! client-work "zq Acme")
+          own (task! "zq task own client" client-work "todo")
+          _ (client! own "zq Beta")
+          _ (task! "zq task page client" client-work "doing")
+          _ (task! "zq task done" client-work "done")
+          _ (task! "zq task canceled" client-work "canceled")
+          _ (task! "zq task no client" other-work "todo")]
+    ;; Stamps last, so no later write moves them.
+    (age! conn :block/updated-at 60 [stale (:uuid stale-block) fresh-child client-project private-project
+                                     (:uuid project-block)])
+    (age! conn :block/created-at 100 [old-meeting])
+    {:conn conn :self self :project-tag project-tag :fresh-child-block (:uuid fresh-child-block) :other-work other-work
+     :undecided undecided :retro (:uuid retro)
+     :for-client (get-in for-client [:body :ident])}))
+
+(defn- with-named [done run]
+  (-> (p/let [graph (seed-named)] (run graph))
+      (p/catch #(is false (str % "\n" (.-stack %))))
+      (p/finally done)))
+
+(def ^:private names
+  ["projects-untouched" "meetings-without-decision" "open-tasks-by-client" "pages-missing-property"])
