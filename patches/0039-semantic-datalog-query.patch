+(defn- deep-chain!
+  "A chain of `n` blocks on `page`, each the only child of the one before, titled `prefix` and its
+  level; the top block is tagged `meeting` and the deepest (`n` levels down the page) `decision`.
+  Returns the top block's title."
+  [self page prefix n meeting decision]
+  (p/let [tree (reduce (fn [child i] (cond-> {:title (str prefix " " i)} child (assoc :children [child])))
+                       nil (reverse (range n)))
+          [top] (insert! self page [tree])
+          deepest (loop [b top] (if-let [c (first (:children b))] (recur c) b))
+          _ (set-tags! self (:uuid top) [meeting])
+          _ (set-tags! self (:uuid deepest) [decision])]
+    (:title top)))
+
+(defn- tag-pairs! [self titles]
+  (reduce (fn [acc title] (p/let [_ acc] (ok! (request! self "POST" "/semantic/tags" {:title title}) 201)))
+          (p/resolved nil) titles))
+
+(defn- meetings! [self meeting decision]
+  (named! self "meetings-without-decision"
+          {:params {:meeting_tag meeting :decision_tag decision :days 3650} :limit 200}))
+
+
+;; Named queries as code (stage 1): counted index reads, named bounds and a lazy private?
+;; ======================================================================================
+
+(defn- walk-ctx
+  "A named-query context over `db`: the default bounds with `overrides`, and no work yet."
+  ([db] (walk-ctx db {}))
+  ([db overrides]
+   {:db db :query "test-walk" :bounds (merge named-queries/default-bounds overrides) :work (volatile! {})}))
+
+(defn- work [ctx k] (get @(:work ctx) k 0))
+
+(defn- bound-data
+  "The ::bound data `f` throws, or :no-throw."
+  [f]
+  (try (f) :no-throw
+       (catch :default e (or (::named-queries/bound (ex-data e)) [:other (ex-message e)]))))
+
+(defn- prng
+  "A seeded generator of ints below n (mulberry32), so a failing graph can be rebuilt from its seed."
+  [seed]
+  (let [state (volatile! (bit-or seed 0))]
+    (fn [n]
+      (let [t (vswap! state #(bit-or (+ % 0x6D2B79F5) 0))
+            t (js/Math.imul (bit-xor t (unsigned-bit-shift-right t 15)) (bit-or t 1))
+            t (bit-xor t (+ t (js/Math.imul (bit-xor t (unsigned-bit-shift-right t 7)) (bit-or t 61))))
+            u (unsigned-bit-shift-right (bit-xor t (unsigned-bit-shift-right t 14)) 0)]
+        (mod u n)))))
+
+(defn- random-tree
+  "Block maps for one block-trees insert: `n` blocks at most `depth` deep, shaped by `rand`."
+  [rand prefix n depth]
+  (let [counter (volatile! 0)
+        node (fn node [d]
+               (let [i (vswap! counter inc)
+                     kids (if (and (< d depth) (< @counter n)) (rand 3) 0)]
+                 (cond-> {:title (str prefix " " i)}
+                   (pos? kids) (assoc :children (vec (keep (fn [_] (when (< @counter n) (node (inc d)))) (range kids)))))))]
+    (loop [acc []] (if (< @counter n) (recur (conj acc (node 1))) acc))))
+
+(defn- tree-uuids [blocks]
+  (mapcat (fn [b] (cons (uuid (:uuid b)) (tree-uuids (:children b)))) blocks))
+
+(defn- seed-random-graph
+  "A graph shaped by `seed`, written through the real handler: tags (a private one titled Private,
+  PRIVATE or private by seed, Secret extending it, Hush extending Secret, and two ordinary ones),
+  four pages with random block trees, random tags on pages and blocks, blocks moved to another
+  page, a page moved to the Recycle bin (deletePage), a deleted block (delete_block retracts it and
+  its children, so it is simply gone), and one block whose :block/page is set apart from its
+  parent chain (a stale page ref, as an uploaded graph can hold: the API keeps them in step)."
+  [seed]
+  (let [rand (prng seed)
+        private-title (["Private" "PRIVATE" "private"] (mod seed 3))
+        tags [private-title "zq Secret" "zq Hush" "zq Topic" "zq Project"]]
+    (p/let [conn (sqlite-export/create-conn)
+            self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true}
+            tag! (fn [body] (ok! (request! self "POST" "/semantic/tags" body) 201))
+            _ (tag! {:title private-title})
+            _ (tag! {:title "zq Secret" :extends [private-title]})
+            _ (tag! {:title "zq Hush" :extends ["zq Secret"]})
+            _ (tag! {:title "zq Topic"})
+            _ (tag! {:title "zq Project"})
+            pages (p/all (for [i (range 4)]
+                           (p/let [r (ok! (request! self "POST" "/semantic/pages" {:title (str "zq page " seed " " i)}) 201)]
+                             (uuid-of r))))
+            trees (p/all (for [[i page] (map-indexed vector pages)]
+                           (insert! self page (random-tree rand (str "zq b" seed "-" i) (+ 8 (rand 12)) 4))))
+            blocks (vec (mapcat tree-uuids trees))
+            nodes (into (vec pages) blocks)
+            ;; One write at a time: the outliner's writes on one conn don't interleave.
+            _ (reduce (fn [acc _]
+                        (p/let [_ acc] (set-tags! self (nodes (rand (count nodes))) [(tags (rand (count tags)))])))
+                      (p/resolved nil) (range (+ 3 (rand 5))))
+            first-ids (mapv (comp uuid :uuid first) trees)
+            move! (fn [block target]
+                    (ok! (request! self "POST" "/semantic/block-moves"
+                                   {:block-ids [(str block)] :target-id (str target) :position "last-child"})
+                         200))
+            ;; The last block of page 0's tree to the first top-level block of page 1, and of page 2's to page 3's.
+            _ (move! (last (tree-uuids (nth trees 0))) (first-ids 1))
+            _ (move! (last (tree-uuids (nth trees 2))) (first-ids 3))
+            _ (ok! (request! self "DELETE" (str "/semantic/pages/" (pages (rand 4))) nil) 200)
+            _ (ok! (request! self "DELETE" (str "/semantic/blocks/" (blocks (rand (count blocks)))) nil) 200)
+            ;; delete_block retracts the block and its children; the stale ref's parent is one that's left.
+            left (filterv #(d/entity @conn [:block/uuid %]) blocks)]
+      (d/transact! conn [{:block/uuid (random-uuid) :block/title (str "zq stale page ref " seed)
+                          :block/page [:block/uuid (pages (rand 4))] :block/parent [:block/uuid (left (rand (count left)))]
+                          :block/order "a0" :block/created-at 1 :block/updated-at 1}])
+      {:conn conn :self self})))
+
+(deftest private-fn-matches-private-ids-test
+  ;; private? decides one entity at a time, walking up :block/parent and :block/page; private-ids
+  ;; walks down from every root. They must agree on every entity, or a named query leaks what
+  ;; datalog_query hides (or hides what it shows).
+  (async done
+    (-> (reduce
+         (fn [acc seed]
+           (p/let [_ acc
+                   {:keys [conn]} (seed-random-graph seed)]
+             (let [db @conn
+                   expected (datalog/private-ids db)
+                   ctx (walk-ctx db {:reads 10000000})
+                   private? (named-queries/private-fn ctx)
+                   ids (distinct (map :e (d/datoms db :eavt)))
+                   wrong (vec (for [e ids :when (not= (contains? expected e) (private? e))]
+                                [e (:block/title (d/entity db e)) (contains? expected e)]))]
+               (is (= [] wrong) (str "seed " seed ": entities where private? and private-ids differ"))
+               (is (< 3 (count (filter #(and (contains? expected %) (string/includes? (str (:block/title (d/entity db %))) "zq")) ids)))
+                   (str "seed " seed ": the graph holds private zq entities to compare")))))
+         (p/resolved nil) (range 1 31))
+        (p/catch #(is false (str % "\n" (.-stack %))))
+        (p/finally done))))
+
+(deftest private-fn-cases-test
+  ;; The cases private-ids covers, one at a time: the private tag in any case, a tag extending a tag
+  ;; extending it, a page's blocks, a private block's descendants, a moved block, a stale page ref,
+  ;; the Recycle bin and a public block.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self notes public-note public-child hidden-child plan-block hush-plans public-plans private-plans private-tag]}]
+        (p/let [_ (ok! (request! self "POST" "/semantic/tags" {:title "zq LOUD"}) 201)
+                [moved] (insert! self notes [{:title "zq to move" :children [{:title "zq moved child"}]}])
+                _ (ok! (request! self "POST" "/semantic/block-moves"
+                                 {:block-ids [(:uuid moved)] :target-id (str hidden-child) :position "last-child"}) 200)
+                recycled (p/let [r (ok! (request! self "POST" "/semantic/pages" {:title "zq Recycled"}) 201)] (uuid-of r))
+                [recycled-block] (insert! self recycled [{:title "zq recycled" :children [{:title "zq recycled child"}]}])
+                _ (ok! (request! self "DELETE" (str "/semantic/pages/" recycled) nil) 200)
+                shouting (p/let [r (ok! (request! self "POST" "/semantic/pages" {:title "zq Shouting"}) 201)] (uuid-of r))
+                _ (ok! (request! self "PATCH" (str "/semantic/tags/" private-tag) {:title "PRIVATE"}) 200)
+                _ (set-tags! self shouting ["PRIVATE"])
+                [shout-block] (insert! self shouting [{:title "zq shouted"}])]
+          (d/transact! conn [{:block/uuid (random-uuid) :block/title "zq stale private block"
+                              :block/page [:block/uuid private-plans] :block/parent [:block/uuid public-note]
+                              :block/order "a1" :block/created-at 1 :block/updated-at 1}])
+          (let [db @conn
+                id (fn [u] (:db/id (d/entity db [:block/uuid (uuid (str u))])))
+                by-title (fn [t] (ffirst (d/q '[:find ?e :in $ ?t :where [?e :block/title ?t]] db t)))
+                private? (named-queries/private-fn (walk-ctx db))
+                expected (datalog/private-ids db)
+                cases [["a page tagged PRIVATE (the Private tag renamed)" (id shouting) true]
+                       ["a block on that page" (id (:uuid shout-block)) true]
+                       ["a page tagged Hush, which extends Secret, which extends Private" (id hush-plans) true]
+                       ["a block on a private page" (id plan-block) true]
+                       ["a block under a private block" (id hidden-child) true]
+                       ["a block moved under a private block, and its child" (id (:uuid moved)) true]
+                       ["the moved block's child" (by-title "zq moved child") true]
+                       ["a block whose page is private but whose parent chain is not" (by-title "zq stale private block") true]
+                       ["a page in the Recycle bin" (id recycled) true]
+                       ["a block on a recycled page" (id (:uuid recycled-block)) true]
+                       ["a block under that block" (by-title "zq recycled child") true]
+                       ["a public page" (id public-plans) false]
+                       ["a public block" (id public-child) false]
+                       ["the private tag itself" (by-title "PRIVATE") false]
+                       ["a tag titled LOUD, not private" (by-title "zq LOUD") false]]]
+            (doseq [[label e want] cases]
+              (testing label
+                (is (some? e))
+                (is (= want (contains? expected e)) "private-ids agrees with the case")
+                (is (= want (private? e)))))))))))
+
+(deftest counted-reads-test
+  (async done
+    (-> (p/let [conn (sqlite-export/create-conn)
+                self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true}
+                _ (ok! (request! self "POST" "/semantic/tags" {:title "zq Counted"}) 201)
+                pages (p/all (for [i (range 10)]
+                               (p/let [r (ok! (request! self "POST" "/semantic/pages" {:title (str "zq counted " i)}) 201)]
+                                 (uuid-of r))))
+                _ (reduce (fn [acc page] (p/let [_ acc] (set-tags! self page ["zq Counted"]))) (p/resolved nil) pages)]
+          (let [db @conn
+                tag (ffirst (d/q '[:find ?e :where [?e :block/title "zq Counted"]] db))]
+            (testing "datoms* charges one read per datom realised, not for the range"
+              (let [ctx (walk-ctx db)
+                    s (named-queries/datoms* ctx :avet :block/tags tag)]
+                (is (= 0 (work ctx :reads)) "nothing is charged before a datom is realised")
+                (is (= 3 (count (doall (take 3 s)))))
+                (is (= 3 (work ctx :reads)))
+                (is (= 10 (count (doall s))))
+                (is (= 10 (work ctx :reads)) "the whole range of 10 charges 10")))
+            (testing "datoms* over EAVT charges the same way"
+              (let [ctx (walk-ctx db)
+                    e (:e (first (d/datoms db :avet :block/tags tag)))]
+                (is (= (count (d/datoms db :eavt e)) (count (doall (named-queries/datoms* ctx :eavt e)))))
+                (is (= (count (d/datoms db :eavt e)) (work ctx :reads)))))
+            (testing "first-value* charges 1 and returns the value"
+              (let [ctx (walk-ctx db)
+                    e (:e (first (d/datoms db :avet :block/tags tag)))]
+                (is (string/starts-with? (named-queries/first-value* ctx e :block/title) "zq counted "))
+                (is (nil? (named-queries/first-value* ctx e :logseq.property/deleted-at)))
+                (is (= 2 (work ctx :reads)))))
+            (testing "charge! counts up to its bound, throws one past it, and leaves reads to the reads"
+              (let [ctx (walk-ctx db {:tagged 2})]
+                (named-queries/charge! ctx :tagged 1)
+                (named-queries/charge! ctx :tagged 1)
+                (is (= 2 (work ctx :tagged)) "at the bound is allowed")
+                (is (= 0 (work ctx :reads)) "a candidate charge is not a read")
+                (is (= {:query "test-walk" :bound :tagged :value 2}
+                       (bound-data #(named-queries/charge! ctx :tagged 1))))
+                (is (= 3 (work ctx :tagged)) "work shows the bound + 1")))
+            (testing "a charge of n past the bound in one step throws"
+              (let [ctx (walk-ctx db {:meetings 4})]
+                (named-queries/charge! ctx :meetings 3)
+                (is (= {:query "test-walk" :bound :meetings :value 4}
+                       (bound-data #(named-queries/charge! ctx :meetings 2))))))
+            (testing "a candidate charge never trips reads; reads past its own bound throws naming reads"
+              (let [ctx (walk-ctx db {:reads 5})]
