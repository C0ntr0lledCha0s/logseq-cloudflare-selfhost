+(deftest create-page-journal-title-in-the-graphs-slash-format-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn call]}]
+        (let [format! (fn [fmt] (d/transact! conn [[:db/add :logseq.class/Journal :logseq.property.journal/title-format fmt]]))
+              cases [["dd/MM/yyyy" "17/11/2026"]
+                     ["E, MM/dd/yyyy" "tue, 11/17/2026"]
+                     ["E, MM/dd/yyyy" "TUE, 11/17/2026"]
+                     ["EEEE, yyyy/MM/dd" "tuesday, 2026/11/17"]]]
