diff --git a/deps/db-sync/src/logseq/db_sync/worker/named_queries.cljs b/deps/db-sync/src/logseq/db_sync/worker/named_queries.cljs
new file mode 100644
index 0000000..ff97074
--- /dev/null
+++ b/deps/db-sync/src/logseq/db_sync/worker/named_queries.cljs
@@ -0,0 +1,118 @@
+(ns logseq.db-sync.worker.named-queries
+  "The named queries runNamedQuery runs (patch 0039), as data. Each entry is a map in the shape of
+  Logseq's advanced query, {:title :query :rules :params}, so its {:query :inputs} pair can be
+  written into a Query block. :query is the map form; :in binds $, then % when the entry has
+  rules, then one input per param in :params order. Each param is {:name :type :default :bounds},
+  with :required instead of a default when it has none:
+
+  - :tag resolves by UUID, ident or title (case-insensitive), then expands to the tag and every tag
+    extending it: a vector of class ids for a collection binding [?t ...], or a set when :binding
+    is :set (one value, so a not-join asks about any of the tags, where a collection binding would
+    ask about each in turn);
+  - :property resolves by UUID, ident or title to the property's ident (:types limits its type);
+  - :days is an integer within :bounds and becomes a cutoff in ms (now less that many days).
+
+  The handler resolves the params, then the query runs through the same validator, private filter
+  and caps as datalogQuery, so no entry can get round a guard.
+
+  Datascript joins a pattern to the rows before it by scanning the attribute unless one value is
+  bound, and the scan cap counts that scan. So each entry reads per row with get-else, get-some and
+  missing? (one entity's datoms each): meetings-without-decision walks up from each decision with
+  get-some rather than down from each meeting through :block/parent. open-tasks-by-client reads its
+  client property's datoms twice (the tasks' and the pages'), because get-else would bind only the
+  first of several values. One other scan is left, because no index leads from a page to its blocks: projects-untouched's not-join reads :block/page for every
+  block when two or more stale pages remain, so on a graph above about 20,000 blocks it can answer
+  422. A tag with tags extending it binds two or more classes, so its :block/tags pattern scans
+  :block/tags (every tagged page and block) once.")
+
+(def ^:private days-bounds [1 3650])
+
+(def ^:private above-rules
+  "A block's ancestors, walked up through :block/parent with get-some: one datom per row and level,
+  where a pattern [?b :block/parent ?x] would scan every block once two or more rows are bound."
+  '[[(above ?b ?a) [(get-some $ ?b :block/parent) [_ ?a]]]
+    [(above ?b ?a) [(get-some $ ?b :block/parent) [_ ?x]] (above ?x ?a)]])
+
+(def named-queries
+  (array-map
+   "projects-untouched"
+   {:title "Projects untouched"
+    :description "Pages tagged tag (or a tag extending it) whose own updated-at is older than days, with no block on the page updated since."
+    :query '{:find [?updated (pull ?p [:block/uuid :block/title])]
+             :keys [updated-at page]
+             :in [$ [?tag ...] ?cutoff]
+             :where [[?p :block/tags ?tag]
+                     [(missing? $ ?p :block/page)]
+                     [(get-else $ ?p :block/updated-at 0) ?updated]
+                     [(< ?updated ?cutoff)]
+                     (not-join [?p ?cutoff]
+                               [?b :block/page ?p]
+                               [(get-else $ ?b :block/updated-at 0) ?b-updated]
+                               [(>= ?b-updated ?cutoff)])]}
+    :rules nil
+    :params [{:name "tag" :type :tag :default "Project"}
+             {:name "days" :type :days :default 30 :bounds days-bounds}]}
+
+   "meetings-without-decision"
+   {:title "Meetings without a decision"
+    :description "Pages or blocks tagged meeting_tag, created within days, with no block below them (at any depth) tagged decision_tag."
+    :query '{:find [?created (pull ?m [:block/uuid :block/title])]
+             :keys [created-at meeting]
+             :in [$ % [?meeting-tag ...] ?decision-tags ?cutoff]
+             :where [[?m :block/tags ?meeting-tag]
+                     [(get-else $ ?m :block/created-at 0) ?created]
+                     [(>= ?created ?cutoff)]
+                     ;; Up from each decision rather than down from each meeting: the decisions
+                     ;; are few, and a walk down would scan :block/parent. The tags come in as one
+                     ;; set, so the not-join asks about any of them, not about each in turn.
+                     (not-join [?m ?decision-tags]
+                               [(identity ?decision-tags) [?decision-tag ...]]
+                               [?d :block/tags ?decision-tag]
+                               (above ?d ?m))]}
+    :rules above-rules
+    :params [{:name "meeting_tag" :type :tag :default "Business Meeting"}
+             {:name "decision_tag" :type :tag :default "Decision" :binding :set}
+             {:name "days" :type :days :default 90 :bounds days-bounds}]}
+
+   "open-tasks-by-client"
+   {:title "Open tasks by client"
+    :description "Blocks tagged Task whose status is not Done or Canceled, with each client from the task's own client_property, else each from its page's (empty when neither has one), sorted by client title: a task with two clients is a row under each."
+    :query '{:find [?client (pull ?t [:block/uuid :block/title])]
+             :keys [client task]
+             :in [$ ?prop]
+             :where [[?t :block/tags :logseq.class/Task]
+                     ;; 0 stands for none: get-else can't default to nil, and an entity id is never 0.
+                     [(get-else $ ?t :block/page 0) ?page]
+                     ;; Data patterns, not get-else, so a property with several values binds each:
+                     ;; get-else returns the first. Each pattern reads the property's datoms once,
+                     ;; but only while ?prop is still a one-row input: so this comes before the
+                     ;; nots (a not joins every relation, ?prop's too), and the page's pattern comes
+                     ;; before missing? (which joins ?prop to the rows) in its branch.
+                     (or-join [?t ?page ?prop ?c]
+                              [?t ?prop ?c]
+                              (and [?page ?prop ?c] [(missing? $ ?t ?prop)])
+                              (and [(missing? $ ?t ?prop)] [(missing? $ ?page ?prop)] [(ground 0) ?c]))
+                     [(get-else $ ?t :logseq.property/status 0) ?status]
+                     (not [?status :db/ident :logseq.property/status.done])
+                     (not [?status :db/ident :logseq.property/status.canceled])
+                     (or-join [?c ?client]
+                              (and [(pos? ?c)] [(get-else $ ?c :block/title "") ?client])
+                              (and [(zero? ?c)] [(ground "") ?client]))]}
+    :rules nil
+    ;; The client is read as the value's :block/title, so the property's values must be entities
+    ;; with a title: not a number (its value is :logseq.property/value) and not a raw value.
+    :params [{:name "client_property" :type :property :default "forClient"
+              :types #{:default :url :date :node :asset :entity :class :page :property}}]}
+
+   "pages-missing-property"
+   {:title "Pages missing a property"
+    :description "Pages tagged tag (or a tag extending it) that have no value for property."
+    :query '{:find [(pull ?p [:block/uuid :block/title])]
+             :keys [page]
+             :in [$ [?tag ...] ?prop]
+             :where [[?p :block/tags ?tag]
+                     [(missing? $ ?p :block/page)]
+                     [(missing? $ ?p ?prop)]]}
+    :rules nil
+    :params [{:name "tag" :type :tag :required true}
+             {:name "property" :type :property :required true}]}))
