+(deftest named-property-kinds-parity-test
+  ;; pages-missing-property takes a property of any type, and open-tasks-by-client one whose values
+  ;; have titles: each kind of value reaches the same visible-values read. For each, the code path
+  ;; answers as the Datalog did: a text, number, checkbox (true and false), datetime, date, url and
+  ;; node value, a node value that is private (a missing value), and a node value that is a block.
+  (async done
+    (with-named done
+      (fn [{:keys [conn self]}]
+        (p/let [_ (ok! (request! self "POST" "/semantic/tags" {:title "zq Kind"}) 201)
+                kinds [["zq k text" "default" "zq some text"]
+                       ["zq k number" "number" 5]
+                       ["zq k checkbox" "checkbox" true]
+                       ["zq k unchecked" "checkbox" false]
+                       ["zq k datetime" "datetime" 1700000000000]
+                       ["zq k date" "date" :journal]
+                       ["zq k url" "url" "https://example.com/zq"]
+                       ["zq k node" "node" "zq Acme"]
+                       ["zq k private node" "node" "zq Kind Hidden"]]
+                journal-task (ok! (request! self "POST" "/semantic/tasks" {:title "zq k journal task"}) 201)
+                journal (str (:block/uuid (:block/page (d/entity @conn [:block/uuid (uuid-of journal-task)]))))
+                kinds (mapv (fn [[t ty v]] [t ty (if (= :journal v) journal v)]) kinds)
+                hidden (page-id! self "zq Kind Hidden")
+                _ (set-tags! self hidden ["Private"])
+                props (reduce (fn [acc [title type]]
+                                (p/let [acc acc
+                                        r (ok! (request! self "POST" "/semantic/properties" {:title title :type type}) 201)]
+                                  (conj acc (js/encodeURIComponent (get-in r [:body :ident])))))
+                              (p/resolved []) kinds)
+                ;; One page per kind holding that kind's value, and one holding none.
+                _ (reduce (fn [acc [[title _ value] path]]
+                            (p/let [_ acc
+                                    page (page-id! self (str title " page"))
+                                    _ (set-tags! self page ["zq Kind"])]
+                              (ok! (request! self "PUT" (str "/semantic/blocks/" page "/properties/" path) {:value value}) 200)))
+                          (p/resolved nil) (map vector kinds props))
+                bare (page-id! self "zq k bare page")
+                _ (set-tags! self bare ["zq Kind"])
+                ;; Tasks with a client of each kind open-tasks-by-client takes.
+                task-page (page-id! self "zq k tasks")
+                [twins] (insert! self task-page [{:title "zq k twin block"}])
+                _ (reduce (fn [acc [[title _ value] path]]
+                            (p/let [_ acc
+                                    r (ok! (request! self "POST" "/semantic/tasks" {:title (str title " task") :page-id (str task-page) :status "todo"}) 201)]
+                              (ok! (request! self "PUT" (str "/semantic/blocks/" (uuid-of r) "/properties/" path) {:value value}) 200)))
+                          (p/resolved nil)
+                          (filter (fn [[[_ type]]] (contains? #{"default" "url" "date" "node"} type)) (map vector kinds props)))
+                block-client (ok! (request! self "POST" "/semantic/properties" {:title "zq k block client" :type "node"}) 201)
+                block-task (ok! (request! self "POST" "/semantic/tasks" {:title "zq k block task" :page-id (str task-page) :status "todo"}) 201)
+                _ (ok! (request! self "PUT" (str "/semantic/blocks/" (uuid-of block-task) "/properties/"
+                                                 (js/encodeURIComponent (get-in block-client [:body :ident])))
+                                 {:value (:uuid twins)}) 200)
+                counts (parity! conn self "property kinds"
+                                (concat (for [[title] kinds] ["pages-missing-property" {:tag "zq Kind" :property title}])
+                                        (for [[title type] kinds :when (contains? #{"default" "url" "date" "node"} type)]
+                                          ["open-tasks-by-client" {:client_property title}])
+                                        [["open-tasks-by-client" {:client_property "zq k block client"}]]))]
+          (testing "each kind's page is the one page with a value, except the private node's"
+            (doseq [[[title] n] (map vector kinds counts)]
+              (is (= (if (= title "zq k private node") 10 9) n) title))))))))
