+(deftest create-page-restores-a-recycled-page-whose-title-holds-a-slash-test
+  ;; The outliner restores a recycled page without checking its title's "/", and createPage
+  ;; answers the outliner's own refusal, so the restore goes through. A page titled "zq/probe" can
+  ;; exist from the app or an import; it is renamed here with a direct transact.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn call]}]
+        (let [rename! (fn [id title]
+                        (d/transact! conn [{:block/uuid (uuid id)
+                                            :block/title title
+                                            :block/name (string/lower-case title)}]))]
+          (p/let [[_ probe] (call "POST" "/pages" {:title "zq probe"})
+                  [_ spaced] (call "POST" "/pages" {:title "zq spaced"})
+                  [_ hashed] (call "POST" "/pages" {:title "zq hashed"})
+                  [_ tag] (call "POST" "/pages" {:title "zq tagged"})
+                  [_ hidden] (call "POST" "/pages" {:title "zq hidden"})
+                  _ (rename! (:uuid probe) "zq/probe")
+                  _ (rename! (:uuid spaced) "zq/spaced")
+                  _ (rename! (:uuid hashed) "zq#hashed")
+                  _ (rename! (:uuid tag) "zq/tagged")
+                  _ (rename! (:uuid hidden) "zq/hidden")
+                  ;; Hidden but not recycled: the outliner hands back an existing top-level page
+                  ;; without checking its title, whatever the characters.
+                  _ (d/transact! conn [[:db/add [:block/uuid (uuid (:uuid hidden))] :logseq.property/hide? true]])
+                  deletes (p/all (map #(call "DELETE" (str "/pages/" (:uuid %))) [probe spaced hashed tag]))
+                  _ (is (= [200 200 200 200] (map first deletes)))
+                  ;; A recycled entity under the title that is not tagged Page (here a tag): the
+                  ;; outliner looks for a Page, so it creates a new page and checks the title.
+                  _ (d/transact! conn [[:db/retract [:block/uuid (uuid (:uuid tag))] :block/tags :logseq.class/Page]
+                                       [:db/add [:block/uuid (uuid (:uuid tag))] :block/tags :logseq.class/Tag]])
+                  _ (is (entity-util/hidden? (entity conn (:uuid tag))) "the tag is in the Recycle bin")
+                  [status body] (call "POST" "/pages" {:title "zq/probe"})
+                  [spaced-status spaced-body] (call "POST" "/pages" {:title "  ZQ/Spaced "})
+                  [hash-status hash-body] (call "POST" "/pages" {:title "zq#hashed"})
+                  [tag-status tag-body] (call "POST" "/pages" {:title "zq/tagged"})
+                  [hidden-status hidden-body] (call "POST" "/pages" {:title "zq/hidden"})
+                  [new-status new-body] (call "POST" "/pages" {:title "zq/never"})]
+            (testing "a recycled page with \"/\" in its title is restored"
+              (is (= [201 (:uuid probe) "zq/probe"] [status (:uuid body) (:title body)]) (pr-str body))
+              (is (not (entity-util/hidden? (entity conn (:uuid probe))))))
+            (testing "matched as the outliner matches it: case-insensitively, after trimming"
+              (is (= [201 (:uuid spaced)] [spaced-status (:uuid spaced-body)]) (pr-str spaced-body)))
+            (testing "\"#\" is still refused: the outliner refuses it before it restores"
+              (is (= [400 "title: a page title can't include \"#\" (zq#hashed)"] [hash-status (:error hash-body)]))
+              (is (entity-util/hidden? (entity conn (:uuid hashed)))))
+            (testing "a recycled tag is not restored by createPage, so its title is still checked"
+              (is (= [400 "title: a page title can't include \"/\" (zq/tagged)"] [tag-status (:error tag-body)])))
+            (testing "a hidden page that is not in the Recycle bin is the outliner's existing page, so \"/\" is not checked"
+              (is (= [201 (:uuid hidden)] [hidden-status (:uuid hidden-body)]) (pr-str hidden-body)))
+            (testing "a title no recycled page holds is still refused"
+              (is (= [400 "title: a page title can't include \"/\" (zq/never)"] [new-status (:error new-body)])))))))))
