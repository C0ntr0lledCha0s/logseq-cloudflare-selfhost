+                titles (query! self '[:find ?b :where [?b :block/title ?t] [(clojure.string/starts-with? ?t "zq filler 1")]])]
+          (testing "an unconstrained query over a graph above the cap answers 422 naming the cap, never 500"
+            (is (= [422 (cap-message "20,000")] [(:status everything) (get-in everything [:body :error])])
+                (pr-str (:status everything) (subs (:text everything) 0 (min 300 (count (:text everything))))))
+            (is (= 20001 scanned) "it stops at the first datom past the cap")
+            (is (= before (snapshot conn))))
+          (testing "a query under the cap on the same graph still answers rows"
+            (is (= [200 1111] [(:status titles) (get-in titles [:body :total-rows])]) (pr-str (:status titles)))
+            (is (= 50 (get-in titles [:body :returned])))))))))
+
+(deftest scan-cap-exact-test
+  ;; The cap counts every datom the filter is asked about across the whole query, kept or dropped.
+  (async done
+    (with-graph done
+      (fn [{:keys [self private-plans]}]
+        (p/let [q '[:find ?t :where [?p :block/title "zq Notes"] [?b :block/parent ?p] [?b :block/title ?t]]
+                uncapped (query! self q)
+                scanned (:scanned @datalog/last-run)
+                _ (set-scan-cap! self scanned)
+                at-cap (query! self q)
+                _ (set-scan-cap! self (dec scanned))
+                over-cap (query! self q)
+                over-scanned (:scanned @datalog/last-run)
+                _ (set-scan-cap! self nil)
+                private-only '[:find ?t :in $ ?u :where [?e :block/uuid ?u] [?e :block/title ?t]]
+                hidden (query! self private-only :inputs (str "[#uuid \"" private-plans "\"]"))
+                hidden-scanned (:scanned @datalog/last-run)
+                _ (set-scan-cap! self 0)
+                hidden-capped (query! self private-only :inputs (str "[#uuid \"" private-plans "\"]"))
+                _ (set-scan-cap! self nil)]
+          (is (= 200 (:status uncapped)) (pr-str uncapped))
+          (is (> scanned 3) "the three clauses scan more than one datom each between them")
+          (testing "a query that scans exactly the cap answers its rows"
+            (is (= [200 (get-in uncapped [:body :rows])] [(:status at-cap) (get-in at-cap [:body :rows])]) (pr-str at-cap)))
+          (testing "one datom over the cap answers 422 naming the cap"
+            (is (= [422 (cap-message (str (dec scanned)))] [(:status over-cap) (get-in over-cap [:body :error])])
+                (pr-str over-cap))
+            (is (= scanned over-scanned)))
+          (testing "datoms the private filter drops count too"
+            (is (= [200 []] [(:status hidden) (get-in hidden [:body :rows])]) (pr-str hidden))
+            (is (pos? hidden-scanned))
+            (is (= [422 (cap-message "0")] [(:status hidden-capped) (get-in hidden-capped [:body :error])])
+                (pr-str hidden-capped))))))))
+
+(deftest scan-cap-is-per-request-test
+  (async done
+    (with-graph done
+      (fn [{:keys [self]}]
+        (p/let [first-run (query! self zq-titles :limit 200)
+                scanned (:scanned @datalog/last-run)
+                _ (set-scan-cap! self scanned)
+                second-run (query! self zq-titles :limit 200)
+                third-run (query! self zq-titles :limit 200)
+                _ (set-scan-cap! self nil)]
+          (is (= 200 (:status first-run)))
+          (testing "two calls in a row, each under the cap, both answer rows: the count starts again per request"
+            (is (= [200 200] [(:status second-run) (:status third-run)]) (pr-str third-run))
+            (is (= (get-in first-run [:body :rows]) (get-in third-run [:body :rows])))))))))
+
+(deftest rule-recursion-test
+  ;; A recursive rule that reads data before it recurses runs under the scan cap: rows or 422.
+  (async done
+    (with-graph done
+      (fn [{:keys [self]}]
+        (p/let [closure-rules '[[(under ?b ?p) [?b :block/parent ?p]]
+                                [(under ?b ?p) [?b :block/parent ?x] (under ?x ?p)]]
+                closure '[:find ?t :in $ % :where [?p :block/title "zq Notes"] (under ?b ?p) [?b :block/title ?t]]
+                closed (query! self closure :rules closure-rules)
+                _ (set-scan-cap! self 5)
+                capped (query! self closure :rules closure-rules)
+                _ (set-scan-cap! self nil)]
+          (testing "the closure finds the blocks under the page"
+            (is (= 200 (:status closed)) (pr-str closed))
+            (is (contains? (set (map first (get-in closed [:body :rows]))) "zq Public child")))
+          (testing "the same closure under a low cap answers 422, not 500"
+            (is (= [422 (cap-message "5")] [(:status capped) (get-in capped [:body :error])]) (pr-str capped))))))))
+
+(defn- left-recursion-message [rule cycle]
+  (str "rules: rule " rule " recurses (" cycle ") before a data pattern binds any of the call's variables;"
+       " the scan cap can't stop that, so start the rule with a data pattern (or a get-some) that binds one,"
+       " e.g. [?b :block/parent ?x] (under ?x ?p)"))
+
+(deftest rule-left-recursion-refused-test
+  ;; A rule that reaches a call back into itself before reading any datom bound to that call
+  ;; expands without limit: Datascript keeps adding branches, the filter is asked about few datoms,
+  ;; and the scan cap never stops it (a left-recursive closure ran past 120 s at a cap of 100).
+  ;; Every such rule is refused with 400 before the query runs, directly or through other rules.
+  ;; The cap is lowered so that, without the refusal, each case answers 422 at once instead of
+  ;; running on.
+  (async done
+    (with-graph done
+      (fn [{:keys [self conn]}]
+        (p/let [before (snapshot conn)
+                q '[:find ?t :in $ % :where [?p :block/title "zq Notes"] (under ?b ?p) [?b :block/title ?t]]
+                base '[(under ?b ?p) [?b :block/parent ?p]]
+                _ (set-scan-cap! self 20)
+                cases [["left-recursive closure" "under" "under → under"
+                        [base '[(under ?b ?p) (under ?b ?x) (under ?x ?p)]]]
+                       ["mutually left-recursive rules" "under" "under → over → under"
+                        [base '[(under ?b ?p) (over ?b ?x) [?x :block/parent ?p]] '[(over ?b ?p) (under ?b ?p)]]]
+                       ["a call that repeats the head" "under" "under → under"
+                        [base '[(under ?b ?p) (under ?b ?p)]]]
+                       ["only a function clause before the call" "under" "under → under"
+                        [base '[(under ?b ?p) [(ground 1) ?k] (under ?b ?x) [?x :block/parent ?p]]]]
+                       ["a data pattern before the call that shares none of its variables" "under" "under → under"
+                        [base '[(under ?b ?p) [?q :block/title "zq Notes"] (under ?b ?x) [?x :block/parent ?p]]]]
+                       ["the call first inside an or" "under" "under → under"
+                        [base '[(under ?b ?p) (or (under ?b ?x) [?b :block/parent ?x]) [?x :block/parent ?p]]]]
+                       ["the call in a later or branch than a data pattern" "under" "under → under"
+                        [base '[(under ?b ?p) (or [?b :block/parent ?x] (under ?b ?x)) [?x :block/parent ?p]]]]
+                       ["the call inside an and inside an or" "under" "under → under"
+                        [base '[(under ?b ?p) (or (and [(ground 1) ?k] (under ?b ?x)) (and [(ground 2) ?k] [?b :block/parent ?x]))
+                                [?x :block/parent ?p]]]]
+                       ["a pattern outside an or-join that doesn't join the call's variables" "under" "under → under"
+                        [base '[(under ?b ?p) [?y :block/parent ?p] (or-join [?b] (under ?b ?y) [?b :block/title "zq"])]]]
+                       ["the call inside a not-join" "under" "under → under"
+                        [base '[(under ?b ?p) [?b :block/parent ?x] (not-join [?b] (under ?z ?x))]]]
+                       ["the call inside a not" "under" "under → under"
+                        [base '[(under ?b ?p) [?b :block/parent ?x] (not (under ?z ?p))]]]
+                       ["a call with a source" "under" "under → under"
+                        [base '[(under ?b ?p) ($ under ?b ?x) [?x :block/parent ?p]]]]]
+                responses (p/all (for [[_ _ _ rules] cases] (query! self q :rules rules)))
+                _ (set-scan-cap! self nil)
+                after (snapshot conn)]
+          (doseq [[[label rule cycle] response] (map vector cases responses)]
+            (testing label
+              (is (refused? response (left-recursion-message rule cycle)) (pr-str response))))
+          (testing "a cycle is named once, from the first rule defined in it"
+            (is (not (string/includes? (get-in (second responses) [:body :error]) "rule over recurses"))
+                (pr-str (second responses))))
+          (is (= before after)))))))
+
+(defn- rule-chain
+  "Rules r0 → r1 → … → r`n`, each calling the next before reading anything; the last reads a title,
+  or, with `cycle?`, calls r0 back."
+  [n cycle?]
+  (str "[" (string/join " " (for [i (range n)] (str "[(r" i " ?a) (r" (inc i) " ?a)]")))
+       " [(r" n " ?a) " (if cycle? "(r0 ?a)" "[?a :block/title \"zq Notes\"]") "]]"))
+
+(def ^:private chain-q "[:find ?a :in $ % :where (r0 ?a)]")
+
+(deftest request-size-caps-test
+  ;; Only query was held to 4,000 characters: a 70,000-character rules string ran the left-recursion
+  ;; check for 24 s, and an inputs string of any size was parsed, walked and repeated in every row.
+  ;; rules and inputs are held to 4,000 characters each, like query, refused with 400 naming the
+  ;; field before anything is parsed.
+  (async done
+    (with-graph done
+      (fn [{:keys [self conn]}]
+        (let [pad (fn [s n] (str (subs s 0 (dec (count s))) (apply str (repeat (- n (count s)) " ")) "]"))
+              chain (rule-chain 185 false)
+              in-q '[:find ?t :in $ ?x :where [?e :block/title ?x] [?e :block/title ?t]]
+              text-input (fn [n] (pad "[\"zq Notes\"]" n))]
+          (p/let [before (snapshot conn)
+                  rules-at (query! self chain-q :rules (pad chain 4000))
+                  rules-over (query! self chain-q :rules (pad chain 4001))
+                  rules-huge (query! self chain-q :rules (rule-chain 3000 false))
+                  inputs-at (query! self in-q :inputs (text-input 4000))
+                  inputs-over (query! self in-q :inputs (text-input 4001))
+                  dry-over (query! self chain-q :rules (pad chain 4001) :dry-run true)]
+            (is (< 3800 (count chain) 4000) (count chain))
+            (testing "4,000 characters of rules run; 4,001 are refused naming the field and the cap"
+              (is (= [200 1] [(:status rules-at) (get-in rules-at [:body :total-rows])]) (pr-str rules-at))
+              (is (refused? rules-over "rules: at most 4,000 characters (got 4,001)") (pr-str rules-over))
+              (is (refused? rules-huge "rules: at most 4,000 characters (got ") (pr-str (:status rules-huge)))
+              (is (refused? dry-over "rules: at most 4,000 characters (got 4,001)") (pr-str dry-over)))
+            (testing "4,000 characters of inputs run; 4,001 are refused naming the field and the cap"
+              (is (= [200 [["zq Notes"]]] [(:status inputs-at) (get-in inputs-at [:body :rows])]) (pr-str inputs-at))
+              (is (refused? inputs-over "inputs: at most 4,000 characters (got 4,001)") (pr-str inputs-over)))
+            (is (= before (snapshot conn)))))))))
+
+(deftest left-recursion-check-is-linear-test
+  ;; The left-recursion check found each rule's reach and searched for a cycle once per rule, so a
+  ;; chain of n rules cost n² steps: 800 rules took 1.6 s. One strongly connected components pass
+  ;; finds the same cycles in one walk.
+  (let [q (:ok (datalog/normalise-query (reader/read-string chain-q)))
+        timed (fn [rules]
+                (let [start (.now js/Date)
+                      result (datalog/validate-query q (reader/read-string rules) [])]
+                  [result (- (.now js/Date) start)]))
+        [ok ok-ms] (timed (rule-chain 800 false))
+        [cycle cycle-ms] (timed (rule-chain 800 true))]
+    (testing "a chain of 800 rules without a cycle is accepted quickly"
+      (is (nil? ok) ok)
+      (is (< ok-ms 250) (str ok-ms " ms")))
+    (testing "the same chain closed into a cycle is refused once, from r0, quickly"
+      (is (string/includes? (str cycle) "rules: rule r0 recurses (r0 → r1 → r2 →") (subs (str cycle) 0 200))
+      (is (string/includes? (str cycle) "→ r800 → r0)") (subs (str cycle) 0 200))
+      (is (= 1 (count (re-seq #"recurses" (str cycle)))))
+      (is (< cycle-ms 250) (str cycle-ms " ms")))))
+
+(deftest response-counts-before-rows-test
+  ;; The connector prints a result indented and cuts it at 150,000 characters. Whatever cuts it,
+  ;; total-rows, returned and truncated come before rows, so the counts and the note survive.
+  (async done
+    (with-graph done
+      (fn [{:keys [self]}]
+        (p/let [response (query! self zq-titles :limit 1)]
+          (let [text (:text response)
+                at (fn [k] (string/index-of text (str "\"" k "\":")))]
+            (is (= [200 "limit"] [(:status response) (get-in response [:body :truncated :by])]) (pr-str response))
+            (doseq [k ["columns" "total-rows" "returned" "truncated" "query" "inputs"]]
+              (is (< (at k) (at "rows")) (str k " before rows: " text)))))))))
+
+(deftest rule-recursion-after-data-runs-test
+  ;; Recursion the refusal must leave alone: each call back into the rule follows a data pattern that
+  ;; binds one of its variables, so every expansion reads datoms the scan cap counts.
+  (async done
+    (with-graph done
+      (fn [{:keys [self]}]
+        (p/let [q '[:find ?t :in $ % :where [?p :block/title "zq Notes"] (under ?b ?p) [?b :block/title ?t]]
+                base '[(under ?b ?p) [?b :block/parent ?p]]
+                cases [["right-recursive closure" [base '[(under ?b ?p) [?b :block/parent ?x] (under ?x ?p)]]]
+                       ["closure from the other end" [base '[(under ?b ?p) [?x :block/parent ?p] (under ?b ?x)]]]
+                       ["mutual recursion after a data pattern"
+                        [base '[(under ?b ?p) [?b :block/parent ?x] (over ?x ?p)] '[(over ?b ?p) (under ?b ?p)]]]
+                       ["the call inside an or after a data pattern"
+                        [base '[(under ?b ?p) [?b :block/parent ?x] (or (under ?x ?p) (under ?x ?p))]]]
+                       ["a call to a rule that can't call back binds its variables"
+                        [base '[(under ?b ?p) (child ?b ?x) (under ?x ?p)] '[(child ?c ?d) [?c :block/parent ?d]]]]
+                       ["a non-recursive rule that calls another rule first"
+                        [base '[(under ?b ?p) [?b :block/parent ?x] (under ?x ?p)] '[(below ?b ?p) (under ?b ?p)]]
+                        '[:find ?t :in $ % :where [?p :block/title "zq Notes"] (below ?b ?p) [?b :block/title ?t]]]]
+                responses (p/all (for [[_ rules query] cases] (query! self (or query q) :rules rules)))]
+          (doseq [[[label] response] (map vector cases responses)]
+            (testing label
+              (is (= 200 (:status response)) (pr-str response))
+              (is (contains? (set (map first (get-in response [:body :rows]))) "zq Public child")
+                  (pr-str response)))))))))
+
+;; A walk up through get-some reads one datom per row: get-some answers nil, and drops the row,
+;; when the entity has no such datom, and every datom it finds goes through the filter. So a call
+;; after it is guarded like a call after a data pattern. Functions that bind a value without reading
+;; one (get-else's default, ground, identity) still leave the call unguarded.
+(def ^:private above-rules
+  '[[(above ?b ?a) [(get-some $ ?b :block/parent) [_ ?a]]]
+    [(above ?b ?a) [(get-some $ ?b :block/parent) [_ ?x]] (above ?x ?a)]])
+
+(deftest rule-recursion-through-get-some-test
+  (async done
+    (with-graph done
+      (fn [{:keys [self conn]}]
+        (p/let [before (snapshot conn)
+                q '[:find ?t :in $ % :where [?b :block/title "zq Public child"] (above ?b ?a) [?a :block/title ?t]]
+                walked (query! self q :rules above-rules)
+                _ (set-scan-cap! self 2)
+                capped (query! self q :rules above-rules)
+                _ (set-scan-cap! self 20)
+                refused (p/all (for [[_ rules] [["get-else's default" '[(above ?b ?a) [(get-else $ ?b :block/parent 0) ?x] (above ?x ?a)]]
+                                                ["ground" '[(above ?b ?a) [(ground 1) ?x] (above ?x ?a)]]
+                                                ["identity of a head variable" '[(above ?b ?a) [(identity ?b) ?x] (above ?x ?a)]]
+                                                ["a get-some that binds none of the call's variables"
+                                                 '[(above ?b ?a) [(get-some $ ?b :block/parent) [_ ?x]] (above ?b ?a)]]]]
+                                 (query! self q :rules [(first above-rules) rules])))
+                _ (set-scan-cap! self nil)]
+          (testing "the walk up from a block reaches its parent block and its page"
+            (is (= 200 (:status walked)) (pr-str walked))
+            (is (= #{"zq Public note" "zq Notes"} (set (map first (get-in walked [:body :rows])))) (pr-str walked)))
+          (testing "every datom get-some reads counts towards the scan cap"
+            (is (= [422 (cap-message "2")] [(:status capped) (get-in capped [:body :error])]) (pr-str capped)))
+          (testing "a function that binds without reading a datom leaves the call unguarded"
+            (doseq [r refused]
+              (is (refused? r (left-recursion-message "above" "above → above")) (pr-str r))))
+          (is (= before (snapshot conn))))))))
+
+;; The row cap: a join that fans out from few datoms
+;; =================================================
+
+(defn- row-cap-message [rows cap]
+  (str "query matched " rows " rows, more than the row cap of " cap "; every row is sorted before limit"
+       " applies, so narrow it with a tag, page or attribute value, or count them with an aggregate such as"
+       " (count ?b)"))
+
+(defn- set-row-cap!
+  "The test-only row cap the handler reads from the Durable Object (`self`), in place of the
+  constant; nil restores the constant. No request can set it."
+  [self n]
+  (unchecked-set self "datalogRowCap" n))
+
+(def ^:private fanout-blocks
+  "Blocks tagged Topic the row-cap tests add: 51 × 51 = 2,601 rows from a self-join, over the
+  2,500-row cap, from a few hundred datoms, so the scan cap never fires."
+  51)
+
+(deftest row-cap-test
+  ;; A self-join through one tag reads few datoms but returns n² rows, and every row was sorted
+  ;; before limit applied: a tag on 500 pages gave 260,100 rows and 6.6 s of sort. Each shape
+  ;; that can fan out like that (a plain join, a join whose rows are pulled, a rule) is refused with
+  ;; 422 before the sort; an aggregate that folds the fan-out into few rows is not. The same join
+  ;; through an or-join builds 265,302 rows on the way (each branch joins every ?t row), so the join
+  ;; cap stops it first (join-cap-test).
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self notes]}]
+        (p/let [_ (bulk! self notes fanout-blocks #(str "zq fan " (pad2 %) " #Topic"))
+                before (snapshot conn)
+                topic '[?t :block/title "Topic"]
+                cases [["a self-join through one tag"
+                        {:q [:find '?a '?c :where topic '[?a :block/tags ?t] '[?c :block/tags ?t]]}]
+                       ["the same join with a pull in :find (pulls run after the cap)"
+                        {:q [:find '(pull ?a [:block/title]) '?c :where topic '[?a :block/tags ?t] '[?c :block/tags ?t]]}]
+                       ["the join inside a rule"
+                        {:q '[:find ?a ?c :in $ % :where [?t :block/title "Topic"] (tagged ?a ?t) (tagged ?c ?t)]
+                         :rules '[[(tagged ?b ?t) [?b :block/tags ?t]]]}]
+                       ["the join with :keys"
+                        {:q [:find '?a '?c :keys 'a 'c :where topic '[?a :block/tags ?t] '[?c :block/tags ?t]]}]]
+                responses (p/all (for [[_ {:keys [q rules]}] cases]
+                                   (p/let [r (if rules (query! self q :rules rules) (query! self q))]
+                                     (assoc r :last-run @datalog/last-run))))
+                folded (query! self [:find '?a '(count ?c) :where topic '[?a :block/tags ?t] '[?c :block/tags ?t]]
+                               :limit 200)
+                one-side (query! self [:find '?c :where topic '[?a :block/tags ?t] '[?a :block/title ?at]
+                                       '[(clojure.string/starts-with? ?at "zq fan 00 ")]
+                                       '[?c :block/tags ?t]]
+                                 :limit 200)]
+          (doseq [[[label] response] (map vector cases responses)]
+            (testing (str label ": 422 naming the rows and the cap, never 500")
+              (is (= [422 (row-cap-message "2,601" "2,500")] [(:status response) (get-in response [:body :error])])
+                  (pr-str (:status response) (subs (:text response) 0 (min 300 (count (:text response))))))
+              (is (< (get-in response [:last-run :scanned]) 20000) "the scan cap did not fire")
+              (is (zero? (get-in response [:last-run :pulled])) "nothing was pulled")))
+          (testing "an aggregate that folds the fan-out into one row per block still answers"
+            (is (= [200 fanout-blocks] [(:status folded) (get-in folded [:body :total-rows])]) (pr-str (:status folded)))
+            (is (every? #(= fanout-blocks (second %)) (get-in folded [:body :rows]))))
+          (testing "the join with one side bound answers its rows"
+            (is (= [200 fanout-blocks] [(:status one-side) (get-in one-side [:body :total-rows])]) (pr-str one-side)))
+          (is (= before (snapshot conn))))))))
+
+(deftest row-cap-exact-test
+  (async done
+    (with-graph done
+      (fn [{:keys [self notes]}]
+        (p/let [_ (bulk! self notes 3 #(str "zq fan " % " #Topic"))
+                q '[:find ?a ?c :where [?t :block/title "Topic"] [?a :block/tags ?t] [?c :block/tags ?t]]
+                _ (set-row-cap! self 9)
+                at-cap (query! self q)
+                _ (set-row-cap! self 8)
+                over-cap (query! self q)
+                _ (set-row-cap! self nil)
+                restored (query! self q)]
+          (testing "a query that matches exactly the cap answers its rows"
+            (is (= [200 9] [(:status at-cap) (get-in at-cap [:body :total-rows])]) (pr-str at-cap)))
+          (testing "one row over the cap answers 422 naming the rows and the cap"
+            (is (= [422 (row-cap-message "9" "8")] [(:status over-cap) (get-in over-cap [:body :error])])
+                (pr-str over-cap)))
+          (testing "the override cleared, the constant applies again"
+            (is (= 200 (:status restored)) (pr-str restored))))))))
+
+;; The join cap: rows built while joining, before any are counted
+;; ===============================================================
+
+(defn- join-cap-message [n]
+  (str "query stopped after joining " n " rows (the join cap); a join through a shared value, such as"
+       " two blocks with the same tag, matches every pair, so bind one side or narrow it with a tag, page"
+       " or attribute value"))
+
+(defn- set-join-cap!
+  "The test-only join cap the handler reads from the Durable Object (`self`), in place of the
+  constant; nil restores the constant. No request can set it."
+  [self n]
+  (unchecked-set self "datalogJoinCap" n))
+
+(deftest join-cap-test
+  ;; The row cap counts rows after d/q has built them: a three-way self-join through a tag on 150
+  ;; blocks read 463 datoms and built 3,375,000 rows in 21 s before its 422. Datascript builds
+  ;; every joined row through join-tuples (hash joins, products for a function over two groups,
+  ;; or-join and not-join branches, rule calls, collection bindings) or -collect-tuples (a rule
+  ;; body's product), and past the join cap the query stops there with 422.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self notes]}]
+        (p/let [_ (bulk! self notes fanout-blocks #(str "zq fan " (pad2 %) " #Topic"))
+                before (snapshot conn)
+                topic '[?t :block/title "Topic"]
+                three-way (query! self [:find '?a '?b '?c :where topic '[?a :block/tags ?t] '[?b :block/tags ?t]
+                                        '[?c :block/tags ?t]])
+                three-run @datalog/last-run
+                _ (set-join-cap! self 1000)
+                cases [["a self-join through one tag" {:q [:find '?a '?c :where topic '[?a :block/tags ?t] '[?c :block/tags ?t]]}]
+                       ["a join a predicate narrows afterwards (51 rows, built from 2,601)"
+                        {:q [:find '?a '?c :where topic '[?a :block/tags ?t] '[?c :block/tags ?t] '[(= ?a ?c)]]}]
+                       ["the join with a pull in :find" {:q [:find '(pull ?a [:block/title]) '?c :where topic '[?a :block/tags ?t]
+                                                             '[?c :block/tags ?t]]}]
+                       ["the join inside a rule" {:q '[:find ?a ?c :in $ % :where [?t :block/title "Topic"] (tagged ?a ?t) (tagged ?c ?t)]
+                                                  :rules '[[(tagged ?b ?t) [?b :block/tags ?t]]]}]
+                       ["a rule body whose clauses share no variable (a product)"
+                        {:q '[:find ?a ?c :in $ % :where (pair ?a ?c)]
+                         :rules '[[(pair ?a ?c) [?t :block/title "Topic"] [?a :block/tags ?t] [?u :block/title "Topic"]
+                                   [?c :block/tags ?u]]]}]
+                       ["the join through an or-join" {:q [:find '?a '?c :where topic '[?a :block/tags ?t]
+                                                           '(or-join [?t ?c] [?c :block/tags ?t] [?c :block/refs ?t])]}]
+                       ["the join inside a not-join" {:q [:find '?a :where topic '[?a :block/tags ?t]
+                                                          '(not-join [?a ?t] [?c :block/tags ?t] [(< ?c ?a)])]}]
+                       ["a function over two groups (a product)"
+                        {:q [:find '?a '?c :where topic '[?a :block/tags ?t] '[?u :block/title "Topic"] '[?c :block/tags ?u]
+                             '[(compare ?a ?c) ?s]]}]
+                       ["a collection input joined through a function"
+                        {:q '[:find ?a ?x :in $ [?x ...] :where [?t :block/title "Topic"] [?a :block/tags ?t] [(compare ?a ?x) ?s]]
+                         :inputs [(vec (range 30))]}]
+                       ["an aggregate over the join" {:q [:find '?a '(count ?c) :where topic '[?a :block/tags ?t] '[?c :block/tags ?t]]}]]
+                responses (p/all (for [[_ {:keys [q rules inputs]}] cases]
+                                   (p/let [r (query! self q :rules rules :inputs inputs)]
+                                     (assoc r :last-run @datalog/last-run))))
+                one-side (query! self [:find '?c :where topic '[?a :block/tags ?t] '[?a :block/title ?at]
+                                       '[(clojure.string/starts-with? ?at "zq fan 00 ")] '[?c :block/tags ?t]]
+                                 :limit 200)
+                _ (set-join-cap! self nil)
+                plain (d/q '[:find ?a ?c :where [?t :block/title "Topic"] [?a :block/tags ?t] [?c :block/tags ?t]] @conn)]
+          (testing "a three-way self-join stops at the join cap, before its 132,651 rows are built"
+            (is (= [422 (join-cap-message "20,000")] [(:status three-way) (get-in three-way [:body :error])])
+                (pr-str (:status three-way) (subs (:text three-way) 0 (min 300 (count (:text three-way))))))
+            (is (= 20001 (:joined three-run)) "it stops at the first row past the cap")
+            (is (< (:scanned three-run) 20000) "the scan cap did not fire"))
+          (doseq [[[label] response] (map vector cases responses)]
+            (testing (str label ": 422 naming the join cap, never 500")
+              (is (= [422 (join-cap-message "1,000")] [(:status response) (get-in response [:body :error])])
+                  (pr-str (:status response) (subs (:text response) 0 (min 300 (count (:text response))))))
+              (is (= 1001 (get-in response [:last-run :joined])))
+              (is (zero? (get-in response [:last-run :pulled])) "nothing was pulled")))
+          (testing "the join with one side bound answers under the same cap"
+            (is (= [200 fanout-blocks] [(:status one-side) (get-in one-side [:body :total-rows])]) (pr-str one-side)))
+          (testing "outside the handler Datascript joins without a cap"
+            (is (<= (* fanout-blocks fanout-blocks) (count plain))))
+          (is (= before (snapshot conn))))))))
