+(deftest width-charges-test
+  ;; The charge is the rows x columns of the relation each function binding returns, whatever the
+  ;; binding form: a scalar, a tuple (the documented step up with get-some), a collection and a
+  ;; relation each add their columns to the 3 the data patterns bind (?p, ?e, ?t) and to an input's
+  ;; own column, and a collection or relation multiplies the rows. Predicates and data patterns copy
+  ;; nothing and charge nothing.
+  (async done
+    (with-graph done
+      (fn [{:keys [self]}]
+        (p/let [page (page-id! self "zq Width 100")
+                _ (bulk! self page 100 #(str "zq w100 " %))
+                run (fn [clauses & {:keys [inputs]}]
+                      (p/let [q (if inputs
+                                  (string/replace (on-page "zq Width 100" clauses) ". :where" ". :in $ ?xs :where")
+                                  (on-page "zq Width 100" clauses))
+                              r (query! self q :inputs inputs)]
+                        [(:status r) (get-in r [:body :rows 0 0]) (:width @datalog/last-run)]))
+                scalar (run ["[(identity ?t) ?a]" "[(identity ?t) ?b]"])
+                tuple (run ["[(get-some $ ?e :block/parent) [_ ?q]]"])
+                collection (run ["[(get-else $ ?e :block/journal-day ?xs) [?x ...]]"] :inputs [[1 2 3]])
+                relation (run ["[(get-else $ ?e :block/journal-day ?xs) [[?x ?y]]]"] :inputs [[[1 2] [3 4]]])
+                predicate (run ["[(clojure.string/starts-with? ?t \"zq\")]" "[(clojure.string/ends-with? ?t \"1\")]"])
+                patterns (run [])]
+          (testing "a scalar binding: rows x (3 + 1), then rows x (3 + 2)"
+            (is (= [200 100 (+ (* 100 4) (* 100 5))] scalar)))
+          (testing "a tuple binding with _ adds one column"
+            (is (= [200 100 (* 100 4)] tuple)))
+          (testing "a collection binding: 3 rows per row, ?xs and ?x added"
+            (is (= [200 100 (* 300 5)] collection)))
+          (testing "a relation binding: 2 rows per row, ?xs, ?x and ?y added"
+            (is (= [200 100 (* 200 6)] relation)))
+          (testing "predicates and data patterns charge nothing"
+            (is (= [200 10 0] predicate))
+            (is (= [200 100 0] patterns))))))))
+
+(deftest width-cap-exact-test
+  ;; Review focus 14: a query whose function bindings copy exactly the cap answers 200, one value
+  ;; more answers 422 naming the cap set.
+  (async done
+    (with-graph done
+      (fn [{:keys [self]}]
+        (p/let [page (page-id! self "zq Width 100")
+                _ (bulk! self page 100 #(str "zq w100 " %))
+                q (on-page "zq Width 100" (identity-clauses 2))
+                uncapped (query! self q)
+                width (:width @datalog/last-run)
+                _ (set-width-cap! self width)
+                at-cap (query! self q)
+                _ (set-width-cap! self (dec width))
+                over-cap (query! self q)
+                over-width (:width @datalog/last-run)
+                _ (set-width-cap! self nil)]
+          (is (= [200 100] [(:status uncapped) (get-in uncapped [:body :rows 0 0])]) (head-of uncapped))
+          (is (= 900 width))
+          (is (= [200 100] [(:status at-cap) (get-in at-cap [:body :rows 0 0])]) (head-of at-cap))
+          (is (= [422 (width-cap-message (format-n (dec width)))] [(:status over-cap) (get-in over-cap [:body :error])])
+              (head-of over-cap))
+          (is (= width over-width) "the refused query's charge is recorded"))))))
+
+(deftest width-hook-reached-test
+  ;; Risk 8: a Datascript bump that renames or inlines bind-by-fn would drop the guard silently, so a
+  ;; function-binding query must be seen to charge.
+  (async done
+    (with-graph done
+      (fn [{:keys [self]}]
+        (p/let [r (query! self '[:find ?t :where [?e :block/title ?t] [(clojure.string/starts-with? ?t "zq")]
+                                 [(identity ?t) ?a]])]
+          (is (= 200 (:status r)) (head-of r))
+          (is (pos? (:width @datalog/last-run)) (pr-str @datalog/last-run)))))))
+
+(deftest width-cap-restored-test
+  ;; bind-by-fn is wrapped only while run-query's d/q runs, and Datascript's own is put back after an
+  ;; answered query and after a refused one, so nothing else that runs a query is charged.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self]}]
+        (p/let [own dq/bind-by-fn
+                q '[:find ?t :where [?e :block/title ?t] [(clojure.string/starts-with? ?t "zq")] [(identity ?t) ?a]]
+                answered (query! self q)
+                after-answered dq/bind-by-fn
+                _ (set-width-cap! self 1)
+                refused (query! self q)
+                after-refused dq/bind-by-fn
+                _ (set-width-cap! self nil)
+                direct (d/q '[:find (count ?a) . :where [?e :block/title ?t] [(identity ?t) ?a]] @conn)]
+          (is (= [200 422] [(:status answered) (:status refused)]) (pr-str [(head-of answered) (head-of refused)]))
+          (is (= (width-cap-message "1") (get-in refused [:body :error])))
+          (is (identical? own after-answered) "restored after an answered query")
+          (is (identical? own after-refused) "restored after a refused query")
+          (is (pos? direct) "a query outside run-query runs uncharged"))))))
