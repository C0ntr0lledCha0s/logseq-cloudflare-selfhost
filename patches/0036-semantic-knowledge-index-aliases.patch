diff --git a/deps/db-sync/test/logseq/db_sync/semantic_knowledge_index_aliases_test.cljs b/deps/db-sync/test/logseq/db_sync/semantic_knowledge_index_aliases_test.cljs
new file mode 100644
index 0000000..da4b542
--- /dev/null
+++ b/deps/db-sync/test/logseq/db_sync/semantic_knowledge_index_aliases_test.cljs
@@ -0,0 +1,192 @@
+(ns logseq.db-sync.semantic-knowledge-index-aliases-test
+  "listKnowledgeIndex lists each entry's aliases: the titles of its visible :block/alias targets,
+  sorted, and [] when there are none. Run through the real handler on a real conn."
+  (:require ["better-sqlite3" :as sqlite3]
+            [cljs.test :refer [async deftest is]]
+            [clojure.string :as string]
+            [datascript.core :as d]
+            [logseq.db-sync.storage :as storage]
+            [logseq.db-sync.worker.handler.sync :as sync-handler]
+            [logseq.db-sync.worker.routes.semantic :as semantic-routes]
+            [logseq.db.sqlite.build :as sqlite-build]
+            [logseq.db.sqlite.export :as sqlite-export]
+            [promesa.core :as p]))
+
+(def sqlite (if (find-ns 'nbb.core) (aget sqlite3 "default") sqlite3))
+
+(defn- select-sql? [sql]
+  (string/starts-with? (-> sql string/trim string/lower-case) "select"))
+
+(defn- with-memory-sql-async [f]
+  (let [db (new sqlite ":memory:" nil)
+        sql #js {:_db db
+                 :transaction (fn [f] ((.transaction db f)))
+                 :exec (fn [sql-str & args]
+                         (let [^js stmt (.prepare db sql-str)]
+                           (if (select-sql? sql-str)
+                             (.apply (.-all stmt) stmt (to-array args))
+                             (do (.apply (.-run stmt) stmt (to-array args)) nil))))
+                 :close (fn [] (.close db))}]
+    (-> (f sql)
+        (p/finally #(.close sql)))))
+
+(defn- index! [sql conn query]
+  (storage/init-schema! sql)
+  (let [self #js {:sql sql :conn conn :schema-ready true}
+        request (js/Request. (str "http://localhost/semantic/knowledge-index?graph-id=graph-1&limit=200" query)
+                             #js {:method "GET" :headers #js {"content-type" "application/json"}})]
+    (p/let [response (sync-handler/handle-http self request)
+            text (.text response)]
+      {:status (.-status response)
+       :body (js->clj (js/JSON.parse text) :keywordize-keys true)})))
+
+(def ^:private ids
+  (zipmap [:oi :oi-alias :ops :plain :journal-host :class-host :archive :hidden-parent :under-hidden
+           :hidden-alias :recycled-alias :recycled-host :recycled-target :secret :secret-alias
+           :public-host :project-page :property-host]
+          (repeatedly random-uuid)))
+
+(defn- page [k title & {:as extra}]
+  {:page (merge {:block/title title :block/uuid (get ids k) :build/keep-uuid? true} extra)})
+
+(defn- seeded-graph
+  "Operational Intelligence has aliases OI and Ops Intel (added in reverse order) and a hidden and a
+  recycled alias. Secret Plans is tagged Private and has alias Secret Alias; Public Host has Secret
+  Plans as an alias. Recycled Host, in the Recycle bin, aliases Recycled Target, which has OI too."
+  []
+  (let [conn (sqlite-export/create-conn)
+        {:keys [init-tx block-props-tx]}
+        (sqlite-build/build-blocks-tx
+         {:properties {:user.property/status-note {:logseq.property/type :default}}
+          :classes {:user.class/Project {}
+                    :user.class/Private {}}
+          :pages-and-blocks
+          [(page :oi "Operational Intelligence")
+           ;; Ops Intel is created before OI, so the entity ids' order is not the titles' order.
+           (page :ops "Ops Intel")
+           (page :oi-alias "OI")
+           (page :plain "Plain Page")
+           (page :journal-host "Journal Host")
+           (page :class-host "Class Host")
+           (page :property-host "Property Host")
+           (page :archive "Archive" :build/properties {:logseq.property/hide? true})
+           (page :under-hidden "Under Hidden")
+           (page :hidden-alias "Hidden Alias" :build/properties {:logseq.property/hide? true})
+           (page :recycled-alias "Recycled Alias")
+           (page :recycled-host "Recycled Host")
+           (page :recycled-target "Recycled Target")
+           (page :secret "Secret Plans" :build/tags [:user.class/Private])
+           (page :secret-alias "Secret Alias")
+           (page :public-host "Public Host")
+           (page :project-page "Roadmap" :build/tags [:user.class/Project])
+           {:page {:build/journal 20261104}}]})]
+    (d/transact! conn init-tx)
+    (d/transact! conn block-props-tx)
+    (let [db @conn
+          ref (fn [k] [:block/uuid (get ids k)])
+          journal (some (fn [datom]
+                          (let [e (d/entity db (:e datom))]
+                            (when (= 20261104 (:block/journal-day e)) (:db/id e))))
+                        (d/datoms db :avet :block/journal-day))
+          project-class (:db/id (d/entity db :user.class/Project))
+          property (:db/id (d/entity db :user.property/status-note))]
+      (d/transact! conn
+                   [;; Under Hidden sits under a hidden page; Recycled Alias and Recycled Host are in the
+                    ;; Recycle bin.
+                    [:db/add (ref :under-hidden) :block/parent (ref :archive)]
+                    [:db/add (ref :recycled-alias) :logseq.property/deleted-at 5]
+                    [:db/add (ref :recycled-host) :logseq.property/deleted-at 5]
+                    ;; Ops Intel first again, so the answer's order comes from the sort.
+                    [:db/add (ref :oi) :block/alias (ref :ops)]
+                    [:db/add (ref :oi) :block/alias (ref :oi-alias)]
+                    [:db/add (ref :oi) :block/alias (ref :hidden-alias)]
+                    [:db/add (ref :oi) :block/alias (ref :under-hidden)]
+                    [:db/add (ref :oi) :block/alias (ref :recycled-alias)]
+                    [:db/add (ref :recycled-host) :block/alias (ref :recycled-target)]
+                    [:db/add (ref :recycled-target) :block/alias (ref :plain)]
+                    [:db/add (ref :journal-host) :block/alias journal]
+                    [:db/add (ref :class-host) :block/alias project-class]
+                    [:db/add (ref :property-host) :block/alias property]
+                    [:db/add (ref :secret) :block/alias (ref :secret-alias)]
+                    [:db/add (ref :public-host) :block/alias (ref :secret)]]))
+    conn))
+
+(defn- by-title [response]
+  (into {} (map (juxt :title identity)) (get-in response [:body :pages])))
+
+(defn- run [done f]
+  (with-memory-sql-async
+    (fn [sql]
+      (-> (f sql (seeded-graph))
+          (p/catch (fn [error] (is false (str error))))
+          (p/finally done)))))
+
+(deftest lists-visible-aliases-sorted-test
+  (async done
+         (run done (fn [sql conn]
+                 (p/let [response (index! sql conn "&exclude-tags=private")
+                         pages (by-title response)]
+                   (is (= 200 (:status response)) (str (:body response)))
+                   (is (= ["OI" "Ops Intel"] (get-in pages ["Operational Intelligence" :aliases]))
+                       "visible alias titles, sorted")
+                   (is (= [] (get-in pages ["Plain Page" :aliases])) "a page with no aliases lists []")
+                   (is (every? #(vector? (:aliases %)) (get-in response [:body :pages]))
+                       "every entry carries the key")
+                   (is (= ["Project"] (get-in pages ["Class Host" :aliases])) "a class alias target is listed")
+                   (is (= ["status-note"] (get-in pages ["Property Host" :aliases])) "a property alias target is listed")
+                   (is (= 1 (count (get-in pages ["Journal Host" :aliases]))) "a journal alias target is listed")
+                   (is (string? (first (get-in pages ["Journal Host" :aliases])))))))))
+
+(deftest drops-hidden-and-recycled-alias-targets-test
+  (async done
+         (run done (fn [sql conn]
+                 (p/let [response (index! sql conn "")
+                         pages (by-title response)
+                         all-aliases (set (mapcat :aliases (get-in response [:body :pages])))]
+                   (is (not-any? all-aliases ["Hidden Alias" "Under Hidden" "Recycled Alias"])
+                       "hidden, under a hidden parent and recycled alias targets are left out")
+                   (is (not (contains? pages "Recycled Host")) "a recycled page is not an entry")
+                   (is (= ["Plain Page"] (get-in pages ["Recycled Target" :aliases]))
+                       "a page aliased by a recycled page still lists its own visible aliases"))))))
+
+(deftest alias-pages-are-entries-in-their-own-right-test
+  (async done
+         (run done (fn [sql conn]
+                 (p/let [response (index! sql conn "&exclude-tags=private")
+                         pages (by-title response)]
+                   (is (= [] (get-in pages ["OI" :aliases])) "the alias page is an entry, listing no aliases")
+                   (is (contains? pages "Ops Intel")))))))
+
+(deftest classes-and-properties-are-not-entries-test
+  (async done
+         (run done (fn [sql conn]
+                 (p/let [response (index! sql conn "")
+                         pages (by-title response)]
+                   (is (not (contains? pages "Project")) "a user class (tagged Tag) is not an entry")
+                   (is (not (contains? pages "Private")))
+                   (is (not (contains? pages "status-note")) "a user property is not an entry")
+                   (is (contains? pages "Roadmap") "a page tagged with a user class is an entry")
+                   (is (not-any? #(re-find #"^Nov|2026" %) (keys pages)) "journals are not entries"))))))
+
+(deftest exclude-tags-still-applies-test
+  (async done
+         (run done (fn [sql conn]
+                 (p/let [response (index! sql conn "&exclude-tags=private")
+                         pages (by-title response)
+                         unfiltered-response (index! sql conn "")
+                         unfiltered (by-title unfiltered-response)]
+                   (is (not (contains? pages "Secret Plans")) "a page tagged private is not an entry")
+                   (is (= [] (get-in pages ["Secret Alias" :aliases])) "its alias page does not mention it")
+                   (is (= [] (get-in pages ["Public Host" :aliases]))
+                       "a page tagged with an excluded tag is not listed as another page's alias")
+                   (is (not (contains? (set (mapcat :aliases (get-in response [:body :pages]))) "Secret Plans")))
+                   (is (= ["Secret Alias"] (get-in unfiltered ["Secret Plans" :aliases])) "without exclude-tags it is")
+                   (is (= ["Secret Plans"] (get-in unfiltered ["Public Host" :aliases]))))))))
+
+(deftest aliases-are-documented-test
+  (let [document (semantic-routes/openapi-document "https://issuer.example")
+        operation (get-in document [:paths "/api/v1/graphs/{graph-id}/knowledge-index" :get])
+        entry (get-in document [:components :schemas :KnowledgeIndexEntry])]
+    (is (string/includes? (:description operation) "aliases"))
+    (is (some #{"aliases"} (:required entry)) "aliases is always present")
+    (is (= {:type "array" :items {:type "string"}} (select-keys (get-in entry [:properties :aliases]) [:type :items])))))
