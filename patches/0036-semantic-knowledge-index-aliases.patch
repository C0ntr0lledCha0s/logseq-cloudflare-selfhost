+  [db {:keys [lineage excluded]} page]
+  (->> (:block/alias page)
+       (remove entity-util/hidden?)
+       (remove #(graph-insights/excluded-page? db lineage excluded %))
+       (keep :block/title)
+       sort
+       vec))
