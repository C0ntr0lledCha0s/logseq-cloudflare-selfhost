+(defn- atomic-write!
+  "Runs (mutate conn) as one authored transaction and returns its result: all of its changes land,
+  or none do. A dry run applies them to a throwaway copy of the graph instead."
+  [conn creator dry-run? outliner-op mutate]
+  (let [result (volatile! nil)]
+    (authored-write! (if dry-run? (dry-run-conn conn) conn) creator
+                     ldb/batch-transact-with-temp-conn! {:outliner-op outliner-op}
+                     (fn [temp-conn _] (vreset! result (mutate temp-conn))))
+    @result))
