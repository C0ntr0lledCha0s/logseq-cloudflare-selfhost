+;; Bulk operations. Each is one request, so one rate-limited write, and applies every change it
+;; was given or none: all inputs are checked first, then the work runs as one transaction. Writes
+;; take `dry-run`, which runs the same work on a throwaway copy of the graph and reports it.
+
+(defn- parse-ids [raw]
+  (when (non-blank-string? raw)
+    (let [ids (mapv string/trim (string/split raw #","))]
+      (when (every? common-util/uuid-string? ids) ids))))
+
+(defn- bulk-read-response [db ids view]
+  (let [entities (map #(find-visible-entity db %) ids)
+        found (remove nil? entities)
+        blocks (if (= "outline" view)
+                 ;; One outline budget for the whole response, as for a single page.
+                 (:blocks (reduce (fn [{:keys [budget] :as result} entity]
+                                    (let [outline (page-outline db entity budget)]
+                                      (-> result
+                                          (update :budget - (:block-count outline))
+                                          (update :blocks conj (merge (block-detail-response db entity) outline)))))
+                                  {:budget max-outline-blocks :blocks []}
+                                  found))
+                 (mapv #(block-detail-response db %) found))]
+    {:blocks blocks
+     :missing (vec (keep (fn [[id entity]] (when (nil? entity) id)) (map vector ids entities)))}))
+
+(def ^:private delete-elsewhere
+  {"page" "is a page; delete pages with deletePage"
+   "tag" "is a tag; delete tags with deleteTag"
+   "property" "is a property; delete properties with deleteProperty"})
+
+(defn- delete-blocks-error [block-ids blocks]
+  (if-not (and (sequential? block-ids) (<= 1 (count block-ids) max-batch-size))
+    (str "block-ids must be an array of 1 to " max-batch-size " UUIDs")
+    (some (fn [[index block]]
+            (when-let [reason (cond
+                                (nil? block) "block not found"
+                                (delete-elsewhere (block-kind block)) (delete-elsewhere (block-kind block))
+                                (some #(= (:db/id block) (:db/id %)) (take index blocks)) "duplicate")]
+              (str "block-ids[" index "]: " reason)))
+          (map-indexed vector blocks))))
+
+(def ^:private move-positions #{"before" "after" "first-child" "last-child"})
+
+(defn- move-error
+  "Why one batch move entry is invalid, given the blocks earlier entries already move; nil when valid."
+  [{:keys [blocks target position]} moved]
+  (or (some (fn [[index block]]
+              (cond
+                (nil? block) (str "block-ids[" index "]: block not found")
+                (contains? moved (:db/id block)) (str "block-ids[" index "] is already moved by an earlier move")
+                (some #(= (:db/id block) (:db/id %)) (take index blocks)) (str "block-ids[" index "] is listed twice")))
+            (map-indexed vector blocks))
+      (cond
+        (nil? target) "target not found"
+        (not (contains? move-positions position)) "position must be before, after, first-child or last-child"
+        (some #(= (:db/id target) (:db/id %)) blocks) "a block cannot move relative to itself"
+        (and (contains? #{"before" "after"} position) (nil? (:block/parent target)))
+        "before and after need a block target, not a page")))
+
+(defn- resolve-moves
+  "Batch move entries as {:moves [{:blocks :target :position}]}, or {:error reason}."
+  [db moves]
+  (if-not (and (sequential? moves) (<= 1 (count moves) max-batch-size))
+    {:error (str "moves must be an array of 1 to " max-batch-size " moves")}
+    (reduce (fn [{:keys [moved] :as result} [index entry]]
+              (let [block-ids (when (map? entry) (:block-ids entry))
+                    move (when (and (sequential? block-ids) (seq block-ids))
+                           {:blocks (mapv #(find-entity db %) block-ids)
+                            :target (find-entity db (:target-id entry))
+                            :position (:position entry)})]
+                (if-let [error (if move (move-error move moved) "block-ids must be a non-empty array")]
+                  (reduced {:error (str "moves[" index "]: " error)})
+                  (-> result
+                      (update :moves conj move)
+                      (update :moved into (map :db/id (:blocks move)))))))
+            {:moves [] :moved #{}}
+            (map-indexed vector moves))))
+
+(defn- move-all!
+  "Applies resolved moves in order, each against the graph as the moves before it left it."
+  [conn moves]
+  (doseq [[index {:keys [blocks target position]}] (map-indexed vector moves)]
+    (let [db @conn
+          blocks (mapv #(d/entity db (:db/id %)) blocks)
+          target (d/entity db (:db/id target))
+          moving (set (map :db/id blocks))
+          inside-moving? (fn [entity] (some moving (map :db/id (ldb/get-block-parents db (:block/uuid entity)))))
+          prefix (str "moves[" index "]: ")]
+      (when-let [nested (first (keep-indexed (fn [j block] (when (inside-moving? block) j)) blocks))]
+        (reject! (str prefix "block-ids[" nested "] is inside another block of this move; move the outer block alone")))
+      (when (inside-moving? target)
+        (reject! (str prefix "a block cannot move into its own children")))
+      (let [[target' opts] (move-destination blocks target position)
+            parent-id (if (contains? #{"before" "after"} position)
+                        (:db/id (:block/parent target))
+                        (:db/id target))]
+        (outliner-core/move-blocks! conn blocks target' opts)
+        ;; The outliner skips moves it refuses (a page under a block, a target it can't take)
+        ;; without an error, so check that every block arrived.
+        (when-not (every? #(= parent-id (:db/id (:block/parent (d/entity @conn (:db/id %))))) blocks)
+          (reject! (str prefix "the blocks could not be placed there")))))))
+
+(defn- tree-uuids [nodes]
+  (mapcat (fn [node]
+            (cond->> (tree-uuids (:children node))
+              (string? (:uuid node)) (cons (string/lower-case (:uuid node)))))
+          nodes))
+
+(defn- insert-entry
+  "One batch insert entry resolved against `db`: {:entry resolved} or {:error reason}."
+  [db e2ee? index entry]
+  (let [prefix (str "entries[" index "]")
+        target (when (contains? entry :target-id) (find-entity db (:target-id entry)))
+        page (:page entry)
+        existing-page (when (and (non-blank-string? page) (not e2ee?)) (ldb/get-page db page))
+        properties (when (contains? entry :properties) (prepare-properties db (:properties entry) e2ee?))
+        error (cond
+                (and (contains? entry :target-id) (contains? entry :page)) "give target-id or page, not both"
+                (contains? entry :target-id) (when (nil? target) "target not found")
+                (not (contains? entry :page)) "give target-id or page"
+                (not (non-blank-string? page)) "page must be a non-blank title"
+                e2ee? "page titles are unavailable for E2EE graphs; create the page and pass target-id"
+                (and existing-page (not (page? existing-page)))
+                (str page " is a " (block-kind existing-page) ", not a page"))
+        error (or error
+                  (cond
+                    (not (contains? #{nil "append" "prepend"} (:position entry)))
+                    "position must be append or prepend"
+                    (not (or (contains? entry :blocks) (contains? entry :properties)))
+                    "give blocks, properties or both"
+                    (and (contains? entry :blocks)
+                         (not (valid-tree-identities? db (or target existing-page) (:blocks entry))))
+                    "invalid blocks"
+                    (:error properties) (:error properties)))
+        tree (when (and (nil? error) (contains? entry :blocks))
+               (prepare-tree db (:blocks entry) e2ee? (str prefix ".blocks")))]
+    (cond
+      error {:error (str prefix ": " error)}
+      (:error tree) tree
+      :else {:entry {:target target
+                     :page page
+                     :position (or (:position entry) "append")
+                     :properties (:properties properties)
+                     :nodes (:nodes tree)}})))
+
+(defn- resolve-insert-entries
+  "Batch insert entries as {:entries [...]}, or {:error reason}. A block uuid may appear only once
+  in the whole batch."
+  [db e2ee? entries]
+  (if-not (and (sequential? entries) (<= 1 (count entries) max-batch-size))
+    {:error (str "entries must be an array of 1 to " max-batch-size " entries")}
+    (reduce (fn [{:keys [uuids] :as result} [index entry]]
+              (let [{:keys [error] :as resolved} (if (map? entry)
+                                                   (insert-entry db e2ee? index entry)
+                                                   {:error (str "entries[" index "]: must be an object")})
+                    entry-uuids (tree-uuids (:blocks entry))]
+                (cond
+                  error (reduced {:error error})
+                  (some uuids entry-uuids)
+                  (reduced {:error (str "entries[" index "]: a block uuid is used more than once in the batch")})
+                  :else (-> result
+                            (update :entries conj (:entry resolved))
+                            (update :uuids into entry-uuids)))))
+            {:entries [] :uuids #{}}
+            (map-indexed vector entries))))
+
+(defn- insert-entries!
+  "Applies resolved insert entries in order. A `page` entry uses the page with that name, or creates it."
+  [conn e2ee? entries]
+  (mapv (fn [{:keys [target page position properties nodes]}]
+          (let [existing (if target (d/entity @conn (:db/id target)) (ldb/get-page @conn page))
+                target-id (:db/id (or existing
+                                      (let [[_ page-uuid] (outliner-page/create! conn page {})]
+                                        (d/entity @conn [:block/uuid page-uuid]))))]
+            (doseq [[property-ident value] properties]
+              (set-prepared-property! conn target-id property-ident value false))
+            (cond-> {:target-id (str (:block/uuid (d/entity @conn target-id)))
+                     :blocks (if (seq nodes)
+                               (insert-tree! conn (d/entity @conn target-id) nodes position e2ee?)
+                               [])}
+              (nil? existing) (assoc :created true))))
+        entries))
+
+(defn- bulk-write-response
+  "The response to a bulk write: `body`, flagged as a dry run, which answers 200 rather than `status`."
+  [body dry-run? status]
+  (if dry-run?
+    (http/json-response nil (assoc body :dry-run true))
+    (http/json-response nil body status)))
+
+(defn- handle-bulk [{:keys [^js self request ^js url conn db handler e2ee? creator]}]
+  (case handler
+    :semantic/blocks-get-many
+    (let [ids (parse-ids (.get (.-searchParams url) "ids"))
+          view (or (.get (.-searchParams url) "view") "summary")]
+      (cond
+        (nil? ids) (http/bad-request "ids must be a comma-separated list of UUIDs")
+        (> (count ids) max-batch-size) (http/bad-request (str "at most " max-batch-size " ids"))
+        (not (apply distinct? (map string/lower-case ids))) (http/bad-request "duplicate id")
+        (not (contains? #{"summary" "outline"} view)) (http/bad-request "view must be summary or outline")
+        (and e2ee? (= "outline" view)) (http/error-response "outlines are unavailable for E2EE graphs" 409)
+        :else (http/json-response nil (bulk-read-response db ids view))))
+
+    :semantic/blocks-delete-many
+    (p/let [body (body-clj request)]
+      (let [block-ids (:block-ids body)
+            blocks (when (sequential? block-ids) (mapv #(find-entity db %) block-ids))
+            dry-run? (dry-run-option body)]
+        (if-let [error (or (delete-blocks-error block-ids blocks)
+                           (when (= ::invalid dry-run?) "dry-run must be a boolean"))]
