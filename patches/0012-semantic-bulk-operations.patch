+            (is (= [200 {:deleted 3 :total-removed 5}] [(:status real) (:body real)]))
+            (is (every? #(nil? (entity conn %)) [a a1 a2 b c]))
+            (is (= ["D"] (titles-under conn page-id)))))))))
