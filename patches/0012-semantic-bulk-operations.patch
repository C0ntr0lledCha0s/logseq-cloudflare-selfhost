+(defn- reject! [message]
+  (throw (ex-info message {::rejected message})))
+
+(defn- rejecting
+  "Calls `write`, answering 400 when it is rejected: by `reject!`, or by the outliner refusing a change
+  with a user-facing notification (such as editing a built-in node). Other errors propagate."
+  [write]
+  (try
+    (write)
+    (catch :default error
+      (let [data (ex-data error)]
+        (if-let [message (or (::rejected data)
+                             (when (= :notification (:type data)) (get-in data [:payload :message])))]
+          (http/bad-request message)
+          (throw error))))))
