+;; Block tree nodes and batch insert entries may carry property values, as a JSON object keyed by
+;; property UUID, ident or title. They are resolved before anything is written.
+(defn- property-selector
+  "A `properties` object key as the client wrote it: JSON keys arrive keywordized."
+  [k]
+  (subs (str k) 1))
+
+(defn- prepare-properties
+  "Resolves a `properties` object to [[ident value] ...], or {:error reason} for the first key or
+  value that doesn't resolve."
+  [db properties e2ee?]
+  (if-not (and (map? properties) (seq properties))
+    {:error "properties must be a non-empty object"}
+    (reduce (fn [result [k value]]
+              (let [selector (property-selector k)
+                    property (some->> (resolve-property-ident db selector) (d/entity db))
+                    prepared (when (and (property? property) (some? value))
+                               (prepare-property-value db (:db/ident property) value e2ee?))]
+                (cond
+                  (not (property? property)) (reduced {:error (str "property not found: " selector)})
+                  (nil? value) (reduced {:error (str selector ": missing property value")})
+                  (:error prepared) (reduced {:error (str selector ": " (:error prepared))})
+                  :else (update result :properties conj [(:db/ident property) (:value prepared)]))))
+            {:properties []}
+            properties)))
+
+(defn- prepare-tree
+  "Resolves the properties of every node of identity-checked `nodes`, keeping them under
+  ::properties. Returns {:nodes nodes} or {:error reason} prefixed with the node's path."
+  [db nodes e2ee? path]
+  (reduce (fn [result [index node]]
+            (let [node-path (str path "[" index "]")
+                  properties (when (contains? node :properties)
+                               (prepare-properties db (:properties node) e2ee?))
+                  children (when (seq (:children node))
+                             (prepare-tree db (:children node) e2ee? (str node-path ".children")))]
+              (cond
+                (:error properties) (reduced {:error (str node-path ": " (:error properties))})
+                (:error children) (reduced children)
+                :else (update result :nodes conj
+                              (cond-> (dissoc node :properties)
+                                properties (assoc ::properties (:properties properties))
+                                children (assoc :children (:nodes children)))))))
+          {:nodes []}
+          (map-indexed vector nodes)))
+
+(defn- tree-block [conn e2ee? node]
+  (let [id (if-let [value (:uuid node)] (uuid (string/lower-case value)) (random-uuid))]
+    (if (d/entity @conn [:block/uuid id])
+      {:block/uuid id}
+      (assoc (prepare-block-title! conn e2ee? (:title node)) :block/uuid id))))
+
+(defn- insert-tree!
+  "Inserts prepared `nodes` under `target` and sets each new block's properties. A node whose uuid
+  already exists under its parent is reused as it is, title and properties included, so a retried
+  insert is safe."
+  [conn target nodes position e2ee?]
+  (let [nodes (vec nodes)
+        blocks (mapv #(tree-block conn e2ee? %) nodes)
+        fresh (filterv #(nil? (d/entity @conn [:block/uuid (:block/uuid %)])) blocks)
+        fresh-ids (set (map :block/uuid fresh))]
+    (when (seq fresh)
+      (outliner-core/insert-blocks! conn fresh target
+                                   {:sibling? false :top? (= position "prepend")
+                                     :bottom? (not= position "prepend") :keep-uuid? true}))
+    (mapv (fn [node block]
+            (when (contains? fresh-ids (:block/uuid block))
+              (doseq [[property-ident value] (::properties node)]
+                (set-prepared-property! conn (:db/id (d/entity @conn [:block/uuid (:block/uuid block)]))
+                                        property-ident value false)))
+            (let [existing (d/entity @conn [:block/uuid (:block/uuid block)])
+                  children (when (seq (:children node))
+                             (insert-tree! conn existing (:children node) "append" e2ee?))]
+              (cond-> {:uuid (str (:block/uuid existing)) :title (:block/title existing)}
+                (seq children) (assoc :children children))))
+          nodes blocks)))
+
+;; Write responses: `verbose=false` drops the titles a caller just sent, leaving the inserted tree's
+;; UUIDs (to address the blocks later) and a count.
+(defn- verbose-option [^js url]
+  (let [raw (.get (.-searchParams url) "verbose")]
+    (cond
+      (or (nil? raw) (= "true" raw)) true
+      (= "false" raw) false
+      :else ::invalid)))
+
+(defn- tree-count [nodes]
+  (reduce + (map #(inc (tree-count (:children %))) nodes)))
+
+(defn- tree-response [nodes verbose?]
+  (if verbose?
+    nodes
+    (mapv #(cond-> {:uuid (:uuid %)}
+             (:children %) (assoc :children (tree-response (:children %) false)))
+          nodes)))
+
+(defn- inserted-response [inserted verbose?]
+  {:blocks (tree-response inserted verbose?) :count (tree-count inserted)})
+
+(def ^:private max-batch-size 100)
