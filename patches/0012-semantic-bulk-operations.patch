+(defn- <encrypt [key value]
+  (p/let [iv (js/crypto.getRandomValues (js/Uint8Array. 12))
+          payload (.encrypt js/crypto.subtle #js {:name "AES-GCM" :iv iv} key
+                            (.encode (js/TextEncoder.) (ldb/write-transit-str value)))]
+    (ldb/write-transit-str [iv (js/Uint8Array. payload)])))
+
+(defn- <key []
+  (.generateKey js/crypto.subtle #js {:name "AES-GCM" :length 256} true #js ["encrypt" "decrypt"]))
+
+(deftest bulk-writes-on-encrypted-graphs-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self page-id]}]
+        (p/let [key (<key)
+                title (<encrypt key "Secret block")
+                path "/semantic/block-trees/batch?graph-e2ee=true"
+                plaintext (request! self "POST" path {:entries [{:target-id (str page-id) :blocks [{:title "Plain"}]}]})
+                page-title (request! self "POST" path {:entries [{:page "Plain page" :blocks [{:title title}]}]})
+                encrypted (request! self "POST" path {:entries [{:target-id (str page-id) :blocks [{:title title}]}]})
+                block-id (get-in encrypted [:body :entries 0 :blocks 0 :uuid])
+                _ (is (= title (:block/raw-title (entity conn block-id))))
+                deleted (request! self "DELETE" "/semantic/blocks?graph-e2ee=true" {:block-ids [block-id]})]
+          (is (= [400 "content must be an encrypted package on e2ee graphs"]
+                 [(:status plaintext) (get-in plaintext [:body :error])]))
+          (is (= [400 "entries[0]: page titles are unavailable for E2EE graphs; create the page and pass target-id"]
+                 [(:status page-title) (get-in page-title [:body :error])]))
+          (is (= 201 (:status encrypted)))
+          (is (= 200 (:status deleted)))
+          (is (nil? (entity conn block-id))))))))
+
+(defn- rate-limiter [calls]
+  #js {:limit (fn [opts]
+                (swap! calls conj (js->clj opts :keywordize-keys true))
+                (p/resolved #js {:success true}))})
+
+(deftest a-bulk-call-counts-as-one-write-test
+  (async done
+    (let [forwarded (atom [])
+          write-calls (atom [])
+          body (js/JSON.stringify (clj->js {:block-ids (mapv str (repeatedly 50 random-uuid))}))
+          request (js/Request. "http://localhost/api/v1/graphs/graph-1/blocks"
+                               #js {:method "DELETE"
+                                    :headers #js {"authorization" "Bearer semantic-token"
+                                                  "content-type" "application/json"}
+                                    :body body})
+          env #js {"DB" #js {}
+                   "LOGSEQ_SYNC_DO" #js {:idFromName (fn [graph-id] graph-id)
+                                         :get (fn [_]
+                                                #js {:fetch (fn [request]
+                                                              (swap! forwarded conj request)
+                                                              (p/resolved (js/Response. "{}" #js {:status 200})))})}
+                   "SEMANTIC_WRITE_RATE_LIMITER" (rate-limiter write-calls)}]
+      (-> (p/with-redefs [auth/auth-claims (fn [_ _] (p/resolved #js {"sub" "user-1" "scope" "logseq/write"}))
+                          index-handler/graph-access-response
+                          (fn [_ _ _] (p/resolved (js/Response. "{}" #js {:status 200})))
+                          common/<d1-all (fn [& _] (p/resolved #js {:results #js [#js {:graph_e2ee 0}]}))]
+            (p/let [response (dispatch/handle-worker-fetch request env)
+                    forwarded-request (first @forwarded)
+                    forwarded-body (.text forwarded-request)]
+              (is (= 200 (.-status response)))
+              (is (= 1 (count @write-calls)) "fifty blocks, one rate-limited write")
+              (is (string/includes? (:key (first @write-calls)) ":deleteBlocks:"))
+              (is (= "DELETE" (.-method forwarded-request)))
+              (is (= "/semantic/blocks" (.-pathname (js/URL. (.-url forwarded-request)))))
+              (is (= body forwarded-body) "the request body reaches the graph's Durable Object")))
+          (p/catch #(is false (str %)))
+          (p/finally done)))))
+
