+(ns logseq.db-sync.semantic-bulk-test
+  "Bulk reads, deletes, moves and inserts in the semantic API: each runs as one request (one
+  rate-limited write) and applies all of its changes or none."
+  (:require [cljs.test :refer [async deftest is]]
+            [clojure.string :as string]
+            [datascript.core :as d]
+            [logseq.db :as ldb]
+            [logseq.db-sync.common :as common]
+            [logseq.db-sync.test-sql :as test-sql]
+            [logseq.db-sync.worker.auth :as auth]
+            [logseq.db-sync.worker.dispatch :as dispatch]
+            [logseq.db-sync.worker.handler.index :as index-handler]
+            [logseq.db-sync.worker.handler.sync :as sync-handler]
+            [logseq.db.sqlite.export :as sqlite-export]
+            [logseq.outliner.property :as outliner-property]
+            [promesa.core :as p]))
+
+(defn- request!
+  "One semantic API request through the real handler; returns {:status :body}."
+  [self method path body]
+  (p/let [url (str "http://localhost" path (if (string/includes? path "?") "&" "?") "graph-id=graph-1")
+          response (sync-handler/handle-http
+                    self
+                    (js/Request. url (clj->js (cond-> {:method method
+                                                       :headers {"content-type" "application/json"}}
+                                                body (assoc :body (js/JSON.stringify (clj->js body)))))))
+          text (.text response)]
+    {:status (.-status response)
+     :body (when (seq text) (js->clj (js/JSON.parse text) :keywordize-keys true))}))
+
+(defn- with-graph
+  "A DB graph with a page `Bulk`, an `Organization` tag and a `Blurb` text property."
+  [done run]
+  (-> (p/let [conn (sqlite-export/create-conn)
+              page-id (random-uuid)
+              org-id (random-uuid)
+              _ (d/transact! conn [{:block/uuid page-id :block/name "bulk" :block/title "Bulk"
+                                    :block/tags :logseq.class/Page
+                                    :block/created-at 1 :block/updated-at 1}
+                                   {:db/ident :user.class/Organization :block/uuid org-id
+                                    :block/name "organization" :block/title "Organization"
+                                    :block/tags :logseq.class/Tag}])
+              description (outliner-property/upsert-property!
+                           conn nil {:logseq.property/type :default :db/cardinality :db.cardinality/one}
+                           {:property-name "Blurb"})
+              self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true}]
+        (run {:conn conn :self self :page-id page-id :org-id org-id :description description}))
+      (p/catch #(is false (str %)))
+      (p/finally done)))
+
+(defn- entity [conn id]
+  (d/entity @conn [:block/uuid (if (string? id) (uuid id) id)]))
+
+(defn- tag-ids [conn id]
+  (set (map :block/uuid (:block/tags (entity conn id)))))
+
+(defn- description-of [conn description id]
+  (:block/title (get (entity conn id) (:db/ident description))))
+
+(defn- titles-under [conn id]
+  (->> (:block/_parent (entity conn id))
+       (sort-by :block/order)
+       (mapv :block/title)))
+
+(defn- tree-keys
+  "Every key used anywhere in a response tree."
+  [nodes]
+  (set (mapcat (fn [node] (concat (keys node) (tree-keys (:children node)))) nodes)))
+
+(deftest get-blocks-reads-many-entities-in-one-call-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self page-id org-id]}]
+        (let [[a b c] (repeatedly 3 random-uuid)
+              missing (random-uuid)
+              ids-path (fn [& ids] (str "/semantic/blocks?ids=" (string/join "," ids)))]
+          (p/let [_ (request! self "POST" "/semantic/block-trees"
+                              {:target-id (str page-id)
+                               :blocks [{:uuid (str a) :title "Acme #Organization"
+                                         :properties {"Blurb" "Makes anvils"}
+                                         :children [{:uuid (str b) :title "Child"}]}
+                                        {:uuid (str c) :title "Other"}]})
+                  summary (request! self "GET" (ids-path c missing a page-id) nil)
+                  outline (request! self "GET" (str (ids-path a page-id) "&view=outline") nil)
+                  errors (p/all (map #(request! self "GET" % nil)
+                                     ["/semantic/blocks"
+                                      (ids-path "not-a-uuid")
+                                      (ids-path a (string/upper-case (str a)))
+                                      (apply ids-path (repeatedly 101 random-uuid))
+                                      (str (ids-path a) "&view=tree")]))
+                  e2ee-outline (request! self "GET" (str (ids-path a) "&view=outline&graph-e2ee=true") nil)]
+            (is (= 200 (:status summary)))
+            (is (= (mapv str [c a page-id]) (mapv :uuid (get-in summary [:body :blocks])))
+                "found entities come back in request order")
+            (is (= [(str missing)] (get-in summary [:body :missing])))
+            (let [[other acme page] (get-in summary [:body :blocks])]
+              (is (= "Other" (:title other)))
+              (is (= [(str org-id)] (mapv :uuid (:tags acme))))
+              (is (= ["Makes anvils"] (mapv :value (:properties acme))))
+              (is (= "page" (:kind page)))
+              (is (not-any? :children [other acme page]) "the summary view loads no block trees")
+              (is (not-any? :markdown [other acme page])))
+            (is (= 200 (:status outline)))
+            (let [[acme page] (get-in outline [:body :blocks])]
+              (is (= "- Child" (:markdown acme)))
+              (is (= 1 (:block-count acme)))
+              (is (false? (:truncated acme)))
+              (is (string/includes? (:markdown page) "  - Child"))
+              (is (string/includes? (:markdown page) "- Other")))
+            (is (= [400 400 400 400 400] (mapv :status errors)))
+            (is (= ["ids must be a comma-separated list of UUIDs"
+                    "ids must be a comma-separated list of UUIDs"
+                    "duplicate id"
+                    "at most 100 ids"
+                    "view must be summary or outline"]
+                   (mapv #(get-in % [:body :error]) errors)))
+            (is (= 409 (:status e2ee-outline)) "outlines need plaintext titles")
+            (is (some? (entity conn b)))))))))
+
+(deftest batch-set-tags-ten-pages-in-one-call-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self org-id]}]
+        (let [page-ids (vec (repeatedly 10 random-uuid))
+              _ (d/transact! conn (map-indexed (fn [index id]
+                                                 {:block/uuid id :block/name (str "person " index)
+                                                  :block/title (str "Person " index)
+                                                  :block/tags :logseq.class/Page
+                                                  :block/created-at 1 :block/updated-at 1})
+                                               page-ids))]
+          (p/let [response (request! self "POST" "/semantic/block-properties/batch-set"
+                                     {:entries (mapv (fn [id] {:block-id (str id) :property-id "Tags"
+                                                               :value "Organization"})
+                                                     page-ids)})]
+            (is (= 200 (:status response)))
+            (is (= {:updated 10} (:body response)))
+            (is (every? #(contains? (tag-ids conn %) org-id) page-ids))))))))
+
+(deftest insert-block-tree-sets-properties-on-new-blocks-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self page-id org-id description]}]
+        (let [[person note good bad] (repeatedly 4 random-uuid)
+              ident (subs (str (:db/ident description)) 1)]
+          (p/let [response (request! self "POST" "/semantic/block-trees"
+                                     {:target-id (str page-id)
+                                      :blocks [{:uuid (str person) :title "Jane Doe"
+                                                :properties {"Tags" ["Organization"] "Blurb" "Engineer"}
+                                                :children [{:uuid (str note) :title "Met at a conference"
+                                                            :properties {ident "First contact"}}]}]})
+                  _ (is (= 201 (:status response)))
+                  _ (is (= #{org-id} (tag-ids conn person)))
+                  _ (is (= "Engineer" (description-of conn description person)))
+                  _ (is (= "First contact" (description-of conn description note)) "a property ident works as the key")
+                  rejected (request! self "POST" "/semantic/block-trees"
+                                     {:target-id (str page-id)
+                                      :blocks [{:uuid (str good) :title "Good" :properties {"Blurb" "fine"}}
+                                               {:uuid (str bad) :title "Bad"
+                                                :children [{:title "Nested" :properties {"No Such Property" 1}}]}]})
+                  bad-value (request! self "POST" "/semantic/block-trees"
+                                      {:target-id (str page-id)
+                                       :blocks [{:uuid (str good) :title "Good" :properties {"Tags" "No Such Tag"}}]})
+                  replay (request! self "POST" "/semantic/block-trees"
+                                   {:target-id (str page-id)
+                                    :blocks [{:uuid (str person) :title "Jane Doe"
+                                              :properties {"Blurb" "Changed on replay"}}]})]
+            (is (= [400 "blocks[1].children[0]: property not found: No Such Property"]
+                   [(:status rejected) (get-in rejected [:body :error])]))
+            (is (= 400 (:status bad-value)))
+            (is (string/starts-with? (get-in bad-value [:body :error]) "blocks[0]: Tags: property value must resolve"))
+            (is (nil? (entity conn good)) "a rejected tree writes none of its blocks")
+            (is (= 201 (:status replay)))
+            (is (= "Engineer" (description-of conn description person))
+                "a block reused on replay keeps its properties, as it keeps its title")))))))
+
+(deftest write-responses-can-be-reduced-to-uuids-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self page-id]}]
+        (let [tree {:target-id (str page-id)
+                    :blocks [{:title "Parent" :children [{:title "Child"}]} {:title "Sibling"}]}]
+          (p/let [full (request! self "POST" "/semantic/block-trees" tree)
+                  compact (request! self "POST" "/semantic/block-trees?verbose=false" tree)
+                  children (request! self "POST" (str "/semantic/blocks/" page-id "/children?verbose=false")
+                                     {:position "append" :blocks [{:title "One"} {:title "Two"}]})
+                  capture (request! self "POST" "/semantic/capture?verbose=false" {:blocks [{:title "Captured"}]})
+                  invalid (request! self "POST" "/semantic/block-trees?verbose=no" tree)]
+            (is (= 201 (:status full)))
+            (is (= 3 (get-in full [:body :count])))
+            (is (= ["Parent" "Sibling"] (mapv :title (get-in full [:body :blocks]))) "verbose is the default")
+            (is (= 201 (:status compact)))
+            (is (= 3 (get-in compact [:body :count])))
+            (is (= #{:uuid :children} (tree-keys (get-in compact [:body :blocks]))))
+            (is (= "Child" (:block/title (entity conn (get-in compact [:body :blocks 0 :children 0 :uuid])))))
+            (is (= [201 2 #{:uuid}] [(:status children) (get-in children [:body :count])
+                                     (tree-keys (get-in children [:body :blocks]))]))
+            (is (= 201 (:status capture)))
+            (is (= #{:page-id :blocks :count} (set (keys (:body capture)))))
+            (is (= #{:uuid} (tree-keys (get-in capture [:body :blocks]))))
+            (is (= [400 "verbose must be true or false"] [(:status invalid) (get-in invalid [:body :error])]))))))))
+
+(deftest batch-insert-builds-several-org-pages-in-one-call-test
