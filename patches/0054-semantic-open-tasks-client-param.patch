+            (is (= [] (pairs-of tag-r))))
+          (testing "a public tag and a private page: the tag is the only candidate, and the page is never named"
+            (is (= {:title "zq Decoy" :uuid (str decoy-tag)} (get-in decoy-r [:body :params :client])))
+            (is (= [["zq Decoy" "zq task no client"]] (pairs-of decoy-r)))
+            (is (not (string/includes? (:text decoy-r) (str decoy-page)))))
+          (testing "an exact title on a block is the only tier; the case-only page is not considered"
+            (is (= {:title "zq Exacto" :uuid (str exact-block)} (get-in exact-r [:body :params :client]))))
+          (testing "a journal and a block: the journal is a page, and wins"
