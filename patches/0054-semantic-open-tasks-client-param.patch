+(def ^:private acme-uuid #uuid "8d3c1a52-0b6f-4e1d-9a71-5c2e7f0a1b01")
+(def ^:private beta-uuid #uuid "8d3c1a52-0b6f-4e1d-9a71-5c2e7f0a1b02")
+(def ^:private acme-work-uuid #uuid "8d3c1a52-0b6f-4e1d-9a71-5c2e7f0a1b03")
+(def ^:private other-uuid #uuid "8d3c1a52-0b6f-4e1d-9a71-5c2e7f0a1b04")
