+(deftest named-client-advice-test
+  ;; Spec §3.4 (without a client), review focus 15: each of the three bounds, reached without a
+  ;; client, advises params.client for every client_property kind that can take a client (node and
+  ;; date; the default forClient is node), and keeps the datalog_query advice for a default or url
+  ;; property, where a client is refused. No rows come back with any 422.
+  (async done
+    (with-named done
+      (fn [{:keys [conn self]}]
+        (p/let [_ (p/all (map (fn [[t ty]] (ok! (request! self "POST" "/semantic/properties" {:title t :type ty}) 201))
+                              [["zq advice text" "default"] ["zq advice url" "url"] ["zq advice date" "date"]]))
+                before (snapshot conn)
+                runs (reduce
+                      (fn [acc [prop text?]]
+                        (reduce (fn [acc bound]
+                                  (p/let [acc acc
+                                          _ (set-bounds! self {bound 0})
+                                          r (named! self "open-tasks-by-client" {:params {:client_property prop}})
+                                          _ (set-bounds! self nil)]
+                                    (conj acc [prop text? bound r])))
+                                acc [:tasks :open-tasks :reads]))
+                      (p/resolved [])
+                      [["forClient" false] ["zq advice date" false] ["zq advice text" true] ["zq advice url" true]])
+                _ (set-bounds! self {:open-tasks 0})
+                default-run (named! self "open-tasks-by-client" {})
+                _ (set-bounds! self nil)
+                after (snapshot conn)]
+          (doseq [[prop text? bound r] runs]
+            (testing (str prop ", its " (name bound) " bound")
+              (is (= [422 (no-client-message bound text?)] (answer-of r)) (head-of r))
+              (is (nil? (get-in r [:body :rows])) "no rows")))
+          (testing "client_property left to its default (forClient, a node property)"
+            (is (= [422 (no-client-message :open-tasks false)] (answer-of default-run)) (head-of default-run)))
+          (is (= before after) "read-only"))))))
