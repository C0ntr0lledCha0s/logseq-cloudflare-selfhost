+;; Patch 0054, stage 2: the walk from the client
+;; =============================================
+;; With params.client, open-tasks-by-client reads the client's holders (AVET on client_property)
+;; and the blocks on each holder that is a page, each charged once to :tasks, instead of every Task;
+;; it keeps the open, non-private Task candidates whose own clients, else their page's, include the
+;; client. Its 422s and plan say what they counted.
+
+(defn- walk-candidates
+  "What the client walk should reach for client `c` (an eid) through `prop` (an ident), read with
+  Datalog on the raw db: the entities holding c, and the blocks on each holder that is a page."
+  [db prop c]
+  (let [holders (set (d/q '[:find [?h ...] :in $ ?prop ?c :where [?h ?prop ?c]] db prop c))
+        pages (filterv #(nil? (:block/page (d/entity db %))) holders)
+        on-pages (if (seq pages)
+                   (set (d/q '[:find [?b ...] :in $ [?p ...] :where [?b :block/page ?p]] db pages))
+                   #{})]
+    (into holders on-pages)))
+
+(defn- eid-titled [conn title] (:db/id (d/entity @conn [:block/uuid (uuid (uuid-titled conn title))])))
+
+(defn- open-task [title] {:title title :properties {"block/tags" ["Task"] "logseq.property/status" "Todo"}})
+
+(defn- seed-client-walk
+  "60 open tasks across three clients, written through the real handler: a node property forClient;
+  client pages zq Acme, zq Beta and zq Gamma; pages zq Acme Work, zq Beta Work and zq Gamma Work,
+  each holding its client. zq Acme Work has 4 tasks with no client of their own and 2 notes; zq
+  Beta Work has zq acme held task (its own client zq Acme) and 30 tasks; zq Gamma Work has 25.
+  zq Acme's candidates: zq Acme Work, its 6 blocks and zq acme held task (8), 5 of them its tasks."
+  []
+  (p/let [conn (sqlite-export/create-conn)
+          self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true}
+          prop (ok! (request! self "POST" "/semantic/properties" {:title "forClient" :type "node"}) 201)
+          for-client (get-in prop [:body :ident])
+          _ (page-id! self "zq Acme")
+          _ (page-id! self "zq Beta")
+          _ (page-id! self "zq Gamma")
+          acme-work (page-id! self "zq Acme Work")
+          beta-work (page-id! self "zq Beta Work")
+          gamma-work (page-id! self "zq Gamma Work")
+          _ (for-client! self for-client acme-work "zq Acme")
+          _ (for-client! self for-client beta-work "zq Beta")
+          _ (for-client! self for-client gamma-work "zq Gamma")
+          _ (insert! self acme-work (into (mapv #(open-task (str "zq acme task " %)) (range 4))
+                                          [{:title "zq acme note 0"} {:title "zq acme note 1"}]))
+          [held] (insert! self beta-work [(open-task "zq acme held task")])
+          _ (for-client! self for-client (:uuid held) "zq Acme")
+          _ (insert! self beta-work (mapv #(open-task (str "zq beta task " %)) (range 30)))
+          _ (insert! self gamma-work (mapv #(open-task (str "zq gamma task " %)) (range 25)))]
+    {:conn conn :self self :for-client for-client}))
+
+(defn- with-client-walk [done run]
+  (-> (p/let [graph (seed-client-walk)] (run graph))
+      (p/catch #(is false (str % "\n" (.-stack %))))
+      (p/finally done)))
+
+(def ^:private acme-rows
+  #{["zq Acme" "zq acme held task"] ["zq Acme" "zq acme task 0"] ["zq Acme" "zq acme task 1"]
+    ["zq Acme" "zq acme task 2"] ["zq Acme" "zq acme task 3"]})
+
+(deftest named-client-walk-test
+  ;; Spec §8 test 3 (with-client half): with the tasks bound lowered below the Task count, the full
+  ;; run stops at it and a client run answers, its tasks bound counting the client's candidates.
+  (async done
+    (with-client-walk done
+      (fn [{:keys [conn self for-client]}]
+        (p/let [_ (set-bounds! self {:tasks 50})
+                full (client-run! self {})
+                acme (client-run! self {:client "zq Acme"})
+                beta (client-run! self {:client "zq Beta"})
+                gamma (client-run! self {:client "zq Gamma"})
+                _ (set-bounds! self nil)
+                prop (keyword for-client)
+                count-of #(count (walk-candidates @conn prop (eid-titled conn %)))]
+          (is (= 60 (count (d/datoms @conn :avet :block/tags (d/entid @conn :logseq.class/Task)))))
+          (is (= [422 "open-tasks-by-client stopped after 50 blocks tagged Task (its tasks bound); give a client (params.client)"]
+                 (answer-of full))
+              (head-of full))
+          (is (= [200 200 200] (map :status [acme beta gamma])) (pr-str (map head-of [acme beta gamma])))
+          (testing "zq Acme: its own and its page's tasks, counted by its candidates"
+            (is (= acme-rows (set (pairs-of acme))) (pr-str (:body acme)))
+            (is (= 5 (count (pairs-of acme))))
+            (is (= {:tasks 8 :open-tasks 5} (select-keys (get-in acme [:body :work]) [:tasks :open-tasks])))
+            (is (= 8 (count-of "zq Acme"))))
+          (testing "zq Beta: the tasks on its page, not the one whose own client is zq Acme"
+            (is (= 30 (count (pairs-of beta))))
+            (is (not (contains? (set (map second (pairs-of beta))) "zq acme held task")))
+            (is (= {:tasks 32 :open-tasks 30} (select-keys (get-in beta [:body :work]) [:tasks :open-tasks]))
+                "zq acme held task, open on zq Beta's page but zq Acme's, is a candidate, not an open task of zq Beta")
+            (is (= 32 (count-of "zq Beta"))))
+          (testing "zq Gamma"
+            (is (= 25 (count (pairs-of gamma))))
+            (is (= 26 (get-in gamma [:body :work :tasks])))))))))
+
+(deftest named-client-open-tasks-bound-counts-the-clients-tasks-test
+  ;; Review r2-correctness-1: with a client, :open-tasks counts only the open tasks found to be the
+  ;; client's (own client, else the page's), so its 422 ("open tasks of <client>") is true. zq Beta
+  ;; has 30 rows and 31 open Task candidates (zq acme held task, on its page, is zq Acme's).
+  (async done
+    (with-client-walk done
+      (fn [{:keys [self]}]
+        (p/let [_ (set-bounds! self {:open-tasks 30})
+                at (client-run! self {:client "zq Beta"})
+                _ (set-bounds! self {:open-tasks 29})
+                over (client-run! self {:client "zq Beta"})
+                _ (set-bounds! self nil)]
+          (is (= 200 (:status at)) (head-of at))
+          (is (= 30 (count (pairs-of at))))
+          (is (= 30 (get-in at [:body :work :open-tasks])))
+          (is (= [422 (client-walk-message :open-tasks "zq Beta" 29)] (answer-of over)) (head-of over)))))))
+
+(deftest named-client-open-tasks-skips-other-clients-on-its-pages-test
+  ;; Review r2-correctness-1, the converse: open tasks whose own client is another one, on the given
+  ;; client's page, are candidates (:tasks) but not counted toward :open-tasks, whichever client
+  ;; they hold; a task on the page with no client of its own is the page's, and counted.
+  (async done
+    (with-client-walk done
+      (fn [{:keys [conn self for-client]}]
+        (p/let [gamma-work (uuid-titled conn "zq Gamma Work")
+                others (insert! self gamma-work (mapv #(open-task (str "zq gamma decoy " %)) (range 6)))
+                _ (reduce (fn [acc [i {:keys [uuid]}]]
+                            (p/let [_ acc] (for-client! self for-client uuid (if (even? i) "zq Acme" "zq Beta"))))
+                          (p/resolved nil) (map-indexed vector others))
+                free (client-run! self {:client "zq Gamma"})
+                _ (set-bounds! self {:open-tasks 25})
+                at (client-run! self {:client "zq Gamma"})
+                _ (set-bounds! self nil)]
+          (is (= [200 200] (map :status [free at])) (pr-str (map head-of [free at])))
+          (is (= 25 (count (pairs-of at))))
+          (is (not-any? #(string/starts-with? (second %) "zq gamma decoy") (pairs-of at)))
+          (is (= {:tasks 32 :open-tasks 25} (select-keys (get-in free [:body :work]) [:tasks :open-tasks]))
+              (pr-str (get-in free [:body :work]))))))))
+
+(defn- client-walk-message [bound title n]
+  ;; :tasks counts candidates, open or not, so marking tasks Done can't clear it; :open-tasks and
+  ;; :reads can be.
+  (let [advice (if (= :tasks bound)
+                 "list one of its pages' tasks with datalog_query"
+                 (str "mark " title "'s finished tasks Done or Canceled, or list one of its pages' tasks with datalog_query"))]
+    (str "open-tasks-by-client "
+         (case bound
+           :tasks (str "stopped after " (format-n n) " blocks holding " title " or on its pages (its tasks bound)")
+           :open-tasks (str "found more than " (format-n n) " open tasks of " title " (its open-tasks bound)")
+           :reads (str "stopped after " (format-n n) " reads (its reads bound, the backstop over every read)"))
+         "; " advice)))
+
+(deftest named-client-bounds-test
+  ;; Spec §8 test 3 (client half), review focus 13: each bound with a client, set to exactly what the
+  ;; run counts, answers the same rows; one lower answers the client-worded 422, last-run shows the
+  ;; bound + 1, and no rows come back. A client with no title is named by its UUID.
+  (async done
+    (with-client-walk done
+      (fn [{:keys [conn self for-client]}]
+        (p/let [untitled (page-id! self "zq Untitled")
+                [t] (insert! self (uuid-titled conn "zq Gamma Work") [(open-task "zq untitled task")])
+                _ (for-client! self for-client (:uuid t) (str untitled))
+                _ (d/transact! conn [[:db.fn/retractAttribute [:block/uuid untitled] :block/title]])
+                cases [["zq Acme" "zq Acme"] [(str untitled) (str untitled)]]]
+          (-> (reduce
+               (fn [acc [client named]]
+                 (reduce
+                  (fn [acc bound]
+                    (p/let [_ acc
+                            _ (set-bounds! self nil)
+                            free (client-run! self {:client client})
+                            counted (get-in @datalog/last-run [:named-work bound])
+                            _ (set-bounds! self {bound counted})
+                            at (client-run! self {:client client})
+                            _ (set-bounds! self {bound (dec counted)})
+                            before (snapshot conn)
+                            over (client-run! self {:client client})
+                            over-work (get-in @datalog/last-run [:named-work bound])
+                            _ (set-bounds! self nil)]
+                      (testing (str client ", its " (name bound) " bound")
+                        (is (= 200 (:status free)) (head-of free))
+                        (is (pos-int? counted) (pr-str (:named-work @datalog/last-run)))
+                        (is (= [200 (get-in free [:body :rows])] [(:status at) (get-in at [:body :rows])]) (str "at the bound: " (head-of at)))
+                        (is (= [422 (client-walk-message bound named (dec counted))] (answer-of over)) (head-of over))
+                        (is (= counted over-work) "work shows the bound + 1")
+                        (is (not (contains? (:body over) :rows)) "no rows found so far")
+                        (is (= before (snapshot conn))))))
+                  acc [:tasks :open-tasks :reads]))
+               (p/resolved nil) cases)
+              (p/finally #(set-bounds! self nil))))))))
