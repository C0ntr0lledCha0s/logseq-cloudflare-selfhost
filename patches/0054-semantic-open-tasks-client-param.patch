+(deftest named-client-dry-run-plan-test
+  ;; Spec §8 test 4 (plan half): the plan names the client and what each bound counts, with its
+  ;; number; a dry run reads nothing, so a bound set to 0 doesn't stop it. A run's plan is the same.
+  (async done
+    (with-named done
+      (fn [{:keys [self]}]
+        (let [plan (fn [tasks]
+                     (str "1. Read the blocks and pages whose forClient is zq Acme, and the blocks on each such page,"
+                          " each counted (tasks bound " tasks ")."
+                          " 2. Keep those tagged Task whose status isn't Done or Canceled and that aren't private."
+                          " 3. Keep each whose own forClient values, else its page's, include zq Acme, each counted (open-tasks bound 2,000)."
+                          " 4. One row per task."
+                          " Every read counts (reads bound 30,000); a bound passed answers 422 naming it, never part of the rows."))]
+          (p/let [dry (client-run! self {:client "zq Acme"} {:dry-run true})
+                  dry-work (:named-work @datalog/last-run)
+                  run (client-run! self {:client "zq Acme"})
+                  _ (set-bounds! self {:tasks 0})
+                  zero (client-run! self {:client "zq Acme"} {:dry-run true})
+                  zero-work (:named-work @datalog/last-run)
+                  zero-run (client-run! self {:client "zq Acme"})
+                  _ (set-bounds! self nil)
+                  none (client-run! self {} {:dry-run true})]
+            (is (= [200 200 200 422] (map :status [dry run zero zero-run])) (pr-str (map head-of [dry run zero zero-run])))
+            (is (= (plan "10,000") (get-in dry [:body :plan])))
+            (is (= (plan "10,000") (get-in run [:body :plan])))
+            (is (= (plan "0") (get-in zero [:body :plan])))
+            (is (= [{} {}] [dry-work zero-work]) "a dry run reads nothing")
+            (is (not-any? #(contains? (:body %) :work) [dry zero]))
+            (testing "without a client, the plan reads every Task"
+              (is (string/starts-with? (get-in none [:body :plan]) "1. Read the blocks tagged Task, each counted (tasks bound 10,000).")))))))))
