+(defn- client-candidates
+  "The visible entities `value` names as a client title: those titled exactly `value`, else the
+  pages and tags whose name is its lower case (the lookup order title-candidates uses), oldest
+  first. A property's choice or value block is never one, nor is a hidden, private or recycled
+  entity (`private?`, as the walk judges it), so a private title is never named."
+  [db value private?]
+  (let [visible (fn [datoms]
+                  (->> datoms
+                       (map #(d/entity db (:e %)))
+                       (remove :block/closed-value-property)
+                       (remove :logseq.property/created-from-property)
+                       (remove entity-util/hidden?)
+                       (remove #(private? (:db/id %)))
+                       (sort-by :db/id)))
+        exact (visible (d/datoms db :avet :block/title value))]
+    (if (seq exact) exact (visible (d/datoms db :avet :block/name (string/lower-case value))))))
+
+(defn- client-kind [e]
+  (cond (entity-util/class? e) "tag"
+        (entity-util/property? e) "property"
+        (or (entity-util/internal-page? e) (entity-util/journal? e)) "page"
+        :else "block"))
+
+(defn- resolve-client-param
+  "A :client param's value (patch 0054): the db id of the one visible entity `value` names, by UUID
+  (any case) or by title (client-candidates), echoed as {:title :uuid}. Several candidates resolve
+  only when exactly one is a page, which wins; otherwise each is named with its kind and UUID,
+  oldest first. Refused, naming params.<name>: a value that isn't a non-empty string (null
+  included), a client_property (`of`, its resolution) that is a default or url property, whose
+  values are per-block text, an unknown, hidden, private or recycled UUID, and a title with no
+  candidate. When client_property itself didn't resolve, its own error names it."
+  [db private? of {param-name :name} value]
+  (let [field (str "params." param-name)
+        found (fn [e] {:input (:db/id e) :echo {:title (or (:block/title e) "") :uuid (str (:block/uuid e))}})
+        of-type (get-in of [:echo :type])]
+    (cond
+      (or (not (string? value)) (= "" value))
+      {:error (str field ": must be a client title or UUID (a string)")}
+
+      (nil? (:input of)) {}
+
+      (contains? #{"default" "url"} of-type)
+      {:error (str field ": " (get-in of [:echo :title]) " is a " of-type " property, whose values are per-block text;"
+                   " give client_property as a node or date property, or list one client's tasks with datalog_query")}
+
+      (common-util/uuid-string? value)
+      (let [e (d/entity db [:block/uuid (uuid (string/lower-case value))])]
+        (if (and e (not (entity-util/hidden? e)) (not (private? (:db/id e))))
+          (found e)
+          {:error (str field ": no client with UUID " value)}))
+
+      :else
+      (let [candidates (client-candidates db value private?)
+            pages (filter #(= "page" (client-kind %)) candidates)]
+        (cond
+          (empty? candidates) {:error (str field ": no page, tag or block titled " (pr-str value))}
+          (empty? (next candidates)) (found (first candidates))
+          (= 1 (count pages)) (found (first pages))
+          :else {:error (str field ": " (pr-str value) " matches " (count candidates) " entities ("
+                             (string/join ", " (map #(str (:block/title %) ": " (client-kind %) " " (:block/uuid %)) candidates))
+                             "); give the one you mean by UUID")})))))
