+(deftest named-client-private-candidates-test
+  ;; The walk reaches private candidates (it reads every holder and every block on a holder page),
+  ;; and must leave them out as the full run does: a task tagged Private holding the client or on
+  ;; the client's page, a task under a private block on the client's page, a task on a private page
+  ;; that holds the client, and a task on a page in the Recycle bin that holds it. Found by the
+  ;; stage 2 mutation step (dropping private? on candidates survived every other test).
+  (async done
+    (with-named done
+      (fn [{:keys [conn self other-work for-client]}]
+        (p/let [client-work (uuid-titled conn "zq Client Work")
+                private-task (fn [title] {:title title :properties {"block/tags" ["Task" "Private"] "logseq.property/status" "Todo"}})
+                [own-private] (insert! self other-work [(private-task "zq rfp own private")])
+                _ (for-client! self for-client (:uuid own-private) "zq Acme")
+                _ (insert! self client-work [(private-task "zq rfp page private")
+                                             {:title "zq rfp hidden" :properties {"block/tags" ["Private"]}
+                                              :children [(open-task "zq rfp under hidden")]}])
+                secret (page-id! self "zq rfp secret page")
+                _ (for-client! self for-client secret "zq Acme")
+                _ (insert! self secret [(open-task "zq rfp on secret")])
+                _ (set-tags! self secret ["Private"])
+                gone (page-id! self "zq rfp gone page")
+                _ (for-client! self for-client gone "zq Acme")
+                _ (insert! self gone [(open-task "zq rfp on gone")])
+                _ (ok! (request! self "DELETE" (str "/semantic/pages/" gone) nil) 200)
+                acme (client-run! self {:client "zq Acme"})
+                full (client-run! self {})]
+          (is (= [200 200] (map :status [acme full])) (pr-str (map head-of [acme full])))
+          (is (= [["zq Acme" "zq task page client"]] (pairs-of acme)) (pr-str (:body acme)))
+          (is (= (pairs-of acme) (filterv #(= "zq Acme" (first %)) (pairs-of full))))
+          (is (not (string/includes? (:text acme) "zq rfp")) "no private candidate is named")
+          (is (= (count (walk-candidates @conn (keyword for-client) (eid-titled conn "zq Acme")))
+                 (get-in acme [:body :work :tasks]))
+              "every candidate is counted, private ones included")
+          (is (= 1 (get-in acme [:body :work :open-tasks]))
+              "only its one visible open task is counted: zq task own client, open on its page but zq Beta's, is not"))))))
