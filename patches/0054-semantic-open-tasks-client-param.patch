+(deftest uploaded-graph-client-walk-test
+  ;; Spec §8 test 5 and §7 risk 1: on a graph uploaded in the app's shape, with forClient made as the
+  ;; app makes it, the AVET read of a client's holders finds what the AEVT scan finds, and the client
+  ;; run walks from them: Acme's rows, counted by its candidates (Acme Work, its 3 blocks, the 2
+  ;; tasks on Other holding Acme), not by the 7 Task blocks.
+  (let [ident (volatile! nil)]
+    (async done
+      (with-uploaded done
+        (fn [{:keys [conn self]}]
+          (p/let [db @conn
