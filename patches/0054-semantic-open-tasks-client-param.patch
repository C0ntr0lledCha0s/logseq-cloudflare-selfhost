+(def ^:private client-advice "give a client (params.client), or mark finished tasks Done or Canceled")
+
+(defn- no-client-message
+  "open-tasks-by-client's 422 without a client at `bound` 0: with a client_property that can take a
+  client (`text?` false) the advice is to give one; with a text one (default or url), whose values
+  are per-block text, it stays the datalog_query advice."
+  [bound text?]
+  (str "open-tasks-by-client "
+       (case bound
+         :tasks "stopped after 0 blocks tagged Task (its tasks bound)"
+         :open-tasks "found more than 0 open tasks (its open-tasks bound)"
+         :reads "stopped after 0 reads (its reads bound, the backstop over every read)")
+       "; "
+       (cond
+         text? (case bound
+                 :open-tasks "mark finished tasks Done or Canceled, or list one client's tasks with datalog_query"
+                 "list one client's tasks with datalog_query")
+         ;; :tasks counts every Task block, finished ones too, so only a client narrows it.
+         (= :tasks bound) "give a client (params.client)"
+         :else client-advice)))
