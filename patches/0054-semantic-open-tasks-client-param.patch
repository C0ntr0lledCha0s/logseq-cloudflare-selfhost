+;; Patch 0054: open-tasks-by-client's client param
+;; ===============================================
+;; params.client is a client's title or UUID. It resolves to one visible entity (a page wins when
+;; exactly one candidate is a page) or answers 400 naming params.client, and the run keeps only the
+;; rows of that entity. The API refuses a second page or tag with a title already in use (409) and
+;; a case-only copy of a page's title, so the fixtures that share a title are made by retitling an
+;; entity the API wrote with d/transact!, the way a graph synced from the app can hold them.
+
+(defn- client-run!
+  "open-tasks-by-client with `params` (limit 200) and any other body fields in `more`."
+  ([self params] (client-run! self params nil))
+  ([self params more] (named! self "open-tasks-by-client" (merge {:params params :limit 200} more))))
+
+(defn- pairs-of [response] (mapv (fn [[c t]] [c (:block/title t)]) (get-in response [:body :rows])))
+
+(defn- uuid-titled
+  "The uuid (a string) of the one entity titled `title`."
+  [conn title]
+  (let [found (d/q '[:find [?u ...] :in $ ?t :where [?e :block/title ?t] [?e :block/uuid ?u]] @conn title)]
+    (assert (= 1 (count found)) (str title ": " (pr-str found)))
+    (str (first found))))
+
+(defn- retitle!
+  "Fixture: gives the entity `id` the title `title` (and a page or tag the lower-case name)."
+  [conn id title]
+  (let [e (d/entity @conn [:block/uuid (uuid (str id))])]
+    (d/transact! conn [(cond-> {:db/id (:db/id e) :block/title title}
+                         (:block/name e) (assoc :block/name (string/lower-case title)))])))
+
+(defn- tag-id! [self title]
+  (p/let [r (ok! (request! self "POST" "/semantic/tags" {:title title}) 201)] (uuid-of r)))
+
+(defn- block-id! [self page title]
+  (p/let [[b] (insert! self page [{:title title}])] (:uuid b)))
+
+(defn- for-client!
+  "Sets forClient (the seed-named node property) of `id` to `value`."
+  [self for-client id value]
+  (ok! (request! self "PUT" (str "/semantic/blocks/" id "/properties/" (js/encodeURIComponent for-client)) {:value value}) 200))
+
+(defn- client-message [title kinds]
+  (str "params.client: " (pr-str title) " matches " (count kinds) " entities ("
+       (string/join ", " (map (fn [[t kind id]] (str t ": " kind " " id)) kinds))
+       "); give the one you mean by UUID"))
+
+(defn- refused-exactly?
+  "A 400 whose error is exactly `message`, with no rows."
+  [response message]
+  (and (= 400 (:status response)) (= message (get-in response [:body :error]))
+       (not (contains? (:body response) :rows))))
+
+(deftest named-client-narrowing-test
+  ;; Spec §8 test 1: with a client, only that client's open tasks come back; a task whose own client
+  ;; is zq Beta, on zq Acme's page, is zq Beta's alone. A client resolves by exact title, else by page
+  ;; name ignoring case, and by UUID in either case.
+  (async done
+    (with-named done
+      (fn [{:keys [conn self]}]
+        (p/let [beta (uuid-titled conn "zq Beta")
+                acme (client-run! self {:client "zq Acme"})
+                beta-title (client-run! self {:client "zq Beta"})
+                beta-uuid (client-run! self {:client beta})
+                beta-upper (client-run! self {:client (string/upper-case beta)})
+                by-name (client-run! self {:client "ZQ ACME"})
+                full (client-run! self {})]
+          (is (= [200 200 200 200 200 200] (map :status [acme beta-title beta-uuid beta-upper by-name full]))
+              (pr-str (map head-of [acme beta-title beta-uuid beta-upper by-name])))
+          (testing "zq Acme's rows are the task on its page that has no client of its own"
+            (is (= [["zq Acme" "zq task page client"]] (pairs-of acme)) (pr-str (:body acme))))
+          (testing "zq Beta by title, by UUID and by an upper-case UUID: its own task only"
+            (doseq [r [beta-title beta-uuid beta-upper]]
+              (is (= [["zq Beta" "zq task own client"]] (pairs-of r)) (pr-str (:body r)))))
+          (testing "a title in another case finds the page by name"
+            (is (= (pairs-of acme) (pairs-of by-name))))
+          (testing "each client's rows are the full run's rows of that client"
+            (is (= (pairs-of acme) (filterv #(= "zq Acme" (first %)) (pairs-of full))))
+            (is (= (pairs-of beta-title) (filterv #(= "zq Beta" (first %)) (pairs-of full))))))))))
+
+(deftest named-client-property-kinds-sweep-test
+  ;; Class sweep over client_property: a node property (forClient, above), a many node property and
+  ;; a date property resolve the client and filter to it; a default or url property is refused
+  ;; (named-client-refusals-test). A date property's clients are journal pages, named by title or UUID.
+  (async done
+    (with-named done
+      (fn [{:keys [conn self other-work]}]
+        (p/let [date-prop (ok! (request! self "POST" "/semantic/properties" {:title "zq client date" :type "date"}) 201)
+                many-prop (ok! (request! self "POST" "/semantic/properties" {:title "zq clients" :type "node" :cardinality "db.cardinality/many"}) 201)
+                _ (request! self "POST" "/semantic/capture" {:blocks [{:title "zq journal note"}]})
+                journal (uuid-titled conn "zq journal note")
+                journal-page (str (:block/uuid (:block/page (d/entity @conn [:block/uuid (uuid journal)]))))
+                journal-title (:block/title (d/entity @conn [:block/uuid (uuid journal-page)]))
+                no-client (uuid-titled conn "zq task no client")
+                own (uuid-titled conn "zq task own client")
+                put! (fn [id prop value]
+                       (ok! (request! self "PUT" (str "/semantic/blocks/" id "/properties/" (js/encodeURIComponent (get-in prop [:body :ident])))
+                                      {:value value}) 200))
+                _ (put! no-client date-prop journal-page)
+                _ (put! own many-prop ["zq Acme" "zq Beta"])
+                _ (put! other-work many-prop ["zq Beta"])
+                date-title (client-run! self {:client_property "zq client date" :client journal-title})
+                date-uuid (client-run! self {:client_property "zq client date" :client journal-page})
+                many-acme (client-run! self {:client_property "zq clients" :client "zq Acme"})
+                many-beta (client-run! self {:client_property "zq clients" :client "zq Beta"})]
+          (is (every? #(= 200 (:status %)) [date-title date-uuid many-acme many-beta])
+              (pr-str (map head-of [date-title date-uuid many-acme many-beta])))
+          (testing "a date property: the journal by title and by UUID"
+            (is (= [[journal-title "zq task no client"]] (pairs-of date-title)) (pr-str (:body date-title)))
+            (is (= (pairs-of date-title) (pairs-of date-uuid))))
+          (testing "a many node property: a task with two clients is a row under the one given only"
+            (is (= [["zq Acme" "zq task own client"]] (pairs-of many-acme)) (pr-str (:body many-acme)))
+            (is (= #{["zq Beta" "zq task own client"] ["zq Beta" "zq task no client"]} (set (pairs-of many-beta)))
+                (pr-str (:body many-beta)))))))))
