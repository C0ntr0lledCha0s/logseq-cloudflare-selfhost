+(deftest named-client-review-focus-test
+  ;; Plan review focus 8 to 12 and 14, each asserting rows and work (:tasks = what the walk should
+  ;; reach, read with Datalog).
+  (async done
+    (with-named done
+      (fn [{:keys [conn self other-work for-client]}]
+        (p/let [prop (keyword for-client)
+                client-work (uuid-titled conn "zq Client Work")
+                ;; 8. A task holding zq Acme on zq Acme's page.
+                [both] (insert! self client-work [(open-task "zq rf8 both")])
+                _ (for-client! self for-client (:uuid both) "zq Acme")
+                ;; 9. A block holding zq Acme on a page without a client, with a Task child; and a
+                ;;    block holding zq Beta on zq Acme's page, with a Task child.
+                [holder] (insert! self other-work [{:title "zq rf9 holder" :children [(open-task "zq rf9 child")]}])
+                _ (for-client! self for-client (:uuid holder) "zq Acme")
+                [page-holder] (insert! self client-work [{:title "zq rf9 page holder" :children [(open-task "zq rf9 page child")]}])
+                _ (for-client! self for-client (:uuid page-holder) "zq Beta")
+                ;; 10. A task with two clients, through a many node property.
+                _ (ok! (request! self "POST" "/semantic/properties" {:title "zq rf clients" :type "node" :cardinality "db.cardinality/many"}) 201)
+                many (d/q '[:find ?i . :where [?e :block/title "zq rf clients"] [?e :db/ident ?i]] @conn)
+                [two] (insert! self other-work [(open-task "zq rf10 two")])
+                _ (for-client! self (subs (str many) 1) (:uuid two) ["zq Acme" "zq Beta"])
+                ;; 11. A Task block used as a client, held by another task.
+                [client-task held-by] (insert! self other-work [(open-task "zq rf11 client") (open-task "zq rf11 holder")])
+                _ (for-client! self for-client (:uuid held-by) (str (:uuid client-task)))
+                ;; 12. A client nothing holds.
+                lonely (page-id! self "zq rf12 lonely")
+                ;; 14. A date client_property: a task and a page hold a journal, with a task on the page.
+                _ (ok! (request! self "POST" "/semantic/properties" {:title "zq rf date" :type "date"}) 201)
+                date (d/q '[:find ?i . :where [?e :block/title "zq rf date"] [?e :db/ident ?i]] @conn)
+                _ (request! self "POST" "/semantic/capture" {:blocks [{:title "zq rf14 journal note"}]})
+                journal (:block/page (d/entity @conn [:block/uuid (uuid (uuid-titled conn "zq rf14 journal note"))]))
+                journal-uuid (str (:block/uuid journal))
+                journal-title (:block/title journal)
+                [dated] (insert! self other-work [(open-task "zq rf14 task")])
+                _ (for-client! self (subs (str date) 1) (:uuid dated) journal-uuid)
+                dated-page (page-id! self "zq rf14 page")
+                _ (for-client! self (subs (str date) 1) dated-page journal-uuid)
+                _ (insert! self dated-page [(open-task "zq rf14 on page") {:title "zq rf14 note"}])
+                acme (client-run! self {:client "zq Acme"})
+                beta (client-run! self {:client "zq Beta"})
+                many-acme (client-run! self {:client_property "zq rf clients" :client "zq Acme"})
+                many-beta (client-run! self {:client_property "zq rf clients" :client "zq Beta"})
+                by-task (client-run! self {:client (str (:uuid client-task))})
+                lonely-r (client-run! self {:client (str lonely)})
+                dated-r (client-run! self {:client_property "zq rf date" :client journal-title})
+                walked (fn [p title] (count (walk-candidates @conn p (eid-titled conn title))))
+                tasks-of (fn [r] (get-in r [:body :work :tasks]))]
+          (is (every? #(= 200 (:status %)) [acme beta many-acme many-beta by-task lonely-r dated-r])
+              (pr-str (map head-of [acme beta many-acme many-beta by-task lonely-r dated-r])))
+          (testing "8. a task holding the client on the client's page: one row, one candidate"
+            (is (= 1 (count (filter #(= ["zq Acme" "zq rf8 both"] %) (pairs-of acme)))))
+            (is (= (walked prop "zq Acme") (tasks-of acme)) (pr-str (get-in acme [:body :work]))))
+          (testing "9. a holder block's Task children are not its client's; on the client's page they are the page's"
+            (is (= #{["zq Acme" "zq task page client"] ["zq Acme" "zq rf8 both"] ["zq Acme" "zq rf9 page child"]}
+                   (set (pairs-of acme))))
+            (is (= #{["zq Beta" "zq task own client"]} (set (pairs-of beta))))
+            (is (= (walked prop "zq Beta") (tasks-of beta))))
+          (testing "10. a task with two clients is a row under the one given only"
+            (is (= [["zq Acme" "zq rf10 two"]] (pairs-of many-acme)))
+            (is (= [["zq Beta" "zq rf10 two"]] (pairs-of many-beta)))
+            (is (= [1 1] (map tasks-of [many-acme many-beta]))))
+          (testing "11. a task as the client: its holders are candidates, and it is not a row of its own"
+            (is (= [["zq rf11 client" "zq rf11 holder"]] (pairs-of by-task)))
+            (is (= 1 (tasks-of by-task))))
+          (testing "12. a client nothing holds: no rows, nothing counted"
+            (is (= [] (pairs-of lonely-r)))
+            (is (= {:tasks 0 :open-tasks 0} (select-keys (get-in lonely-r [:body :work]) [:tasks :open-tasks]))))
+          (testing "14. a date client_property: the journal's holders and the blocks on its holder page"
+            (is (= #{[journal-title "zq rf14 task"] [journal-title "zq rf14 on page"]} (set (pairs-of dated-r))))
+            (is (= 4 (tasks-of dated-r)) "the task, the page and the page's two blocks")
+            (is (= 2 (get-in dated-r [:body :work :open-tasks])))))))))
