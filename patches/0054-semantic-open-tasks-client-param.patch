+                       ["a namespace child and another page" {:client "zq Leaf"}
+                        (client-message "zq Leaf" [["zq Leaf" "page" (str leaf)] ["zq Leaf" "page" (str leaf-child)]])]
+                       ["a private client by UUID" {:client (str secret)} (no-uuid (str secret))]
+                       ["a private client by title" {:client "zq Secret Client"} (no-title "zq Secret Client")]
+                       ["a recycled client by UUID" {:client (str gone)} (no-uuid (str gone))]
+                       ["a recycled client by title" {:client "zq Gone Client"} (no-title "zq Gone Client")]
+                       ["a value block" {:client "zq Value Only"} (no-title "zq Value Only")]
+                       ["a choice" {:client "zq Choice"} (no-title "zq Choice")]
+                       ["a default client_property" {:client_property "zq client text" :client "zq Acme"} (text-message "zq client text" "default")]
+                       ["a url client_property" {:client_property "zq client url" :client "zq Acme"} (text-message "zq client url" "url")]
+                       ["client before a default client_property" (array-map :client "zq Acme" :client_property "zq client text")
+                        (text-message "zq client text" "default")]
+                       ["the hidden Recycle page by title" {:client "Recycle"} (no-title "Recycle")]
+                       ["the hidden Recycle page by UUID" {:client recycle} (no-uuid recycle)]
+                       ["the hidden favourites page by title" {:client "$$$favorites"} (no-title "$$$favorites")]
+                       ["the hidden favourites page by UUID" {:client favorites} (no-uuid favorites)]
+                       ["the hidden views page by title" {:client "$$$views"} (no-title "$$$views")]
+                       ["the hidden views page by UUID" {:client views} (no-uuid views)]
+                       ["a journal and a page sharing its title" {:client journal-title}
+                        (client-message journal-title (sort-by #(:db/id (d/entity @conn [:block/uuid (uuid (nth % 2))]))
+                                                               [[journal-title "page" journal] [journal-title "page" (str journal-twin)]]))]
+                       ["an unknown client_property: only its own error" {:client_property "zq no such property" :client "zq Nobody"}
+                        "params.client_property: no property titled zq no such property"]
+                       ["an unknown client_property UUID: only its own error" {:client_property unknown :client "zq Nobody"}
+                        (str "params.client_property: no property titled " unknown)]
+                       ["a client_property of a refused type: only its own error" {:client_property "zq client flag" :client "zq Nobody"}
+                        (str "params.client_property: zq client flag is a checkbox property; give one whose values"
+                             " are pages or text (a node, default, url or date property)")]]
+                responses (p/all (map (fn [[_ params]] (client-run! self params)) cases))
+                dry (p/all (map (fn [[_ params]] (client-run! self params {:dry-run true})) cases))]
+          (doseq [[[label _ message] r d] (map vector cases responses dry)]
+            (is (refused-exactly? r message) (str label ": " (head-of r)))
