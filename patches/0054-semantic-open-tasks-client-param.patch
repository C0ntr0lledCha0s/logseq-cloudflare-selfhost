+(deftest named-client-page-wins-test
+  ;; Spec §12 answer 2: a page wins when exactly one candidate is a page. A private candidate is
+  ;; never one, and an exact title is the only tier when it matches (§12 answer 4).
+  (async done
+    (with-named done
+      (fn [{:keys [conn self other-work for-client]}]
+        (p/let [acme (uuid-titled conn "zq Acme")
+                beta (uuid-titled conn "zq Beta")
+                ;; A tag titled like the page zq Acme, and a block titled like the page zq Beta.
+                acme-tag (tag-id! self "zq Acme Tag")
+                _ (retitle! conn acme-tag "zq Acme")
+                _ (block-id! self other-work "zq Beta")
+                ;; A public tag and a private page titled zq Decoy; a task holds the tag.
+                decoy-tag (tag-id! self "zq Decoy")
+                decoy-page (page-id! self "zq Decoy Page")
+                _ (set-tags! self decoy-page ["Private"])
+                _ (retitle! conn decoy-page "zq Decoy")
+                _ (for-client! self for-client (uuid-titled conn "zq task no client") (str decoy-tag))
+                ;; A block titled exactly zq Exacto, and a page titled ZQ EXACTO.
+                exact-block (block-id! self other-work "zq Exacto")
+                exact-page (page-id! self "zq Exacto Page")
+                _ (retitle! conn exact-page "ZQ EXACTO")
+                ;; A journal page and a block whose text is the journal's title.
+                _ (ok! (request! self "POST" "/semantic/capture" {:blocks [{:title "zq wins journal note"}]}) 201)
+                journal (str (:block/uuid (:block/page (d/entity @conn [:block/uuid (uuid (uuid-titled conn "zq wins journal note"))]))))
+                journal-title (:block/title (d/entity @conn [:block/uuid (uuid journal)]))
+                _ (block-id! self other-work journal-title)
+                journal-r (client-run! self {:client journal-title})
+                acme-r (client-run! self {:client "zq Acme"})
+                beta-r (client-run! self {:client "zq Beta"})
+                decoy-r (client-run! self {:client "zq Decoy"})
