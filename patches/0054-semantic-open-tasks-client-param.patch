+(defn- client-parity!
+  "For each value of `prop` (an ident) in the graph: the client run by UUID equals the legacy
+  client-bound Datalog over the private filter, and the full run's rows whose client title is the
+  client's; a private or recycled value is refused as an unknown UUID. Returns how many clients had
+  rows."
+  [conn self label prop-title prop]
+  (let [db @conn
+        clients (distinct (map :v (d/datoms db :aevt prop)))]
+    (p/let [full (client-run! self {:client_property prop-title})]
+      (reduce (fn [acc c]
+                (p/let [n acc
+                        id (str (:block/uuid (d/entity db c)))
+                        r (client-run! self {:client_property prop-title :client id})
+                        private? (contains? (datalog/private-ids db) c)]
+                  (testing (str label ", client " (:block/title (d/entity db c)))
+                    (if private?
+                      (is (refused-exactly? r (str "params.client: no client with UUID " id)) (head-of r))
+                      (let [legacy (legacy-rows db "open-tasks-by-client (client)" {:client_property prop-title :client id})
+                            title (or (:block/title (d/entity db c)) "")]
+                        (is (= 200 (:status r)) (head-of r))
+                        (is (= legacy (code-rows r)) (pr-str {:legacy legacy :code (code-rows r)}))
+                        ;; A client without a title shares "" with the tasks that have none, so
+                        ;; only the legacy Datalog (bound by eid) stands for it.
+                        (when (seq title)
+                          (is (= (filterv #(= title (first %)) (code-rows full)) (code-rows r)))))))
+                  (if (seq (get-in r [:body :rows])) (inc n) n)))
+              (p/resolved 0) clients))))
+
+(deftest named-client-parity-test
+  ;; Client rows = the full run's rows of that client = the legacy client-bound Datalog, on
+  ;; seed-named, on its review-focus additions (two clients with one title, private clients, a client
+  ;; without a title) and on seeded random graphs.
+  (async done
+    (-> (p/let [graph (seed-named)
+                {:keys [conn self for-client]} graph
+                a (client-parity! conn self "seed-named" "forClient" (keyword for-client))
+                {:keys [clients]} (seed-review-focus! graph)
+                b (client-parity! conn self "review focus" "zq clients" (keyword clients))
+                seeded (reduce (fn [acc seed]
+                                 (p/let [n acc
+                                         g (seed-random-graph seed)
+                                         _ (extend-for-named! g seed)
+                                         prop (:db/ident (d/entity @(:conn g) (d/q '[:find ?e . :where [?e :block/title "zq client"] [?e :logseq.property/type _]] @(:conn g))))
+                                         m (client-parity! (:conn g) (:self g) (str "seed " seed) "zq client" prop)]
+                                   (+ n m)))
+                               (p/resolved 0) (range 1 11))]
+          (is (pos? a)) (is (pos? b))
+          (is (<= 10 seeded) (str "clients with rows across the seeded graphs: " seeded)))
+        (p/catch #(is false (str % "\n" (.-stack %))))
+        (p/finally done))))
+
+(deftest named-client-refusals-test
+  ;; Spec §8 test 2 with §12: each a 400 naming params.client, with the exact message and no rows;
+  ;; never all clients.
+  (async done
+    (with-named done
+      (fn [{:keys [conn self other-work for-client]}]
+        (p/let [before (snapshot conn)
+                ;; A tag and a block share a title, with no page.
+                tb-tag (tag-id! self "zq Tb")
+                tb-block (block-id! self other-work "zq Tb")
+                ;; The same, beside a private page with that title: the page is never named.
+                tb2-tag (tag-id! self "zq Tb2")
+                tb2-block (block-id! self other-work "zq Tb2")
+                tb2-page (page-id! self "zq Tb2 private")
+                _ (set-tags! self tb2-page ["Private"])
+                _ (retitle! conn tb2-page "zq Tb2")
+                ;; Two pages that match only by name, ignoring case.
+                dup-a (page-id! self "zq Dup One")
+                dup-b (page-id! self "zq Dup Two")
+                _ (retitle! conn dup-a "Zq Dup")
+                _ (retitle! conn dup-b "ZQ DUP")
+                ;; A namespace child page sharing its title with another page.
+                leaf (page-id! self "zq Leaf")
+                ns-parent (page-id! self "zq Ns")
+                leaf-child (page-id! self "zq Leaf Child")
+                _ (retitle! conn leaf-child "zq Leaf")
+                _ (d/transact! conn [[:db/add [:block/uuid leaf-child] :block/parent [:block/uuid ns-parent]]])
+                ;; A private client, and a recycled one.
+                secret (page-id! self "zq Secret Client")
+                _ (set-tags! self secret ["Private"])
+                gone (page-id! self "zq Gone Client")
+                _ (ok! (request! self "DELETE" (str "/semantic/pages/" gone) nil) 200)
+                ;; Text client properties, a value block and a choice titled like a client.
+                _ (ok! (request! self "POST" "/semantic/properties" {:title "zq client text" :type "default"}) 201)
+                _ (ok! (request! self "POST" "/semantic/properties" {:title "zq client url" :type "url"}) 201)
+                text-ident (d/q '[:find ?i . :where [?e :block/title "zq client text"] [?e :db/ident ?i]] @conn)
+                _ (ok! (request! self "PUT" (str "/semantic/blocks/" other-work "/properties/" (js/encodeURIComponent (subs (str text-ident) 1)))
+                                 {:value "zq Value Only"}) 200)
+                kind (outliner-property/upsert-property! conn nil {:logseq.property/type :default} {:property-name "zq kind"})
+                _ (outliner-property/upsert-closed-value! conn (:db/ident kind) {:value "zq Choice"})
+                _ (assert (some? (d/q '[:find ?e . :where [?e :block/title "zq Choice"] [?e :block/closed-value-property _]] @conn)))
+                unknown (str (random-uuid))
+                before (snapshot conn)
+                type-message "params.client: must be a client title or UUID (a string)"
+                no-title #(str "params.client: no page, tag or block titled " (pr-str %))
+                no-uuid #(str "params.client: no client with UUID " %)
+                text-message #(str "params.client: " % " is a " %2 " property, whose values are per-block text;"
+                                   " give client_property as a node or date property, or list one client's tasks with datalog_query")
+                cases [["null" {:client nil} type-message]
+                       ["empty" {:client ""} type-message]
+                       ["a number" {:client 3} type-message]
+                       ["zero" {:client 0} type-message]
+                       ["an array" {:client ["zq Acme"]} type-message]
+                       ["an object" {:client {:title "zq Acme"}} type-message]
+                       ["false" {:client false} type-message]
+                       ["whitespace" {:client "   "} (no-title "   ")]
+                       ["an unknown title" {:client "zq Nobody"} (no-title "zq Nobody")]
+                       ["an unknown UUID" {:client unknown} (no-uuid unknown)]
+                       ["a malformed UUID" {:client "6650aaaa-zzzz-4000-8000-000000000000"} (no-title "6650aaaa-zzzz-4000-8000-000000000000")]
+                       ["the property's ident" {:client (subs (str for-client) 0)} (no-title (subs (str for-client) 0))]
+                       ["a tag and a block, no page" {:client "zq Tb"}
+                        (client-message "zq Tb" (sort-by #(:db/id (d/entity @conn [:block/uuid (uuid (nth % 2))]))
+                                                         [["zq Tb" "tag" (str tb-tag)] ["zq Tb" "block" (str tb-block)]]))]
+                       ["a private page beside them is never named" {:client "zq Tb2"}
+                        (client-message "zq Tb2" [["zq Tb2" "tag" (str tb2-tag)] ["zq Tb2" "block" (str tb2-block)]])]
+                       ["two pages by name only" {:client "zq dup"}
+                        (client-message "zq dup" [["Zq Dup" "page" (str dup-a)] ["ZQ DUP" "page" (str dup-b)]])]
+                       ["a namespace child and another page" {:client "zq Leaf"}
+                        (client-message "zq Leaf" [["zq Leaf" "page" (str leaf)] ["zq Leaf" "page" (str leaf-child)]])]
+                       ["a private client by UUID" {:client (str secret)} (no-uuid (str secret))]
+                       ["a private client by title" {:client "zq Secret Client"} (no-title "zq Secret Client")]
+                       ["a recycled client by UUID" {:client (str gone)} (no-uuid (str gone))]
+                       ["a recycled client by title" {:client "zq Gone Client"} (no-title "zq Gone Client")]
+                       ["a value block" {:client "zq Value Only"} (no-title "zq Value Only")]
+                       ["a choice" {:client "zq Choice"} (no-title "zq Choice")]
+                       ["a default client_property" {:client_property "zq client text" :client "zq Acme"} (text-message "zq client text" "default")]
+                       ["a url client_property" {:client_property "zq client url" :client "zq Acme"} (text-message "zq client url" "url")]
+                       ["client before a default client_property" (array-map :client "zq Acme" :client_property "zq client text")
+                        (text-message "zq client text" "default")]]
+                responses (p/all (map (fn [[_ params]] (client-run! self params)) cases))
+                dry (p/all (map (fn [[_ params]] (client-run! self params {:dry-run true})) cases))]
+          (doseq [[[label _ message] r d] (map vector cases responses dry)]
+            (is (refused-exactly? r message) (str label ": " (head-of r)))
+            (is (refused-exactly? d message) (str label ", dry run: " (head-of d))))
+          (testing "no message names the private page"
+            (is (not-any? #(string/includes? (:text %) (str tb2-page)) responses)))
+          (is (= before (snapshot conn))))))))
+
+(deftest named-client-page-wins-test
+  ;; Spec §12 answer 2: a page wins when exactly one candidate is a page. A private candidate is
+  ;; never one, and an exact title is the only tier when it matches (§12 answer 4).
+  (async done
+    (with-named done
+      (fn [{:keys [conn self other-work for-client]}]
+        (p/let [acme (uuid-titled conn "zq Acme")
+                beta (uuid-titled conn "zq Beta")
+                ;; A tag titled like the page zq Acme, and a block titled like the page zq Beta.
+                acme-tag (tag-id! self "zq Acme Tag")
+                _ (retitle! conn acme-tag "zq Acme")
+                _ (block-id! self other-work "zq Beta")
+                ;; A public tag and a private page titled zq Decoy; a task holds the tag.
+                decoy-tag (tag-id! self "zq Decoy")
+                decoy-page (page-id! self "zq Decoy Page")
+                _ (set-tags! self decoy-page ["Private"])
+                _ (retitle! conn decoy-page "zq Decoy")
+                _ (for-client! self for-client (uuid-titled conn "zq task no client") (str decoy-tag))
+                ;; A block titled exactly zq Exacto, and a page titled ZQ EXACTO.
+                exact-block (block-id! self other-work "zq Exacto")
+                exact-page (page-id! self "zq Exacto Page")
+                _ (retitle! conn exact-page "ZQ EXACTO")
+                acme-r (client-run! self {:client "zq Acme"})
+                beta-r (client-run! self {:client "zq Beta"})
+                decoy-r (client-run! self {:client "zq Decoy"})
+                exact-r (client-run! self {:client "zq Exacto"})
+                name-r (client-run! self {:client "zq exacto"})
+                tag-r (client-run! self {:client (str acme-tag)})]
+          (is (every? #(= 200 (:status %)) [acme-r beta-r decoy-r exact-r name-r tag-r])
+              (pr-str (map head-of [acme-r beta-r decoy-r exact-r name-r tag-r])))
+          (testing "a page and a tag: the page wins"
+            (is (= {:title "zq Acme" :uuid acme} (get-in acme-r [:body :params :client])))
+            (is (= [["zq Acme" "zq task page client"]] (pairs-of acme-r))))
+          (testing "a page and a block: the page wins"
+            (is (= {:title "zq Beta" :uuid beta} (get-in beta-r [:body :params :client])))
+            (is (= [["zq Beta" "zq task own client"]] (pairs-of beta-r))))
+          (testing "the tag by UUID is the tag, with no tasks"
+            (is (= {:title "zq Acme" :uuid (str acme-tag)} (get-in tag-r [:body :params :client])))
+            (is (= [] (pairs-of tag-r))))
+          (testing "a public tag and a private page: the tag is the only candidate, and the page is never named"
+            (is (= {:title "zq Decoy" :uuid (str decoy-tag)} (get-in decoy-r [:body :params :client])))
+            (is (= [["zq Decoy" "zq task no client"]] (pairs-of decoy-r)))
+            (is (not (string/includes? (:text decoy-r) (str decoy-page)))))
+          (testing "an exact title on a block is the only tier; the case-only page is not considered"
+            (is (= {:title "zq Exacto" :uuid (str exact-block)} (get-in exact-r [:body :params :client]))))
+          (testing "with no exact title, the page by name"
+            (is (= {:title "ZQ EXACTO" :uuid (str exact-page)} (get-in name-r [:body :params :client])))))))))
+
+(deftest named-client-echo-test
+  ;; params.client echoes {title, uuid} of the entity used; without a client the response's params
+  ;; are what they were. dry-run resolves and echoes the client and reads nothing.
+  (async done
+    (with-named done
+      (fn [{:keys [conn self]}]
+        (p/let [acme (uuid-titled conn "zq Acme")
+                given (client-run! self {:client "zq Acme"})
+                absent (client-run! self {})
+                dry (client-run! self {:client "zq Acme"} {:dry-run true})
+                dry-work (:named-work @datalog/last-run)]
+          (is (= [200 200 200] (map :status [given absent dry])) (pr-str (map head-of [given absent dry])))
+          (is (= {:title "zq Acme" :uuid acme} (get-in given [:body :params :client])))
+          (is (= [:client_property] (keys (get-in absent [:body :params]))) "no client key without a client")
+          (is (= (get-in absent [:body :params :client_property]) (get-in given [:body :params :client_property])))
+          (testing "dry run: the client echoed, nothing read"
+            (is (true? (get-in dry [:body :dry-run])))
+            (is (= {:title "zq Acme" :uuid acme} (get-in dry [:body :params :client])))
+            (is (not-any? #(contains? (:body dry) %) [:rows :work]))
+            (is (= {} dry-work))))))))
+
+(deftest named-client-absent-still-works-test
+  ;; The calls that worked before params.client still answer as they did: no params, empty params,
+  ;; client_property alone (node and text), a dry run, and a client re-sent gives the same answer.
+  ;; Key order in params doesn't matter.
+  (async done
+    (with-named done
+      (fn [{:keys [self]}]
+        (p/let [_ (ok! (request! self "POST" "/semantic/properties" {:title "zq client text" :type "default"}) 201)
+                bodies [nil {} {:params {}} {:params {:client_property "forClient"}}
+                        {:params {:client_property "zq client text"}} {:dry-run true}]
+                answers (p/all (map #(named! self "open-tasks-by-client" %) bodies))
+                once (client-run! self (array-map :client_property "forClient" :client "zq Acme"))
+                again (client-run! self (array-map :client "zq Acme" :client_property "forClient"))]
+          (doseq [[b r] (map vector bodies answers)]
+            (is (= 200 (:status r)) (str (pr-str b) " " (head-of r)))
+            (is (not (contains? (get-in r [:body :params]) :client)) (pr-str b)))
+          (is (= (:text (first answers)) (:text (nth answers 1)) (:text (nth answers 2)) (:text (nth answers 3))))
+          (is (= [200 200] (map :status [once again])))
+          (is (= (:body once) (:body again)) "a re-send, keys in either order"))))))
+
+(deftest named-client-read-only-test
+  ;; max-tx and the datom count are unchanged after a client run answered, refused at a bound, and
+  ;; refused with a 400.
+  (async done
+    (with-named done
+      (fn [{:keys [conn self]}]
+        (p/let [before (snapshot conn)
+                answered (client-run! self {:client "zq Acme"})
+                _ (set-bounds! self {:reads 1})
+                bounded (client-run! self {:client "zq Acme"})
+                _ (set-bounds! self nil)
+                refused (client-run! self {:client "zq Nobody"})]
+          (is (= [200 422 400] (map :status [answered bounded refused])) (pr-str (map head-of [answered bounded refused])))
+          (is (= before (snapshot conn))))))))
+
+(deftest named-client-documented-test
+  ;; runNamedQuery's description and its 400 name params.client, how it resolves and what it refuses.
+  (let [document (semantic-routes/openapi-document "https://issuer.example")
+        post (get-in document [:paths "/api/v1/graphs/{graph-id}/named-queries/{name}" :post])]
+    (doseq [phrase ["open-tasks-by-client (params client_property, default forClient, and client, optional)"
+                    "client is a client's title or UUID, and lists only that client's tasks"
+                    "a page wins when exactly one of them is a page"
+                    "naming each one's kind and UUID, oldest first"
+                    "a private or recycled one reads as unknown"
+                    "a client_property that is a default or url property"
+                    "never all clients"
+                    "params.client echoes the client used, as title and uuid"]]
+      (is (string/includes? (:description post) phrase) phrase))
+    (is (string/includes? (get-in post [:responses "400" :description]) "params.client"))))
