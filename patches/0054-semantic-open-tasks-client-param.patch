+(defn- extend-for-client-walk!
+  "Adds to an extend-for-named! graph what the client walk must get right, shaped by `seed`: on each
+  live page holding a zq client value, a block holding another client with a Task child (the child
+  is the page's client's, not the block's) and a task holding that other client (its own client
+  wins over the page's)."
+  [{:keys [conn self]} seed]
+  (let [db @conn
+        prop (d/q '[:find ?i . :where [?e :block/title "zq client"] [?e :logseq.property/type _] [?e :db/ident ?i]] db)
+        path (js/encodeURIComponent (subs (str prop) 1))
+        clients (vec (sort (d/q '[:find [?u ...] :where [?e :block/title ?t] [(clojure.string/starts-with? ?t "zq cl ")] [?e :block/uuid ?u]] db)))
+        holder-pages (vec (sort (d/q '[:find [?u ...] :in $ ?prop
+                                       :where [?p ?prop _] [(missing? $ ?p :block/page)]
+                                       [(missing? $ ?p :logseq.property/deleted-at)] [?p :block/uuid ?u]]
+                                     db prop)))
+        put! (fn [id value] (ok! (request! self "PUT" (str "/semantic/blocks/" id "/properties/" path) {:value value}) 200))]
+    (reduce (fn [acc [i page]]
+              (p/let [n acc
+                      other (str (clients (mod (+ seed i) (count clients))))
+                      [holder own] (insert! self page [{:title (str "zq walk holder " seed " " i)
+                                                        :children [(open-task (str "zq walk child " seed " " i))]}
+                                                       (open-task (str "zq walk own " seed " " i))])
+                      _ (put! (:uuid holder) [other])
+                      _ (put! (:uuid own) [other])]
+                (inc n)))
+            (p/resolved 0) (map-indexed vector holder-pages))))
+
+(deftest named-client-parity-test
+  ;; Client rows = the full run's rows of that client = the legacy client-bound Datalog, on
+  ;; seed-named, on its review-focus additions (two clients with one title, private clients, a client
+  ;; without a title) and on seeded random graphs. Stage 2: the seeded graphs gain holder blocks over
+  ;; Task children on client pages, and tasks holding a client on another client's page
+  ;; (extend-for-client-walk!), which the walk from the client must answer as the full run does.
+  (async done
+    (-> (p/let [graph (seed-named)
+                {:keys [conn self for-client]} graph
+                a (client-parity! conn self "seed-named" "forClient" (keyword for-client))
+                {:keys [clients]} (seed-review-focus! graph)
+                b (client-parity! conn self "review focus" "zq clients" (keyword clients))
+                seeded (reduce (fn [acc seed]
+                                 (p/let [[n extended] acc
+                                         g (seed-random-graph seed)
+                                         _ (extend-for-named! g seed)
+                                         added (extend-for-client-walk! g seed)
+                                         prop (:db/ident (d/entity @(:conn g) (d/q '[:find ?e . :where [?e :block/title "zq client"] [?e :logseq.property/type _]] @(:conn g))))
+                                         m (client-parity! (:conn g) (:self g) (str "seed " seed) "zq client" prop)]
+                                   [(+ n m) (+ extended added)]))
+                               (p/resolved [0 0]) (range 1 11))]
+          (is (pos? a)) (is (pos? b))
+          (is (<= 10 (first seeded)) (str "clients with rows across the seeded graphs: " (pr-str seeded)))
+          (is (<= 5 (second seeded)) (str "client pages extended across the seeded graphs: " (pr-str seeded))))
+        (p/catch #(is false (str % "\n" (.-stack %))))
+        (p/finally done))))
