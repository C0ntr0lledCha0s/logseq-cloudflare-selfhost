+(defn- client-graph!
+  "On the app's conn, as the app writes them: a node property forClient (upsert-property!), client
+  pages Acme and Beta, a page Acme Work holding Acme with two tasks and a note on it (one task's own
+  client is Beta), a page Other with a task holding Acme, a done task holding Acme and three tasks
+  with no client. Returns forClient's ident."
+  [client]
+  (let [ident (:db/ident (outliner-property/upsert-property!
+                          client nil {:logseq.property/type :node :db/cardinality :db.cardinality/one}
+                          {:property-name "forClient"}))
+        now 1700000000000
+        page (fn [id title] {:block/uuid id :block/title title :block/name (string/lower-case title)
+                             :block/tags #{:logseq.class/Page} :block/created-at now :block/updated-at now})
+        block (fn [page-id order title & [task?]]
+                (cond-> {:block/uuid (random-uuid) :block/title title :block/order order
+                         :block/page [:block/uuid page-id] :block/parent [:block/uuid page-id]
+                         :block/created-at now :block/updated-at now}
+                  task? (assoc :block/tags #{:logseq.class/Task} :logseq.property/status task?)))]
+    (d/transact! client [(page acme-uuid "Acme") (page beta-uuid "Beta")
+                         (assoc (page acme-work-uuid "Acme Work") ident [:block/uuid acme-uuid])
+                         (page other-uuid "Other")])
+    (d/transact! client [(block acme-work-uuid "a0" "acme page task" :logseq.property/status.todo)
+                         (assoc (block acme-work-uuid "a1" "beta own task" :logseq.property/status.doing) ident [:block/uuid beta-uuid])
+                         (block acme-work-uuid "a2" "acme note")
+                         (assoc (block other-uuid "a0" "acme own task" :logseq.property/status.todo) ident [:block/uuid acme-uuid])
+                         (assoc (block other-uuid "a1" "acme done task" :logseq.property/status.done) ident [:block/uuid acme-uuid])
+                         (block other-uuid "a2" "loose task 0" :logseq.property/status.todo)
+                         (block other-uuid "a3" "loose task 1" :logseq.property/status.todo)
+                         (block other-uuid "a4" "loose task 2" :logseq.property/status.todo)])
+    ident))
