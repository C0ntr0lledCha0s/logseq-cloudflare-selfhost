+(deftest get-block-shows-stored-heading-test
+  (async done
+    (with-graph done 1
+      (fn [{:keys [conn self ids]}]
+        (let [id (first ids)]
+          ;; A heading the app stored (the property, no prefix in the title).
+          (d/transact! conn [[:db/add [:block/uuid id] :logseq.property/heading 4]])
+          (p/let [heading (shown-heading self id)
+                  many (request! self "GET" (str "/semantic/blocks?ids=" id) nil)]
+            (is (= 4 heading) "getBlock shows the heading")
+            (is (= 4 (some #(when (= "logseq.property/heading" (:ident %)) (:value %))
+                           (get-in many [:body :blocks 0 :properties])))
+                (str "getBlocks shows the heading: " (pr-str (:body many))))))))))
