+(deftest refresh-refs-keeps-legacy-heading-test
+  ;; A block an earlier insert stored with the prefix as text. refreshRefs re-saves it through
+  ;; save-block! because its unknown #tag needs escaping, which must not lose the level.
+  (async done
+    (with-graph done 0
+      (fn [{:keys [conn self page-id]}]
+        (let [id (random-uuid)]
+          (outliner-core/insert-blocks! conn [{:block/uuid id :block/title "## Legacy #Unknownword"}]
+                                        (d/entity @conn [:block/uuid page-id])
+                                        {:sibling? false :keep-uuid? true :bottom? true})
+          (p/let [response (request! self "POST" "/semantic/refresh-refs" {:apply true})
+                  {:keys [title heading]} (stored conn id)]
+            (is (= 200 (:status response)) (pr-str (:body response)))
+            (is (or (= 2 heading) (string/starts-with? title "## "))
+                (str "the level survives the re-save: " (pr-str {:title title :heading heading})))))))))
+
+(deftest refresh-refs-preview-ignores-heading-prefix-test
+  ;; refreshRefs fixes tags and links. A legacy block whose only difference from today's write is
+  ;; its heading prefix is not listed as a change.
+  (async done
+    (with-graph done 0
+      (fn [{:keys [conn self page-id]}]
+        (let [id (random-uuid)]
+          (outliner-core/insert-blocks! conn [{:block/uuid id :block/title "## Plain heading"}]
+                                        (d/entity @conn [:block/uuid page-id])
+                                        {:sibling? false :keep-uuid? true :bottom? true})
+          (p/let [response (request! self "POST" "/semantic/refresh-refs" {})]
+            (is (= 200 (:status response)) (pr-str (:body response)))
+            (is (not-any? #(= (str id) (:uuid %)) (get-in response [:body :changed]))
+                (pr-str (:body response)))))))))
+
+;; A block with a display type (a code, math or quote block) holds text, not an outline title: a
+;; leading `# ` is a comment or literal text. The outliner's save leaves such a title alone, so
+;; every write keeps it as given and sets no heading. (Only updateBlock and refreshRefs can reach
+;; one: an insert can't set a display type, which takes a keyword JSON can't carry.)
+(def display-typed
+  [[:code "# install deps\nnpm install"]
+   [:code "####### banner\necho hi"]
+   [:math "# x^2"]
+   [:quote "## Not a heading"]])
+
+(deftest update-block-keeps-display-typed-title-test
+  (async done
+    (with-graph done (count display-typed)
+      (fn [{:keys [conn self ids]}]
+        (d/transact! conn (mapv (fn [[display-type] id]
+                                  [:db/add [:block/uuid id] :logseq.property.node/display-type display-type])
+                                display-typed ids))
+        (p/let [responses (p/all (map (fn [[_ title] id]
+                                        (request! self "PATCH" (str "/semantic/blocks/" id) {:title title}))
+                                      display-typed ids))]
+          (doseq [[[display-type title] id response] (map vector display-typed ids responses)]
+            (testing (pr-str display-type title)
+              (is (= 200 (:status response)) (pr-str (:body response)))
+              (is (= title (get-in response [:body :title])) "response title")
+              (is (= {:title title :heading nil} (stored conn id)) "stored as given, no heading"))))))))
+
+(deftest refresh-refs-keeps-display-typed-title-test
+  ;; A code block whose comment line starts with `# ` and which holds an unknown #word that
+  ;; refreshRefs escapes: the re-save keeps the comment and sets no heading.
+  (async done
+    (with-graph done 0
+      (fn [{:keys [conn self page-id]}]
+        (let [id (random-uuid)]
+          (outliner-core/insert-blocks! conn [{:block/uuid id :block/title "# build #Unknownword\nmake"}]
+                                        (d/entity @conn [:block/uuid page-id])
+                                        {:sibling? false :keep-uuid? true :bottom? true})
+          (d/transact! conn [[:db/add [:block/uuid id] :logseq.property.node/display-type :code]])
+          (p/let [preview (request! self "POST" "/semantic/refresh-refs" {})
+                  response (request! self "POST" "/semantic/refresh-refs" {:apply true})]
+            (is (= 200 (:status response)) (pr-str (:body response)))
+            (is (= ["# build \\#Unknownword\nmake"]
+                   (keep #(when (= (str id) (:uuid %)) (:after %)) (get-in preview [:body :changed])))
+                (str "preview: " (pr-str (:body preview))))
+            (is (= {:title "# build \\#Unknownword\nmake" :heading nil} (stored conn id)))))))))
+
+(deftest page-outline-shows-heading-as-prefix-test
+  ;; The outline is markdown, so a heading reads as it is written: `## Section`, not a key:: line.
+  (async done
+    (with-graph done 0
+      (fn [{:keys [self page-id]}]
+        (p/let [_ (request! self "POST" "/semantic/block-trees"
+                            {:target-id (str page-id)
