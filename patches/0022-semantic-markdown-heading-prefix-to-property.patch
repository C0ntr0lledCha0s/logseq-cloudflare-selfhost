index 0000000..fc6ff82
--- /dev/null
+++ b/deps/db-sync/test/logseq/db_sync/semantic_headings_test.cljs
@@ -0,0 +1,308 @@
+(ns logseq.db-sync.semantic-headings-test
+  "A block title that starts with a markdown heading (`#` to `######`, then whitespace) is stored
+  the way the app stores it, whichever write made it: the prefix comes off the title and the level
+  goes in :logseq.property/heading. updateBlock goes through the outliner's save-block!, which
+  strips any `#+ ` prefix without setting the property; the inserts go through insert-blocks!,
+  which keeps the prefix as text. Both must end in the same stored form, and getBlock must show
+  the level. A `#` that isn't a heading (no space after it, mid-title, an inline tag, seven or more
+  hashes) is never a heading and is never dropped."
+  (:require [cljs.test :refer [async deftest is testing]]
+            [clojure.string :as string]
+            [datascript.core :as d]
+            [logseq.db-sync.test-sql :as test-sql]
+            [logseq.db-sync.worker.handler.sync :as sync-handler]
+            [logseq.db.sqlite.export :as sqlite-export]
+            [logseq.outliner.core :as outliner-core]
+            [logseq.outliner.page :as outliner-page]
+            [promesa.core :as p]))
+
+(defn- request!
+  "One semantic API request through the real handler; returns {:status :body}."
+  [self method path body]
+  (p/let [url (str "http://localhost" path (if (string/includes? path "?") "&" "?") "graph-id=graph-1")
+          response (sync-handler/handle-http
+                    self
+                    (js/Request. url (clj->js (cond-> {:method method
+                                                       :headers {"content-type" "application/json"}}
+                                                body (assoc :body (js/JSON.stringify (clj->js body)))))))
+          text (.text response)]
+    {:status (.-status response)
+     :body (when (seq text)
+             (try (js->clj (js/JSON.parse text) :keywordize-keys true)
+                  (catch :default _ text)))}))
+
+;; [title stored-title level]: every heading level, and leading whitespace as the app trims it.
+(def headings
+  [["# One" "One" 1]
+   ["## Section" "Section" 2]
+   ["### Three" "Three" 3]
+   ["#### Four" "Four" 4]
+   ["##### Five" "Five" 5]
+   ["###### Six" "Six" 6]
+   ["##\tTabbed" "Tabbed" 2]
+   ["  ## Indented" "Indented" 2]])
+
+;; Titles with a `#` that isn't a heading. Each must keep its hashes and set no heading.
+;; "## " has hashes and whitespace but no text, so the app makes no heading of it either.
+(def not-headings ["##Nospace" "Plain ## mid" "#tag word" "####### Seven" "## "])
+
+(defn- stored [conn id]
+  (let [e (d/entity @conn [:block/uuid id])]
+    {:title (:block/title e) :heading (:logseq.property/heading e)}))
+
+(defn- shown-heading
+  "The heading level getBlock shows for `id`, or nil."
+  [self id]
+  (p/let [got (request! self "GET" (str "/semantic/blocks/" id) nil)]
+    (some #(when (= "logseq.property/heading" (:ident %)) (:value %))
+          (get-in got [:body :properties]))))
+
+(defn- with-graph
+  "A page with one placeholder block per title, made by the outliner as the app makes them."
+  [done n run]
+  (-> (p/let [conn (sqlite-export/create-conn)
+              [_ page-id] (outliner-page/create! conn "Headings" {})
+              ids (vec (repeatedly n random-uuid))
+              _ (when (seq ids)
+                  (outliner-core/insert-blocks! conn (mapv (fn [id] {:block/uuid id :block/title "placeholder"}) ids)
+                                              (d/entity @conn [:block/uuid page-id])
+                                                {:sibling? false :keep-uuid? true :bottom? true}))
+              self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true}]
+        (run {:conn conn :self self :page-id page-id :ids ids}))
+      (p/catch #(is false (str "unexpected error: " %)))
+      (p/finally done)))
+
+(defn- check-headings!
+  "Asserts each written heading title is stored without its prefix, with its level, and shown by getBlock."
+  [self conn label ids]
+  (p/all
+   (map (fn [[title stored-title level] id]
+          (p/let [heading (shown-heading self id)]
+            (is (= {:title stored-title :heading level} (stored conn id))
+                (str label " " (pr-str title) ": the prefix becomes the heading property"))
+            (is (= level heading) (str label " " (pr-str title) ": getBlock shows the heading"))))
+        headings ids)))
+
+(deftest update-block-stores-heading-test
+  (async done
+    (with-graph done (count headings)
+      (fn [{:keys [conn self ids]}]
+        (p/let [responses (p/all (map (fn [[title] id]
+                                        (request! self "PATCH" (str "/semantic/blocks/" id) {:title title}))
+                                      headings ids))]
+          (doseq [[[title stored-title] response] (map vector headings responses)]
+            (is (= 200 (:status response)) (str (pr-str title) ": " (pr-str (:body response))))
+            (is (= stored-title (get-in response [:body :title])) (str (pr-str title) ": response title")))
+          (check-headings! self conn "updateBlock" ids))))))
+
+(deftest insert-paths-store-heading-test
+  (async done
+    (with-graph done 1
+      (fn [{:keys [conn self page-id ids]}]
+        (let [tree-ids (vec (repeatedly (count headings) random-uuid))
+              child-ids (vec (repeatedly (count headings) random-uuid))
+              batch-ids (vec (repeatedly (count headings) random-uuid))
+              capture-ids (vec (repeatedly (count headings) random-uuid))
+              nodes (fn [uuids] (mapv (fn [[title] id] {:uuid (str id) :title title}) headings uuids))]
+          (p/let [tree (request! self "POST" "/semantic/block-trees"
+                                 {:target-id (str page-id) :blocks (nodes tree-ids)})
+                  children (request! self "POST" (str "/semantic/blocks/" (first ids) "/children")
+                                     {:position "append" :blocks (nodes child-ids)})
+                  batch (request! self "POST" "/semantic/block-trees/batch"
+                                  {:entries [{:target-id (str page-id) :blocks (nodes batch-ids)}]})
+                  capture (request! self "POST" "/semantic/capture" {:blocks (nodes capture-ids)})]
+            (doseq [[label response] [["insertBlockTree" tree] ["insertBlockChildren" children]
+                                      ["batchInsertBlockTrees" batch] ["captureToToday" capture]]]
+              (is (= 201 (:status response)) (str label ": " (pr-str (:body response)))))
+            (is (= (mapv second headings) (mapv :title (get-in tree [:body :blocks])))
+                "insertBlockTree: response titles have no prefix")
+            (check-headings! self conn "insertBlockTree" tree-ids)
+            (check-headings! self conn "insertBlockChildren" child-ids)
+            (check-headings! self conn "batchInsertBlockTrees" batch-ids)
+            (check-headings! self conn "captureToToday" capture-ids)))))))
+
+(deftest nested-tree-child-stores-heading-test
