+(deftest update-and-insert-agree-on-non-headings-test
+  (async done
+    (with-graph done (count not-headings)
+      (fn [{:keys [conn self page-id ids]}]
+        (let [tree-ids (vec (repeatedly (count not-headings) random-uuid))]
+          (p/let [updates (p/all (map (fn [title id]
+                                        (request! self "PATCH" (str "/semantic/blocks/" id) {:title title}))
+                                      not-headings ids))
+                  tree (request! self "POST" "/semantic/block-trees"
+                                 {:target-id (str page-id)
+                                  :blocks (mapv (fn [title id] {:uuid (str id) :title title}) not-headings tree-ids)})]
+            (is (= 201 (:status tree)) (pr-str (:body tree)))
+            (doseq [[title id tree-id response] (map vector not-headings ids tree-ids updates)]
+              (testing (pr-str title)
+                (is (= 200 (:status response)) (pr-str (:body response)))
+                (is (nil? (:heading (stored conn id))) "updateBlock sets no heading")
+                (is (nil? (:heading (stored conn tree-id))) "insertBlockTree sets no heading")
+                (is (string/starts-with? (string/replace (:title (stored conn id)) "\\" "") (subs title 0 2))
+                    "updateBlock keeps the leading hashes or text")
+                (is (= (:title (stored conn tree-id)) (:title (stored conn id)))
+                    "updateBlock and insertBlockTree store the same title")))))))))
