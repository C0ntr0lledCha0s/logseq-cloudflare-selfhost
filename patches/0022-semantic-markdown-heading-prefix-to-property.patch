+                                      {:title "Plain"}]})
+                outline (request! self "GET" (str "/semantic/pages/" page-id "/outline") nil)]
+          (is (= 200 (:status outline)) (pr-str (:body outline)))
+          (is (= "- ## Section\n  - ###### Deep\n- Plain" (get-in outline [:body :markdown]))))))))
+
+(deftest page-outline-shows-other-heading-values-as-property-test
+  ;; A heading value that is no markdown level (the app's auto heading, true, or a number outside
+  ;; 1 to 6) has no prefix to show, so the outline keeps it as a property line.
+  (async done
+    (with-graph done 2
+      (fn [{:keys [conn self page-id ids]}]
+        (d/transact! conn [[:db/add [:block/uuid (first ids)] :logseq.property/heading true]
+                           [:db/add [:block/uuid (second ids)] :logseq.property/heading 7]])
+        (p/let [outline (request! self "GET" (str "/semantic/pages/" page-id "/outline") nil)]
+          (is (= "- placeholder\n  Heading:: true\n- placeholder\n  Heading:: 7"
+                 (get-in outline [:body :markdown]))))))))
+
+(deftest refresh-refs-preview-skips-display-typed-comment-test
