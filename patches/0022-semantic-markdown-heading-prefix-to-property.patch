+(deftest update-block-heading-level-follows-the-title-test
+  (async done
+    (with-graph done 2
+      (fn [{:keys [conn self ids]}]
+        (let [[changed kept] ids]
+          ;; Both start as level-3 headings, as the app stores them.
+          (d/transact! conn [[:db/add [:block/uuid changed] :logseq.property/heading 3]
+                             [:db/add [:block/uuid kept] :logseq.property/heading 3]])
+          (p/let [_ (request! self "PATCH" (str "/semantic/blocks/" changed) {:title "## Now two"})
+                  _ (request! self "PATCH" (str "/semantic/blocks/" kept) {:title "No prefix"})]
+            (is (= {:title "Now two" :heading 2} (stored conn changed)) "a new prefix sets the new level")
+            (is (= {:title "No prefix" :heading 3} (stored conn kept))
+                "a title without a prefix keeps the block's heading, as the app does")))))))
