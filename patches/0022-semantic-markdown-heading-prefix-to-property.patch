+(defn- markdown-heading
+  "A title's markdown heading, read as the app reads it: optional leading whitespace, `#` to
+  `######`, whitespace, then text. Returns {:title :level}, the title without the prefix and the
+  level, or {:title} when it isn't a heading. The outliner's save strips any `#+ ` prefix from a
+  title, so a leading run of hashes that isn't a heading (seven or more, or nothing after it) has
+  its first `#` escaped and survives as text."
+  [title]
+  (let [[_ hashes text] (re-find #"^\s*(#{1,6})\s+([\s\S]*)$" title)]
+    (cond
+      (and hashes (not (string/blank? text))) {:title text :level (count hashes)}
+      (re-find #"^#+\s" title) {:title (str "\\" title)}
+      :else {:title title})))
+
