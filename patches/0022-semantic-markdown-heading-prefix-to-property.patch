+                                                :children [{:uuid (str child) :title "### Child"}]}]})]
+            (is (= 201 (:status response)) (pr-str (:body response)))
+            (is (= {:title "Parent" :heading 2} (stored conn parent)))
+            (is (= {:title "Child" :heading 3} (stored conn child)))))))))
