+(defn- free-text-value?
+  "A plain string for a text (default-type) property without fixed choices. The outliner stores it
+  in a new value block, as the editor does, so it is never looked up by title: text that happens to
+  match a page title is still text. A UUID string keeps referencing an existing value. E2EE graphs
+  need client-encrypted values, so plaintext is never accepted there."
+  [property value e2ee?]
+  (and (not e2ee?)
+       (= :default (get property :logseq.property/type :default))
+       (empty? (:block/_closed-value-property property))
+       (non-blank-string? value)
+       (not (common-util/uuid-string? value))))
+
 (defn- prepare-ref-property-value [db property-ident value e2ee?]
   (let [property (d/entity db property-ident)]
-    (or (resolve-ref-entity db property-ident value)
-        (when (and (not e2ee?)
-                   (= :url (:logseq.property/type property))
-                   (empty? (:block/_closed-value-property property))
-                   (db-property-type/url? value))
-          value))))
+    (if (free-text-value? property value e2ee?)
+      value
+      (or (resolve-ref-entity db property-ident value)
+          (when (and (not e2ee?)
+                     (= :url (:logseq.property/type property))
+                     (empty? (:block/_closed-value-property property))
+                     (db-property-type/url? value))
+            value)))))
 
 (defn- prepare-property-value [db property-ident value e2ee?]
   (let [property (d/entity db property-ident)]
