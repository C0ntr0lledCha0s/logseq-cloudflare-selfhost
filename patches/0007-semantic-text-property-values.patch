+(defn- run-text-property-test! [done cardinality run]
+  (-> (with-typed-property-test :default cardinality run)
+      (p/then (fn [] (done)))
+      (p/catch (fn [error] (is false (str error)) (done)))))
+
+(deftest semantic-text-property-accepts-free-text-test
+  (async done
+    (run-text-property-test! done :db.cardinality/one
+      (fn [{:keys [conn property page-id block-ids request]}]
+        (let [value #(get (d/entity @conn [:block/uuid (first block-ids)]) (:db/ident property))]
+          (p/let [text-response (request "PUT" {:value "Quarterly planning notes"} false)
+                  _ (is (= 200 (.-status text-response)))
+                  first-value (value)
+                  _ (is (= "Quarterly planning notes" (:block/title first-value)))
+                  _ (is (= (:db/id property) (:db/id (:logseq.property/created-from-property first-value))))
+                  page-title-response (request "PUT" {:value "URL test"} false)
+                  _ (is (= 200 (.-status page-title-response)))
+                  _ (is (= "URL test" (:block/title (value))))
+                  _ (is (not= page-id (:block/uuid (value)))
+                        "text matching a page title is stored as text, not as a link to that page")
+                  uuid-response (request "PUT" {:value (str (:block/uuid first-value))} false)
+                  _ (is (= 200 (.-status uuid-response)))
+                  _ (is (= (:block/uuid first-value) (:block/uuid (value)))
+                        "a UUID still references an existing value")
+                  missing-uuid (request "PUT" {:value (str (random-uuid))} false)
+                  _ (is (= 400 (.-status missing-uuid)))
+                  encrypted (request "PUT" {:value "Plaintext in an encrypted graph"} true)]
+            (is (= 400 (.-status encrypted)) "E2EE graphs still need an existing entity")))))))
+
+(deftest semantic-text-property-batch-accepts-string-arrays-test
+  (async done
+    (run-text-property-test! done :db.cardinality/many
+      (fn [{:keys [conn property block-ids request]}]
+        (let [entry {:block-id (str (first block-ids))
+                     :property-id (str (:block/uuid property))
+                     :value ["alpha" "beta"]}
+              titles #(set (map :block/title (get (d/entity @conn [:block/uuid (first block-ids)]) (:db/ident property))))]
+          (p/let [response (request "POST" {:entries [entry]} false)]
+            (is (= 200 (.-status response)))
+            (is (= #{"alpha" "beta"} (titles)))))))))
