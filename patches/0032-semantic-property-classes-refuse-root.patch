diff --git a/deps/db-sync/test/logseq/db_sync/semantic_property_classes_root_test.cljs b/deps/db-sync/test/logseq/db_sync/semantic_property_classes_root_test.cljs
new file mode 100644
index 0000000..5f85f22
--- /dev/null
+++ b/deps/db-sync/test/logseq/db_sync/semantic_property_classes_root_test.cljs
@@ -0,0 +1,159 @@
+(ns logseq.db-sync.semantic-property-classes-root-test
+  "A property's classes can't be Root (:logseq.class/Root). The app's tag picker for a property
+  never offers Root (`:except-root-class? true`), and its value picker treats a Root-only
+  restriction as no restriction, while the server's write checks would enforce it as 'tagged nodes
+  only'. So createProperty classes and updateProperty classes.set and classes.add refuse Root up
+  front, by any form that names it (title, title in another case, UUID, ident), naming the entry,
+  and write nothing (not even the other classes in the same list). classes.remove still takes Root
+  off a property that holds it, and the other built-in classes (Page, Task) are still accepted."
+  (:require [cljs.test :refer [async deftest is testing]]
+            [clojure.string :as string]
+            [datascript.core :as d]
+            [logseq.db-sync.test-sql :as test-sql]
+            [logseq.db-sync.worker.handler.sync :as sync-handler]
+            [logseq.db.sqlite.export :as sqlite-export]
+            [promesa.core :as p]))
+
+(defn- request!
+  "One semantic API request through the real handler; returns {:status :body}."
+  [self method path body]
+  (p/let [url (str "http://localhost" path (if (string/includes? path "?") "&" "?") "graph-id=graph-1")
+          response (sync-handler/handle-http
+                    self
+                    (js/Request. url (clj->js (cond-> {:method method
+                                                       :headers {"content-type" "application/json"}}
+                                                body (assoc :body (js/JSON.stringify (clj->js body)))))))
+          text (.text response)]
+    {:status (.-status response)
+     :body (when (seq text) (js->clj (js/JSON.parse text) :keywordize-keys true))}))
+
+(defn- property-path [ident] (str "/semantic/properties/" (js/encodeURIComponent ident)))
+
+(defn- class-idents [conn ident]
+  (set (map :db/ident (:logseq.property/classes (d/entity @conn (keyword ident))))))
+
+(defn- titled [conn title]
+  (seq (d/datoms @conn :avet :block/title title)))
+
+(defn- graph!
+  "A fresh graph with the tag Client, and Root's selector forms."
+  []
+  (p/let [conn (sqlite-export/create-conn)
+          self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true}
+          client (request! self "POST" "/semantic/tags" {:title "Client"})
+          root (d/entity @conn :logseq.class/Root)]
+    (is (= "Root Tag" (:block/title root)) "Root's title")
+    {:conn conn :self self
+     :client (get-in client [:body :uuid])
+     :client-ident (keyword (get-in client [:body :ident]))
+     :forms {"title" (:block/title root)
+             "title in lower case" (string/lower-case (:block/title root))
+             "uuid" (str (:block/uuid root))
+             "ident" "logseq.class/Root"}}))
+
+(defn- run [done f]
+  (-> (p/let [g (graph!)] (f g))
+      (p/catch #(is false (str %)))
+      (p/finally done)))
+
+(defn- property! [self title]
+  (p/let [r (request! self "POST" "/semantic/properties" {:title title :type "node"})]
+    (is (= 201 (:status r)) (str "created " title))
+    (get-in r [:body :ident])))
+
+(def ^:private refusal "Root Tag is not a valid class restriction")
+
+(deftest create-property-refuses-root-test
+  (async done
+    (run done
+      (fn [{:keys [self conn client forms]}]
+        (p/doseq [[form v] forms]
+          (p/let [alone (str "alone " form)
+                  listed (str "listed " form)
+                  r1 (request! self "POST" "/semantic/properties" {:title alone :type "node" :classes [v]})
+                  r2 (request! self "POST" "/semantic/properties" {:title listed :type "node" :classes [client v]})]
+            (testing (str "createProperty classes [Root by " form "]")
+              (is (= 400 (:status r1)) (pr-str (:body r1)))
+              (is (string/includes? (str (get-in r1 [:body :error])) (str "classes 0: " refusal))
+                  (pr-str (:body r1)))
+              (is (not (titled conn alone)) "no property was created"))
+            (testing (str "createProperty classes [Client, Root by " form "]")
+              (is (= 400 (:status r2)) (pr-str (:body r2)))
+              (is (string/includes? (str (get-in r2 [:body :error])) (str "classes 1: " refusal))
+                  (pr-str (:body r2)))
+              (is (not (titled conn listed)) "no property was created"))))))))
+
+(deftest update-property-refuses-root-test
+  (async done
+    (run done
+      (fn [{:keys [self conn client forms]}]
+        ;; p/doseq takes one binding, so the cases are built with for.
+        (p/doseq [[form v mode] (for [[form v] forms mode [:set :add]] [form v mode])]
+          (p/let [ident (property! self (str "upd " form " " (name mode)))
+                  r (request! self "PATCH" (property-path ident) {:classes {mode [client v]}})]
+            (testing (str "updateProperty classes." (name mode) " [Client, Root by " form "]")
+              (is (= 400 (:status r)) (pr-str (:body r)))
+              (is (string/includes? (str (get-in r [:body :error]))
+                                    (str "classes." (name mode) " 1: " refusal))
+                  (pr-str (:body r)))
+              (is (= #{} (class-idents conn ident)) "nothing stored, not even Client"))))))))
+
+(deftest update-property-root-refused-with-type-change-and-dry-run-test
+  (async done
+    (run done
+      (fn [{:keys [self conn client client-ident]}]
+        (p/let [;; A default property made a node property in the same call: classes are judged
+                ;; on the type the call applies, and Root is still refused.
+                default-r (request! self "POST" "/semantic/properties" {:title "notes" :type "default"})
+                default-ident (get-in default-r [:body :ident])
+                typed (request! self "PATCH" (property-path default-ident)
+                                {:type "node" :classes {:set ["logseq.class/Root"]}})
+                ;; A property that already holds Client: set and add with Root leave it as it was.
+                held (property! self "held")
+                _ (request! self "PATCH" (property-path held) {:classes {:set [client]}})
+                set-r (request! self "PATCH" (property-path held) {:classes {:set ["logseq.class/Root"]}})
+                dry (request! self "PATCH" (str (property-path held) "?dry-run=true")
+                              {:classes {:add ["Root Tag"]}})]
+          (testing "type change to node with classes.set [Root]"
+            (is (= 400 (:status typed)) (pr-str (:body typed)))
+            (is (string/includes? (str (get-in typed [:body :error])) (str "classes.set 0: " refusal)))
+            (is (= :default (:logseq.property/type (d/entity @conn (keyword default-ident))))
+                "the type change wasn't written either"))
+          (testing "classes.set [Root] on a property limited to Client"
+            (is (= 400 (:status set-r)) (pr-str (:body set-r)))
+            (is (= #{client-ident} (class-idents conn held)) "Client kept, Root not stored"))
+          (testing "dry-run classes.add [Root]"
+            (is (= 400 (:status dry)) (pr-str (:body dry)))
+            (is (string/includes? (str (get-in dry [:body :error])) (str "classes.add 0: " refusal)))))))))
+
+(deftest root-other-forms-and-neighbours-test
+  (async done
+    (run done
+      (fn [{:keys [self conn]}]
+        (p/let [root (d/entity @conn :logseq.class/Root)
+                ;; Root's db id is not a selector: as a string it names no tag, as a number the
+                ;; list is refused. Either way Root isn't stored.
+                id-str (property! self "db id string")
+                r-id-str (request! self "PATCH" (property-path id-str) {:classes {:add [(str (:db/id root))]}})
+                id-num (property! self "db id number")
+                r-id-num (request! self "PATCH" (property-path id-num) {:classes {:add [(:db/id root)]}})
+                ;; Other built-in classes the app's picker offers stay accepted.
+                page-task (request! self "POST" "/semantic/properties"
+                                    {:title "page or task" :type "node" :classes ["logseq.class/Page" "Task"]})
+                ;; A property that already holds Root (written before this rule) can be cleaned up.
+                legacy (property! self "legacy")
+                _ (d/transact! conn [[:db/add (:db/id (d/entity @conn (keyword legacy)))
+                                      :logseq.property/classes (:db/id root)]])
+                removed (request! self "PATCH" (property-path legacy) {:classes {:remove ["logseq.class/Root"]}})]
+          (testing "Root by db id"
+            (is (= 400 (:status r-id-str)) (pr-str (:body r-id-str)))
+            (is (= #{} (class-idents conn id-str)))
+            (is (= 400 (:status r-id-num)) (pr-str (:body r-id-num)))
+            (is (= #{} (class-idents conn id-num))))
+          (testing "Page and Task are still valid classes"
+            (is (= 201 (:status page-task)) (pr-str (:body page-task)))
+            (is (= #{:logseq.class/Page :logseq.class/Task}
+                   (class-idents conn (get-in page-task [:body :ident])))))
+          (testing "classes.remove takes Root off a property that holds it"
+            (is (= 200 (:status removed)) (pr-str (:body removed)))
+            (is (= #{} (class-idents conn legacy)))))))))
