+;; ---------------------------------------------------------------------------------------------
+;; A service token's call, through dispatch: whose user id the DO sees
+
+(defn- capturing-do-namespace [requests]
+  #js {:idFromName (fn [graph-id] graph-id)
+       :get (fn [_]
+              #js {:fetch (fn [request]
+                            (swap! requests conj request)
+                            (p/resolved (js/Response. "{}" #js {:status 200})))})})
+
+(deftest own-for-service-token-test
+  ;; The connector calls the sync server with the graph's personal access token for every caller,
+  ;; service tokens included. Stubs the index's D1 lookups (the PAT row, graph access, the e2ee
+  ;; flag); dispatch, auth and the DO handler are real. The PAT is user A's, made by user A, so
+  ;; the actor header carries user A's id, and own counts user A's sockets.
+  (async done
+    (let [forwarded (atom [])
+          env #js {"DB" #js {}
+                   "DB_SYNC_ALLOWED_USERS" (:user-id user-a)
+                   "LOGSEQ_SYNC_DO" (capturing-do-namespace forwarded)
+                   "SEMANTIC_READ_RATE_LIMITER" #js {:limit (fn [_] (p/resolved #js {:success true}))}}
+          request (js/Request. "http://localhost/api/v1/graphs/graph-1/sync-status"
+                               #js {:method "GET"
+                                    :headers #js {"authorization" "Bearer logseq_pat_service0123456789"}})]
+      (run done
+        (fn []
+          (p/let [{:keys [self]} (seeded-graph)
+                  _ (connect! self)
+                  response (p/with-redefs [index/<personal-access-token-by-hash
+                                           (fn [_db _hash]
+                                             (p/resolved {:id "pat-1" :user-id (:user-id user-a) :graph-id "graph-1"
+                                                          :permission "read"
+                                                          :expires-at (+ (common/now-ms) 60000)}))
+                                           index/<user-has-access-to-graph? (fn [& _] (p/resolved true))
+                                           index/<graph-e2ee? (fn [& _] (p/resolved false))
+                                           index-handler/graph-access-response
+                                           (fn [& _] (throw (js/Error. "a PAT call checks access by its user")))]
+                             (dispatch/handle-worker-fetch request env))
+                  forwarded-request (first @forwarded)
+                  actor (some-> forwarded-request .-headers (.get "x-logseq-sync-actor")
+                                js/decodeURIComponent js/JSON.parse (js->clj))
+                  answer (when forwarded-request (sync-handler/handle-http self forwarded-request))
+                  body (when answer (p/let [text (.text answer)] (js->clj (js/JSON.parse text) :keywordize-keys true)))]
+            (is (= 200 (.-status response)) "a read-permission PAT reaches the route")
+            (is (= 1 (count @forwarded)))
+            (is (= "/semantic/sync-status" (some-> forwarded-request .-url js/URL. .-pathname)))
+            (is (= (:user-id user-a) (get actor "sub")) "the actor is the PAT's user, the owner")
+            (is (= expected-clients (:clients body)) (pr-str body))))))))
