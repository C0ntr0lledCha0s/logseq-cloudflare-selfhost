+;; ---------------------------------------------------------------------------------------------
+;; Counts
+
+(defn- tag! [self title]
+  (p/let [r (ok! (request! self "POST" "/semantic/tags" {:title title} :user user-a) 201)]
+    (get-in r [:body :uuid])))
+
+(defn- page! [self title]
+  (p/let [r (ok! (request! self "POST" "/semantic/pages" {:title title} :user user-a) 201)]
+    (get-in r [:body :uuid])))
+
+(defn- insert! [self target blocks]
+  (p/let [r (ok! (request! self "POST" "/semantic/block-trees" {:target-id (str target) :blocks blocks} :user user-a) 201)]
+    (get-in r [:body :blocks])))
+
+(defn- set-tags! [self id titles]
+  (ok! (request! self "PUT" (str "/semantic/blocks/" id "/properties/" (js/encodeURIComponent "block/tags"))
+                 {:value titles} :user user-a)
+       200))
+
+(defn- set-attr!
+  "Sets a datom directly on the opened graph (hide? or deleted-at, which no write route sets this way)."
+  [self id attr value]
+  (d/transact! (.-conn self) [[:db/add [:block/uuid (uuid (str id))] attr value]]))
+
+(defn- counts [response]
+  (select-keys (:body response) [:page-count :block-count :counts-include-private :e2ee]))
+
+(defn- count-fixture!
+  "Adds, on top of the graph's built-in content, what the counts must take in and leave out:
+  - counted: page Example (4 blocks: Projects, a child of it, a block holding a text property
+    value and that value block, which sits on the page too), today's journal (1 block) and the page that
+    stands for the writes' author (user A), which an authored write creates as the app does;
+  - left out: hidden page Hidden (1 block), page Recycled in the Recycle bin (1 block), page
+    Private Plans tagged Private (1 block), page Secret Plans tagged Secret, which extends
+    Private (1 block), a block tagged Private on Example with a child, a recycled block on Example,
+    tag Topic with a block on its page, and property Rating's page.
+  Returns the uuids it made."
+  [self]
+  (p/let [private-tag (tag! self "Private")
+          secret-tag (ok! (request! self "POST" "/semantic/tags" {:title "Secret" :extends ["Private"]} :user user-a) 201)
+          topic (tag! self "Topic")
+          example (page! self "Example")
+          hidden (page! self "Hidden")
+          recycled (page! self "Recycled")
+          private-page (page! self "Private Plans")
+          secret-page (page! self "Secret Plans")
+          [projects private-block recycled-block] (insert! self example [{:title "Projects" :children [{:title "a child"}]}
+                                                                         {:title "a private block" :children [{:title "under it"}]}
+                                                                         {:title "a recycled block"}])
+          [rated] (insert! self example [{:title "a rated block"}])
+          rating (ok! (request! self "POST" "/semantic/properties" {:title "Rating" :type "default"} :user user-a) 201)
+          _ (ok! (request! self "PUT" (str "/semantic/blocks/" (:uuid rated) "/properties/"
+                                           (js/encodeURIComponent (get-in rating [:body :ident])))
+                           {:value "four stars"} :user user-a) 200)
+          journal (ok! (request! self "POST" "/semantic/capture" {:blocks [{:title "a journal block"}]} :user user-a) 201)
+          _ (insert! self hidden [{:title "on a hidden page"}])
+          _ (insert! self recycled [{:title "on a recycled page"}])
+          _ (insert! self private-page [{:title "on a private page"}])
+          _ (insert! self secret-page [{:title "on a secret page"}])
+          _ (insert! self topic [{:title "on a tag page"}])
+          _ (set-tags! self private-page ["Private"])
+          _ (set-tags! self secret-page ["Secret"])
+          _ (set-tags! self (:uuid private-block) ["Private"])
+          _ (set-attr! self hidden :logseq.property/hide? true)
+          _ (set-attr! self recycled :logseq.property/deleted-at 1)
+          _ (set-attr! self (:uuid recycled-block) :logseq.property/deleted-at 1)]
+    {:example example :projects projects :journal journal
+     :tags [private-tag (get-in secret-tag [:body :uuid])]}))
+
+(deftest counts-exclude-hidden-recycled-private-test
+  (async done
+    (run done
+      (fn []
+        (p/let [{:keys [self]} (seeded-graph)
+                base (ok! (status! self :user user-a) 200)
+                _ (count-fixture! self)
+                after (ok! (status! self :user user-a) 200)]
+          (is (= {:counts-include-private false :e2ee false}
+                 (select-keys (counts after) [:counts-include-private :e2ee])))
+          ;; Hand count: pages Example, today's journal and user A's author page; blocks Projects, its
+          ;; child, the rated block, its property value block and the journal block. Nothing else in
+          ;; the fixture is counted.
+          (is (= 3 (- (get-in after [:body :page-count]) (get-in base [:body :page-count])))
+              (pr-str (counts base) (counts after)))
+          (is (= 5 (- (get-in after [:body :block-count]) (get-in base [:body :block-count])))
+              (pr-str (counts base) (counts after))))))))
+
+(deftest counts-on-e2ee-test
+  ;; On an E2EE graph, class titles are ciphertext, so Private can't be recognised: the counts take
+  ;; Private content in and say so. The Recycle bin and hidden pages are still left out.
+  (async done
+    (run done
+      (fn []
+        (p/let [{:keys [self]} (seeded-graph)
+                base (ok! (status! self :user user-a :e2ee? true) 200)
+                plain-base (ok! (status! self :user user-a) 200)
+                {:keys [tags]} (count-fixture! self)
+                ;; The tag titles as an E2EE graph stores them: not readable as "private".
+                conn (.-conn self)
+                _ (doseq [tag tags]
+                    (d/transact! conn [[:db/add [:block/uuid (uuid tag)] :block/title (str "ciphertext-" (random-uuid))]]))
+                after (ok! (status! self :user user-a :e2ee? true) 200)]
+          (is (= {:counts-include-private true :e2ee true}
+                 (select-keys (counts after) [:counts-include-private :e2ee])))
+          (is (= (counts plain-base) (assoc (counts base) :counts-include-private false :e2ee false))
+              "the same graph counts the same either way before any Private content exists")
+          ;; Hand count: the three counted pages and five blocks above, plus pages Private Plans and
+          ;; Secret Plans, their blocks, and the Private block on Example with its child.
+          (is (= 5 (- (get-in after [:body :page-count]) (get-in base [:body :page-count])))
+              (pr-str (counts base) (counts after)))
+          (is (= 9 (- (get-in after [:body :block-count]) (get-in base [:body :block-count])))
+              (pr-str (counts base) (counts after))))))))
+
+;; ---------------------------------------------------------------------------------------------
+;; Clients
+
+(def ^:private expected-clients {:connected 3 :users 2 :own 2 :others 1 :editing 1})
+
+(deftest clients-after-rebuild-test
+  (async done
+    (run done
+      (fn []
+        (p/let [{:keys [sql self]} (seeded-graph)
+                sockets (connect! self)
+                live (ok! (status! self :user user-a) 200)
+                awake (woken sql sockets)
+                after-wake (ok! (status! awake :user user-a) 200)
+                as-b (ok! (status! awake :user user-b) 200)
+                no-actor (ok! (status! awake) 200)
+                empty-do (woken sql [])
+                none (ok! (status! empty-do :user user-a) 200)]
+          (testing "live presence: user A on two sockets (one editing), user B on one; a socket that
+                    never identified a user is not in presence and isn't counted"
+            (is (= expected-clients (get-in live [:body :clients])) (pr-str (:body live))))
+          (testing "a DO rebuilt from socket attachments alone counts the same"
+            (is (= 3 (count @(presence/presence* awake))) "rebuild-presence! put back the three users' sockets")
+            (is (= expected-clients (get-in after-wake [:body :clients])) (pr-str (:body after-wake))))
+          (testing "own is the caller's sockets"
+            (is (= (assoc expected-clients :own 1 :others 2) (get-in as-b [:body :clients]))))
+          (testing "without a caller, own and others are unknown"
+            (is (= (assoc expected-clients :own nil :others nil) (get-in no-actor [:body :clients])))
+            (is (contains? (get-in no-actor [:body :clients]) :own)))
+          (testing "no sockets"
+            (is (= {:connected 0 :users 0 :own 0 :others 0 :editing 0} (get-in none [:body :clients])))))))))
+
+(deftest editing-cleared-is-not-counted-test
+  (async done
+    (run done
+      (fn []
+        (p/let [{:keys [self]} (seeded-graph)
+                [_ a2] (connect! self)
+                _ (presence/update-presence! self a2 {:editing-block-uuid nil})
+                response (ok! (status! self :user user-a) 200)]
+          (is (= 0 (get-in response [:body :clients :editing])))
+          (is (= #{} (presence/editing-block-uuids self))))))))
+
+(deftest editing-block-uuids-test
+  (let [self #js {}
+        [a1 a2 b1] (repeatedly 3 socket)
+        other (str (random-uuid))]
+    (is (= #{} (presence/editing-block-uuids self)))
+    (presence/add-presence! self a1 user-a)
+    (presence/add-presence! self a2 user-a)
+    (presence/add-presence! self b1 user-b)
+    (presence/update-presence! self a2 {:editing-block-uuid editing-uuid})
+    (presence/update-presence! self b1 {:editing-block-uuid other})
+    (is (= #{(uuid editing-uuid) (uuid other)} (presence/editing-block-uuids self)))
+    (presence/update-presence! self a1 {:editing-block-uuid editing-uuid})
+    (is (= #{(uuid editing-uuid) (uuid other)} (presence/editing-block-uuids self)) "a set: two sockets, one block")
+    (is (= {:connected 3 :users 2 :own 2 :others 1 :editing 3}
+           (presence/presence-summary self (:user-id user-a))))))
+
+(deftest no-identities-in-json-test
+  (async done
+    (run done
+      (fn []
+        (p/let [{:keys [self]} (seeded-graph)
+                _ (connect! self)
+                responses (p/all [(status! self :user user-a) (status! self :user user-b) (status! self)
+                                  (status! self :user user-a :e2ee? true)])]
+          (doseq [{:keys [status text]} responses]
+            (is (= 200 status))
+            (doseq [user [user-a user-b]
+                    value (vals user)]
+              (is (not (string/includes? text value)) (str "the response names " value)))
+            (is (not (string/includes? text editing-uuid)) "the editing block is not named")
+            (is (not (string/includes? (string/lower-case text) "example.com")))
+            (is (= #{:t :last-written-at :last-op :checksum :page-count :block-count
+                     :counts-include-private :e2ee :clients}
+                   (set (keys (js->clj (js/JSON.parse text) :keywordize-keys true))))
+                "exactly the documented fields")))))))
