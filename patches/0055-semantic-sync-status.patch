diff --git a/deps/db-sync/test/logseq/db_sync/semantic_sync_status_test.cljs b/deps/db-sync/test/logseq/db_sync/semantic_sync_status_test.cljs
new file mode 100644
index 0000000..d4b0b6b
--- /dev/null
+++ b/deps/db-sync/test/logseq/db_sync/semantic_sync_status_test.cljs
@@ -0,0 +1,491 @@
+(ns logseq.db-sync.semantic-sync-status-test
+  "getSyncStatus (patch 0055): one read-only answer for a graph's sync state. t and checksum are the
+  DO's sync_meta values (the checksum as stored, never recomputed), last-written-at and last-op the
+  tx_log row at t (null when no row holds it, as on a graph that arrived by snapshot upload), and
+  page-count and block-count what the reads show: no hidden page, nothing in the Recycle bin and,
+  except on E2EE graphs where Private can't be recognised, nothing Private. clients counts the
+  presence atom's sockets, which the DO constructor rebuilds from socket attachments after a wake;
+  it names no user and no block. Graphs here sit on a real SQLite store (better-sqlite3), so tx_log
+  and sync_meta are the ones the handler writes, and every call goes through handle-http."
+  (:require ["better-sqlite3" :as sqlite3]
+            [cljs.test :refer [async deftest is testing]]
+            [clojure.string :as string]
+            [datascript.core :as d]
+            [logseq.db-sync.checksum :as sync-checksum]
+            [logseq.db-sync.common :as common]
+            [logseq.db-sync.index :as index]
+            [logseq.db-sync.storage :as storage]
+            [logseq.db-sync.worker.dispatch :as dispatch]
+            [logseq.db-sync.worker.handler.index :as index-handler]
+            [logseq.db-sync.worker.handler.sync :as sync-handler]
+            [logseq.db-sync.worker.presence :as presence]
+            [logseq.db.frontend.schema :as db-schema]
+            [logseq.db.sqlite.create-graph :as sqlite-create-graph]
+            [promesa.core :as p]))
+
+;; ---------------------------------------------------------------------------------------------
+;; Fixture users. The DO keeps each socket's JWT claims as presence; none of this may come back.
+
+(def ^:private user-a {:user-id "0b7c2f4e-1d3a-4c5b-8e6f-7a9b0c1d2e3f" :email "user-a@example.com"
+                       :username "user-a-name" :name "User A Example"})
+(def ^:private user-b {:user-id "5e8d9a0b-2c4f-4a6e-9b1d-3f5a7c9e1b2d" :email "user-b@example.com"
+                       :username "user-b-name" :name "User B Example"})
+(def ^:private editing-uuid "9c1e3a5b-7d9f-4b2a-8c6e-0f1a2b3c4d5e")
+
+(defn- actor-header
+  "The x-logseq-sync-actor header dispatch sets from the caller's claims."
+  [user]
+  (js/encodeURIComponent
+   (js/JSON.stringify #js {"sub" (:user-id user)
+                           "cognito:username" (:username user)
+                           "email" (:email user)})))
+
+(defn- memory-sql []
+  (let [db (new sqlite3 ":memory:" nil)]
+    #js {:transaction (fn [f] ((.transaction db f)))
+         :exec (fn [sql-str & args]
+                 (let [stmt (.prepare db sql-str)]
+                   (if (string/starts-with? (-> sql-str string/trim string/lower-case) "select")
+                     (.apply (.-all stmt) stmt (to-array args))
+                     (do (.apply (.-run stmt) stmt (to-array args)) nil))))}))
+
+(defn- request!
+  "One semantic API request through the real handler; returns {:status :body :text}. Without
+  `user` it carries no actor header."
+  [self method path body & {:keys [user e2ee?]}]
+  (p/let [url (str "http://localhost" path (if (string/includes? path "?") "&" "?") "graph-id=graph-1"
+                   (when e2ee? "&graph-e2ee=true"))
+          headers (js/Headers. #js {"content-type" "application/json"})
+          _ (when user (.set headers "x-logseq-sync-actor" (actor-header user)))
+          response (sync-handler/handle-http
+                    self
+                    (js/Request. url (clj->js (cond-> {:method method :headers headers}
+                                                body (assoc :body (js/JSON.stringify (clj->js body)))))))
+          text (.text response)]
+    {:status (.-status response)
+     :text text
+     :body (when (seq text) (try (js->clj (js/JSON.parse text) :keywordize-keys true) (catch :default _ text)))}))
+
+(defn- status! [self & opts]
+  (apply request! self "GET" "/semantic/sync-status" nil opts))
+
+(defn- ok!
+  [response status]
+  (p/let [response response]
+    (assert (= status (:status response)) (pr-str response))
+    response))
+
+(defn- seeded-graph
+  "A graph created on the server (never uploaded), not yet opened: a fresh self on real SQLite."
+  []
+  (let [sql (memory-sql)
+        conn (storage/open-conn sql)]
+    (d/transact! conn (sqlite-create-graph/build-db-initial-data "{}"))
+    {:sql sql :self #js {:sql sql :conn nil :schema-ready false :env #js {"TIMEZONE" "UTC"}}}))
+
+(defn- upload-rows
+  "The kvs rows the app uploads for `client`, as <prepare-upload-temp-sqlite! makes them."
+  [client]
+  (let [sql (memory-sql)
+        _ (storage/init-schema! sql)
+        temp (d/conn-from-datoms [] (d/schema @client) {:storage (storage/new-sqlite-storage sql)})]
+    (d/transact! temp (mapv (fn [datom] [:db/add (:e datom) (:a datom) (:v datom)]) (d/datoms @client :eavt))
+                 {:initial-db? true})
+    (mapv (fn [row] [(aget row "addr") (aget row "content") (aget row "addresses")])
+          (.exec sql "select addr, content, addresses from kvs order by addr"))))
+
+(defn- uploaded-graph
+  "A graph that arrived through the snapshot upload of a fresh app graph, imported by the real
+  handler: its kvs rows only, with no tx_log row and no stored checksum."
+  []
+  (let [client (d/create-conn db-schema/schema)
+        _ (d/transact! client (sqlite-create-graph/build-db-initial-data "{}"))
+        sql (memory-sql)
+        self #js {:sql sql :conn nil :schema-ready false :env #js {"TIMEZONE" "UTC"}}]
+    (#'sync-handler/import-snapshot! self (upload-rows client) true)
+    {:sql sql :self self}))
+
+(defn- tx-log-count [sql]
+  (aget (first (.exec sql "select count(*) as n from tx_log")) "n"))
+
+(defn- tx-log-row [sql t]
+  (first (.exec sql "select created_at, outliner_op from tx_log where t = ?" t)))
+
+(defn- run [done f]
+  (-> (p/do (f))
+      (p/catch #(is false (str % (some-> % .-stack))))
+      (p/finally done)))
+
+;; ---------------------------------------------------------------------------------------------
+;; Presence: fake sockets as the Workers runtime gives them, with a real attachment store.
+
+(defn- socket
+  "A socket whose attachment round-trips as the runtime's serializeAttachment/deserializeAttachment
+  do (structured clone); `attachment` presets one, as a socket a client never identified on has."
+  ([] (socket ::none))
+  ([attachment]
+   (let [stored (atom (when-not (= ::none attachment) attachment))]
+     #js {:readyState 1
+          :serializeAttachment (fn [value] (reset! stored (js/structuredClone value)))
+          :deserializeAttachment (fn [] (some-> @stored js/structuredClone))})))
+
+(defn- connect!
+  "Sockets for user A on two clients (one editing a block), user B on one, and one socket whose
+  attachment holds no user, connected through the real presence functions."
+  [self]
+  (let [[a1 a2 b1] (repeatedly 3 socket)
+        anonymous (socket #js {})
+        never-identified (socket)]
+    (presence/add-presence! self a1 user-a)
+    (presence/add-presence! self a2 user-a)
+    (presence/add-presence! self b1 user-b)
+    (presence/update-presence! self a2 {:editing-block-uuid editing-uuid})
+    [a1 a2 b1 anonymous never-identified]))
+
+(defn- woken
+  "A fresh DO over the same storage and sockets, as after hibernation: the constructor rebuilds
+  presence from the sockets' attachments with presence/rebuild-presence!."
+  [sql sockets]
+  (let [self #js {:sql sql :conn nil :schema-ready false :env #js {"TIMEZONE" "UTC"}
+                  :state #js {:getWebSockets (fn [] (to-array sockets))}}]
+    (presence/rebuild-presence! self (.getWebSockets (.-state self)))
+    self))
+
+;; ---------------------------------------------------------------------------------------------
+;; t, last write and checksum
+
+;; Before patch 0055 there is no such route: 404.
+(deftest t-and-last-write-follow-a-write-test
+  (async done
+    (run done
+      (fn []
+        (p/let [{:keys [sql self]} (seeded-graph)
+                page (ok! (request! self "POST" "/semantic/pages" {:title "Example"} :user user-a) 201)
+                block (str (random-uuid))
+                _ (ok! (request! self "POST" "/semantic/block-trees"
+                                 {:target-id (get-in page [:body :uuid]) :blocks [{:uuid block :title "Projects"}]}
+                                 :user user-a) 201)
+                before (ok! (status! self :user user-a) 200)
+                _ (ok! (request! self "DELETE" (str "/semantic/blocks/" block) nil :user user-a) 200)
+                after (ok! (status! self :user user-a) 200)
+                t (storage/get-t sql)
+                row (tx-log-row sql t)]
+          (is (= (get-in before [:body :t]) (dec (get-in after [:body :t]))) "one delete is one transaction")
+          (is (= t (get-in after [:body :t])) "t is the DO's sync_meta t")
+          (is (= "delete-blocks" (get-in after [:body :last-op])))
+          (is (not= "delete-blocks" (get-in before [:body :last-op])))
+          (is (= (.toISOString (js/Date. (aget row "created_at"))) (get-in after [:body :last-written-at]))
+              "last-written-at is the tx_log row's created_at at t, as ISO")
+          (is (= (storage/get-checksum sql) (get-in after [:body :checksum])))
+          (is (string? (get-in after [:body :checksum])))
+          (is (false? (get-in after [:body :e2ee]))))))))
+
+(deftest last-written-at-null-on-upload-test
+  ;; The snapshot import writes kvs rows and no tx_log row. Opening the graph repairs the app's
+  ;; schema drift in one logged transaction, so the opened graph has a row at t. Two states the log
+  ;; can be in are then made directly (the stubbed steps here): t moved past the last row, and a
+  ;; log with no row at all.
+  (async done
+    (run done
+      (fn []
+        (p/let [{:keys [sql self]} (uploaded-graph)
+                rows-before-open (tx-log-count sql)
+                opened (ok! (status! self :user user-a) 200)
+                _ (storage/set-t! sql (inc (storage/get-t sql)))
+                moved (ok! (status! self :user user-a) 200)
+                _ (.exec sql "delete from tx_log")
+                emptied (ok! (status! self :user user-a) 200)]
+          (is (zero? rows-before-open) "the upload writes no tx_log row")
+          (is (string? (get-in opened [:body :last-written-at])) "the opening repair's row is at t")
+          (doseq [[label response] [["t past the last log row" moved] ["no log row at all" emptied]]]
+            (testing label
+              (is (pos? (get-in response [:body :t])))
+              (is (contains? (:body response) :last-written-at) "present, as null")
+              (is (nil? (get-in response [:body :last-written-at])))
+              (is (contains? (:body response) :last-op))
+              (is (nil? (get-in response [:body :last-op]))))))))))
+
+(deftest checksum-not-recomputed-test
+  ;; Stubs a step: the checksum recompute is redefined to throw, so an answer proves it never ran.
+  ;; Both graphs are opened first (an uploaded graph's open repairs its schema, which recomputes),
+  ;; and the second graph's stored checksum is then removed directly, the state of a graph with none.
+  (async done
+    (run done
+      (fn []
+        (p/let [{:keys [sql self]} (seeded-graph)
+                _ (ok! (request! self "POST" "/semantic/pages" {:title "Example"} :user user-a) 201)
+                stored (storage/get-checksum sql)
+                {other :self other-sql :sql} (uploaded-graph)
+                _ (ok! (status! other :user user-a) 200)
+                _ (.exec other-sql "delete from sync_meta where key = 'checksum'")
+                [with-checksum without]
+                (p/with-redefs [sync-checksum/recompute-checksum
+                                (fn [& _] (throw (js/Error. "recompute-checksum was called")))
+                                sync-checksum/recompute-checksum-diagnostics
+                                (fn [& _] (throw (js/Error. "recompute-checksum-diagnostics was called")))]
+                  (p/all [(status! self :user user-a) (status! other :user user-a)]))]
+          (is (string? stored))
+          (is (= [200 stored] [(:status with-checksum) (get-in with-checksum [:body :checksum])])
+              (pr-str with-checksum))
+          (is (= 200 (:status without)) (pr-str without))
+          (is (contains? (:body without) :checksum))
+          (is (nil? (get-in without [:body :checksum]))))))))
+
+(deftest read-only-test
+  (async done
+    (run done
+      (fn []
+        (p/let [{:keys [sql self]} (seeded-graph)
+                _ (ok! (request! self "POST" "/semantic/pages" {:title "Example"} :user user-a) 201)
+                t (storage/get-t sql)
+                rows (tx-log-count sql)
+                checksum (storage/get-checksum sql)
+                _ (ok! (status! self :user user-a) 200)
+                _ (ok! (status! self) 200)
+                _ (ok! (status! self :e2ee? true) 200)
+                post (request! self "POST" "/semantic/sync-status" {})]
+          (is (= [t rows checksum] [(storage/get-t sql) (tx-log-count sql) (storage/get-checksum sql)])
+              "no write: t, the tx_log and the checksum are unchanged")
+          (is (= 404 (:status post)) "only GET is routed"))))))
