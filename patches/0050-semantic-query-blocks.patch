+(defn query-holder
+  "The one block whose :logseq.property/query points at value block `value-id`, or nil when none or
+  more than one does."
+  [db value-id]
+  (let [holders (into #{} (map :e) (d/datoms db :avet :logseq.property/query value-id))]
+    (when (= 1 (count holders)) (first holders))))
