+;; Query blocks (patch 0050): the server can't check a query it can't read, so a query field is
+;; refused on an E2EE graph, naming the node, and nothing is written. A fence is never parsed there
+;; (titles are ciphertext), so a ```query title is stored as sent.
+;; Before the fix (Stage 1 tree) the field was ignored and the block written:
+;;   expected: (= 400 (.-status refused))  actual: (not (= 400 201))
+(deftest query-field-refused-on-e2ee-test
+  (async done
+         (-> (p/let [key (<key)
+                     conn (sqlite-export/create-conn)
+                     [_ page-id] (outliner-page/create! conn "Disposable" {})
+                     ctx (self conn)
+                     caption (<encrypt key "zq Books")
+                     fence (<encrypt key "```query\n{:query [:find ?b :where [?b :block/title]]}\n```")
+                     before [(:max-tx @conn) (count (d/datoms @conn :eavt))]
+                     refused (sync/handle-http ctx (request "/semantic/block-trees" "POST"
+                                                            {:target-id (str page-id)
+                                                             :blocks [{:title caption
+                                                                       :query "{:query [:find ?b :where [?b :block/title]]}"}]}))
+                     refused-body (.json refused)
+                     after [(:max-tx @conn) (count (d/datoms @conn :eavt))]
+                     id (random-uuid)
+                     stored (sync/handle-http ctx (request "/semantic/block-trees" "POST"
+                                                           {:target-id (str page-id) :blocks [{:uuid (str id) :title fence}]}))
+                     stored-body (js->clj (.json stored) :keywordize-keys true)
+                     block (d/entity @conn [:block/uuid id])]
+               (is (= 400 (.-status refused)))
+               (is (= "blocks[0]: query: not on an E2EE graph" (aget refused-body "error")))
+               (is (= before after) "nothing written")
+               (is (= 201 (.-status stored)) (pr-str stored-body))
+               (is (= fence (:block/title block)) "the fence's package is stored as sent")
+               (is (empty? (:block/tags block)))
+               (is (nil? (:logseq.property/query block)))
+               (is (not-any? #(contains? (get-in stored-body [:blocks 0]) %) [:query :converted])))
+             (p/catch #(is false (str %)))
+             (p/finally done))))
