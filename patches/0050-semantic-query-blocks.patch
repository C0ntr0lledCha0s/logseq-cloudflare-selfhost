+                  caption (update! self qb {:title "zq caption"})]
+            (testing label
+              (if (= :both target-of)
+                (refused-409 conn before caption (reason-of qb) "caption")
+                ;; The Query block itself still holds the marker, so its caption may change.
+                (ok-200 caption "caption of the marked holder")))))
+        (p/catch #(is false (str "unexpected error: " % (some-> % .-stack))))
+        (p/finally done))))
