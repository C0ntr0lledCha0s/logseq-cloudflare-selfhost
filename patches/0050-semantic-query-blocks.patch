+;; ---------------------------------------------------------------------------------------------
+;; Stage 2: inserts make Query blocks. Every case goes through handle-http on a graph whose page
+;; Notes already holds block A, so the new blocks' order keys are checked against an existing one.
+
+(def ^:private book-fence (str "```query\n" book-query "\n```"))
+(def ^:private simple-reason "only an advanced query ({:query [...]}) becomes a Query block; a simple query stays text")
+(def ^:private update-reason "update_block doesn't make Query blocks; insert one")
+(def ^:private rules-text (str "{:query [:find ?b :where [?b :block/title]] :rules [[(r ?b) [?b :block/title]]]}"))
+(def ^:private rule-call-text "{:query [:find ?b :where [?b :block/title] (task ?b #{\"todo\"})]}")
+
+(defn- tree! [self target blocks & {:keys [query extra]}]
+  (request! self "POST" (str "/semantic/block-trees" query) (merge {:target-id (str target) :blocks blocks} extra)))
+
+(defn- children! [self parent blocks & {:keys [query extra]}]
+  (request! self "POST" (str "/semantic/blocks/" parent "/children" query) (merge {:position "append" :blocks blocks} extra)))
+
+(defn- batch! [self entries & {:keys [query extra]}]
+  (request! self "POST" (str "/semantic/block-trees/batch" query) (merge {:entries entries} extra)))
+
+(defn- capture! [self blocks & {:keys [query]}]
+  (request! self "POST" (str "/semantic/capture" query) {:blocks blocks}))
+
+(defn- update! [self id body & {:keys [query]}]
+  (request! self "PATCH" (str "/semantic/blocks/" id query) body))
+
+(defn- snapshot [conn]
+  {:max-tx (:max-tx @conn) :datoms (count (d/datoms @conn :eavt))})
+
+(defn- held
+  "What block `id` (a uuid or its string) holds, from :eavt (stored-query-block)."
+  [conn id]
+  (let [db @conn]
+    (some->> (d/entity db [:block/uuid (uuid (str id))]) :db/id (stored-query-block db))))
+
+(defn- query-block [title text]
+  {:title title :tags #{:logseq.class/Query}
+   :values [{:text text :display-type :code :lang "clojure" :from :logseq.property/query}]
+   :sorting nil})
+
+(defn- runs-in-the-app?
+  "The app's own test of a stored query (block.cljs query-result, execute-custom-query): it reads the
+  value block's title with safe-read-string, and runs a map whose :query is a vector starting :find."
+  [text]
+  (let [form (common-util/safe-read-string text)]
+    (and (map? form) (vector? (:query form)) (= :find (first (:query form))))))
+
+(defn- sibling-orders
+  "The :block/order keys of the blocks on the page with uuid `page`, grouped by parent, read from
+  :avet and :eavt. Order keys are relative to siblings, so a first child may share a top-level key."
+  [db page]
+  (let [page-id (:db/id (d/entity db [:block/uuid page]))]
+    (->> (d/datoms db :avet :block/page page-id)
+         (map :e)
+         (group-by #(datom-v db % :block/parent))
+         vals
+         (map (fn [es] (keep #(datom-v db % :block/order) es))))))
+
+(defn- distinct-orders?
+  "Whether no two siblings on the page share an order key, and the page has more than one block."
+  [db page]
+  (let [groups (sibling-orders db page)]
+    (and (< 1 (count (apply concat groups)))
+         (every? #(or (empty? %) (apply distinct? %)) groups))))
+
+(defn- refused-unchanged
+  "Asserts `response` is a 400 with `error`, and that `before` (a snapshot) still holds."
+  [conn before response error label]
+  (is (= 400 (:status response)) (str label ": " (pr-str (:body response))))
+  (is (= error (get-in response [:body :error])) label)
+  (is (= before (snapshot conn)) (str label ": nothing written")))
+
+(defn- tag! [self title]
+  (p/let [response (request! self "POST" "/semantic/tags" {:title title})]
+    (is (= 201 (:status response)) (pr-str (:body response)))
+    (get-in response [:body :uuid])))
+
+;; Before the fix (Stage 1 tree), the repro's 201 with kept and an untagged block:
+;;   FAIL in (fence-converts-each-tool-test) insert_block_tree: the response
+;;   expected: (= ["query" book-query] ...)  actual: (not (= ["query" "{:query ...}"] [nil nil]))
+;;   kept [{:path "blocks[0]", :reason "query fences stay text; a Query block is not supported yet"}]
+;;   expected: (= (query-block "" book-query) (held conn id))
+;;   actual: {:title "```query\n{:query ...}\n```", :tags #{}, :values [], :sorting nil}
+(deftest fence-converts-each-tool-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self notes a]}]
+        (p/let [[tree-id child-id capture-id b1 b2] (repeatedly 5 random-uuid)
+                tree (tree! self notes [{:uuid (str tree-id) :title book-fence}])
+                child (children! self a [{:uuid (str child-id) :title book-fence}])
+                captured (capture! self [{:uuid (str capture-id) :title book-fence}])
+                batch (batch! self [{:target-id (str notes) :blocks [{:uuid (str b1) :title book-fence}]}
+                                    {:page "Notes" :blocks [{:uuid (str b2) :title book-fence}]}])]
+          (doseq [[op response id block] [["insert_block_tree" tree tree-id (get-in tree [:body :blocks 0])]
+                                          ["insert_block_children" child child-id (get-in child [:body :blocks 0])]
+                                          ["capture_to_today" captured capture-id (get-in captured [:body :blocks 0])]
+                                          ["batch_insert_block_trees, entry 0" batch b1 (get-in batch [:body :entries 0 :blocks 0])]
+                                          ["batch_insert_block_trees, entry 1" batch b2 (get-in batch [:body :entries 1 :blocks 0])]]]
+            (is (= 201 (:status response)) (str op ": " (pr-str (:body response))))
+            (is (= ["query" book-query ""] ((juxt :converted :query :title) block)) (str op ": the response"))
+            (is (not (contains? (:body response) :kept)) (str op ": nothing kept"))
+            (is (= (query-block "" book-query) (held conn id)) (str op ": a Query block, read from :eavt"))
+            (is (runs-in-the-app? (-> (held conn id) :values first :text)) (str op ": the app reads a :find vector")))
+          (testing "order keys stay distinct on a page that already had a block"
+            (is (distinct-orders? @conn notes))
+            (is (some? (d/entity @conn [:block/uuid a])))))))))
+
+;; Before the fix (Stage 1 tree) the field was ignored and the block stored as plain text:
+;;   expected: (= (query-block "zq Books" book-query) (held conn id))
+;;   actual: {:title "zq Books", :tags #{}, :values [], :sorting nil}
+(deftest field-converts-each-tool-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self notes a]}]
+        (p/let [ids (repeatedly 4 random-uuid)
+                node (fn [id] [{:uuid (str id) :title "zq Books" :query book-query}])
+                [t c k b] ids
+                tree (tree! self notes (node t) :query "?verbose=false")
+                child (children! self a (node c) :query "?verbose=false")
+                captured (capture! self (node k) :query "?verbose=false")
+                batch (batch! self [{:target-id (str notes) :blocks (node b)}] :query "?verbose=false")]
+          (p/do
+          (doseq [[op response id block] [["insert_block_tree" tree t (get-in tree [:body :blocks 0])]
+                                          ["insert_block_children" child c (get-in child [:body :blocks 0])]
+                                          ["capture_to_today" captured k (get-in captured [:body :blocks 0])]
+                                          ["batch_insert_block_trees" batch b (get-in batch [:body :entries 0 :blocks 0])]]]
+            (is (= 201 (:status response)) (str op ": " (pr-str (:body response))))
+            (is (= {:uuid (str id) :query book-query} block)
+                (str op ": verbose=false still answers the uuid and the query, not converted"))
+            (is (= (query-block "zq Books" book-query) (held conn id)) (str op ": the caption is kept")))
+          (testing "a :title in the map and a caption on the node are both stored, not compared"
+            (p/let [id (random-uuid)
+                    text "{:query [:find ?b :where [?b :block/title]] :title \"zq In the map\"}"
+                    response (tree! self notes [{:uuid (str id) :title "zq Caption" :query text}])]
+              (is (= 201 (:status response)) (pr-str (:body response)))
+              (is (= (query-block "zq Caption" text) (held conn id)))
+              (is (= text (get-in response [:body :blocks 0 :query])))
+              (is (not (contains? (get-in response [:body :blocks 0]) :converted)))))
+          (testing "an inline #Query or #Code in a caption is escaped as text (a built-in tag never resolves inline), so the block converts with no other tag"
+            (p/let [[q c] (repeatedly 2 random-uuid)
+                    response (tree! self notes [{:uuid (str q) :title "zq Q #Query" :query book-query}
+                                                {:uuid (str c) :title "zq C #Code" :query book-query}])]
+              (is (= 201 (:status response)) (pr-str (:body response)))
+              (is (= (query-block "zq Q \\#Query" book-query) (held conn q)))
+              (is (= (query-block "zq C \\#Code" book-query) (held conn c)))))
+          (testing "a field node with a tag and an inline tag keeps them beside Query (the tag check catches only Query, Code, Math and Quote)"
+            (p/let [book (tag! self "Book")
+                    id (random-uuid)
+                    response (tree! self notes [{:uuid (str id) :title "zq Books #Book" :query book-query
+                                                 :properties {"Tags" ["Book"]}}])
+                    stored (held conn id)]
+              (is (= 201 (:status response)) (pr-str (:body response)))
+              (is (= #{:logseq.class/Query (:db/ident (d/entity @conn [:block/uuid (uuid book)]))} (:tags stored)))
+              (is (= [book-query] (map :text (:values stored))))))))))))
+
+(defn- refusal-cases
+  "Each case: a label, the call (a fn of self, notes, a), and the error it must answer."
+  [book-uuid query-uuid]
+  (let [q book-query
+        rules-reason* (str "query: :rules is not accepted; " rules-reason)
+        node (fn [m] [(merge {:title "zq Q"} m)])
+        tree (fn [blocks] (fn [self notes _] (tree! self notes blocks)))]
+    [[":rules in a field" (tree (node {:query rules-text})) (str "blocks[0]: " rules-reason*)]
+     ["a rule call in a fence" (tree [{:title (str "```query\n" rule-call-text "\n```")}])
+      (str "blocks[0]: query: where 2: (task …) calls a rule; " rules-reason)]
+     [":view in a field" (tree (node {:query "{:query [:find ?b :where [?b :block/title]] :view (fn [r] r)}"}))
+      "blocks[0]: query: :view is not accepted; it runs as code in the app"]
+     ["map-form :query in a fence" (tree [{:title "```query\n{:query {:find [?b] :where [[?b :block/title]]}}\n```"}])
+      (str "blocks[0]: " give-vector)]
+     ["4,001 characters" (tree (node {:query (padded 4001)})) "blocks[0]: query: at most 4,000 characters (got 4,001)"]
+     ["a fence that opens a map but isn't one" (tree [{:title "```query\n{:query\n```"}]) ::query-prefixed]
+     ["a fence map with no :query" (tree [{:title "```query\n{:title \"zq x\"}\n```"}]) (str "blocks[0]: " give-vector)]
+     ["nested" (tree [{:title "p" :children [{:title "a"} {:title "b" :query rules-text}]}])
+      (str "blocks[0].children[1]: " rules-reason*)]
+     ["a batch: a valid Query entry first, the bad one third"
+      (fn [self notes _] (batch! self [{:target-id (str notes) :blocks (node {:query q})}
+                                       {:page "Notes" :blocks [{:title book-fence}]}
+                                       {:target-id (str notes) :blocks (node {:query rules-text})}]))
+      (str "entries[2].blocks[0]: " rules-reason*)]
+     ["a batch, reversed: the bad one first"
+      (fn [self notes _] (batch! self [{:target-id (str notes) :blocks (node {:query rules-text})}
+                                       {:page "Notes" :blocks [{:title book-fence}]}
+                                       {:target-id (str notes) :blocks (node {:query q})}]))
+      (str "entries[0].blocks[0]: " rules-reason*)]
+     ["insert_block_children" (fn [self _ a] (children! self a (node {:query rules-text})))
+      (str "blocks[0]: " rules-reason*)]
+     ["capture" (fn [self _ _] (capture! self (node {:query rules-text}))) (str "blocks[0]: " rules-reason*)]
+     ;; capture_to_today makes today's journal before prepare-tree runs, so only
+     ;; query-tree-refusal's recursion into children keeps these from writing it.
+     ["capture, nested" (fn [self _ _] (capture! self [{:title "p" :children [{:title "zq c" :query rules-text}]}]))
+      (str "blocks[0].children[0]: " rules-reason*)]
+     ["capture, a grandchild after a sibling"
+      (fn [self _ _] (capture! self [{:title "p" :children [{:title "a"}
+                                                            {:title "b" :children [{:title "zq c" :query rules-text}]}]}]))
+      (str "blocks[0].children[1].children[0]: " rules-reason*)]
+     ["a field and an advanced fence" (tree [{:title book-fence :query q}]) "blocks[0]: query: given both as a field and as a fence"]
+     ["a field and a simple fence" (tree [{:title "```query\n(task todo)\n```" :query q}])
+      "blocks[0]: query: given both as a field and as a fence"]
+     ["display-type" (tree (node {:query q :display-type "code"})) "blocks[0]: query: a Query block takes no display-type or lang"]
+     ["lang" (tree (node {:query q :lang "clojure"})) "blocks[0]: query: a Query block takes no display-type or lang"]
+     ["display-type in properties" (tree (node {:query q :properties {"logseq.property.node/display-type" "code"}}))
+      "blocks[0]: query: a Query block takes no display-type or lang"]
+     ["Node Display Type in properties" (tree (node {:query q :properties {"Node Display Type" "quote"}}))
+      "blocks[0]: query: a Query block takes no display-type or lang"]
+     ["lang in properties" (tree (node {:query q :properties {"logseq.property.code/lang" "clojure"}}))
+      "blocks[0]: query: a Query block takes no display-type or lang"]
+     ["a fence with display-type" (tree [{:title book-fence :display-type "code"}])
+      "blocks[0]: query: a Query block takes no display-type or lang"]
+     ["a field whose caption is a code fence" (tree [{:title "```python\nprint(1)\n```" :query q}])
+      "blocks[0]: query: a Query block takes no display-type or lang"]
+     ["Query by title in properties" (tree (node {:query q :properties {"Tags" ["Query"]}}))
+      "blocks[0]: query: the Query tag is set by the query field"]
+     ["Query by ident in properties" (tree (node {:query q :properties {"Tags" "logseq.class/Query"}}))
+      "blocks[0]: query: the Query tag is set by the query field"]
+     ["Query by uuid, after a valid tag" (tree (node {:query q :properties {"block/tags" ["Book" (str query-uuid)]}}))
+      "blocks[0]: query: the Query tag is set by the query field"]
+     ["Query on a fence-made block" (tree [{:title book-fence :properties {"Tags" ["Query"]}}])
+      "blocks[0]: query: the Query tag is set by the query field"]
+     ["Code in properties" (tree (node {:query q :properties {"Tags" ["Code"]}}))
+      "blocks[0]: query: the Query tag is set by the query field"]
+     ["Math in properties" (tree (node {:query q :properties {"Tags" ["Math"]}}))
+      "blocks[0]: query: the Query tag is set by the query field"]
+     ["Quote in properties, after Book by uuid" (tree (node {:query q :properties {"Tags" [(str book-uuid) "Quote"]}}))
+      "blocks[0]: query: the Query tag is set by the query field"]
+     ;; Starts with {, so it is read as an advanced query and checked, not kept as a simple one.
+     ["a {{query}} macro in a fence" (tree [{:title "```query\n{{query (task todo)}}\n```"}]) ::query-prefixed]
+     ["a number field" (tree (node {:query 3})) (str "blocks[0]: " give-map)]
+     ["a map field" (tree (node {:query {:query "[:find ?b]"}})) (str "blocks[0]: " give-map)]
+     ["a null field" (tree (node {:query nil})) (str "blocks[0]: " give-map)]
+     ["a list field" (tree (node {:query [book-query]})) (str "blocks[0]: " give-map)]]))
+
+;; Before the fix (Stage 1 tree) every case was written:
+;;   FAIL in (query-refusals-test) :rules in a field
+;;   expected: (= 400 (:status response))  actual: (not (= 400 201))
+(deftest query-refusals-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self notes a]}]
+        (p/let [book (tag! self "Book")
+                query-uuid (:block/uuid (d/entity @conn :logseq.class/Query))]
+          (p/doseq [[label call error] (refusal-cases book query-uuid)]
+            (p/let [before (snapshot conn)
+                    response (call self notes a)]
+              (if (= ::query-prefixed error)
+                (do (is (= 400 (:status response)) (str label ": " (pr-str (:body response))))
+                    (is (string/starts-with? (str (get-in response [:body :error])) "blocks[0]: query: ") label)
+                    (is (= before (snapshot conn)) (str label ": nothing written")))
+                (refused-unchanged conn before response error label)))))))))
+
+;; Before the fix (Stage 1 tree) the (task todo) fence was kept with the old reason, and an advanced
+;; fence on update_block was kept with it too:
+;;   expected: [{:path "blocks[0]", :reason simple-reason}]
+;;   actual: [{:path "blocks[0]", :reason "query fences stay text; a Query block is not supported yet"}]
+(deftest simple-fences-stay-text-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self notes a]}]
+        (p/do
+          (p/doseq [[label title] [["(task todo)" "```query\n(task todo)\n```"]
+                                   ["a string" "```query\n\"text\"\n```"]
+                                   ["an empty fence" "```query\n```"]]]
+            (p/let [id (random-uuid)
+                    response (tree! self notes [{:uuid (str id) :title title}])]
+              (is (= 201 (:status response)) (str label ": " (pr-str (:body response))))
+              (is (= [{:path "blocks[0]" :reason simple-reason}] (get-in response [:body :kept])) label)
+              (is (= {:title title :tags #{} :values [] :sorting nil} (held conn id)) (str label ": stored as text"))
+              (is (not-any? #(contains? (get-in response [:body :blocks 0]) %) [:query :converted]) label)))
+          (testing "convert-fences=false keeps an advanced fence, valid or not, while a field on the same call converts"
+            (p/let [[valid invalid field] (repeatedly 3 random-uuid)
+                    bad-fence "```query\n{:query [:find ?b :where [?b :block/title]] :view 1}\n```"
+                    response (tree! self notes [{:uuid (str valid) :title book-fence}
+                                                {:uuid (str invalid) :title bad-fence}
+                                                {:uuid (str field) :title "zq Field" :query book-query}]
+                                    :query "?convert-fences=false")]
+              (is (= 201 (:status response)) (pr-str (:body response)))
+              (is (not (contains? (:body response) :kept)))
+              (is (= {:title book-fence :tags #{} :values [] :sorting nil} (held conn valid)))
+              (is (= {:title bad-fence :tags #{} :values [] :sorting nil} (held conn invalid)))
+              (is (= (query-block "zq Field" book-query) (held conn field)))
+              (is (= book-query (get-in response [:body :blocks 2 :query])))))
+          (testing "update_block keeps an advanced fence as text with its own reason, and a simple one with the insert's"
+            (p/let [r1 (tree! self notes [{:title "zq to update"}])
+                    r2 (tree! self notes [{:title "zq to update 2"}])
+                    id (get-in r1 [:body :blocks 0 :uuid])
+                    id2 (get-in r2 [:body :blocks 0 :uuid])
+                    updated (update! self id {:title book-fence})
+                    simple (update! self id2 {:title "```query\n(task todo)\n```"})]
+              (is (= 200 (:status updated)) (pr-str (:body updated)))
+              (is (= [{:path "title" :reason update-reason}] (get-in updated [:body :kept])))
+              (is (not-any? #(contains? (:body updated) %) [:query :converted]))
+              (is (= {:title book-fence :tags #{} :values [] :sorting nil} (held conn id)))
+              (is (= 200 (:status simple)) (pr-str (:body simple)))
+              (is (= [{:path "title" :reason simple-reason}] (get-in simple [:body :kept])))
+              (is (some? a)))))))))
+
+;; Before the fix (Stage 1 tree) the dry run kept the fence and ignored the field:
+;;   expected: (= ["query" book-query] ...)  actual: [nil nil]
+(deftest query-dry-run-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self notes a]}]
+        (p/let [before (snapshot conn)
+                body {:dry-run true}
+                tree (tree! self notes [{:title book-fence}] :extra body)
+                child (children! self a [{:title "zq Field" :query book-query}] :extra body)
+                batch (batch! self [{:target-id (str notes) :blocks [{:title book-fence}]}] :extra body)]
+          (doseq [[op response block expected]
+                  [["insert_block_tree" tree (get-in tree [:body :blocks 0]) ["query" book-query]]
+                   ["insert_block_children" child (get-in child [:body :blocks 0]) [nil book-query]]
+                   ["batch_insert_block_trees" batch (get-in batch [:body :entries 0 :blocks 0]) ["query" book-query]]]]
+            (is (= 200 (:status response)) (str op ": " (pr-str (:body response))))
+            (is (true? (get-in response [:body :dry-run])) op)
+            (is (= expected ((juxt :converted :query) block)) (str op ": the conversion and the query")))
+          (is (= before (snapshot conn)) "a dry run writes nothing")
+          (p/let [refused (tree! self notes [{:title "zq" :query rules-text}] :extra body)
+                  refused-batch (batch! self [{:target-id (str notes) :blocks [{:title "zq" :query rules-text}]}] :extra body)]
+            (refused-unchanged conn before refused (str "blocks[0]: query: :rules is not accepted; " rules-reason) "dry run")
+            (refused-unchanged conn before refused-batch
+                               (str "entries[0].blocks[0]: query: :rules is not accepted; " rules-reason) "batch dry run")))))))
+
+;; Before the fix (Stage 1 tree) each shape was stored as text and kept:
+;;   expected: (= (query-block "" book-query) (held conn id))  actual: {:title "  ```query\n ...", :tags #{} ...}
+(deftest query-fence-shapes-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self notes]}]
+        (p/do
+          (p/doseq [[label title text]
+                    [["surrounding whitespace" (str "  ```query\n   " book-query "  \n```  \n") book-query]
+                     ["CRLF line endings" (str "```query\r\n" book-query "\r\n```\r\n") book-query]
+                     ["```QUERY" (str "```QUERY\n" book-query "\n```") book-query]
+                     ["two lines" "```query\n{:query [:find ?b\n :where [?b :block/title]]}\n```"
+                      "{:query [:find ?b\n :where [?b :block/title]]}"]]]
+            (p/let [id (random-uuid)
+                    response (tree! self notes [{:uuid (str id) :title title}])]
+              (is (= 201 (:status response)) (str label ": " (pr-str (:body response))))
+              (is (= (query-block "" text) (held conn id)) label)
+              (is (= text (get-in response [:body :blocks 0 :query])) (str label ": no trailing newline"))))
+          (testing "a uuid that already exists (a retried insert) is reused as it is: no Query write"
+            (p/let [id (random-uuid)
+                    first-write (tree! self notes [{:uuid (str id) :title "zq plain"}])
+                    retried (tree! self notes [{:uuid (str id) :title "zq plain" :query book-query}])
+                    fence-retry (tree! self notes [{:uuid (str id) :title book-fence}])]
+              (is (= 201 (:status first-write)))
+              (doseq [[label response] [["field" retried] ["fence" fence-retry]]]
+                (is (= 201 (:status response)) (str label ": " (pr-str (:body response))))
+                (is (not-any? #(contains? (get-in response [:body :blocks 0]) %) [:query :converted]) label))
+              (is (= {:title "zq plain" :tags #{} :values [] :sorting nil} (held conn id)))))
+          (testing "a re-sent Query insert with its uuid is reused, and the block stays one Query block"
+            (p/let [id (random-uuid)
+                    blocks [{:uuid (str id) :title "zq Again" :query book-query}]
+                    first-write (tree! self notes blocks)
+                    resent (tree! self notes blocks)]
+              (is (= 201 (:status first-write)))
+              (is (= 201 (:status resent)) (pr-str (:body resent)))
+              (is (= (query-block "zq Again" book-query) (held conn id)))))
+          (testing "a Query node with children, and one nested as a child"
+            (p/let [[parent child grandchild] (repeatedly 3 random-uuid)
+                    response (tree! self notes [{:uuid (str parent) :title "zq Parent" :query book-query
+                                                 :children [{:uuid (str child) :title book-fence
+                                                             :children [{:uuid (str grandchild) :title "zq leaf"}]}]}])
+                    db @conn]
+              (is (= 201 (:status response)) (pr-str (:body response)))
+              (is (= (query-block "zq Parent" book-query) (held conn parent)))
+              (is (= (query-block "" book-query) (held conn child)))
+              (is (= ["query" book-query] ((juxt :converted :query) (get-in response [:body :blocks 0 :children 0]))))
+              (is (= parent (get-in (d/entity db [:block/uuid child]) [:block/parent :block/uuid])))
+              (is (= child (get-in (d/entity db [:block/uuid grandchild]) [:block/parent :block/uuid])))
+              (is (distinct-orders? db notes))))
+          (testing "a nested Query node's refusal names its path"
+            (p/let [before (snapshot conn)
+                    response (tree! self notes [{:title "p" :query book-query :children [{:title "c" :query rules-text}]}])]
+              (refused-unchanged conn before response
+                                 (str "blocks[0].children[0]: query: :rules is not accepted; " rules-reason) "nested"))))))))
+
+;; Before the fix (Stage 1 tree) the fence was kept as text on the uploaded graph too:
+;;   expected: (= (query-block "" book-query) (held conn id))  actual: {:title "```query\n...", :tags #{} ...}
+(deftest query-upload-path-test
+  (async done
+    (#'uploaded/with-uploaded
+     done
+     (fn [{:keys [conn self]}]
+       (p/let [[page-id] (#'uploaded/notes-page! self)
+               id (random-uuid)
+               response (request! self "POST" "/semantic/block-trees"
+                                  {:target-id page-id :blocks [{:uuid (str id) :title book-fence}]})]
+         (is (= 201 (:status response)) (pr-str (:body response)))
+         (is (= (query-block "" book-query) (held conn id)))
+         (is (= ["query" book-query] ((juxt :converted :query) (get-in response [:body :blocks 0])))))))))
+
+;; The contract: the query field on every tree node, the response fields, and the four insert
+;; operations' and updateBlock's descriptions.
+;; Before the fix (Stage 1 tree):
+;;   expected: (= {:type "string" :maxLength 4000} ...)  actual: (not (= {...} {:type nil :maxLength nil}))
+(deftest openapi-query-blocks-test
+  (let [document (semantic-routes/openapi-document "https://issuer.example")
+        schemas (get-in document [:components :schemas])
+        description (fn [path method] (get-in document [:paths path method :description]))]
+    (is (= {:type "string" :maxLength 4000} (select-keys (get-in schemas [:BlockTree :properties :query]) [:type :maxLength])))
+    (is (= ["fence" "query"] (get-in schemas [:InsertedBlock :properties :converted :enum])))
+    (is (= "string" (get-in schemas [:InsertedBlock :properties :query :type])))
+    (doseq [path ["/api/v1/graphs/{graph-id}/block-trees" "/api/v1/graphs/{graph-id}/blocks/{block-id}/children"
+                  "/api/v1/graphs/{graph-id}/block-trees/batch" "/api/v1/graphs/{graph-id}/capture"]
+            phrase ["becomes a Query block" "checked as datalog_query checks a query" "converted: query"
+                    "also with verbose=false" "a simple ```query fence stays text" "not on the server"
+                    "Private filter don't apply there" "query field on an E2EE graph"]]
+      (is (string/includes? (description path :post) phrase) (str path ": " phrase)))
+    (is (string/includes? (description "/api/v1/graphs/{graph-id}/blocks/{block-id}" :patch)
+                          "updateBlock doesn't make Query blocks"))))
+
+;; The read-back is wired to the insert: when it finds a gap, the call answers 500 naming the node's
+;; path and the transaction is rolled back. A correct write always reads back, so the read-back is
+;; replaced here by one that reports a gap; the outliner, the handler and the graph are real.
+;; Before the fix (Stage 1 tree) nothing read a Query block back on insert:
+;;   expected: (= 500 (:status response))  actual: (not (= 500 201))
+(deftest query-read-back-failure-rolls-back-test
+  (async done
+    (let [real semantic/read-back-query-block]
+      (with-graph (fn [] (set! semantic/read-back-query-block real) (done))
+        (fn [{:keys [conn self notes a]}]
+          (set! semantic/read-back-query-block (fn [& _] ["the block is not tagged Query"]))
+          (p/let [before (snapshot conn)
+                  holders #(count (d/datoms @conn :aevt :logseq.property/query))
+                  holders-before (holders)
+                  tree (tree! self notes [{:title "p" :children [{:title "zq Q" :query book-query}]}])
+                  batch (batch! self [{:target-id (str a) :blocks [{:title "zq B" :query book-query}]}])
+                  after-batch (snapshot conn)
+                  captured (capture! self [{:title book-fence}])]
+            (doseq [[label response path] [["insert_block_tree" tree "blocks[0].children[0]"]
+                                           ["batch_insert_block_trees" batch "entries[0].blocks[0]"]]]
+              (is (= 500 (:status response)) (str label ": " (pr-str (:body response))))
+              (is (= (str "the write did not store what was asked: " path ": the block is not tagged Query")
+                     (get-in response [:body :error])) label))
+            (is (= before after-batch) "the inserts were rolled back")
+            ;; capture_to_today makes today's journal in its own write first, as it always has.
+            (is (= 500 (:status captured)) (pr-str (:body captured)))
+            (is (= holders-before (holders)) "capture stored no Query block")))))))
+
+;; The class sweep: the new node checks look only at Tags and the display properties. A Query node
+;; carrying a value of every other property kind (text, number, checkbox, URL, node, a datetime and
+;; a choice) is written with each value, beside the Query tag and its query.
+;; Before the fix (Stage 1 tree) the field was ignored, so the block held the values but no query:
+;;   expected: #{:logseq.class/Query :logseq.class/Task}  actual: #{:logseq.class/Task}
+(deftest query-node-keeps-every-other-property-kind-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self notes]}]
+        (p/let [props (p/all (map (fn [[title type]]
+                                    (p/let [r (request! self "POST" "/semantic/properties" {:title title :type type})]
+                                      (is (= 201 (:status r)) (pr-str (:body r)))
+                                      [title (keyword "user.property" (last (string/split (get-in r [:body :ident]) #"/")))]))
+                                  [["zqText" "default"] ["zqNum" "number"] ["zqDone" "checkbox"]
+                                   ["zqLink" "url"] ["zqRef" "node"]]))
+                id (random-uuid)
+                response (tree! self notes [{:uuid (str id) :title "zq Props" :query book-query
+                                             :properties {"zqText" "x" "zqNum" 3 "zqDone" true
+                                                          "zqLink" "https://example.com/a" "zqRef" "Notes"
+                                                          "logseq.property/deadline" 1767225600000
+                                                          "logseq.property/priority" "High"}}])
+                db @conn
+                block (d/entity db [:block/uuid id])
+                value (fn [ident] (let [v (get block ident)]
+                                    (if (de/entity? v)
+                                      (or (:db/ident v) (:logseq.property/value v) (:block/title v))
+                                      v)))]
+          (is (= 201 (:status response)) (pr-str (:body response)))
+          ;; Priority adds the outliner's implicit Task tag, as it does on any block.
+          (is (= #{:logseq.class/Query :logseq.class/Task} (:tags (held conn id))))
+          (is (= [book-query] (map :text (:values (held conn id)))))
+          (is (= {"zqText" "x" "zqNum" 3 "zqDone" true "zqLink" "https://example.com/a" "zqRef" "Notes"}
+                 (into {} (map (fn [[title ident]] [title (value ident)]) props))))
+          (is (= 1767225600000 (value :logseq.property/deadline)))
+          (is (= :logseq.property/priority.high (value :logseq.property/priority))))))))
+
+;; ---------------------------------------------------------------------------------------------
+;; Stage 3: the property paths are closed. logseq.property/query and the Query tag are refused on
+;; set_block_property, batch_set_block_property, a node's properties and a batch entry's page
+;; properties, naming the entry, and nothing is written. Query is a tag the server keeps, so a
+;; reset can't strip it and the batch class check's final-tags agrees; the delete paths refuse
+;; removing the Query tag or the query from a block that holds them.
+
+(def ^:private query-property-reason
+  "logseq.property/query can't be set here; use the query field on an insert node")
+(def ^:private query-tag-reason "Query can't be given as a tag; use the query field on an insert node")
+(def ^:private query-tag-delete-reason "Query can't be removed from a Query block; delete the block instead")
+(def ^:private query-delete-reason
+  "logseq.property/query can't be removed from a Query block; delete the block instead")
+
+(defn- put! [self id property value]
+  (request! self "PUT" (str "/semantic/blocks/" id "/properties/" (js/encodeURIComponent property)) {:value value}))
+
+(defn- batch-set! [self entries & {:keys [reset?]}]
+  (request! self "POST" "/semantic/block-properties/batch-set"
+            (cond-> {:entries (mapv (fn [[id property value]] {:block-id (str id) :property-id property :value value})
+                                    entries)}
+              reset? (assoc :isResetExistingValues true))))
+
+(defn- delete-property!
+  ([self id property]
+   (request! self "DELETE" (str "/semantic/blocks/" id "/properties/" (js/encodeURIComponent property)) nil))
+  ([self id property value]
+   (request! self "DELETE" (str "/semantic/blocks/" id "/properties/" (js/encodeURIComponent property)) {:value value})))
+
+(defn- batch-delete! [self entries]
+  (request! self "POST" "/semantic/block-properties/batch-delete"
+            {:entries (mapv (fn [[id property & [value]]]
+                              (cond-> {:block-id (str id) :property-id property}
+                                value (assoc :value value)))
+                            entries)}))
+
+(defn- query-block!
+  "Inserts a Query block titled `title` holding book-query on page `notes`; returns its uuid."
+  [self notes title]
+  (p/let [id (random-uuid)
+          response (tree! self notes [{:uuid (str id) :title title :query book-query}])]
+    (is (= 201 (:status response)) (pr-str (:body response)))
+    id))
+
+(defn- tags-of
+  "Block `id`'s tags from :eavt: Query and Task by ident, any other by title."
+  [conn id]
+  (set (map #(let [tag (d/entity @conn (:v %))]
+               (if (#{:logseq.class/Query :logseq.class/Task} (:db/ident tag)) (:db/ident tag) (:block/title tag)))
+            (d/datoms @conn :eavt (:db/id (d/entity @conn [:block/uuid (uuid (str id))])) :block/tags))))
+
+(defn- ok-200 [response label]
+  (is (= 200 (:status response)) (str label ": " (pr-str (:body response)))))
+
+(deftest property-paths-refuse-query-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self notes a]}]
+        (p/let [qb (query-block! self notes "zq Books")
+                book (tag! self "Book")
+                property (d/entity @conn :logseq.property/query)
+                selectors ["logseq.property/query" (:block/title property) (str (:block/uuid property))]
+                values [rules-text book-query 3 {:query "[:find ?b]"}]]
+          (p/doseq [[selector value [target label]] (for [selector selectors
+                                                          value values
+                                                          target [[a "a plain block"] [qb "a Query block"]]]
+                                                      [selector value target])]
+            (p/let [what (str selector " = " (pr-str value) " on " label)
+                    before (snapshot conn)
+                    single (put! self target selector value)
+                    batch (batch-set! self [[a "block/tags" book] [target "block/tags" book]
+                                            [notes "block/tags" book] [target selector value]])
+                    reversed (batch-set! self [[target selector value] [notes "block/tags" book]
+                                               [target "block/tags" book] [a "block/tags" book]])]
+              (refused-unchanged conn before single (str "entry 0: " query-property-reason) (str what ": set"))
+              (refused-unchanged conn before batch (str "entry 3: " query-property-reason) (str what ": batch entry 3"))
+              (refused-unchanged conn before reversed (str "entry 0: " query-property-reason) (str what ": batch reversed"))))
+          (p/doseq [selector selectors]
+            (p/let [before (snapshot conn)
+                    node (tree! self notes [{:title "zq ok"} {:title "zq P" :properties {selector book-query}}])
+                    child (children! self a [{:title "zq P" :properties {"Tags" ["Book"] selector rules-text}}])
+                    entry (batch! self [{:page "Notes" :blocks [{:title "zq ok"}]}
+                                        {:page "Notes" :properties {selector book-query}}])
+                    entry-target (batch! self [{:target-id (str notes) :properties {selector book-query}
+                                                :blocks [{:title "zq ok"}]}])]
+              (refused-unchanged conn before node (str "blocks[1]: " query-property-reason) (str selector ": node properties"))
+              (refused-unchanged conn before child (str "blocks[0]: " query-property-reason) (str selector ": child properties"))
+              (refused-unchanged conn before entry (str "entries[1]: " query-property-reason) (str selector ": batch entry page properties"))
+              (refused-unchanged conn before entry-target (str "entries[0]: " query-property-reason)
+                                 (str selector ": batch entry target properties"))))
+          (testing "the Query block still holds its query"
+            (is (= (query-block "zq Books" book-query) (held conn qb)))))))))
+
+(deftest property-paths-refuse-query-tag-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self notes a]}]
+        (p/let [qb (query-block! self notes "zq Books")
+                book (tag! self "Book")
+                query (d/entity @conn :logseq.class/Query)
+                forms [["by title" "Query"] ["by UUID" (str (:block/uuid query))] ["by ident" "logseq.class/Query"]]]
+          (p/doseq [[form value values shape] (for [[form value] forms
+                                                    [values shape] [[value "alone"] [[book value] "after a valid tag"]
+                                                                    [[value book] "before a valid tag"]]]
+                                                [form value values shape])]
+            (p/let [what (str form ", " shape)
+                    before (snapshot conn)
+                    single (put! self a "block/tags" values)
+                    batch (batch-set! self [[a "block/tags" book] [notes "block/tags" book] [a "block/tags" values]])
+                    reset (batch-set! self [[a "block/tags" values] [notes "block/tags" book]] :reset? true)
+                    node (tree! self notes [{:title "zq ok"} {:title "zq T" :properties {"Tags" values}}])
+                    entry (batch! self [{:page "Notes" :blocks [{:title "zq ok"}]}
+                                        {:page "Notes" :properties {"block/tags" values}}])]
+              (refused-unchanged conn before single (str "Tags: " query-tag-reason) (str what ": set"))
+              (refused-unchanged conn before batch (str "entry 2: Tags: " query-tag-reason) (str what ": batch"))
+              (refused-unchanged conn before reset (str "entry 0: Tags: " query-tag-reason) (str what ": batch reset"))
+              (refused-unchanged conn before node (str "blocks[1]: Tags: " query-tag-reason) (str what ": node properties"))
+              (refused-unchanged conn before entry (str "entries[1]: block/tags: " query-tag-reason)
+                                 (str what ": batch entry page properties"))))
+          (testing "a db id is never Query (a bare number is matched as a title), nor is a title in another case (a tag title is matched exactly)"
+            (p/doseq [value [(:db/id query) "query"]]
+              (p/let [before (snapshot conn)
+                      response (put! self a "block/tags" value)]
+                (is (= 400 (:status response)) (pr-str (:body response)))
+                (is (= before (snapshot conn))))))
+          (testing "on a Query block, a held Query is a no-op, in every form, and a new tag beside it is added"
+            (p/doseq [[form value] forms]
+              (p/let [single (put! self qb "block/tags" value)
+                      listed (put! self qb "block/tags" [value book])
+                      batch (batch-set! self [[qb "block/tags" value] [qb "block/tags" [book value]]])
+                      reset (batch-set! self [[qb "block/tags" [value book]]] :reset? true)]
+                (ok-200 single (str form ": set"))
+                (ok-200 listed (str form ": set in a list"))
+                (ok-200 batch (str form ": batch"))
+                (ok-200 reset (str form ": batch reset"))
+                (is (= #{:logseq.class/Query "Book"} (tags-of conn qb)) form)
+                (is (= [book-query] (map :text (:values (held conn qb)))) form)))))))))
+
+(deftest reset-keeps-query-tag-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self notes]}]
+        (p/let [qb (query-block! self notes "zq Books")
+                book (tag! self "Book")
+                film (tag! self "Film")
+                set-empty (put! self qb "block/tags" [])
+                _ (ok-200 set-empty "set [] on a Query block")
+                _ (is (= (query-block "zq Books" book-query) (held conn qb)) "Query kept after set []")
+                set-list (put! self qb "block/tags" [book])
+                _ (ok-200 set-list "set [Book]")
+                _ (is (= #{:logseq.class/Query "Book"} (tags-of conn qb)))
+                batch-empty (batch-set! self [[qb "block/tags" []]] :reset? true)
+                _ (ok-200 batch-empty "batch reset []")
+                _ (is (= (query-block "zq Books" book-query) (held conn qb)) "Query kept after a batch reset []")
+                batch-list (batch-set! self [[qb "block/tags" [book]] [qb "block/tags" [film]]] :reset? true)]
+          (ok-200 batch-list "a chain of batch resets")
+          (is (= #{:logseq.class/Query "Film"} (tags-of conn qb)) "the last reset wins, and Query stays")
+          (is (= [book-query] (map :text (:values (held conn qb))))))))))
+
+(deftest batch-class-check-sees-kept-query-test
+  ;; about-query is a node property limited to Query. A reset that leaves Query out keeps it, so the
+  ;; Query block is still a Query object when the class check judges the batch, whichever entry
+  ;; comes first; a plain block is refused, which shows the check is on.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self notes a]}]
+        (p/let [qb (query-block! self notes "zq Books")
+                book (tag! self "Book")
+                created (request! self "POST" "/semantic/properties" {:title "about-query" :type "node"})
+                ident (get-in created [:body :ident])
+                limited (request! self "PATCH" (str "/semantic/properties/" (js/encodeURIComponent ident))
+                                  {:classes {:set ["Query"]}})
+                _ (is (= [201 200] [(:status created) (:status limited)]) (pr-str [(:body created) (:body limited)]))
+                tag-first (batch-set! self [[qb "block/tags" [book]] [a ident (str qb)]] :reset? true)
+                _ (ok-200 tag-first "tag entry first")
+                set-first (batch-set! self [[a ident (str qb)] [qb "block/tags" []]] :reset? true)
+                _ (ok-200 set-first "set entry first")
+                before (snapshot conn)
+                plain (batch-set! self [[qb "block/tags" []] [a ident (str notes)]] :reset? true)]
+          (is (= 400 (:status plain)) (pr-str (:body plain)))
+          (is (string/starts-with? (str (get-in plain [:body :error])) "entry 1: ") (pr-str (:body plain)))
+          (is (= before (snapshot conn)) "the refused batch wrote nothing")
+          (is (= (query-block "zq Books" book-query) (held conn qb)))
+          (is (= (uuid (str qb)) (:block/uuid (get (d/entity @conn [:block/uuid a]) (keyword ident))))))))))
+
+(deftest delete-paths-keep-query-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self notes a]}]
+        (p/let [qb (query-block! self notes "zq Books")
+                book (tag! self "Book")
+                film (tag! self "Film")
+                ;; Added without a reset, so the Query tag stays on the Stage 2 tree too.
+                tagged (batch-set! self [[qb "block/tags" book] [qb "block/tags" film]])
+                _ (ok-200 tagged "tag the Query block")
+                query (d/entity @conn :logseq.class/Query)
+                property (d/entity @conn :logseq.property/query)]
+          (p/doseq [value ["Query" "query" (str (:block/uuid query)) "logseq.class/Query"]]
+            (p/let [before (snapshot conn)
+                    single (delete-property! self qb "block/tags" value)
+                    batch (batch-delete! self [[qb "block/tags" "Film"] [qb "block/tags" value]])
+                    reversed (batch-delete! self [[qb "block/tags" value] [qb "block/tags" "Film"]])]
+              (refused-unchanged conn before single (str "entry 0: " query-tag-delete-reason) (str value ": delete"))
+              (refused-unchanged conn before batch (str "entry 1: " query-tag-delete-reason) (str value ": batch"))
+              (refused-unchanged conn before reversed (str "entry 0: " query-tag-delete-reason) (str value ": batch reversed"))))
+          (p/doseq [selector ["logseq.property/query" (:block/title property) (str (:block/uuid property))]]
+            (p/let [before (snapshot conn)
+                    single (delete-property! self qb selector)
+                    batch (batch-delete! self [[qb "block/tags" "Film"] [qb selector]])
+                    reversed (batch-delete! self [[qb selector] [qb "block/tags" "Film"]])]
+              (refused-unchanged conn before single (str "entry 0: " query-delete-reason) (str selector ": delete"))
+              (refused-unchanged conn before batch (str "entry 1: " query-delete-reason) (str selector ": batch"))
+              (refused-unchanged conn before reversed (str "entry 0: " query-delete-reason) (str selector ": batch reversed"))))
+          (p/let [film-gone (delete-property! self qb "block/tags" "Film")
+                  _ (ok-200 film-gone "another tag still deletes")
+                  _ (is (= #{:logseq.class/Query "Book"} (tags-of conn qb)))
+                  all-tags (batch-delete! self [[qb "block/tags"]])
+                  _ (ok-200 all-tags "deleting Tags removes the other tags")
+                  _ (is (= (query-block "zq Books" book-query) (held conn qb)) "Query and the query stay")
+                  plain-tag (put! self a "block/tags" book)
+                  _ (ok-200 plain-tag "tag a plain block")
+                  plain-query (delete-property! self a "logseq.property/query")
+                  plain-batch (batch-delete! self [[a "logseq.property/query"] [a "block/tags" "Book"]])]
+            (testing "a block that holds no query: deleting the query is the no-op it always was"
+              (ok-200 plain-query "single")
+              (ok-200 plain-batch "batch, beside a tag delete")
+              (is (= #{} (tags-of conn a))))))))))
+
+(deftest other-writers-never-write-query-test
+  ;; create_task and update_block write titles (and Task), never the query or the Query tag: an
+  ;; inline #Query is stored escaped as text. A pin; it passes before and after the fix.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self notes a]}]
+        (p/let [task (request! self "POST" "/semantic/tasks" {:title "zq T #Query" :page-id (str notes)})
+                task-id (get-in task [:body :uuid])
+                updated (update! self a {:title "zq A #Query"})]
+          (is (= 201 (:status task)) (pr-str (:body task)))
+          (is (= #{:logseq.class/Task} (tags-of conn task-id)))
+          (is (= 200 (:status updated)) (pr-str (:body updated)))
+          (is (= #{} (tags-of conn a)))
+          (is (empty? (d/datoms @conn :avet :logseq.property/query))
+              "no block holds a query"))))))
+
+;; ---------------------------------------------------------------------------------------------
+;; Stage 4: the created-by-Claude marker and the update_block guard.
+
+(def ^:private marker-ident :user.property/claude-queryBlock)
+(def ^:private marker-reason "claudeQueryBlock is set by the server and can't be written")
+(def ^:private signed [["x-logseq-sync-actor" actor]])
+(def ^:private other-query "{:query [:find (pull ?b [*]) :where [?b :block/title \"zq\"]]}")
+
+(defn- eid [db id] (:db/id (d/entity db [:block/uuid (uuid (str id))])))
+
+(defn- marker-of
+  "Block `id`'s marker value, read from :eavt (nil when it holds none)."
+  [conn id]
+  (datom-v @conn (eid @conn id) marker-ident))
+
+(defn- value-uuid
+  "The uuid of the value block holding Query block `id`'s query, from :eavt."
+  [conn id]
+  (:block/uuid (d/entity @conn (datom-v @conn (eid @conn id) :logseq.property/query))))
+
+(defn- marker-properties
+  "Every property whose :block/name is claudequeryblock."
+  [db]
+  (map #(d/entity db (:e %)) (d/datoms db :avet :block/name "claudequeryblock")))
+
+(defn- stamped? [conn id]
+  (seq (d/datoms @conn :eavt (eid @conn id) :user.property/claude-editedBy)))
+
+(defn- ops-of!
+  "The :outliner-op of each transaction `write` (a thunk answering a promise of a response) commits."
+  [conn write]
+  (let [ops (atom [])]
+    (d/listen! conn ::ops #(swap! ops conj (:outliner-op (:tx-meta %))))
+    (-> (p/let [response (write)] [response @ops])
+        (p/finally #(d/unlisten! conn ::ops)))))
