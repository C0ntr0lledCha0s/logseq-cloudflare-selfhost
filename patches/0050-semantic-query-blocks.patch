+        from (some->> (first (d/datoms db :eavt id :logseq.property/created-from-property)) :v (d/entity db) :db/ident)]
+    (cond
+      (= :logseq.property/query from) {:holder (query-holder db id) :value? true}
+      (some #(= :logseq.class/Query (:db/ident (d/entity db (:v %)))) (d/datoms db :eavt id :block/tags))
