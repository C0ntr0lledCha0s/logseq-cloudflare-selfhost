+++ b/deps/db-sync/src/logseq/db_sync/worker/handler/datalog.cljs
@@ -1128,6 +1128,81 @@
       (refusal 400 (string/join "; " problems))
       {:query (:ok normalised) :given query :inputs inputs})))
 
+;; Query blocks (patch 0050)
+;; =========================
+;; The text Claude stores as a Query block's query runs in the owner's app, not here, so it gets
+;; only the static checks: the ones datalog_query applies before it runs a query, plus the keys the
+;; app reads (and none it runs as code) and the vector form, the only :query form the app runs.
+
+(def query-block-keys
+  "The keys a query block's map may hold, in the order refusals list them."
+  [:query :inputs :title :collapsed? :group-by-page? :remove-block-children? :breadcrumb-show?])
+
+(def query-block-flags
+  "The query block keys that take true or false."
+  [:collapsed? :group-by-page? :remove-block-children? :breadcrumb-show?])
+
+(def ^:private give-query-map "query: give an EDN map {:query [:find … :where …] :inputs […]}")
+
+(defn- query-reason
+  "`message` starting with `query: ` exactly once."
+  [message]
+  (if (string/starts-with? message "query: ") message (str "query: " message)))
+
+(defn- query-block-shape-errors
+  "Why the map `m` isn't a query block's shape: its keys, :title, the flags, :inputs and the vector
+  form of :query."
+  [m]
+  (let [{:keys [query inputs title]} m]
+    (concat
+     (for [k (sort-by str (keys m)) :when (not (some #{k} query-block-keys))]
+       (case k
+         :rules (str "query: :rules is not accepted; " no-caller-rules)
+         (:view :result-transform) (str "query: " k " is not accepted; it runs as code in the app")
+         (str "query: " (pr-str k) " is not accepted (keys: " (string/join ", " query-block-keys) ")")))
+     (when (and (contains? m :title) (not (string? title))) ["query: :title must be a string"])
+     (for [k query-block-flags :when (and (contains? m k) (not (boolean? (get m k))))]
+       (str "query: " k " must be true or false"))
+     (cond
+       (and (contains? m :inputs) (not (vector? inputs))) ["query: :inputs must be a vector"]
+       (> (count inputs) max-inputs)
+       [(str "query: :inputs takes at most " max-inputs " values (got " (count inputs) ")")])
+     (when-not (and (vector? query) (= :find (first query)))
+       ["query: give :query as a vector [:find … :where …]; the app runs only that form"]))))
+
+(defn check-query-block
+  "Checks `text`, a Query block's query, as the app will read it: {:ok text :form m} or {:error
+  message}, every reason starting with `query: ` once and joined with `; `. In order: a string of at
+  most `max-query-chars` characters (the whole text); one EDN form (`parse-edn`); a map; its shape
+  (`query-block-shape-errors`); then what datalog_query checks before it runs a query, in
+  `checked-query`'s order (write forms in the whole map, the normaliser, the validator with the
+  inputs), and its function-binding cap, answered here as a reason since nothing runs."
+  [text]
+  (cond
+    (not (string? text)) {:error give-query-map}
+
+    (> (count text) max-query-chars)
+    {:error (str "query: at most " (format-count max-query-chars) " characters (got " (format-count (count text)) ")")}
+
+    :else
+    (let [{form :ok parse-error :error} (parse-edn "query" text)]
+      (cond
+        parse-error {:error parse-error}
+        (not (map? form)) {:error give-query-map}
+        :else
+        (if-let [shape (seq (query-block-shape-errors form))]
+          {:error (string/join "; " shape)}
+          (let [normalised (normalise-query (:query form))
+                invalid (or (:error normalised)
+                            (validate-query (:ok normalised) (or (:inputs form) [])))
+                problems (cond-> (vec (write-form-errors "query" form))
+                           invalid (conj (query-reason invalid)))
+                too-wide (when (empty? problems) (fn-bindings-refusal (:ok normalised)))]
+            (cond
+              (seq problems) {:error (string/join "; " problems)}
+              too-wide {:error (query-reason (::error too-wide))}
+              :else {:ok text :form form})))))))
+
 (defn- parse-request
   "The body's query and inputs parsed, normalised and validated: {:query :inputs :given} or a
   refusal. A body with rules never gets here (`body-errors`)."
