+(defn- query-node-refusal
+  "Why tree node `node`, which has a query field or whose title is a query fence (`fence`, from
+  fence-display-block), can't become a Query block, as \"query: <reason>\", or nil. In order: a
+  field and a query fence together; a field on an E2EE graph, whose text the server can't check; a
+  display-type or lang (a field, the same in its properties, or a field's caption that converts to
+  code or math); the Query, Code, Math or Quote tag in its properties; then the query's own check
+  (datalog/check-query-block). An inline #Query (or #Code) in a caption needs no rule: a built-in
+  tag never resolves inline, so it is stored escaped as text."
+  [db node fence e2ee?]
+  (let [field? (contains? node :query)
+        properties (when (map? (:properties node)) (:properties node))
+        idents (map (fn [[k v]] [(resolve-property-ident db (property-selector k)) v]) properties)
+        tag-values (some (fn [[ident v]] (when (= :block/tags ident) v)) idents)
+        tags (keep (fn [value]
+                     (let [id (resolve-ref-entity db :block/tags value)]
+                       (when (integer? id) (:db/ident (d/entity db id)))))
+                   (if (sequential? tag-values) tag-values (some-> tag-values vector)))]
+    (cond
+      (and field? (or (= :query (:type fence)) (::query-fence fence)))
+      "query: given both as a field and as a fence"
+      e2ee? "query: not on an E2EE graph"
+      (or (contains? node :display-type) (contains? node :lang)
+          (some (comp #{display-type-ident lang-ident} first) idents)
+          (and field? (:type fence)))
+      "query: a Query block takes no display-type or lang"
+      (some query-refused-classes tags)
+      "query: the Query tag is set by the query field"
+      :else (:error (datalog/check-query-block (if field? (:query node) (:text fence)))))))
