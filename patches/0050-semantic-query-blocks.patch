+(defn- app-query-block!
+  "A Query block made as the app's advanced-query command makes it, with the outliner directly, not
+  through the API: a block tagged Query whose query value block holds `text`, shown as Clojure code
+  when `code?`. Unmarked. Returns its uuid."
+  [conn notes text code? order]
+  (let [id (random-uuid)]
+    (d/transact! conn [{:block/uuid id :block/title "zq Owner" :block/order order
+                        :block/page [:block/uuid notes] :block/parent [:block/uuid notes]
+                        :block/created-at 1 :block/updated-at 1}])
+    (let [e (eid @conn id)]
+      (outliner-property/set-block-property! conn e :block/tags :logseq.class/Query)
+      (outliner-property/set-block-property! conn e :logseq.property/query text)
+      (when code?
+        (let [v (datom-v @conn e :logseq.property/query)]
+          (outliner-property/set-block-property! conn v :logseq.property.node/display-type :code)
+          (outliner-property/set-block-property! conn v :logseq.property.code/lang "clojure"))))
+    id))
+
