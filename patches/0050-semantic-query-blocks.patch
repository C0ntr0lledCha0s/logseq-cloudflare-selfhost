+  value block, display-type and lang are refused and the new title must pass check-query-block."
+  [db block body]
+  (when-let [{:keys [holder value?]} (query-block-part db block)]
+    (let [named (str "block " (:block/uuid block) ": ")]
+      (case (claude-query-block? db holder)
+        :unknown {:status 409 :error (str named "can't tell whether Claude created this Query block, so it isn't changed")}
+        :no {:status 409 :error (str named "update_block changes only Query blocks Claude created")}
+        :yes (when value?
+               (if (or (contains? body :display-type) (contains? body :lang))
+                 {:status 400 :error "title: query: a Query block takes no display-type or lang"}
