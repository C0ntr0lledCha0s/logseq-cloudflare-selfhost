+;; The read-back is wired to update_block on a Claude-made value block: when it finds a gap, the call
+;; answers 500 naming the title and the transaction is rolled back. A correct write always reads
+;; back, so the read-back is replaced, after the insert, by one that reports a gap.
+;; Found by the mutation step (dropping the read-back left every other test green); before the fix
+;; nothing read the update back:
+;;   expected: (= 500 (:status response))  actual: (not (= 500 200))
+(deftest update-query-read-back-failure-rolls-back-test
+  (async done
+    (let [real semantic/read-back-query-block]
+      (with-graph (fn [] (set! semantic/read-back-query-block real) (done))
+        (fn [{:keys [conn self notes]}]
+          (p/let [qb (query-block! self notes "zq Books")
+                  vb (value-uuid conn qb)
+                  _ (set! semantic/read-back-query-block (fn [& _] ["the query text is not what was given"]))
+                  before (snapshot conn)
+                  response (update! self vb {:title other-query})
+                  _ (set! semantic/read-back-query-block real)
+                  _ (is (= 500 (:status response)) (pr-str (:body response)))
+                  _ (is (= "the write did not store what was asked: title: the query text is not what was given"
+                           (get-in response [:body :error])))
+                  _ (is (= before (snapshot conn)) "rolled back")
+                  _ (is (= (query-block "zq Books" book-query) (held conn qb)))
+                  _ (set! semantic/read-back-query-block (fn [& _] ["the query text is not what was given"]))
+                  caption (update! self qb {:title "zq caption"})]
+            (set! semantic/read-back-query-block real)
+            (ok-200 caption "a caption update doesn't read the query back")))))))
+
+;; The class sweep: every other kind of block update_block reaches is not a Query block, so the guard
+;; leaves it alone: a plain block, a page, a tag, a property, and the value blocks of a text, number
+;; and URL property and a choice. A pin; each answers as it did before the guard.
+(deftest update-other-blocks-unguarded-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self notes a]}]
+        (p/let [_ (query-block! self notes "zq Mine")
+                props (p/all (map (fn [[title type extra]]
+                                    (p/let [r (request! self "POST" "/semantic/properties" (merge {:title title :type type} extra))]
+                                      (is (= 201 (:status r)) (pr-str (:body r)))
+                                      (keyword "user.property" (last (string/split (get-in r [:body :ident]) #"/")))))
+                                  [["zqText" "default"] ["zqNum" "number"] ["zqLink" "url"]
+                                   ["zqMood" "default" {:choices [{:title "zq calm"} {:title "zq busy"}]}]]))
+                [text-ident num-ident link-ident mood-ident] props
+                b-id (random-uuid)
+                _ (tree! self notes [{:uuid (str b-id) :title "zq B"
+                                      :properties {"zqText" "zq x" "zqNum" 3 "zqLink" "https://example.com/a"
+                                                   "zqMood" "zq calm"}}])
+                tag-id (tag! self "zqTag")
+                value-of (fn [ident] (:block/uuid (d/entity @conn (datom-v @conn (eid @conn b-id) ident))))
+                cases [["a plain block" a "zq A2" 200]
+                       ["a page" notes "Notes2" 200]
+                       ["a tag" tag-id "zqTag2" 200]
+                       ["a text value block" (value-of text-ident) "zq y" 200]
+                       ["a number value block" (value-of num-ident) "4" 200]
+                       ["a URL value block" (value-of link-ident) "https://example.com/b" 200]
+                       ["a choice" (value-of mood-ident) "zq quiet" 200]]]
+          (p/doseq [[label id title status] cases]
+            (p/let [response (update! self id {:title title})]
+              (is (= status (:status response)) (str label ": " (pr-str (:body response))))
+              (is (not (string/includes? (str (get-in response [:body :error])) "Query")) label))))))))
+
+;; The upload path: a graph uploaded from the app stores some attributes with the app's schema. The
+;; guard reads the marker and the holder from datoms, so it works there too.
+(deftest update-guard-upload-path-test
+  (async done
+    (#'uploaded/with-uploaded
+     done
+     (fn [{:keys [conn self]}]
+       (p/let [[page-id] (#'uploaded/notes-page! self)
+               id (random-uuid)
+               response (request! self "POST" "/semantic/block-trees"
+                                  {:target-id page-id :blocks [{:uuid (str id) :title "zq U" :query book-query}]})
+               vb (value-uuid conn id)
+               rule (update! self vb {:title page-ref-text})
+               valid (update! self vb {:title other-query})]
+         (is (= 201 (:status response)) (pr-str (:body response)))
+         (is (true? (marker-of conn id)))
+         (is (= 400 (:status rule)) (pr-str (:body rule)))
+         (is (= 200 (:status valid)) (pr-str (:body valid)))
+         (is (= (query-block "zq U" other-query) (held conn id))))))))
+
+;; The contract: updateBlock's description names the guard and the check, and the insert tools
+;; mention the hidden marker.
+;; Before the fix (Stage 3 tree):
+;;   (filled in from the run)
+(deftest openapi-update-guard-test
+  (let [document (semantic-routes/openapi-document "https://issuer.example")
+        description (fn [path method] (get-in document [:paths path method :description]))
+        update-text (description "/api/v1/graphs/{graph-id}/blocks/{block-id}" :patch)]
+    (doseq [phrase ["only on the Query blocks Claude created" "checked as datalog_query checks a query"
+                    "title: query:" "takes no display-type or lang" "409"]]
+      (is (string/includes? update-text phrase) phrase))
+    (doseq [path ["/api/v1/graphs/{graph-id}/block-trees" "/api/v1/graphs/{graph-id}/blocks/{block-id}/children"
+                  "/api/v1/graphs/{graph-id}/block-trees/batch" "/api/v1/graphs/{graph-id}/capture"]]
+      (is (string/includes? (description path :post) "hidden claudeQueryBlock") path))))
