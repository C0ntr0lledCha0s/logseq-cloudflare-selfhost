+(defn- refused-409
+  [conn before response error label]
+  (is (= 409 (:status response)) (str label ": " (pr-str (:body response))))
+  (is (= error (get-in response [:body :error])) label)
+  (is (= before (snapshot conn)) (str label ": nothing written")))
