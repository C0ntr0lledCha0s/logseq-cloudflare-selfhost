 ;; one and seven days back in epoch milliseconds, which is what claudeEditedAt holds. A page, tag or
 ;; property (anything holding the :block/name) already titled Claude Activity is left alone.
 
+;; Query blocks (patch 0050). One write makes a block a Query block, as the app's advanced-query
+;; command does: tagged Query, the text in :logseq.property/query's value block, shown as a Clojure
+;; code block. The Activity page uses it; the insert path (stage 2) will too.
+
+(defn- query-value-id
+  "The db id of the value block holding `block-id`'s query, read from :eavt (an uploaded graph may
+  store the attribute with the app's schema), or nil."
+  [db block-id]
+  (:v (first (d/datoms db :eavt block-id :logseq.property/query))))
+
+(defn set-query-block!
+  "Makes block `block-id` on `conn` a Query block holding `text`: tagged Query, the text in its query
+  value block, which shows as code in Clojure. `_opts` takes {:mark? bool}: :mark? asks for the created-by-Claude marker, which
+  stage 4 adds; nothing writes it yet, so `read-back-query-block` reports it missing. The caller
+  checks `text` first (`datalog/check-query-block`) and reads the write back."
+  [conn block-id text _opts]
+  (outliner-property/set-block-property! conn block-id :block/tags :logseq.class/Query)
+  (outliner-property/set-block-property! conn block-id :logseq.property/query text)
+  (when-let [query-id (query-value-id @conn block-id)]
+    (outliner-property/set-block-property! conn query-id :logseq.property.node/display-type :code)
+    (outliner-property/set-block-property! conn query-id :logseq.property.code/lang "clojure"))
+  nil)
+
+(defn read-back-query-block
+  "What `db` doesn't hold of the Query block `block-id` that `set-query-block!` wrote with `text` and
+  `mark?`, as reasons for `unverified!` (empty when it stored). Read from :eavt datoms."
+  [db block-id text mark?]
+  (let [value (fn [e a] (:v (first (d/datoms db :eavt e a))))
+        tags (set (map #(:db/ident (d/entity db (:v %))) (d/datoms db :eavt block-id :block/tags)))
+        query-id (query-value-id db block-id)]
+    (cond-> []
+      (not (contains? tags :logseq.class/Query)) (conj "the block is not tagged Query")
+      (nil? query-id) (conj "the block holds no query")
+      (and query-id (not= text (value query-id :block/title))) (conj "the query text is not what was given")
+      (and query-id (not= :code (value query-id :logseq.property.node/display-type)))
+      (conj "the query is not shown as code")
+      (and query-id (not= "clojure" (value query-id :logseq.property.code/lang)))
+      (conj "the query's lang is not clojure")
+      ;; Stage 4 writes the marker and reads it here; until then a request for it can't hold.
+      mark? (conj "claudeQueryBlock is not set"))))
+
