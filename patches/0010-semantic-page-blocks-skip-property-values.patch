+
+(deftest semantic-list-page-blocks-leaves-out-property-values-test
+  (async done
+    (run-text-property-test! done :db.cardinality/one
+      (fn [{:keys [conn self property page-id request]}]
+        (p/let [set-response (sync-handler/handle-http
+                              self
+                              (semantic-json-request
+                               (str "/semantic/blocks/" page-id "/properties/" (:block/uuid property) "?graph-id=graph-1")
+                               "PUT" {:value "Page description"}))
+                _ (is (= 200 (.-status set-response)))
+                value-block (get (d/entity @conn [:block/uuid page-id]) (:db/ident property))
+                _ (is (= page-id (get-in value-block [:block/parent :block/uuid]))
+                      "the value block sits under the page, alongside its body blocks")
+                list-response (sync-handler/handle-http
+                               self
+                               (semantic-json-request
+                                (str "/semantic/pages/" page-id "/blocks?graph-id=graph-1") "GET" nil))
+                body (json-body list-response)
+                block-response (sync-handler/handle-http
+                                self
+                                (semantic-json-request
+                                 (str "/semantic/blocks/" (:block/uuid value-block) "?graph-id=graph-1") "GET" nil))]
+          (is (= 200 (.-status list-response)))
+          (is (= ["URL block 0" "URL block 1"] (mapv :title (:blocks body))))
+          (is (= 200 (.-status block-response)) "the value block is still readable by UUID"))))))
