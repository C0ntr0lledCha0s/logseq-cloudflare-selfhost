+(defn- stranded-choice?
+  "Whether `choice` is a choice of some entity, and every entity it is a choice of has neither a
+  :db/ident nor a title: an owner whose datoms were retracted (the ref dangles, and d/entity is nil)
+  or one left nameless. Neither can be named or claim the choice (Connector #27). An owner with
+  only one of them (a page, or a property without a title) is a real holder."
+  [db choice]
+  (let [owners (choice-owners db choice)]
+    (and (seq owners) (every? #(not (or (:db/ident %) (:block/title %))) owners))))
+
+(defn- stranded-stamp-choice?
+  "Whether `choice`, the entity holding the claude choice's UUID, is stranded: as stranded-choice?,
+  or left with no owner at all, as :db/retractEntity on its property leaves it (every ref to the
+  property goes, the choice's :block/page and :block/parent too). Only an entity that still reads
+  claude and is neither on a page nor a page itself counts as that choice."
+  [db choice]
+  (or (stranded-choice? db choice)
+      (and (empty? (choice-owners db choice))
+           (nil? (:block/page choice))
+           (nil? (:block/name choice))
+           (= stamp-header-value (:block/title choice)))))
+
