diff --git a/deps/db-sync/test/logseq/db_sync/semantic_stranded_stamp_choice_test.cljs b/deps/db-sync/test/logseq/db_sync/semantic_stranded_stamp_choice_test.cljs
new file mode 100644
index 0000000..2c29382
--- /dev/null
+++ b/deps/db-sync/test/logseq/db_sync/semantic_stranded_stamp_choice_test.cljs
@@ -0,0 +1,328 @@
+(ns logseq.db-sync.semantic-stranded-stamp-choice-test
+  "Connector #27: a choice whose owner is gone or has no name. The claude choice keeps its fixed UUID,
+  so once its owner is stranded every flagged write after it was refused with a 409 that named an
+  empty owner (\"held by a choice of  ()\"), and no repair was offered. Two kinds of stranded owner:
+  one whose datoms were all retracted (the choice's ref dangles), and one that is left without a
+  :db/ident or a title (a nameless property). Each graph is uploaded from the app and opened by the
+  real handler, as in semantic-uploaded-graph-schema-test, whose helpers this reuses."
+  (:require [cljs.test :refer [async deftest is testing]]
+            [clojure.string :as string]
+            [datascript.core :as d]
+            [logseq.db-sync.semantic-uploaded-graph-schema-test :as u]
+            [logseq.outliner.property :as outliner-property]
+            [promesa.core :as p]))
+
+(def ^:private by-ident :user.property/claude-editedBy)
+(def ^:private choice-uuid #uuid "3072a652-18e8-4dcb-bb37-e1aa38c8e3e9")
+
+(def ^:private request! @#'u/request!)
+(def ^:private with-uploaded @#'u/with-uploaded)
+(def ^:private notes-page! @#'u/notes-page!)
+(def ^:private owner-idents @#'u/owner-idents)
+(def ^:private stamps @#'u/stamps)
+(def ^:private signed @#'u/signed)
+(def ^:private stamped @#'u/stamped)
+
+(defn- retract-all!
+  "Strands every choice of `owner-id`: retracts each of the owner's datoms one by one (not
+  :db/retractEntity), so the choices' :block/closed-value-property, :block/parent and :block/page
+  still point at an id that has no datoms."
+  [conn owner-id]
+  (d/transact! conn (mapv (fn [dt] [:db/retract (:e dt) (:a dt) (:v dt)]) (d/datoms @conn :eavt owner-id))))
+
+(defn- unname!
+  "Leaves `owner-id` a nameless property: its :db/ident, :block/title and :block/name are retracted
+  and its other datoms stay."
+  [conn owner-id]
+  (d/transact! conn (vec (for [a [:db/ident :block/title :block/name]
+                               dt (d/datoms @conn :eavt owner-id a)]
+                           [:db/retract (:e dt) (:a dt) (:v dt)]))))
+
+(defn- retract-entity!
+  "Deletes `owner-id` the way datascript does, with :db/retractEntity: every ref to it goes too, so
+  its choices keep no :block/closed-value-property, :block/parent or :block/page at all."
+  [conn owner-id]
+  (d/transact! conn [[:db/retractEntity owner-id]]))
+
+(defn- property! [conn title]
+  (:db/ident (outliner-property/upsert-property!
+              conn nil {:logseq.property/type :default :db/cardinality :db.cardinality/one}
+              {:property-name title})))
+
+(def ^:private strandings
+  [["an owner whose datoms are all retracted" retract-all!]
+   ["a nameless owner" unname!]
+   ["an owner deleted with :db/retractEntity" retract-entity!]])
+
+(defn- claude-choices
+  "The ids of every choice whose content is claude, whatever owns it."
+  [db]
+  (set (keep (fn [dt] (let [e (d/entity db (:e dt))]
+                        (when (= "claude" (:block/title e)) (:db/id e))))
+             (d/datoms db :avet :block/closed-value-property))))
+
+;; ---------------------------------------------------------------------------------------------
+;; The precheck
+
+(deftest flagged-writes-succeed-after-the-claude-choice-is-stranded-test
+  ;; The first flagged write creates the claude choice; its owner is then stranded. Every flagged
+  ;; write after that (an edit of a block written before, a block tree, a property definition) must
+  ;; succeed and stamp, with the claude choice re-parented to editedBy rather than a second claude
+  ;; choice created.
+  (async done
+    (-> (p/doseq [[label strand!] strandings]
+          (p/let [_ (js/Promise.
+                     (fn [resolve]
+                       (with-uploaded resolve
+                         (fn [{:keys [conn self]}]
+                           (p/let [[page a] (notes-page! self)
+                                   first-write (request! self "POST" "/semantic/pages" {:title "Stamp Test"} stamped)
+                                   _ (strand! conn (:db/id (d/entity @conn by-ident)))
+                                   edited (request! self "PATCH" (str "/semantic/blocks/" a) {:title "A edited"} stamped)
+                                   child (str (random-uuid))
+                                   tree (request! self "POST" "/semantic/block-trees"
+                                                  {:target-id page :blocks [{:uuid child :title "N"}]} stamped)
+                                   property (request! self "POST" "/semantic/properties" {:title "mood" :type "default"} stamped)
+                                   choice (d/entity @conn [:block/uuid choice-uuid])]
+                             (testing label
+                               (is (= 201 (:status first-write)) (pr-str first-write))
+                               (is (= 200 (:status edited)) (pr-str edited))
+                               (is (= 201 (:status tree)) (pr-str tree))
+                               (is (= 201 (:status property)) (pr-str property))
+                               (is (= {:by choice-uuid :at? true} (stamps @conn a)) "the edited block carries both stamps")
+                               (is (= {:by choice-uuid :at? true} (stamps @conn child)) "the tree's block carries both stamps")
+                               (is (= #{by-ident} (owner-idents @conn (:db/id choice)))
+                                   "the claude choice is editedBy's again")
+                               (is (= [by-ident by-ident by-ident]
+                                      (mapv #(:db/ident (get choice %))
+                                            [:block/parent :block/page :logseq.property/created-from-property]))
+                                   "its parent, page and created-from-property are editedBy too")
+                               (is (= "editedBy" (:block/title (d/entity @conn by-ident))))
+                               (is (= #{(:db/id choice)} (claude-choices @conn)) "no second claude choice is created"))))
+                         :stale? true)))]
+            nil))
+        (p/catch #(is false (str % (some-> % .-stack))))
+        (p/finally done))))
+
+(deftest editedby-is-named-in-the-transaction-that-creates-its-choice-test
+  ;; Guard (Connector #27, acceptance 1): the first flagged write commits editedBy's title in the same
+  ;; transaction as the claude choice that points at it, so no stored state has the choice hanging off
+  ;; a nameless property. This holds before the fix too; it fails if the schema is made in its own
+  ;; writes ahead of the flagged one.
+  (async done
+    (with-uploaded done
+      (fn [{:keys [conn self]}]
+        (p/let [_ (notes-page! self)
+                created (request! self "POST" "/semantic/pages" {:title "Stamp Test"} stamped)
+                by (d/entity @conn by-ident)
+                choice-id (:db/id (d/entity @conn [:block/uuid choice-uuid]))
+                title-tx (:tx (first (d/datoms @conn :eavt (:db/id by) :block/title)))
+                owner-tx (:tx (first (d/datoms @conn :eavt choice-id :block/closed-value-property)))]
+          (is (= 201 (:status created)) (pr-str created))
+          (is (= "editedBy" (:block/title by)))
+          (is (some? owner-tx))
+          (is (= title-tx owner-tx) "editedBy's title and its choice's owner are committed in one transaction")))
+      :stale? true)))
+
+(defn- re-own!
+  "Makes the claude choice a choice of `owner-ids` only."
+  [conn owner-ids]
+  (let [id (:db/id (d/entity @conn [:block/uuid choice-uuid]))]
+    (d/transact! conn (into (mapv (fn [dt] [:db/retract id :block/closed-value-property (:v dt)])
+                                  (d/datoms @conn :eavt id :block/closed-value-property))
+                            (map (fn [owner] [:db/add id :block/closed-value-property owner]) owner-ids)))))
+
+(defn- detach!
+  "Retracts the claude choice's :block/parent and :block/page, keeping whatever owns it."
+  [conn]
+  (let [id (:db/id (d/entity @conn [:block/uuid choice-uuid]))]
+    (d/transact! conn (vec (for [a [:block/parent :block/page] dt (d/datoms @conn :eavt id a)]
+                             [:db/retract (:e dt) (:a dt) (:v dt)])))))
+
+(deftest a-claimed-claude-choice-is-not-repaired-test
+  ;; Guards: an owner that still has a title or an ident holds the choice, so the write is refused
+  ;; (naming it) and nothing is re-parented, and get_graph_health doesn't list the choice. Only an
+  ;; owner with neither, or one that's gone, counts as stranded.
+  (async done
+    (-> (p/doseq [[label setup expected stale-too?]
+                  [["a page" (fn [conn page] (re-own! conn [(:db/id (d/entity @conn [:block/uuid (uuid page)]))]))
+                    "is held by a choice of Notes ()" true]
+                   ["a property without a title"
+                    (fn [conn _page]
+                      (p/let [ident (property! conn "mood")
+                              mood (:db/id (d/entity @conn ident))]
+                        (re-own! conn [mood])
+                        (d/transact! conn (vec (for [a [:block/title :block/name] dt (d/datoms @conn :eavt mood a)]
+                                                 [:db/retract (:e dt) (:a dt) (:v dt)])))))
+                    "is held by a choice of  (user.property/mood" true]
+                   ;; A real holder still counts when the choice has lost its own page and parent.
+                   ["a page, with the choice's parent and page retracted"
+                    (fn [conn page]
+                      (re-own! conn [(:db/id (d/entity @conn [:block/uuid (uuid page)]))])
+                      (detach! conn))
+                    "is held by a choice of Notes ()" true]
+                   ;; Two owners can't be held on a conn whose schema has them at cardinality one.
+                   ["a live property and a deleted one"
+                    (fn [conn _page]
+                      (p/let [ident (property! conn "mood")]
+                        (re-own! conn [(:db/id (d/entity @conn ident)) (+ 100000 (:max-eid @conn))])))
+                    "is held by a choice of" false]]]
+          (p/let [_ (js/Promise.
+                     (fn [resolve]
+                       (with-uploaded resolve
+                         (fn [{:keys [conn self]}]
+                           (when (or stale-too? (= :db.cardinality/many
+                                                  (get-in (d/schema @conn) [:block/closed-value-property :db/cardinality])))
+                             (p/let [[page a] (notes-page! self)
+                                     _ (request! self "POST" "/semantic/pages" {:title "Stamp Test"} stamped)
+                                     _ (setup conn page)
+                                     choice-id (:db/id (d/entity @conn [:block/uuid choice-uuid]))
+                                     owners (owner-idents @conn choice-id)
+                                     max-tx (:max-tx @conn)
+                                     edited (request! self "PATCH" (str "/semantic/blocks/" a) {:title "A edited"} stamped)
+                                     health (request! self "GET" "/semantic/health?checks=orphan-choices" nil signed)]
+                               (testing label
+                                 (is (= 409 (:status edited)) (pr-str edited))
+                                 (is (string/includes? (str (get-in edited [:body :error])) expected) (pr-str edited))
+                                 (is (= max-tx (:max-tx @conn)) "nothing is transacted")
+                                 (is (= owners (owner-idents @conn choice-id)) "the choice keeps its owners")
+                                 (is (= 0 (get-in health [:body :checks :orphan-choices :count])) (pr-str health))))))
+                         :stale? true)))]
+            nil))
+        (p/catch #(is false (str % (some-> % .-stack))))
+        (p/finally done))))
+
+(deftest an-ownerless-entity-that-is-not-the-claude-choice-is-not-repaired-test
+  ;; Guards: once :db/retractEntity has taken the claude choice's owner, only an entity with the
+  ;; choice's UUID that still reads claude, and is on no page and isn't a page itself, is re-parented.
+  ;; A page or a block holding that UUID, or one with another title, still refuses, naming it, and
+  ;; nothing is written.
+  (async done
+    (-> (p/doseq [[label setup expected]
+                  [["a page titled claude"
+                    (fn [conn id _page] (d/transact! conn [[:db/add id :block/name "claude"]
+                                                           [:db/add id :block/tags :logseq.class/Page]]))
+                    "is held by a page"]
+                   ["a block titled claude on a page"
+                    (fn [conn id page] (d/transact! conn [[:db/add id :block/page
+                                                           (:db/id (d/entity @conn [:block/uuid (uuid page)]))]]))
+                    "is held by a block"]
+                   ["an entity with another title"
+                    (fn [conn id _page] (d/transact! conn [[:db/add id :block/title "other"]]))
+                    "is held by a block"]]]
+          (p/let [_ (js/Promise.
+                     (fn [resolve]
+                       (with-uploaded resolve
+                         (fn [{:keys [conn self]}]
+                           (p/let [[page a] (notes-page! self)
+                                   _ (request! self "POST" "/semantic/pages" {:title "Stamp Test"} stamped)
+                                   _ (retract-entity! conn (:db/id (d/entity @conn by-ident)))
+                                   choice-id (:db/id (d/entity @conn [:block/uuid choice-uuid]))
+                                   _ (setup conn choice-id page)
+                                   max-tx (:max-tx @conn)
+                                   edited (request! self "PATCH" (str "/semantic/blocks/" a) {:title "A edited"} stamped)]
+                             (testing label
+                               (is (= 409 (:status edited)) (pr-str edited))
+                               (is (string/includes? (str (get-in edited [:body :error])) expected) (pr-str edited))
+                               (is (= max-tx (:max-tx @conn)) "nothing is transacted"))))
+                         :stale? true)))]
+            nil))
+        (p/catch #(is false (str % (some-> % .-stack))))
+        (p/finally done))))
+
+(deftest a-stranded-claude-choice-is-not-re-parented-next-to-another-claude-choice-test
+  ;; Guard: when editedBy already has a claude choice of its own, re-parenting the stranded one would
+  ;; leave two, so the write is refused as when the choice is missing, and nothing is written.
+  (async done
+    (with-uploaded done
+      (fn [{:keys [conn self]}]
+        (p/let [[_page a] (notes-page! self)
+                _ (request! self "POST" "/semantic/pages" {:title "Stamp Test"} stamped)
+                mood (property! conn "mood")
+                _ (re-own! conn [(:db/id (d/entity @conn mood))])
+                _ (unname! conn (:db/id (d/entity @conn mood)))
+                _ (outliner-property/upsert-closed-value! conn by-ident {:id (random-uuid) :value "claude"})
+                max-tx (:max-tx @conn)
+                edited (request! self "PATCH" (str "/semantic/blocks/" a) {:title "A edited"} stamped)]
+          (is (= 409 (:status edited)) (pr-str edited))
+          (is (string/includes? (str (get-in edited [:body :error])) "editedBy has a claude choice that isn't the stamp's")
+              (pr-str edited))
+          (is (= max-tx (:max-tx @conn)) "nothing is transacted")))
+      :stale? true)))
+
+(deftest a-re-parented-claude-choice-takes-a-fresh-order-key-test
+  ;; The re-parent gives the choice a new :block/order, so it never shares a key with a choice editedBy
+  ;; already has.
+  (async done
+    (with-uploaded done
+      (fn [{:keys [conn self]}]
+        (p/let [[_page a] (notes-page! self)
+                _ (request! self "POST" "/semantic/pages" {:title "Stamp Test"} stamped)
+                mood (property! conn "mood")
+                _ (re-own! conn [(:db/id (d/entity @conn mood))])
+                _ (unname! conn (:db/id (d/entity @conn mood)))
+                other (random-uuid)
+                _ (outliner-property/upsert-closed-value! conn by-ident {:id other :value "other"})
+                edited (request! self "PATCH" (str "/semantic/blocks/" a) {:title "A edited"} stamped)
+                orders (mapv #(:block/order (d/entity @conn [:block/uuid %])) [choice-uuid other])]
+          (is (= 200 (:status edited)) (pr-str edited))
+          (is (= #{by-ident} (owner-idents @conn (:db/id (d/entity @conn [:block/uuid choice-uuid])))))
+          (is (every? some? orders) (pr-str orders))
+          (is (apply distinct? orders) (str "editedBy's choices share an order key: " (pr-str orders)))))
+      :stale? true)))
+
+;; ---------------------------------------------------------------------------------------------
+;; get_graph_health
+
+(deftest health-lists-orphaned-choices-test
+  ;; orphan-choices lists every choice whose owner is gone or has no name, with a complete count, and
+  ;; leaves healthy choices (a user property's and the live claude choice) out. It runs by default.
+  (async done
+    (with-uploaded done
+      (fn [{:keys [conn self]}]
+        (p/let [_ (notes-page! self)
+                _ (request! self "POST" "/semantic/pages" {:title "Stamp Test"} stamped)
+                mood (property! conn "mood")
+                phase (property! conn "phase")
+                tone (property! conn "tone")
+                happy (random-uuid)
+                ;; Value order (Active, calm, ignoring case) is neither uuid order nor insertion order.
+                active #uuid "ffffffff-0000-4000-8000-000000000001"
+                calm #uuid "00000000-0000-4000-8000-000000000002"
+                _ (outliner-property/upsert-closed-value! conn mood {:id happy :value "happy"})
+                _ (outliner-property/upsert-closed-value! conn tone {:id calm :value "calm"})
+                _ (outliner-property/upsert-closed-value! conn phase {:id active :value "Active"})
+                phase-id (:db/id (d/entity @conn phase))
+                _ (retract-all! conn phase-id)
+                _ (unname! conn (:db/id (d/entity @conn tone)))
+                ;; Where the schema holds two owners, calm has two stranded ones and is still listed once.
+                _ (when (= :db.cardinality/many (get-in (d/schema @conn) [:block/closed-value-property :db/cardinality]))
+                    (d/transact! conn [[:db/add [:block/uuid calm] :block/closed-value-property phase-id]]))
+                one (request! self "GET" "/semantic/health?checks=orphan-choices" nil signed)
+                all (request! self "GET" "/semantic/health" nil signed)
+                paged (request! self "GET" "/semantic/health?checks=orphan-choices&limit=1" nil signed)
+                cursor (get-in paged [:body :checks :orphan-choices :next-cursor])
+                second-page (request! self "GET" (str "/semantic/health?checks=orphan-choices&limit=1&cursor="
+                                                      (js/encodeURIComponent (str cursor)))
+                                      nil signed)
+                check (get-in one [:body :checks :orphan-choices])]
+          (is (= 200 (:status one)) (pr-str one))
+          (is (= 2 (:count check)) (pr-str check))
+          (is (= [(str active) (str calm)] (mapv :uuid (:items check)))
+              "the stranded Active and calm choices, not happy or claude, in value order ignoring case")
+          (is (= {"Active" "owner-deleted" "calm" "owner-unnamed"}
+                 (into {} (map (juxt :value :reason)) (:items check)))
+              "each item names why its owner doesn't count")
+          (is (= 200 (:status all)) (pr-str all))
+          (is (= 2 (get-in all [:body :checks :orphan-choices :count])) "the check runs by default")
+          (testing "a page of one keeps the complete count and a cursor"
+            (is (= 200 (:status paged)) (pr-str paged))
+            (is (= 2 (get-in paged [:body :checks :orphan-choices :count])))
+            (is (= ["Active"] (mapv :value (get-in paged [:body :checks :orphan-choices :items]))))
+            (is (some? cursor)))
+          (testing "its cursor gives the next choice in value order, and the last page ends the feed"
+            (is (= 200 (:status second-page)) (pr-str second-page))
+            (is (= 2 (get-in second-page [:body :checks :orphan-choices :count])))
+            (is (= ["calm"] (mapv :value (get-in second-page [:body :checks :orphan-choices :items]))))
+            (is (nil? (get-in second-page [:body :checks :orphan-choices :next-cursor]))))))
+      :stale? true)))
