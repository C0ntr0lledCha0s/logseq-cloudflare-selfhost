+(defn- tag-property-label
+  "`tag-properties`, `tag-properties[1]`, or the stored variable's name with the setting it comes from."
+  [{:keys [source] :as label} index]
+  (str (:name label) (when index (str "[" index "]")) (when source (str " " source))))
+
+(defn- parse-tag-property-pairs
+  "The raw JSON pairs as {:pairs [{:tag :property} ...]}, or {:error message} naming `label` (an entry
+  of tag-property-sources): a JSON array of objects with non-empty tag and property strings, holding
+  (:min label) to max-tag-property-pairs pairs."
+  [raw label]
+  (let [parsed (try (js->clj (js/JSON.parse raw)) (catch :default _ ::invalid))
+        text? (fn [value] (and (string? value) (not (string/blank? value))))
+        pair? (fn [pair] (and (map? pair) (text? (get pair "tag")) (text? (get pair "property"))))]
+    (cond
+      (not (and (vector? parsed) (every? pair? parsed)))
+      {:error (str "invalid " (tag-property-label label nil) ": give a JSON array of {\"tag\": …, \"property\": …}")}
+
+      (not (<= (:min label) (count parsed) max-tag-property-pairs))
+      {:error (str (tag-property-label label nil) ": give " (:min label) " to " max-tag-property-pairs
+                   " pairs (got " (count parsed) ")")}
+
+      :else
+      {:pairs (mapv (fn [pair] {:tag (get pair "tag") :property (get pair "property")}) parsed)})))
+
+(defn- has-default-value? [db property]
+  (boolean (or (seq (d/datoms db :eavt (:db/id property) :logseq.property/default-value))
+               (seq (d/datoms db :eavt (:db/id property) :logseq.property/scalar-default-value)))))
+
+(defn- resolve-tag-property-pair
+  "{:pair {:tag :property}} (entities) for one parsed pair, or {:reason message}."
+  [db {:keys [tag property]}]
+  (let [tag-entity (resolve-tag-selector db tag)
+        property-entity (resolve-property-selector db property)]
+    (cond
+      (nil? tag-entity) {:reason (str "tag " (pr-str tag) " not found")}
+      (:logseq.property/built-in? tag-entity) {:reason (str (:block/title tag-entity) " is a built-in tag")}
+      (nil? property-entity) {:reason (str "property " (pr-str property) " not found")}
+      (:logseq.property/built-in? property-entity)
+      {:reason (str (:block/title property-entity) " is a built-in property")}
+      (not (graph-insights/class-lists-property? db (:db/id tag-entity) (:db/id property-entity)))
+      {:reason (str (:block/title tag-entity) " doesn't list " (:block/title property-entity)
+                    " (nor does a tag it extends)")}
+      (has-default-value? db property-entity)
+      {:reason (str (:block/title property-entity) " has a default value, so it always reads as set")}
+      :else {:pair {:tag tag-entity :property property-entity}})))
+
+(defn- resolve-tag-property-pairs
+  "The parsed pairs as {:pairs [{:tag :property} ...]} (entities, a pair given twice kept once, in the
+  order given), or {:error message} naming every pair that doesn't resolve, by its entry in `label`."
+  [db pairs label]
+  (let [resolved (mapv #(resolve-tag-property-pair db %) pairs)
+        refusals (keep-indexed (fn [index {:keys [reason]}]
+                                 (when reason (str (tag-property-label label index) ": " reason)))
+                               resolved)]
+    (if (seq refusals)
+      {:error (string/join "; " refusals)}
+      {:pairs (vec (common-util/distinct-by (fn [{:keys [tag property]}] [(:db/id tag) (:db/id property)])
+                                (map :pair resolved)))})))
+
+(defn- resolve-stored-tag-property-pairs
+  "The stored pairs that resolve in this graph as {:pairs [...]} (as resolve-tag-property-pairs), and
+  under :skipped each one that doesn't, as {:entry \"HEALTH_TAG_PROPERTIES[N]\" :reason ...}: the
+  variable serves every graph on the Worker, so a pair for another graph's tag mustn't refuse here."
+  [db pairs label]
+  (let [resolved (mapv #(resolve-tag-property-pair db %) pairs)]
+    {:pairs (vec (common-util/distinct-by (fn [{:keys [tag property]}] [(:db/id tag) (:db/id property)])
+                                          (keep :pair resolved)))
+     :skipped (vec (keep-indexed (fn [index {:keys [reason]}]
+                                   (when reason {:entry (str (:name label) "[" index "]") :reason reason}))
+                                 resolved))}))
+
+(defn- expected-tag-properties
+  "The pairs missing-tag-properties checks: {:pairs [...] :from \"input\"|\"settings\"|\"none\"}, with
+  :skipped for stored pairs that don't resolve in this graph, or {:error message}. The tag-properties
+  input, when given, replaces the stored pairs, which are then not read."
+  [^js self ^js url db]
+  (let [params (.-searchParams url)]
+    (if (.has params "tag-properties")
+      (let [label (:input tag-property-sources)
+            {:keys [error pairs]} (parse-tag-property-pairs (.get params "tag-properties") label)]
+        (if error {:error error} (assoc (resolve-tag-property-pairs db pairs label) :from "input")))
+      (let [label (:settings tag-property-sources)
+            raw (some-> (.-env self) (aget "HEALTH_TAG_PROPERTIES") str)
+            {:keys [error pairs]} (if (string/blank? raw) {:pairs []} (parse-tag-property-pairs raw label))]
+        (cond
+          error {:error error}
+          (empty? pairs) {:pairs [] :from "none"}
+          :else (assoc (resolve-stored-tag-property-pairs db pairs label) :from "settings"))))))
+
