+(def ^:private ref-pattern
+  "A ref in a stored title: [[uuid]] (db-content/id-ref-pattern's form, which a #[[uuid]] tag also
+  holds) or ((uuid)) (a block ref, stored as typed), in any case. Group 1 or 2 is the uuid."
+  (re-pattern (str "(?i)\\[\\[(" common-util/uuid-pattern ")\\]\\]"
+                   "|\\(\\((" common-util/uuid-pattern ")\\)\\)")))
+
+(defn- recycled-id?
+  "The entity or one of its parents is in the Recycle bin."
+  [db e]
+  (loop [e e
+         seen #{}]
+    (cond
+      (or (nil? e) (contains? seen e)) false
+      (attr-value db e :logseq.property/deleted-at) true
+      :else (recur (attr-value db e :block/parent) (conj seen e)))))
+
+(defn broken-refs
+  "Refs in stored titles whose target has no entity (:reason \"missing\") or is in the Recycle bin,
+  itself or through a parent (\"in-recycle-bin\"), as {:holder :target-uuid :reason}, one per holder
+  and target. A property value block's ref belongs to its owner. Holders in `private`
+  (datalog/private-ids), hidden or built-in are not scanned, and a target in `private` that isn't in
+  the bin is not listed: it exists, so it isn't missing. Titles are matched first, so only titles that
+  hold a ref cost an entity walk."
+  [db private]
+  (->> (d/datoms db :aevt :block/title)
+       (mapcat (fn [{:keys [e v]}]
+                 (when (string? v)
+                   (when-let [targets (seq (re-seq ref-pattern v))]
+                     (let [holder (if (value-block-property db e) (attr-value db e :block/parent) e)]
+                       (when-not (or (nil? holder) (contains? private holder)
+                                     (built-in-id? db holder) (hidden-id? db holder))
+                         (for [[_ page-form block-form] targets]
+                           [holder (string/lower-case (or page-form block-form))])))))))
+       (distinct)
+       (keep (fn [[holder target]]
+               (let [target-id (:e (first (d/datoms db :avet :block/uuid (uuid target))))
+                     reason (cond
+                              (nil? target-id) "missing"
+                              (recycled-id? db target-id) "in-recycle-bin")]
+                 (when reason
+                   {:holder (d/entity db holder) :target-uuid target :reason reason}))))))
