+                typo (request! self "GET" "/semantic/health?checks=broken-ref" nil)]
+          (is (= 200 (:status all)))
+          (is (= 9 (count (get-in all [:body :checks]))))
+          (is (= (count expected) (get-in all [:body :checks :broken-refs :count]))
+              "the default call runs broken-refs")
+          (is (= {:status 400 :body {:error "invalid checks"}} typo)))))))
+
+(deftest broken-refs-upload-path-test
+  ;; The same check on a graph that arrived through the app's snapshot upload.
+  (async done
+    (let [request! #'uploaded/request!
+          signed @#'uploaded/signed]
+      (-> (p/let [{:keys [self]} (#'uploaded/uploaded-graph)
+                  _conn (#'uploaded/open! self)
+                  created (fn [r] (assert (= 201 (:status r)) (pr-str r)) r)
+                  page (p/let [r (request! self "POST" "/semantic/pages" {:title "zz Notes"} signed)] (uuid-of (created r)))
+                  target (p/let [r (request! self "POST" "/semantic/pages" {:title "zz Target"} signed)] (uuid-of (created r)))
+                  [ghost] [(random-uuid)]
+                  _ (p/let [r (request! self "DELETE" (str "/semantic/pages/" target) nil signed)]
+                      (assert (= 200 (:status r)) (pr-str r)))
+                  inserted (p/let [r (request! self "POST" "/semantic/block-trees"
+                                               {:target-id (str page)
+                                                :blocks [{:title (str "zz see " (ref ghost))}
+                                                         {:title (str "zz target " (ref target))}]}
+                                               signed)]
+                             (mapv #(uuid (:uuid %)) (get-in (created r) [:body :blocks])))
+                  response (request! self "GET" "/semantic/health?checks=broken-refs" nil signed)]
+            (is (= 200 (:status response)) (pr-str response))
+            (is (= #{[(first inserted) ghost "missing"] [(second inserted) target "in-recycle-bin"]}
+                   (triples (get-in response [:body :checks :broken-refs])))))
+          (p/catch #(is false (str % "\n" (.-stack %))))
+          (p/finally done)))))
+
+(deftest broken-refs-documented-test
+  (let [operation (get-in (semantic-routes/openapi-document "https://issuer.example")
+                          [:paths "/api/v1/graphs/{graph-id}/health" :get])
+        checks (first (filter #(= "checks" (:name %)) (:parameters operation)))]
+    (is (string/includes? (:description operation) "broken-refs (blocks and pages whose title refers"))
+    (is (every? #(string/includes? (:description operation) %) ["reason missing" "reason in-recycle-bin" "target-uuid"]))
+    (is (string/includes? (:description checks) "orphan-choices, broken-refs, missing-tag-properties. Defaults to all"))))
diff --git a/deps/db-sync/test/logseq/db_sync/semantic_graph_health_tag_properties_test.cljs b/deps/db-sync/test/logseq/db_sync/semantic_graph_health_tag_properties_test.cljs
new file mode 100644
index 0000000..6124c5d
--- /dev/null
+++ b/deps/db-sync/test/logseq/db_sync/semantic_graph_health_tag_properties_test.cljs
@@ -0,0 +1,536 @@
+(ns logseq.db-sync.semantic-graph-health-tag-properties-test
+  "getGraphHealth's missing-tag-properties check (patch 0051): the visible objects tagged with a tag,
+  or with a tag that extends it, that lack an expected property of it, for the expected tag-property
+  pairs only. The pairs come from the tag-properties input (a JSON array of {tag, property}) or, when
+  a call gives none, from the Worker's HEALTH_TAG_PROPERTIES variable (config/settings.json
+  health.expectedTagProperties). Every pair is resolved before the scan, and a bad one refuses the call
+  with 400 naming the entry and where it came from. With no pairs the check lists nothing and says why.
+
+  The graph is written through the real handler (tags with their properties and extends, properties,
+  blocks, tags and values) and transacted directly for what the API can't store: Logseq's empty
+  placeholder as a value, a property's default value and a block in the Recycle bin. Every fixture
+  title holds zz."
+  (:require [cljs.test :refer [async deftest is testing]]
+            [clojure.string :as string]
+            [datascript.core :as d]
+            [logseq.db-sync.semantic-uploaded-graph-schema-test :as uploaded]
+            [logseq.db-sync.test-sql :as test-sql]
+            [logseq.db-sync.worker.handler.semantic :as semantic]
+            [logseq.db-sync.worker.handler.sync :as sync-handler]
+            [logseq.db-sync.worker.routes.semantic :as semantic-routes]
+            [logseq.db.sqlite.export :as sqlite-export]
+            [promesa.core :as p]))
+
+(defn- request!
+  "One semantic API request through the real handler; returns {:status :body}."
+  [self method path body]
+  (p/let [url (str "http://localhost" path (if (string/includes? path "?") "&" "?") "graph-id=graph-1")
+          response (sync-handler/handle-http
+                    self
+                    (js/Request. url (clj->js (cond-> {:method method
+                                                       :headers {"content-type" "application/json"}}
+                                                (some? body) (assoc :body (js/JSON.stringify (clj->js body)))))))
+          text (.text response)]
+    {:status (.-status response)
+     :body (when (seq text)
+             (try (js->clj (js/JSON.parse text) :keywordize-keys true)
+                  (catch :default _ text)))}))
+
+(defn- ok! [response status]
+  (p/let [response response]
+    (assert (= status (:status response)) (pr-str response))
+    response))
+
+(defn- uuid-of [response] (uuid (get-in response [:body :uuid])))
+
+(defn- eid [conn id] (:db/id (d/entity @conn [:block/uuid id])))
+
+(defn- writer [self]
+  {:tag! (fn [title & [body]]
+           (p/let [r (ok! (request! self "POST" "/semantic/tags" (merge {:title title} body)) 201)] (uuid-of r)))
+   :property! (fn [title type & [body]]
+                (p/let [r (ok! (request! self "POST" "/semantic/properties" (merge {:title title :type type} body)) 201)]
+                  {:uuid (uuid-of r) :ident (get-in r [:body :ident]) :title title}))
+   :page! (fn [title] (p/let [r (ok! (request! self "POST" "/semantic/pages" {:title title}) 201)] (uuid-of r)))
+   :put! (fn [id property value]
+           (ok! (request! self "PUT" (str "/semantic/blocks/" id "/properties/" (js/encodeURIComponent property))
+                          {:value value})
+                200))
+   :insert! (fn [target blocks]
+              (p/let [r (ok! (request! self "POST" "/semantic/block-trees" {:target-id (str target) :blocks blocks}) 201)]
+                (mapv #(uuid (:uuid %)) (get-in r [:body :blocks]))))})
+
+(def ^:private stored-label "HEALTH_TAG_PROPERTIES")
+(def ^:private stored-source "(set from a GitHub variable or config/settings.json health.expectedTagProperties)")
+
+(defn- pairs-json [pairs] (js/JSON.stringify (clj->js pairs)))
+
+(defn- query [pairs] (str "&tag-properties=" (js/encodeURIComponent (if (string? pairs) pairs (pairs-json pairs)))))
+
+(defn- set-stored! [^js self pairs]
+  (set! (.-env self) (if (nil? pairs) #js {} #js {"HEALTH_TAG_PROPERTIES" (if (string? pairs) pairs (pairs-json pairs))})))
+
+(defn- seed-graph
+  "Tags zz Book (properties zz author, zz rating, zz notes, and zz format and zz read, which have a
+  default value, a ref and a checkbox's scalar one),
+  zz Novel extending it (zz series) and zz Epic extending zz Novel, and zz Magazine (zz author too);
+  blocks tagged with them on zz Library."
+  []
+  (p/let [conn (sqlite-export/create-conn)
+          self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true :env #js {}}
+          {:keys [tag! property! page! put! insert!]} (writer self)
+          _private (tag! "Private")
+          author (property! "zz author" "default")
+          rating (property! "zz rating" "number")
+          notes (property! "zz notes" "default")
+          format (property! "zz format" "default")
+          series (property! "zz series" "default")
+          read (property! "zz read" "checkbox")
+          book (tag! "zz Book" {:properties ["zz author" "zz rating" "zz notes" "zz format" "zz read"]})
+          novel (tag! "zz Novel" {:extends ["zz Book"] :properties ["zz series"]})
+          epic (tag! "zz Epic" {:extends ["zz Novel"]})
+          magazine (tag! "zz Magazine" {:properties ["zz author"]})
+          library (page! "zz Library")
+          [full no-rating placeholder no-notes bare novel-bare epic-rated private-book binned-book magazine-bare
+           task-block]
+          (insert! library (mapv (fn [t] {:title t})
+                                 ["zz full" "zz no rating" "zz placeholder author" "zz no notes" "zz bare"
+                                  "zz novel bare" "zz epic rated" "zz private book" "zz binned book"
+                                  "zz magazine bare" "zz task block"]))
+          tag-as (fn [id tags] (put! id "block/tags" tags))
+          _ (p/all (map #(tag-as % ["zz Book"]) [full no-rating placeholder no-notes bare binned-book]))
+          _ (tag-as private-book ["zz Book" "Private"])
+          _ (tag-as novel-bare ["zz Novel"])
+          _ (tag-as epic-rated ["zz Epic"])
+          _ (tag-as magazine-bare ["zz Magazine"])
+          _ (tag-as task-block ["Task"])
+          _ (put! full (:ident author) "zz Ann")
+          _ (put! full (:ident rating) 4)
+          _ (put! no-rating (:ident author) "zz Ben")
+          _ (put! placeholder (:ident author) "zz Cat")
+          _ (put! placeholder (:ident rating) 3)
+          _ (put! no-notes (:ident author) "zz Dan")
+          _ (put! no-notes (:ident rating) 5)
+          _ (put! epic-rated (:ident rating) 2)
+          author-ident (keyword (:ident author))
+          placeholder-id (d/entid @conn :logseq.property/empty-placeholder)
+          _ (d/transact! conn [[:db/add (eid conn placeholder) author-ident placeholder-id]
+                               [:db/add [:db/ident (keyword (:ident format))] :logseq.property/default-value placeholder-id]
+                               [:db/add [:db/ident (keyword (:ident read))] :logseq.property/scalar-default-value true]
+                               [:db/add (eid conn binned-book) :logseq.property/deleted-at 1]])]
+    {:conn conn :self self
+     :properties {:author author :rating rating :notes notes :format format :series series}
+     :tags {:book book :novel novel :epic epic :magazine magazine}
+     :ids {:full full :no-rating no-rating :placeholder placeholder :no-notes no-notes :bare bare
+           :novel-bare novel-bare :epic-rated epic-rated :private-book private-book :binned-book binned-book
+           :magazine-bare magazine-bare :task-block task-block :library library}}))
+
+(defn- with-graph [done run]
+  (-> (p/let [graph (seed-graph)] (run graph))
+      (p/catch #(is false (str % "\n" (.-stack %))))
+      (p/finally done)))
+
+(defn- health! [self q]
+  (request! self "GET" (str "/semantic/health?checks=missing-tag-properties" q
+                            (when-not (string/includes? q "limit=") "&limit=200"))
+            nil))
+
+(defn- each!
+  "`f` on each of `xs` in turn (each request sees the env the one before it left), as a vector."
+  [f xs]
+  (reduce (fn [acc x] (p/let [acc acc r (f x)] (conj acc r))) (p/resolved []) xs))
+
+(defn- check! [self q]
+  (p/let [response (health! self q)]
+    (assert (= 200 (:status response)) (pr-str response))
+    (get-in response [:body :checks :missing-tag-properties])))
+
+(defn- found
+  "The check's items as {holder-uuid {tag-title [missing titles]}}."
+  [check]
+  (reduce (fn [result item]
+            (assoc-in result [(uuid (:uuid item)) (get-in item [:tag :title])] (mapv :title (:missing item))))
+          {} (:items check)))
+
+(def ^:private book-pairs [{:tag "zz Book" :property "zz author"} {:tag "zz Book" :property "zz rating"}])
+
+(defn- book-expected [ids]
+  {(:no-rating ids) {"zz Book" ["zz rating"]}
+   (:placeholder ids) {"zz Book" ["zz author"]}
+   (:bare ids) {"zz Book" ["zz author" "zz rating"]}
+   (:novel-bare ids) {"zz Book" ["zz author" "zz rating"]}
+   (:epic-rated ids) {"zz Book" ["zz author"]}})
+
+(defn- snapshot [conn] [(:max-tx @conn) (count (d/datoms @conn :eavt))])
+
+;; Before the fix (Stage 2 tree) every missing-tag-properties call answered 400:
+;;   AssertionError: Assert failed: {:status 400, :body {:error "invalid checks"}}
+(deftest missing-tag-properties-input-test
+  (async done
+    (with-graph done
+      (fn [{:keys [self ids tags properties]}]
+        (p/let [check (check! self (query book-pairs))
+                item (first (filter #(= (str (:no-rating ids)) (:uuid %)) (:items check)))]
+          (is (= (book-expected ids) (found check))
+              "only the expected pairs: zz notes and zz format are listed by zz Book but not expected")
+          (is (= {:uuid (str (:no-rating ids)) :kind "block" :title "zz no rating" :page-id (str (:library ids))
+                  :page-title "zz Library" :tag {:uuid (str (:book tags)) :title "zz Book"}
+                  :missing [{:ident (:ident (:rating properties)) :title "zz rating"}]}
+                 item)
+              "the spec section 4 item shape")
+          (is (contains? (found check) (:placeholder ids)) "an object holding the empty placeholder counts as missing")
+          (is (not (contains? (found check) (:full ids))) "an object with both is not listed")
+          (is (not (contains? (found check) (:no-notes ids))) "zz notes isn't expected")
+          (is (= [{:tag {:uuid (str (:book tags)) :title "zz Book"}
+                   :property {:ident (:ident (:author properties)) :title "zz author"}}
+                  {:tag {:uuid (str (:book tags)) :title "zz Book"}
+                   :property {:ident (:ident (:rating properties)) :title "zz rating"}}]
+                 (:pairs check)))
+          (is (= "input" (:pairs-from check)))
+          (is (nil? (:note check)))
+          (is (= 5 (:count check) (count (:items check)))))))))
+
+(deftest missing-tag-properties-inherited-test
+  ;; Review focus 9: a property two extends up, on an object tagged with the subclass's subclass.
+  (async done
+    (with-graph done
+      (fn [{:keys [self ids]}]
+        (p/let [epic-pairs (check! self (query [{:tag "zz Epic" :property "zz author"}]))
+                novel-own (check! self (query [{:tag "zz Novel" :property "zz series"}]))]
+          (is (= {(:epic-rated ids) {"zz Epic" ["zz author"]}} (found epic-pairs))
+              "zz Epic lists zz author through zz Novel and zz Book; only zz Epic's objects are checked")
+          (is (= {(:novel-bare ids) {"zz Novel" ["zz series"]} (:epic-rated ids) {"zz Novel" ["zz series"]}}
+                 (found novel-own))
+              "a tag's own property, checked on its objects and on its subclass's"))))))
+
+(deftest missing-tag-properties-order-test
+  ;; The pairs are a list: reversed, swapped and chained (a tag and a tag it extends) give the same items.
+  (async done
+    (with-graph done
+      (fn [{:keys [self ids]}]
+        (p/let [chain [{:tag "zz Novel" :property "zz series"} {:tag "zz Book" :property "zz author"}]
+                forward (check! self (query chain))
+                backward (check! self (query (reverse chain)))
+                swapped (check! self (query (reverse book-pairs)))]
+          (is (= (found forward) (found backward)))
+          (is (= {(:novel-bare ids) {"zz Novel" ["zz series"] "zz Book" ["zz author"]}
+                  (:epic-rated ids) {"zz Novel" ["zz series"] "zz Book" ["zz author"]}}
+                 (select-keys (found forward) [(:novel-bare ids) (:epic-rated ids)]))
+              "one item per object and expected tag")
+          (is (= (book-expected ids) (found swapped)))
+          (is (= ["zz author" "zz rating"] (get-in (found swapped) [(:bare ids) "zz Book"]))
+              "missing is in title order, whatever order the pairs came in")
+          (is (= ["zz rating" "zz author"] (map #(get-in % [:property :title]) (:pairs swapped)))
+              "pairs echo the order given"))))))
+
+(deftest missing-tag-properties-selectors-test
+  ;; Every kind of selector the resolvers take, and the re-sends that must not be refused: a duplicate
+  ;; pair, the same pair by title and by UUID or ident, and one property under two tags.
+  (async done
+    (with-graph done
+      (fn [{:keys [self ids tags properties]}]
+        (p/let [{:keys [author rating]} properties
+                by-ids (check! self (query [{:tag (str (:book tags)) :property (str (:uuid author))}
+                                            {:tag "zz book" :property (:ident rating)}]))
+                duplicated (check! self (query (concat book-pairs book-pairs
+                                                       [{:tag (str (:book tags)) :property (:ident author)}])))
+                two-tags (check! self (query [{:tag "zz Book" :property "zz author"}
+                                              {:tag "zz Magazine" :property "zz author"}]))]
+          (is (= (book-expected ids) (found by-ids)) "a tag by UUID and by title in another case; a property by UUID and by ident")
+          (is (= (book-expected ids) (found duplicated)))
+          (is (= 2 (count (:pairs duplicated))) "a pair given twice, or by title and by ids, is checked once")
+          (is (= {"zz Magazine" ["zz author"]} (get (found two-tags) (:magazine-bare ids))))
+          (is (= {"zz Book" ["zz author"]} (get (found two-tags) (:bare ids))))
+          (is (= 2 (count (:pairs two-tags))) "the same property under two tags is two pairs"))))))
+
+(deftest missing-tag-properties-types-test
+  ;; Class sweep: an expected property of each type a user property can have counts as set when the
+  ;; object holds any value, and as missing when it holds none.
+  (async done
+    (-> (p/let [conn (sqlite-export/create-conn)
+                self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true :env #js {"TIMEZONE" "UTC"}}
+                {:keys [tag! property! page! put! insert!]} (writer self)
+                target (page! "zz Target")
+                journal-task (ok! (request! self "POST" "/semantic/tasks" {:title "zz journal task"}) 201)
+                journal (str (:block/uuid (:block/page (d/entity @conn [:block/uuid (uuid-of journal-task)]))))
+                specs [["zz text" "default" "zz words"]
+                       ["zz number" "number" 7]
+                       ["zz node" "node" (str target)]
+                       ["zz url" "url" "https://example.com/zz"]
+                       ["zz date" "date" journal]
+                       ["zz datetime" "datetime" 1763600000000]
+                       ["zz checkbox" "checkbox" false]
+                       ["zz choice" "default" "zz yes"]]
+                created (p/all (map (fn [[title type]]
+                                      (property! title type (when (= title "zz choice") {:choices [{:title "zz yes"} {:title "zz no"}]})))
+                                    specs))
+                _ (tag! "zz Kit" {:properties (mapv first specs)})
+                [held none] (insert! target [{:title "zz held"} {:title "zz none"}])
+                _ (put! held "block/tags" ["zz Kit"])
+                _ (put! none "block/tags" ["zz Kit"])
+                _ (p/doseq [[{:keys [ident]} [_ _ value]] (map vector created specs)]
+                    (put! held ident value))
+                check (check! self (query (mapv (fn [[title]] {:tag "zz Kit" :property title}) specs)))]
+          (is (= {none {"zz Kit" (vec (sort (map first specs)))}} (found check))
+              "default, number, node, url, date, datetime, checkbox (false is a value) and a choice"))
+        (p/catch #(is false (str % "\n" (.-stack %))))
+        (p/finally done))))
+
+(deftest missing-tag-properties-settings-test
+  (async done
+    (with-graph done
+      (fn [{:keys [self ids]}]
+        (p/let [_ (set-stored! self book-pairs)
+                stored (check! self "")
+                overridden (check! self (query [{:tag "zz Magazine" :property "zz author"}]))
+                _ (set-stored! self [{:tag "zz Nope" :property "zz author"}])
+                broken-stored-input (check! self (query book-pairs))]
+          (is (= (book-expected ids) (found stored)))
+          (is (= "settings" (:pairs-from stored)))
+          (is (= 2 (count (:pairs stored))))
+          (is (= {(:magazine-bare ids) {"zz Magazine" ["zz author"]}} (found overridden))
+              "tag-properties replaces the stored pairs for that call")
+          (is (= "input" (:pairs-from overridden)))
+          (is (= (book-expected ids) (found broken-stored-input))
+              "with input given, the stored pairs aren't read, so a broken one doesn't refuse"))))))
+
+(def ^:private no-pairs-note
+  (str "no expected tag-property pairs: pass tag-properties, or set the HEALTH_TAG_PROPERTIES GitHub variable"
+       " or health.expectedTagProperties in config/settings.json"))
+
+(def ^:private all-skipped-note
+  "no stored tag-property pair applies to this graph (see skipped): pass tag-properties for this graph")
+
+(deftest missing-tag-properties-no-pairs-test
+  (async done
+    (with-graph done
+      (fn [{:keys [self]}]
+        (p/let [_ (set-stored! self nil)
+                unset (check! self "")
+                _ (set-stored! self "[]")
+                empty-stored (check! self "")
+                _ (set! (.-env self) nil)
+                no-env (check! self "")]
+          (doseq [[label check] [["no variable" unset] ["the variable []" empty-stored] ["no env" no-env]]]
+            (is (= {:count 0 :items [] :pairs [] :pairs-from "none" :note no-pairs-note} check) label)))))))
+
+(defn- refusal-cases
+  "[pairs expected-reason] for each per-pair refusal on the seeded graph."
+  []
+  [[[{:tag "zz Nope" :property "zz author"}] "tag \"zz Nope\" not found"]
+   [[{:tag "Task" :property "zz author"}] "Task is a built-in tag"]
+   [[{:tag "zz Book" :property "zz nope"}] "property \"zz nope\" not found"]
+   [[{:tag "zz Book" :property "Status"}] "Status is a built-in property"]
+   [[{:tag "zz Book" :property "zz series"}] "zz Book doesn't list zz series (nor does a tag it extends)"]
+   [[{:tag "zz Book" :property "zz format"}] "zz format has a default value, so it always reads as set"]
+   [[{:tag "zz Book" :property "zz read"}] "zz read has a default value, so it always reads as set"]])
+
+(deftest missing-tag-properties-refusals-test
+  (async done
+    (with-graph done
+      (fn [{:keys [self conn]}]
+        (p/let [before (snapshot conn)
+                input (p/all (map (fn [[pairs _]] (health! self (query pairs))) (refusal-cases)))
+                stored (each! (fn [[pairs _]] (set-stored! self pairs) (health! self "")) (refusal-cases))
+                _ (set-stored! self nil)
+                second-bad (health! self (query [{:tag "zz Book" :property "zz author"} {:tag "zz Nope" :property "zz x"}]))
+                both-bad (health! self (query [{:tag "zz Nope" :property "zz x"} {:tag "zz Book" :property "zz format"}]))
+                swapped-bad (health! self (query [{:tag "zz Book" :property "zz format"} {:tag "zz Nope" :property "zz x"}]))
+                shapes (p/all (map #(health! self (query %))
+                                   ["[]" (pairs-json (repeat 51 {:tag "zz Book" :property "zz author"}))
+                                    (pairs-json {:tag "zz Book" :property "zz author"}) "zz Book/zz author" ""
+                                    (pairs-json [{:tag "zz Book"}]) (pairs-json [{:tag "zz Book" :property ""}])
+                                    (pairs-json [{:tag "  " :property "zz author"}]) (pairs-json [["zz Book" "zz author"]])
+                                    (pairs-json [{:tag "zz Book" :property 3}])]))
+                stored-shapes (each! #(do (set-stored! self %) (health! self ""))
+                                      [(pairs-json {:tag "zz Book"}) "not json"
+                                       (pairs-json (repeat 51 {:tag "zz Book" :property "zz author"}))])
+                _ (set-stored! self nil)
+                without-check (request! self "GET" (str "/semantic/health?checks=orphan-tags" (query book-pairs)) nil)
+                after (snapshot conn)]
+          (doseq [[[_ reason] response] (map vector (refusal-cases) input)]
+            (is (= {:status 400 :body {:error (str "tag-properties[0]: " reason)}} response)))
+          ;; Review r1-integrity-1: the stored pairs serve every graph on the Worker, so each per-pair
+          ;; reason skips that pair, named under skipped, and refuses nothing.
+          (doseq [[[_ reason] response] (map vector (refusal-cases) stored)]
+            (is (= {:status 200
+                    :body {:checks {:missing-tag-properties
+                                    {:count 0 :items [] :pairs [] :pairs-from "settings"
+                                     :skipped [{:entry (str stored-label "[0]") :reason reason}]
+                                     :note all-skipped-note}}}}
+                   response)
+                reason))
+          (is (= {:status 400 :body {:error "tag-properties[1]: tag \"zz Nope\" not found"}} second-bad)
+              "the entry's index, counted from 0")
+          (is (= {:status 400 :body {:error (str "tag-properties[0]: tag \"zz Nope\" not found; "
+                                                 "tag-properties[1]: zz format has a default value, so it always reads as set")}}
+                 both-bad)
+              "every bad pair is named")
+          (is (= {:status 400 :body {:error (str "tag-properties[0]: zz format has a default value, so it always reads as set; "
+                                                 "tag-properties[1]: tag \"zz Nope\" not found")}}
+                 swapped-bad))
+          (let [invalid "invalid tag-properties: give a JSON array of {\"tag\": …, \"property\": …}"]
+            (is (= [{:status 400 :body {:error "tag-properties: give 1 to 50 pairs (got 0)"}}
+                    {:status 400 :body {:error "tag-properties: give 1 to 50 pairs (got 51)"}}]
+                   (take 2 shapes)))
+            (is (every? #(= {:status 400 :body {:error invalid}} %) (drop 2 shapes))
+                (pr-str (drop 2 shapes))))
+          (is (= [{:status 400 :body {:error (str "invalid " stored-label " " stored-source ": give a JSON array of {\"tag\": …, \"property\": …}")}}
+                  {:status 400 :body {:error (str "invalid " stored-label " " stored-source ": give a JSON array of {\"tag\": …, \"property\": …}")}}
+                  {:status 400 :body {:error (str stored-label " " stored-source ": give 0 to 50 pairs (got 51)")}}]
+                 stored-shapes))
+          (is (= {:status 400 :body {:error "tag-properties needs the missing-tag-properties check"}} without-check))
+          (is (= before after) "nothing written"))))))
+
+(deftest missing-tag-properties-stored-pair-not-read-test
+  ;; Review focus 10: a malformed stored variable refuses only calls that run the check. Review
+  ;; r1-integrity-1: a stored pair whose tag isn't in this graph (renamed, or another graph's) is
+  ;; skipped, so the default call still runs every check.
+  (async done
+    (with-graph done
+      (fn [{:keys [self ids]}]
+        (p/let [_ (set-stored! self "not json")
+                orphans (request! self "GET" "/semantic/health?checks=orphan-tags" nil)
+                malformed (request! self "GET" "/semantic/health" nil)
+                _ (set-stored! self [{:tag "zz Renamed" :property "zz author"}])
+                default (request! self "GET" "/semantic/health" nil)
+                _ (set-stored! self [{:tag "zz Book" :property "zz author"} {:tag "zz Renamed" :property "zz author"}
+                                     {:tag "zz Book" :property "zz nope"} {:tag "zz Book" :property "zz rating"}])
+                mixed (check! self "")]
+          (is (= 200 (:status orphans)))
+          (is (= [:orphan-tags] (keys (get-in orphans [:body :checks]))))
+          (is (= {:status 400
+                  :body {:error (str "invalid " stored-label " " stored-source
+                                     ": give a JSON array of {\"tag\": …, \"property\": …}")}}
+                 malformed)
+              "a malformed variable is the same on every graph, so it says how to fix the setting")
+          (is (= 200 (:status default)) (pr-str default))
+          (is (= 9 (count (get-in default [:body :checks]))) "every check runs")
+          (is (= {:count 0 :items [] :pairs [] :pairs-from "settings"
+                  :skipped [{:entry (str stored-label "[0]") :reason "tag \"zz Renamed\" not found"}]
+                  :note all-skipped-note}
+                 (get-in default [:body :checks :missing-tag-properties])))
+          (is (= (book-expected ids) (found mixed)) "the pairs that resolve are checked")
+          (is (= ["zz author" "zz rating"] (mapv #(get-in % [:property :title]) (:pairs mixed))))
+          (is (= [{:entry (str stored-label "[1]") :reason "tag \"zz Renamed\" not found"}
+                  {:entry (str stored-label "[2]") :reason "property \"zz nope\" not found"}]
+                 (:skipped mixed)))
+          (is (not (contains? mixed :note))))))))
+
+(deftest missing-tag-properties-second-graph-test
+  ;; Review r1-integrity-1: one Worker, one HEALTH_TAG_PROPERTIES, two graphs. The pairs written for
+  ;; the first graph's tags don't stop a default call on a second graph that has none of them.
+  (async done
+    (with-graph done
+      (fn [{:keys [self ids]}]
+        (p/let [stored (pairs-json book-pairs)
+                _ (set-stored! self stored)
+                other-conn (sqlite-export/create-conn)
+                other #js {:conn other-conn :sql (test-sql/make-sql) :schema-ready true
+                           :env #js {"HEALTH_TAG_PROPERTIES" stored}}
+                {:keys [page! insert!]} (writer other)
+                page (page! "zz Elsewhere")
+                _ (insert! page [{:title "zz an ordinary block"}])
+                first-graph (check! self "")
+                second-graph (request! other "GET" "/semantic/health" nil)]
+          (is (= (book-expected ids) (found first-graph)))
+          (is (= 200 (:status second-graph)) (pr-str second-graph))
+          (is (= 9 (count (get-in second-graph [:body :checks]))))
+          (is (= [{:entry (str stored-label "[0]") :reason "tag \"zz Book\" not found"}
+                  {:entry (str stored-label "[1]") :reason "tag \"zz Book\" not found"}]
+                 (get-in second-graph [:body :checks :missing-tag-properties :skipped])))
+          (is (= [] (get-in second-graph [:body :checks :missing-tag-properties :items]))))))))
+
+(deftest missing-tag-properties-private-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self ids]}]
+        (p/let [{:keys [insert! put!]} (writer self)
+                ;; Review r1-tests-6: hidden and built-in objects, each a zz Book with no zz author:
+                ;; one hidden itself, one under a hidden parent, one on the hidden Quick add page, and
+                ;; one marked built-in.
+                [hidden-book hidden-parent built-in-book] (insert! (:library ids) [{:title "zz hidden book"}
+                                                                                   {:title "zz hidden parent"}
+                                                                                   {:title "zz built-in book"}])
+                [under-hidden] (insert! hidden-parent [{:title "zz book under a hidden parent"}])
+                quick-add (some (fn [d] (let [e (d/entity @conn (:e d))]
+                                          (when (and (= "Quick add" (:v d)) (:logseq.property/built-in? e))
+                                            (:block/uuid e))))
+                                (d/datoms @conn :aevt :block/title))
+                [on-quick-add] (insert! quick-add [{:title "zz book on quick add"}])
+                _ (p/all (map #(put! % "block/tags" ["zz Book"]) [hidden-book under-hidden built-in-book on-quick-add]))
+                _ (d/transact! conn [[:db/add (eid conn hidden-book) :logseq.property/hide? true]
+                                     [:db/add (eid conn hidden-parent) :logseq.property/hide? true]
+                                     [:db/add (eid conn built-in-book) :logseq.property/built-in? true]])
+                check (check! self (query book-pairs))]
+          (is (not (contains? (found check) (:private-book ids))) "a Private book is left out")
+          (is (not (contains? (found check) (:binned-book ids))) "a book in the Recycle bin is left out")
+          (is (not (contains? (found check) (:task-block ids))))
+          (is (not (contains? (found check) hidden-book)) "a hidden book is left out")
+          (is (not (contains? (found check) under-hidden)) "and one under a hidden parent")
+          (is (not (contains? (found check) on-quick-add)) "and one on the hidden Quick add page")
+          (is (not (contains? (found check) built-in-book)) "a built-in book is left out")
+          (is (= (book-expected ids) (found check)) "the visible books are still listed"))))))
+
+(deftest missing-tag-properties-paging-test
+  (async done
+    (with-graph done
+      (fn [{:keys [self ids]}]
+        (p/let [first-page (check! self (str (query book-pairs) "&limit=2"))
+                cursor (:next-cursor first-page)
+                rest-page (check! self (str (query book-pairs) "&limit=10&cursor=" (js/encodeURIComponent cursor)))]
+          (is (= 2 (count (:items first-page))))
+          (is (= [5 5] [(:count first-page) (:count rest-page)]))
+          (is (= (set (keys (book-expected ids))) (into (set (keys (found first-page))) (keys (found rest-page)))))
+          (is (= (sort (map :uuid (concat (:items first-page) (:items rest-page))))
+                 (map :uuid (concat (:items first-page) (:items rest-page))))
+              "holder-uuid order")
+          (is (= "input" (:pairs-from rest-page))))))))
