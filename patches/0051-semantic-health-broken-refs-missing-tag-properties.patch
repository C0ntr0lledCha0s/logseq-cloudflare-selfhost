+    (is (string/includes? (:description (param "checks")) "broken-refs, missing-tag-properties. Defaults to all"))
+    (is (string/includes? (:description (param "tag-properties")) (str "1 to " cap " pairs")))
+    (is (string/includes? (:description operation) (str "1 to " cap " pairs")))))
