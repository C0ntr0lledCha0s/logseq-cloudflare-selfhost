+(def ^:private ref-pattern
+  "A ref in a stored title: [[uuid]] (db-content/id-ref-pattern's form, which a #[[uuid]] tag also
+  holds) or ((uuid)) (a block ref, stored as typed), in any case. Group 1 or 2 is the uuid."
+  (re-pattern (str "(?i)\\[\\[(" common-util/uuid-pattern ")\\]\\]"
+                   "|\\(\\((" common-util/uuid-pattern ")\\)\\)")))
+
+(defn- recycled-id?
+  "The entity or one of its parents is in the Recycle bin."
+  [db e]
+  (loop [e e
+         seen #{}]
+    (cond
+      (or (nil? e) (contains? seen e)) false
+      (attr-value db e :logseq.property/deleted-at) true
+      :else (recur (attr-value db e :block/parent) (conj seen e)))))
+
+(defn broken-refs
+  "Refs in stored titles whose target has no entity (:reason \"missing\") or is in the Recycle bin,
+  itself or through a parent (\"in-recycle-bin\"), as {:holder :target-uuid :reason}, one per holder
+  and target. A property value block's ref belongs to its owner. Holders in `private`
+  (datalog/private-ids), hidden or built-in are not scanned, and a target in `private` that isn't in
+  the bin is not listed: it exists, so it isn't missing. Titles are matched first, so only titles that
+  hold a ref cost an entity walk."
+  [db private]
+  (->> (d/datoms db :aevt :block/title)
+       (mapcat (fn [{:keys [e v]}]
+                 (when (string? v)
+                   (when-let [targets (seq (re-seq ref-pattern v))]
+                     (let [holder (if (value-block-property db e) (attr-value db e :block/parent) e)]
+                       (when-not (or (nil? holder) (contains? private holder)
+                                     (built-in-id? db holder) (hidden-id? db holder))
+                         (for [[_ page-form block-form] targets]
+                           [holder (string/lower-case (or page-form block-form))])))))))
+       (distinct)
+       (keep (fn [[holder target]]
+               (let [target-id (:e (first (d/datoms db :avet :block/uuid (uuid target))))
+                     reason (cond
+                              (nil? target-id) "missing"
+                              (recycled-id? db target-id) "in-recycle-bin")]
+                 (when reason
+                   {:holder (d/entity db holder) :target-uuid target :reason reason}))))))
+
+(defn- class-closure
+  "The class and every class reached from it through `:logseq.property.class/extends` datoms: its
+  ancestors with `index` :eavt, its descendants with :avet. Datoms, as an uploaded graph can hold the
+  attribute at cardinality one in its schema."
+  [db index class-id]
+  (let [next-ids (if (= :eavt index)
+                   (fn [id] (map :v (d/datoms db :eavt id :logseq.property.class/extends)))
+                   (fn [id] (map :e (d/datoms db :avet :logseq.property.class/extends id))))]
+    (loop [seen #{} queue [class-id]]
+      (if-let [id (peek queue)]
+        (if (contains? seen id)
+          (recur seen (pop queue))
+          (recur (conj seen id) (into (pop queue) (next-ids id))))
+        seen))))
+
+(defn class-lists-property?
+  "True when the class, or a class it extends, lists the property in :logseq.property.class/properties
+  (read from datoms)."
+  [db class-id property-id]
+  (boolean (some #(seq (d/datoms db :eavt % :logseq.property.class/properties property-id))
+                 (class-closure db :eavt class-id))))
+
+(defn missing-tag-properties
+  "For each expected pair {:tag :property} (entities), the visible objects tagged with the tag or a
+  class extending it that hold no value for the property or hold Logseq's empty placeholder, as
+  {:holder :tag :missing}, one per object and tag, `missing` being that tag's missing expected
+  properties in title order. Objects in `private` (datalog/private-ids), hidden or built-in are left
+  out."
+  [db private pairs]
+  (let [placeholder-id (d/entid db :logseq.property/empty-placeholder)
+        missing? (fn [object-id ident]
+                   (let [datoms (d/datoms db :eavt object-id ident)]
+                     (or (empty? datoms) (some #(= placeholder-id (:v %)) datoms))))
+        title-order (fn [property] [(string/lower-case (or (:block/title property) "")) (str (:db/ident property))])]
+    (->> pairs
+         (group-by #(:db/id (:tag %)))
+         (mapcat (fn [[tag-id tag-pairs]]
+                   (let [tag (:tag (first tag-pairs))
+                         properties (sort-by title-order (map :property tag-pairs))]
+                     (->> (class-closure db :avet tag-id)
+                          (mapcat #(d/datoms db :avet :block/tags %))
+                          (map :e)
+                          (distinct)
+                          (remove #(or (contains? private %) (built-in-id? db %) (hidden-id? db %)))
+                          (keep (fn [object-id]
+                                  (when-let [missing (seq (filter #(missing? object-id (:db/ident %)) properties))]
+                                    {:holder (d/entity db object-id) :tag tag :missing (vec missing)}))))))))))
