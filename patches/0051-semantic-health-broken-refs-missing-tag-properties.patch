+;; getGraphHealth's broken-refs check (patch 0051) reads titles, which are ciphertext on an E2EE
+;; graph, so the call answers the insights 409 before reading any parameter, and writes nothing.
+(deftest broken-refs-refused-on-e2ee-test
+  (async done
+         (-> (p/let [conn (sqlite-export/create-conn)
+                     [_ page-id] (outliner-page/create! conn "Disposable" {})
+                     ctx (self conn)
+                     before [(:max-tx @conn) (count (d/datoms @conn :eavt))]
+                     responses (p/all (map (fn [query]
+                                             (p/let [response (sync/handle-http
+                                                               ctx
+                                                               (js/Request. (str "http://localhost/semantic/health?graph-id=graph-1&graph-e2ee=true" query)
+                                                                            #js {:method "GET"}))
+                                                     body (.json response)]
+                                               [(.-status response) (aget body "error")]))
+                                           ["&checks=broken-refs" "&checks=broken-refs&limit=0" ""]))
+                     after [(:max-tx @conn) (count (d/datoms @conn :eavt))]]
+               (is (some? page-id))
+               (is (= (repeat 3 [409 "graph insights are unavailable for E2EE graphs"]) responses)
+                   "broken-refs alone, with a bad limit, and in the default set")
+               (is (= before after) "nothing written"))
+             (p/catch #(is false (str %)))
+             (p/finally done))))
