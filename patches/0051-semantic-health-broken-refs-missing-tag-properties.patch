+(deftest missing-tag-properties-upload-path-test
+  ;; On a graph that arrived through the app's snapshot upload, with the class attributes held at
+  ;; cardinality one in the open conn's schema (the app's schema drift): an entity read would see one
+  ;; property and one parent, so the check must read datoms.
+  (async done
+    (let [request! #'uploaded/request!
+          signed @#'uploaded/signed]
+      (-> (p/let [{:keys [self]} (#'uploaded/uploaded-graph)
+                  conn (#'uploaded/open! self)
+                  created (fn [r] (assert (= 201 (:status r)) (pr-str r)) r)
+                  ok (fn [r] (assert (= 200 (:status r)) (pr-str r)) r)
+                  _ (p/doseq [title ["zz author" "zz rating"]]
+                      (p/let [r (request! self "POST" "/semantic/properties" {:title title :type "default"} signed)] (created r)))
+                  _ (p/let [r (request! self "POST" "/semantic/tags" {:title "zz Base"} signed)] (created r))
+                  _ (p/let [r (request! self "POST" "/semantic/tags" {:title "zz Book" :properties ["zz author" "zz rating"]} signed)] (created r))
+                  _ (p/let [r (request! self "POST" "/semantic/tags" {:title "zz Novel" :extends ["zz Base" "zz Book"]} signed)] (created r))
+                  page (p/let [r (request! self "POST" "/semantic/pages" {:title "zz Library"} signed)] (uuid-of (created r)))
+                  [novel] (p/let [r (request! self "POST" "/semantic/block-trees"
+                                              {:target-id (str page) :blocks [{:title "zz novel"}]} signed)]
+                            (mapv #(uuid (:uuid %)) (get-in (created r) [:body :blocks])))
+                  _ (p/let [r (request! self "PUT" (str "/semantic/blocks/" novel "/properties/block%2Ftags")
+                                        {:value ["zz Novel"]} signed)] (ok r))
+                  _ (d/reset-schema! conn (-> (d/schema @conn)
+                                              (assoc-in [:logseq.property.class/properties :db/cardinality] :db.cardinality/one)
+                                              (assoc-in [:logseq.property.class/extends :db/cardinality] :db.cardinality/one)))
+                  _ (set! (.-env self) #js {"HEALTH_TAG_PROPERTIES"
+                                            (pairs-json [{:tag "zz Novel" :property "zz author"}
+                                                         {:tag "zz Novel" :property "zz rating"}])})
+                  response (request! self "GET" "/semantic/health?checks=missing-tag-properties" nil signed)]
+            (is (= 200 (:status response)) (pr-str response))
+            (is (= {novel {"zz Novel" ["zz author" "zz rating"]}}
+                   (found (get-in response [:body :checks :missing-tag-properties]))))
+            (is (= "settings" (get-in response [:body :checks :missing-tag-properties :pairs-from]))))
+          (p/catch #(is false (str % "\n" (.-stack %))))
+          (p/finally done)))))
+
