@@ -0,0 +1,307 @@
+(ns logseq.db-sync.semantic-graph-health-refs-test
+  "getGraphHealth's broken-refs check (patch 0051): every visible block or page whose stored title
+  refers to a uuid, as [[uuid]] (which a #[[uuid]] tag holds) or ((uuid)), that has no entity
+  (reason missing) or whose entity is in the Recycle bin, itself or through a parent (reason
+  in-recycle-bin). A property value block is reported as its owner. A holder that is Private, in the
+  Recycle bin or built-in is not scanned, and a ref to a Private target that isn't in the bin is not
+  listed: the target exists, so missing would be false. One item per holder and target.
+
+  The graph is written through the real handler (tags, pages, blocks, property values, deleteBlock and
+  deletePage, which recycle) and transacted directly for what the API can't store: an uppercase uuid,
+  a built-in holder, and a page whose own title holds a ref. Every fixture title holds zz."
+  (:require [cljs.test :refer [async deftest is testing]]
+            [clojure.string :as string]
+            [datascript.core :as d]
+            [logseq.db-sync.semantic-uploaded-graph-schema-test :as uploaded]
+            [logseq.db-sync.test-sql :as test-sql]
+            [logseq.db-sync.worker.handler.sync :as sync-handler]
+            [logseq.db-sync.worker.routes.semantic :as semantic-routes]
+            [logseq.db.sqlite.export :as sqlite-export]
+            [logseq.outliner.property :as outliner-property]
+            [promesa.core :as p]))
+
+(defn- request!
+  "One semantic API request through the real handler; returns {:status :body}."
+  [self method path body]
+  (p/let [url (str "http://localhost" path (if (string/includes? path "?") "&" "?") "graph-id=graph-1")
+          response (sync-handler/handle-http
+                    self
+                    (js/Request. url (clj->js (cond-> {:method method
+                                                       :headers {"content-type" "application/json"}}
+                                                (some? body) (assoc :body (js/JSON.stringify (clj->js body)))))))
+          text (.text response)]
+    {:status (.-status response)
+     :body (when (seq text)
+             (try (js->clj (js/JSON.parse text) :keywordize-keys true)
+                  (catch :default _ text)))}))
+
+(defn- ok! [response status]
+  (p/let [response response]
+    (assert (= status (:status response)) (pr-str response))
+    response))
+
+(defn- uuid-of [response] (uuid (get-in response [:body :uuid])))
+
+(defn- eid [conn id] (:db/id (d/entity @conn [:block/uuid id])))
+
+(defn- writer
+  "Write helpers on `self`, each through the real handler."
+  [self]
+  {:tag! (fn [title] (p/let [r (ok! (request! self "POST" "/semantic/tags" {:title title}) 201)] (uuid-of r)))
+   :page! (fn [title] (p/let [r (ok! (request! self "POST" "/semantic/pages" {:title title}) 201)] (uuid-of r)))
+   :set-tags! (fn [id titles]
+                (ok! (request! self "PUT" (str "/semantic/blocks/" id "/properties/" (js/encodeURIComponent "block/tags"))
+                               {:value titles})
+                     200))
+   :insert! (fn [target blocks]
+              (p/let [r (ok! (request! self "POST" "/semantic/block-trees" {:target-id (str target) :blocks blocks}) 201)]
+                (mapv #(uuid (:uuid %)) (get-in r [:body :blocks]))))
+   :delete-block! (fn [id] (ok! (request! self "DELETE" (str "/semantic/blocks/" id "?acknowledge-references=true") nil) 200))
+   :delete-page! (fn [id] (ok! (request! self "DELETE" (str "/semantic/pages/" id "?acknowledge-references=true") nil) 200))})
+
+(defn- ref [id] (str "[[" id "]]"))
+(defn- block-ref [id] (str "((" id "))"))
+
+(defn- seed-graph
+  "The graph the namespace docstring describes. Returns the conn, the handler context, the uuids by
+  name and :expected, the set of [holder target reason] items the check must list."
+  []
+  (p/let [conn (sqlite-export/create-conn)
+          self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true}
+          {:keys [tag! page! set-tags! insert! delete-block! delete-page!]} (writer self)
+          _private-tag (tag! "Private")
+          book (tag! "zz Book")
+          notes (page! "zz Notes")
+          valid-page (page! "zz Valid Page")
+          private-page (page! "zz Private Page")
+          binned-page (page! "zz Binned Page")
+          journal-ish (page! "zz Other")
+          _ (set-tags! private-page ["Private"])
+          [ghost ghost-2 ghost-3 ghost-4 ghost-5 ghost-6 page-holder] (repeatedly 7 random-uuid)
+          [doomed-block valid-block private-block binned-block]
+          (insert! journal-ish [{:title "zz doomed block"} {:title "zz valid block"} {:title "zz private block"}
+                                {:title "zz binned block"}])
+          _ (set-tags! private-block ["Private"])
+          [on-private-page] (insert! private-page [{:title "zz block on a private page"}])
+          [on-binned-page on-bin-holder] (insert! binned-page [{:title "zz block on a binned page"}
+                                                               {:title (str "zz on bin holder " (ref ghost-5))}])
+          [missing-holder deleted-holder bin-block-holder on-bin-page-holder
+           forms-holder upper-holder valid-holder private-target-holder value-owner
+           private-holder bin-holder built-in-holder hidden-holder]
+          (insert! notes [{:title (str "zz see " (ref ghost))}
+                          {:title (str "zz deleted block ref " (block-ref doomed-block))}
+                          {:title (str "zz binned block ref " (block-ref binned-block))}
+                          {:title (str "zz ref to a block on a binned page " (block-ref on-binned-page))}
+                          {:title (str "zz forms " (ref ghost-2) " " (block-ref ghost-2) " " (ref ghost-2)
+                                       " #" (ref ghost-3))}
+                          {:title "zz upper placeholder"}
+                          {:title (str "zz valid " (ref valid-page) " " (block-ref valid-block) " " (ref book))}
+                          {:title (str "zz private targets " (ref private-page) " " (block-ref private-block)
+                                       " " (block-ref on-private-page))}
+                          {:title (str "zz value owner " (ref ghost-4))}
+                          {:title (str "zz private holder " (ref ghost-5))}
+                          {:title (str "zz bin holder " (ref ghost-5))}
+                          {:title (str "zz built-in holder " (ref ghost-5))}
+                          {:title (str "zz hidden holder " (ref ghost-5))}])
+          ;; A text property value that links a missing uuid, held by a block whose own title links
+          ;; the same uuid (one item), and one held by a block whose title doesn't (the owner listed).
+          notes-prop (:db/ident (outliner-property/upsert-property!
+                                 conn nil {:logseq.property/type :default :db/cardinality :db.cardinality/one}
+                                 {:property-name "zz notes"}))
+          prop-path (js/encodeURIComponent (subs (str notes-prop) 1))
+          [value-only-owner] (insert! notes [{:title "zz value only owner"}])
+          _ (ok! (request! self "PUT" (str "/semantic/blocks/" value-owner "/properties/" prop-path)
+                           {:value (str "zz about " (ref ghost-4))})
+                 200)
+          _ (ok! (request! self "PUT" (str "/semantic/blocks/" value-only-owner "/properties/" prop-path)
+                           {:value (str "zz about " (ref ghost-6))})
+                 200)
+          _ (set-tags! private-holder ["Private"])
+          ;; deleteBlock retracts the block; deletePage recycles the page with its blocks (and turns
+          ;; [[uuid]] links to it in other titles into its title, so the page ref is written after).
+          ;; A block in the bin by itself is marked as the app's recycle leaves it (deleted-at).
+          _ (delete-block! doomed-block)
+          _ (delete-page! binned-page)
+          [bin-page-holder] (insert! notes [{:title (str "zz page ref " (ref binned-page))}])
+          _ (d/transact! conn [[:db/add (eid conn binned-block) :logseq.property/deleted-at 1]
+                               [:db/add (eid conn bin-holder) :logseq.property/deleted-at 1]])
+          ;; What the API can't store: an uppercase uuid (to a missing and to an existing entity), a
+          ;; built-in holder, and a page whose own title holds a ref.
+          _ (d/transact! conn [[:db/add (eid conn upper-holder) :block/title
+                                (str "zz upper " (ref (string/upper-case (str ghost))) " "
+                                     (ref (string/upper-case (str valid-page))))]
+                               [:db/add (eid conn built-in-holder) :logseq.property/built-in? true]
+                               [:db/add (eid conn hidden-holder) :logseq.property/hide? true]
+                               {:block/uuid page-holder :block/name "zz page holder" :block/title (str "zz page holder " (ref ghost))
+                                :block/tags #{:logseq.class/Page} :block/created-at 1 :block/updated-at 1}])]
+    {:conn conn :self self
+     :ids {:ghost ghost :ghost-2 ghost-2 :ghost-3 ghost-3 :ghost-4 ghost-4 :ghost-5 ghost-5 :ghost-6 ghost-6
+           :notes notes :missing-holder missing-holder :value-owner value-owner :value-only-owner value-only-owner
+           :private-holder private-holder :bin-holder bin-holder :on-bin-holder on-bin-holder
+           :built-in-holder built-in-holder :hidden-holder hidden-holder
+           :valid-holder valid-holder :private-target-holder private-target-holder :page-holder page-holder
+           :forms-holder forms-holder :upper-holder upper-holder
+           :deleted-holder deleted-holder :doomed-block doomed-block}
+     :expected #{[missing-holder ghost "missing"]
+                 [deleted-holder doomed-block "missing"]
+                 [bin-block-holder binned-block "in-recycle-bin"]
+                 [bin-page-holder binned-page "in-recycle-bin"]
+                 [on-bin-page-holder on-binned-page "in-recycle-bin"]
+                 [forms-holder ghost-2 "missing"]
+                 [forms-holder ghost-3 "missing"]
+                 [upper-holder ghost "missing"]
+                 [value-owner ghost-4 "missing"]
+                 [value-only-owner ghost-6 "missing"]
+                 [page-holder ghost "missing"]}}))
+
+(defn- with-graph [done run]
+  (-> (p/let [graph (seed-graph)] (run graph))
+      (p/catch #(is false (str % "\n" (.-stack %))))
+      (p/finally done)))
+
+(defn- check! [self & [query]]
+  (p/let [response (request! self "GET" (str "/semantic/health?checks=broken-refs" (or query "&limit=200")) nil)]
+    (assert (= 200 (:status response)) (pr-str response))
+    (get-in response [:body :checks :broken-refs])))
+
+(defn- triples [check]
+  (set (map (fn [item] [(uuid (:uuid item)) (uuid (:target-uuid item)) (:reason item)]) (:items check))))
+
+(defn- holders [check] (set (map :uuid (:items check))))
+
+;; Before the fix (Stage 1 tree) every broken-refs call answered 400:
+;;   AssertionError: Assert failed: {:status 400, :body {:error "invalid checks"}}
+(deftest broken-refs-missing-test
+  (async done
+    (with-graph done
+      (fn [{:keys [self ids]}]
+        (p/let [{:keys [ghost missing-holder notes]} ids
+                check (check! self)
+                item (first (filter #(and (= (str missing-holder) (:uuid %)) (= (str ghost) (:target-uuid %)))
+                                    (:items check)))]
+          (is (= {:uuid (str missing-holder) :kind "block" :title (str "zz see " (ref ghost))
+                  :page-id (str notes) :page-title "zz Notes" :target-uuid (str ghost) :reason "missing"}
+                 item)
+              "the spec's repro: a [[uuid]] with no entity, with the spec section 4 item shape"))))))
+
+(deftest broken-refs-in-recycle-bin-test
+  (async done
+    (with-graph done
+      (fn [{:keys [self expected ids]}]
+        (p/let [check (check! self)
+                bin (set (filter #(= "in-recycle-bin" (nth % 2)) expected))]
+          (is (= 3 (count bin)))
+          (is (every? (triples check) bin)
+              "a ((uuid)) to a block in the bin, a [[uuid]] to a page deletePage recycled, and a ((uuid)) to a block on that page")
+          (is (contains? (triples check) [(:deleted-holder ids) (:doomed-block ids) "missing"])
+              "a ((uuid)) to a block deleteBlock retracted is missing"))))))
+
+(deftest broken-refs-skips-test
+  (async done
+    (with-graph done
+      (fn [{:keys [self ids]}]
+        (p/let [{:keys [valid-holder private-holder bin-holder on-bin-holder built-in-holder hidden-holder ghost-5]} ids
+                check (check! self)]
+          (is (not (contains? (holders check) (str valid-holder)))
+              "refs to a live page, block and tag (and an uppercase ref to a live page) are not listed")
+          (is (not (contains? (holders check) (str private-holder))) "a Private holder is not scanned")
+          (is (not (contains? (holders check) (str bin-holder))) "a holder in the Recycle bin is not scanned")
+          (is (not (contains? (holders check) (str on-bin-holder))) "nor is a holder on a recycled page")
+          (is (not (contains? (holders check) (str built-in-holder))) "a built-in holder is not scanned")
+          (is (not (contains? (holders check) (str hidden-holder))) "a hidden holder is not scanned")
+          (is (not-any? #(= (str ghost-5) (:target-uuid %)) (:items check))))))))
+
+(deftest broken-refs-forms-test
+  (async done
+    (with-graph done
+      (fn [{:keys [self expected ids]}]
+        (p/let [{:keys [private-target-holder value-owner ghost-4]} ids
+                check (check! self)
+                found (triples check)
+                value-block-ids (set (map str (keep :block/uuid (:block/_parent (d/entity @(.-conn self) [:block/uuid value-owner])))))]
+          (testing "[[uuid]], ((uuid)), #[[uuid]] and a repeated target in one title"
+            (is (= #{[(:forms-holder ids) (:ghost-2 ids) "missing"] [(:forms-holder ids) (:ghost-3 ids) "missing"]}
+                   (set (filter #(= (:forms-holder ids) (first %)) found)))
+                "one item per target, though the title holds one three times in two forms and one as a tag"))
+          (is (contains? found [(:value-owner ids) ghost-4 "missing"])
+              "a ref in a property value block's title and in its owner's title is one item, for the owner")
+          (is (contains? found [(:value-only-owner ids) (:ghost-6 ids) "missing"])
+              "a ref only in a property value block's title is reported as its owner block")
+          (is (not-any? #(contains? value-block-ids (:uuid %)) (:items check)) "no value block is an item")
+          (is (= #{[(:upper-holder ids) (:ghost ids) "missing"]} (set (filter #(= (:upper-holder ids) (first %)) found)))
+              "an uppercase uuid matches (a live one isn't listed), and target-uuid is lower case")
+          (is (some #(and (= (str (:upper-holder ids)) (:uuid %)) (= (str (:ghost ids)) (:target-uuid %))) (:items check)))
+          (is (not (contains? (holders check) (str private-target-holder)))
+              "refs to a Private page, a Private block and a block on a Private page are not listed")
+          (is (some #(and (= (str (:page-holder ids)) (:uuid %)) (= "page" (:kind %))) (:items check))
+              "a page whose own title holds a ref is listed as a page")
+          (is (= expected found) "exactly the expected items")
+          (is (= (count expected) (:count check) (count (:items check)))))))))
+
+(deftest broken-refs-paging-test
+  (async done
+    (-> (p/let [conn (sqlite-export/create-conn)
+                self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true}
+                {:keys [page! insert!]} (writer self)
+                page (page! "zz Paging")
+                _ (insert! page (mapv (fn [i] {:title (str "zz broken " i " " (ref (random-uuid)))}) (range 3)))
+                first-page (check! self "&limit=2")
+                cursor (:next-cursor first-page)
+                second-page (check! self (str "&limit=2&cursor=" (js/encodeURIComponent cursor)))
+                mixed (request! self "GET" (str "/semantic/health?checks=broken-refs,orphan-tags&cursor="
+                                                (js/encodeURIComponent cursor)) nil)]
+          (is (= 2 (count (:items first-page))))
+          (is (string? cursor))
+          (is (= 1 (count (:items second-page))) "the cursor returns the third")
+          (is (nil? (:next-cursor second-page)))
+          (is (= [3 3] [(:count first-page) (:count second-page)]) "the count is complete on both pages")
+          (is (= 3 (count (into (holders first-page) (holders second-page)))) "no holder twice, none skipped")
+          (is (= {:status 400 :body {:error "cursor needs exactly one check"}} mixed)))
+        (p/catch #(is false (str % "\n" (.-stack %))))
+        (p/finally done))))
+
+(deftest broken-refs-default-set-test
+  (async done
