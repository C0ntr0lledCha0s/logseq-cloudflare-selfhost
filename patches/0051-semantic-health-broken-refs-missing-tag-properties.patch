+        (p/let [all (request! self "GET" "/semantic/health?limit=200" nil)
+                typo (request! self "GET" "/semantic/health?checks=broken-ref" nil)]
+          (is (= 200 (:status all)))
+          (is (= 8 (count (get-in all [:body :checks]))))
