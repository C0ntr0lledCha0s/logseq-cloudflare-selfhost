+;; getGraphHealth's broken-refs check (patch 0051) reads titles, which are ciphertext on an E2EE
+;; graph, so the call answers the insights 409 before reading any parameter, and writes nothing.
+(deftest broken-refs-refused-on-e2ee-test
+  (async done
+         (-> (p/let [conn (sqlite-export/create-conn)
+                     [_ page-id] (outliner-page/create! conn "Disposable" {})
+                     ctx (self conn)
+                     before [(:max-tx @conn) (count (d/datoms @conn :eavt))]
+                     responses (p/all (map (fn [query]
+                                             (p/let [response (sync/handle-http
+                                                               ctx
+                                                               (js/Request. (str "http://localhost/semantic/health?graph-id=graph-1&graph-e2ee=true" query)
+                                                                            #js {:method "GET"}))
+                                                     body (.json response)]
+                                               [(.-status response) (aget body "error")]))
+                                           ["&checks=broken-refs" "&checks=broken-refs&limit=0" ""]))
+                     after [(:max-tx @conn) (count (d/datoms @conn :eavt))]]
+               (is (some? page-id))
+               (is (= (repeat 3 [409 "graph insights are unavailable for E2EE graphs"]) responses)
+                   "broken-refs alone, with a bad limit, and in the default set")
+               (is (= before after) "nothing written"))
+             (p/catch #(is false (str %)))
+             (p/finally done))))
+
+;; getGraphHealth's missing-tag-properties check (patch 0051) resolves tag and property titles, which
+;; are ciphertext on an E2EE graph, so the call answers the insights 409 before reading tag-properties
+;; or the stored pairs, even a malformed one, and writes nothing.
+(deftest missing-tag-properties-refused-on-e2ee-test
+  (async done
+         (-> (p/let [conn (sqlite-export/create-conn)
+                     [_ page-id] (outliner-page/create! conn "Disposable" {})
+                     ctx (self conn)
+                     _ (set! (.-env ctx) #js {"HEALTH_TAG_PROPERTIES" "not json"})
+                     before [(:max-tx @conn) (count (d/datoms @conn :eavt))]
+                     pairs (js/encodeURIComponent "[{\"tag\":\"Book\",\"property\":\"author\"}]")
+                     responses (p/all (map (fn [query]
+                                             (p/let [response (sync/handle-http
+                                                               ctx
+                                                               (js/Request. (str "http://localhost/semantic/health?graph-id=graph-1&graph-e2ee=true" query)
+                                                                            #js {:method "GET"}))
+                                                     body (.json response)]
+                                               [(.-status response) (aget body "error")]))
+                                           ["&checks=missing-tag-properties"
+                                            (str "&checks=missing-tag-properties&tag-properties=" pairs)
+                                            "&checks=missing-tag-properties&tag-properties=%5B%5D"
+                                            (str "&checks=orphan-tags&tag-properties=" pairs)]))
+                     after [(:max-tx @conn) (count (d/datoms @conn :eavt))]]
+               (is (some? page-id))
+               (is (= (repeat 4 [409 "graph insights are unavailable for E2EE graphs"]) responses)
+                   "stored pairs (malformed), given pairs, [] and tag-properties without the check")
+               (is (= before after) "nothing written"))
+             (p/catch #(is false (str %)))
+             (p/finally done))))
