+(defn- batch-entries-error
+  "Why a property batch can't be applied, naming the first bad entry by index; nil when every entry resolved."
+  [entries resolved]
+  (if-not (and (sequential? entries) (seq entries))
+    "entries must be a non-empty array"
+    (some (fn [[index {:keys [block property-ident prepared]}]]
+            (when-let [reason (cond
+                                (nil? block) "block not found"
+                                (nil? property-ident) "property not found"
+                                :else (:error prepared))]
+              (str "entry " index ": " reason)))
+          (map-indexed vector resolved))))
+
