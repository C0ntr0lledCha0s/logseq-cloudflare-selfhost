+(deftest semantic-batch-property-errors-name-the-entry-and-reason-test
+  (async done
+         (with-memory-sql-async
+           (fn [sql]
+             (storage/init-schema! sql)
+             (let [conn (sqlite-export/create-conn)
+                   page-id (random-uuid)
+                   block-id (random-uuid)
+                   status-id (str (:block/uuid (d/entity @conn :logseq.property/status)))
+                   _ (d/transact! conn
+                                  [{:block/uuid page-id :block/name "page" :block/title "Page"
+                                    :block/tags :logseq.class/Page
+                                    :block/created-at 1 :block/updated-at 1}
+                                   {:block/uuid block-id :block/title "Block"
+                                    :block/page [:block/uuid page-id]
+                                    :block/parent [:block/uuid page-id]
+                                    :block/order "a0"
+                                    :block/created-at 1 :block/updated-at 1}])
+                   self #js {:sql sql :conn conn :schema-ready true}
+                   valid {:block-id (str block-id) :property-id status-id :value "DONE"}
+                   error-for (fn [path body]
+                               (p/let [response (sync-handler/handle-http
+                                                 self (semantic-json-request
+                                                       (str path "?graph-id=graph-1") "POST" body))
+                                       body (json-body response)]
+                                 [(.-status response) (:error body)]))
+                   set-error (partial error-for "/semantic/block-properties/batch-set")
+                   delete-error (partial error-for "/semantic/block-properties/batch-delete")]
+               (-> (p/let [string-entries (set-error {:entries (js/JSON.stringify (clj->js [valid]))})
+                           missing-entries (set-error {})
+                           empty-entries (set-error {:entries []})
+                           missing-block (set-error {:entries [valid (assoc valid :block-id (str (random-uuid)))]})
+                           missing-property (set-error {:entries [(assoc valid :property-id "Missing Property")]})
+                           bad-value (set-error {:entries [(assoc valid :value "Not A Status")]})
+                           delete-string-entries (delete-error {:entries "[]"})
+                           delete-missing-block (delete-error {:entries [(dissoc (assoc valid :block-id (str (random-uuid))) :value)]})]
+                     (is (= [400 "entries must be a non-empty array"] string-entries))
+                     (is (= [400 "entries must be a non-empty array"] missing-entries))
+                     (is (= [400 "entries must be a non-empty array"] empty-entries))
+                     (is (= [400 "entry 1: block not found"] missing-block))
+                     (is (= [400 "entry 0: property not found"] missing-property))
+                     (is (= 400 (first bad-value)))
+                     (is (string/starts-with? (second bad-value) "entry 0: property value must resolve"))
+                     (is (= [400 "entries must be a non-empty array"] delete-string-entries))
+                     (is (= [400 "entry 0: block not found"] delete-missing-block))
+                     (is (nil? (:logseq.property/status (d/entity @conn [:block/uuid block-id])))
+                         "a rejected batch writes nothing, including its valid entries"))
+                   (p/then (fn [] (done)))
+                   (p/catch (fn [error]
+                              (is false (str error))
+                              (done)))))))))
