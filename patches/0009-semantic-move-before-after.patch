+
+(deftest semantic-move-blocks-places-blocks-where-the-position-says-test
+  (async done
+    (with-tree-identity-test done
+      (fn [{:keys [conn page-id request self]}]
+        (let [[a b b1 c m] (repeatedly 5 random-uuid)
+              titles-under (fn [parent-uuid]
+                             (->> (:block/_parent (d/entity @conn [:block/uuid parent-uuid]))
+                                  (sort-by :block/order)
+                                  (mapv :block/title)))
+              move! (fn [position target]
+                      (p/let [response (sync-handler/handle-http
+                                        self (semantic-json-request "/semantic/block-moves?graph-id=graph-1" "POST"
+                                                                    {:block-ids [(str m)] :target-id (str target)
+                                                                     :position position}))]
+                        (.-status response)))]
+          (p/let [_ (request {:target-id (str page-id)
+                              :blocks [{:uuid (str a) :title "A"}
+                                       {:uuid (str b) :title "B" :children [{:uuid (str b1) :title "B1"}]}
+                                       {:uuid (str c) :title "C"}
+                                       {:uuid (str m) :title "M"}]})
+                  s1 (move! "after" a)
+                  _ (is (= [200 ["A" "M" "B" "C"]] [s1 (titles-under page-id)]) "after makes a next sibling")
+                  s2 (move! "before" a)
+                  _ (is (= [200 ["M" "A" "B" "C"]] [s2 (titles-under page-id)]) "before the first block")
+                  s3 (move! "after" b)
+                  _ (is (= [200 ["A" "B" "M" "C"] ["B1"]] [s3 (titles-under page-id) (titles-under b)])
+                        "after a block with children is still a sibling")
+                  s4 (move! "before" c)
+                  _ (is (= [200 ["A" "B" "M" "C"]] [s4 (titles-under page-id)])
+                        "before the block right after it leaves it in place")
+                  s5 (move! "before" b)
+                  _ (is (= [200 ["A" "M" "B" "C"]] [s5 (titles-under page-id)]))
+                  s6 (move! "first-child" b)
+                  _ (is (= [200 ["M" "B1"]] [s6 (titles-under b)]))
+                  s7 (move! "last-child" b)
+                  _ (is (= [200 ["B1" "M"]] [s7 (titles-under b)]))
+                  s8 (move! "after" page-id)]
+            (is (= 400 s8) "a page has no siblings to move next to")))))))
