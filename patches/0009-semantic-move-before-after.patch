+(defn- move-destination
+  "The outliner target and options that put `blocks` at `position` relative to `target`. The
+  outliner's :top? and :bottom? address the target's children (:bottom? lands after its last
+  child), so a sibling placement must name the block to follow with :sibling? alone."
+  [blocks target position]
+  (case position
+    "after" [target {:sibling? true}]
+    "before" (let [moving (set (map :db/id blocks))]
+               ;; Follow the nearest left sibling that isn't moving; with none, become the first child.
+               (loop [left (ldb/get-left-sibling target)]
+                 (cond
+                   (nil? left) [(:block/parent target) {:sibling? false :top? true}]
+                   (contains? moving (:db/id left)) (recur (ldb/get-left-sibling left))
+                   :else [left {:sibling? true}])))
+    "first-child" [target {:sibling? false :top? true}]
+    "last-child" [target {:sibling? false :bottom? true}]))
+
