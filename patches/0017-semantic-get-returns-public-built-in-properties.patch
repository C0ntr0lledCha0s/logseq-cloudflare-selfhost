+(defn- shown-property?
+  "Whether a property value is shown in a response: a user or library property, or a built-in
+  one Logseq marks public, as the editor shows it."
+  [k]
+  (or (not (db-property/internal-property? k))
+      (and (db-property/logseq-property? k)
+           (contains? db-property/public-built-in-properties k))))
