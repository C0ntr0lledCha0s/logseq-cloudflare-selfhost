+(deftest default-property-given-page-uuid-test
+  ;; The related report: one batch setting objective (text), project (default type, given a page
+  ;; UUID) and topic (node, given a page UUID) returned 500.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self blocks journal-id plain-a plain-b objective project topic due points dates]}]
+        (let [[_ _ _ _ _ _ _ _ b8 b9 b10 b11] blocks
+              value-blocks (fn [property]
+                             (count (d/datoms @conn :avet :logseq.property/created-from-property
+                                              (:db/id (d/entity @conn (:db/ident property))))))
+              stored (fn [block property] (get (d/entity @conn [:block/uuid block]) (:db/ident property)))]
+          (p/let [batch (batch-set! self
+                                    (set-entry b8 (ident-id objective) "Ship it")
+                                    (set-entry b8 (ident-id project) (str plain-a))
+                                    (set-entry b8 (ident-id topic) (str plain-b)))
+                  put (request! self "PUT" (str "/semantic/blocks/" b9 "/properties/"
+                                                (js/encodeURIComponent (ident-id project)))
+                                {:value (str plain-a)})
+                  topic-only (batch-set! self (set-entry b10 (ident-id topic) (str plain-b)))
+                  topic-read (request! self "GET" (str "/semantic/blocks/" b10) nil)
+                  ;; Other types the outliner's validator refuses a page for.
+                  date-page (batch-set! self (set-entry b11 (ident-id due) (str plain-a)))
+                  number-page (batch-set! self (set-entry b11 (ident-id points) (str plain-a)))
+                  date-journal (batch-set! self (set-entry b11 (ident-id due) (str journal-id)))
+                  ;; A list whose first item the type takes and whose second it doesn't.
+                  dates-list (batch-set! self (set-entry b10 (ident-id dates) [(str journal-id) (str plain-a)]))
+                  dates-list-put (request! self "PUT" (str "/semantic/blocks/" b10 "/properties/"
+                                                           (js/encodeURIComponent (ident-id dates)))
+                                           {:value [(str journal-id) (str plain-b)]})]
+            (testing "batch: refused up front, naming the entry and the property"
+              (is (= 400 (:status batch)) (pr-str (:body batch)))
+              (let [error (str (get-in batch [:body :error]))]
+                (is (string/starts-with? error "entry 1: ") error)
+                (is (string/includes? error "project") error)))
+            (testing "the refused batch writes nothing and leaves no value blocks"
+              (is (nil? (stored b8 objective)))
+              (is (nil? (stored b8 project)))
+              (is (nil? (stored b8 topic)))
+              (is (= 0 (value-blocks objective)))
+              (is (= 0 (value-blocks project))))
+            (testing "single set: refused with a message naming the property"
+              (is (= 400 (:status put)) (pr-str (:body put)))
+              (is (string/includes? (str (get-in put [:body :error])) "project") (pr-str (:body put)))
+              (is (nil? (stored b9 project))))
+            (testing "control: a node property given a page UUID is set and reads back"
+              (is (= 200 (:status topic-only)) (pr-str (:body topic-only)))
+              (is (= 200 (:status topic-read)) (pr-str (:body topic-read)))
+              (is (= [(str plain-b)] (value-uuids topic-read topic))))
+            (testing "other types given a page they don't take are refused, naming the entry and property"
+              (doseq [[label r property] [["date property given a plain page" date-page "due"]
+                                          ["number property given a page" number-page "points"]]]
+                (is (= 400 (:status r)) (str label ": " (pr-str (:body r))))
+                (is (string/starts-with? (str (get-in r [:body :error])) (str "entry 0: " property ": "))
+                    (str label ": " (pr-str (:body r)))))
+              (is (nil? (stored b11 points)))
+              (testing "control: a date property given a journal page is set"
+                (is (= 200 (:status date-journal)) (pr-str (:body date-journal)))
+                (is (= journal-id (:block/uuid (stored b11 due))))))
+            (testing "every item of a list is checked, not only the first"
+              (doseq [[label r bad] [["batch" dates-list plain-a] ["single set" dates-list-put plain-b]]]
+                (is (= 400 (:status r)) (str label ": " (pr-str (:body r))))
+                (let [error (str (get-in r [:body :error]))]
+                  (is (string/includes? error (str "dates: \"" bad "\" should be a journal date")) (str label ": " error))))
+              (is (string/starts-with? (str (get-in dates-list [:body :error])) "entry 0: dates: ")
+                  (pr-str (:body dates-list)))
+              (is (nil? (stored b10 dates)) "nothing of the refused list is stored"))))))))
+
+(deftest typed-value-refused-up-front-test
+  ;; A value a property's type doesn't take is refused before anything is written, naming the
+  ;; entry and the property, whatever the type: built-in datetime properties (Deadline,
+  ;; Scheduled), which store a raw number, a checkbox, and text, URL and number properties, whose
+  ;; values are value blocks of the property's own.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self blocks host-id journal-id other-block link-block plain-a about objective
+                   project estimate points link done]}]
+        (let [[_ _ _ _ _ _ _ _ _ _ _ _ b12 b13 b14 b15 b16 b17] blocks
+              deadline "logseq.property/deadline"
+              scheduled "logseq.property/scheduled"
+              put! (fn [block property value]
+                     (request! self "PUT" (str "/semantic/blocks/" block "/properties/"
+                                               (js/encodeURIComponent property))
+                               {:value value}))
+              stored (fn [block ident] (get (d/entity @conn [:block/uuid block]) ident))
+              value-uuid (fn [block property]
+                           (:block/uuid (stored block (:db/ident property))))]
+          (p/let [;; Raw-valued (non-ref) types.
+                  deadline-journal (batch-set! self (set-entry b12 deadline (str journal-id)))
+                  deadline-iso (batch-set! self (set-entry b12 deadline "2026-11-10"))
+                  scheduled-put (put! b12 scheduled (str journal-id))
+                  checkbox-text (batch-set! self (set-entry b12 (ident-id done) "yes"))
+                  mixed (batch-set! self
+                                    (set-entry b13 (ident-id about) (str plain-a))
+                                    (set-entry b13 deadline "next week"))
+                  deadline-ms (batch-set! self (set-entry b14 deadline 1794268800000))
+                  checkbox-ok (put! b14 (ident-id done) true)
+                  ;; Value-block types given an entity that isn't one of the property's values.
+                  objective-set (batch-set! self (set-entry b15 (ident-id objective) "Ship it"))
+                  objective-value (value-uuid b15 objective)
+                  project-content (batch-set! self (set-entry b16 (ident-id project) (str other-block)))
+                  project-other-value (put! b16 (ident-id project) (str objective-value))
+                  ;; Deleting b16's project never touches b15's objective.
+                  _ (request! self "DELETE" (str "/semantic/blocks/" b16 "/properties/"
+                                                 (js/encodeURIComponent (ident-id project))) nil)
+                  _ (batch-set! self (set-entry b15 (ident-id points) 3))
+                  points-value (value-uuid b15 points)
+                  estimate-other-value (batch-set! self (set-entry b16 (ident-id estimate) (str points-value)))
+                  link-content (batch-set! self (set-entry b16 (ident-id link) (str link-block)))
+                  ;; Control: a UUID of the property's own value still reuses that value.
+                  project-first (put! b17 (ident-id project) "Shared project")
+                  project-value (value-uuid b17 project)
+                  project-reuse (put! b16 (ident-id project) (str project-value))
+                  ;; The insert tools name the property once.
+                  insert (request! self "POST" (str "/semantic/blocks/" host-id "/children")
+                                   {:position "append"
+                                    :blocks [{:title "x" :properties {"project" (str plain-a)}}]})
+                  insert-deadline (request! self "POST" (str "/semantic/blocks/" host-id "/children")
+                                            {:position "append"
+                                             :blocks [{:title "y" :properties {deadline "2026-11-10"}}]})]
+            (testing "built-in datetime and checkbox properties refuse a value they can't store"
+              (doseq [[label r prefix value reason]
+                      [["deadline given a journal UUID" deadline-journal "entry 0: Deadline: " (str journal-id) "should be a datetime"]
+                       ["deadline given a date string" deadline-iso "entry 0: Deadline: " "2026-11-10" "should be a datetime"]
+                       ["scheduled given a journal UUID by single set" scheduled-put "Scheduled: " (str journal-id) "should be a datetime"]
+                       ["checkbox given text" checkbox-text "entry 0: done: " "yes" "should be a boolean"]
+                       ["a bad entry after a good one" mixed "entry 1: Deadline: " "next week" "should be a datetime"]]]
+                (is (= 400 (:status r)) (str label ": " (pr-str (:body r))))
+                (is (= (str prefix (pr-str value) " " reason) (get-in r [:body :error]))
+                    (str label ": " (pr-str (:body r)))))
+              (is (nil? (stored b12 :logseq.property/deadline)))
+              (is (nil? (stored b13 (:db/ident about))) "the refused batch writes nothing"))
+            (testing "control: epoch milliseconds and a boolean are set"
+              (is (= 200 (:status deadline-ms)) (pr-str (:body deadline-ms)))
+              (is (= 1794268800000 (stored b14 :logseq.property/deadline)))
+              (is (= 200 (:status checkbox-ok)) (pr-str (:body checkbox-ok)))
+              (is (true? (stored b14 (:db/ident done)))))
+            (is (= 200 (:status objective-set)) (pr-str (:body objective-set)))
+            (is (= 3 (:logseq.property/value (stored b15 (:db/ident points)))))
+            (testing "text, URL and number properties take only a value of their own by UUID"
+              (doseq [[label r prefix value property]
+                      [["text property given a content block" project-content "entry 0: project: " other-block "project"]
+                       ["text property given another property's value" project-other-value "project: " objective-value "project"]
+                       ["number property given another property's value" estimate-other-value "entry 0: estimate: " points-value "estimate"]
+                       ["URL property given a block whose text is a URL" link-content "entry 0: link: " link-block "link"]]]
+                (is (= 400 (:status r)) (str label ": " (pr-str (:body r))))
+                (is (= (str prefix (pr-str (str value)) " is not a value of " property) (get-in r [:body :error]))
+                    (str label ": " (pr-str (:body r)))))
+              (is (nil? (stored b16 (:db/ident estimate))))
+              (is (nil? (stored b16 (:db/ident link)))))
+            (testing "control: the property's own value is reused by UUID"
+              (is (= 200 (:status project-first)) (pr-str (:body project-first)))
+              (is (= 200 (:status project-reuse)) (pr-str (:body project-reuse))))
+            (testing "another block's value survives a delete on the block that was offered it"
+              (is (= objective-value (value-uuid b15 objective)))
+              (is (= "Ship it" (:block/title (stored b15 (:db/ident objective)))))
+              (is (= "A plain block" (:block/title (d/entity @conn [:block/uuid other-block])))))
+            (testing "the insert tools name the property once"
+              (is (= 400 (:status insert)) (pr-str (:body insert)))
+              (is (= (str "blocks[0]: project: " (pr-str (str plain-a)) " should be a text block")
+                     (get-in insert [:body :error])))
+              (is (= 400 (:status insert-deadline)) (pr-str (:body insert-deadline)))
+              (is (= (str "blocks[0]: " deadline ": \"2026-11-10\" should be a datetime")
+                     (get-in insert-deadline [:body :error]))))))))))
+
+(deftest number-property-takes-a-number-test
+  ;; A number given to a number property is the number itself, stored in a number value block as
+  ;; the editor does, never read as a db id, whichever path writes it and whatever its value.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self blocks host-id points estimate]}]
+        (let [[b0 b1 b2 b3 b4 b5 b6 b7 b8 b9 b10 b11] blocks
+              put! (fn [block property value]
+                     (request! self "PUT" (str "/semantic/blocks/" block "/properties/"
+                                               (js/encodeURIComponent (ident-id property)))
+                               {:value value}))
+              number (fn [block property]
+                       (:logseq.property/value (get (d/entity @conn [:block/uuid block]) (:db/ident property))))]
+          (p/let [scores (outliner-property/upsert-property!
+                          conn nil {:logseq.property/type :number :db/cardinality :db.cardinality/many}
+                          {:property-name "scores"})
+                  batch (batch-set! self (set-entry b0 (ident-id points) 3))
+                  put (put! b1 estimate 5)
+                  decimal (batch-set! self (set-entry b2 (ident-id points) 2.5))
+                  text (put! b3 points "42")
+                  ;; A number equal to the db id of one of points' own value blocks is still a number.
+                  value-id (:db/id (get (d/entity @conn [:block/uuid b0]) (:db/ident points)))
+                  same-as-id (batch-set! self (set-entry b4 (ident-id points) value-id))
+                  many (batch-set! self (set-entry b5 (ident-id scores) [1 value-id]))
+                  insert (request! self "POST" (str "/semantic/blocks/" host-id "/children")
+                                   {:position "append"
+                                    :blocks [{:title "inserted" :properties {"points" 7}}]})
+                  inserted (some-> (get-in insert [:body :blocks 0 :uuid]) uuid)
+                  read (request! self "GET" (str "/semantic/blocks/" b0) nil)
+                  not-a-number (batch-set! self (set-entry b2 (ident-id points) "three"))
+                  ;; Numeric text that parses to a value JSON can't carry: stored, it would read back as null.
+                  non-finite (reduce (fn [acc [label block write]]
+                                       (p/let [done acc r (write block)] (conj done [label block r])))
+                                     (p/resolved [])
+                                     (for [[text batch-block put-block] [["NaN" b6 b7] ["Infinity" b8 b9]
+                                                                             ["-Infinity" b10 b11]]
+                                               [how block write] [["batch" batch-block
+                                                                   #(batch-set! self (set-entry % (ident-id points) text))]
+                                                                  ["PUT" put-block #(put! % points text)]]]
+                                       [(str how " " text) block write]))]
+            (doseq [[label r] [["batch" batch] ["single set" put] ["decimal" decimal] ["numeric text" text]
+                               ["a db id of an own value" same-as-id] ["list" many]]]
+              (is (= 200 (:status r)) (str label ": " (pr-str (:body r)))))
+            (is (= 201 (:status insert)) (pr-str (:body insert)))
+            (is (= 3 (number b0 points)))
+            (is (= 5 (number b1 estimate)))
+            (is (= 2.5 (number b2 points)))
+            (is (= 42 (number b3 points)))
+            (is (= value-id (number b4 points)) "the number is stored, not the value block it names")
+            (is (= #{1 value-id} (set (map :logseq.property/value
+                                           (get (d/entity @conn [:block/uuid b5]) (:db/ident scores))))))
+            (is (= 7 (some-> inserted (#(number % points)))))
+            (testing "the number reads back"
+              (is (= 200 (:status read)) (pr-str (:body read)))
+              (is (= 3 (some #(when (= (ident-id points) (:ident %)) (:value %))
+                             (get-in read [:body :properties])))
+                  (pr-str (:body read))))
+            (testing "control: text that isn't a number is still refused"
+              (is (= 400 (:status not-a-number)) (pr-str (:body not-a-number)))
+              (is (= 2.5 (number b2 points))))
+            (testing "text that isn't a finite number is refused, naming the entry and property, and nothing is stored"
+              (doseq [[label block r] non-finite]
+                (is (= 400 (:status r)) (str label ": " (pr-str (:body r))))
+                (is (re-find (if (string/starts-with? label "batch")
+                               #"^entry 0: points: .* should be a finite number"
+                               #"^points: .* should be a finite number")
+                             (str (get-in r [:body :error])))
+                    (str label ": " (pr-str (:body r))))
+                (is (nil? (get (d/entity @conn [:block/uuid block]) (:db/ident points)))
+                    (str label ": stored " (pr-str (number block points))))))))))))
