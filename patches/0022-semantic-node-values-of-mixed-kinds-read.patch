@@ -0,0 +1,453 @@
+(ns logseq.db-sync.semantic-node-value-read-test
+  "A node (many) property can hold entities of different kinds: plain and journal pages, which
+  have no :block/order, and blocks, property entities and pages under the Library or a namespace
+  parent, which do. Every read that renders properties (getBlock, getBlocks, getPage,
+  getPageOutline) must return such a value set, whichever kinds it mixes and however it was
+  written. A value a property doesn't take (a page UUID for a default-type property, any item of
+  a list a date property can't hold, text for a datetime or checkbox property, an entity that
+  isn't one of a text, URL or number property's own values) is refused up front, naming the entry
+  and the property, and the refused call writes nothing."
+  (:require [cljs.test :refer [async deftest is testing]]
+            [clojure.string :as string]
+            [datascript.core :as d]
+            [logseq.db-sync.test-sql :as test-sql]
+            [logseq.db-sync.worker.handler.sync :as sync-handler]
+            [logseq.db.sqlite.export :as sqlite-export]
+            [logseq.outliner.page :as outliner-page]
+            [logseq.outliner.property :as outliner-property]
+            [promesa.core :as p]))
+
+(defn- request!
+  "One semantic API request through the real handler; returns {:status :body}. A body that isn't
+  JSON is kept as text so a failure shows it."
+  [self method path body]
+  (p/let [url (str "http://localhost" path (if (string/includes? path "?") "&" "?") "graph-id=graph-1")
+          response (sync-handler/handle-http
+                    self
+                    (js/Request. url (clj->js (cond-> {:method method
+                                                       :headers {"content-type" "application/json"}}
+                                                body (assoc :body (js/JSON.stringify (clj->js body)))))))
+          text (.text response)]
+    {:status (.-status response)
+     :body (when (seq text)
+             (try (js->clj (js/JSON.parse text) :keywordize-keys true)
+                  (catch :default _ text)))}))
+
+(defn- ident-id [property] (subs (str (:db/ident property)) 1))
+
+(defn- set-entry [block property value]
+  {:block-id (str block) :property-id property :value value})
+
+(defn- batch-set! [self & entries]
+  (request! self "POST" "/semantic/block-properties/batch-set" {:entries (vec entries)}))
+
+(defn- with-graph
+  "A journal page holding meeting blocks, and candidate values of every kind:
+  - plain pages Workflow Intelligence and Other plain (no :block/order);
+  - Areas/Operational Intelligence, made by the outliner's namespace split, so Areas sits under
+    the Library and Operational Intelligence under Areas, both with a :block/order;
+  - a block on another page (has :block/order), and a block whose text is a URL;
+  - text, date, number, URL and checkbox properties to give them to."
+  [done run]
+  (-> (p/let [conn (sqlite-export/create-conn)
+              [_ journal-id] (outliner-page/create! conn "Nov 6th, 2026" {})
+              [_ host-id] (outliner-page/create! conn "Host page" {})
+              [_ notes-id] (outliner-page/create! conn "Notes page" {})
+              blocks (vec (repeatedly 20 random-uuid))
+              other-block (random-uuid)
+              link-block (random-uuid)
+              _ (d/transact! conn (concat
+                                   (map-indexed (fn [index id]
+                                                  {:block/uuid id :block/title (str "Meeting " index)
+                                                   :block/page [:block/uuid journal-id]
+                                                   :block/parent [:block/uuid journal-id]
+                                                   :block/order (str "a" index)
+                                                   :block/created-at 1 :block/updated-at 1})
+                                                blocks)
+                                   [{:block/uuid other-block :block/title "A plain block"
+                                     :block/page [:block/uuid notes-id]
+                                     :block/parent [:block/uuid notes-id]
+                                     :block/order "a0"
+                                     :block/created-at 1 :block/updated-at 1}
+                                    {:block/uuid link-block :block/title "https://example.com/pasted"
+                                     :block/page [:block/uuid notes-id]
+                                     :block/parent [:block/uuid notes-id]
+                                     :block/order "a1"
+                                     :block/created-at 1 :block/updated-at 1}]))
+              [_ plain-a] (outliner-page/create! conn "Workflow Intelligence" {})
+              [_ plain-b] (outliner-page/create! conn "Other plain" {})
+              [_ ns-child] (outliner-page/create! conn "Areas/Operational Intelligence" {:split-namespace? true})
+              about (outliner-property/upsert-property!
+                     conn nil {:logseq.property/type :node :db/cardinality :db.cardinality/many}
+                     {:property-name "about"})
+              topic (outliner-property/upsert-property!
+                     conn nil {:logseq.property/type :node :db/cardinality :db.cardinality/one}
+                     {:property-name "topic"})
+              objective (outliner-property/upsert-property!
+                         conn nil {:logseq.property/type :default :db/cardinality :db.cardinality/one}
+                         {:property-name "objective"})
+              project (outliner-property/upsert-property!
+                       conn nil {:logseq.property/type :default :db/cardinality :db.cardinality/one}
+                       {:property-name "project"})
+              due (outliner-property/upsert-property!
+                   conn nil {:logseq.property/type :date :db/cardinality :db.cardinality/one}
+                   {:property-name "due"})
+              points (outliner-property/upsert-property!
+                      conn nil {:logseq.property/type :number :db/cardinality :db.cardinality/one}
+                      {:property-name "points"})
+              dates (outliner-property/upsert-property!
+                     conn nil {:logseq.property/type :date :db/cardinality :db.cardinality/many}
+                     {:property-name "dates"})
+              estimate (outliner-property/upsert-property!
+                        conn nil {:logseq.property/type :number :db/cardinality :db.cardinality/one}
+                        {:property-name "estimate"})
+              link (outliner-property/upsert-property!
+                    conn nil {:logseq.property/type :url :db/cardinality :db.cardinality/one}
+                    {:property-name "link"})
+              done-property (outliner-property/upsert-property!
+                             conn nil {:logseq.property/type :checkbox :db/cardinality :db.cardinality/one}
+                             {:property-name "done"})
+              ns-child-entity (d/entity @conn [:block/uuid ns-child])
+              areas (:block/parent ns-child-entity)
+              self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true}]
+        (run {:conn conn :self self :journal-id journal-id :host-id host-id :blocks blocks
+              :other-block other-block :link-block link-block :plain-a plain-a :plain-b plain-b :ns-child ns-child
+              :areas (:block/uuid areas)
+              :about about :topic topic :objective objective :project project :due due :points points
+              :dates dates :estimate estimate :link link :done done-property}))
+      (p/catch #(is false (str %)))
+      (p/finally done)))
+
+(defn- value-uuids
+  "The UUIDs of the values `property` shows in a block or page response, in response order."
+  [response property]
+  (let [value (some #(when (= (ident-id property) (:ident %)) (:value %))
+                    (get-in response [:body :properties]))]
+    (mapv :uuid (if (map? value) [value] value))))
+
+(deftest mixed-order-node-values-read-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self journal-id host-id blocks other-block plain-a plain-b ns-child areas
+                   about]}]
+        (let [[b0 b1 b2 b3 b4 b5 b6 b7 b8] blocks
+              about-id (ident-id about)
+              get-block #(request! self "GET" (str "/semantic/blocks/" %) nil)
+              ordered? #(some? (:block/order (d/entity @conn [:block/uuid %])))]
+          (testing "preconditions: the outliner gives Library and namespace pages an order, and plain and journal pages none"
+            (is (ordered? ns-child))
+            (is (ordered? areas))
+            (is (ordered? other-block))
+            (is (not (ordered? plain-a)))
+            (is (not (ordered? plain-b)))
+            (is (some? (:block/journal-day (d/entity @conn [:block/uuid journal-id]))) "the host page is a journal")
+            (is (not (ordered? journal-id))))
+          (p/let [;; The report: a plain page, then a namespace page appended by UUID.
+                  append-1 (batch-set! self (set-entry b0 about-id (str plain-a)))
+                  append-2 (batch-set! self (set-entry b0 about-id (str ns-child)))
+                  ;; The same pair appended the other way round.
+                  _ (batch-set! self (set-entry b1 about-id (str ns-child)))
+                  _ (batch-set! self (set-entry b1 about-id (str plain-a)))
+                  ;; The same pair by title.
+                  by-title-1 (batch-set! self (set-entry b2 about-id "Workflow Intelligence"))
+                  by-title-2 (batch-set! self (set-entry b2 about-id "Operational Intelligence"))
+                  ;; A plain page and a Library page in one list value.
+                  _ (batch-set! self (set-entry b3 about-id [(str plain-b) (str areas)]))
+                  ;; A journal page and a block in one list value.
+                  _ (batch-set! self (set-entry b4 about-id [(str journal-id) (str other-block)]))
+                  ;; Controls that already read: values of one kind, and one value.
+                  _ (batch-set! self (set-entry b5 about-id [(str plain-a) (str plain-b)]))
+                  _ (batch-set! self (set-entry b6 about-id [(str ns-child) (str other-block)]))
+                  _ (batch-set! self (set-entry b7 about-id (str ns-child)))
+                  ;; Two blocks whose order keys sort the other way from their db ids.
+                  later-key (random-uuid)
+                  earlier-key (random-uuid)
+                  notes-page (:block/uuid (:block/page (d/entity @conn [:block/uuid other-block])))
+                  _ (d/transact! conn (for [[id order] [[later-key "a3"] [earlier-key "a2"]]]
+                                        {:block/uuid id :block/title (str "Ordered " order)
+                                         :block/page [:block/uuid notes-page]
+                                         :block/parent [:block/uuid notes-page]
+                                         :block/order order
+                                         :block/created-at 1 :block/updated-at 1}))
+                  _ (batch-set! self (set-entry b8 about-id [(str later-key) (str earlier-key)]))
+                  r8 (get-block b8)
+                  ;; A page holding the mixed pair, for getPage.
+                  _ (batch-set! self (set-entry host-id about-id [(str plain-a) (str ns-child)]))
+                  reads (p/all (map get-block [b0 b1 b2 b3 b4 b5 b6 b7]))
+                  bulk (request! self "GET" (str "/semantic/blocks?ids=" (string/join "," [b5 b0 b4])) nil)
+                  page (request! self "GET" (str "/semantic/pages/" host-id) nil)
+                  outline (request! self "GET" (str "/semantic/pages/" journal-id "/outline") nil)]
+            (is (= [200 200 200 200] (mapv :status [append-1 append-2 by-title-1 by-title-2]))
+                (pr-str (mapv :body [append-1 append-2 by-title-1 by-title-2])))
+            (let [[r0 r1 r2 r3 r4 r5 r6 r7] reads
+                  pair #{(str plain-a) (str ns-child)}]
+              (testing "controls: one kind of value, or one value"
+                (is (= [200 200 200] (mapv :status [r5 r6 r7])) (pr-str (mapv :body [r5 r6 r7])))
+                (is (= #{(str plain-a) (str plain-b)} (set (value-uuids r5 about))))
+                (is (= [(str ns-child)] (value-uuids r7 about))))
+              (testing "getBlock returns every value whichever kinds the set mixes"
+                (doseq [[label r expected] [["plain page then namespace page, appended by UUID" r0 pair]
+                                            ["namespace page then plain page, appended by UUID" r1 pair]
+                                            ["plain page then namespace page, by title" r2 pair]
+                                            ["plain page and Library page in one list" r3 #{(str plain-b) (str areas)}]
+                                            ["journal page and block in one list" r4 #{(str journal-id) (str other-block)}]]]
+                  (is (= 200 (:status r)) (str label ": " (pr-str (:body r))))
+                  (is (= expected (set (value-uuids r about))) label)))
+              (testing "the order of values doesn't depend on the order they were written"
+                (is (= (value-uuids r0 about) (value-uuids r1 about) (value-uuids r2 about))
+                    (pr-str (mapv #(value-uuids % about) [r0 r1 r2]))))
+              (testing "ordered values (blocks, Library and namespace pages) come first, then the rest by db id"
+                (is (= [(str ns-child) (str plain-a)] (value-uuids r0 about)))
+                (is (= [(str areas) (str plain-b)] (value-uuids r3 about)))
+                (is (= [(str other-block) (str journal-id)] (value-uuids r4 about))))
+              (testing "ordered values are listed by order key, not db id"
+                (is (< (:db/id (d/entity @conn [:block/uuid later-key]))
+                       (:db/id (d/entity @conn [:block/uuid earlier-key])))
+                    "precondition: the block with the later order key has the lower db id")
+                (is (= 200 (:status r8)) (pr-str (:body r8)))
+                (is (= [(str earlier-key) (str later-key)] (value-uuids r8 about)))))
+            (testing "getBlocks: one mixed block doesn't fail the bulk read"
+              (is (= 200 (:status bulk)) (pr-str (:body bulk))))
+            (testing "getPage on a page holding the mixed pair"
+              (is (= 200 (:status page)) (pr-str (:body page)))
+              (is (= #{(str plain-a) (str ns-child)} (set (value-uuids page about)))))
+            (testing "getPageOutline on the journal shows both values on the block's about line"
+              (is (= 200 (:status outline)) (pr-str (:body outline)))
+              (let [text (pr-str (:body outline))]
+                (is (re-find #"about:: [^\n\"]*\[\[Workflow Intelligence\]\]" text) text)
+                (is (re-find #"about:: [^\n\"]*\[\[Operational Intelligence\]\]" text) text)))))))))
