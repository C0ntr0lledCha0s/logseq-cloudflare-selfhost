+(defn- refused-by-type
+  "Why the property's type refuses an entity a value resolved to, as the outliner's own validator
+  would when writing it (a page for a text property, a non-journal page for a date one), or nil.
+  Found here, the call is refused up front, naming the property, not failed as a server error."
+  [db property values resolved]
+  (when (and (:logseq.property/type property) (not= :block/tags (:db/ident property)))
+    (some (fn [[value id]]
+            (when (number? id)
+              (when-let [errors (outliner-property/validate-property-value db property id)]
+                (str (or (:block/title property) (entity-ident property)) ": " (pr-str (str value)) " "
+                     (let [error (if (coll? errors) (first errors) errors)]
+                       (if (coll? error) (first error) error))))))
+          (map vector values resolved))))
+
