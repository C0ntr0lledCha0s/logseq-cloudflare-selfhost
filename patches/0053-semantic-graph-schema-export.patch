@@ -0,0 +1,381 @@
+(ns logseq.db-sync.semantic-graph-schema-test
+  "getGraphSchema (patch 0053): the graph's tags and properties in one call, for a drift review. Tags
+  carry extends, properties and object-count; properties carry type, cardinality, choices (each with
+  usage-count), value-count and used-by-tags. Private content and the Recycle bin are left out of every
+  item and every count; built-ins are hidden unless built-in=true; sections, limit and a one-section
+  cursor page through it, and every bad parameter is refused by name. E2EE graphs answer 409.
+
+  The graph is written through the real handler (tags, properties, pages, blocks, tags and values) and
+  transacted directly only for what the API can't store: a block or tag in the Recycle bin and Logseq's
+  empty placeholder as a value. Every fixture title holds zz, apart from the Private tag."
+  (:require [cljs.test :refer [async deftest is testing]]
+            [clojure.string :as string]
+            [datascript.core :as d]
+            [logseq.db-sync.semantic-uploaded-graph-schema-test :as uploaded]
+            [logseq.db-sync.test-sql :as test-sql]
+            [logseq.db-sync.worker.handler.semantic :as semantic]
+            [logseq.db-sync.worker.handler.sync :as sync-handler]
+            [logseq.db-sync.worker.routes.semantic :as semantic-routes]
+            [logseq.db.sqlite.export :as sqlite-export]
+            [promesa.core :as p]))
+
+(defn- request!
+  "One semantic API request through the real handler; returns {:status :body}."
+  [self method path body]
+  (p/let [url (str "http://localhost" path (if (string/includes? path "?") "&" "?") "graph-id=graph-1")
+          response (sync-handler/handle-http
+                    self
+                    (js/Request. url (clj->js (cond-> {:method method
+                                                       :headers {"content-type" "application/json"}}
+                                                (some? body) (assoc :body (js/JSON.stringify (clj->js body)))))))
+          text (.text response)]
+    {:status (.-status response)
+     :body (when (seq text)
+             (try (js->clj (js/JSON.parse text) :keywordize-keys true)
+                  (catch :default _ text)))}))
+
+(defn- ok! [response status]
+  (p/let [response response]
+    (assert (= status (:status response)) (pr-str response))
+    response))
+
+(defn- uuid-of [response] (uuid (get-in response [:body :uuid])))
+
+(defn- eid [conn id] (:db/id (d/entity @conn [:block/uuid id])))
+
+(defn- snapshot [conn] [(:max-tx @conn) (count (d/datoms @conn :eavt))])
+
+(defn- writer [self]
+  {:tag! (fn [title & [body]]
+           (p/let [r (ok! (request! self "POST" "/semantic/tags" (merge {:title title} body)) 201)] (uuid-of r)))
+   :property! (fn [title type & [body]]
+                (p/let [r (ok! (request! self "POST" "/semantic/properties" (merge {:title title :type type} body)) 201)]
+                  {:uuid (uuid-of r) :ident (get-in r [:body :ident]) :title title}))
+   :page! (fn [title] (p/let [r (ok! (request! self "POST" "/semantic/pages" {:title title}) 201)] (uuid-of r)))
+   :put! (fn [id property value]
+           (ok! (request! self "PUT" (str "/semantic/blocks/" id "/properties/" (js/encodeURIComponent property))
+                          {:value value})
+                200))
+   :insert! (fn [target titles]
+              (p/let [r (ok! (request! self "POST" "/semantic/block-trees"
+                                       {:target-id (str target) :blocks (mapv (fn [t] {:title t}) titles)})
+                             201)]
+                (mapv #(uuid (:uuid %)) (get-in r [:body :blocks]))))})
+
+(defn- seed-graph
+  "Tags Private, zz Book (zz author, zz colour), zz Novel extending zz Book (zz rating), zz Shelf (no
+  objects), zz Binned tag (in the Recycle bin); properties zz author, zz colour (choices Red, Green,
+  Blue), zz rating, zz only private, zz unused and zz binned property (in the bin). Blocks on zz Library:
+  two visible Books, a visible Novel, a Novel holding the empty placeholder, a Book tagged Private and a
+  Book in the bin; a block on the page zz Secret, which is tagged Private."
+  []
+  (p/let [conn (sqlite-export/create-conn)
+          self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true :env #js {}}
+          {:keys [tag! property! page! put! insert!]} (writer self)
+          private (tag! "Private")
+          author (property! "zz author" "default")
+          colour (property! "zz colour" "default" {:choices [{:title "Red"} {:title "Green"} {:title "Blue"}]})
+          rating (property! "zz rating" "number")
+          only-private (property! "zz only private" "default")
+          unused (property! "zz unused" "default")
+          binned-property (property! "zz binned property" "default")
+          shade (property! "zz shade" "default" {:choices [{:title "Red"}]})
+          book (tag! "zz Book" {:properties ["zz author" "zz colour"]})
+          novel (tag! "zz Novel" {:extends ["zz Book"] :properties ["zz rating"]})
+          shelf (tag! "zz Shelf")
+          binned-tag (tag! "zz Binned tag")
+          library (page! "zz Library")
+          secret (page! "zz Secret")
+          _ (put! secret "block/tags" ["Private"])
+          [secret-block] (insert! secret ["zz secret block"])
+          [b1 b2 n1 placeholder private-book binned-book odd]
+          (insert! library ["zz book one" "zz book two" "zz novel one" "zz novel placeholder" "zz private book"
+                            "zz binned book" "zz odd colour"])
+          _ (p/doseq [id [b1 b2 binned-book]] (put! id "block/tags" ["zz Book"]))
+          _ (p/doseq [id [n1 placeholder]] (put! id "block/tags" ["zz Novel"]))
+          _ (put! private-book "block/tags" ["zz Book" "Private"])
+          _ (put! b1 (:ident author) "zz Ann")
+          _ (put! b1 (:ident colour) "Red")
+          _ (put! b2 (:ident author) "zz Ben")
+          _ (put! b2 (:ident colour) "Red")
+          _ (put! n1 (:ident colour) "Green")
+          _ (put! n1 (:ident rating) 4)
+          _ (put! private-book (:ident author) "zz Pat")
+          _ (put! private-book (:ident colour) "Blue")
+          _ (put! private-book (:ident only-private) "zz hush")
+          _ (put! secret-block (:ident colour) "Blue")
+          _ (put! secret-block (:ident only-private) "zz hush")
+          _ (put! binned-book (:ident colour) "Green")
+          _ (put! binned-book (:ident author) "zz Bin")
+          placeholder-id (d/entid @conn :logseq.property/empty-placeholder)
+          shade-red (:e (first (d/datoms @conn :avet :block/closed-value-property (d/entid @conn (keyword (:ident shade))))))
+          ;; zz odd colour holds zz shade's Red as its zz colour: a value, but not zz colour's Red.
+          _ (d/transact! conn [[:db/add (eid conn odd) (keyword (:ident colour)) shade-red]
+                               [:db/add (eid conn placeholder) (keyword (:ident author)) placeholder-id]
+                               [:db/add (eid conn binned-book) :logseq.property/deleted-at 1]
+                               [:db/add (eid conn binned-tag) :logseq.property/deleted-at 1]
+                               [:db/add [:db/ident (keyword (:ident binned-property))] :logseq.property/deleted-at 1]])]
+    {:conn conn :self self
+     :properties {:author author :colour colour :rating rating :only-private only-private :unused unused
+                  :binned-property binned-property}
+     :tags {:private private :book book :novel novel :shelf shelf :binned-tag binned-tag}}))
+
+(defn- with-graph [done run]
+  (-> (p/let [graph (seed-graph)] (run graph))
+      (p/catch #(is false (str % "\n" (.-stack %))))
+      (p/finally done)))
+
+(defn- schema! [self q]
+  (request! self "GET" (str "/semantic/schema" (when (seq q) (str "?" q))) nil))
+
+(defn- by-title [section] (into {} (map (juxt :title identity)) (:items section)))
+
+(deftest schema-tags-test
+  ;; Each user tag with what it extends, its own properties and the objects tagged with it directly,
+  ;; Private objects and the Recycle bin left out. A tag in the bin is not listed.
+  (async done
+    (with-graph done
+      (fn [{:keys [self tags properties]}]
+        (p/let [response (schema! self "sections=tags")
+                section (get-in response [:body :tags])
+                items (by-title section)]
+          (is (= 200 (:status response)) (pr-str response))
+          (is (= #{:tags} (set (keys (:body response)))) "only the section asked for")
+          (is (= #{"Private" "zz Book" "zz Novel" "zz Shelf"} (set (keys items))))
+          (is (= 4 (:count section)))
+          (is (= {"Private" 0 "zz Book" 2 "zz Novel" 2 "zz Shelf" 0}
+                 (update-vals items :object-count))
+              "zz private book (Private) and zz binned book (bin) are not counted; the Private tag counts no visible object")
+          (is (= [{:uuid (str (:book tags)) :title "zz Book"}] (get-in items ["zz Novel" :extends])))
+          (is (= ["Root Tag"] (mapv :title (get-in items ["zz Book" :extends])))
+              "a tag given no parent extends Root Tag, as get_tag shows")
+          (is (= [(:ident (:author properties)) (:ident (:colour properties))]
+                 (mapv :ident (get-in items ["zz Book" :properties]))))
+          (is (= ["zz rating"] (mapv :title (get-in items ["zz Novel" :properties]))))
+          (is (= {:uuid (str (:novel tags)) :ident (get-in items ["zz Novel" :ident])}
+                 (select-keys (items "zz Novel") [:uuid :ident]))))))))
+
+(deftest schema-properties-test
+  ;; Each user property with its value-count (values on visible holders), each choice's usage-count
+  ;; (by the choice's id) and the tags that list it. Values held only by Private holders count 0.
+  (async done
+    (with-graph done
+      (fn [{:keys [self tags]}]
+        (p/let [response (schema! self "sections=properties")
+                section (get-in response [:body :properties])
+                items (by-title section)
+                colour (items "zz colour")]
+          (is (= 200 (:status response)) (pr-str response))
+          (is (= #{:properties} (set (keys (:body response)))))
+          (is (= #{"zz author" "zz colour" "zz rating" "zz only private" "zz unused" "zz shade"} (set (keys items)))
+              "zz binned property, in the Recycle bin, is not listed")
+          (is (= 6 (:count section)))
+          (is (= {"zz author" 2 "zz colour" 4 "zz rating" 1 "zz only private" 0 "zz unused" 0 "zz shade" 0}
+                 (update-vals items :value-count))
+              "Private holders, a binned holder and the empty placeholder are not values; zz shade's Red held as a zz colour value counts for zz colour")
+          (is (= {"Red" 2 "Green" 1 "Blue" 0}
+                 (into {} (map (juxt :title :usage-count)) (:choices colour)))
+              "Blue is held only by a Private block and a block on a Private page; zz shade's Red is not zz colour's Red")
+          (is (= [0] (mapv :usage-count (get-in items ["zz shade" :choices])))
+              "a choice is counted under its own property only")
+          (is (= ["Red" "Green" "Blue"] (mapv :title (:choices colour))) "choices keep the editor's order")
+          (is (every? :uuid (:choices colour)))
+          (is (= [{:uuid (str (:book tags)) :title "zz Book"}] (:used-by-tags colour)))
+          (is (= [{:uuid (str (:novel tags)) :title "zz Novel"}] (get-in items ["zz rating" :used-by-tags])))
+          (is (= [] (get-in items ["zz unused" :used-by-tags])))
+          (is (= ["default" "one"] ((juxt :type :cardinality) colour)))
+          (is (= "number" (get-in items ["zz rating" :type])))
+          (is (not (contains? (items "zz author") :choices)) "no choices key on a property without them"))))))
+
+(deftest schema-value-count-per-type-test
+  ;; value-count counts one value per holder for every property type, whatever stores it: a value block
+  ;; (default, url, number), a scalar (checkbox, datetime), a ref (node, date) or a choice; the empty
+  ;; placeholder is no value, whatever the type.
+  (async done
+    (-> (p/let [conn (sqlite-export/create-conn)
+                self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true :env #js {}}
+                {:keys [property! page! put! insert!]} (writer self)
+                journal (ok! (request! self "POST" "/semantic/block-trees/batch"
+                                       {:entries [{:page "2026-11-06" :blocks [{:title "zz j"}]}]})
+                             201)
+                _ journal
+                journal-id (d/q '[:find ?u . :where [?p :block/journal-day 20261106] [?p :block/uuid ?u]] @conn)
+                target (page! "zz Target")
+                page (page! "zz Values")
+                types [["zz t default" "default" "zz text"] ["zz t url" "url" "https://example.com"]
+                       ["zz t number" "number" 3] ["zz t checkbox" "checkbox" true]
+                       ["zz t datetime" "datetime" 1763251200000] ["zz t node" "node" (str target)]
+                       ["zz t date" "date" (str journal-id)] ["zz t choice" "default" "zz one"]]
+                props (p/all (map (fn [[title type]]
+                                    (property! title type (when (= title "zz t choice") {:choices [{:title "zz one"}]})))
+                                  types))
+                [holder empty-holder] (insert! page ["zz holder" "zz empty holder"])
+                _ (p/doseq [[prop [_ _ value]] (map vector props types)] (put! holder (:ident prop) value))
+                placeholder-id (d/entid @conn :logseq.property/empty-placeholder)
+                _ (d/transact! conn (mapv (fn [prop] [:db/add (eid conn empty-holder) (keyword (:ident prop)) placeholder-id])
+                                          props))
+                response (schema! self "sections=properties")
+                items (by-title (get-in response [:body :properties]))]
+          (is (= 200 (:status response)) (pr-str response))
+          (is (= (zipmap (map first types) (repeat 1))
+                 (update-vals (select-keys items (map first types)) :value-count))
+              "one value per type; the empty placeholder on the second holder is not counted"))
+        (p/catch #(is false (str % "\n" (.-stack %))))
+        (p/finally done))))
+
+(deftest schema-built-in-test
+  ;; Built-in tags and properties (Task, Status) are hidden by default and with built-in=false, and
+  ;; listed with built-in=true.
+  (async done
+    (with-graph done
+      (fn [{:keys [self]}]
+        (p/let [default (schema! self "")
+                off (schema! self "built-in=false")
+                on (schema! self "built-in=true&limit=200")
+                titles (fn [r section] (set (map :title (get-in r [:body section :items]))))]
+          (is (= 200 (:status default)) (pr-str default))
+          (is (= #{:tags :properties} (set (keys (:body default)))) "both sections by default")
+          (is (not (contains? (titles default :tags) "Task")))
+          (is (not (contains? (titles default :properties) "Status")))
+          (is (= (:body default) (:body off)) "built-in=false is the default")
+          (is (= 200 (:status on)) (pr-str on))
+          (is (contains? (titles on :tags) "Task"))
+          (is (contains? (titles on :properties) "Status"))
+          (is (> (get-in on [:body :tags :count]) (get-in default [:body :tags :count])))
+          (is (every? #(contains? (titles on :properties) %) (titles default :properties))
+              "built-in=true adds to the user items"))))))
+
+(deftest schema-paging-test
+  ;; limit pages one section through its cursor, with a complete count on every page; a cursor needs
+  ;; exactly one section (after de-duplication).
+  (async done
+    (with-graph done
+      (fn [{:keys [self]}]
+        (p/let [walk (fn walk [section q acc]
+                       (p/let [r (schema! self q)
+                               body (get-in r [:body (keyword section)])
+                               acc (conj acc [(:status r) (:count body) (mapv :title (:items body))])]
+                         (if-let [cursor (:next-cursor body)]
+                           (walk section (str "sections=" section "&limit=1&cursor=" (js/encodeURIComponent cursor)) acc)
+                           acc)))
+                pages (walk "tags" "sections=tags&limit=1" [])
+                first-page (schema! self "sections=tags&limit=1")
+                cursor (js/encodeURIComponent (get-in first-page [:body :tags :next-cursor]))
+                both (schema! self (str "limit=1&cursor=" cursor))
+                both-named (schema! self (str "sections=tags,properties&limit=1&cursor=" cursor))
+                deduped (schema! self (str "sections=tags,tags&limit=1&cursor=" cursor))
+                other-section (schema! self (str "sections=properties&limit=1&cursor=" cursor))
+                properties-pages (walk "properties" "sections=properties&limit=2" [])]
+          (is (= [[200 4 ["Private"]] [200 4 ["zz Book"]] [200 4 ["zz Novel"]] [200 4 ["zz Shelf"]]] pages)
+              "title order, one per page, count complete on each")
+          (is (= {:status 400 :body {:error "cursor needs exactly one section"}} both))
+          (is (= {:status 400 :body {:error "cursor needs exactly one section"}} both-named))
+          (is (= 200 (:status deduped)) "tags,tags is one section")
+          (is (= ["zz Book"] (mapv :title (get-in deduped [:body :tags :items]))))
+          (is (= 200 (:status other-section)) "a cursor is a title key, read in whichever one section is named")
+          (is (= ["zz author" "zz colour" "zz only private" "zz rating" "zz shade" "zz unused"]
+                 (mapcat last properties-pages)))
+          (is (every? #(= 6 (second %)) properties-pages)))))))
+
+(deftest schema-refusals-test
+  ;; Every bad parameter is refused by name and nothing is written; E2EE answers 409 before any
+  ;; parameter. The inputs these refusals sit next to still answer: a repeated section, both sections in
+  ;; either order, built-in given as true or false, and a limit over the maximum (capped).
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self]}]
+        (p/let [before (snapshot conn)
+                refusals [["sections=" "invalid sections"]
+                          ["sections=pages" "invalid sections"]
+                          ["sections=tags,pages" "invalid sections"]
+                          ["sections=,tags" "invalid sections"]
+                          ["sections=tags,,properties" "invalid sections"]
+                          ["sections=Tags" "invalid sections"]
+                          ["sections=%20tags" "invalid sections"]
+                          ["built-in=yes" "invalid built-in: give true or false"]
+                          ["built-in=" "invalid built-in: give true or false"]
+                          ["built-in=TRUE" "invalid built-in: give true or false"]
+                          ["built-in=1" "invalid built-in: give true or false"]
+                          ["limit=0" "invalid limit"]
+                          ["limit=x" "invalid limit"]
+                          ["sections=tags&cursor=nope" "invalid cursor"]
+                          ["cursor=nope" "invalid cursor"]]
+                refused (p/all (map (fn [[q _]] (schema! self q)) refusals))
+                e2ee (schema! self "sections=pages&graph-e2ee=true")
+                e2ee-valid (schema! self "graph-e2ee=true")
+                works (p/all (map #(schema! self %)
+                                  ["sections=tags,tags" "sections=properties,tags" "sections=tags,properties"
+                                   "built-in=true" "built-in=false" "limit=500" "sections=properties&limit=200"]))
+                after (snapshot conn)]
+          (doseq [[[q message] response] (map vector refusals refused)]
+            (is (= {:status 400 :body {:error message}} response) q))
+          (is (= {:status 409 :body {:error "graph insights are unavailable for E2EE graphs"}} e2ee)
+              "E2EE is refused before any parameter")
+          (is (= 409 (:status e2ee-valid)))
+          (is (every? #(= 200 (:status %)) works) (pr-str (map :status works)))
+          (is (= [#{:tags} #{:tags :properties} #{:tags :properties}]
+                 (map #(set (keys (:body %))) (take 3 works))))
+          (is (= 6 (count (get-in (nth works 5) [:body :properties :items]))) "limit over 200 is capped, not refused")
+          (is (= before after) "nothing was written"))))))
+
+(deftest schema-route-documented-test
+  (let [operation (get-in (semantic-routes/openapi-document "https://issuer.example")
+                          [:paths "/api/v1/graphs/{graph-id}/schema" :get])
+        param (fn [n] (first (filter #(= n (:name %)) (:parameters operation))))
+        description (:description operation)
+        route (first (filter #(= "getGraphSchema" (:operation-id %)) semantic-routes/operations))]
+    (is (= "getGraphSchema" (:operationId operation)))
+    (is (= {:method "GET" :handler :semantic/graph-schema :scope "logseq/read" :rate-class :read}
+           (select-keys route [:method :handler :scope :rate-class])))
+    (is (every? param ["sections" "built-in" "limit" "cursor"]))
+    (is (= {:type "boolean" :default false} (:schema (param "built-in"))))
+    (is (= @#'semantic/max-limit (get-in (param "limit") [:schema :maximum])))
+    (is (every? #(contains? (:responses operation) %) ["200" "400" "409"]))
+    (is (string/includes? (get-in operation [:responses "400" :description]) "sections, built-in, limit or cursor"))
+    (is (every? #(string/includes? description %)
+                ["object-count" "value-count" "usage-count" "used-by-tags" "Private" "Recycle bin"
+                 "built-in=true" "pass that section alone in sections" "Unavailable for E2EE graphs"
+                 (str "1 to " @#'semantic/max-limit)]))))
+
+(deftest schema-upload-path-test
+  ;; On a graph that arrived through the app's snapshot upload, with the class attributes and
+  ;; closed-value-property held at cardinality one in the open conn's schema (the app's schema drift):
+  ;; extends, properties, used-by-tags and each choice's usage-count are read from datoms.
+  (async done
+    (let [request! #'uploaded/request!
+          signed @#'uploaded/signed]
+      (-> (p/let [{:keys [self]} (#'uploaded/uploaded-graph)
+                  conn (#'uploaded/open! self)
+                  created (fn [r] (assert (= 201 (:status r)) (pr-str r)) r)
+                  ok (fn [r] (assert (= 200 (:status r)) (pr-str r)) r)
+                  colour (p/let [r (request! self "POST" "/semantic/properties"
+                                             {:title "zz colour" :type "default" :choices [{:title "Red"} {:title "Green"}]}
+                                             signed)]
+                           (get-in (created r) [:body :ident]))
+                  _ (p/let [r (request! self "POST" "/semantic/properties" {:title "zz author" :type "default"} signed)] (created r))
+                  _ (p/let [r (request! self "POST" "/semantic/tags" {:title "zz Base"} signed)] (created r))
+                  _ (p/let [r (request! self "POST" "/semantic/tags" {:title "zz Book" :properties ["zz author" "zz colour"]} signed)] (created r))
+                  _ (p/let [r (request! self "POST" "/semantic/tags" {:title "zz Novel" :extends ["zz Base" "zz Book"]
+                                                                       :properties ["zz colour"]} signed)] (created r))
+                  page (p/let [r (request! self "POST" "/semantic/pages" {:title "zz Library"} signed)] (uuid-of (created r)))
+                  [a b] (p/let [r (request! self "POST" "/semantic/block-trees"
+                                            {:target-id (str page) :blocks [{:title "zz a"} {:title "zz b"}]} signed)]
+                          (mapv #(uuid (:uuid %)) (get-in (created r) [:body :blocks])))
+                  _ (p/doseq [id [a b]]
+                      (p/let [r (request! self "PUT" (str "/semantic/blocks/" id "/properties/" (js/encodeURIComponent colour))
+                                          {:value "Red"} signed)] (ok r)))
+                  _ (d/reset-schema! conn (-> (d/schema @conn)
+                                              (assoc-in [:logseq.property.class/properties :db/cardinality] :db.cardinality/one)
+                                              (assoc-in [:logseq.property.class/extends :db/cardinality] :db.cardinality/one)
+                                              (assoc-in [:block/closed-value-property :db/cardinality] :db.cardinality/one)))
+                  response (request! self "GET" "/semantic/schema" nil signed)
+                  tags (by-title (get-in response [:body :tags]))
+                  props (by-title (get-in response [:body :properties]))]
+            (is (= 200 (:status response)) (pr-str response))
+            (is (= #{"zz Base" "zz Book"} (set (map :title (get-in tags ["zz Novel" :extends])))))
+            (is (= #{"zz author" "zz colour"} (set (map :title (get-in tags ["zz Book" :properties])))))
+            (is (= #{"zz Book" "zz Novel"} (set (map :title (get-in props ["zz colour" :used-by-tags])))))
+            (is (= {"Red" 2 "Green" 0} (into {} (map (juxt :title :usage-count)) (get-in props ["zz colour" :choices]))))
+            (is (= 2 (get-in props ["zz colour" :value-count]))))
+          (p/catch #(is false (str % "\n" (.-stack %))))
+          (p/finally done)))))
