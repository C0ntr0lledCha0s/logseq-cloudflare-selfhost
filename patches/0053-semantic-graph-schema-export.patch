+;; getGraphSchema lists the graph's tags and properties with their usage, for a drift review, in one
+;; call. Like the health checks it reads titles, so it refuses E2EE graphs, and it builds the private
+;; set once: no Private or Recycle-bin entity is an item, a counted object, a counted holder or a tag
+;; in used-by-tags. Class attributes are read from datoms, as an uploaded graph can hold them at
+;; cardinality one.
+
+(def ^:private schema-sections ["tags" "properties"])
+
+(defn- datom-entities
+  "The entities `e`'s `attr` datoms point to, in db id order."
+  [db e attr]
+  (map #(d/entity db %) (sort (map :v (d/datoms db :eavt e attr)))))
+
+(defn- schema-items
+  "The visible entities tagged with `class-ident` (tags or properties): none private or hidden, and
+  no built-in one unless `built-in?`."
+  [db class-ident private built-in?]
+  (->> (d/datoms db :avet :block/tags (d/entid db class-ident))
+       (map :e)
+       (remove #(contains? private %))
+       (map #(d/entity db %))
+       (remove entity-util/hidden?)
+       (filter #(or built-in? (not (:logseq.property/built-in? %))))))
+
+(defn- schema-tag-response [db private tag]
+  (let [id (:db/id tag)]
+    (assoc (tag-response tag)
+           :extends (mapv #(select-keys (class-response %) [:uuid :title])
+                          (datom-entities db id :logseq.property.class/extends))
+           :properties (mapv class-response (datom-entities db id :logseq.property.class/properties))
+           :object-count (count (remove #(contains? private (:e %)) (d/datoms db :avet :block/tags id))))))
+
+(defn- schema-property-response
+  "property-response plus value-count (values on visible holders, the empty placeholder not one),
+  each choice's usage-count (counted by the choice's id) and used-by-tags (the visible tags whose
+  class/properties datoms hold it)."
+  [db private property]
+  (let [placeholder (d/entid db :logseq.property/empty-placeholder)
+        values (when-let [ident (:db/ident property)]
+                 (->> (d/datoms db :aevt ident)
+                      (remove #(contains? private (:e %)))
+                      (remove #(= placeholder (:v %)))
+                      (map :v)))
+        usage (frequencies values)
+        response (property-response property)]
+    (cond-> (assoc response
+                   :value-count (count values)
+                   :used-by-tags (->> (d/datoms db :avet :logseq.property.class/properties (:db/id property))
+                                      (map :e)
+                                      (remove #(contains? private %))
+                                      (map #(d/entity db %))
+                                      (remove entity-util/hidden?)
+                                      (sort-by (partial title-key db))
+                                      (mapv #(select-keys (class-response %) [:uuid :title]))))
+      (:choices response)
+      (assoc :choices (mapv (fn [choice]
+                              (assoc (property-choice-detail-response choice)
+                                     :usage-count (get usage (:db/id choice) 0)))
+                            (property-choices property))))))
+
+(defn- handle-graph-schema [{:keys [^js url db e2ee?]}]
+  (let [params (.-searchParams url)
+        raw-sections (.get params "sections")
+        sections (if (some? raw-sections) (vec (distinct (string/split raw-sections #","))) schema-sections)
+        raw-built-in (.get params "built-in")
+        {:keys [limit raw-cursor cursor]} (pagination-options url)]
+    (cond
+      e2ee? (http/error-response "graph insights are unavailable for E2EE graphs" 409)
+      (not-every? (set schema-sections) sections) (http/bad-request "invalid sections")
+      (not (contains? #{nil "true" "false"} raw-built-in)) (http/bad-request "invalid built-in: give true or false")
+      (nil? limit) (http/bad-request "invalid limit")
+      (and raw-cursor (nil? cursor)) (http/bad-request "invalid cursor")
+      (and cursor (not= 1 (count sections))) (http/bad-request "cursor needs exactly one section")
+      :else
+      (let [private (datalog/private-ids db)
+            built-in? (= "true" raw-built-in)
+            section (fn [class-ident response-fn]
+                      (update (paginate-by (partial title-key db) (schema-items db class-ident private built-in?)
+                                           limit cursor)
+                              :items #(mapv (partial response-fn db private) %)))]
+        (http/json-response nil (cond-> {}
+                                  (some #{"tags"} sections)
+                                  (assoc :tags (section :logseq.class/Tag schema-tag-response))
+                                  (some #{"properties"} sections)
+                                  (assoc :properties (section :logseq.class/Property schema-property-response))))))))
+
