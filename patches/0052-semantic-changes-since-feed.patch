+      (-> (p/let [{:keys [self]} (#'uploaded/uploaded-graph)
+                  conn (#'uploaded/open! self)
+                  created (fn [r] (assert (= 201 (:status r)) (pr-str r)) r)
+                  page (p/let [r (request! self "POST" "/semantic/pages" {:title "zz Uploaded"} signed)] (uuid-of (created r)))
+                  [block] (p/let [r (request! self "POST" "/semantic/block-trees"
+                                              {:target-id (str page) :blocks [{:title "zz up"}]} signed)]
+                            (mapv #(uuid (:uuid %)) (get-in (created r) [:body :blocks])))
+                  _ (age! conn)
+                  _ (p/let [r (request! self "PATCH" (str "/semantic/blocks/" block) {:title "zz up edited"} signed)]
+                      (assert (= 200 (:status r)) (pr-str r)))
+                  response (request! self "GET" (str "/semantic/changes?since=" old) nil signed)]
+            (is (= 200 (:status response)) (pr-str response))
+            (is (= [block] (block-ids (group (:body response) page)))))
+          (p/catch #(is false (str % "\n" (.-stack %))))
+          (p/finally done)))))
