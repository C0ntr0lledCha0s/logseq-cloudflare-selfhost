+(defn- since-of [self zone since]
+  (set! (.-env self) (clj->js {"TIMEZONE" zone}))
+  (changes self (str "since=" (js/encodeURIComponent since) "&until=" far-until)))
+
+(def ^:private since-error "invalid since: give epoch ms, an ISO date (2026-11-16) or an ISO datetime")
+(def ^:private until-error "invalid until: give epoch ms, an ISO date (2026-11-16) or an ISO datetime")
+
+(deftest changes-since-forms-test
+  ;; Review focus 11. A date is local midnight in TIMEZONE; a datetime without an offset is local time.
+  (async done
+    (-> (p/let [{:keys [self]} (new-graph {"TIMEZONE" "UTC"})
+                cases [["Pacific/Auckland" "2026-09-27" (js/Date.UTC 2026 8 26 12) "NZ daylight saving starts that day; midnight is still +12"]
+                       ["Pacific/Auckland" "2026-09-28" (js/Date.UTC 2026 8 27 11) "the day after, +13"]
+                       ["Pacific/Auckland" "2026-04-05" (js/Date.UTC 2026 3 4 11) "NZ daylight saving ends that day; midnight is still +13"]
+                       ["Pacific/Auckland" "2026-04-06" (js/Date.UTC 2026 3 5 12) "the day after, +12"]
+                       ["Pacific/Auckland" "2026-11-16T09:00" (js/Date.UTC 2026 10 15 20) "local time, +13"]
+                       ["Pacific/Auckland" "2026-11-16T09:00:30.250" (js/Date.UTC 2026 10 15 20 0 30 250) "local, seconds and ms"]
+                       ["Pacific/Auckland" "2026-09-27T02:30" (js/Date.UTC 2026 8 26 14 30) "in the gap: the time after the change, 03:30 +13"]
+                       ["Pacific/Auckland" "2026-04-05T02:30" (js/Date.UTC 2026 3 4 13 30) "twice that night: the first, +13"]
+                       ["Pacific/Auckland" "2026-11-16T09:00:00Z" (js/Date.UTC 2026 10 16 9) "Z is that instant"]
+                       ["Pacific/Auckland" "2026-11-16T09:00+13:00" (js/Date.UTC 2026 10 15 20) "an offset is that instant"]
+                       ["Pacific/Auckland" "2026-11-16T09:00-05:30" (js/Date.UTC 2026 10 16 14 30) "a negative offset"]
+                       ["Pacific/Auckland" "1763251200000" 1763251200000 "epoch ms"]
+                       ["Pacific/Auckland" "0" 0 "zero"]
+                       ["UTC" "2026-09-27" (js/Date.UTC 2026 8 27) "UTC midnight"]
+                       ["UTC" "2026-11-16T09:00" (js/Date.UTC 2026 10 16 9) "UTC local time"]
+                       ["America/Los_Angeles" "2026-11-16" (js/Date.UTC 2026 10 16 8) "-08:00"]
+                       [" Pacific/Auckland " "2026-11-16" (js/Date.UTC 2026 10 15 11) "TIMEZONE is trimmed"]]
+                results (p/loop [xs cases acc []]
+                          (if (empty? xs)
+                            acc
+                            (p/let [[zone since] (first xs)
+                                    r (since-of self zone since)]
