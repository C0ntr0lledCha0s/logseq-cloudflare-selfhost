+(deftest changes-cap-test
+  ;; Review focus 14. The window is built from bare entities holding only a uuid and an updated-at,
+  ;; transacted at once so the fixture stays fast; the cap counts datoms in the window before any
+  ;; filter, so they count as changes (and, having no page, list nothing).
+  (async done
+    (let [index-range d/index-range
+          realised (volatile! 0)]
+      (-> (p/let [{:keys [conn self]} (new-graph {"TIMEZONE" "UTC"})
+                  cap @#'semantic/max-changes
+                  add! (fn [from n] (d/transact! conn (vec (for [i (range from (+ from n))]
+                                                             {:block/uuid (random-uuid) :block/updated-at (+ 5000 i)}))))
+                  _ (add! 0 cap)
+                  at-cap (changes self "since=4999&until=100000")
+                  _ (add! cap 1)
+                  over (changes self "since=4999&until=100000")
+                  _ (add! (inc cap) 49)
+                  before (snapshot conn)
+                  _ (set! d/index-range (fn [& args] (counting realised (apply index-range args))))
+                  far-over (changes self "since=4999&until=100000")
+                  _ (set! d/index-range index-range)
+                  narrowed (changes self "since=5000&until=100000")
+                  after (snapshot conn)]
+            (is (= 20000 cap))
+            (is (= 200 (:status at-cap)) (str "exactly " cap " changes answer: " (pr-str (:body at-cap))))
+            (is (= [] (get-in at-cap [:body :pages])))
+            (is (= {:status 422 :body {:error "too many changes in that window (more than 20,000); pass a later since or an until"}}
+                   over)
+                "20,001 changes")
+            (is (= 422 (:status far-over)))
+            (is (<= @realised (inc cap)) (str "realised " @realised " datoms; the take stops at the cap plus one"))
+            (is (= 422 (:status narrowed)) "a later since still holds more than the cap")
+            (is (= before after) "nothing written"))
+          (p/catch #(is false (str % "\n" (.-stack %))))
+          (p/finally (fn []
+                       (set! d/index-range index-range)
+                       (done)))))))
