+(defn- stamp-row
+  "What one write moved: the watched block's and page's updated-at, and whether the feed lists it."
+  [conn self [tool block page run]]
+  (p/let [_ (age! conn)
+          _ (run)
+          body (feed! self (since-old))
+          g (group body page)]
+    {:tool tool
+     :block-bumped (when block (> (stamp-of conn block) old))
+     :page-bumped (> (stamp-of conn page) old)
+     :listed (boolean (or (and block (some #{block} (block-ids g))) (:page-changed g)))}))
+
+(def ^:private expected-stamps
+  "The stamp table (the commit body repeats it). nil: the tool has no block to watch."
+  {"update_block" [true true true]
+   "update_page" [nil true true]
+   "set_block_property" [true false true]
+   "batch_set_block_property" [true false true]
+   "delete_block_property" [false true true]
+   "batch_delete_block_property" [false true true]
+   "move_blocks" [false true true]
+   "batch_move_blocks" [false true true]
+   "insert_block_children" [false true true]
+   "update_tag" [nil true true]
+   "update_property" [nil true true]
+   "promote_page_to_tag" [nil true true]
+   "refresh_refs" [true true true]
+   "set_page_favorite" [nil false false]
+   "tag via set_block_property" [true false true]})
+
+(deftest changes-write-tool-stamps-test
