+(defn- counting
+  "`xs` as an unchunked lazy seq that counts, in `n`, the elements realised."
+  [n xs]
+  (lazy-seq (when-let [s (seq xs)]
+              (vswap! n inc)
+              (cons (first s) (counting n (rest s))))))
