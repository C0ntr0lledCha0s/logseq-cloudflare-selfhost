+                         (p/let [row (stamp-row conn self (first cases))]
+                           (p/recur (rest cases) (conj acc row)))))
+                table (into {} (map (juxt :tool (juxt :block-bumped :page-bumped :listed))) rows)
+                blind (sort (keep (fn [[tool [block page]]] (when (and (not block) (not page)) tool)) table))
