+(defn- write-tool-cases
+  "One case per connector write tool that edits existing content: what to call, and which block (or
+  none) and page to watch."
+  [{:keys [ids note]} self extra]
+  (let [{:keys [a a1 a2 b b1]} ids
+        {:keys [promote tag-block refresh-block]} extra
+        call (fn [method path body status] (fn [] (ok! (request! self method path body) status)))]
+    [["update_block" a1 a (call "PATCH" (str "/semantic/blocks/" a1) {:title "zz a1 by update_block"} 200)]
+     ["update_page" nil a (call "PATCH" (str "/semantic/pages/" a) {:title "zz A by update_page"} 200)]
+     ["set_block_property" a1 a (call "PUT" (str "/semantic/blocks/" a1 "/properties/" (js/encodeURIComponent (:ident note)))
+                                      {:value "zz set"} 200)]
+     ["batch_set_block_property" a2 a (call "POST" "/semantic/block-properties/batch-set"
+                                            {:entries [{:block-id (str a2) :property-id (:ident note) :value "zz batch"}]} 200)]
+     ["delete_block_property" a1 a (call "DELETE" (str "/semantic/blocks/" a1 "/properties/" (js/encodeURIComponent (:ident note)))
+                                         nil 200)]
+     ["batch_delete_block_property" a2 a (call "POST" "/semantic/block-properties/batch-delete"
+                                               {:entries [{:block-id (str a2) :property-id (:ident note)}]} 200)]
+     ["move_blocks" a1 b (call "POST" "/semantic/block-moves" {:block-ids [(str a1)] :target-id (str b) :position "last-child"} 200)]
+     ["batch_move_blocks" a1 a (call "POST" "/semantic/block-moves/batch"
+                                     {:moves [{:block-ids [(str a1)] :target-id (str a) :position "last-child"}]} 200)]
+     ["insert_block_children" b1 b (call "POST" (str "/semantic/blocks/" b1 "/children")
+                                         {:position "append" :blocks [{:title "zz child"}]} 201)]
+     ["update_tag" nil (:book ids) (call "PATCH" (str "/semantic/tags/" (:book ids)) {:title "zz Book by update_tag"} 200)]
+     ["update_property" nil (:uuid note) (call "PATCH" (str "/semantic/properties/" (:uuid note)) {:title "zz note by update_property"} 200)]
+     ["promote_page_to_tag" nil promote (call "POST" (str "/semantic/pages/" promote "/promote-to-tag") {} 200)]
+     ["refresh_refs" refresh-block b (call "POST" "/semantic/refresh-refs" {:page-id (str b) :apply true} 200)]
+     ["set_page_favorite" nil b (call "PUT" (str "/semantic/pages/" b "/favorite") {:favorite true} 200)]
+     ["tag via set_block_property" tag-block b (call "PUT" (str "/semantic/blocks/" tag-block "/properties/block%2Ftags")
+                                                     {:value ["zz Book by update_tag"]} 200)]]))
