+  ;; neither are the blind spots listChangesSince's description names.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self ids] :as graph}]
+        (p/let [{:keys [page! insert! tag!]} (writer self)
+                promote (page! "zz To Promote")
+                [tag-block] (insert! (:b ids) [{:title "zz tag me"}])
+                _ (tag! "zzLater")
