+(ns logseq.db-sync.semantic-changes-since-test
+  "listChangesSince (patch 0052): GET /semantic/changes lists the pages changed in a window
+  (since, until], newest first, read from the :block/updated-at index. Each page carries
+  latest-updated-at, page-changed (its own stamp moved), complete created and updated counts and at
+  most blocks-per-page blocks; recycled counts what went to the Recycle bin in the window; the last
+  page answers next-cursor null. Private, hidden and built-in content is left out, and a property
+  value block is reported as its owner.
+
+  The graph is written through the real handler. Stamps are moved directly only to put the fixture's
+  own writes before the window (age!), to fix an order, or to build a window of 20,001 changes
+  quickly; the feed always reads them through the real route. Every fixture title holds zz."
+  (:require [cljs.test :refer [async deftest is testing]]
+            [clojure.string :as string]
+            [datascript.core :as d]
+            [logseq.db-sync.semantic-uploaded-graph-schema-test :as uploaded]
+            [logseq.db-sync.test-sql :as test-sql]
+            [logseq.db-sync.worker.handler.semantic :as semantic]
+            [logseq.db-sync.worker.handler.sync :as sync-handler]
+            [logseq.db-sync.worker.routes.semantic :as semantic-routes]
+            [logseq.db.sqlite.export :as sqlite-export]
+            [logseq.outliner.core :as outliner-core]
+            [logseq.outliner.recycle :as recycle]
+            [promesa.core :as p]))
+
+(defn- request!
+  "One semantic API request through the real handler; returns {:status :body}."
+  [self method path body]
+  (p/let [url (str "http://localhost" path (if (string/includes? path "?") "&" "?") "graph-id=graph-1")
+          response (sync-handler/handle-http
+                    self
+                    (js/Request. url (clj->js (cond-> {:method method
+                                                       :headers {"content-type" "application/json"}}
+                                                (some? body) (assoc :body (js/JSON.stringify (clj->js body)))))))
+          text (.text response)]
+    {:status (.-status response)
+     :body (when (seq text)
+             (try (js->clj (js/JSON.parse text) :keywordize-keys true)
+                  (catch :default _ text)))}))
+
+(defn- ok! [response status]
+  (p/let [response response]
+    (assert (= status (:status response)) (pr-str response))
+    response))
+
+(defn- uuid-of [response] (uuid (get-in response [:body :uuid])))
+
+(defn- eid [conn id] (:db/id (d/entity @conn [:block/uuid id])))
+
+(defn- writer [self]
+  {:tag! (fn [title & [body]]
+           (p/let [r (ok! (request! self "POST" "/semantic/tags" (merge {:title title} body)) 201)] (uuid-of r)))
+   :property! (fn [title type & [body]]
+                (p/let [r (ok! (request! self "POST" "/semantic/properties" (merge {:title title :type type} body)) 201)]
+                  {:uuid (uuid-of r) :ident (get-in r [:body :ident]) :title title}))
+   :page! (fn [title] (p/let [r (ok! (request! self "POST" "/semantic/pages" {:title title}) 201)] (uuid-of r)))
+   :put! (fn [id property value]
+           (ok! (request! self "PUT" (str "/semantic/blocks/" id "/properties/" (js/encodeURIComponent property))
+                          {:value value})
+                200))
+   :edit! (fn [id title] (ok! (request! self "PATCH" (str "/semantic/blocks/" id) {:title title}) 200))
+   :move! (fn [ids target position]
+            (ok! (request! self "POST" "/semantic/block-moves"
+                           {:block-ids (mapv str ids) :target-id (str target) :position position})
+                 200))
+   :insert! (fn [target blocks]
+              (p/let [r (ok! (request! self "POST" "/semantic/block-trees" {:target-id (str target) :blocks blocks}) 201)]
+                (mapv #(uuid (:uuid %)) (get-in r [:body :blocks]))))
+   :delete-block! (fn [id] (ok! (request! self "DELETE" (str "/semantic/blocks/" id "?acknowledge-references=true") nil) 200))
+   :delete-page! (fn [id] (ok! (request! self "DELETE" (str "/semantic/pages/" id "?acknowledge-references=true") nil) 200))})
+
+(def ^:private old
+  "The stamp age! gives every entity: the fixture's own writes happen before a window that starts here."
+  1000)
+
+(def ^:private far-until
+  "An until after every real write (2100-01-01), for calls that must not depend on the clock."
+  4102444800000)
+
+(defn- age!
+  "Moves every :block/created-at and :block/updated-at to `old`, so a window (old, now] holds only
+  what the test writes after this. Transacted directly: it is fixture setup, not a write under test."
+  [conn]
+  (d/transact! conn (vec (for [attr [:block/created-at :block/updated-at]
+                               datom (d/datoms @conn :aevt attr)]
+                           [:db/add (:e datom) attr old]))))
+
+(defn- stamp! [conn id attr value]
+  (d/transact! conn [[:db/add (eid conn id) attr value]]))
+
+(defn- stamp-of [conn id] (:block/updated-at (d/entity @conn [:block/uuid id])))
+
+(defn- snapshot [conn] [(:max-tx @conn) (count (d/datoms @conn :eavt))])
+
+(defn- new-graph [env]
+  (p/let [conn (sqlite-export/create-conn)]
+    {:conn conn :self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true :env (clj->js env)}}))
+
+(defn- seed-graph
+  "Pages zz A (blocks zz a1 to zz a3) and zz B (zz b1), a Private page zz Secret (zz s1), a tag
+  zz Book and a text property zz note."
+  []
+  (p/let [{:keys [conn self]} (new-graph {"TIMEZONE" "UTC"})
+          {:keys [tag! property! page! insert!]} (writer self)
+          _private (tag! "Private")
+          book (tag! "zz Book")
+          note (property! "zz note" "default")
+          a (page! "zz A")
+          b (page! "zz B")
+          secret (page! "zz Secret")
+          [a1 a2 a3] (insert! a [{:title "zz a1"} {:title "zz a2"} {:title "zz a3"}])
+          [b1] (insert! b [{:title "zz b1"}])
+          [s1] (insert! secret [{:title "zz s1"}])
+          _ ((:put! (writer self)) secret "block/tags" ["Private"])]
+    {:conn conn :self self
+     :ids {:a a :b b :secret secret :a1 a1 :a2 a2 :a3 a3 :b1 b1 :s1 s1 :book book}
+     :note note}))
+
+(defn- with-graph [done run]
+  (-> (p/let [graph (seed-graph)] (run graph))
+      (p/catch #(is false (str % "\n" (.-stack %))))
+      (p/finally done)))
+
+(defn- changes [self q] (request! self "GET" (str "/semantic/changes?" q) nil))
+
+(defn- feed!
+  "The 200 body of GET /semantic/changes?`q`."
+  [self q]
+  (p/let [r (ok! (changes self q) 200)] (:body r)))
+
+(defn- group [body page-id] (first (filter #(= (str page-id) (get-in % [:page :uuid])) (:pages body))))
+
+(defn- block-ids [g] (mapv #(uuid (:uuid %)) (:blocks g)))
+
+(defn- listed-ids [body] (set (mapcat block-ids (:pages body))))
+
+(defn- since-old [& [more]] (str "since=" old (or more "")))
+
+;; Before the fix (Stage 3 tree, patches 0001 to 0051) every call answered 404:
+;;   AssertionError: Assert failed: {:status 404, :body {:error "not found"}}
+(deftest changes-created-edited-old-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self ids]}]
+        (p/let [{:keys [a a1 a2 a3 b]} ids
+                {:keys [insert! edit!]} (writer self)
+                _ (age! conn)
+                _ (stamp! conn a3 :block/updated-at 500)
+                [fresh] (insert! a [{:title "zz fresh"}])
+                _ (edit! a1 (str "zz a1 edited [[" b "]]"))
+                body (feed! self (since-old))
+                g (group body a)
+                entries (into {} (map (juxt #(uuid (:uuid %)) identity)) (:blocks g))]
+          (is (= {:uuid (str a) :title "zz A" :kind "page"} (:page g)))
+          (is (= [1 1] [(:created g) (:updated g)]) "one created and one edited block")
+          (is (= "created" (:change (get entries fresh))))
+          (is (= "updated" (:change (get entries a1))))
+          (is (= "zz a1 edited [[zz B]]" (:snippet (get entries a1))) "the snippet shows a ref as its title")
+          (is (= #{:uuid :change :updated-at :snippet} (set (keys (get entries a1)))))
+          (is (not (contains? entries a2)) "a block untouched since the window began is not listed")
+          (is (not (contains? entries a3)) "nor is one edited before since")
+          (is (= (:latest-updated-at g)
+                 (apply max (cond-> (map :updated-at (:blocks g))
+                              (:page-changed g) (conj (stamp-of conn a)))))
+              "the newest stamp on the page or its blocks")
+          (is (= old (:since body)))
+          (is (number? (:until body)))
+          (is (= "UTC" (:time-zone body)))
+          (is (contains? body :next-cursor))
+          (is (nil? (:next-cursor body)) "one page of results: next-cursor is null")
+          (is (= 0 (:recycled body))))))))
+
+(deftest changes-property-set-test
+  ;; The spec's repro: a property set bumps the block's stamp but not its page's.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self ids]}]
+        (p/let [{:keys [a a1 a2]} ids
+                {:keys [put!]} (writer self)
+                _ (age! conn)
+                _ (put! a1 "block/tags" ["zz Book"])
+                _ (put! a2 "logseq.property/heading" 2)
+                body (feed! self (since-old))
+                g (group body a)]
+          (is (= #{a1 a2} (set (block-ids g))) "both blocks listed in their page's group")
+          (is (every? #(= "updated" (:change %)) (:blocks g)))
+          (is (false? (:page-changed g)) "the page's own stamp did not move")
+          (is (= [0 2] [(:created g) (:updated g)])))))))
+
+(deftest changes-value-block-test
+  ;; Review focus 13: a property value block is reported as its owner, once, though the owner
+  ;; changed too; a value block on a page is a change to the page.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self ids note]}]
+        (p/let [{:keys [a a1 a2 b]} ids
+                {:keys [put! edit!]} (writer self)
+                _ (put! a1 (:ident note) "zz first")
+                _ (put! a2 (:ident note) "zz second")
+                _ (put! b (:ident note) "zz on page")
+                value-of (fn [owner] (->> (d/datoms @conn :avet :block/parent (eid conn owner))
+                                          (map #(d/entity @conn (:e %)))
+                                          (filter :logseq.property/created-from-property)
+                                          first))
+                [v1 v2 vb] (map value-of [a1 a2 b])
+                _ (age! conn)
+                now (js/Date.now)
+                _ (d/transact! conn (vec (for [v [v1 v2 vb]]
+                                           [:db/add (:db/id v) :block/updated-at now])))
+                _ (edit! a1 "zz a1 again")
+                body (feed! self (since-old))
+                g (group body a)
+                value-ids (set (map :block/uuid [v1 v2 vb]))]
+          (is (some? v1))
+          (is (= #{a1 a2} (set (block-ids g))) "each owner once: a1 (value and title changed) and a2 (value only)")
+          (is (= 2 (count (:blocks g))) "not two entries for a1")
+          (is (= [0 2] [(:created g) (:updated g)]))
+          (is (not-any? value-ids (listed-ids body)) "no value block is listed")
+          (is (true? (:page-changed (group body b))) "a value block on page zz B is a change to the page")
+          (is (empty? (:blocks (group body b)))))))))
+
+(deftest changes-move-test
+  ;; Spec section 12 decision 3: a move shows as page-changed on both pages, with no block entry; a
+  ;; block edited and then moved is listed once, under its current page (review focus 12).
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self ids]}]
+        (p/let [{:keys [a a1 a2 b]} ids
+                {:keys [move! edit!]} (writer self)
+                _ (age! conn)
+                _ (move! [a1] b "last-child")
+                _ (edit! a2 "zz a2 edited")
+                _ (move! [a2] b "last-child")
+                body (feed! self (since-old))
+                ga (group body a)
+                gb (group body b)]
+          (is (true? (:page-changed ga)) "the source page")
+          (is (true? (:page-changed gb)) "the target page")
+          (is (not (contains? (listed-ids body) a1)) "the moved block's own stamp did not move")
+          (is (= [a2] (block-ids gb)) "the edited block is listed under its current page")
+          (is (empty? (:blocks ga)))
+          (is (= [0 0] [(:created ga) (:updated ga)])))))))
+
+(deftest changes-title-edit-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self ids]}]
+        (p/let [{:keys [a a1]} ids
+                _ (age! conn)
+                _ ((:edit! (writer self)) a1 "zz a1 retitled")
+                body (feed! self (since-old))
+                g (group body a)]
+          (is (= [a1] (block-ids g)) "the block")
+          (is (true? (:page-changed g)) "and its page: a title edit moves both stamps"))))))
+
+(defn- recycle-block!
+  "Moves a block to the Recycle bin as the app does (deleteBlock on the server deletes for good)."
+  [conn id & [now-ms]]
+  (d/transact! conn (vec (recycle/recycle-blocks-tx-data @conn [(d/entity @conn [:block/uuid id])]
+                                                         {:now-ms (or now-ms (js/Date.now))}))))
+
+(deftest changes-private-and-bin-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self ids]}]
+        (p/let [{:keys [secret s1 a a2 a3 b b1]} ids
+                {:keys [edit! insert! put! delete-block! delete-page! page!]} (writer self)
+                [private-block gone] (insert! a [{:title "zz private block"} {:title "zz gone for good"}])
+                _ (put! private-block "block/tags" ["Private"])
+                doomed (page! "zz Doomed")
+                [old-bin] (insert! a [{:title "zz binned long ago"}])
+                _ (recycle-block! conn old-bin 500)
+                _ (age! conn)
+                _ (edit! s1 "zz s1 edited")
+                _ (edit! a2 "zz a2 edited")
+                _ (recycle-block! conn a3)
+                _ (delete-page! doomed)
+                _ (recycle-block! conn private-block)
+                _ (delete-block! gone)
+                _ (edit! b1 "zz b1 edited")
+                body (feed! self (since-old))
+                pages (set (map #(get-in % [:page :uuid]) (:pages body)))]
+          (is (not (contains? pages (str secret))) "a Private page's edits are not listed")
+          (is (not (contains? (listed-ids body) s1)))
+          (is (not (contains? pages (str doomed))) "a page deletePage recycled is not listed")
+          (is (not (contains? (listed-ids body) a3)) "nor a block recycled as the app does")
+          (is (not (contains? (listed-ids body) private-block)))
+          (is (not (contains? (listed-ids body) gone)) "a block deleted for good leaves nothing to list")
+          (is (= #{(str a) (str b)} pages) "only the visible pages; not the Recycle bin page")
+          (is (= [a2] (block-ids (group body a))))
+          (is (= 2 (:recycled body))
+              (str "the block and the page recycled in the window; not the Private block, one binned before"
+                   " since, nor the block deleted for good")))))))
+
+(deftest changes-order-and-caps-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self ids]}]
+        (p/let [{:keys [a a1 a2 b b1]} ids
+                {:keys [insert! edit! page!]} (writer self)
+                [n1 n2 n3] (insert! a [{:title "zz n1"} {:title "zz n2"} {:title "zz n3"}])
+                _ (age! conn)
+                ;; Stamps set directly to fix the order: zz A's five changes at 2001 to 2005 (three
+                ;; created), zz B's one at 3000, so zz B comes first.
+                _ (d/transact! conn (vec (concat
+                                          (map-indexed (fn [i id] [:db/add (eid conn id) :block/updated-at (+ 2001 i)])
+                                                       [a1 a2 n1 n2 n3])
+                                          (map (fn [id] [:db/add (eid conn id) :block/created-at 2000]) [n1 n2 n3])
+                                          [[:db/add (eid conn b1) :block/updated-at 3000]])))
+                capped (feed! self (since-old "&until=10000&blocks-per-page=2"))
+                ga (group capped a)
+                first-page (feed! self (since-old "&until=10000&limit=1"))
+                cursor (:next-cursor first-page)
+                ;; Written after the pinned until: a new page with a block and an edit on zz A.
+                c (page! "zz C")
+                _ (insert! c [{:title "zz c1"}])
+                _ (edit! a1 "zz a1 after until")
+                second-page (feed! self (since-old (str "&limit=1&cursor=" (js/encodeURIComponent cursor))))]
+          (is (= [(str b) (str a)] (map #(get-in % [:page :uuid]) (:pages capped))) "newest first")
+          (is (= [n3 n2] (block-ids ga)) "blocks-per-page=2 keeps the two newest")
+          (is (= [3 2] [(:created ga) (:updated ga)]) "counts stay complete")
+          (is (= 2005 (:latest-updated-at ga)))
+          (is (= [(str b)] (map #(get-in % [:page :uuid]) (:pages first-page))))
+          (is (string? cursor))
+          (is (= 10000 (:until second-page)) "the cursor's until is used when until is left out")
+          (is (= [(str a)] (map #(get-in % [:page :uuid]) (:pages second-page)))
+              "page 2 is zz A, though zz C and an edit on zz A came after the pinned until")
+          (is (= [n3 n2 n1 a2] (block-ids (group second-page a)))
+              "zz a1's edit after until moved its stamp out of the window")
+          (is (nil? (:next-cursor second-page)) "the last page answers null")
+          (is (contains? second-page :next-cursor)))))))
