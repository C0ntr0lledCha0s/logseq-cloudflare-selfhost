+        (let [[b0 b1] blocks
+              rel-ident (subs (str relationship) 1)
+              ;; Another property's choice, however it is given, and things that are not choices.
+              refused-values ["nope" "one" "paused" (str project-active) "logseq.property/status.todo"
+                              (:db/id (d/entity @conn [:block/uuid project-active]))]]
+          (p/let [puts (p/all (map #(request! self "PUT" (property-path b0 relationship) {:value %})
+                                   refused-values))
+                  priority (request! self "PUT" (property-path b1 :logseq.property/priority)
+                                     {:value "logseq.property/status.todo"})
+                  batch-set (request! self "POST" "/semantic/block-properties/batch-set"
+                                      {:entries [{:block-id (str b0) :property-id rel-ident :value "prospect"}
+                                                 {:block-id (str b1) :property-id rel-ident :value "paused"}]})
+                  tree (request! self "POST" "/semantic/block-trees"
