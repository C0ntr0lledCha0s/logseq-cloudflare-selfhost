+(deftest url-value-held-by-several-blocks-test
+  ;; The editor gives each holder of a URL its own value block, so a URL can have several.
+  (async done
+    (with-choices done
+      (fn [{:keys [conn self page-id blocks]}]
+        (p/let [website (outliner-property/upsert-property!
+                         conn nil {:logseq.property/type :url :db/cardinality :db.cardinality/one}
+                         {:property-name "Website"})
+                website (:db/ident website)
+                website-ident (subs (str website) 1)
+                url "https://example.com/x"
+                [b0 b1 b2 b3] blocks
+                tree-child (random-uuid)
+                _ (outliner-property/set-block-property! conn [:block/uuid b0] website url)
+                _ (outliner-property/set-block-property! conn [:block/uuid b1] website url)
+                put (request! self "PUT" (property-path b2 website) {:value url})
+                batch-set (request! self "POST" "/semantic/block-properties/batch-set"
+                                    {:entries [{:block-id (str b3) :property-id website-ident :value url}]})
+                tree (request! self "POST" "/semantic/block-trees"
+                               {:target-id (str page-id)
+                                :blocks [{:uuid (str tree-child) :title "Tree child"
+                                          :properties {"Website" url}}]})]
+          (is (not= (stored-uuid conn b0 website) (stored-uuid conn b1 website))
+              "two holders, two value blocks")
+          (is (= [200 200 201] (mapv :status [put batch-set tree])) (pr-str (mapv :body [put batch-set tree])))
+          (doseq [id [b2 b3 tree-child]]
+            (is (= url (:block/title (get (d/entity @conn [:block/uuid id]) website)))
+                "the URL is stored on the third block")
+            (is (not (contains? #{(stored-uuid conn b0 website) (stored-uuid conn b1 website)}
+                                (stored-uuid conn id website)))
+                "and in its own value block, not an earlier holder's")))))))
+
+(defn- value-blocks
+  "The value entities `property` holds on block `id`, as a vector (one or several)."
+  [conn id property]
+  (let [value (get (d/entity @conn [:block/uuid id]) property)]
+    (vec (if (or (set? value) (sequential? value)) value (keep identity [value])))))
+
+(deftest url-value-belongs-to-its-block-test
+  ;; Each block that holds a URL gets its own value block, as the editor gives it, so deleting or
+  ;; editing another holder never changes it. Re-setting a block's own URL keeps its value block.
+  (async done
+    (with-choices done
+      (fn [{:keys [conn self page-id blocks]}]
+        (p/let [website (outliner-property/upsert-property!
+                         conn nil {:logseq.property/type :url :db/cardinality :db.cardinality/one}
+                         {:property-name "Website"})
+                website (:db/ident website)
+                website-ident (subs (str website) 1)
+                links (outliner-property/upsert-property!
+                       conn nil {:logseq.property/type :url :db/cardinality :db.cardinality/many}
+                       {:property-name "Links"})
+                links (:db/ident links)
+                url "https://shared.example.com/"
+                other-url "https://other.example.com/"
+                [a b-put b-batch b-many b-again] blocks
+                b-tree (random-uuid)
+                set-a (request! self "PUT" (property-path a website) {:value url})
+                set-a-many (request! self "PUT" (property-path a links) {:value [url]})
+                put (request! self "PUT" (property-path b-put website) {:value url})
+                batch-set (request! self "POST" "/semantic/block-properties/batch-set"
+                                    {:entries [{:block-id (str b-batch) :property-id website-ident :value url}]})
+                tree (request! self "POST" "/semantic/block-trees"
+                               {:target-id (str page-id)
+                                :blocks [{:uuid (str b-tree) :title "Tree child"
+                                          :properties {"Website" url}}]})
+                many (request! self "PUT" (property-path b-many links) {:value [url other-url]})
+                _ (request! self "PUT" (property-path b-again website) {:value url})
+                again-before (:db/id (first (value-blocks conn b-again website)))
+                again (request! self "PUT" (property-path b-again website) {:value url})
+                again-many-before (set (map :db/id (value-blocks conn b-many links)))
+                again-many (request! self "POST" "/semantic/block-properties/batch-set"
+                                     {:entries [{:block-id (str b-many) :property-id (subs (str links) 1)
+                                                 :value [url other-url]}]})
+                again-many-after (set (map :db/id (value-blocks conn b-many links)))
+                reset-many (request! self "PUT" (property-path b-many links) {:value [url other-url]})
+                reset-many-titles (mapv :block/title (value-blocks conn b-many links))
+                a-website (:db/id (first (value-blocks conn a website)))
+                a-links (set (map :db/id (value-blocks conn a links)))]
+          (is (= [200 200 200 200 201 200 200 200]
+                 (mapv :status [set-a set-a-many put batch-set tree many again again-many]))
+              (pr-str (mapv :body [set-a set-a-many put batch-set tree many again again-many])))
+          (doseq [id [b-put b-batch b-tree b-again]]
+            (let [value (first (value-blocks conn id website))]
+              (is (not= a-website (:db/id value)) (str "block " id " has its own value block, not A's"))
+              (is (= id (:block/uuid (:block/parent value))) (str "block " id "'s value block is under it"))))
+          (is (= again-before (:db/id (first (value-blocks conn b-again website))))
+              "re-setting a block's own URL keeps its value block")
+          (is (empty? (set/intersection a-links (set (map :db/id (value-blocks conn b-many links)))))
+              "a cardinality-many URL list gets its own value blocks")
+          (is (= again-many-before again-many-after)
+              "re-adding a block's own URLs keeps its value blocks")
+          (is (= 200 (:status reset-many)) (str (:body reset-many)))
+          (is (= #{url other-url} (set reset-many-titles))
+              "replacing a block's URLs with the same list reads back both")
+          (p/let [delete-a (request! self "DELETE" (str "/semantic/blocks/" a) nil)]
+            (is (contains? #{200 204} (:status delete-a)) (str (:body delete-a)))
+            (is (nil? (d/entity @conn [:block/uuid a])) "A is deleted")
+            (doseq [id [b-put b-batch b-tree b-again]]
+              (is (= url (:block/title (first (value-blocks conn id website))))
+                  (str "block " id " keeps its URL after A is deleted")))
+            (is (= #{url other-url} (set (map :block/title (value-blocks conn b-many links))))
+                "the cardinality-many block keeps both URLs after A is deleted")))))))
+
+(deftest node-property-title-ranking-test
+  ;; A node property's title lookup: objects of the property's tags only, then pages over blocks,
+  ;; user entities over built-ins, and never a recycled entity.
+  (async done
+    (with-choices done
+      (fn [{:keys [conn self page-id blocks]}]
+        (p/let [company (request! self "POST" "/semantic/tags" {:title "Company"})
+                company-id (:db/id (d/entity @conn [:block/uuid (uuid (get-in company [:body :uuid]))]))
+                [zeta-page zeta-block globex-x globex-plain initech-built-in initech-user gone
+                 acme-notes acme-object] (repeatedly 9 random-uuid)
+                page (fn [id title & {:as more}]
+                       (merge {:block/uuid id :block/name (string/lower-case title) :block/title title
+                               :block/tags #{:logseq.class/Page} :block/created-at 1 :block/updated-at 1}
+                              more))
+                block (fn [id title order & {:as more}]
+                        (merge {:block/uuid id :block/title title :block/page [:block/uuid page-id]
+                                :block/parent [:block/uuid page-id] :block/order order
+                                :block/created-at 1 :block/updated-at 1}
+                               more))
+                _ (d/transact! conn [(page zeta-page "Zeta")
+                                     (block zeta-block "Zeta" "b0")
+                                     (page globex-x "Globex" :block/tags #{:logseq.class/Page company-id})
+                                     (page globex-plain "Globex")
+                                     (page initech-built-in "Initech" :logseq.property/built-in? true)
+                                     (page initech-user "Initech")
+                                     (page gone "Gone page" :logseq.property/deleted-at 1)
+                                     (page acme-notes "Acme")
+                                     (block acme-object "Acme" "b1" :block/tags #{company-id})])
+                related (outliner-property/upsert-property!
+                         conn nil {:logseq.property/type :node :db/cardinality :db.cardinality/one}
+                         {:property-name "Related"})
+                company-ref (outliner-property/upsert-property!
+                             conn nil {:logseq.property/type :node :db/cardinality :db.cardinality/one}
+                             {:property-name "Company ref"})
+                _ (d/transact! conn [[:db/add (:db/id company-ref) :logseq.property/classes company-id]])
+                related (:db/ident related)
+                company-ref (:db/ident company-ref)
+                [b0 b1 b2 b3 b4 b5] blocks
+                page-over-block (request! self "PUT" (property-path b0 related) {:value "Zeta"})
+                class-match (request! self "PUT" (property-path b1 company-ref) {:value "Globex"})
+                class-before-page (request! self "PUT" (property-path b2 company-ref) {:value "Acme"})
+                no-class-match (request! self "PUT" (property-path b3 company-ref) {:value "Zeta"})
+                user-over-built-in (request! self "PUT" (property-path b4 related) {:value "Initech"})
+                recycled (request! self "PUT" (property-path b5 related) {:value "Gone page"})]
+          (is (= 200 (:status page-over-block)) (str (:body page-over-block)))
+          (is (= zeta-page (stored-uuid conn b0 related)) "a page wins over a block with its title")
+          (is (= 200 (:status class-match)) (str (:body class-match)))
+          (is (= globex-x (stored-uuid conn b1 company-ref)) "the page with the property's tag wins")
+          (is (= 200 (:status class-before-page)) (str (:body class-before-page)))
+          (is (= acme-object (stored-uuid conn b2 company-ref))
+              "a #Company block wins over an untagged page for a property limited to Company")
+          (is (= 400 (:status no-class-match)) (str (:body no-class-match)))
+          (is (string/includes? (str (get-in no-class-match [:body :error])) "#Company")
+              (str (:body no-class-match)))
+          (is (nil? (stored-uuid conn b3 company-ref)) "an object without the tag is never stored")
+          (is (= 200 (:status user-over-built-in)) (str (:body user-over-built-in)))
+          (is (= initech-user (stored-uuid conn b4 related)) "a user page wins over a built-in one")
+          (is (= 400 (:status recycled)) (str (:body recycled)))
+          (is (nil? (stored-uuid conn b5 related)) "a recycled page is never stored"))))))
+
+(deftest url-value-is-never-a-content-block-test
+  ;; A block whose text is a pasted link is content, not a URL value: a URL property set by title
+  ;; makes a value block for the block that holds it, on every write path.
+  (async done
+    (with-choices done
+      (fn [{:keys [conn self page-id blocks]}]
+        (p/let [website (outliner-property/upsert-property!
+                         conn nil {:logseq.property/type :url :db/cardinality :db.cardinality/one}
+                         {:property-name "Website"})
+                website (:db/ident website)
+                website-ident (subs (str website) 1)
+                [one-url two-url mix-url] ["https://one.example.com/" "https://two.example.com/"
+                                           "https://mix.example.com/"]
+                [c1 c2 c3 c4] (repeatedly 4 random-uuid)
+                _ (d/transact! conn (map-indexed
+                                     (fn [index [id title]]
+                                       {:block/uuid id :block/title title :block/page [:block/uuid page-id]
+                                        :block/parent [:block/uuid page-id] :block/order (str "a" (nth ["7" "8" "9" "A"] index))
+                                        :block/created-at 1 :block/updated-at 1})
+                                     [[c1 one-url] [c2 two-url] [c3 two-url] [c4 mix-url]]))
+                [b0 b1 b2 b3 b4] blocks
+                tree-child (random-uuid)
+                _ (outliner-property/set-block-property! conn [:block/uuid b0] website mix-url)
+                one (request! self "PUT" (property-path b1 website) {:value one-url})
+                two (request! self "PUT" (property-path b2 website) {:value two-url})
+                mix (request! self "PUT" (property-path b3 website) {:value mix-url})
+                batch-set (request! self "POST" "/semantic/block-properties/batch-set"
+                                    {:entries [{:block-id (str b4) :property-id website-ident :value two-url}]})
+                tree (request! self "POST" "/semantic/block-trees"
+                               {:target-id (str page-id)
+                                :blocks [{:uuid (str tree-child) :title "Tree child"
+                                          :properties {"Website" two-url}}]})]
+          (is (= [200 200 200 200 201] (mapv :status [one two mix batch-set tree]))
+              (pr-str (mapv :body [one two mix batch-set tree])))
+          (doseq [[id url] [[b1 one-url] [b2 two-url] [b3 mix-url] [b4 two-url] [tree-child two-url]]]
+            (let [value (get (d/entity @conn [:block/uuid id]) website)]
+              (is (= url (:block/title value)) "the URL is stored")
+              (is (= website (:db/ident (:logseq.property/created-from-property value)))
+                  (str "the value is a Website value block, not a content block: " (:block/uuid value)))))
+          (is (not= (stored-uuid conn b0 website) (stored-uuid conn b3 website))
+              "another block's value block with the same URL is not shared")
+          (is (= b3 (:block/uuid (:block/parent (get (d/entity @conn [:block/uuid b3]) website))))
+              "the value block belongs to the block that holds it"))))))
+
+(deftest batch-reset-scopes-by-what-the-tag-write-does-test
+  ;; With isResetExistingValues, a list of tags replaces the block's tags but a single tag adds to
+  ;; them, as set-prepared-property! writes; a later choice entry is checked against the result.
+  (async done
+    (with-bug-scoped-triage done
+      (fn [{:keys [conn self blocks relationship bug-id triage]}]
+        (let [rel-ident (subs (str relationship) 1)
+              [b0 b1 b2] blocks
+              tags-of (fn [id] (set (map :block/title (:block/tags (d/entity @conn [:block/uuid id])))))]
+          (p/let [_ (request! self "POST" "/semantic/tags" {:title "Feature"})
+                  _ (outliner-property/set-block-property! conn [:block/uuid b0] :block/tags bug-id)
+                  _ (outliner-property/set-block-property! conn [:block/uuid b1] :block/tags bug-id)
+                  batch (fn [entries] (request! self "POST" "/semantic/block-properties/batch-set"
+                                                {:isResetExistingValues true :entries entries}))
+                  single (batch [{:block-id (str b0) :property-id "block/tags" :value "Feature"}
+                                 {:block-id (str b0) :property-id rel-ident :value "triage"}])
+                  replaced (batch [{:block-id (str b1) :property-id "block/tags" :value ["Feature"]}
+                                   {:block-id (str b1) :property-id rel-ident :value "triage"}])
+                  replaced-with-bug (batch [{:block-id (str b2) :property-id "block/tags" :value ["Bug"]}
+                                            {:block-id (str b2) :property-id rel-ident :value "triage"}])]
+            (is (= 200 (:status single)) (str (:body single)))
+            (is (= #{"Bug" "Feature"} (tags-of b0)) "a single tag under reset keeps the block's tags")
+            (is (= triage (stored-uuid conn b0 relationship)))
+            (is (= 400 (:status replaced)) (str (:body replaced)))
+            (is (string/starts-with? (str (get-in replaced [:body :error])) "entry 1: ") (str (:body replaced)))
+            (is (nil? (stored-uuid conn b1 relationship)) "a refused batch writes nothing")
+            (is (= #{"Bug"} (tags-of b1)))
+            (is (= 200 (:status replaced-with-bug)) (str (:body replaced-with-bug)))
+            (is (= triage (stored-uuid conn b2 relationship)))))))))
