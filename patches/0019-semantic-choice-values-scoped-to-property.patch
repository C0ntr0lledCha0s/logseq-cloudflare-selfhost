+(deftest tag-scoped-choices-test
+  ;; A choice can be limited to tags (choice-classes), and a tag can exclude a global choice
+  ;; (choice-exclusions). The editor offers a block only the choices in its scope.
+  (async done
+    (with-choices done
+      (fn [{:keys [conn self page-id blocks relationship rel-prospect]}]
+        (p/let [bug (request! self "POST" "/semantic/tags" {:title "Bug"})
+                bug-id (:db/id (d/entity @conn [:block/uuid (uuid (get-in bug [:body :uuid]))]))
+                triage (random-uuid)
+                _ (outliner-property/upsert-closed-value! conn relationship
+                                                          {:id triage :value "triage" :scoped-class-id bug-id})
+                _ (d/transact! conn [[:db/add bug-id :logseq.property/choice-exclusions [:block/uuid rel-prospect]]])
+                stale (random-uuid)
+                _ (outliner-property/upsert-closed-value! conn relationship
+                                                          {:id stale :value "stale" :scoped-class-id bug-id})
+                [b0 b1 b2 b3 b4 b5] blocks
+                _ (d/transact! conn [;; A recycled choice is not reported as out of scope.
+                                     [:db/add [:block/uuid stale] :logseq.property/deleted-at 1]
+                                     [:db/add [:block/uuid b5] relationship [:block/uuid stale]]
+                                     [:db/add [:block/uuid b1] :block/tags bug-id]
+                                     [:db/add [:block/uuid b2] :block/tags bug-id]
+                                     [:db/add [:block/uuid b3] relationship [:block/uuid triage]]
+                                     [:db/add [:block/uuid b4] :block/tags bug-id]
+                                     [:db/add [:block/uuid b4] relationship [:block/uuid rel-prospect]]])
+                [tagged-child untagged-child] (repeatedly 2 random-uuid)
+                untagged (request! self "PUT" (property-path b0 relationship) {:value "triage"})
+                tagged (request! self "PUT" (property-path b1 relationship) {:value "triage"})
+                excluded (request! self "PUT" (property-path b2 relationship) {:value "prospect"})
+                tree (request! self "POST" "/semantic/block-trees"
+                               {:target-id (str page-id)
+                                :blocks [{:uuid (str tagged-child) :title "Fix login #Bug"
+                                          :properties {"Relationship status" "triage"}}]})
+                tree-refused (request! self "POST" "/semantic/block-trees"
+                                       {:target-id (str page-id)
+                                        :blocks [{:uuid (str untagged-child) :title "No tag"
+                                                  :properties {"Relationship status" "triage"}}]})
+                health (request! self "GET" "/semantic/health?checks=mismatched-choice-values" nil)]
+          (is (= 400 (:status untagged)) "a choice scoped to Bug is refused on an untagged block")
+          (let [error (str (get-in untagged [:body :error]))]
+            (is (and (string/includes? error "(active, prospect)") (not (string/includes? error "(active, prospect, triage)")))
+                (str "the error lists only the block's choices: " error)))
+          (is (nil? (stored-uuid conn b0 relationship)))
+          (is (= 200 (:status tagged)) (str (:body tagged)))
+          (is (= triage (stored-uuid conn b1 relationship)) "a Bug block takes the Bug-scoped choice")
+          (is (= 400 (:status excluded)) "a choice the block's tag excludes is refused")
+          (is (nil? (stored-uuid conn b2 relationship)))
+          (is (= 201 (:status tree)) (str (:body tree)))
+          (is (= triage (stored-uuid conn tagged-child relationship)) "an inline #Bug brings the scoped choice")
+          (is (= 400 (:status tree-refused)) (str (:body tree-refused)))
+          (is (nil? (d/entity @conn [:block/uuid untagged-child])))
+          (let [check (get-in health [:body :checks :mismatched-choice-values])]
+            (is (= #{[(str b3) "out-of-scope"] [(str b4) "out-of-scope"]}
+                   (set (map (juxt :uuid :reason) (:items check))))
+                (str "values outside the holder's choices are flagged: " check))))))))
