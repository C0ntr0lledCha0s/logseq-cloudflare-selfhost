+(deftest node-property-title-resolves-among-pages-test
+  ;; A node property has no choices, so a title is looked up in the graph. Built-in Priority's
+  ;; "High" and Project status's "active" are older than any user page with that title, and a text
+  ;; property's value block can share a title too; none of them is a page the caller can mean.
+  (async done
+    (with-choices done
+      (fn [{:keys [conn self page-id blocks]}]
+        (p/let [[high active twin-a twin-b tree-child batch-child] (repeatedly 6 random-uuid)
+                _ (d/transact! conn (for [[id title] [[high "High"] [active "active"] [twin-a "Twin"] [twin-b "Twin"]]]
+                                      {:block/uuid id :block/name (string/lower-case title) :block/title title
+                                       :block/tags :logseq.class/Page :block/created-at 1 :block/updated-at 1}))
+                related (outliner-property/upsert-property!
+                         conn nil {:logseq.property/type :node :db/cardinality :db.cardinality/one}
+                         {:property-name "Related"})
+                notes (outliner-property/upsert-property!
+                       conn nil {:logseq.property/type :default :db/cardinality :db.cardinality/one}
+                       {:property-name "Notes"})
+                related (:db/ident related)
+                related-ident (subs (str related) 1)
+                [b0 b1 b2 b3 b4 b5] blocks
+                notes-set (request! self "PUT" (property-path b5 (:db/ident notes)) {:value "Acme"})
+                put-high (request! self "PUT" (property-path b0 related) {:value "High"})
+                put-active (request! self "PUT" (property-path b1 related) {:value "active"})
+                batch-set (request! self "POST" "/semantic/block-properties/batch-set"
+                                    {:entries [{:block-id (str b2) :property-id related-ident :value "high"}]})
+                put-block (request! self "PUT" (property-path b3 related) {:value "Block 5"})
+                tree (request! self "POST" "/semantic/block-trees"
+                               {:target-id (str page-id)
+                                :blocks [{:uuid (str tree-child) :title "Tree child"
+                                          :properties {"Related" "High"}}]})
+                batch-tree (request! self "POST" "/semantic/block-trees/batch"
+                                     {:entries [{:target-id (str page-id)
+                                                 :blocks [{:uuid (str batch-child) :title "Batch child"
+                                                           :properties {related-ident "active"}}]}]})
+                refused-values ["Twin" "paused" "Acme"]
+                refused (p/all (map #(request! self "PUT" (property-path b4 related) {:value %})
+                                    refused-values))]
+          (is (= [200 200 200 200 200 201 201]
+                 (mapv :status [notes-set put-high put-active batch-set put-block tree batch-tree]))
+              (pr-str (mapv :body [notes-set put-high put-active batch-set put-block tree batch-tree])))
+          (is (= high (stored-uuid conn b0 related)) "\"High\" is the page, not Priority's High")
+          (is (= active (stored-uuid conn b1 related)) "\"active\" is the page, not Project status's choice")
+          (is (= high (stored-uuid conn b2 related)) "a title differing only by case finds the page")
+          (is (= (nth blocks 5) (stored-uuid conn b3 related)) "a block's title still resolves when no page has it")
+          (is (= high (stored-uuid conn tree-child related)) "insert_block_tree resolves to the page")
+          (is (= active (stored-uuid conn batch-child related)) "batch_insert_block_trees resolves to the page")
+          (doseq [[value response] (map vector refused-values refused)]
+            (is (= 400 (:status response)) (str "PUT " value " is refused: " (:body response))))
+          (let [error (str (get-in (first refused) [:body :error]))]
+            (is (and (string/includes? error (str twin-a)) (string/includes? error (str twin-b)))
+                (str "an ambiguous title lists its candidates: " error)))
+          (is (nil? (stored-uuid conn b4 related)) "a refused title writes nothing"))))))
+
