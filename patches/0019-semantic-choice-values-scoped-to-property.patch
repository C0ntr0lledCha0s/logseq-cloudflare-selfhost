+(defn- with-bug-scoped-triage
+  "with-choices plus a tag Bug and a Relationship status choice \"triage\" limited to Bug."
+  [done run]
+  (with-choices done
+    (fn [{:keys [conn self relationship] :as context}]
+      (p/let [bug (request! self "POST" "/semantic/tags" {:title "Bug"})
+              bug-id (:db/id (d/entity @conn [:block/uuid (uuid (get-in bug [:body :uuid]))]))
+              triage (random-uuid)
+              _ (outliner-property/upsert-closed-value! conn relationship
+                                                        {:id triage :value "triage" :scoped-class-id bug-id})]
+        (run (assoc context :bug-id bug-id :triage triage))))))
+
+(deftest tag-scope-comes-from-every-write-path-test
+  ;; Each write path builds the block's scope its own way; each is checked here.
+  (async done
+    (with-bug-scoped-triage done
+      (fn [{:keys [conn self page-id relationship bug-id triage]}]
+        (let [rel-ident (subs (str relationship) 1)
+              tagged-child (random-uuid)
+              status-bug (random-uuid)]
+          (p/let [;; A Tags property in the same properties object tags the new block.
+                  tree (request! self "POST" "/semantic/block-trees"
+                                 {:target-id (str page-id)
+                                  :blocks [{:uuid (str tagged-child) :title "Tagged by property"
+                                            :properties {"Tags" ["Bug"] "Relationship status" "triage"}}]})
+                  ;; A task is a Task: a Status choice limited to Bug is not one of its choices.
+                  _ (outliner-property/upsert-closed-value! conn :logseq.property/status
+                                                            {:id status-bug :value "Bug triage" :scoped-class-id bug-id})
+                  task (request! self "POST" "/semantic/tasks"
+                                 {:title "Scoped status task" :page-id (str page-id) :status "Bug triage"})
+                  ;; A batch insert entry's page properties are checked against the page's tags.
+                  entry (request! self "POST" "/semantic/block-trees/batch"
+                                  {:entries [{:page "Choices" :properties {rel-ident "triage"}}]})]
+            (is (= 201 (:status tree)) (str (:body tree)))
+            (is (= triage (stored-uuid conn tagged-child relationship))
+                "a block tagged Bug by its Tags property takes the Bug-scoped choice")
+            (is (= 400 (:status task)) (str (:body task)))
+            (is (not-any? #(= "Scoped status task" (:block/title %))
+                          (:block/_parent (d/entity @conn [:block/uuid page-id])))
+                "a refused task is not created")
+            (is (= 400 (:status entry)) (str (:body entry)))
+            (is (string/starts-with? (str (get-in entry [:body :error])) "entries[0]: ") (str (:body entry)))
+            (is (nil? (stored-uuid conn page-id relationship)) "a refused entry writes nothing")))))))
