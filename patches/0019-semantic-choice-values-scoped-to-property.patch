+(defn mismatched-choice-values
+  "Values of properties with choices (closed values) that are not one of the property's own
+  choices, such as another property's choice with the same title, as {:holder :property :value}
+  entity maps. Hidden holders are left out, and so is Logseq's empty placeholder, which the
+  outliner stores when a Status provided by a tag, or a property with a default, is removed."
+  [db]
+  (let [owners (fn [value-id] (set (map :v (d/datoms db :eavt value-id :block/closed-value-property))))
+        placeholder-id (d/entid db :logseq.property/empty-placeholder)]
+    (->> (d/datoms db :aevt :block/closed-value-property)
+         (map :v)
+         (distinct)
+         (mapcat (fn [property-id]
+                   (let [ident (attr-value db property-id :db/ident)]
+                     (when (and ident (= :db.type/ref (get-in (:schema db) [ident :db/valueType])))
+                       (->> (d/datoms db :aevt ident)
+                            (remove #(= placeholder-id (:v %)))
+                            (remove #(contains? (owners (:v %)) property-id))
+                            (remove #(hidden-id? db (:e %)))
+                            (map (fn [datom]
+                                   {:holder (d/entity db (:e datom))
+                                    :property (d/entity db property-id)
+                                    :value (d/entity db (:v datom))}))))))))))
