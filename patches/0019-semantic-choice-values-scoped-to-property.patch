+(deftest batch-sees-tags-earlier-entries-add-test
+  ;; Tagging a block and setting a choice its new tag allows, in one call, works as two calls do.
+  (async done
+    (with-bug-scoped-triage done
+      (fn [{:keys [conn self blocks relationship bug-id triage]}]
+        (let [rel-ident (subs (str relationship) 1)
+              [b0 b1] blocks]
+          (p/let [batch-set (request! self "POST" "/semantic/block-properties/batch-set"
+                                      {:entries [{:block-id (str b0) :property-id "block/tags" :value "Bug"}
+                                                 {:block-id (str b0) :property-id rel-ident :value "triage"}]})
+                  ;; The tag goes to b0 only: b1 is still refused.
+                  other-block (request! self "POST" "/semantic/block-properties/batch-set"
+                                        {:entries [{:block-id (str b0) :property-id "block/tags" :value "Bug"}
+                                                   {:block-id (str b1) :property-id rel-ident :value "triage"}]})
+                  batch-tree (request! self "POST" "/semantic/block-trees/batch"
+                                       {:entries [{:page "Fresh page" :properties {"Tags" ["Bug"]}}
+                                                  {:page "fresh page" :properties {rel-ident "triage"}}]})]
+            (is (= 200 (:status batch-set)) (str (:body batch-set)))
+            (is (= triage (stored-uuid conn b0 relationship)))
+            (is (contains? (set (map :db/id (:block/tags (d/entity @conn [:block/uuid b0])))) bug-id))
+            (is (= 400 (:status other-block)) (str (:body other-block)))
+            (is (string/starts-with? (str (get-in other-block [:body :error])) "entry 1: ") (str (:body other-block)))
+            (is (nil? (stored-uuid conn b1 relationship)))
+            (is (= 201 (:status batch-tree)) (str (:body batch-tree)))
+            (let [page (d/entity @conn [:block/uuid (uuid (get-in batch-tree [:body :entries 1 :target-id] "00000000-0000-0000-0000-000000000000"))])]
+              (is (= triage (:block/uuid (get page relationship)))
+                  "a later entry for the same page sees the tag an earlier entry adds"))))))))
