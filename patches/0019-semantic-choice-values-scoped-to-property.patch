+(deftest health-flags-choice-values-owned-by-another-property-test
+  (async done
+    (with-choices done
+      (fn [{:keys [conn self blocks project relationship project-active rel-active]}]
+        (let [[b0 b1] blocks
+              _ (d/transact! conn [[:db/add [:block/uuid b0] relationship [:block/uuid project-active]]
+                                   [:db/add [:block/uuid b1] relationship [:block/uuid rel-active]]])]
+          (p/let [health (request! self "GET" "/semantic/health?checks=mismatched-choice-values" nil)]
+            (is (= 200 (:status health)) (str (:body health)))
+            (let [check (get-in health [:body :checks :mismatched-choice-values])]
+              (is (= 1 (:count check)))
+              (is (= [{:uuid (str b0)
+                       :property (subs (str relationship) 1)
+                       :value "active"
+                       :value-uuid (str project-active)
+                       :value-property (subs (str project) 1)}]
+                     (mapv #(select-keys % [:uuid :property :value :value-uuid :value-property])
+                           (:items check)))
+                  "only the value whose choice belongs to Project status is flagged"))))))))
+
+(deftest health-skips-cleared-choice-values-test
+  (async done
+    (with-choices done
+      (fn [{:keys [conn self page-id]}]
+        (p/let [created (request! self "POST" "/semantic/tasks"
+                                  {:title "Cleared status" :page-id (str page-id)
+                                   :status "todo" :priority "high"})
+                task-id (get-in created [:body :uuid])
+                cleared (request! self "DELETE"
+                                  (property-path task-id :logseq.property/status) nil)
+                health (request! self "GET" "/semantic/health?checks=mismatched-choice-values" nil)]
+          (is (= 201 (:status created)) (str (:body created)))
+          (is (= 204 (:status cleared)) (str (:body cleared)))
+          (is (= :logseq.property/empty-placeholder
+                 (:db/ident (:logseq.property/status (d/entity @conn [:block/uuid (uuid task-id)]))))
+              "removing a provided Status stores Logseq's empty placeholder")
+          (is (= 200 (:status health)) (str (:body health)))
+          (is (= {:count 0 :items []}
+                 (select-keys (get-in health [:body :checks :mismatched-choice-values]) [:count :items]))
+              "a deliberately cleared choice is not a mismatched choice"))))))
