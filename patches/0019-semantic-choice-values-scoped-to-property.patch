+(defn- property-choices
+  "The property's own choices (closed values), in the order the editor lists them. With `scope`, a
+  block entity or a map of its :block/tags, only the choices the editor offers that block: a choice
+  limited to tags it lacks, one its tags exclude and a recycled one are left out."
+  ([property] (sort-by (juxt :block/order :db/id) (:block/_closed-value-property property)))
+  ([property scope]
+   (cond->> (property-choices property)
+     scope (db-property/scoped-closed-values property scope :values))))
+
+(defn- choice-content [choice]
+  (str (db-property/property-value-content choice)))
