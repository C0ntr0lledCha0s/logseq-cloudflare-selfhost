+(deftest value-outside-the-propertys-choices-is-refused-test
+  (async done
+    (with-choices done
+      (fn [{:keys [conn self page-id blocks relationship project-active]}]
+        (let [[b0 b1] blocks
+              rel-ident (subs (str relationship) 1)
+              refused-values ["nope" "one" "paused" (str project-active)]]
+          (p/let [puts (p/all (map #(request! self "PUT" (property-path b0 relationship) {:value %})
+                                   refused-values))
+                  batch-set (request! self "POST" "/semantic/block-properties/batch-set"
+                                      {:entries [{:block-id (str b0) :property-id rel-ident :value "prospect"}
+                                                 {:block-id (str b1) :property-id rel-ident :value "paused"}]})
+                  tree (request! self "POST" "/semantic/block-trees"
+                                 {:target-id (str page-id)
+                                  :blocks [{:title "Tree child" :properties {"Relationship status" "nope"}}]})
+                  batch-tree (request! self "POST" "/semantic/block-trees/batch"
+                                       {:entries [{:target-id (str page-id) :blocks [{:title "Fine"}]}
+                                                  {:target-id (str page-id)
+                                                   :blocks [{:title "Batch child"
+                                                             :properties {rel-ident "one"}}]}]})]
+            (doseq [[value response] (map vector refused-values puts)
+                    :let [error (str (get-in response [:body :error]))]]
+              (is (= 400 (:status response)) (str "PUT " value " is refused"))
+              (is (names-property? error relationship) (str "PUT " value ": " error))
+              (is (and (string/includes? error "active") (string/includes? error "prospect"))
+                  (str "PUT " value " lists the valid choices: " error)))
+            (is (= 400 (:status batch-set)))
+            (let [error (str (get-in batch-set [:body :error]))]
+              (is (string/starts-with? error "entry 1: ") error)
+              (is (names-property? error relationship) error)
+              (is (and (string/includes? error "active") (string/includes? error "prospect")) error))
+            (is (= 400 (:status tree)))
+            (let [error (str (get-in tree [:body :error]))]
+              (is (string/starts-with? error "blocks[0]: ") error)
+              (is (names-property? error relationship) error)
+              (is (and (string/includes? error "active") (string/includes? error "prospect")) error))
+            (is (= 400 (:status batch-tree)))
+            (let [error (str (get-in batch-tree [:body :error]))]
+              (is (string/starts-with? error "entries[1].blocks[0]: ") error)
+              (is (names-property? error relationship) error)
+              (is (and (string/includes? error "active") (string/includes? error "prospect")) error))
+            (is (nil? (stored-uuid conn b0 relationship)) "a refused value writes nothing")
+            (is (nil? (stored-uuid conn b1 relationship)) "a refused batch writes nothing")
+            (is (not-any? #(contains? #{"Tree child" "Batch child" "Fine"} (:block/title %))
+                          (:block/_parent (d/entity @conn [:block/uuid page-id])))
+                "refused trees insert nothing")))))))
