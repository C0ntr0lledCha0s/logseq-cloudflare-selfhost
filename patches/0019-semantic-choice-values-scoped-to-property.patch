+              (is (= 400 (:status response)) (str "PUT " value " is refused"))
+              (is (names-property? error relationship) (str "PUT " value ": " error))
+              (is (and (string/includes? error "active") (string/includes? error "prospect"))
+                  (str "PUT " value " lists the valid choices: " error)))
+            (is (= 400 (:status priority)) "another property's choice ident is refused for Priority")
+            (is (string/includes? (str (get-in priority [:body :error]))
+                                  "Priority's choices (Low, Medium, High, Urgent)")
+                (str (:body priority)))
+            (is (nil? (:logseq.property/priority (d/entity @conn [:block/uuid b1])))
+                "a refused ident writes nothing")
+            (is (= 400 (:status batch-set)))
+            (let [error (str (get-in batch-set [:body :error]))]
+              (is (string/starts-with? error "entry 1: ") error)
+              (is (names-property? error relationship) error)
+              (is (and (string/includes? error "active") (string/includes? error "prospect")) error))
+            (is (= 400 (:status tree)))
+            (let [error (str (get-in tree [:body :error]))]
+              (is (string/starts-with? error "blocks[0]: ") error)
+              (is (names-property? error relationship) error)
+              (is (and (string/includes? error "active") (string/includes? error "prospect")) error))
+            (is (= 400 (:status batch-tree)))
+            (let [error (str (get-in batch-tree [:body :error]))]
+              (is (string/starts-with? error "entries[1].blocks[0]: ") error)
+              (is (names-property? error relationship) error)
+              (is (and (string/includes? error "active") (string/includes? error "prospect")) error))
+            (is (nil? (stored-uuid conn b0 relationship)) "a refused value writes nothing")
