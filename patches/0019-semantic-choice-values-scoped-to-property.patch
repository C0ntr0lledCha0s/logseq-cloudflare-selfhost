@@ -0,0 +1,272 @@
+(ns logseq.db-sync.semantic-choice-values-test
+  "Values of a property with choices (closed values) resolve only among that property's own
+  choices. Two properties here share the choice title \"active\"; Project status's choice is
+  created first, so it is the older entity a graph-wide title lookup would find first."
+  (:require [cljs.test :refer [async deftest is]]
+            [clojure.string :as string]
+            [datascript.core :as d]
+            [logseq.db-sync.test-sql :as test-sql]
+            [logseq.db-sync.worker.handler.sync :as sync-handler]
+            [logseq.db.sqlite.export :as sqlite-export]
+            [logseq.outliner.property :as outliner-property]
+            [promesa.core :as p]))
+
+(defn- request!
+  "One semantic API request through the real handler; returns {:status :body}."
+  [self method path body]
+  (p/let [url (str "http://localhost" path (if (string/includes? path "?") "&" "?") "graph-id=graph-1")
+          response (sync-handler/handle-http
+                    self
+                    (js/Request. url (clj->js (cond-> {:method method
+                                                       :headers {"content-type" "application/json"}}
+                                                body (assoc :body (js/JSON.stringify (clj->js body)))))))
+          text (.text response)]
+    {:status (.-status response)
+     :body (when (seq text) (js->clj (js/JSON.parse text) :keywordize-keys true))}))
+
+(defn- with-choices
+  "A page `Choices` with blocks, a plain block titled \"one\", and two properties with choices:
+  Project status (active, paused) and then Relationship status (active, prospect)."
+  [done run]
+  (-> (p/let [conn (sqlite-export/create-conn)
+              page-id (random-uuid)
+              blocks (vec (repeatedly 6 random-uuid))
+              plain-id (random-uuid)
+              _ (d/transact! conn (concat
+                                   [{:block/uuid page-id :block/name "choices" :block/title "Choices"
+                                     :block/tags :logseq.class/Page
+                                     :block/created-at 1 :block/updated-at 1}
+                                    {:block/uuid plain-id :block/title "one" :block/page [:block/uuid page-id]
+                                     :block/parent [:block/uuid page-id] :block/order "a0"
+                                     :block/created-at 1 :block/updated-at 1}]
+                                   (map-indexed (fn [index id]
+                                                  {:block/uuid id :block/title (str "Block " index)
+                                                   :block/page [:block/uuid page-id]
+                                                   :block/parent [:block/uuid page-id]
+                                                   :block/order (str "a" (inc index))
+                                                   :block/created-at 1 :block/updated-at 1})
+                                                blocks)))
+              project (outliner-property/upsert-property!
+                       conn nil {:logseq.property/type :default :db/cardinality :db.cardinality/one}
+                       {:property-name "Project status"})
+              project-active (random-uuid)
+              project-paused (random-uuid)
+              _ (outliner-property/upsert-closed-value! conn (:db/ident project) {:id project-active :value "active"})
+              _ (outliner-property/upsert-closed-value! conn (:db/ident project) {:id project-paused :value "paused"})
+              relationship (outliner-property/upsert-property!
+                            conn nil {:logseq.property/type :default :db/cardinality :db.cardinality/one}
+                            {:property-name "Relationship status"})
+              rel-active (random-uuid)
+              rel-prospect (random-uuid)
+              _ (outliner-property/upsert-closed-value! conn (:db/ident relationship) {:id rel-active :value "active"})
+              _ (outliner-property/upsert-closed-value! conn (:db/ident relationship) {:id rel-prospect :value "prospect"})
+              self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true}]
+        (run {:conn conn :self self :page-id page-id :blocks blocks :plain-id plain-id
+              :project (:db/ident project) :relationship (:db/ident relationship)
+              :project-active project-active :project-paused project-paused
+              :rel-active rel-active :rel-prospect rel-prospect}))
+      (p/catch #(is false (str %)))
+      (p/finally done)))
+
+(defn- stored-uuid
+  "The :block/uuid of the value `property` holds on block `id`, or nil."
+  [conn id property]
+  (let [value (get (d/entity @conn [:block/uuid id]) property)
+        value (if (set? value) (first value) value)]
+    (:block/uuid value)))
+
+(defn- property-path [block-id property]
+  (str "/semantic/blocks/" block-id "/properties/"
+       (js/encodeURIComponent (subs (str property) 1))))
+
+(defn- names-property? [error property]
+  (or (string/includes? error "Relationship status")
+      (string/includes? error (subs (str property) 1))))
+
+(deftest choice-title-resolves-among-the-propertys-own-choices-test
+  (async done
+    (with-choices done
+      (fn [{:keys [conn self page-id blocks relationship rel-active rel-prospect]}]
+        (let [[b0 b1 b2 b3] blocks
+              tree-child (random-uuid)
+              batch-child (random-uuid)
+              rel-ident (subs (str relationship) 1)]
+          (p/let [put (request! self "PUT" (property-path b0 relationship) {:value "active"})
+                  put-case (request! self "PUT" (property-path b1 relationship) {:value "Active"})
+                  put-only-one (request! self "PUT" (property-path b2 relationship) {:value "prospect"})
+                  batch-set (request! self "POST" "/semantic/block-properties/batch-set"
+                                      {:entries [{:block-id (str b3) :property-id rel-ident :value "active"}]})
+                  tree (request! self "POST" "/semantic/block-trees"
+                                 {:target-id (str page-id)
+                                  :blocks [{:uuid (str tree-child) :title "Tree child"
+                                            :properties {"Relationship status" "active"}}]})
+                  batch-tree (request! self "POST" "/semantic/block-trees/batch"
+                                       {:entries [{:target-id (str page-id)
+                                                   :blocks [{:uuid (str batch-child) :title "Batch child"
+                                                             :properties {rel-ident "active"}}]}]})]
+            (is (= [200 200 200 200 201 201]
+                   (mapv :status [put put-case put-only-one batch-set tree batch-tree])))
+            (is (= rel-active (stored-uuid conn b0 relationship))
+                "set_block_property stores Relationship status's own \"active\"")
+            (is (= rel-active (stored-uuid conn b1 relationship))
+                "a title differing only by case resolves to the same choice")
+            (is (= rel-prospect (stored-uuid conn b2 relationship)))
+            (is (= rel-active (stored-uuid conn b3 relationship))
+                "batch_set_block_property stores Relationship status's own \"active\"")
+            (is (= rel-active (stored-uuid conn tree-child relationship))
+                "insert_block_tree stores Relationship status's own \"active\"")
+            (is (= rel-active (stored-uuid conn batch-child relationship))
+                "batch_insert_block_trees stores Relationship status's own \"active\"")))))))
