+(deftest number-and-url-choices-resolve-by-content-test
+  (async done
+    (with-choices done
+      (fn [{:keys [conn self blocks project-active]}]
+        (p/let [score (outliner-property/upsert-property!
+                       conn nil {:logseq.property/type :number :db/cardinality :db.cardinality/one}
+                       {:property-name "Score"})
+                link (outliner-property/upsert-property!
+                      conn nil {:logseq.property/type :url :db/cardinality :db.cardinality/one}
+                      {:property-name "Link"})
+                [one two three link-a] (repeatedly 4 random-uuid)
+                _ (outliner-property/upsert-closed-value! conn (:db/ident score) {:id one :value 1})
+                _ (outliner-property/upsert-closed-value! conn (:db/ident score) {:id two :value 2})
+                _ (outliner-property/upsert-closed-value! conn (:db/ident score) {:id three :value 3})
+                _ (outliner-property/upsert-closed-value! conn (:db/ident link)
+                                                          {:id link-a :value "https://a.example.com"})
+                score (:db/ident score)
+                link (:db/ident link)
+                score-ident (subs (str score) 1)
+                [b0 b1 b2 b3 b4 b5] blocks
+                one-id (:db/id (d/entity @conn [:block/uuid one]))
+                by-number (request! self "PUT" (property-path b0 score) {:value 2})
+                by-string (request! self "PUT" (property-path b1 score) {:value "3"})
+                by-uuid (request! self "PUT" (property-path b2 score) {:value (str one)})
+                batch-set (request! self "POST" "/semantic/block-properties/batch-set"
+                                    {:entries [{:block-id (str b3) :property-id score-ident :value 3}]})
+                by-url (request! self "PUT" (property-path b4 link) {:value "https://a.example.com"})
+                refused-values [7 2.5 one-id (:db/id (d/entity @conn [:block/uuid project-active]))]
+                refused (p/all (map #(request! self "PUT" (property-path b5 score) {:value %})
+                                    refused-values))
+                url-refused (request! self "PUT" (property-path b5 link) {:value "https://b.example.com"})]
+          (is (= [200 200 200 200 200]
+                 (mapv :status [by-number by-string by-uuid batch-set by-url]))
+              (pr-str (mapv :body [by-number by-string by-uuid batch-set by-url])))
+          (is (= two (stored-uuid conn b0 score)) "a JSON number matches the choice with that value")
+          (is (= three (stored-uuid conn b1 score)) "a numeric string matches the choice with that value")
+          (is (= one (stored-uuid conn b2 score)) "a choice UUID still works")
+          (is (= three (stored-uuid conn b3 score)) "batch_set_block_property matches a JSON number")
+          (is (= link-a (stored-uuid conn b4 link)) "a URL choice matches by its URL")
+          (doseq [[value response] (map vector refused-values refused)
+                  :let [error (str (get-in response [:body :error]))]]
+            (is (= 400 (:status response)) (str "PUT " value " is refused"))
+            (is (string/includes? error "Score's choices (1, 2, 3)") error)
+            (is (string/ends-with? error (str "got " value)) error))
+          (is (= 400 (:status url-refused)))
+          (is (string/includes? (str (get-in url-refused [:body :error])) "https://a.example.com")
+              (str (:body url-refused)))
+          (is (nil? (stored-uuid conn b5 score)) "a refused number writes nothing")
+          (is (nil? (stored-uuid conn b5 link)) "a refused URL writes nothing"))))))
+
+(deftest task-status-title-shared-with-another-property-test
+  (async done
+    (with-choices done
+      (fn [{:keys [conn self page-id project]}]
+        (let [project-blocked (random-uuid)
+              status-blocked (random-uuid)
+              _ (outliner-property/upsert-closed-value! conn project {:id project-blocked :value "Blocked"})
+              _ (outliner-property/upsert-closed-value! conn :logseq.property/status
+                                                        {:id status-blocked :value "Blocked"})]
+          (p/let [created (request! self "POST" "/semantic/tasks"
+                                    {:title "Waiting on legal" :page-id (str page-id) :status "Blocked"})]
+            (is (= 201 (:status created)) (str (:body created)))
+            (is (= (str status-blocked) (get-in created [:body :status :uuid]))
+                "the task's own status choice is found, not Project status's")))))))
