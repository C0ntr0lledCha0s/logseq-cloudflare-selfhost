+(defn mismatched-choice-values
+  "Values that are not one of their property's own choices (closed values), as
+  {:holder :property :value :reason} entity maps. :reason is \"another-propertys-choice\" for
+  another property's choice, on a property with choices or on a user property without them (a
+  node property set by a choice's title); \"not-a-choice\" for a property with choices holding
+  something else; and \"out-of-scope\" for the property's own choice that the editor would not
+  offer the holder, because the choice is limited to tags the holder lacks or one of its tags
+  excludes it. Hidden holders are left out, and so is Logseq's empty placeholder, which the
+  outliner stores when a Status provided by a tag, or a property with a default, is removed."
+  [db]
+  (let [owners (reduce (fn [result datom] (update result (:e datom) (fnil conj #{}) (:v datom)))
+                       {} (d/datoms db :aevt :block/closed-value-property))
+        closed-property-ids (set (mapcat val owners))
+        ;; Only these choices can be out of a holder's scope, so only they need entity reads.
+        scoped-ids (into (set (map :e (d/datoms db :aevt :logseq.property/choice-classes)))
+                         (map :v (d/datoms db :aevt :logseq.property/choice-exclusions)))
+        placeholder-id (d/entid db :logseq.property/empty-placeholder)
+        ref-ident (fn [property-id]
+                    (let [ident (attr-value db property-id :db/ident)]
+                      (when (and ident (= :db.type/ref (get-in (:schema db) [ident :db/valueType])))
+                        ident)))
+        user-property-ids (->> (d/datoms db :avet :block/tags (d/entid db :logseq.class/Property))
+                               (map :e)
+                               (remove closed-property-ids)
+                               (remove #(attr-value db % :logseq.property/built-in?)))
+        reason (fn [property-id holder-id value-id]
+                 (let [value-owners (get owners value-id)]
+                   (cond
+                     (not (contains? closed-property-ids property-id))
+                     (when (seq value-owners) "another-propertys-choice")
+                     (= placeholder-id value-id) nil
+                     (empty? value-owners) "not-a-choice"
+                     (not (contains? value-owners property-id)) "another-propertys-choice"
+                     (and (contains? scoped-ids value-id)
+                          (let [value (d/entity db value-id)]
+                            (and (not (entity-util/recycled? value))
+                                 (empty? (db-property/scoped-closed-values
+                                          (d/entity db property-id) (d/entity db holder-id)
+                                          :values [value])))))
+                     "out-of-scope")))]
+    (->> (concat closed-property-ids user-property-ids)
+         (mapcat (fn [property-id]
+                   (when-let [ident (ref-ident property-id)]
+                     (->> (d/datoms db :aevt ident)
+                          (keep (fn [datom]
+                                  (when-let [reason (reason property-id (:e datom) (:v datom))]
+                                    (when-not (hidden-id? db (:e datom))
+                                      {:holder (d/entity db (:e datom))
+                                       :property (d/entity db property-id)
+                                       :value (d/entity db (:v datom))
+                                       :reason reason})))))))))))
