+(defn- property-choices
+  "The property's own choices (closed values), in the order the editor lists them."
+  [property]
+  (sort-by (juxt :block/order :db/id) (:block/_closed-value-property property)))
+
+(defn- choice-content [choice]
+  (str (db-property/property-value-content choice)))
+
+(defn- resolve-choice
+  "The db id of one of `property`'s own choices given by UUID, ident or title, or nil. A title is
+  matched exactly first, then ignoring case, and only among the property's choices: another
+  property may have a choice with the same title. A number is matched by content for a number
+  property, whose choices are numbers, and otherwise read as a db id."
+  [db property value]
+  (let [property-ident (:db/ident property)
+        value (if (string? value)
+                (get-in property-choice-aliases [property-ident (string/lower-case value)] value)
+                value)
+        choices (property-choices property)
+        own (fn [entity] (when (and entity (some #(= (:db/id entity) (:db/id %)) choices))
+                           (:db/id entity)))
+        by-title (fn [same?] (some #(when (same? (choice-content %)) (:db/id %)) choices))]
+    (cond
+      (and (number? value) (= :number (:logseq.property/type property)))
+      (some #(when (= value (:logseq.property/value %)) (:db/id %)) choices)
+      (number? value) (own (d/entity db value))
+      (qualified-keyword? value) (own (d/entity db value))
+      (and (string? value) (common-util/uuid-string? value)) (own (d/entity db [:block/uuid (uuid value)]))
+      (string? value) (or (when (qualified-keyword? (keyword value)) (own (d/entity db (keyword value))))
+                          (by-title #(= % value))
+                          (by-title #(= (string/lower-case %) (string/lower-case value))))
+      :else nil)))
+
+(defn- choice-error
+  "Why `property` refused a value that is not one of its choices, listing the valid ones."
+  [property]
+  (str "property value must resolve to one of " (or (:block/title property) (entity-ident property))
+       "'s choices (" (string/join ", " (map choice-content (property-choices property))) ")"))
+
