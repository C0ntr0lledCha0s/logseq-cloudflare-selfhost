+++ b/deps/db-sync/test/logseq/db_sync/semantic_outline_options_test.cljs
@@ -0,0 +1,106 @@
+(ns logseq.db-sync.semantic-outline-options-test
+  "getPageOutline's shape options (LC-136): uuids=true ends each block line with its ((uuid)), so a
+  write can target any block from one read; properties picks which property lines print (all, none,
+  or a list of titles or idents); queries=line prints a Query block as one line instead of its
+  query text. Their defaults leave the outline as it was."
+  (:require [cljs.test :refer [async deftest is testing]]
+            [clojure.string :as string]
+            [datascript.core :as d]
+            [logseq.db-sync.test-sql :as test-sql]
+            [logseq.db-sync.worker.handler.sync :as sync-handler]
+            [logseq.db.sqlite.export :as sqlite-export]
+            [logseq.outliner.page :as outliner-page]
+            [promesa.core :as p]))
+
+(defn- request!
+  [self method path body]
+  (p/let [url (str "http://localhost" path (if (string/includes? path "?") "&" "?") "graph-id=graph-1")
+          response (sync-handler/handle-http
+                    self
+                    (js/Request. url (clj->js (cond-> {:method method
+                                                       :headers {"content-type" "application/json"}}
+                                                body (assoc :body (js/JSON.stringify (clj->js body)))))))
+          text (.text response)]
+    {:status (.-status response)
+     :body (when (seq text)
+             (try (js->clj (js/JSON.parse text) :keywordize-keys true)
+                  (catch :default _ text)))}))
+
+(def query-text "{:query [:find ?b :where [?b :block/title \"Write the spec\"]]}")
+
+(defn- with-page [done run]
+  (-> (p/let [conn (sqlite-export/create-conn)
+              [_ page-id] (outliner-page/create! conn "Options" {})
+              self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true}
+              inserted (request! self "POST" "/semantic/block-trees"
+                                 {:target-id (str page-id)
+                                  :blocks [{:title "Write the spec"
+                                            :properties {"logseq.property/status" "Todo"
+                                                         "logseq.property/priority" "High"
+                                                         "logseq.property/deadline" 1795000000000}
+                                            :children [{:title "Notes"}]}
+                                           {:title "Open items" :query query-text}]})
+              _ (is (= 201 (:status inserted)) (pr-str (:body inserted)))
+              uuid-of (fn [title] (str (:block/uuid (d/entity @conn (ffirst (d/q '[:find ?b :in $ ?t :where [?b :block/title ?t]]
+                                                                                   @conn title))))))]
+        (run {:self self :page-id page-id :uuid-of uuid-of}))
+      (p/catch #(is false (str "unexpected error: " %)))
+      (p/finally done)))
+
+(defn- outline! [self page-id query]
+  (p/let [{:keys [status body]} (request! self "GET" (str "/semantic/pages/" page-id "/outline" (when query (str "?" query))) nil)]
+    (is (= 200 status) (str query ": " (pr-str body)))
+    (:markdown body)))
+
+(deftest outline-uuids-end-each-line-test
+  (async done
+    (with-page done
+      (fn [{:keys [self page-id uuid-of]}]
+        (p/let [plain (outline! self page-id "properties=none&queries=line")
+                with-ids (outline! self page-id "uuids=true&properties=none&queries=line")
+                folded (outline! self page-id "uuids=true&properties=none&queries=line&depth=1")]
+          (is (= "- [Todo] Write the spec\n  - Notes\n- Open items (query)" plain))
+          (is (= (str "- [Todo] Write the spec ((" (uuid-of "Write the spec") "))\n"
+                      "  - Notes ((" (uuid-of "Notes") "))\n"
+                      "- Open items ((" (uuid-of "Open items") ")) (query)")
+                 with-ids))
+          (testing "a folded block names its uuid once, then the count"
+            (is (= (str "- [Todo] Write the spec ((" (uuid-of "Write the spec") ")) (+1 block)\n"
+                        "- Open items ((" (uuid-of "Open items") ")) (query)")
+                   folded))))))))
+
+(deftest outline-properties-picks-the-lines-test
+  (async done
+    (with-page done
+      (fn [{:keys [self page-id]}]
+        (p/let [all (outline! self page-id nil)
+                none (outline! self page-id "properties=none")
+                some-by-title (outline! self page-id "properties=priority")
+                some-by-ident (outline! self page-id "properties=logseq.property/deadline,Priority")]
+          (is (string/includes? all "Priority:: [[High]]") "the default prints every property line")
+          (is (string/includes? all "Deadline:: "))
+          (is (not (string/includes? none "::")) "none prints no property lines")
+          (is (string/includes? some-by-title "Priority:: [[High]]") "a title matches ignoring case")
+          (is (not (string/includes? some-by-title "Deadline::")))
+          (is (string/includes? some-by-ident "Deadline:: "))
+          (is (string/includes? some-by-ident "Priority:: ")))))))
+
+(deftest outline-queries-line-hides-query-text-test
+  (async done
+    (with-page done
+      (fn [{:keys [self page-id]}]
+        (p/let [full (outline! self page-id nil)
+                line (outline! self page-id "queries=line")]
+          (is (string/includes? full ":find ?b") "the default prints the query, as before")
+          (is (not (string/includes? line ":find")) "queries=line leaves the query text out")
+          (is (string/includes? line "- Open items (query)")))))))
+
+(deftest outline-shape-options-are-checked-test
+  (async done
+    (with-page done
+      (fn [{:keys [self page-id]}]
+        (p/let [responses (p/all (map #(request! self "GET" (str "/semantic/pages/" page-id "/outline?" %) nil)
+                                      ["uuids=yes" "queries=short" "properties=" "properties=nosuchproperty"]))]
+          (doseq [[param {:keys [status body]}] (map vector ["uuids" "queries" "properties" "properties"] responses)]
+            (is (= 400 status) (str param ": " (pr-str body)))
+            (is (string/starts-with? (str (:error body)) param) (pr-str body))))))))
