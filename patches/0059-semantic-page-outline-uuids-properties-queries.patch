+(defn- outline-int-param
+  "The whole number query parameter `name` within [lo, hi], nil when absent, or ::invalid."
+  [url name lo hi]
+  (let [raw (.get (.-searchParams url) name)]
+    (cond
+      (nil? raw) nil
+      (not (re-matches #"\d+" raw)) ::invalid
+      :else (let [v (js/parseInt raw 10)] (if (<= lo v hi) v ::invalid)))))
+
+(defn- outline-options
+  "getPageOutline's paging options from the query (LC-135), or {:error message} naming the parameter."
+  [db page url]
+  (let [params (.-searchParams url)
+        depth (outline-int-param url "depth" 1 50)
+        limit (outline-int-param url "limit" 1 200)
+        max-chars (outline-int-param url "max-chars" 100 1000000)
+        raw-cursor (.get params "cursor")
+        cursor (decode-cursor raw-cursor)
+        raw-root (.get params "root")
+        root-uuid (when raw-root (parse-uuid raw-root))
+        root (when root-uuid (d/entity db [:block/uuid root-uuid]))]
+    (cond
+      (= ::invalid depth) {:error "depth: must be a whole number from 1 to 50"}
+      (= ::invalid limit) {:error "limit: must be a whole number from 1 to 200"}
+      (= ::invalid max-chars) {:error "max-chars: must be a whole number from 100 to 1000000"}
+      (and raw-cursor (nil? cursor)) {:error "cursor: not a cursor this outline gave; pass a next-cursor from the same page and root, or leave it out"}
+      (and raw-root (nil? root-uuid)) {:error (str "root: not a block UUID: " raw-root)}
+      (and raw-root (or (nil? root) (entity-util/hidden? root) (page? root)
+                        (not= (:db/id page) (:db/id (:block/page root)))))
+      {:error (str "root: no visible block " raw-root " on this page")}
+      :else
+      (let [raw-uuids (.get params "uuids")
+            raw-queries (.get params "queries")
+            raw-properties (.get params "properties")
+            names (when (and raw-properties (not= "all" raw-properties) (not= "none" raw-properties))
+                    (map string/trim (string/split raw-properties #",")))
+            resolved (map (fn [n] [n (when (seq n)
+                                       (or (resolve-property db n)
+                                           (some->> (d/datoms db :avet :block/name (string/lower-case n))
+                                                    (map #(d/entity db (:e %)))
+                                                    (filter property?)
+                                                    first)))])
+                          names)
+            unknown (first (keep (fn [[n p]] (when (nil? p) n)) resolved))
+            idents (set (map (fn [[_ p]] (entity-ident p)) resolved))]
+        (cond
+          (and raw-uuids (not (#{"true" "false"} raw-uuids))) {:error "uuids: must be true or false"}
+          (and raw-queries (not (#{"full" "line"} raw-queries))) {:error "queries: must be full or line"}
+          (= "" raw-properties) {:error "properties: give all, none, or property titles or idents separated by commas"}
+          unknown {:error (str "properties: no property " (pr-str unknown))}
+          :else
+          {:depth depth :limit limit :max-chars max-chars :cursor cursor :root root
+           :uuids? (= "true" raw-uuids)
+           :query-line? (= "line" raw-queries)
+           :keep-property? (cond
+                             (= "none" raw-properties) (constantly false)
+                             names (fn [{:keys [ident]}] (contains? idents ident))
+                             :else nil)})))))
+
 (def ^:private allowed-property-types
   (into (set db-property-type/user-built-in-property-types)
         db-property-type/user-allowed-internal-property-types))
