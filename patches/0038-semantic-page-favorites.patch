+;; ---------------------------------------------------------------------------------------------
+;; reorderFavorites (stage 3): PUT /favorites with {page-ids, dry-run?}, the full list in the new
+;; order. Anything but a permutation of the visible favourites is refused in one 400 naming every
+;; problem; the write rewrites :block/link on the visible slots whose page changes (save-block, as
+;; the app does), keeping every order key and every hidden slot, in one transaction, read back.
+;; Before stage 3 there is no such route and every request below answered 404 {:error "not found"}.
+
+(defn- reorder!
+  [self body & {:keys [e2ee? headers]}]
+  (request! self "PUT" "/semantic/favorites" body e2ee? headers))
+
+(defn- slot-keys
+  "Each slot's uuid and order key, in sibling order: what a reorder must leave byte-equal."
+  [conn]
+  (mapv (juxt :block/uuid :block/order) (slots conn)))
+
+(defn- app-refs!
+  "Gives each linking slot the :block/refs the app's refs pipeline gives it (the linked page), as a
+  favourite the app wrote and synced carries."
+  [conn]
+  (d/transact! conn (keep #(when-let [link (:block/link %)] [:db/add (:db/id %) :block/refs (:db/id link)]) (slots conn))))
+
+(defn- slot-refs
+  "Each slot's refs, as uuids, in sibling order."
+  [conn]
+  (mapv #(set (map :block/uuid (:block/refs %))) (slots conn)))
+
+;; Pins (spec section 8 item 9, reorder half; risk 3). Settled before the connector entry.
+
+;; save-block keeps the new :block/link, and the handler gives each rewritten slot the refs the app's
+;; pipeline would (the linked page only), so the old page's ref goes with its link. A slot the server
+;; added (no refs) gains its new page's ref; a slot the call doesn't rewrite is untouched.
+(deftest reorder-save-block-keeps-link-and-refs-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self alpha beta delta]}]
+        (add-favourites! conn [alpha beta])
+        (app-refs! conn)
+        (p/let [added (favorite! self delta {:favorite true})
+                _ (is (= [#{alpha} #{beta} #{}] (slot-refs conn)) "the server's add leaves refs empty")
+                response (reorder! self {:page-ids [(str delta) (str beta) (str alpha)]})]
+          (is (= 200 (:status added)) (pr-str added))
+          (is (= [200 (ids delta beta alpha)] (listed response)) (pr-str response))
+          (is (= [delta beta alpha] (slot-links conn)) "each slot links its new page")
+          (is (= [#{delta} #{beta} #{alpha}] (slot-refs conn)) "refs follow the link: the old page out, the new in")
+          (is (empty? (filter #(contains? #{alpha delta} (:block/uuid %))
+                              (map #(d/entity @conn (:e %)) (d/datoms @conn :avet :block/link (:db/id (entity conn beta))))))
+              "sanity: Beta is linked by its own slot only"))))))
+
+;; Neither page's :block/updated-at moves: only the slots and their parent are written. (Spec
+;; section 5's stop point: if this moved, the build would stop for the owner.)
+(deftest reorder-does-not-bump-targets-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self alpha beta gamma]}]
+        (add-favourites! conn [alpha beta gamma])
+        (app-refs! conn)
+        (p/let [response (reorder! self {:page-ids [(str gamma) (str beta) (str alpha)]})]
+          (is (= [200 (ids gamma beta alpha)] (listed response)) (pr-str response))
+          (is (= [1 1 1] (mapv #(:block/updated-at (entity conn %)) [alpha beta gamma]))
+              "no target's updated-at moved"))))))
+
+;; getPageBacklinks on both swapped pages answers the same before and after (the slots are blocks of
+;; a hidden page), and the block-changes feed lists no slot and never re-lists a page or its blocks.
+(deftest reorder-backlinks-and-feed-test
+  (async done
+    (with-memory-sql done
+      (fn [sql]
+        (storage/init-schema! sql)
+        (let [conn (storage/open-conn sql)
+              self #js {:sql sql :conn conn :schema-ready true}
+              [alpha beta note-a note-b] (repeatedly 4 random-uuid)]
+          (d/transact! conn (sqlite-create-graph/build-db-initial-data "{}"))
+          (d/transact! conn [(page-tx alpha "Alpha") (page-tx beta "Beta")])
+          ;; A visible reference to each page, so the backlinks have something to compare.
+          (d/transact! conn [{:block/uuid note-a :block/title (str "See [[" alpha "]]") :block/refs #{[:block/uuid alpha]}
+                              :block/page [:block/uuid beta] :block/parent [:block/uuid beta] :block/order "a0"
+                              :block/created-at 1 :block/updated-at 1}
+                             {:block/uuid note-b :block/title (str "See [[" beta "]]") :block/refs #{[:block/uuid beta]}
+                              :block/page [:block/uuid alpha] :block/parent [:block/uuid alpha] :block/order "a1"
+                              :block/created-at 1 :block/updated-at 1}])
+          (add-favourites! conn [alpha beta])
+          (app-refs! conn)
+          (p/let [backlinks #(p/all (map (fn [id] (request! self "GET" (str "/semantic/pages/" id "/backlinks") nil)) [alpha beta]))
+                  before (backlinks)
