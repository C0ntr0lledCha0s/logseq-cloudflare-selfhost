+(defn- with-memory-sql [done f]
+  (let [sqlite (if (find-ns 'nbb.core) (aget sqlite3 "default") sqlite3)
+        db (new sqlite ":memory:" nil)
+        sql #js {:_db db
+                 :transaction (fn [f] ((.transaction db f)))
+                 :exec (fn [sql-str & args]
+                         (let [^js stmt (.prepare db sql-str)]
+                           (if (string/starts-with? (-> sql-str string/trim string/lower-case) "select")
+                             (.apply (.-all stmt) stmt (to-array args))
+                             (do (.apply (.-run stmt) stmt (to-array args)) nil))))}]
+    (-> (p/let [_ (f sql)] nil)
+        (p/catch #(is false (str %)))
+        (p/finally #(do (.close db) (done))))))
+
+(defn- stamped-ids
+  "The entities holding claudeEditedAt (read from :eavt: the attribute may not exist yet)."
+  [conn]
+  (set (keep #(when (= :user.property/claude-editedAt (:a %)) (:e %)) (d/datoms @conn :eavt))))
+
+(defn- feed! [self query]
+  (request! self "GET" (str "/semantic/block-changes" (when (seq query) (str "?" query))) nil))
+
+;; The block-changes feed (which drives the semantic index) neither lists the new slot (hidden page,
+;; empty title) nor re-lists the target or its blocks after an add. Pinned as observed: the
+;; incremental feed names the slot and the favourites page under removed, as it does for any
+;; touched entity that isn't a content block; the indexer only looks those uuids up in D1.
+(deftest add-not-in-feed-test
+  (async done
+    (with-memory-sql done
+      (fn [sql]
+        (storage/init-schema! sql)
+        (let [conn (storage/open-conn sql)
+              self #js {:sql sql :conn conn :schema-ready true}
+              beta (random-uuid)
+              note (random-uuid)]
+          (d/transact! conn (sqlite-create-graph/build-db-initial-data "{}"))
+          (d/transact! conn [(page-tx beta "Beta")])
+          (d/transact! conn [{:block/uuid note :block/title "A Beta note" :block/page [:block/uuid beta]
+                              :block/parent [:block/uuid beta] :block/order "a0"
+                              :block/created-at 1 :block/updated-at 1}])
+          (p/let [start (feed! self "")
+                  response (favorite! self beta {:favorite true})
+                  since (feed! self (str "since=" (get-in start [:body :t]) "&epoch=" (get-in start [:body :epoch])))
+                  full (feed! self "")]
+            (is (= 200 (:status response)) (pr-str response))
+            (is (= [(str note)] (mapv :uuid (get-in start [:body :blocks]))))
+            (is (> (get-in since [:body :t]) (get-in start [:body :t])) "the add is in the tx log")
+            (is (= [200 []] [(:status since) (get-in since [:body :blocks])]) (pr-str since))
+            (is (= #{(str (:block/uuid (first (slots conn)))) (str favorites-uuid)}
+                   (set (get-in since [:body :removed])))
+                "only the slot and the favourites page; never the target or its blocks")
+            (is (= [(str note)] (mapv :uuid (get-in full [:body :blocks]))) "the slot is never a feed block")))))))
+
+;; With the edit-stamp header on, the new slot carries no editedBy or claudeEditedAt (a hidden,
+;; empty block would otherwise be stamped and could reach the Claude Activity page's queries).
+(deftest add-no-edit-stamp-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self alpha beta block]}]
+        (p/let [response (favorite! self alpha {:favorite true} :headers stamped)
+                slot (first (slots conn))
+                _ (is (empty? (stamped-ids conn)) "the add stamped nothing")
+                ;; The control: the same header on an ordinary edit does stamp.
+                control (request! self "PATCH" (str "/semantic/blocks/" block) {:title "Edited"} false stamped)
+                second-add (favorite! self beta {:favorite true} :headers stamped)
+                removed (favorite! self alpha {:favorite false} :headers stamped)
+                stamped-ids (stamped-ids conn)]
+          (is (= [200 "added"] [(:status response) (get-in response [:body :result])]) (pr-str response))
+          (is (= 200 (:status control)) (pr-str control))
+          (is (contains? stamped-ids (:db/id (entity conn block))) "the header is on: an ordinary edit is stamped")
+          (is (= [200 "added"] [(:status second-add) (get-in second-add [:body :result])]) (pr-str second-add))
+          (is (= [nil nil] [(:user.property/claude-editedBy slot) (:user.property/claude-editedAt slot)])
+              "the slot is not stamped")
+          (is (not-any? (set (map :db/id (slots conn))) stamped-ids)
+              "no favourite slot is stamped, so the Claude Activity queries can't list one")
+          (is (= [200 "removed"] [(:status removed) (get-in removed [:body :result])]) (pr-str removed)))))))
