+(ns logseq.db-sync.semantic-favorites-test
+  "Page favourites (patch 0038). Favourites are child blocks of the hidden page $$$favorites, each
+  linking a page with :block/link; the app's db worker reads and writes them, and deps/db-sync had
+  no favourites API. listFavorites finds the page by its deterministic uuid (never by name, so it
+  works on E2EE graphs and after a rename) and returns the favourites in sidebar order (sibling
+  order), leaving out a slot with no link, a slot whose page is hidden or in the Recycle bin, and a
+  later slot linking a page an earlier one links. Favourites are built here as the app builds them:
+  ldb/build-favorite-tx through the real outliner's insert-blocks! with the app's {} options, which
+  put each new favourite at the top."
+  (:require ["better-sqlite3" :as sqlite3]
+            [cljs.test :refer [async deftest is testing]]
+            [clojure.string :as string]
+            [datascript.core :as d]
+            [logseq.common.uuid :as common-uuid]
+            [logseq.db :as ldb]
+            [logseq.db-sync.storage :as storage]
+            [logseq.db-sync.test-sql :as test-sql]
+            [logseq.db-sync.worker.handler.sync :as sync-handler]
+            [logseq.db-sync.worker.routes.semantic :as semantic-routes]
+            [logseq.db.sqlite.create-graph :as sqlite-create-graph]
+            [logseq.db.sqlite.export :as sqlite-export]
+            [logseq.outliner.core :as outliner-core]
+            [promesa.core :as p]))
+
+(def ^:private favorites-uuid (common-uuid/gen-uuid :builtin-block-uuid "$$$favorites"))
+
+(defn- request!
+  "One semantic API request through the real handler; returns {:status :body}. With e2ee?, the
+  request carries graph-e2ee=true as the index's flag reaches the DO."
+  ([self method path body] (request! self method path body false))
+  ([self method path body e2ee?] (request! self method path body e2ee? nil))
+  ([self method path body e2ee? headers]
+   (p/let [url (str "http://localhost" path (if (string/includes? path "?") "&" "?") "graph-id=graph-1"
+                    (when e2ee? "&graph-e2ee=true"))
+           response (sync-handler/handle-http
+                     self
+                     (js/Request. url (clj->js (cond-> {:method method
+                                                        :headers (merge {"content-type" "application/json"} headers)}
+                                                 (some? body) (assoc :body (js/JSON.stringify (clj->js body)))))))
+           text (.text response)]
+     {:status (.-status response)
+      :body (when (seq text)
+              (try (js->clj (js/JSON.parse text) :keywordize-keys true)
+                   (catch :default _ text)))})))
+
+(defn- list! [self & [e2ee?]] (request! self "GET" "/semantic/favorites" nil e2ee?))
+
+(defn- favorites-page [conn] (d/entity @conn [:block/uuid favorites-uuid]))
+
+(defn- add-favourites!
+  "Adds favourite slots so that the sidebar shows them in `entries` order: each entry is a uuid the
+  slot links, or :no-link for a slot without a link. Inserted as the app inserts (each at the top),
+  last entry first, so the slots' db ids run opposite to their sidebar order."
+  [conn entries]
+  (doseq [entry (reverse entries)]
+    (outliner-core/insert-blocks! conn
+                                  [(if (= :no-link entry)
+                                     {:block/title ""}
+                                     (ldb/build-favorite-tx entry))]
+                                  (favorites-page conn)
+                                  {})))
+
+(defn- page-tx [id title & [extra]]
+  (merge {:block/uuid id :block/name (string/lower-case title) :block/title title
+          :block/tags #{:logseq.class/Page} :block/created-at 1 :block/updated-at 1}
+         extra))
+
+(defn- seed-graph
+  "A conn from the initial data (create_graph's $$$favorites included) with pages Alpha, Beta,
+  Gamma, Delta, a hidden page Secret and a block in Alpha."
+  []
+  (let [conn (sqlite-export/create-conn)
+        self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true}
+        [alpha beta gamma delta secret block] (repeatedly 6 random-uuid)]
+    (d/transact! conn [(page-tx alpha "Alpha") (page-tx beta "Beta") (page-tx gamma "Gamma")
+                       (page-tx delta "Delta") (page-tx secret "Secret" {:logseq.property/hide? true})])
+    (d/transact! conn [{:block/uuid block :block/title "An Alpha block"
+                        :block/page [:block/uuid alpha] :block/parent [:block/uuid alpha]
+                        :block/order "a0" :block/created-at 1 :block/updated-at 1}])
+    {:conn conn :self self :alpha alpha :beta beta :gamma gamma :delta delta :secret secret :block block}))
+
+(defn- with-graph [done run]
+  (-> (p/let [graph (seed-graph)] (run graph))
+      (p/catch #(is false (str %)))
+      (p/finally done)))
+
+(defn- listed [response] [(:status response) (mapv :uuid (get-in response [:body :favorites]))])
+
+(defn- ids [& uuids] (mapv str uuids))
+
+;; Before patch 0038 there is no such route: 404 {:error "not found"}.
+(deftest list-in-sidebar-order-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self alpha beta gamma]}]
+        (add-favourites! conn [beta gamma alpha])
+        (p/let [response (list! self)]
+          (is (= 200 (:status response)) (pr-str response))
+          (is (= {:favorites [{:uuid (str beta) :title "Beta" :kind "page"}
+                              {:uuid (str gamma) :title "Gamma" :kind "page"}
+                              {:uuid (str alpha) :title "Alpha" :kind "page"}]}
+                 (:body response))
+              "sibling order under $$$favorites, not the order the slots were created in"))))))
+
+(deftest list-skips-hidden-slots-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self alpha beta gamma delta secret]}]
+        (add-favourites! conn [alpha :no-link beta secret gamma alpha delta beta])
+        (p/let [before (list! self)
+                deleted (request! self "DELETE" (str "/semantic/pages/" gamma "?acknowledge-references=true") nil)
+                recycled? (some? (:logseq.property/deleted-at (d/entity @conn [:block/uuid gamma])))
+                slots-after-delete (count (:block/_parent (favorites-page conn)))
+                after-delete (list! self)
+                restored (request! self "POST" "/semantic/pages" {:title "Gamma"})
+                after-restore (list! self)]
+          (testing "a link-less slot, a hidden page's slot and later duplicates are left out"
+            (is (= [200 (ids alpha beta gamma delta)] (listed before)) (pr-str before)))
+          (testing "deletePage puts the page in the Recycle bin; its favourite is left out, the slot kept"
+            (is (= 200 (:status deleted)) (pr-str deleted))
+            (is recycled?)
+            (is (= [200 (ids alpha beta delta)] (listed after-delete)) (pr-str after-delete))
+            (is (= 8 slots-after-delete) "no slot is removed by a page delete"))
+          (testing "restoring the page brings its favourite back in its place"
+            (is (= [201 (str gamma)] [(:status restored) (get-in restored [:body :uuid])]) (pr-str restored))
+            (is (= [200 (ids alpha beta gamma delta)] (listed after-restore)) (pr-str after-restore))))))))
+
+(deftest list-missing-page-is-empty-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self alpha]}]
+        (add-favourites! conn [alpha])
+        (d/transact! conn [[:db/retractEntity (:db/id (favorites-page conn))]])
+        (is (nil? (favorites-page conn)))
+        (p/let [response (list! self)]
+          (is (= [200 {:favorites []}] [(:status response) (:body response)]) (pr-str response)))))))
+
+(deftest list-by-uuid-not-name-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self alpha beta gamma]}]
+        (add-favourites! conn [alpha beta])
+        ;; The real page under another name, then an impostor holding the name under another uuid,
+        ;; with a favourite of its own.
+        (d/transact! conn [{:db/id (:db/id (favorites-page conn)) :block/name "renamed" :block/title "renamed"}])
+        (let [impostor (random-uuid)]
+          (d/transact! conn [(page-tx impostor "$$$favorites" {:logseq.property/hide? true})])
+          (d/transact! conn [{:block/uuid (random-uuid) :block/title "" :block/link [:block/uuid gamma]
+                              :block/page [:block/uuid impostor] :block/parent [:block/uuid impostor]
+                              :block/order "a0"}]))
+        (p/let [response (list! self)]
+          (is (= [200 (ids alpha beta)] (listed response)) (pr-str response)))))))
+
+(deftest list-e2ee-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self alpha]}]
+        (let [journal (random-uuid)
+              cipher "[\"~#iv\",\"ciphertext\"]"]
+          (d/transact! conn [{:block/uuid journal :block/name cipher :block/title cipher
+                              :block/journal-day 20261109 :block/tags #{:logseq.class/Journal}
+                              :block/created-at 1 :block/updated-at 1}])
+          ;; On an E2EE graph the favourites page's name and title are ciphertext too.
+          (d/transact! conn [{:db/id (:db/id (favorites-page conn)) :block/name cipher :block/title cipher}
+                             {:block/uuid alpha :block/name cipher :block/title cipher}])
+          (add-favourites! conn [journal alpha])
+          (p/let [response (list! self true)]
+            (is (= 200 (:status response)) (pr-str response))
+            (is (= [{:uuid (str journal) :kind "journal" :title (:block/title (d/entity @conn [:block/uuid journal]))}
+                    {:uuid (str alpha) :kind "page" :title cipher}]
+                   (get-in response [:body :favorites]))
+                "found by uuid; uuids and kinds, with titles as stored, as listPages returns them")))))))
+
+(deftest list-kinds-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self alpha block]}]
+        (p/let [journal (random-uuid)
+                _ (d/transact! conn [{:block/uuid journal :block/name "nov 9th, 2026" :block/title "Nov 9th, 2026"
+                                      :block/journal-day 20261109 :block/tags #{:logseq.class/Journal}
+                                      :block/created-at 1 :block/updated-at 1}])
+                tag (request! self "POST" "/semantic/tags" {:title "Projects"})
+                property (request! self "POST" "/semantic/properties" {:title "Rating" :type "number"})
+                tag-id (uuid (get-in tag [:body :uuid]))
+                property-id (uuid (get-in property [:body :uuid]))
+                _ (add-favourites! conn [journal tag-id property-id alpha block])
+                response (list! self)]
+          (is (= [201 201] [(:status tag) (:status property)]))
+          (is (= [["journal" "Nov 9th, 2026"] ["tag" "Projects"] ["property" "Rating"] ["page" "Alpha"]
+                  ["block" "An Alpha block"]]
+                 (mapv (juxt :kind :title) (get-in response [:body :favorites])))
+              (pr-str response)))))))
+
+;; The connector generates list_favorites from this operation.
+(deftest list-route-and-openapi-test
+  (let [public (semantic-routes/match-public "GET" "/api/v1/graphs/graph-1/favorites")
+        document (semantic-routes/openapi-document "https://issuer.example")
+        operation (get-in document [:paths "/api/v1/graphs/{graph-id}/favorites" :get])
+        item (get-in document [:components :schemas :Favorite])]
+    (is (= ["listFavorites" :semantic/favorites-list "logseq/read" :read "/semantic/favorites"]
+           ((juxt :operation-id :handler :scope :rate-class :internal-path) public)))
+    (is (= "listFavorites" (:operationId operation)))
+    (is (= [{:oauth ["logseq/read"]}] (:security operation)))
+    (is (= ["graph-id"] (map :name (:parameters operation))))
+    (is (= "#/components/schemas/FavoritesResponse"
+           (get-in operation [:responses "200" :content "application/json" :schema :$ref])))
+    (is (= ["uuid" "title" "kind"] (:required item)))
+    (is (every? #(string/includes? (:description operation) %)
+                ["sidebar order" "Recycle bin" "empty" "E2EE"]))))
+
+;; ---------------------------------------------------------------------------------------------
+;; setPageFavorite (stage 2): PUT /pages/:page-id/favorite with {favorite, dry-run?}. Add appends at
+;; the bottom (the app adds at the top), remove takes every slot linking the page, both idempotent,
+;; one transaction, read back; refused on E2EE graphs. Before stage 2 there is no such route and
+;; every request below answered 404 {:error "not found"}.
+
+(def ^:private actor
+  (js/encodeURIComponent
+   (js/JSON.stringify #js {"sub" "6f2c1a90-5b1e-4c7a-9d3e-2a1b0c9d8e7f"
+                           "cognito:username" "Owner" "email" "owner@example.com"})))
+
+(def ^:private stamped {"x-logseq-sync-actor" actor "x-logseq-edit-stamp" "claude"})
+
+(defn- favorite!
+  "PUT /pages/:page-id/favorite. `page-id` is a uuid or a title (encoded here)."
+  [self page-id body & {:keys [e2ee? headers]}]
+  (request! self "PUT" (str "/semantic/pages/" (js/encodeURIComponent (str page-id)) "/favorite") body e2ee? headers))
+
+(defn- snapshot
+  "What a call that writes nothing must leave unchanged: the last tx and the datom count."
+  [conn]
+  {:max-tx (:max-tx @conn) :datoms (count (d/datoms @conn :eavt))})
+
+(defn- slots
+  "Every slot under the real $$$favorites in sibling order, hidden ones included."
+  [conn]
+  (when-let [page (favorites-page conn)]
+    (ldb/sort-by-order (:block/_parent page))))
+
+(defn- slot-links
+  "The uuid each slot links, in sibling order (:no-link for a slot without one)."
+  [conn]
+  (mapv #(or (some-> % :block/link :block/uuid) :no-link) (slots conn)))
+
+(defn- record-reports!
+  "Collects every transaction on conn until the returned fn is called; it returns the reports."
+  [conn]
+  (let [reports (atom [])
+        k (keyword (str "favorites-" (random-uuid)))]
+    (d/listen! conn k #(when (seq (:tx-data %)) (swap! reports conj %)))
+    (fn [] (d/unlisten! conn k) @reports)))
+
+(defn- tx-ids [reports] (distinct (map :tx (mapcat :tx-data reports))))
+
+(defn- entity [conn id] (d/entity @conn [:block/uuid id]))
+
+(defn- favorites-body [response] (mapv :uuid (get-in response [:body :favorites])))
+
+;; Pins (spec section 8 item 9, add half). Settled before the connector entry.
+
+;; The target's :block/updated-at is the same after an add: only the new slot and its parent are
+;; written. (Spec section 5's stop point: if this moved, the build would stop for the owner.)
+(deftest add-does-not-bump-target-updated-at-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self alpha beta]}]
+        (add-favourites! conn [alpha])
+        (let [before (:block/updated-at (entity conn beta))]
+          (p/let [response (favorite! self beta {:favorite true})]
+            (is (= [200 "added"] [(:status response) (get-in response [:body :result])]) (pr-str response))
+            (is (= 1 before))
+            (is (= before (:block/updated-at (entity conn beta))) "the target's updated-at did not move")))))))
+
+;; Pinned as observed: the new slot links the target with :block/link, and its :block/refs is empty.
+;; The outliner's refs pipeline (pipeline.cljs, which would add the link to refs) is the client's
+;; and never runs for a server write, so the target gains no reference. getPageBacklinks on the
+;; target answers the same before and after.
+(deftest add-refs-and-backlinks-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self beta gamma]}]
+        ;; A visible reference to Beta, so the backlinks have something to compare.
+        (d/transact! conn [{:block/uuid (random-uuid) :block/title (str "See [[" beta "]]")
+                            :block/refs #{[:block/uuid beta]}
+                            :block/page [:block/uuid gamma] :block/parent [:block/uuid gamma]
+                            :block/order "a0" :block/created-at 1 :block/updated-at 1}])
+        (p/let [before (request! self "GET" (str "/semantic/pages/" beta "/backlinks") nil)
+                response (favorite! self beta {:favorite true})
+                after (request! self "GET" (str "/semantic/pages/" beta "/backlinks") nil)]
+          (is (= 200 (:status response)) (pr-str response))
+          (is (= (:db/id (entity conn beta)) (:db/id (:block/link (first (slots conn))))))
+          (is (empty? (:block/refs (first (slots conn)))) "no refs: the client pipeline doesn't run on the server")
+          (is (= 200 (:status before)) (pr-str before))
+          (is (= (:body before) (:body after)) "backlinks are unchanged"))))))
