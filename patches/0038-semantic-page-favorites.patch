+                before (snapshot conn)
+                empty-none (reorder! self {:page-ids []})
+                _ (is (= before (snapshot conn)) "an empty list on an empty favourites page writes nothing")
+                _ (add-favourites! conn [alpha :no-link beta gamma])
+                before (snapshot conn)
+                same (reorder! self {:page-ids [(str alpha) (str beta) (str gamma)]})
+                same-by-title (reorder! self {:page-ids ["alpha" "Beta" "GAMMA"] :dry-run false})
+                same-dry (reorder! self {:page-ids [(str alpha) (str beta) (str gamma)] :dry-run true})
+                after (snapshot conn)
+                sent-by-no-ops (count @sent)
+                moved (reorder! self {:page-ids [(str beta) (str alpha) (str gamma)]})
+                sent-by-move (count @sent)
+                _ (d/transact! conn [[:db/retractEntity (:db/id (favorites-page conn))]])
+                missing-before (snapshot conn)
+                empty-missing (reorder! self {:page-ids []})
+                one-missing (reorder! self {:page-ids [(str alpha)]})]
+          (is (= [200 {:favorites []}] [(:status empty-none) (:body empty-none)]) (pr-str empty-none))
+          (is (= [200 (ids alpha beta gamma)] (listed same)) (pr-str same))
+          (is (= (:body same) (:body same-by-title)))
+          (is (= (assoc (:body same) :dry-run true) (:body same-dry)))
+          (is (= before after) "no tx was written")
+          (is (= 0 sent-by-no-ops) "no client was told of a change")
+          (is (= [200 (ids beta alpha gamma) 1] (conj (listed moved) sent-by-move)) "a real reorder tells the clients once")
+          (is (= [200 {:favorites []}] [(:status empty-missing) (:body empty-missing)]) (pr-str empty-missing))
+          (is (= [400 (str "page-ids: entry 0: \"Alpha\" (" alpha ") is not a favourite")]
