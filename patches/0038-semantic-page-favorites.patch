+            (is (= [200 200] (mapv :status before)) (pr-str before))
+            (is (= (mapv :body before) (mapv :body after)) "both pages' backlinks are unchanged")
+            (is (= #{(str note-a) (str note-b)} (set (mapv :uuid (get-in start [:body :blocks])))))
