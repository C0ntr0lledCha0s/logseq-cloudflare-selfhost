+                                           (fn [tx-conn block & _]
+                                             (when (< 1 (swap! calls inc))
+                                               (d/transact! tx-conn [(select-keys block [:block/uuid :block/link])])))]
+                             (reorder! self {:page-ids [(str gamma) (str beta) (str alpha)]}))]
