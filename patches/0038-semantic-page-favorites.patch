+            (is (every? #(neg? (compare % new-key)) (butlast keys)) "the new key sorts after every sibling")
+            (is (= 1 (count (d/datoms @conn :avet :block/order new-key))) "no other block holds the key")
+            (is (= 1 (count reports)) "one transaction")
