+
+;; Kinds a favourite can be, each named as page-ids takes it: a page by uuid and by title, a journal
+;; by uuid and by date, a tag and a property by uuid, and a block the app favourited from a zoomed-in
+;; block, by uuid.
+(deftest reorder-kinds-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self alpha beta block]}]
+        (p/let [journal (random-uuid)
+                _ (d/transact! conn [{:block/uuid journal :block/name "nov 9th, 2026" :block/title "Nov 9th, 2026"
+                                      :block/journal-day 20261109 :block/tags #{:logseq.class/Journal}
+                                      :block/created-at 1 :block/updated-at 1}])
+                tag (request! self "POST" "/semantic/tags" {:title "Projects"})
+                property (request! self "POST" "/semantic/properties" {:title "Rating" :type "number"})
+                tag-id (uuid (get-in tag [:body :uuid]))
+                property-id (uuid (get-in property [:body :uuid]))
+                _ (add-favourites! conn [alpha beta journal tag-id property-id block])
+                response (reorder! self {:page-ids [(str block) (str property-id) (str tag-id) "2026-11-09" "Beta" (str alpha)]})
+                links (slot-links conn)
+                by-uuid (reorder! self {:page-ids [(str alpha) (str beta) (str journal) (str tag-id) (str property-id) (str block)]})]
+          (is (= [200 ["block" "property" "tag" "journal" "page" "page"]]
+                 [(:status response) (mapv :kind (get-in response [:body :favorites]))])
+              (pr-str response))
+          (is (= [block property-id tag-id journal beta alpha] links))
+          (is (= [200 (ids alpha beta journal tag-id property-id block)] (listed by-uuid)) (pr-str by-uuid)))))))
+
+;; The connector generates reorder_favorites from this operation.
+(deftest reorder-route-and-openapi-test
+  (let [public (semantic-routes/match-public "PUT" "/api/v1/graphs/graph-1/favorites")
+        document (semantic-routes/openapi-document "https://issuer.example")
+        operation (get-in document [:paths "/api/v1/graphs/{graph-id}/favorites" :put])
+        body (get-in operation [:requestBody :content "application/json" :schema])]
+    (is (= ["reorderFavorites" :semantic/favorites-reorder "logseq/write" :write "/semantic/favorites"]
+           ((juxt :operation-id :handler :scope :rate-class :internal-path) public)))
+    (is (= "listFavorites" (:operation-id (semantic-routes/match-public "GET" "/api/v1/graphs/graph-1/favorites")))
+        "the read keeps its route")
+    (is (= [{:oauth ["logseq/write"]}] (:security operation)))
+    (is (= ["graph-id"] (map :name (:parameters operation))))
+    (is (true? (get-in operation [:requestBody :required])))
+    (is (= ["page-ids"] (:required body)))
+    (is (= #{:page-ids :dry-run} (set (keys (:properties body)))))
+    (is (= "string" (get-in body [:properties :page-ids :items :type])))
+    (is (false? (:additionalProperties body)))
+    (is (= "#/components/schemas/FavoritesResponse"
+           (get-in operation [:responses "200" :content "application/json" :schema :$ref])))
+    (is (every? #(contains? (:responses operation) %) ["400" "500"]))
+    (is (every? #(string/includes? (:description operation) %)
+                ["full list" "listFavorites" "hidden" "order keys" "E2EE" "dry-run" "missing" "duplicate" "not a favourite"]))))
+
+;; ---------------------------------------------------------------------------------------------
+;; Review round 1.
+
+(defn- count-broadcasts!
+  "Stubs the DO's sockets with one open client and returns an atom of the messages it is sent."
+  [^js self]
+  (let [sent (atom [])]
+    (set! (.-state self) #js {:getWebSockets (fn [] #js [#js {:readyState 1 :send #(swap! sent conj %)}])})
+    sent))
+
+;; r1-tests-1: a real add and a real remove each tell the connected clients once; a re-send (no-op)
+;; and a dry run tell nobody.
+(deftest set-favorite-tells-clients-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self alpha beta gamma]}]
+        (add-favourites! conn [alpha])
+        (let [sent (count-broadcasts! self)
+              sends (fn [response] (p/let [r response] [(:status r) (get-in r [:body :result]) (count @sent)]))]
+          (p/let [dry-add (sends (favorite! self gamma {:favorite true :dry-run true}))
+                  add (sends (favorite! self beta {:favorite true}))
+                  add-again (sends (favorite! self beta {:favorite true}))
+                  dry-remove (sends (favorite! self beta {:favorite false :dry-run true}))
+                  remove (sends (favorite! self beta {:favorite false}))
+                  remove-again (sends (favorite! self beta {:favorite false}))]
+            (is (= [200 "added" 0] dry-add) "a dry-run add tells no client")
+            (is (= [200 "added" 1] add) "a real add tells the clients once")
+            (is (= [200 "already a favourite" 1] add-again) "a re-sent add tells no client")
+            (is (= [200 "removed" 1] dry-remove) "a dry-run remove tells no client")
+            (is (= [200 "removed" 2] remove) "a real remove tells the clients once")
+            (is (= [200 "was not a favourite" 2] remove-again) "a re-sent remove tells no client")))))))
+
+;; r1-tests-3: a reorder dry run that reaches the write (a real permutation, not the same-order
+;; no-op) tells no client; the same call for real tells them once.
+(deftest reorder-dry-run-tells-no-client-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self alpha beta gamma]}]
+        (add-favourites! conn [alpha beta gamma])
+        (let [sent (count-broadcasts! self)
+              order [(str gamma) (str alpha) (str beta)]]
+          (p/let [dry (reorder! self {:page-ids order :dry-run true})
+                  sent-by-dry (count @sent)
+                  real (reorder! self {:page-ids order})
+                  sent-by-real (count @sent)]
+            (is (= [200 (ids gamma alpha beta) true] (conj (listed dry) (get-in dry [:body :dry-run]))) (pr-str dry))
+            (is (= 0 sent-by-dry) "the dry run told no client")
+            (is (= [200 (ids gamma alpha beta) 1] (conj (listed real) sent-by-real)) "the real reorder told them once")))))))
+
+;; r1-tests-2: an add on a graph that already has $$$favorites writes the new slot and nothing of the
+;; page's own but the updated-at insert-blocks! gives a parent: the page isn't re-created, so no name,
+;; title, tags or flags are re-asserted and its created-at is kept.
+(deftest add-leaves-existing-page-alone-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self alpha beta]}]
+        (add-favourites! conn [alpha])
+        (let [page-id (:db/id (favorites-page conn))
+              before (d/pull @conn '[*] page-id)
+              stop (record-reports! conn)]
+          (p/let [response (favorite! self beta {:favorite true})
+                  reports (stop)
+                  page-attrs (set (keep (fn [datom] (when (and (= page-id (:e datom)) (:added datom)) (:a datom)))
+                                        (mapcat :tx-data reports)))]
+            (is (= [200 "added"] [(:status response) (get-in response [:body :result])]) (pr-str response))
+            (is (= #{:block/updated-at} page-attrs)
+                "only the insert's own touch of its parent: no name, title, tags, flags or created-at")
+            (is (= (dissoc before :block/updated-at) (dissoc (d/pull @conn '[*] page-id) :block/updated-at))
+                "the page's other attributes, created-at included, are unchanged")))))))
+
+;; r1-correctness-1: a later duplicate slot sitting between visible slots. Re-pointing only the
+;; visible slots left the duplicate in front of its page's new slot, so the list read back in
+;; another order: 500, after the write was committed. The first live slots now take the new order,
+;; and a mismatch is caught before anything is stored. Layouts: a duplicate right after its page's
+;; slot; duplicates of two pages interleaved with a link-less slot, a hidden page's slot and a
+;; recycled page's slot; each as a dry run and for real.
+(deftest reorder-duplicate-between-visible-slots-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self alpha beta gamma delta secret]}]
+        (add-favourites! conn [alpha alpha beta gamma])
+        (p/let [keys-before (slot-keys conn)
+                order [(str beta) (str gamma) (str alpha)]
+                dry (reorder! self {:page-ids order :dry-run true})
+                real (reorder! self {:page-ids order})
+                listed-after (list! self)]
+          (testing "a duplicate right after its page's slot"
+            (is (= [200 (ids beta gamma alpha)] (listed dry)) (pr-str dry))
+            (is (= [200 (ids beta gamma alpha)] (listed real)) (pr-str real))
+            (is (= [200 (ids beta gamma alpha)] (listed listed-after)))
+            (is (= [beta gamma alpha gamma] (slot-links conn)) "the last live slot is now the duplicate")
+            (is (= keys-before (slot-keys conn)) "no slot was added, deleted or re-keyed"))
+          (p/let [epsilon (random-uuid)
+                  _ (d/transact! conn [(page-tx epsilon "Epsilon")])
+                  _ (d/transact! conn (mapv (fn [slot] [:db/retractEntity (:db/id slot)]) (slots conn)))
+                  _ (add-favourites! conn [alpha :no-link beta alpha secret epsilon gamma beta delta])
+                  deleted (request! self "DELETE" (str "/semantic/pages/" epsilon "?acknowledge-references=true") nil)
+                  keys-before (slot-keys conn)
+                  order [(str delta) (str gamma) (str beta) (str alpha)]
+                  dry (reorder! self {:page-ids order :dry-run true})
+                  real (reorder! self {:page-ids order})]
+            (testing "duplicates of two pages among hidden slots"
+              (is (= 200 (:status deleted)) (pr-str deleted))
+              (is (= [200 (ids delta gamma beta alpha)] (listed dry)) (pr-str dry))
+              (is (= [200 (ids delta gamma beta alpha)] (listed real)) (pr-str real))
+              (is (= [delta :no-link gamma beta secret epsilon alpha beta delta] (slot-links conn))
+                  "the first four live slots take the order; hidden slots and the trailing duplicates keep their links")
+              (is (= keys-before (slot-keys conn))))))))))
+
+;; r1-correctness-1, the read-back half (STUBS A STEP: the outliner writes the wrong slot): a write
+;; that doesn't read back answers 500 and stores nothing, for an add and a remove.
+(deftest read-back-mismatch-stores-nothing-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self alpha beta gamma]}]
+        (add-favourites! conn [alpha beta])
+        (let [insert outliner-core/insert-blocks!
+              delete outliner-core/delete-blocks!]
+          (p/let [add (p/with-redefs [outliner-core/insert-blocks!
+                                      (fn [tx-conn _blocks target opts]
+                                        (insert tx-conn [(ldb/build-favorite-tx alpha)] target opts))]
+                        (favorite! self gamma {:favorite true}))
+                  after-add (slot-links conn)
+                  remove (p/with-redefs [outliner-core/delete-blocks!
+                                         (fn [tx-conn _slots opts]
+                                           (delete tx-conn (filterv #(= beta (some-> % :block/link :block/uuid)) (slots conn)) opts))]
+                           (favorite! self alpha {:favorite false}))]
+            (is (= [500 "favourite did not read back"] [(:status add) (get-in add [:body :error])]) (pr-str add))
+            (is (= [alpha beta] after-add) "the wrong slot the add wrote was not stored")
+            (is (= [500 "favourite did not read back"] [(:status remove) (get-in remove [:body :error])]) (pr-str remove))
+            (is (= [alpha beta] (slot-links conn)) "the wrong slot the remove deleted is still there")))))))
