+;; Spec section 8 item 8: a permutation rewrites the links, keeps every slot's key byte-equal, reads
+;; back as asked, in one transaction with one tx id. Reversed, a chain (each page moves one place)
+;; and a swap of two, with entries by uuid, by title in another case and by journal date.
+(deftest reorder-permutation-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self alpha beta gamma]}]
+        (let [journal (random-uuid)]
+          (d/transact! conn [{:block/uuid journal :block/name "nov 9th, 2026" :block/title "Nov 9th, 2026"
+                              :block/journal-day 20261109 :block/tags #{:logseq.class/Journal}
+                              :block/created-at 1 :block/updated-at 1}])
+          (add-favourites! conn [alpha beta gamma journal])
+          (p/let [keys-before (slot-keys conn)
+                  run (fn [page-ids]
+                        (let [stop (record-reports! conn)]
+                          (p/let [response (reorder! self {:page-ids page-ids})
+                                  reports (stop)
+                                  listed-after (list! self)]
+                            {:response response :reports reports :read listed-after
+                             :links (slot-links conn) :slot-keys (slot-keys conn)})))
+                  reversed (run [(str journal) (str gamma) (str beta) (str alpha)])
+                  chain (run ["2026-11-09" "GAMMA" "beta" (str alpha)])
+                  _ (is (= [journal gamma beta alpha] (:links chain)) "sanity: the chain's starting order")
+                  chain (run [(str gamma) (str beta) (str alpha) (str journal)])
+                  swap (run [(str beta) (str gamma) (str alpha) (str journal)])]
+            (doseq [[label {:keys [response reports read links slot-keys]} expected]
+                    [["reversed" reversed [journal gamma beta alpha]]
+                     ["chain" chain [gamma beta alpha journal]]
+                     ["swap" swap [beta gamma alpha journal]]]]
+              (testing label
+                (is (= [200 (apply ids expected)] (listed response)) (pr-str response))
+                (is (= (:body read) (:body response)) "the answer is the list as listFavorites reads it")
+                (is (= expected links) "each slot links its new page")
+                (is (= keys-before slot-keys) "every slot keeps its uuid and its order key, byte-equal")
+                (is (= [1 1] [(count reports) (count (tx-ids reports))]) "one transaction, one tx id")))
+            (is (= {:favorites [{:uuid (str beta) :title "Beta" :kind "page"}
+                                {:uuid (str gamma) :title "Gamma" :kind "page"}
+                                {:uuid (str alpha) :title "Alpha" :kind "page"}
+                                {:uuid (str journal) :title "Nov 9th, 2026" :kind "journal"}]}
+                   (:body (:response swap))))
+            (is (= 2 (count (filter (fn [{:keys [a added]}] (and added (= :block/link a))) (mapcat :tx-data (:reports swap)))))
+                "a swap rewrites two slots' links, and no other slot's")))))))
+
