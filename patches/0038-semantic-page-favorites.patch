+    (d/transact! conn [{:block/uuid asset :block/title "photo" :block/order "a9"
+                        :block/page [:block/uuid twin-a] :block/parent [:block/uuid twin-a]
+                        :block/tags #{:logseq.class/Asset} :logseq.property.asset/type "png"
+                        :logseq.property.asset/checksum "abc" :logseq.property.asset/size 1
+                        :block/created-at 1 :block/updated-at 1}])
+    {:old old :uuid-named uuid-named :asset asset :board board :twin-a twin-a :twin-b twin-b}))
+
+;; Spec section 8 item 4 and review focus 1, 3 and 5: each refusal names page-id or the field and
+;; the reason, and the db is unchanged.
+(deftest refusals-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self alpha secret block]}]
+        (add-favourites! conn [alpha])
+        (let [{:keys [old uuid-named asset board twin-a twin-b]} (seed-refusal-kinds conn)
+              missing (random-uuid)
+              label (fn [id] (str "page-id: \"" (:block/title (entity conn id)) "\" (" id ") "))]
+          (p/do
+           (p/doseq [[kind id body status error]
+                    [["the favourites page by uuid" favorites-uuid {:favorite true} 404 (str "page-id: no page " favorites-uuid)]
+                     ["the favourites page by title" "$$$favorites" {:favorite true} 404 "page-id: no page titled \"$$$favorites\""]
+                     ["a hidden page" secret {:favorite true} 404 (str "page-id: no page " secret)]
+                     ["a missing uuid" missing {:favorite true} 404 (str "page-id: no page " missing)]
+                     ["a missing uuid, remove" missing {:favorite false} 404 (str "page-id: no page " missing)]
+                     ["a missing title" "Nowhere" {:favorite true} 404 "page-id: no page titled \"Nowhere\""]
+                     ["a recycled page" old {:favorite true} 400 (str (label old) "is in the Recycle bin")]
+                     ["a block" block {:favorite true} 400 (str (label block) "is a block, not a page")]
+                     ["a uuid-named page" uuid-named {:favorite true} 400 (str (label uuid-named) "has a uuid name")]
+                     ["an asset" asset {:favorite true} 400 (str (label asset) "is an asset")]
+                     ["a whiteboard" board {:favorite true} 400 (str (label board) "is a whiteboard, not a page")]
+                     ["the UK spelling" alpha {:favourite true} 400
+                      "favourite: not a field; the body takes favorite and dry-run; favorite: must be true or false"]
+                     ["an unknown field beside favorite" alpha {:favorite false :page "x"} 400
+                      "page: not a field; the body takes favorite and dry-run"]
+                     ["favorite as a string" alpha {:favorite "true"} 400 "favorite: must be true or false"]
+                     ["favorite as a number" alpha {:favorite 1} 400 "favorite: must be true or false"]
+                     ["favorite null" alpha {:favorite nil} 400 "favorite: must be true or false"]
+                     ["no body" alpha nil 400 "favorite: must be true or false"]
+                     ["a body that isn't an object" alpha [true] 400 "body: give an object with favorite"]
+                     ["dry-run as a string" alpha {:favorite false :dry-run "yes"} 400 "dry-run: must be true or false"]]]
+            (p/let [before (snapshot conn)
+                    response (favorite! self id body)]
+              (testing kind
+                (is (= [status error] [(:status response) (get-in response [:body :error])]) (pr-str response))
+                (is (= before (snapshot conn)) "nothing is written"))))
+           (p/let [before (snapshot conn)
+                   ambiguous (favorite! self "example" {:favorite true})]
+             (testing "a title two pages share ignoring case: 409 with candidates"
+               (is (= 409 (:status ambiguous)) (pr-str ambiguous))
+               (is (= #{(str twin-a) (str twin-b)} (set (map :uuid (get-in ambiguous [:body :candidates])))))
+               (is (= before (snapshot conn))))
+             (is (= [alpha] (slot-links conn))))))))))
+
+;; Review focus 2: what the app's page menu offers is accepted: a visible built-in page, a journal
+;; (by uuid and by its date), a tag and a property.
+(deftest allowed-kinds-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self]}]
+        (p/let [library (ldb/get-library-page @conn)
+                journal (random-uuid)
+                _ (d/transact! conn [{:block/uuid journal :block/name "nov 9th, 2026" :block/title "Nov 9th, 2026"
+                                      :block/journal-day 20261109 :block/tags #{:logseq.class/Journal}
+                                      :block/created-at 1 :block/updated-at 1}])
+                tag (request! self "POST" "/semantic/tags" {:title "Projects"})
+                property (request! self "POST" "/semantic/properties" {:title "Rating" :type "number"})
+                results (p/loop [ids [(:block/uuid library) journal (get-in tag [:body :uuid])
+                                      (get-in property [:body :uuid])]
+                                 results []]
+                          (if-let [id (first ids)]
+                            (p/let [result (favorite! self id {:favorite true})]
+                              (p/recur (rest ids) (conj results result)))
+                            results))
+                by-date (favorite! self "2026-11-09" {:favorite false})
+                tag-by-title (favorite! self "Projects" {:favorite false})
+                response (list! self)]
+          (is (true? (:logseq.property/built-in? library)))
+          (is (= [200 200 200 200] (mapv :status results)) (pr-str results))
+          (is (= [["page" "Library"] ["journal" "Nov 9th, 2026"] ["tag" "Projects"] ["property" "Rating"]]
+                 (mapv (juxt :kind :title) (get-in (last results) [:body :favorites]))))
+          (is (= [200 "removed"] [(:status by-date) (get-in by-date [:body :result])]) (pr-str by-date))
+          (is (= [404 "page-id: no page titled \"Projects\""] [(:status tag-by-title) (get-in tag-by-title [:body :error])])
+              "titles resolve pages and journals only, as everywhere page-id is taken; a tag goes by its UUID")
+          (is (= ["Library" "Projects" "Rating"] (mapv :title (get-in response [:body :favorites])))))))))
+
+;; Review focus 4: deletePage leaves the favourite, hidden; add refuses the recycled page, and remove
+;; (by uuid) clears every slot linking it.
+(deftest remove-recycled-target-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self alpha beta]}]
+        (add-favourites! conn [alpha beta alpha])
+        (p/let [deleted (request! self "DELETE" (str "/semantic/pages/" alpha "?acknowledge-references=true") nil)
+                add (favorite! self alpha {:favorite true})
+                removed (favorite! self alpha {:favorite false})
+                again (favorite! self alpha {:favorite false})]
+          (is (= 200 (:status deleted)) (pr-str deleted))
+          (is (= 400 (:status add)) (pr-str add))
+          (is (string/ends-with? (get-in add [:body :error]) "is in the Recycle bin"))
+          (is (= [200 "removed" [(str beta)]]
+                 [(:status removed) (get-in removed [:body :result]) (favorites-body removed)])
+              (pr-str removed))
+          (is (= [beta] (slot-links conn)) "both slots linking the recycled page went")
+          (is (= "was not a favourite" (get-in again [:body :result]))))))))
+
+;; Spec section 3.4 step 1: no favourite write on an E2EE graph, with or without the favourites
+;; page, dry run or not.
+(deftest e2ee-refuses-every-write-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self alpha beta]}]
+        (add-favourites! conn [alpha])
+        (p/let [message "favourites can't be changed on E2EE graphs; the favourites page and its blocks are encrypted"
+                uuids #(count (d/datoms @conn :avet :block/uuid))
+                before (snapshot conn)
+                entities (uuids)
+                responses (p/all [(favorite! self beta {:favorite true} :e2ee? true)
+                                  (favorite! self alpha {:favorite false} :e2ee? true)
+                                  (favorite! self beta {:favorite true :dry-run true} :e2ee? true)
+                                  (favorite! self alpha {:favorite true} :e2ee? true)
+                                  (favorite! self alpha {:favourite true} :e2ee? true)
+                                  (favorite! self (random-uuid) {:favorite true} :e2ee? true)])
+                after (snapshot conn)
+                after-entities (uuids)
+                _ (d/transact! conn [[:db/retractEntity (:db/id (favorites-page conn))]])
+                without-page (snapshot conn)
+                create (favorite! self beta {:favorite true} :e2ee? true)]
+          (is (= (repeat 6 [400 message]) (mapv (juxt :status (comp :error :body)) responses)) (pr-str responses))
+          (is (= [before entities] [after after-entities]) "nothing written; the entity count is unchanged")
+          (is (= [400 message] [(:status create) (get-in create [:body :error])]))
+          (is (nil? (favorites-page conn)) "the page is never created on an E2EE graph")
+          (is (= without-page (snapshot conn))))))))
+
+;; Spec section 8 item 5 (write half), review focus 10: writes go to the page at the fixed uuid; with
+;; it missing, a page named $$$favorites under another uuid refuses the create path.
+(deftest impostor-name-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self alpha beta]}]
+        (let [impostor (random-uuid)]
+          (d/transact! conn [(page-tx impostor "$$$favorites" {:logseq.property/hide? true})])
+          (p/let [present (favorite! self alpha {:favorite true})
+                  _ (is (= [alpha] (slot-links conn)) "written under the real page")
+                  _ (is (empty? (:block/_parent (entity conn impostor))) "nothing under the impostor")
+                  _ (d/transact! conn [[:db/retractEntity (:db/id (favorites-page conn))]])
+                  before (snapshot conn)
+                  missing (favorite! self beta {:favorite true})]
+            (is (= 200 (:status present)) (pr-str present))
+            (is (= [409 "graph has a $$$favorites page with an unexpected uuid; nothing was changed"]
+                   [(:status missing) (get-in missing [:body :error])])
+                (pr-str missing))
+            (is (nil? (favorites-page conn)) "nothing created")
+            (is (= before (snapshot conn)))))))))
+
+(defn- page-attributes
+  "The favourites page's own attributes, as the create path must give them: timestamps and db ids
+  left out, tags as idents."
+  [db]
+  (-> (d/pull db '[*] [:block/uuid favorites-uuid])
+      (dissoc :db/id :block/created-at :block/updated-at :block/tx-id :logseq.property/created-by-ref)
+      (update :block/tags (fn [tags] (set (map #(:db/ident (d/entity db (:db/id %))) tags))))))
+
+;; Spec section 8 item 6 (write half), risk 5: with no page at the uuid on a graph that isn't E2EE,
+;; an add creates it with create_graph's attributes in the same tx as the insert.
+(deftest missing-page-created-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self alpha]}]
+        (let [expected (page-attributes @(sqlite-export/create-conn))]
+          (d/transact! conn [[:db/retractEntity (:db/id (favorites-page conn))]])
+          (let [stop (record-reports! conn)]
+            (p/let [response (favorite! self alpha {:favorite true})
+                    reports (stop)
+                    page (favorites-page conn)]
+              (is (= [200 "added" [(str alpha)]]
+                     [(:status response) (get-in response [:body :result]) (favorites-body response)])
+                  (pr-str response))
+              (is (= expected (page-attributes @conn)) "the same attributes as a create_graph page")
+              (is (pos-int? (:block/created-at page)))
+              (is (= [alpha] (slot-links conn)))
+              (is (= [1 1] [(count reports) (count (tx-ids reports))]) "page and slot in one tx"))))))))
+
+;; Spec section 8 item 10, review focus 6: a dry run answers the real body with dry-run: true and
+;; writes nothing: add, remove and the create path.
+(deftest dry-run-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self alpha beta]}]
+        (add-favourites! conn [alpha])
+        (p/let [before (snapshot conn)
+                add (favorite! self beta {:favorite true :dry-run true})
+                remove (favorite! self alpha {:favorite false :dry-run true})
+                noop (favorite! self alpha {:favorite true :dry-run true})
+                _ (is (= before (snapshot conn)) "dry runs wrote nothing")
+                _ (d/transact! conn [[:db/retractEntity (:db/id (favorites-page conn))]])
+                missing (snapshot conn)
+                create (favorite! self beta {:favorite true :dry-run true})
+                _ (is (= missing (snapshot conn)) "the create path's dry run wrote nothing")
+                _ (is (nil? (favorites-page conn)) "and created no page")
+                real-create (favorite! self beta {:favorite true})]
+          (is (= {:result "added" :dry-run true
+                  :page {:uuid (str beta) :title "Beta" :kind "page"}
+                  :favorites [{:uuid (str alpha) :title "Alpha" :kind "page"}
+                              {:uuid (str beta) :title "Beta" :kind "page"}]}
+                 (:body add)))
+          (is (= {:result "removed" :dry-run true
+                  :page {:uuid (str alpha) :title "Alpha" :kind "page"}
+                  :favorites []}
+                 (:body remove)))
+          (is (= [200 "already a favourite" true]
+                 [(:status noop) (get-in noop [:body :result]) (get-in noop [:body :dry-run])]))
+          (is (= (assoc (:body real-create) :dry-run true) (:body create)) "the create path's dry run answers the real body"))))))
+
+;; Read-back (STUBS A STEP: the outliner's insert and delete are redefined to write nothing, so the
+;; handler's own re-read must catch it). A real write that doesn't store what was asked answers 500.
+(deftest read-back-mismatch-rejects-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self alpha beta]}]
+        (add-favourites! conn [alpha])
+        (p/let [add (p/with-redefs [outliner-core/insert-blocks! (fn [& _] nil)]
+                      (favorite! self beta {:favorite true}))
+                remove (p/with-redefs [outliner-core/delete-blocks! (fn [& _] nil)]
+                         (favorite! self alpha {:favorite false}))]
+          (is (= [500 "favourite did not read back"] [(:status add) (get-in add [:body :error])]) (pr-str add))
+          (is (= [500 "favourite did not read back"] [(:status remove) (get-in remove [:body :error])]) (pr-str remove))
+          (is (= [alpha] (slot-links conn))))))))
+
+;; The handler is reached through handle, which seeds the max order key: a favourite written after a
+;; client wrote a slot with a high key (raw, as a sync replay would, never through this process's
+;; key generator) takes a key after it and never reuses one.
+(deftest seeded-order-key-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self alpha beta]}]
+        (d/transact! conn [{:block/uuid (random-uuid) :block/title "" :block/link [:block/uuid alpha]
+                            :block/page (:db/id (favorites-page conn)) :block/parent (:db/id (favorites-page conn))
+                            :block/order "a9" :block/created-at 1 :block/updated-at 1}])
+        (p/let [response (favorite! self beta {:favorite true})
+                new-key (:block/order (last (slots conn)))]
+          (is (= 200 (:status response)) (pr-str response))
+          (is (= [alpha beta] (slot-links conn)))
+          (is (pos? (compare new-key "a9")))
+          (is (= 1 (count (d/datoms @conn :avet :block/order new-key)))))))))
+
+;; The connector generates set_page_favorite from this operation.
+(deftest set-route-and-openapi-test
+  (let [public (semantic-routes/match-public "PUT" "/api/v1/graphs/graph-1/pages/Example/favorite")
+        document (semantic-routes/openapi-document "https://issuer.example")
+        operation (get-in document [:paths "/api/v1/graphs/{graph-id}/pages/{page-id}/favorite" :put])
+        body (get-in operation [:requestBody :content "application/json" :schema])]
+    (is (= ["setPageFavorite" :semantic/pages-favorite "logseq/write" :write "/semantic/pages/:page-id/favorite"]
+           ((juxt :operation-id :handler :scope :rate-class :internal-path) public)))
+    (is (= [{:oauth ["logseq/write"]}] (:security operation)))
+    (is (= ["graph-id" "page-id"] (map :name (:parameters operation))))
+    (is (true? (get-in operation [:requestBody :required])))
+    (is (= ["favorite"] (:required body)))
+    (is (= #{:favorite :dry-run} (set (keys (:properties body)))))
+    (is (false? (:additionalProperties body)))
+    (is (= "#/components/schemas/FavoriteWriteResponse"
+           (get-in operation [:responses "200" :content "application/json" :schema :$ref])))
+    (is (every? #(contains? (:responses operation) %) ["400" "404" "409" "500"]))
+    (is (every? #(string/includes? (:description operation) %)
+                ["bottom" "top" "E2EE" "Recycle bin" "already a favourite" "was not a favourite" "dry-run"]))))
