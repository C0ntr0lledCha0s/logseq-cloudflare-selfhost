+;; Page favourites (patch 0038). The sidebar's Favorites list is the hidden page $$$favorites, whose
+;; children each link one favourite with :block/link (ldb/build-favorite-tx); sibling order is the
+;; list's order. The app's db worker reads and writes it, and deps/db-sync has no copy of that code,
+;; so this reimplements it. The page is found by the deterministic uuid create_graph gives it, never
+;; by name: on an E2EE graph its name is ciphertext, and a page named $$$favorites under another uuid
+;; is not the list the app shows.
+(def ^:private favorites-page-uuid
+  (common-uuid/gen-uuid :builtin-block-uuid common-config/favorites-page-name))
+
+(defn- favorites-page [db]
+  (d/entity db [:block/uuid favorites-page-uuid]))
+
+(defn- favorite-slots
+  "The favourite blocks under $$$favorites in sidebar order; empty when the page is missing."
+  [db]
+  (when-let [page (favorites-page db)]
+    (ldb/sort-by-order (map #(d/entity db (:e %)) (d/datoms db :avet :block/parent (:db/id page))))))
+
+(defn- visible-favorites
+  "The favourites the sidebar shows, in its order, as [{:slot :target}]: a slot counts only when its
+  :block/link names an entity that is neither hidden nor in the Recycle bin, and a later slot
+  linking a target an earlier slot links is left out. Slots left out stay in the graph."
+  [db]
+  (let [seen (volatile! #{})]
+    (into []
+          (keep (fn [slot]
+                  (when-let [target (:block/link slot)]
+                    (when-not (or (entity-util/hidden? target) (contains? @seen (:db/id target)))
+                      (vswap! seen conj (:db/id target))
+                      {:slot slot :target target}))))
+          (favorite-slots db))))
+
+(defn- favorite-response
+  "A favourite named as the other endpoints name a page: its title as stored (ciphertext on an
+  E2EE graph, as listPages returns it) and its kind."
+  [target]
+  {:uuid (uuid-string (:block/uuid target))
+   :title (:block/title target)
+   :kind (title-holder-kind target)})
+
+(defn- favorites-list [db]
+  (mapv (comp favorite-response :target) (visible-favorites db)))
+
+(defn- slots-linking
+  "Every slot under $$$favorites that links `target-id`, hidden duplicates included."
+  [db target-id]
+  (filterv #(= target-id (:db/id (:block/link %))) (favorite-slots db)))
+
+(def ^:private favorite-body-fields #{:favorite :dry-run})
+
+(defn- favorite-body-errors
+  "setPageFavorite's body problems, each naming the field: favorite is required and a boolean,
+  dry-run an optional boolean, and nothing else is taken."
+  [body]
+  (if (and (some? body) (not (map? body)))
+    ["body: give an object with favorite"]
+    (cond-> (mapv #(str (name %) ": not a field; the body takes favorite and dry-run")
+                  (remove favorite-body-fields (keys body)))
+      (not (boolean? (:favorite body))) (conj "favorite: must be true or false")
+      (= ::invalid (dry-run-option body)) (conj "dry-run: must be true or false"))))
+
+(defn- favourite-refusal
+  "Why the entity `page-id` names (`page`, or nil) can't be added as a favourite, as
+  {:status :error}, or nil. Add takes what the app's page menu offers (page_menu.cljs, with
+  frontend.util.entity/page?): a page, journal, tag or property whose :block/name isn't a uuid,
+  built-in ones included while visible. A zoomed-in block, which the app's header menu also offers,
+  is refused: these are page favourites."
+  [page-id page]
+  (let [label (when page (str "page-id: \"" (:block/title page) "\" (" (:block/uuid page) ") "))
+        refuse (fn [reason] {:status 400 :error (str label reason)})
+        missing {:status 404 :error (str "page-id: no page " page-id)}]
+    (cond
+      (nil? page) missing
+      (entity-util/recycled? page) (refuse "is in the Recycle bin")
+      (entity-util/hidden? page) missing
+      (asset? page) (refuse "is an asset")
+      (not (or (page? page) (tag? page) (property? page))) (refuse (str "is " (promotion-kind page) ", not a page"))
+      (parse-uuid (str (:block/name page))) (refuse "has a uuid name"))))
+
+(defn- favorites-page-tx
+  "create_graph's build-favorites-page (private upstream): the hidden built-in page at the fixed uuid."
+  []
+  [(common-util/block-with-timestamps
+    {:block/uuid favorites-page-uuid
+     :block/name common-config/favorites-page-name
+     :block/title common-config/favorites-page-name
+     :block/tags [:logseq.class/Page]
+     :logseq.property/hide? true
+     :logseq.property/built-in? true})])
+
+(defn- favorites-page-conflict
+  "On a graph with no page at the fixed uuid, the 409 when something else holds the name: the
+  handler never writes to a page it didn't expect."
+  [db]
+  (when (and (nil? (favorites-page db))
+             (seq (d/datoms db :avet :block/name common-config/favorites-page-name)))
+    {:status 409 :error "graph has a $$$favorites page with an unexpected uuid; nothing was changed"}))
+
+(defn- ensure-favorites-page!
+  "The favourites page on `conn` (the write's tx-conn), created there when missing."
+  [conn]
+  (or (favorites-page @conn)
+      (do (ldb/transact! conn (favorites-page-tx))
+          (favorites-page @conn))))
+
+(defn- favorite-stored?
+  "Whether `db` holds what the call asked: the target listed after an add, no slot linking it after a
+  remove."
+  [db target-id favorite?]
+  (if favorite?
+    (boolean (some #(= target-id (:db/id (:target %))) (visible-favorites db)))
+    (empty? (slots-linking db target-id))))
+
+(defn- read-back-favorites!
+  "The list as `db` holds it after a write; throws, answered 500 by `rejecting`, when the target's
+  presence isn't what the call asked."
+  [db target-id favorite?]
+  (when-not (favorite-stored? db target-id favorite?)
+    (throw (ex-info "favourite did not read back" {::unverified "favourite did not read back"})))
+  (favorites-list db))
+
+(defn- set-page-favorite!
+  "Adds (at the bottom) or removes (every slot linking it) the favourite `target` on `conn`, the
+  graph or a dry-run copy, in one atomic-write! with one tx id, and returns the list read back.
+  The creator's edit stamp is dropped: a favourite slot is a hidden, empty block."
+  [conn creator dry-run? target favorite?]
+  (let [target-id (:db/id target)
+        result (atomic-write! conn (dissoc creator :stamp?) dry-run? (if favorite? :insert-blocks :delete-blocks)
+                              (fn [tx-conn]
+                                (if favorite?
+                                  (outliner-core/insert-blocks! tx-conn [(ldb/build-favorite-tx (:block/uuid target))]
+                                                                (ensure-favorites-page! tx-conn)
+                                                                {:sibling? false :bottom? true})
+                                  (outliner-core/delete-blocks! tx-conn (slots-linking @tx-conn target-id) {}))
+                                ;; A dry run's answer is read from the copy it wrote to.
+                                (when dry-run? (read-back-favorites! @tx-conn target-id favorite?))))]
+    (if dry-run? result (read-back-favorites! @conn target-id favorite?))))
+
+(defn- handle-favorites [{:keys [^js self request conn db handler path-params e2ee? creator]}]
+  (case handler
+    :semantic/favorites-list
+    (http/json-response nil {:favorites (favorites-list db)})
+
+    :semantic/pages-favorite
+    (if e2ee?
+      ;; Before anything is read: the favourites page's name and its slots' titles are encrypted.
+      (http/bad-request "favourites can't be changed on E2EE graphs; the favourites page and its blocks are encrypted")
+      (p/let [body (body-clj request)]
+        (let [page-id (:page-id path-params)
+              body-errors (favorite-body-errors body)
+              favorite? (:favorite body)
+              selected (when (empty? body-errors)
+                         (resolve-page-selector db page-id "page-id" {:find find-entity}))
+              target (:ok selected)
+              refusal (cond
+                        (seq body-errors) {:status 400 :error (string/join "; " body-errors)}
+                        (:error selected) selected
+                        favorite? (favourite-refusal page-id target)
+                        (nil? target) {:status 404 :error (str "page-id: no page " page-id)})
+              noop (when-not refusal
+                     (if favorite?
+                       (when (favorite-stored? db (:db/id target) true) "already a favourite")
+                       (when (empty? (slots-linking db (:db/id target))) "was not a favourite")))
+              conflict (when (and (not refusal) (not noop) favorite?) (favorites-page-conflict db))
+              dry-run? (true? (:dry-run body))]
+          (cond
+            refusal (selector-refusal refusal)
+            conflict (selector-refusal conflict)
+            noop (http/json-response nil (cond-> {:result noop :page (favorite-response target) :favorites (favorites-list db)}
+                                           dry-run? (assoc :dry-run true)))
+            :else
+            (rejecting
+             #(let [favorites (set-page-favorite! conn creator dry-run? target favorite?)]
+                (when-not dry-run? (broadcast-change! self))
+                (http/json-response nil (cond-> {:result (if favorite? "added" "removed")
+                                                 :page (favorite-response target)
+                                                 :favorites favorites}
+                                          dry-run? (assoc :dry-run true)))))))))))
+
+(def ^:private favorite-handlers
+  #{:semantic/favorites-list :semantic/pages-favorite})
+
 (def ^:private page-handlers
   #{:semantic/pages-list :semantic/pages-create :semantic/pages-blocks :semantic/pages-outline
     :semantic/pages-references :semantic/pages-get
@@ -5209,6 +5393,7 @@
