+;; Spec section 8 item 1, review focus 7 and 8: a new favourite goes after the last one, under
+;; $$$favorites, whatever the graph's max key; one transaction, one tx id.
+(deftest add-appends-at-bottom-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self alpha beta gamma delta]}]
+        (add-favourites! conn [alpha beta gamma])
+        ;; The graph's max order key sits on an ordinary page's block.
+        (d/transact! conn [{:block/uuid (random-uuid) :block/title "Late" :block/page [:block/uuid delta]
+                            :block/parent [:block/uuid delta] :block/order "a5"
+                            :block/created-at 1 :block/updated-at 1}])
+        (let [stop (record-reports! conn)]
+          (p/let [response (favorite! self delta {:favorite true})
+                  reports (stop)
+                  keys (mapv :block/order (slots conn))
+                  new-key (last keys)]
+            (is (= 200 (:status response)) (pr-str response))
+            (is (= {:result "added"
+                    :page {:uuid (str delta) :title "Delta" :kind "page"}
