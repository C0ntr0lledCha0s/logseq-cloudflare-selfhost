+;; Inline tags follow the editor's boundaries: `#` starts a tag after the line start, whitespace or
+;; `(`, and trailing `,` `.` `)` are punctuation, not part of the name.
+(def ^:private inline-tag-re #"(?:^|[\s(])#(?:\[\[([^\]]+)\]\]|([^\s\[\]()#,]+))")
+
+(defn- inline-tag-names [title]
+  (->> (re-seq inline-tag-re title)
+       (keep (fn [[_ bracketed bare]]
+               (let [name (or bracketed (string/replace bare #"[.)]+$" ""))]
+                 (when-not (or (string/blank? name) (common-util/uuid-string? name))
+                   name))))
+       distinct))
+
+(defn- resolve-inline-class
+  "The one class an inline tag names: an exact title match, else a unique case-insensitive one.
+  Classes Logseq refuses as inline tags (page, property and other built-in kinds) never match."
+  [db name]
+  (let [classes (fn [datoms]
+                  (->> datoms
+                       (map #(d/entity db (:e %)))
+                       (filter tag?)
+                       (remove #(contains? db-class/disallowed-inline-tags (:db/ident %)))))
+        exact (classes (d/datoms db :avet :block/title name))
+        candidates (if (seq exact) exact (classes (d/datoms db :avet :block/name (string/lower-case name))))]
+    (when (= 1 (count candidates))
+      (first candidates))))
+
+(defn- replace-inline-tag [title name id]
+  (let [tag (common-util/escape-regex-chars name)
+        bracketed (common-util/escape-regex-chars (page-ref/->page-ref name))]
+    (string/replace title
+                    (re-pattern (str "(^|[\\s(])#(?:" bracketed "|" tag "(?=[,.)]*(?:$|[\\s)])))"))
+                    (fn [[_ lhs]] (str lhs "#" (page-ref/->page-ref id))))))
+
+(defn- resolve-inline-tags
+  "Rewrites inline tags that name an existing class to `#[[uuid]]`, as the editor stores them,
+  and returns those classes. Any other `#word` (an issue number, a URL fragment, an unknown
+  name) stays plain text."
+  [db title]
+  (reduce (fn [result name]
+            (if-let [class (resolve-inline-class db name)]
+              (-> result
+                  (update :title replace-inline-tag name (:block/uuid class))
+                  (update :classes conj class))
+              result))
+          {:title title :classes []}
+          (inline-tag-names title)))
+
 (defn- prepare-block-title! [conn e2ee? title]
   ;; E2EE titles are opaque ciphertext packages — they contain no resolvable
   ;; [[refs]] (and transit punctuation must never be parsed as refs).
   (if e2ee?
     {:block/title title}
-    (let [refs (->> (page-ref-values title)
+    (let [{:keys [title classes]} (resolve-inline-tags @conn title)
+          refs (->> (page-ref-values title)
                   (keep #(resolve-page-ref! conn %))
                   (reduce (fn [result ref]
                             (assoc result (:block/uuid ref) ref)) {})
                   vals
                   vec)]
-      {:block/title (db-content/title-ref->id-ref title refs :replace-tag? false)
-       :block/refs (mapv #(vector :block/uuid (:block/uuid %)) refs)})))
+      (cond-> {:block/title (db-content/title-ref->id-ref title refs :replace-tag? false)
+               :block/refs (mapv #(vector :block/uuid (:block/uuid %)) refs)}
+        (seq classes) (assoc :block/tags (mapv #(vector :block/uuid (:block/uuid %)) (distinct classes)))))))
 
