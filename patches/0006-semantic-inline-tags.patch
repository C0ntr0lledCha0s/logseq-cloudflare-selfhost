+(deftest semantic-inline-tags-resolve-to-existing-classes-test
+  (async done
+    (with-tree-identity-test done
+      (fn [{:keys [conn page-id request self]}]
+        (let [decision-id (random-uuid)
+              meeting-id (random-uuid)
+              _ (d/transact! conn [{:db/ident :user.class/Decision :block/uuid decision-id
+                                    :block/name "decision" :block/title "Decision"
+                                    :block/tags :logseq.class/Tag}
+                                   {:db/ident :user.class/BusinessMeeting :block/uuid meeting-id
+                                    :block/name "business meeting" :block/title "Business Meeting"
+                                    :block/tags :logseq.class/Tag}])
+              ids (vec (repeatedly 5 random-uuid))
+              titles ["Chose Postgres #Decision"
+                      "Notes #[[Business Meeting]] and #Decision."
+                      "Connector #7, see https://example.com/#frag and C# #Unknown"
+                      "Lower case #decision"
+                      "Not inline #Page"]
+              tags-of (fn [id] (set (map :block/uuid (:block/tags (d/entity @conn [:block/uuid id])))))
+              ;; :block/raw-title is the stored text; :block/title renders id refs back as names
+              title-of (fn [id] (:block/raw-title (d/entity @conn [:block/uuid id])))
+              ref-of (fn [id] (str "#" (page-ref/->page-ref id)))]
+          (p/let [response (request {:target-id (str page-id)
+                                     :blocks (mapv (fn [id title] {:uuid (str id) :title title}) ids titles)})
+                  _ (is (= 201 (.-status response)))
+                  _ (is (= #{decision-id} (tags-of (ids 0))))
+                  _ (is (= (str "Chose Postgres " (ref-of decision-id)) (title-of (ids 0))))
+                  _ (is (= #{decision-id meeting-id} (tags-of (ids 1))))
+                  _ (is (= (str "Notes " (ref-of meeting-id) " and " (ref-of decision-id) ".") (title-of (ids 1))))
+                  _ (is (empty? (tags-of (ids 2))) "issue numbers, URL fragments and unknown names stay text")
+                  _ (is (= (titles 2) (title-of (ids 2))))
+                  _ (is (= #{decision-id} (tags-of (ids 3))) "a unique case-insensitive match resolves")
+                  _ (is (empty? (tags-of (ids 4))) "built-in classes Logseq disallows inline are not applied")
+                  _ (is (= (titles 4) (title-of (ids 4))))
+                  update-response (sync-handler/handle-http
+                                   self
+                                   (semantic-json-request (str "/semantic/blocks/" (ids 2) "?graph-id=graph-1")
+                                                          "PATCH" {:title "Now a #Decision"}))]
+            (is (= 200 (.-status update-response)))
+            (is (= #{decision-id} (tags-of (ids 2))))
+            (is (= (str "Now a " (ref-of decision-id)) (title-of (ids 2))))))))))
