+(defn- key-value-content
+  "LC-139: what value `v` of `property` reads as: a value block's own value (a number, text or URL,
+  as the outliner stores them under :logseq.property/value, else its title), another entity's
+  {:uuid :title}, or a scalar as stored."
+  [db v]
+  (if-let [e (when (integer? v) (d/entity db v))]
+    (if (:logseq.property/created-from-property e)
+      (let [value (:logseq.property/value e)] (if (some? value) value (:block/title e)))
+      {:uuid (uuid-string (:block/uuid e)) :title (:block/title e)})
+    v))
+
+(defn- key-sort-key
+  "A sort key for a key value: numbers in numeric order (zero-padded), others as lower-case text."
+  [value]
+  (cond
+    (number? value) (.padStart (str value) 24 "0")
+    (map? value) (string/lower-case (str (:title value) " " (:uuid value)))
+    :else (string/lower-case (str value))))
+
+(defn- property-holders
+  "Each visible holder of `property` that isn't in `private`, with its values' contents, in index order."
+  [db property private]
+  (let [by-holder (reduce (fn [acc datom]
+                            (if (contains? private (:e datom))
+                              acc
+                              (update acc (:e datom) (fnil conj []) (key-value-content db (:v datom)))))
+                          (array-map) (d/datoms db :aevt (:db/ident property)))]
+    (keep (fn [[e values]]
+            (let [holder (d/entity db e)]
+              (when-not (entity-util/hidden? holder) [holder values])))
+          by-holder)))
+
+(defn- title-starts-with-key?
+  "Whether `title` starts with `key` as a whole key: LC-10 isn't the key LC-1."
