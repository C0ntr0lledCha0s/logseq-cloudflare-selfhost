+(ns logseq.db-sync.semantic-graph-health-keys-test
+  "getGraphHealth's key checks (LC-139). duplicate-values lists each value of property that more
+  than one block or page holds, with the holders; title-key-mismatch lists the holders of property
+  whose title doesn't start with key-prefix and the value, as an item key such as LC-104 should.
+  Both are opt-in and need property; key-prefix is title-key-mismatch's alone. Private content is
+  left out, as in every check."
+  (:require [cljs.test :refer [async deftest is testing]]
+            [clojure.string :as string]
+            [datascript.core :as d]
+            [logseq.db-sync.test-sql :as test-sql]
+            [logseq.db-sync.worker.handler.sync :as sync-handler]
+            [logseq.db.sqlite.export :as sqlite-export]
+            [logseq.outliner.page :as outliner-page]
+            [promesa.core :as p]))
+
+(defn- request!
+  [self method path body]
+  (p/let [url (str "http://localhost" path (if (string/includes? path "?") "&" "?") "graph-id=graph-1")
+          response (sync-handler/handle-http
+                    self
+                    (js/Request. url (clj->js (cond-> {:method method
+                                                       :headers {"content-type" "application/json"}}
+                                                (some? body) (assoc :body (js/JSON.stringify (clj->js body)))))))
+          text (.text response)]
+    {:status (.-status response)
+     :body (when (seq text)
+             (try (js->clj (js/JSON.parse text) :keywordize-keys true)
+                  (catch :default _ text)))}))
+
+(defn- ok! [response status]
+  (p/let [response response]
+    (is (= status (:status response)) (pr-str response))
+    response))
+
+(defn- with-items
+  "Blocks holding itemNumber: LC-1 (1), LC-2 (2), LC-3 (2: a duplicate, and its key disagrees),
+  LC-10 (1: a duplicate, and LC-10 is not the key LC-1), LC-7 tagged Private (2), and a block
+  with no itemNumber."
+  [done run]
+  (-> (p/let [conn (sqlite-export/create-conn)
+              [_ page-id] (outliner-page/create! conn "Keys" {})
+              self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true}
+              _ (ok! (request! self "POST" "/semantic/tags" {:title "Private"}) 201)
+              _ (ok! (request! self "POST" "/semantic/properties" {:title "itemNumber" :type "number"}) 201)
+              item (fn [title n & tags] {:title title :properties (cond-> {"itemNumber" n} (seq tags) (assoc "Tags" (vec tags)))})
+              _ (ok! (request! self "POST" "/semantic/block-trees"
+                               {:target-id (str page-id)
+                                :blocks [(item "LC-1: one" 1) (item "LC-2: two" 2) (item "LC-3: three" 2)
+                                         (item "LC-10: ten" 1) (item "LC-7: secret" 2 "Private") {:title "no number"}]})
+                     201)
+              uuid-of (fn [title] (str (:block/uuid (d/entity @conn (ffirst (d/q '[:find ?b :in $ ?t :where [?b :block/title ?t]] @conn title))))))]
+        (run {:self self :uuid-of uuid-of}))
+      (p/catch #(is false (str "unexpected error: " %)))
+      (p/finally done)))
+
+(defn- health! [self query]
+  (request! self "GET" (str "/semantic/health?" query) nil))
+
+(deftest duplicate-values-groups-the-holders-of-a-shared-value-test
+  (async done
+    (with-items done
+      (fn [{:keys [self uuid-of]}]
+        (p/let [response (health! self "checks=duplicate-values&property=itemNumber")
+                check (get-in response [:body :checks :duplicate-values])]
+          (is (= 200 (:status response)) (pr-str (:body response)))
+          (is (= 2 (:count check)) "two values are shared: 1 and 2")
+          (is (= [[1 #{(uuid-of "LC-1: one") (uuid-of "LC-10: ten")}]
+                  [2 #{(uuid-of "LC-2: two") (uuid-of "LC-3: three")}]]
+                 (mapv (fn [{:keys [value holders]}] [value (set (map :uuid holders))]) (:items check)))
+              "a private holder is left out")
+          (is (= "itemNumber" (get-in check [:property :title])) "the result names the property it checked")
+          (is (string/starts-with? (get-in check [:property :ident]) "user.property/itemNumber")))))))
+
+(deftest title-key-mismatch-lists-titles-that-disagree-test
+  (async done
+    (with-items done
+      (fn [{:keys [self uuid-of]}]
+        (p/let [response (health! self "checks=title-key-mismatch&property=itemNumber&key-prefix=LC-")
+                check (get-in response [:body :checks :title-key-mismatch])]
+          (is (= 200 (:status response)) (pr-str (:body response)))
+          (is (= #{[(uuid-of "LC-3: three") 2 "LC-2"] [(uuid-of "LC-10: ten") 1 "LC-1"]}
+                 (set (map (juxt :uuid :value :expected) (:items check))))
+              "LC-10 doesn't count as LC-1, and the block with no number isn't a holder")
+          (is (= 2 (:count check))))))))
+
+(deftest key-checks-parameters-are-checked-test
+  (async done
+    (with-items done
+      (fn [{:keys [self]}]
+        (p/let [responses (p/all (map #(health! self %)
+                                      ["checks=duplicate-values"
+                                       "checks=title-key-mismatch&property=itemNumber"
+                                       "checks=duplicate-values&property=noSuchProperty"
+                                       "checks=orphan-tags&property=itemNumber"
+                                       "checks=duplicate-values&property=itemNumber&key-prefix=LC-"]))]
+          (doseq [[expected {:keys [status body]}] (map vector
+                                                        ["duplicate-values needs property"
+                                                         "title-key-mismatch needs key-prefix"
+                                                         "property: no property"
+                                                         "property needs the duplicate-values or title-key-mismatch check"
+                                                         "key-prefix needs the title-key-mismatch check"]
+                                                        responses)]
+            (is (= 400 status) (str expected ": " (pr-str body)))
+            (is (string/includes? (str (:error body)) expected) (pr-str body))))))))
+
+(deftest key-checks-are-opt-in-test
+  (async done
+    (with-items done
+      (fn [{:keys [self]}]
+        (p/let [response (health! self "")]
+          (is (= 200 (:status response)))
+          (is (not-any? #{:duplicate-values :title-key-mismatch} (keys (get-in response [:body :checks])))))))))
