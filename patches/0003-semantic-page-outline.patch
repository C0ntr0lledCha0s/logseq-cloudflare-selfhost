+(deftest semantic-get-page-outline-renders-resolved-markdown-test
+  (async done
+         (with-memory-sql-async
+           (fn [sql]
+             (storage/init-schema! sql)
+             (let [conn (sqlite-export/create-conn)
+                   author-id (random-uuid)
+                   page-id (random-uuid)
+                   fantasy-id (random-uuid)
+                   {:keys [init-tx block-props-tx]}
+                   (sqlite-build/build-blocks-tx
+                    {:properties {:user.property/genre {:logseq.property/type :default
+                                                        :db/cardinality :db.cardinality/many
+                                                        :build/closed-values [{:value "Fantasy" :uuid fantasy-id}]}}
+                     :classes {:user.class/Book {}}
+                     :pages-and-blocks
+                     [{:page {:block/title "Brandon Sanderson" :block/uuid author-id :build/keep-uuid? true}}
+                      {:page {:block/title "Sunlit Man" :block/uuid page-id :build/keep-uuid? true
+                              :build/tags [:user.class/Book]
+                              :build/properties {:user.property/genre #{[:block/uuid fantasy-id]}}}
+                       :blocks [{:block/title (str "Written by [[" author-id "]]")
+                                 :build/children [{:block/title "Nested note"
+                                                   :build/properties {:user.property/genre #{[:block/uuid fantasy-id]}}}]}
+                                {:block/title "Finish the book"
+                                 :build/properties {:logseq.property/status :logseq.property/status.doing}}]}]})
+                   _ (d/transact! conn init-tx)
+                   _ (d/transact! conn block-props-tx)
+                   self #js {:sql sql :conn conn :schema-ready true}]
+               (-> (p/let [response (sync-handler/handle-http
+                                     self (semantic-json-request (str "/semantic/pages/" page-id "/outline?graph-id=graph-1") "GET" nil))
+                            body (json-body response)
+                            not-page (sync-handler/handle-http
+                                      self (semantic-json-request (str "/semantic/pages/" (random-uuid) "/outline?graph-id=graph-1") "GET" nil))]
+                     (is (= 200 (.-status response)))
+                     (is (= 404 (.-status not-page)))
+                     (is (= "Sunlit Man" (:title body)))
+                     (is (some #(= "user.class/Book" (:ident %)) (:tags body)))
+                     (is (= "user.property/genre" (:ident (first (:properties body)))))
+                     (is (= (string/join "\n" ["- Written by [[Brandon Sanderson]]"
+                                                "  - Nested note"
+                                                "    genre:: [[Fantasy]]"
+                                                "- [Doing] Finish the book"])
+                            (:markdown body)))
+                     (is (= 3 (:block-count body)))
+                     (is (false? (:truncated body))))
+                   (p/then (fn [] (done)))
+                   (p/catch (fn [error]
+                              (is false (str error))
+                              (done)))))))))
