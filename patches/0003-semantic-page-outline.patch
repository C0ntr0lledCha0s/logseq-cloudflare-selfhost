+;; getPageOutline renders a page's whole block tree as a markdown outline with id refs resolved
+;; to titles, so an agent can read a page in one call.
+(def ^:private max-outline-blocks 2000)
+
+(defn- outline-property-lines [db entity indent]
+  (for [{:keys [title value]} (entity-properties-response db entity)
+        :let [values (if (vector? value) value [value])
+              text (string/join ", " (map #(if (map? %) (page-ref/->page-ref (:title %)) (str %)) values))]]
+    (str indent "  " title ":: " text)))
+
+(defn- outline-children [db entity]
+  (->> (:block/_parent entity)
+       (remove entity-util/hidden?)
+       (sort-by :block/order)))
+
+(defn- page-outline [db page]
+  (let [lines (transient [])
+        n (volatile! 0)
+        truncated? (volatile! false)]
+    (letfn [(walk [entity depth]
+              (doseq [block (outline-children db entity)]
+                (if (>= @n max-outline-blocks)
+                  (vreset! truncated? true)
+                  (let [indent (apply str (repeat depth "  "))
+                        status (some-> (:logseq.property/status block) :block/title)
+                        title (or (db-content/recur-replace-uuid-in-block-title block) "")]
+                    (vswap! n inc)
+                    (conj! lines (str indent "- " (when status (str "[" status "] ")) title))
+                    (doseq [line (outline-property-lines db block indent)] (conj! lines line))
+                    (walk block (inc depth))))))]
+      (walk page 0))
+    {:markdown (string/join "\n" (persistent! lines))
+     :block-count @n
+     :truncated @truncated?}))
+
 (defn- non-blank-string? [v]
   (and (string? v) (seq v)))
 
