+;; getPage and getBlock also return the entity's tags and its user and library property values
+;; (e.g. schema.property/genre). Built-in logseq.* properties and DB attributes are left out.
+(defn- property-value-response
+  "Text and number values (value blocks) become their content. References to pages, nodes and
+  choices become {uuid title ident?}."
+  [value]
+  (cond
+    (not (de/entity? value)) value
+    (and (:logseq.property/created-from-property value) (not (:block/closed-value-property value)))
+    (db-property/property-value-content value)
+    :else (cond-> {:uuid (uuid-string (:block/uuid value))
+                   :title (db-property/property-value-content value)}
+            (:db/ident value) (assoc :ident (entity-ident value)))))
+
+(defn- entity-properties-response [db entity]
+  (->> (db-property/properties entity)
+       (remove (fn [[k _]] (db-property/internal-property? k)))
+       (sort-by (fn [[k _]] (str k)))
+       (mapv (fn [[k v]]
+               (let [property (d/entity db k)]
+                 {:ident (str (namespace k) "/" (name k))
+                  :title (:block/title property)
+                  :type (some-> (:logseq.property/type property) name)
+                  :value (if (set? v)
+                           (mapv property-value-response (sort-by #(or (:block/order %) (:db/id %)) v))
+                           (property-value-response v))})))))
+
+(defn- block-detail-response [db entity]
+  (cond-> (block-response entity)
+    (seq (:block/tags entity)) (assoc :tags (mapv tag-response (sort-by :db/id (:block/tags entity))))
+    true (assoc :properties (entity-properties-response db entity))))
+
 (defn- entities-by-avet [db attribute & [value]]
   (->> (if (some? value)
          (d/datoms db :avet attribute value)
