+(deftest semantic-get-page-and-block-return-tags-and-properties-test
+  (async done
+         (with-memory-sql-async
+           (fn [sql]
+             (storage/init-schema! sql)
+             (let [conn (sqlite-export/create-conn)
+                   author-id (random-uuid)
+                   page-id (random-uuid)
+                   block-id (random-uuid)
+                   fantasy-id (random-uuid)
+                   mystery-id (random-uuid)
+                   {:keys [init-tx block-props-tx]}
+                   (sqlite-build/build-blocks-tx
+                     {:properties {:user.property/genre {:logseq.property/type :default
+                                                         :db/cardinality :db.cardinality/many
+                                                         :build/closed-values [{:value "Fantasy" :uuid fantasy-id}
+                                                                               {:value "Mystery" :uuid mystery-id}]}
+                                   :user.property/author {:logseq.property/type :node}
+                                   :user.property/pages {:logseq.property/type :number}}
+                      :classes {:user.class/Book {}}
+                      :pages-and-blocks
+                      [{:page {:block/title "Brandon Sanderson" :block/uuid author-id :build/keep-uuid? true}}
+                       {:page {:block/title "Sunlit Man" :block/uuid page-id :build/keep-uuid? true
+                               :build/tags [:user.class/Book]
+                               :build/properties {:user.property/genre #{[:block/uuid fantasy-id]}
+                                                  :user.property/author [:block/uuid author-id]
+                                                  :user.property/pages 400}}
+                        :blocks [{:block/title "A note" :block/uuid block-id :build/keep-uuid? true
+                                  :build/properties {:user.property/genre #{[:block/uuid mystery-id]}}}]}]})
+                   _ (d/transact! conn init-tx)
+                   _ (d/transact! conn block-props-tx)
+                   self #js {:sql sql :conn conn :schema-ready true}]
+               (-> (p/let [page-response (sync-handler/handle-http
+                                          self (semantic-json-request (str "/semantic/pages/" page-id "?graph-id=graph-1") "GET" nil))
+                            page-body (json-body page-response)
+                            block-response (sync-handler/handle-http
+                                            self (semantic-json-request (str "/semantic/blocks/" block-id "?graph-id=graph-1") "GET" nil))
+                            block-body (json-body block-response)
+                            by-ident (fn [body] (into {} (map (juxt :ident identity)) (:properties body)))
+                            page-props (by-ident page-body)]
+                     (is (= [200 200] [(.-status page-response) (.-status block-response)]))
+                     (is (= "Sunlit Man" (:title page-body)))
+                     (is (some #(= "user.class/Book" (:ident %)) (:tags page-body)) "page tags include Book")
+                     (is (= #{"user.property/author" "user.property/genre" "user.property/pages"} (set (keys page-props)))
+                         "only user properties, no built-ins")
+                     (is (= [{:uuid (str fantasy-id) :title "Fantasy"}] (get-in page-props ["user.property/genre" :value]))
+                         "choices are returned as references")
+                     (is (= {:uuid (str author-id) :title "Brandon Sanderson"}
+                            (get-in page-props ["user.property/author" :value])))
+                     (is (= "node" (get-in page-props ["user.property/author" :type])))
+                     (is (= 400 (get-in page-props ["user.property/pages" :value])))
+                     (is (= ["Mystery"] (mapv :title (get-in (by-ident block-body) ["user.property/genre" :value]))))
+                     (is (= (str page-id) (:page-id block-body))))
+                   (p/then (fn [] (done)))
+                   (p/catch (fn [error]
+                              (is false (str error))
+                              (done)))))))))
