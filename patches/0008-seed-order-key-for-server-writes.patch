+(deftest get-max-order-reads-only-order-datoms
+  (let [conn (d/create-conn {:block/order {:db/index true}
+                             :block/name {:db/index true}})]
+    (d/transact! conn [{:block/name "日本語ページ"}])
+    (is (nil? (db-order/get-max-order @conn))
+        "no ordered blocks means no max order, not another attribute's value")
+    (d/transact! conn [{:block/order "a0"} {:block/order "a1"}])
+    (is (= "a1" (db-order/get-max-order @conn)))))
