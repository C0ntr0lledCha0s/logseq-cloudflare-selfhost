+(deftest semantic-writes-never-reuse-an-existing-order-key-test
+  (async done
+    (run-text-property-test! done :db.cardinality/one
+      (fn [{:keys [conn self property page-id]}]
+        ;; A fresh Worker isolate starts with no max order key, while the graph already has
+        ;; blocks ordered "a0" and "a1". The URL-test page holds two such blocks.
+        (reset! db-order/*max-key nil)
+        (p/let [response (sync-handler/handle-http
+                          self
+                          (semantic-json-request
+                           (str "/semantic/blocks/" page-id "/properties/" (:block/uuid property) "?graph-id=graph-1")
+                           "PUT" {:value "Page description"}))
+                _ (is (= 200 (.-status response)))
+                page (d/entity @conn [:block/uuid page-id])
+                ;; Read children from datoms: the entity API leaves property value blocks out of
+                ;; :block/_parent, but they share the order space with the page's other children.
+                orders (map second (d/q '[:find ?child ?order :in $ ?page
+                                          :where [?child :block/parent ?page] [?child :block/order ?order]]
+                                        @conn (:db/id page)))]
+          (is (= 3 (count orders)))
+          (is (= (count orders) (count (distinct orders)))
+              "the new value block gets an order key no sibling already has"))))))
diff --git a/deps/db/src/logseq/db/common/order.cljs b/deps/db/src/logseq/db/common/order.cljs
index 5642c92878..38fdbbe5f2 100644
--- a/deps/db/src/logseq/db/common/order.cljs
+++ b/deps/db/src/logseq/db/common/order.cljs
@@ -28,7 +28,11 @@
 
 (defn get-max-order
   [db]
-  (:v (first (d/rseek-datoms db :avet :block/order))))
+  ;; rseek walks back past the start of the :block/order range, so with no ordered blocks the
+  ;; first datom belongs to another attribute.
+  (let [datom (first (d/rseek-datoms db :avet :block/order))]
+    (when (= :block/order (:a datom))
+      (:v datom))))
 
 (defn gen-n-keys
   [n start end & {:keys [max-key-atom]
