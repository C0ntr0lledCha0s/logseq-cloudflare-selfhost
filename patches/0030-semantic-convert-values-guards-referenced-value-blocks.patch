+    (referenced-conversion! done "a ((ref)) in a block's title"
+                            ;; The app stores a ((ref)) as the title text and a :block/refs datom.
+                            (fn [{:keys [conn]} referrer value]
+                              (d/transact! conn [{:db/id (:db/id (entity conn referrer))
+                                                  :block/title (str "See ((" value "))")
+                                                  :block/refs [(:db/id (entity conn value))]}])
+                              {:status 200}))))
