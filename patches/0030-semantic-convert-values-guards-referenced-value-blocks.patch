+(deftest convert-values-holders-are-not-references-test
+  ;; Two holders of one value block through phase itself, and a holder of its own value: nothing
+  ;; refers to a value block from outside, so the counts are 0 and no flag is needed.
+  (async done
+    (with-choices done
+      (fn [{:keys [conn self phase blocks]}]
+        (let [[b0 b1 b2] blocks]
+          (p/let [_ (hold! self b0 phase "Active")
+                  _ (hold! self b1 phase "Done")
+                  _ (d/transact! conn [[:db/add (:db/id (entity conn b2)) phase (:db/id (get (entity conn b0) phase))]])
+                  before (snapshot conn)
+                  body {:choices {:add [{:title "Active"} {:title "Done"}]}}
+                  dry (convert! self phase body "dry-run=true")
+                  after-dry (snapshot conn)
+                  real (convert! self phase body)
+                  active (choice-uuid conn phase "Active")
+                  done-id (choice-uuid conn phase "Done")]
+            (is (= 200 (:status dry)) (str (:body dry)))
+            (is (= 2 (get-in dry [:body :converted :deleted])))
+            (is (= 0 (get-in dry [:body :converted :referenced])) "a holder's own value is not a reference")
+            (is (true? (= before after-dry)))
+            (is (= 200 (:status real)) (str "no flag is needed: " (:body real)))
+            (is (= [active done-id active] (mapv #(stored conn % phase) [b0 b1 b2])))))))))
+
+(deftest convert-values-referenced-and-held-retire-names-both-flags-test
+  ;; A call that retires a held choice and deletes a referenced value block needs both flags; the
+  ;; refusal names both, and one flag alone is still refused.
+  (async done
+    (with-choices done
+      (fn [{:keys [conn self phase blocks]}]
+        (let [[b0 b1 b2] blocks]
+          (p/let [_ (hold! self b0 phase "Active")
+                  v0 (stored conn b0 phase)
+                  paused (add-choice! conn phase "Paused")
+                  _ (d/transact! conn [[:db/add (:db/id (entity conn b1)) phase (:db/id (entity conn paused))]])
+                  _ (d/transact! conn [{:db/id (:db/id (entity conn b2))
+                                        :block/title (str "See ((" v0 "))")
+                                        :block/refs [(:db/id (entity conn v0))]}])
+                  before (snapshot conn)
+                  body {:choices {:add [{:title "Active"}] :retire ["Paused"]}}
+                  neither (convert! self phase body)
+                  holders-only (convert! self phase body "acknowledge-holders=true")
+                  references-only (convert! self phase body "acknowledge-references=true")
+                  after (snapshot conn)
+                  both (convert! self phase body "acknowledge-holders=true&acknowledge-references=true")]
+            (is (= 409 (:status neither)) (str (:body neither)))
+            (is (string/includes? (str (get-in neither [:body :error])) "acknowledge-holders"))
+            (is (string/includes? (str (get-in neither [:body :error])) "acknowledge-references"))
+            (is (= 409 (:status holders-only)) (str (:body holders-only)))
+            (is (string/includes? (str (get-in holders-only [:body :error])) "acknowledge-references"))
+            (is (= 409 (:status references-only)) (str (:body references-only)))
+            (is (string/includes? (str (get-in references-only [:body :error])) "acknowledge-holders"))
+            (is (true? (= before after)) "no refused call wrote anything")
+            (is (= 200 (:status both)) (str (:body both)))
+            (is (nil? (entity conn v0)))))))))
+
+(deftest convert-values-holder-linking-its-own-value-is-a-reference-test
+  ;; Only the converted property's own attribute is left out: a holder that also links to its value
+  ;; block in its title loses that link to the delete, so it counts.
+  (async done
+    (with-choices done
+      (fn [{:keys [conn self phase blocks]}]
+        (let [[b0] blocks]
+          (p/let [_ (hold! self b0 phase "Active")
+                  v0 (stored conn b0 phase)
+                  _ (d/transact! conn [{:db/id (:db/id (entity conn b0))
+                                        :block/title (str "See [[" v0 "]]")
+                                        :block/refs [(:db/id (entity conn v0))]}])
+                  dry (convert! self phase {:choices {:add [{:title "Active"}]}} "dry-run=true")
+                  refused (convert! self phase {:choices {:add [{:title "Active"}]}})]
+            (is (= {:values 1 :holders 1 :deleted 1 :referenced 1} (get-in dry [:body :converted])))
+            (is (= 409 (:status refused)) (str (:body refused)))
+            (is (string/includes? (str (get-in refused [:body :error])) (str b0)))
+            (is (= {:values 1 :holders 1 :deleted 1 :referenced 1} (get-in refused [:body :converted]))
+                "the refusal carries the counts")
+            (is (some? (entity conn v0)))))))))
+
+(deftest convert-values-value-blocks-referring-to-each-other-test
+  ;; A reference from one deleted value block to another is lost with both, so it isn't counted.
+  (async done
+    (with-choices done
+      (fn [{:keys [conn self phase blocks]}]
+        (let [[b0 b1] blocks]
+          (p/let [_ (hold! self b0 phase "Active")
+                  _ (hold! self b1 phase "Done")
+                  v0 (stored conn b0 phase)
+                  v1 (stored conn b1 phase)
+                  _ (d/transact! conn [[:db/add (:db/id (entity conn v1)) :block/refs (:db/id (entity conn v0))]])
+                  body {:choices {:add [{:title "Active"} {:title "Done"}]}}
+                  dry (convert! self phase body "dry-run=true")
+                  real (convert! self phase body)]
+            (is (= 0 (get-in dry [:body :converted :referenced])) (str (:body dry)))
+            (is (= 200 (:status real)) (str (:body real)))
+            (is (nil? (entity conn v0)))
+            (is (nil? (entity conn v1)))))))))
+
+(deftest convert-values-referenced-message-counts-test
+  ;; Two referenced value blocks and six referrers: the plurals, and the first five referrers named
+  ;; with the rest counted.
+  (async done
+    (with-choices done
+      (fn [{:keys [conn self phase blocks]}]
+        (let [[b0 b1 & others] blocks
+              referrers (take 6 others)]
+          (p/let [_ (hold! self b0 phase "Active")
+                  _ (hold! self b1 phase "Done")
+                  v0 (stored conn b0 phase)
+                  v1 (stored conn b1 phase)
+                  _ (d/transact! conn (map-indexed (fn [i referrer]
+                                                     [:db/add (:db/id (entity conn referrer)) :block/refs
+                                                      (:db/id (entity conn (if (even? i) v0 v1)))])
+                                                   referrers))
+                  refused (convert! self phase {:choices {:add [{:title "Active"} {:title "Done"}]}})
+                  error (str (get-in refused [:body :error]))
+                  named (filter #(string/includes? error (str %)) referrers)]
+            (is (= 409 (:status refused)) error)
+            (is (string/includes? error "phase: 2 value blocks (of 2 to delete) are referenced by 6 blocks or pages: ") error)
+            (is (= 5 (count named)) "five referrers are named")
+            (is (string/includes? error " and 1 more;") error)))))))
