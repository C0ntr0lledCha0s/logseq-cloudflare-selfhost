+    (fn [{:keys [conn self phase blocks] :as graph}]
+      (let [[b0 b1 b2] blocks]
+        (p/let [_ (hold! self b0 phase "Active")
+                _ (hold! self b1 phase "Active")
+                v0 (stored conn b0 phase)
+                v1 (stored conn b1 phase)
+                referred (refer! graph b2 v0)
+                before (snapshot conn)
+                body {:choices {:add [{:title "Active"}]}}
+                dry (convert! self phase body "dry-run=true")
+                after-dry (snapshot conn)
+                refused (convert! self phase body)
+                after-refused (snapshot conn)
+                kept (some? (entity conn v0))
+                added (choice-uuid conn phase "Active")
+                acked (convert! self phase body "acknowledge-references=true")
+                active (choice-uuid conn phase "Active")
+                reads (p/all (map #(read-value self % phase) [b0 b1]))]
+          (testing kind
+            (is (= 200 (:status referred)) (str "the reference is written: " (:body referred)))
+            (is (not= v0 v1) "each holder has its own value block")
+            (is (= 200 (:status dry)) (str (:body dry)))
+            (is (= 2 (get-in dry [:body :converted :deleted])) "the dry run counts the value blocks to delete")
+            (is (= 1 (get-in dry [:body :converted :referenced])) "and the ones referenced elsewhere")
+            (is (true? (= before after-dry)) "a dry run stores nothing")
+            (is (= 409 (:status refused)) (str (:body refused)))
+            (let [error (str (get-in refused [:body :error]))]
+              (is (string/includes? error "convert_values") error)
+              (is (string/includes? error "phase") "the error names the property")
+              (is (string/includes? error "1 value block") "and the count")
+              (is (string/includes? error (str b2)) "and the referencing block")
+              (is (string/includes? error "acknowledge-references") "and the flag"))
+            (is (true? (= before after-refused)) "a refused call writes nothing")
+            (is (true? kept) "the referenced value block is kept")
+            (is (nil? added) "no choice was added")
+            (is (= 200 (:status acked)) (str (:body acked)))
+            (is (some? active) "the acknowledged call converts")
+            (is (= [{:uuid (str active) :title "Active"} {:uuid (str active) :title "Active"}] (vec reads))
+                "and every holder reads back its choice")
+            (is (nil? (entity conn v0)) "the old value blocks are gone")
+            (is (nil? (entity conn v1)))))))))
+
+(deftest convert-values-referenced-by-page-ref-test
+  (async done
+    (referenced-conversion! done "a [[ref]] in a block's title"
+                            (fn [{:keys [self]} referrer value]
+                              (request! self "PATCH" (str "/semantic/blocks/" referrer) {:title (str "See [[" value "]]")})))))
+
+(deftest convert-values-referenced-by-block-ref-test
