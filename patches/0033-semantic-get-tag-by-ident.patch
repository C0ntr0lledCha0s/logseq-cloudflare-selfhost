+;; getTag takes the same tag-id as updateTag: a UUID or a qualified ident, so the connector's audit
+;; log can read a tag before an update by ident overwrites it. Anything else names no tag: a
+;; property's ident, a title, an unqualified word, an ident nothing has, and a tag in the Recycle bin.
+(deftest get-tag-by-qualified-ident-test
+  (async done
+    (with-tags done
+      (fn [{:keys [conn self client for-service]}]
+        (p/let [by-uuid (request! self "GET" (tag-path (:block/uuid client)) nil)
+                by-ident (request! self "GET" (tag-path (:db/ident client)) nil)
+                built-in (request! self "GET" (tag-path :logseq.class/Task) nil)
+                property (request! self "GET" (tag-path for-service) nil)
+                title (request! self "GET" (str "/semantic/tags/" (js/encodeURIComponent "Client")) nil)
+                missing (request! self "GET" (tag-path :user.class/No-such-tag) nil)
+                _ (d/transact! conn [{:db/id (:db/id client) :logseq.property/deleted-at 1}])
+                deleted (request! self "GET" (tag-path (:db/ident client)) nil)]
+          (is (= 200 (:status by-uuid)) (str (:body by-uuid)))
+          (is (= 200 (:status by-ident)) (str (:body by-ident)))
+          (is (= (:body by-uuid) (:body by-ident)))
+          (is (= 200 (:status built-in)) (str (:body built-in)))
+          (is (= "Task" (get-in built-in [:body :title])))
+          (is (= 404 (:status property)) "a property's ident names no tag")
+          (is (= 404 (:status title)) "a title is not a tag-id")
+          (is (= 404 (:status missing)))
+          (is (= 404 (:status deleted)) "a tag in the Recycle bin stays hidden by ident"))))))
+
