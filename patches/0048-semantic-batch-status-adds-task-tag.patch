+(def ^:private task-tag-properties
+  "The properties whose write makes the outliner tag a block Task (should-add-task-tag-for-property?
+  in logseq.outliner.property)."
+  #{:logseq.property/status :logseq.property/scheduled :logseq.property/deadline})
+
+(defn- task-tag-write
+  "The final-tags write of setting `property-ident` to `value` on the entity with db id `id` when the
+  property is Status, Scheduled or Deadline, or nil. final-tags adds Task only where the outliner
+  would at that point in the batch."
+  [db id property-ident value]
+  (when (and id (contains? task-tag-properties property-ident) (some? value))
+    [id [(:db/id (d/entity db :logseq.class/Task))] false false property-ident]))
+
+(defn- classes-provide-property?
+  "Whether the tags with db ids `ids`, or the classes they extend, provide `property-ident` as a
+  class property, as the outliner's get-block-classes-properties reads it."
+  [db ids property-ident]
+  (let [classes (map #(d/entity db %) ids)]
+    (boolean (some (fn [class] (some #(= property-ident (:db/ident %)) (:logseq.property.class/properties class)))
+                   (concat classes (ldb/get-classes-parents classes))))))
+
