diff --git a/deps/db-sync/test/logseq/db_sync/semantic_batch_task_tag_test.cljs b/deps/db-sync/test/logseq/db_sync/semantic_batch_task_tag_test.cljs
new file mode 100644
index 0000000..31a8ba5
--- /dev/null
+++ b/deps/db-sync/test/logseq/db_sync/semantic_batch_task_tag_test.cljs
@@ -0,0 +1,264 @@
+(ns logseq.db-sync.semantic-batch-task-tag-test
+  "A property limited to Task, written in a batch that also sets Status, Scheduled or Deadline on
+  the value's block (item 44). The outliner tags a block Task when it gets one of those three and
+  has no tags, or none of its classes provides the property, so the batch's class check must count
+  that Task tag as it counts an explicit one: in either entry order, whether the value is given by
+  UUID, title or ident, for a one and a many property, in batchSetBlockProperty and
+  batchInsertBlockTrees. The same writes as separate calls succeed. A batch with no such write, a
+  Status on a different block, a later reset tag list that drops Task, and a block whose class
+  provides Status (so the outliner adds no Task) all stay refused, naming the entry, and write
+  nothing.
+  The graph has tags Client and Project (Project's class properties include Status), a page Notes
+  with untagged blocks Block 0 to Block 5, and an untagged page Globex with an ident. for-task (one)
+  and tasks (many) are node properties limited to Task."
+  (:require [cljs.test :refer [async deftest is testing]]
+            [clojure.string :as string]
+            [datascript.core :as d]
+            [logseq.db-sync.test-sql :as test-sql]
+            [logseq.db-sync.worker.handler.sync :as sync-handler]
+            [logseq.db.sqlite.export :as sqlite-export]
+            [logseq.outliner.property :as outliner-property]
+            [promesa.core :as p]))
+
+(defn- request!
+  "One semantic API request through the real handler; returns {:status :body}."
+  [self method path body]
+  (p/let [url (str "http://localhost" path (if (string/includes? path "?") "&" "?") "graph-id=graph-1")
+          response (sync-handler/handle-http
+                    self
+                    (js/Request. url (clj->js (cond-> {:method method
+                                                       :headers {"content-type" "application/json"}}
+                                                body (assoc :body (js/JSON.stringify (clj->js body)))))))
+          text (.text response)]
+    {:status (.-status response)
+     :body (when (seq text) (js->clj (js/JSON.parse text) :keywordize-keys true))}))
+
+(defn- ident-str [ident] (subs (str ident) 1))
+
+(defn- entity [conn id] (d/entity @conn [:block/uuid id]))
+
+(def ^:private deadline-ms 1794268800000)
+
+(defn- graph!
+  "A fresh graph as the namespace doc describes it."
+  []
+  (p/let [conn (sqlite-export/create-conn)
+          self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true}
+          tag! (fn [title] (p/let [r (request! self "POST" "/semantic/tags" {:title title})]
+                             (entity conn (uuid (get-in r [:body :uuid])))))
+          client (tag! "Client")
+          project (tag! "Project")
+          _ (d/transact! conn [[:db/add (:db/id project) :logseq.property.class/properties
+                                (:db/id (d/entity @conn :logseq.property/status))]])
+          page-id (random-uuid)
+          globex (random-uuid)
+          blocks (vec (repeatedly 6 random-uuid))
+          _ (d/transact! conn (concat
+                               [{:block/uuid page-id :block/name "notes" :block/title "Notes"
+                                 :block/tags #{:logseq.class/Page} :block/created-at 1 :block/updated-at 1}
+                                {:block/uuid globex :block/name "globex" :block/title "Globex"
+                                 :db/ident :user.page/globex
+                                 :block/tags #{:logseq.class/Page} :block/created-at 1 :block/updated-at 1}]
+                               (map-indexed (fn [index id]
+                                              {:block/uuid id :block/title (str "Block " index)
+                                               :block/page [:block/uuid page-id]
+                                               :block/parent [:block/uuid page-id]
+                                               :block/order (str "a" index)
+                                               :block/created-at 1 :block/updated-at 1})
+                                            blocks)))
+          for-task (outliner-property/upsert-property!
+                    conn nil {:logseq.property/type :node :db/cardinality :db.cardinality/one}
+                    {:property-name "for-task"})
+          tasks (outliner-property/upsert-property!
+                 conn nil {:logseq.property/type :node :db/cardinality :db.cardinality/many}
+                 {:property-name "tasks"})
+          for-task (:db/ident for-task)
+          tasks (:db/ident tasks)
+          r1 (request! self "PATCH" (str "/semantic/properties/" (js/encodeURIComponent (ident-str for-task)))
+                       {:classes {:set ["Task"]}})
+          r2 (request! self "PATCH" (str "/semantic/properties/" (js/encodeURIComponent (ident-str tasks)))
+                       {:classes {:set ["Task"]}})]
+    (is (= [200 200] [(:status r1) (:status r2)]) "for-task and tasks are limited to Task")
+    {:conn conn :self self :page-id page-id :blocks blocks :globex globex
+     :client client :project project
+     :for-task for-task :tasks tasks
+     :ft (ident-str for-task) :ts (ident-str tasks)}))
+
+(defn- each-graph
+  "Runs (f graph case) on a fresh graph for each case, one after another, so one wrongly accepted
+  batch can't change the next case."
+  [done cases f]
+  (-> (reduce (fn [chain case] (p/then chain (fn [_] (p/let [g (graph!)] (f g case)))))
+              (p/resolved nil)
+              cases)
+      (p/catch #(is false (str %)))
+      (p/finally done)))
+
+(defn- stored [conn id property]
+  (let [value (get (entity conn id) property)]
+    (if (set? value) (set (map :block/uuid value)) (:block/uuid value))))
+
+(defn- tag-titles [conn id]
+  (set (map :block/title (:block/tags (entity conn id)))))
+
+(defn- batch-set! [self entries & [opts]]
+  (request! self "POST" "/semantic/block-properties/batch-set" (merge {:entries entries} opts)))
+
+(defn- insert-batch! [self entries]
+  (request! self "POST" "/semantic/block-trees/batch" {:entries entries}))
+
+(def ^:private task-properties
+  "Each property whose write makes the outliner tag the block Task, with a value for it."
+  [["Status" "logseq.property/status" "Todo"]
+   ["Scheduled" "logseq.property/scheduled" deadline-ms]
+   ["Deadline" "logseq.property/deadline" deadline-ms]])
+
+(deftest separate-calls-tag-the-block-task-test
+  ;; The baseline the batch must match: setting Status on an untagged block tags it Task, and then
+  ;; for-task takes that block.
+  (async done
+    (each-graph done task-properties
+      (fn [{:keys [conn self blocks for-task ft]} [label property value]]
+        (let [b0 (first blocks)
+              b1 (second blocks)]
+          (p/let [set-task (request! self "PUT" (str "/semantic/blocks/" b0 "/properties/"
+                                                     (js/encodeURIComponent property))
+                                     {:value value})
+                  set-value (request! self "PUT" (str "/semantic/blocks/" b1 "/properties/"
+                                                      (js/encodeURIComponent ft))
+                                      {:value (str b0)})]
+            (testing label
+              (is (= 200 (:status set-task)) (str (:body set-task)))
+              (is (= #{"Task"} (tag-titles conn b0)) "the outliner tags the block Task")
+              (is (= 200 (:status set-value)) (str (:body set-value)))
+              (is (= b0 (stored conn b1 for-task))))))))))
+
+(deftest batch-set-counts-implicit-task-tag-test
+  ;; Entry A sets Status, Scheduled or Deadline on untagged Block 0; entry B sets for-task (one) or
+  ;; tasks (many) on Block 1 to Block 0 by UUID or by title. Either order answers 200, and both the
+  ;; value and the Task tag read back. Today: "entry 1: no #Task object <uuid>" (entry 0 swapped).
+  (async done
+    (each-graph done (for [task task-properties
+                           many? [false true]
+                           value-form [:uuid :title]
+                           task-first? [true false]]
+                       [task many? value-form task-first?])
+      (fn [{:keys [conn self blocks for-task tasks ft ts]} [[label property value] many? value-form task-first?]]
+        (let [[b0 b1] blocks
+              named (if (= value-form :uuid) (str b0) "Block 0")
+              task-entry {:block-id (str b0) :property-id property :value value}
+              value-entry {:block-id (str b1) :property-id (if many? ts ft) :value (if many? [named] named)}]
+          (p/let [response (batch-set! self (if task-first? [task-entry value-entry] [value-entry task-entry]))]
+            (testing (str label ", " (if many? "tasks" "for-task") " by " (name value-form)
+                          (if task-first? ", task entry first" ", value entry first"))
+              (is (= 200 (:status response)) (str (:body response)))
+              (is (= (if many? #{b0} b0) (stored conn b1 (if many? tasks for-task))) "the value reads back")
+              (is (contains? (tag-titles conn b0) "Task") "the Task tag reads back"))))))))
+
+(deftest batch-set-implicit-task-tag-page-by-ident-test
+  ;; A plain page gets Task too (Page doesn't provide Status), and a value can name it by ident.
+  (async done
+    (each-graph done [true false]
+      (fn [{:keys [conn self blocks globex for-task ft]} task-first?]
+        (let [b0 (first blocks)
+              task-entry {:block-id (str globex) :property-id "logseq.property/status" :value "Todo"}
+              value-entry {:block-id (str b0) :property-id ft :value "user.page/globex"}]
+          (p/let [response (batch-set! self (if task-first? [task-entry value-entry] [value-entry task-entry]))]
+            (testing (if task-first? "task entry first" "value entry first")
+              (is (= 200 (:status response)) (str (:body response)))
+              (is (= globex (stored conn b0 for-task)) "the value reads back")
+              (is (contains? (tag-titles conn globex) "Task") "the Task tag reads back"))))))))
+
+(deftest batch-set-reset-tags-then-status-adds-task-test
+  ;; Under isResetExistingValues, entry 0 resets Block 0's tags to [Client], entry 1 sets Status on
+  ;; it. Client doesn't provide Status, so the outliner adds Task after the reset, and entry 2's
+  ;; for-task value of Block 0 is in class once the batch applies.
+  (async done
+    (each-graph done [nil]
+      (fn [{:keys [conn self blocks for-task ft]} _]
+        (let [[b0 b1] blocks]
+          (p/let [response (batch-set! self [{:block-id (str b0) :property-id "block/tags" :value ["Client"]}
+                                             {:block-id (str b0) :property-id "logseq.property/status" :value "Todo"}
+                                             {:block-id (str b1) :property-id ft :value (str b0)}]
+                                       {:isResetExistingValues true})]
+            (is (= 200 (:status response)) (str (:body response)))
+            (is (= b0 (stored conn b1 for-task)) "the value reads back")
+            (is (= #{"Client" "Task"} (tag-titles conn b0)) "Block 0 keeps Client and gains Task")))))))
+
+(deftest batch-set-without-implicit-task-tag-still-refused-test
+  ;; The Task tag counts only where the outliner would add it. Each case is refused naming the value
+  ;; entry, and nothing is written:
+  ;; - no Status, Scheduled or Deadline write in the batch (a title change instead);
+  ;; - Status set on Block 2, not on the value's block;
+  ;; - under reset, a later tag list [Client] on Block 0 drops the Task tag Status gave it;
+  ;; - Block 0 is a Project, whose class properties include Status, so the outliner adds no Task;
+  ;; - Status null on Block 0 sets nothing, so it adds no Task (value entry first, so entry 0 is
+  ;;   judged before entry 1's own refusal).
+  (async done
+    (each-graph done [:no-task-write :other-block :reset-drops-task :class-provides-status :null-status]
+      (fn [{:keys [conn self blocks project for-task ft]} kind]
+        (let [[b0 b1 b2] blocks
+              status (fn [b] {:block-id (str b) :property-id "logseq.property/status" :value "Todo"})
+              value-entry {:block-id (str b1) :property-id ft :value (str b0)}]
+          (p/let [_ (when (= kind :class-provides-status)
+                      (d/transact! conn [[:db/add [:block/uuid b0] :block/tags (:db/id project)]]))
+                  response (case kind
+                             :no-task-write (batch-set! self [{:block-id (str b0) :property-id "block/title" :value "Renamed"}
+                                                              value-entry])
+                             :other-block (batch-set! self [(status b2) value-entry])
+                             :reset-drops-task (batch-set! self [(status b0)
+                                                                 {:block-id (str b0) :property-id "block/tags" :value ["Client"]}
+                                                                 (assoc value-entry :value "Block 0")]
+                                                           {:isResetExistingValues true})
+                             :class-provides-status (batch-set! self [(status b0) value-entry])
+                             :null-status (batch-set! self [value-entry (assoc (status b0) :value nil)]))
+                  expected (case kind
+                             :reset-drops-task "entry 2: no #Task object titled \"Block 0\""
+                             :null-status (str "entry 0: no #Task object " b0)
+                             (str "entry 1: no #Task object " b0))]
+            (testing (name kind)
+              (is (= 400 (:status response)) (str (:body response)))
+              (is (= expected (get-in response [:body :error])))
+              (is (nil? (stored conn b1 for-task)) "no value is written")
+              (is (not (contains? (tag-titles conn b0) "Task")) "Block 0 isn't tagged Task"))))))))
+
+(deftest batch-insert-counts-implicit-task-tag-test
+  ;; batchInsertBlockTrees: one entry sets Status, Scheduled or Deadline on existing Block 0 through
+  ;; its target properties, another inserts a block whose for-task is Block 0 by UUID or title. Either
+  ;; order answers 201. Today: "entries[1].blocks[0]: ...: no #Task object <uuid>".
+  (async done
+    (each-graph done (for [task task-properties
+                           value-form [:uuid :title]
+                           task-first? [true false]]
+                       [task value-form task-first?])
+      (fn [{:keys [conn self page-id blocks for-task ft]} [[label property value] value-form task-first?]]
+        (let [b0 (first blocks)
+              n0 (random-uuid)
+              task-entry {:target-id (str b0) :properties {property value}}
+              insert-entry {:target-id (str page-id)
+                            :blocks [{:uuid (str n0) :title "Inserted"
+                                      :properties {ft (if (= value-form :uuid) (str b0) "Block 0")}}]}]
+          (p/let [response (insert-batch! self (if task-first? [task-entry insert-entry] [insert-entry task-entry]))]
+            (testing (str label ", by " (name value-form) (if task-first? ", task entry first" ", insert entry first"))
+              (is (= 201 (:status response)) (str (:body response)))
+              (is (= b0 (stored conn n0 for-task)) "the value reads back")
+              (is (contains? (tag-titles conn b0) "Task") "the Task tag reads back"))))))))
+
+(deftest batch-insert-without-implicit-task-tag-still-refused-test
+  ;; With no Status, Scheduled or Deadline write on Block 0, the inserted block's for-task is refused.
+  (async done
+    (each-graph done [nil]
+      (fn [{:keys [conn self page-id blocks ft]} _]
+        (let [b0 (first blocks)
+              n0 (random-uuid)]
+          (p/let [response (insert-batch! self [{:target-id (str (second blocks))
+                                                 :properties {"logseq.property/status" "Todo"}}
+                                                {:target-id (str page-id)
+                                                 :blocks [{:uuid (str n0) :title "Inserted"
+                                                           :properties {ft (str b0)}}]}])]
+            (is (= 400 (:status response)) (str (:body response)))
+            (is (string/starts-with? (str (get-in response [:body :error])) "entries[1].blocks[0]")
+                (str (:body response)))
+            (is (string/includes? (str (get-in response [:body :error])) (str "no #Task object " b0)))
+            (is (nil? (entity conn n0)) "the block isn't inserted")
+            (is (not (contains? (tag-titles conn b0) "Task")))))))))
