+(deftest openapi-documents-write-guards-test
+  (let [paths (:paths (semantic-routes/openapi-document "https://issuer.example"))
+        query-flags (fn [path]
+                      (->> (get-in paths [path :delete :parameters])
+                           (filter #(= "query" (:in %)))
+                           (map (juxt :name (comp :type :schema)))
+                           (into {})))]
+    (is (= {"acknowledge-references" "boolean" "dry-run" "boolean"}
+           (query-flags "/api/v1/graphs/{graph-id}/pages/{page-id}")))
+    (is (= {"acknowledge-holders" "boolean" "acknowledge-child-tags" "boolean"
+            "acknowledge-references" "boolean" "dry-run" "boolean"}
+           (query-flags "/api/v1/graphs/{graph-id}/tags/{tag-id}")))
+    (is (= {"acknowledge-values" "boolean" "dry-run" "boolean"}
+           (query-flags "/api/v1/graphs/{graph-id}/properties/{property-id}")))
+    (doseq [path ["/api/v1/graphs/{graph-id}/pages" "/api/v1/graphs/{graph-id}/tags"]]
+      (is (= "#/components/schemas/TitleConflict"
+             (get-in paths [path :post :responses "409" :content "application/json" :schema :$ref]))))
+    (is (string/includes? (get-in paths ["/api/v1/graphs/{graph-id}/pages" :post :description])
+                          "no need to search before creating"))))
