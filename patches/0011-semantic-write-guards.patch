+            [logseq.db-sync.storage :as storage]
+            [logseq.db-sync.worker.handler.sync :as sync-handler]
+            [logseq.db-sync.worker.routes.semantic :as semantic-routes]
+            [logseq.db.frontend.entity-util :as entity-util]
+            [logseq.db.sqlite.export :as sqlite-export]
+            [logseq.outliner.property :as outliner-property]
+            [promesa.core :as p]))
+
+(def ^:private sqlite (if (find-ns 'nbb.core) (aget sqlite3 "default") sqlite3))
+
+(defn- with-memory-sql-async [f]
+  (let [db (new sqlite ":memory:" nil)
+        sql #js {:_db db
+                 :transaction (fn [f] ((.transaction db f)))
+                 :exec (fn [sql-str & args]
+                         (let [stmt (.prepare db sql-str)]
+                           (if (string/starts-with? (-> sql-str string/trim string/lower-case) "select")
+                             (.apply (.-all ^js stmt) stmt (to-array args))
+                             (do (.apply (.-run ^js stmt) stmt (to-array args)) nil))))
+                 :close (fn [] (.close db))}]
+    (-> (f sql)
+        (p/finally #(.close sql)))))
+
+(defn- semantic-json-request [path method body]
+  (js/Request. (str "http://localhost" path)
+               (clj->js (cond-> {:method method
+                                 :headers {"content-type" "application/json"}}
+                          body (assoc :body (js/JSON.stringify (clj->js body)))))))
+
+(defn- with-graph
+  "Runs `run` against a fresh built-in DB graph. `call` sends one semantic API request through the
+  real HTTP handler and resolves to [status body]; `query` is appended to the path's query string."
+  [done run]
+  (-> (with-memory-sql-async
+        (fn [sql]
+          (storage/init-schema! sql)
+          (let [conn (sqlite-export/create-conn)
+                self #js {:sql sql :conn conn :schema-ready true}
+                call (fn call
+                       ([method path] (call method path nil nil))
+                       ([method path body] (call method path body nil))
+                       ([method path body query]
+                        (p/let [response (sync-handler/handle-http
+                                          self
+                                          (semantic-json-request
+                                           (str "/semantic" path "?graph-id=graph-1" (when query (str "&" query)))
+                                           method body))
+                                text (.text response)]
+                          [(.-status response)
+                           (when (seq text) (js->clj (js/JSON.parse text) :keywordize-keys true))])))]
+            (run {:conn conn :call call}))))
+      (p/catch #(is false (str %)))
+      (p/finally done)))
+
+(defn- entity [conn id]
+  (d/entity @conn [:block/uuid (uuid id)]))
+
+(defn- named [conn page-name]
+  (->> (d/datoms @conn :avet :block/name page-name)
+       (map #(d/entity @conn (:e %)))
+       (remove entity-util/hidden?)))
+
+(deftest create-page-refuses-a-title-an-existing-page-holds-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn call]}]
+        (p/let [[status created] (call "POST" "/pages" {:title "Project Alpha"})
+                _ (is (= 201 status))
+                id (:uuid created)
+                [lower-status lower] (call "POST" "/pages" {:title "project alpha"})
+                [bracket-status _] (call "POST" "/pages" {:title "[[Project Alpha]]"})
+                [tag-status tag-body] (call "POST" "/tags" {:title "PROJECT ALPHA"})]
+          (testing "a case-insensitive match refuses and names the page"
+            (is (= 409 lower-status))
+            (is (string/includes? (:error lower) id))
+            (is (string/includes? (:error lower) "page \"Project Alpha\""))
+            (is (= {:uuid id :kind "page" :title "Project Alpha"} (first (:existing lower)))))
+          (testing "the title is compared as Logseq stores it, without [[ ]]"
+            (is (= 409 bracket-status)))
+          (testing "createTag refuses rather than converting the page into a tag"
+            (is (= 409 tag-status))
+            (is (string/includes? (:error tag-body) id))
+            (is (not (ldb/class? (entity conn id)))))
+          (is (= 1 (count (named conn "project alpha"))) "nothing was written"))))))
+
+(deftest create-refuses-titles-held-by-tags-properties-and-journals-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn call]}]
+        (p/let [[_ movie] (call "POST" "/tags" {:title "Movie"})
+                [tag-status tag-body] (call "POST" "/tags" {:title "movie"})
+                [page-status page-body] (call "POST" "/pages" {:title "MOVIE"})
+                [_ genre] (call "POST" "/properties" {:title "Genre"})
+                [property-status property-body] (call "POST" "/pages" {:title "genre"})
+                [built-in-status built-in-body] (call "POST" "/tags" {:title "task"})
+                [_ captured] (call "POST" "/capture" {:blocks [{:title "Today"}]})
+                journal (entity conn (:page-id captured))
+                [journal-status journal-body] (call "POST" "/pages" {:title (:block/title journal)})
+                [fresh-status _] (call "POST" "/tags" {:title "Movie night"})]
+          (testing "a tag differing only in case is the same title"
+            (is (= 409 tag-status))
+            (is (string/includes? (:error tag-body) (str "tag \"Movie\" (" (:uuid movie) ")")))
+            (is (= 409 page-status))
+            (is (= 1 (count (named conn "movie")))))
+          (testing "a property holds its title"
+            (is (= 409 property-status))
+            (is (string/includes? (:error property-body) (str "property \"Genre\" (" (:uuid genre) ")"))))
+          (testing "built-in tags hold their titles"
+            (is (= 409 built-in-status))
+            (is (string/includes? (:error built-in-body) "tag \"Task\"")))
+          (testing "a journal holds its title"
+            (is (= 409 journal-status))
+            (is (string/includes? (:error journal-body) (str "journal \"" (:block/title journal) "\""))))
+          (is (= 201 fresh-status) "a free title is still created"))))))
+
+(deftest create-page-restores-a-recycled-page-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn call]}]
+        (p/let [[_ created] (call "POST" "/pages" {:title "Scratch"})
+                [delete-status _] (call "DELETE" (str "/pages/" (:uuid created)))
+                _ (is (= 204 delete-status))
+                _ (is (entity-util/hidden? (entity conn (:uuid created))))
+                [again-status again] (call "DELETE" (str "/pages/" (:uuid created)))
+                _ (is (= [400 "page cannot be deleted"] [again-status (:error again)])
+                      "deleting a recycled page again fails instead of answering 204")
+                [status body] (call "POST" "/pages" {:title "Scratch"})]
+          (is (= 201 status) "a page in the Recycle bin does not hold its title")
+          (is (= (:uuid created) (:uuid body)) "Logseq restores it, as in the editor")
+          (is (not (entity-util/hidden? (entity conn (:uuid created))))))))))
+
+(deftest delete-page-with-references-needs-acknowledgement-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn call]}]
+        (p/let [[_ target] (call "POST" "/pages" {:title "Target"})
+                [_ source] (call "POST" "/pages" {:title "Source"})
+                [_ related] (call "POST" "/properties" {:title "Related" :type "node"})
+                [_ inserted] (call "POST" "/block-trees" {:target-id (:uuid source)
+                                                          :blocks [{:title "See [[Target]]"}
+                                                                   {:title "Holds a value"}]})
+                [_ _] (call "POST" "/block-trees" {:target-id (:uuid target)
+                                                   :blocks [{:title "Self link to [[Target]]"}]})
+                [set-status _] (call "PUT" (str "/blocks/" (get-in inserted [:blocks 1 :uuid])
+                                                "/properties/" (:uuid related))
+                                     {:value (:uuid target)})
+                _ (is (= 200 set-status))
+                path (str "/pages/" (:uuid target))
+                [refused-status refused] (call "DELETE" path)
+                [false-status _] (call "DELETE" path nil "acknowledge-references=false")
+                [invalid-status invalid] (call "DELETE" path nil "acknowledge-references=yes")
+                [dry-status dry] (call "DELETE" path nil "dry-run=true")
+                _ (testing "refused deletes and dry runs write nothing"
+                    (is (not (entity-util/hidden? (entity conn (:uuid target)))))
+                    (is (string/includes? (:block/raw-title (entity conn (get-in inserted [:blocks 0 :uuid])))
+                                          (:uuid target))))
+                [status _] (call "DELETE" path nil "acknowledge-references=true")]
+          (testing "references are blocks elsewhere that link to the page or hold it as a property value"
+            (is (= 409 refused-status))
+            (is (string/includes? (:error refused) "2 references"))
+            (is (string/includes? (:error refused) "acknowledge-references=true"))
+            (is (= 2 (:references refused)))
+            (is (= ["acknowledge-references"] (:requires refused))))
+          (is (= 409 false-status))
+          (is (= 400 invalid-status))
+          (is (= "acknowledge-references must be true or false" (:error invalid)))
+          (testing "dry-run reports what would be lost"
+            (is (= 200 dry-status))
+            (is (= {:dry-run true :uuid (:uuid target) :kind "page" :title "Target"
+                    :references 2 :requires ["acknowledge-references"]}
+                   dry)))
+          (testing "with the acknowledgement the delete proceeds"
+            (is (= 204 status))
+            (is (entity-util/hidden? (entity conn (:uuid target))))))))))
+
+(deftest delete-unreferenced-page-proceeds-without-acknowledgement-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn call]}]
+        (p/let [[_ page] (call "POST" "/pages" {:title "Lonely"})
+                _ (call "POST" "/block-trees" {:target-id (:uuid page) :blocks [{:title "Body"}]})
+                [dry-status dry] (call "DELETE" (str "/pages/" (:uuid page)) nil "dry-run=true")
+                [status _] (call "DELETE" (str "/pages/" (:uuid page)))]
+          (is (= 200 dry-status))
+          (is (= {:references 0 :requires []} (select-keys dry [:references :requires])))
+          (is (= 204 status))
+          (is (entity-util/hidden? (entity conn (:uuid page)))))))))
+
+(deftest delete-tag-guards-holders-child-tags-and-references-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn call]}]
+        (p/let [[_ animal] (call "POST" "/tags" {:title "Animal"})
+                [_ dog] (call "POST" "/tags" {:title "Dog"})
+                _ (outliner-property/set-block-property! conn [:block/uuid (uuid (:uuid dog))]
+                                                         :logseq.property.class/extends
+                                                         (:db/id (entity conn (:uuid animal))))
+                [_ page] (call "POST" "/pages" {:title "Zoo"})
+                [_ inserted] (call "POST" "/block-trees" {:target-id (:uuid page)
+                                                          :blocks [{:title "Rex #Animal"}
+                                                                   {:title "About [[Animal]]"}]})
+                _ (is (= #{(uuid (:uuid animal))}
+                         (set (map :block/uuid (:block/tags (entity conn (get-in inserted [:blocks 0 :uuid]))))))
+                      "the inline tag makes the block a holder")
+                path (str "/tags/" (:uuid animal))
+                [refused-status refused] (call "DELETE" path)
+                [partial-status partial] (call "DELETE" path nil "acknowledge-holders=true&acknowledge-references=true")
+                [dry-status dry] (call "DELETE" path nil "dry-run=true")
+                _ (is (some? (entity conn (:uuid animal))) "refused deletes and dry runs write nothing")
+                [status _] (call "DELETE" path nil (str "acknowledge-holders=true&acknowledge-child-tags=true"
+                                                        "&acknowledge-references=true"))]
+          (testing "holders, child tags and other references are counted separately"
+            (is (= 409 refused-status))
+            (is (= {:holders 1 :child-tags 1 :references 1}
+                   (select-keys refused [:holders :child-tags :references])))
+            (is (= ["acknowledge-holders" "acknowledge-child-tags" "acknowledge-references"] (:requires refused)))
+            (is (string/includes? (:error refused) "1 holder"))
+            (is (string/includes? (:error refused) "1 child tag"))
+            (is (string/includes? (:error refused) "1 reference")))
+          (testing "every count needs its own acknowledgement"
+            (is (= 409 partial-status))
+            (is (= ["acknowledge-child-tags"] (:requires partial))))
+          (is (= 200 dry-status))
+          (is (= {:dry-run true :uuid (:uuid animal) :kind "tag" :title "Animal"
+                  :holders 1 :child-tags 1 :references 1
+                  :requires ["acknowledge-holders" "acknowledge-child-tags" "acknowledge-references"]}
+                 dry))
+          (testing "with every acknowledgement the delete proceeds"
+            (is (= 204 status))
+            (is (nil? (entity conn (:uuid animal))))
+            (is (= #{:logseq.class/Root}
+                   (set (map :db/ident (:logseq.property.class/extends (entity conn (:uuid dog))))))
+                "Logseq re-parents the child tag to Root")))))))
+
+(deftest delete-property-with-values-needs-acknowledgement-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn call]}]
+        (p/let [[_ mood] (call "POST" "/properties" {:title "Mood"})
+                [_ unused] (call "POST" "/properties" {:title "Unused"})
+                [_ page] (call "POST" "/pages" {:title "Diary"})
+                [_ inserted] (call "POST" "/block-trees" {:target-id (:uuid page)
+                                                          :blocks [{:title "Monday"} {:title "Tuesday"}]})
+                _ (p/doseq [block (:blocks inserted)]
+                    (call "PUT" (str "/blocks/" (:uuid block) "/properties/" (:uuid mood)) {:value "calm"}))
+                path (str "/properties/" (:uuid mood))
+                [refused-status refused] (call "DELETE" path)
+                [dry-status dry] (call "DELETE" path nil "dry-run=true")
+                _ (is (some? (entity conn (:uuid mood))) "refused deletes and dry runs write nothing")
+                [status _] (call "DELETE" path nil "acknowledge-values=true")
+                [unused-status _] (call "DELETE" (str "/properties/" (:uuid unused)))]
+          (is (= 409 refused-status))
+          (is (= 2 (:values refused)))
+          (is (string/includes? (:error refused) "2 values"))
+          (is (string/includes? (:error refused) "acknowledge-values=true"))
+          (is (= 200 dry-status))
+          (is (= {:dry-run true :uuid (:uuid mood) :kind "property" :title "Mood"
+                  :values 2 :requires ["acknowledge-values"]}
+                 dry))
+          (is (= 204 status))
+          (is (nil? (entity conn (:uuid mood))))
+          (is (= 204 unused-status) "a property without values needs no acknowledgement"))))))
+
+(deftest delete-block-refuses-pages-tags-and-properties-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn call]}]
+        (p/let [[_ page] (call "POST" "/pages" {:title "Kept"})
+                [_ tag] (call "POST" "/tags" {:title "Kept tag"})
+                [_ property] (call "POST" "/properties" {:title "Kept property"})
+                [page-status page-body] (call "DELETE" (str "/blocks/" (:uuid page)))
+                [tag-status tag-body] (call "DELETE" (str "/blocks/" (:uuid tag)))
+                [property-status property-body] (call "DELETE" (str "/blocks/" (:uuid property)))]
+          (is (= [400 400 400] [page-status tag-status property-status]))
+          (is (= "block is a page: delete it with deletePage" (:error page-body)))
+          (is (= "block is a tag: delete it with deleteTag" (:error tag-body)))
+          (is (= "block is a property: delete it with deleteProperty" (:error property-body)))
+          (is (not-any? #(entity-util/hidden? (entity conn (:uuid %))) [page tag property])))))))
