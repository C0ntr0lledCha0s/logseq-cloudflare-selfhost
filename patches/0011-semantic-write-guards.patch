-(defn- handle-pages [{:keys [^js self request ^js url conn db handler path-params e2ee? creator]}]
+;; createPage and createTag refuse a title that a visible page, journal, tag or property already
+;; holds, compared as Logseq's :block/name (sanitized, lower-cased). The outliner keeps tag and
+;; property titles case-sensitive, but [[links]], page lookups by name and inline-tag resolution go
+;; through :block/name, so #Movie and #movie would be ambiguous there. Recycled pages don't count:
+;; creating one again restores it, as in the editor. E2EE names are ciphertext and can't be compared.
+(defn- title-holder-kind [entity]
+  (if (ldb/journal? entity) "journal" (block-kind entity)))
+
+(defn- title-holders [db title]
+  (->> (d/datoms db :avet :block/name (common-util/page-name-sanity-lc (outliner-page/sanitize-title title)))
+       (map #(d/entity db (:e %)))
+       (remove entity-util/hidden?)
+       (filter #(or (page? %) (tag? %) (property? %)))
+       (sort-by :db/id)))
+
+(defn- title-taken-response [title holders]
+  (http/json-response
+   nil
+   {:error (str "title \"" title "\" is already used by "
+                (string/join ", " (map #(str (title-holder-kind %) " \"" (:block/title %) "\" ("
+                                             (:block/uuid %) ")")
+                                       holders))
+                "; nothing was created. Use the existing one or choose another title.")
+    :existing (mapv #(hash-map :uuid (uuid-string (:block/uuid %))
+                               :kind (title-holder-kind %)
+                               :title (:block/title %))
+                    holders)}
+   409))
+
+;; deletePage, deleteTag and deleteProperty refuse to lose references, holders, child tags or
+;; values unless the matching acknowledge-* query flag is true; dry-run=true reports the counts.
+(def ^:private loss-acknowledgements
+  [[:holders "acknowledge-holders" "holder" "holders"]
+   [:child-tags "acknowledge-child-tags" "child tag" "child tags"]
+   [:references "acknowledge-references" "reference" "references"]
+   [:values "acknowledge-values" "value" "values"]])
+
+(def ^:private delete-flags
+  (conj (mapv second loss-acknowledgements) "dry-run"))
+
+(defn- flag-param [^js url flag]
+  (case (.get (.-searchParams url) flag)
+    nil false
+    "false" false
+    "true" true
+    ::invalid))
+
+(defn- visible-entity-ids [db datoms]
+  (into #{} (comp (map :e) (remove #(entity-util/hidden? (d/entity db %)))) datoms))
+
+(defn- referrer-ids
+  "Visible entities, other than `entity` and its own blocks, that link to it (:block/refs, which
+  also covers inline tags), embed it, alias it, or hold it as a user or library property value."
+  [db entity]
+  (let [id (:db/id entity)
+        attributes (into [:block/refs :block/link :block/alias]
+                         (comp (filter #(= :db.type/ref (:db/valueType %)))
+                               (map :db/ident)
+                               (remove db-property/internal-property?))
+                         (db-db/get-all-properties db))]
+    (->> (visible-entity-ids db (mapcat #(d/datoms db :avet % id) attributes))
+         (remove #(or (= id %) (= id (:db/id (:block/page (d/entity db %))))))
+         set)))
+
+(defn- delete-impact [db kind entity]
+  (let [id (:db/id entity)]
+    (case kind
+      "page" {:references (count (referrer-ids db entity))}
+      "tag" (let [holders (visible-entity-ids db (d/datoms db :avet :block/tags id))
+                  children (visible-entity-ids db (d/datoms db :avet :logseq.property.class/extends id))]
+              {:holders (count holders)
+               :child-tags (count children)
+               :references (count (remove (into holders children) (referrer-ids db entity)))})
+      "property" {:values (count (visible-entity-ids db (d/datoms db :avet (:db/ident entity))))})))
+
+(defn- join-and [items]
+  (if (< (count items) 2)
+    (first items)
+    (str (string/join ", " (butlast items)) " and " (last items))))
+
+(defn- loss-message [kind entity impact requires]
+  (let [losses (keep (fn [[k flag singular plural]]
+                       (when (some #{flag} requires)
+                         (let [n (get impact k)]
+                           [(str n " " (if (= 1 n) singular plural)) (str flag "=true")])))
+                     loss-acknowledgements)]
+    (str kind " \"" (:block/title entity) "\" (" (:block/uuid entity) ") has "
+         (join-and (map first losses)) "; nothing was deleted. Pass "
+         (join-and (map second losses))
+         " to delete it anyway, or dry-run=true to preview what would be lost.")))
+
+(defn- delete-node!
+  "Deletes a page, tag or property through Logseq's page deletion rules once every loss it causes
+  is acknowledged."
+  [{:keys [^js self ^js url conn db]} entity]
+  (let [flags (into {} (map (juxt identity #(flag-param url %))) delete-flags)
+        invalid (some #(when (= ::invalid (get flags %)) %) delete-flags)
+        kind (block-kind entity)
+        impact (delete-impact db kind entity)
+        requires (into [] (keep (fn [[k flag]]
+                                  (when (and (pos? (get impact k 0)) (not (get flags flag)))
+                                    flag)))
+                       loss-acknowledgements)]
+    (cond
+      invalid (http/bad-request (str invalid " must be true or false"))
+      (ldb/built-in? entity) (http/bad-request (str "built-in " kind " cannot be deleted"))
+      (get flags "dry-run") (http/json-response nil (merge {:dry-run true
+                                                            :uuid (uuid-string (:block/uuid entity))
+                                                            :kind kind
+                                                            :title (:block/title entity)}
+                                                           impact
+                                                           {:requires requires}))
+      (seq requires) (http/json-response nil (merge {:error (loss-message kind entity impact requires)}
+                                                    impact
+                                                    {:requires requires})
+                                         409)
+      (outliner-page/delete! conn (:block/uuid entity)) (do (broadcast-change! self)
+                                                            (js/Response. nil #js {:status 204}))
+      :else (http/bad-request (str kind " cannot be deleted")))))
+
