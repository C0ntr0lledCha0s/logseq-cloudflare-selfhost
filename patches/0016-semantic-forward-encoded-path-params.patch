+(deftest semantic-api-forwards-encoded-path-parameters-test
+  ;; The router decodes path parameters, so a property ident such as logseq.property/status,
+  ;; sent as logseq.property%2Fstatus, must be encoded again in the internal path or its `/`
+  ;; becomes a path segment that no internal route matches.
+  (async done
+         (let [{:keys [request claims]} (semantic-request
+                                         "/api/v1/graphs/graph-1/blocks/block-1/properties/logseq.property%2Fstatus?x=1"
+                                         "logseq/write" "PUT")
+               forwarded (atom [])
+               env #js {"DB" #js {}
+                        "LOGSEQ_SYNC_DO" (capturing-do-namespace forwarded)
+                        "SEMANTIC_WRITE_RATE_LIMITER" (rate-limiter true (atom []))}]
+           (-> (p/with-redefs [auth/auth-claims (fn [_ _] (p/resolved claims))
+                               index-handler/graph-access-response (fn [_ _ _] (p/resolved (ok-json-response)))
+                               common/<d1-all (fn [& _] (p/resolved #js {:results #js [(graph-row false)]}))]
+                 (p/let [response (dispatch/handle-worker-fetch request env)
+                         url (js/URL. (.-url (first @forwarded)))
+                         path (.-pathname url)]
+                   (is (= 200 (.-status response)))
+                   (is (= "/semantic/blocks/block-1/properties/logseq.property%2Fstatus" path))
+                   (is (= "1" (.get (.-searchParams url) "x")))
+                   (is (= {:block-id "block-1" :property-id "logseq.property/status"}
+                          (:path-params (semantic-routes/match-internal "PUT" path))))))
+               (p/then (fn [] (done)))
+               (p/catch (fn [error]
+                          (is false (str error))
+                          (done)))))))
+
