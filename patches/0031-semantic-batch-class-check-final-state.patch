+(defn- class-object
+  "The entity with db id `id` as a class check sees it: with its final tags when the batch being
+  resolved tags it (*final-tags*), else as it is in `db`."
+  [db id]
+  (if-let [tags (get *final-tags* id)]
+    {:db/id id :block/tags tags}
+    (d/entity db id)))
