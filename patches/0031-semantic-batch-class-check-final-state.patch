+(defn- final-tags
+  "*final-tags* for a batch's tag writes, [[db-id tag-ids replace?] ...] in request order, applied
+  as set-prepared-tags! applies them: a write adds its tags, and one that replaces (a list under
+  reset) first drops the user tags the entity holds and keeps the private ones."
+  [db writes]
+  (let [private? #(contains? ldb/private-tags (:db/ident (d/entity db %)))]
+    (->> (reduce (fn [result [id ids replace?]]
+                   (let [held (get result id (set (map :db/id (:block/tags (d/entity db id)))))]
+                     (assoc result id (into (if replace? (set (filter private? held)) held) ids))))
+                 {} writes)
+         (map (fn [[id ids]] [id (mapv #(d/entity db %) ids)]))
+         (into {}))))
 
