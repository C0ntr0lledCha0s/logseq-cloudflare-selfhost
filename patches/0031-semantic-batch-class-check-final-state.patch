@@ -0,0 +1,347 @@
+(ns logseq.db-sync.semantic-batch-class-check-test
+  "A property limited to classes, written in a batch: the class check judges the batch's final
+  state, so a tag one entry gives a page counts for a value another entry sets to that page, in
+  any entry order and however the value is given (title, UUID, ident or db id). A batch whose final
+  state puts an object outside the classes is refused up front, naming the entry, and writes
+  nothing. Covers batchSetBlockProperty and batchInsertBlockTrees.
+  The graph has tags Client, Service and VIP (VIP extends Client), a Client page Acme, a Service
+  page Audit, and untagged pages Acme Ltd, Beta Ltd, Gamma Ltd and Globex (which has an ident).
+  for-client (one) and clients (many) are node properties limited to Client."
+  (:require [cljs.test :refer [async deftest is testing]]
+            [clojure.string :as string]
+            [datascript.core :as d]
+            [logseq.db-sync.test-sql :as test-sql]
+            [logseq.db-sync.worker.handler.sync :as sync-handler]
+            [logseq.db.sqlite.export :as sqlite-export]
+            [logseq.outliner.property :as outliner-property]
+            [promesa.core :as p]))
+
+(defn- request!
+  "One semantic API request through the real handler; returns {:status :body}."
+  [self method path body]
+  (p/let [url (str "http://localhost" path (if (string/includes? path "?") "&" "?") "graph-id=graph-1")
+          response (sync-handler/handle-http
+                    self
+                    (js/Request. url (clj->js (cond-> {:method method
+                                                       :headers {"content-type" "application/json"}}
+                                                body (assoc :body (js/JSON.stringify (clj->js body)))))))
+          text (.text response)]
+    {:status (.-status response)
+     :body (when (seq text) (js->clj (js/JSON.parse text) :keywordize-keys true))}))
+
+(defn- ident-str [ident] (subs (str ident) 1))
+
+(defn- entity [conn id] (d/entity @conn [:block/uuid id]))
+
+(defn- graph!
+  "A fresh graph as the namespace doc describes it, with for-client and clients limited to Client."
+  []
+  (p/let [conn (sqlite-export/create-conn)
+          self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true}
+          tag! (fn [title] (p/let [r (request! self "POST" "/semantic/tags" {:title title})]
+                             (entity conn (uuid (get-in r [:body :uuid])))))
+          client (tag! "Client")
+          service (tag! "Service")
+          vip (tag! "VIP")
+          _ (d/transact! conn [[:db/add (:db/id vip) :logseq.property.class/extends (:db/id client)]])
+          page-id (random-uuid)
+          [acme audit acme-ltd beta gamma globex] (repeatedly 6 random-uuid)
+          blocks (vec (repeatedly 6 random-uuid))
+          page (fn [id title tags]
+                 {:block/uuid id :block/name (string/lower-case title) :block/title title
+                  :block/tags (into #{:logseq.class/Page} tags) :block/created-at 1 :block/updated-at 1})
+          _ (d/transact! conn (concat
+                               [(page page-id "Notes" [])
+                                (page acme-ltd "Acme Ltd" [])
+                                (page beta "Beta Ltd" [])
+                                (page gamma "Gamma Ltd" [])
+                                (assoc (page globex "Globex" []) :db/ident :user.page/globex)
+                                (page acme "Acme" [(:db/id client)])
+                                (page audit "Audit" [(:db/id service)])]
+                               (map-indexed (fn [index id]
+                                              {:block/uuid id :block/title (str "Block " index)
+                                               :block/page [:block/uuid page-id]
+                                               :block/parent [:block/uuid page-id]
+                                               :block/order (str "a" index)
+                                               :block/created-at 1 :block/updated-at 1})
+                                            blocks)))
+          for-client (outliner-property/upsert-property!
+                      conn nil {:logseq.property/type :node :db/cardinality :db.cardinality/one}
+                      {:property-name "for-client"})
+          clients (outliner-property/upsert-property!
+                   conn nil {:logseq.property/type :node :db/cardinality :db.cardinality/many}
+                   {:property-name "clients"})
+          for-client (:db/ident for-client)
+          clients (:db/ident clients)
+          r1 (request! self "PATCH" (str "/semantic/properties/" (js/encodeURIComponent (ident-str for-client)))
+                       {:classes {:set ["Client"]}})
+          r2 (request! self "PATCH" (str "/semantic/properties/" (js/encodeURIComponent (ident-str clients)))
+                       {:classes {:set ["Client"]}})]
+    (is (= [200 200] [(:status r1) (:status r2)]) "for-client and clients are limited to Client")
+    {:conn conn :self self :page-id page-id :blocks blocks
+     :client client :service service :vip vip
+     :acme acme :audit audit :acme-ltd acme-ltd :beta beta :gamma gamma :globex globex
+     :for-client for-client :clients clients
+     :fc (ident-str for-client) :cl (ident-str clients)}))
+
+(defn- run [done f]
+  (-> (p/let [g (graph!)] (f g))
+      (p/catch #(is false (str %)))
+      (p/finally done)))
+
+(defn- stored [conn id property]
+  (let [value (get (entity conn id) property)]
+    (if (set? value) (set (map :block/uuid value)) (:block/uuid value))))
+
+(defn- tag-titles [conn id]
+  (set (map :block/title (:block/tags (entity conn id)))))
+
+(defn- batch-set! [self entries & [opts]]
+  (request! self "POST" "/semantic/block-properties/batch-set" (merge {:entries entries} opts)))
+
+(defn- tag-entry [page tag]
+  {:block-id (str page) :property-id "block/tags" :value tag})
+
+(defn- permutations [xs]
+  (if (empty? xs)
+    [[]]
+    (for [x xs
+          rest-perm (permutations (remove #{x} xs))]
+      (cons x rest-perm))))
+
+(deftest batch-set-sees-tag-from-earlier-entry-test
+  ;; Entry 0 makes an untagged page a Client; entry 1 sets for-client to it. Each way of naming
+  ;; the value reaches the class check: a title (title-candidates), a UUID, an ident and a db id
+  ;; (class-refusal).
+  (async done
+    (run done
+      (fn [{:keys [conn self blocks acme-ltd beta gamma globex for-client fc]}]
+        (let [[b0 b1 b2 b3] blocks
+              gamma-id (:db/id (entity conn gamma))]
+          (p/let [by-title (batch-set! self [(tag-entry acme-ltd "Client")
+                                             {:block-id (str b0) :property-id fc :value "Acme Ltd"}])
+                  by-uuid (batch-set! self [(tag-entry beta "Client")
+                                            {:block-id (str b1) :property-id fc :value (str beta)}])
+                  by-db-id (batch-set! self [(tag-entry gamma "Client")
+                                             {:block-id (str b2) :property-id fc :value gamma-id}])
+                  by-ident (batch-set! self [(tag-entry globex "Client")
+                                             {:block-id (str b3) :property-id fc :value "user.page/globex"}])]
+            (doseq [[label response block page] [["title" by-title b0 acme-ltd]
+                                                 ["UUID" by-uuid b1 beta]
+                                                 ["db id" by-db-id b2 gamma]
+                                                 ["ident" by-ident b3 globex]]]
+              (testing (str "value by " label)
+                (is (= 200 (:status response)) (str (:body response)))
+                (is (= page (stored conn block for-client)) "the value reads back")
+                (is (contains? (tag-titles conn page) "Client") "the tag reads back")))))))))
+
+(deftest batch-set-sees-tag-from-later-entry-test
+  ;; The final state is valid whichever entry comes first.
+  (async done
+    (run done
+      (fn [{:keys [conn self blocks acme-ltd beta gamma globex for-client fc]}]
+        (let [[b0 b1 b2 b3] blocks
+              gamma-id (:db/id (entity conn gamma))]
+          (p/let [by-title (batch-set! self [{:block-id (str b0) :property-id fc :value "Acme Ltd"}
+                                             (tag-entry acme-ltd "Client")])
+                  by-uuid (batch-set! self [{:block-id (str b1) :property-id fc :value (str beta)}
+                                            (tag-entry beta "Client")])
+                  by-db-id (batch-set! self [{:block-id (str b2) :property-id fc :value gamma-id}
+                                             (tag-entry gamma "Client")])
+                  by-ident (batch-set! self [{:block-id (str b3) :property-id fc :value "user.page/globex"}
+                                             (tag-entry globex "Client")])]
+            (doseq [[label response block page] [["title" by-title b0 acme-ltd]
+                                                 ["UUID" by-uuid b1 beta]
+                                                 ["db id" by-db-id b2 gamma]
+                                                 ["ident" by-ident b3 globex]]]
+              (testing (str "value by " label)
+                (is (= 200 (:status response)) (str (:body response)))
+                (is (= page (stored conn block for-client)) "the value reads back")
+                (is (contains? (tag-titles conn page) "Client") "the tag reads back")))))))))
+
+(deftest batch-set-tag-forms-test
+  ;; The other ways a batch can make the page an object of the class: a subclass (VIP extends
+  ;; Client), a tag list under isResetExistingValues, and a tag given by UUID.
+  (async done
+    (run done
+      (fn [{:keys [conn self blocks client acme-ltd beta gamma for-client fc]}]
+        (let [[b0 b1 b2] blocks]
+          (p/let [subclass (batch-set! self [(tag-entry acme-ltd "VIP")
+                                             {:block-id (str b0) :property-id fc :value (str acme-ltd)}])
+                  reset-list (batch-set! self [(tag-entry beta ["Client"])
+                                               {:block-id (str b1) :property-id fc :value (str beta)}]
+                                         {:isResetExistingValues true})
+                  tag-by-uuid (batch-set! self [(tag-entry gamma (str (:block/uuid client)))
+                                                {:block-id (str b2) :property-id fc :value "Gamma Ltd"}])]
+            (is (= 200 (:status subclass)) (str (:body subclass)))
+            (is (= acme-ltd (stored conn b0 for-client)))
+            (is (= 200 (:status reset-list)) (str (:body reset-list)))
+            (is (= beta (stored conn b1 for-client)))
+            (is (= 200 (:status tag-by-uuid)) (str (:body tag-by-uuid)))
+            (is (= gamma (stored conn b2 for-client)))))))))
+
+(deftest batch-set-chain-in-every-order-test
+  ;; Three entries: tag Acme Ltd with Client, set b0's for-client to it by UUID, and set b1's
+  ;; clients to [Acme Ltd, Acme] by title. Every order has the same valid final state.
+  (async done
+    (-> (p/all
+         (for [order (permutations [:tag :one :many])]
+           (p/let [{:keys [conn self blocks acme acme-ltd for-client clients fc cl]} (graph!)
+                   [b0 b1] blocks
+                   entry {:tag (tag-entry acme-ltd "Client")
+                          :one {:block-id (str b0) :property-id fc :value (str acme-ltd)}
+                          :many {:block-id (str b1) :property-id cl :value ["Acme Ltd" "Acme"]}}
+                   response (batch-set! self (mapv entry order))]
+             (testing (str "order " (pr-str order))
+               (is (= 200 (:status response)) (str (:body response)))
+               (is (= acme-ltd (stored conn b0 for-client)))
+               (is (= #{acme-ltd acme} (stored conn b1 clients)))
+               (is (contains? (tag-titles conn acme-ltd) "Client"))))))
+        (p/catch #(is false (str %)))
+        (p/finally done))))
+
+(deftest batch-set-wrong-class-still-refused-test
+  ;; Tagging the page with a class that isn't the property's doesn't let it through: the batch is
+  ;; refused naming the entry, in either order, and nothing is written.
+  (async done
+    (run done
+      (fn [{:keys [conn self blocks acme-ltd beta fc for-client]}]
+        (let [[b0 b1 b2] blocks]
+          (p/let [by-uuid (batch-set! self [(tag-entry beta "Service")
+                                            {:block-id (str b0) :property-id fc :value (str beta)}])
+                  reversed (batch-set! self [{:block-id (str b1) :property-id fc :value (str beta)}
+                                             (tag-entry beta "Service")])
+                  by-title (batch-set! self [(tag-entry acme-ltd "Service")
+                                             {:block-id (str b2) :property-id fc :value "Acme Ltd"}])]
+            (is (= 400 (:status by-uuid)) (str (:body by-uuid)))
+            (is (= (str "entry 1: no #Client object " beta) (get-in by-uuid [:body :error])))
+            (is (= 400 (:status reversed)) (str (:body reversed)))
+            (is (= (str "entry 0: no #Client object " beta) (get-in reversed [:body :error])))
+            (is (= 400 (:status by-title)) (str (:body by-title)))
+            (is (= "entry 1: no #Client object titled \"Acme Ltd\"" (get-in by-title [:body :error])))
+            (is (= #{"Page"} (tag-titles conn beta)) "the tag entry isn't written")
+            (is (= #{"Page"} (tag-titles conn acme-ltd)))
+            (doseq [b [b0 b1 b2]]
+              (is (nil? (stored conn b for-client)) "no value is written"))))))))
+
+(deftest batch-set-reset-removing-class-refused-test
+  ;; The converse: under isResetExistingValues a tag list [Service] takes Client away from Acme,
+  ;; so a for-client value of Acme elsewhere in the batch would be out of class once the batch
+  ;; applies. The outliner doesn't check classes on server writes, so the handler must refuse it,
+  ;; naming the entry that sets the value, in either order and however Acme is named. Each case
+  ;; runs on its own graph, so one wrongly accepted batch can't change the next.
+  (async done
+    (-> (p/all
+         (for [[label form tag-first? expected]
+               [["UUID, tag entry first" :uuid true "entry 1: no #Client object %s"]
+                ["UUID, value entry first" :uuid false "entry 0: no #Client object %s"]
+                ["db id, tag entry first" :db-id true "entry 1: no #Client object %d"]
+                ["title, tag entry first" :title true "entry 1: no #Client object titled \"Acme\""]
+                ["title, value entry first" :title false "entry 0: no #Client object titled \"Acme\""]]]
+           (p/let [{:keys [conn self blocks acme fc for-client]} (graph!)
+                   b0 (first blocks)
+                   acme-id (:db/id (entity conn acme))
+                   value (case form :uuid (str acme) :db-id acme-id :title "Acme")
+                   entries [(tag-entry acme ["Service"])
+                            {:block-id (str b0) :property-id fc :value value}]
+                   response (batch-set! self (if tag-first? entries (vec (reverse entries)))
+                                        {:isResetExistingValues true})]
+             (testing label
+               (is (= 400 (:status response)) (str (:body response)))
+               (is (= (-> expected
+                          (string/replace "%s" (str acme))
+                          (string/replace "%d" (str acme-id)))
+                      (get-in response [:body :error])))
+               (is (contains? (tag-titles conn acme) "Client") "Acme keeps Client")
+               (is (nil? (stored conn b0 for-client)) "no out-of-class value is stored")))))
+        (p/catch #(is false (str %)))
+        (p/finally done))))
+
+(deftest batch-set-reset-keeps-private-tags-test
+  ;; Under reset a tag list replaces a page's user tags but the page keeps the private tags it
+  ;; holds (Page), as set-prepared-tags! writes them. So a property limited to Page still takes the
+  ;; page as a value in the same batch: the final state keeps Page.
+  (async done
+    (run done
+      (fn [{:keys [conn self blocks acme-ltd]}]
+        (p/let [about (outliner-property/upsert-property!
+                       conn nil {:logseq.property/type :node :db/cardinality :db.cardinality/one}
+                       {:property-name "about-page"})
+                about (:db/ident about)
+                limited (request! self "PATCH" (str "/semantic/properties/" (js/encodeURIComponent (ident-str about)))
+                                  {:classes {:set ["Page"]}})
+                b0 (first blocks)
+                response (batch-set! self [(tag-entry acme-ltd ["Client"])
+                                           {:block-id (str b0) :property-id (ident-str about) :value (str acme-ltd)}]
+                                     {:isResetExistingValues true})]
+          (is (= 200 (:status limited)) (str "about-page is limited to Page " (:body limited)))
+          (is (= 200 (:status response)) (str (:body response)))
+          (is (= acme-ltd (stored conn b0 about)) "the value reads back")
+          (is (= #{"Page" "Client"} (tag-titles conn acme-ltd)) "the page keeps Page and gains Client"))))))
+
+(deftest batch-set-reset-single-tag-adds-test
+  ;; Under isResetExistingValues only a tag list replaces; a single tag adds. So entry giving Acme
+  ;; (already a Client) the single tag Service leaves it a Client, and a for-client value of Acme
+  ;; elsewhere in the batch is in class once the batch applies, in either order.
+  (async done
+    (-> (p/all
+         (for [tag-first? [true false]]
+           (p/let [{:keys [conn self blocks acme fc for-client]} (graph!)
+                   b0 (first blocks)
+                   entries [(tag-entry acme "Service")
+                            {:block-id (str b0) :property-id fc :value (str acme)}]
+                   response (batch-set! self (if tag-first? entries (vec (reverse entries)))
+                                        {:isResetExistingValues true})]
+             (testing (if tag-first? "tag entry first" "value entry first")
+               (is (= 200 (:status response)) (str (:body response)))
+               (is (= acme (stored conn b0 for-client)) "the value reads back")
+               (is (= #{"Page" "Client" "Service"} (tag-titles conn acme))
+                   "the single tag adds Service and Acme keeps Client")))))
+        (p/catch #(is false (str %)))
+        (p/finally done))))
+
+(defn- insert-batch! [self entries]
+  (request! self "POST" "/semantic/block-trees/batch" {:entries entries}))
+
+(deftest batch-insert-sees-tag-from-another-entry-test
+  ;; batchInsertBlockTrees: one entry tags an existing page with Client through its properties,
+  ;; another inserts a block whose for-client is that page. Either order, a title or a UUID, both
+  ;; in one entry, and a tag entry that names its page by title (page) rather than target-id.
+  (async done
+    (run done
+      (fn [{:keys [conn self page-id acme-ltd beta gamma globex for-client fc]}]
+        (let [[n0 n1 n2 n3] (repeatedly 4 random-uuid)
+              insert (fn [id value] {:target-id (str page-id)
+                                     :blocks [{:uuid (str id) :title "Inserted" :properties {fc value}}]})
+              tag (fn [page] {:target-id (str page) :properties {"Tags" "Client"}})]
+          (p/let [tag-first (insert-batch! self [(tag acme-ltd) (insert n0 "Acme Ltd")])
+                  insert-first (insert-batch! self [(insert n1 (str beta)) (tag beta)])
+                  one-entry (insert-batch! self [{:target-id (str gamma) :properties {"Tags" "Client"}
+                                                  :blocks [{:uuid (str n2) :title "Inserted"
+                                                            :properties {fc "Gamma Ltd"}}]}])
+                  by-page-title (insert-batch! self [(insert n3 (str globex))
+                                                     {:page "Globex" :properties {"Tags" "Client"}}])]
+            (doseq [[label response block page] [["tag entry first" tag-first n0 acme-ltd]
+                                                 ["insert entry first" insert-first n1 beta]
+                                                 ["one entry" one-entry n2 gamma]
+                                                 ["tag entry by page title" by-page-title n3 globex]]]
+              (testing label
+                (is (= 201 (:status response)) (str (:body response)))
+                (is (= page (stored conn block for-client)) "the value reads back")
+                (is (contains? (tag-titles conn page) "Client") "the tag reads back")))))))))
+
+(deftest batch-insert-wrong-class-still-refused-test
+  (async done
+    (run done
+      (fn [{:keys [conn self page-id beta fc]}]
+        (let [n0 (random-uuid)]
+          (p/let [response (insert-batch! self [{:target-id (str beta) :properties {"Tags" "Service"}}
+                                                {:target-id (str page-id)
+                                                 :blocks [{:uuid (str n0) :title "Inserted"
+                                                           :properties {fc (str beta)}}]}])]
+            (is (= 400 (:status response)) (str (:body response)))
+            (is (string/starts-with? (str (get-in response [:body :error])) "entries[1]")
+                (str (:body response)))
+            (is (string/includes? (str (get-in response [:body :error])) (str "no #Client object " beta)))
+            (is (= #{"Page"} (tag-titles conn beta)) "the tag entry isn't written")
+            (is (nil? (entity conn n0)) "the block isn't inserted")))))))
