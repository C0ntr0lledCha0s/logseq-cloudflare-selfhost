+                       (:breadcrumb (get (by-uuid (get-in edited [:body :blocks])) (str (:details ids))))))
+                (is (< (:t start) (get-in edited [:body :t])))
+                (is (= [(str (:unrelated ids))] (get-in deleted [:body :removed])))))))))
