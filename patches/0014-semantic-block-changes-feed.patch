+                      edited (changes self since)
+                      _ (d/transact! conn [[:db/retractEntity [:block/uuid (:unrelated ids)]]])
+                      deleted (changes self since)]
+                (is (= {:blocks [] :removed []} (select-keys (:body unchanged) [:blocks :removed])))
