+(deftest incremental-listing-is-gone-after-reset-or-mismatch-test
+  (async done
+         (async-test
+          done
+          (fn [sql]
+            (let [self (new-self sql)]
+              (p/let [{start :body} (changes self "")
+                      wrong-epoch (changes self (str "&since=" (:t start) "&epoch=other"))
+                      ahead (changes self (str "&since=" (inc (:t start)) "&epoch=" (:epoch start)))
+                      missing-epoch (changes self (str "&since=" (:t start)))
+                      bad-since (changes self (str "&since=-1&epoch=" (:epoch start)))
+                      _ (common/sql-exec sql "delete from sync_meta")
+                      after-reset (changes self (str "&since=0&epoch=" (:epoch start)))
+                      {relisted :body} (changes self "")]
+                (is (= 410 (:status wrong-epoch)))
+                (is (= 410 (:status ahead)))
+                (is (= 400 (:status missing-epoch)))
+                (is (= 400 (:status bad-since)))
+                (is (= 410 (:status after-reset)) "clearing sync_meta, as an import does, ends the epoch")
+                (is (not= (:epoch start) (:epoch relisted)))))))))
+
