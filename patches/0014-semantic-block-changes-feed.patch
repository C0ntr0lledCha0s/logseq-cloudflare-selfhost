+(ns logseq.db-sync.semantic-block-changes-test
+  (:require ["better-sqlite3" :as sqlite3]
+            [cljs.test :refer [async deftest is]]
+            [clojure.string :as string]
+            [datascript.core :as d]
+            [logseq.db-sync.common :as common]
+            [logseq.db-sync.storage :as storage]
+            [logseq.db-sync.worker.handler.sync :as sync-handler]
+            [logseq.db-sync.worker.routes.semantic :as semantic-routes]
+            [promesa.core :as p]))
+
+(def sqlite (if (find-ns 'nbb.core) (aget sqlite3 "default") sqlite3))
+
+(defn- with-memory-sql-async [f]
+  (let [db (new sqlite ":memory:" nil)
+        sql #js {:_db db
+                 :transaction (fn [f] ((.transaction db f)))
+                 :exec (fn [sql-str & args]
+                         (let [^js stmt (.prepare db sql-str)]
+                           (if (string/starts-with? (-> sql-str string/trim string/lower-case) "select")
+                             (.apply (.-all stmt) stmt (to-array args))
+                             (do (.apply (.-run stmt) stmt (to-array args)) nil))))
+                 :close (fn [] (.close db))}]
+    (-> (f sql)
+        (p/finally #(.close sql)))))
+
+(defn- changes [self query]
+  (p/let [response (sync-handler/handle-http
+                    self (js/Request. (str "http://localhost/semantic/block-changes?graph-id=graph-1" query)))
+          text (.text response)]
+    {:status (.-status response)
+     :body (js->clj (js/JSON.parse text) :keywordize-keys true)}))
+
+(defn- by-uuid [blocks]
+  (into {} (map (juxt :uuid identity)) blocks))
+
+(defn- async-test [done f]
+  (-> (with-memory-sql-async f)
+      (p/then (fn [] (done)))
+      (p/catch (fn [error]
+                 (is false (str error))
+                 (done)))))
+
+(def ids
+  {:projects (random-uuid) :other (random-uuid) :private-tag (random-uuid)
+   :roadmap (random-uuid) :ship (random-uuid) :details (random-uuid) :hidden (random-uuid)
+   :blank (random-uuid) :value (random-uuid) :notes (random-uuid) :unrelated (random-uuid)})
+
+(defn- ref [k] [:block/uuid (get ids k)])
+
+(defn- seed! [conn]
+  (d/transact! conn [{:db/ident :logseq.class/Page}
+                     {:db/ident :logseq.class/Tag}
+                     {:db/ident :user.property/note}])
+  (d/transact! conn [{:block/uuid (:private-tag ids) :block/name "private" :block/title "Private"
+                      :block/tags :logseq.class/Tag}
+                     {:block/uuid (:projects ids) :block/name "projects" :block/title "Projects"
+                      :block/tags #{:logseq.class/Page}}
+                     {:block/uuid (:other ids) :block/name "other" :block/title "Other"
+                      :block/tags #{:logseq.class/Page}}
+                     {:block/uuid (:notes ids) :block/name "notes" :block/title "Notes"
+                      :block/tags #{:logseq.class/Page [:block/uuid (:private-tag ids)]}}])
+  (d/transact! conn [{:block/uuid (:roadmap ids) :block/title (str "Roadmap for [[" (:other ids) "]]")
+                      :block/refs #{(ref :other)}
+                      :block/page (ref :projects) :block/parent (ref :projects) :block/order "a0"}
+                     {:block/uuid (:ship ids) :block/title "Ship v2"
+                      :block/page (ref :projects) :block/parent (ref :roadmap) :block/order "a0"}
+                     {:block/uuid (:details ids) :block/title "Write the release notes"
+                      :block/page (ref :projects) :block/parent (ref :ship) :block/order "a0"}
+                     {:block/uuid (:hidden ids) :block/title "Hidden"
+                      :logseq.property/hide? true
+                      :block/page (ref :projects) :block/parent (ref :projects) :block/order "a1"}
+                     {:block/uuid (:blank ids) :block/title "  "
+                      :block/page (ref :projects) :block/parent (ref :projects) :block/order "a2"}
+                     {:block/uuid (:value ids) :block/title "A property value"
+                      :logseq.property/created-from-property :user.property/note
+                      :block/page (ref :projects) :block/parent (ref :projects) :block/order "a3"}
+                     {:block/uuid (:unrelated ids) :block/title "Diary entry"
+                      :block/page (ref :notes) :block/parent (ref :notes) :block/order "a0"}]))
+
+(defn- new-self [sql]
+  (storage/init-schema! sql)
+  (let [conn (storage/open-conn sql)]
+    (seed! conn)
+    #js {:sql sql :conn conn :schema-ready true}))
+
+(deftest public-route-maps-to-the-internal-feed-test
+  (let [operation (semantic-routes/match-public "GET" "/api/v1/graphs/graph-1/block-changes")
+        spec (semantic-routes/openapi-document "https://issuer.example.com")
+        get-op (get-in spec [:paths "/api/v1/graphs/{graph-id}/block-changes" :get])]
+    (is (= "listBlockChanges" (:operation-id operation)))
+    (is (= :read (:rate-class operation)))
+    (is (= "logseq/read" (:scope operation)))
+    (is (= :semantic/block-changes (:handler (semantic-routes/match-internal "GET" "/semantic/block-changes"))))
+    (is (= "listBlockChanges" (:operationId get-op)))
+    (is (= #{"graph-id" "limit" "cursor" "since" "epoch"} (set (map :name (:parameters get-op)))))
+    (is (contains? (:responses get-op) "410"))
+    (is (some? (get-in spec [:components :schemas :BlockChangesResponse])))))
+
+(deftest full-listing-returns-content-blocks-with-context-test
+  (async done
+         (async-test
+          done
+          (fn [sql]
+            (let [self (new-self sql)]
+              (p/let [{:keys [status body]} (changes self "")
+                      blocks (by-uuid (:blocks body))
+                      roadmap (get blocks (str (:roadmap ids)))
+                      details (get blocks (str (:details ids)))
+                      diary (get blocks (str (:unrelated ids)))]
+                (is (= 200 status) (pr-str body))
+                (is (string? (:epoch body)))
+                (is (= (storage/get-t sql) (:t body)))
+                (is (pos? (:t body)))
+                (is (= [] (:removed body)))
+                (is (nil? (:next-cursor body)))
+                (is (= #{(:roadmap ids) (:ship ids) (:details ids) (:unrelated ids)}
+                       (set (map (comp uuid :uuid) (:blocks body))))
+                    "pages, tags, hidden, blank and property-value blocks are left out")
+                (is (= (sort (map :uuid (:blocks body))) (map :uuid (:blocks body))) "UUID order")
+                (is (= "Roadmap for [[Other]]" (:text roadmap)) "references show titles")
+                (is (= {:page-id (str (:projects ids)) :page-title "Projects" :breadcrumb []}
+                       (select-keys roadmap [:page-id :page-title :breadcrumb])))
+                (is (= ["Roadmap for [[Other]]" "Ship v2"] (:breadcrumb details)))
+                (is (= "Write the release notes" (:text details)))
+                (is (= ["Private"] (:tags diary)) "tags on the page are inherited")
+                (is (= [] (:tags details)))))))))
+
+(deftest full-listing-pages-by-uuid-cursor-test
+  (async done
+         (async-test
+          done
+          (fn [sql]
+            (let [self (new-self sql)]
+              (p/let [first-page (changes self "&limit=3")
+                      second-page (changes self (str "&limit=3&cursor="
+                                                     (js/encodeURIComponent (get-in first-page [:body :next-cursor]))))
+                      bad-cursor (changes self "&cursor=not-a-cursor")
+                      bad-limit (changes self "&limit=0")]
+                (is (= 3 (count (get-in first-page [:body :blocks]))))
+                (is (string? (get-in first-page [:body :next-cursor])))
+                (is (= 1 (count (get-in second-page [:body :blocks]))))
+                (is (nil? (get-in second-page [:body :next-cursor])))
