+;; listBlockChanges feeds an external search index. Without `since` it lists every content block
+;; in UUID order; with `since` (a graph t from an earlier response) and that response's `epoch`, it
+;; lists the blocks whose indexed text may have changed since then, read from the tx log, plus the
+;; UUIDs that are no longer content blocks. The epoch lives in sync_meta, which a snapshot import
+;; or reset clears, so a client holding an old t learns its position is gone (410) and lists again.
+(def ^:private feed-epoch-key :semantic-feed-epoch)
+(def ^:private max-feed-txs 5000)
+(def ^:private max-feed-changes 20000)
+
+;; Attributes whose change alters the text indexed for the entity's descendants (page title and
+;; breadcrumb) or whether they are indexed at all (tags, hidden, deleted, moved).
+(def ^:private feed-subtree-attrs
+  #{:block/title :block/name :block/parent :block/page :block/tags
+    :logseq.property/hide? :logseq.property/deleted-at})
+
+(defn- feed-epoch! [^js sql]
+  (or (storage/get-meta sql feed-epoch-key)
+      (let [epoch (str (random-uuid))]
+        (storage/set-meta! sql feed-epoch-key epoch)
+        epoch)))
+
+(defn- feed-block?
+  "A content block: not a page, tag, property or asset, not a property value, visible, with text."
+  [entity]
+  (and (some? entity)
+       (= "block" (block-kind entity))
+       (some? (:block/page entity))
+       (nil? (:logseq.property/created-from-property entity))
+       (not (entity-util/hidden? entity))
+       (not (string/blank? (:block/title entity)))))
+
+(defn- feed-text [entity]
+  (or (db-content/recur-replace-uuid-in-block-title entity) ""))
+
+(defn- feed-ancestors
+  "The block's ancestors below its page, outermost first."
+  [block]
+  (let [page-id (:db/id (:block/page block))]
+    (loop [parent (:block/parent block)
+           above ()]
+      (if (or (nil? parent) (= page-id (:db/id parent)))
+        (vec above)
+        (recur (:block/parent parent) (conj above parent))))))
+
+(defn- feed-block-response [block]
+  (let [page (:block/page block)
+        above (feed-ancestors block)]
+    {:uuid (uuid-string (:block/uuid block))
+     :page-id (uuid-string (:block/uuid page))
+     :page-title (:block/title page)
+     :breadcrumb (mapv feed-text above)
+     :text (feed-text block)
+     :tags (->> (concat [page] above [block])
+                (mapcat :block/tags)
+                (keep :block/title)
+                distinct
+                sort
+                vec)
+     :updated-at (:block/updated-at block)}))
+
+(defn- tx-item-uuid [e]
+  (cond
+    (and (vector? e) (= :block/uuid (first e))) (second e)
+    (uuid? e) e
+    (string? e) (parse-uuid e)
+    :else nil))
+
+(defn- touched-entities
+  "uuid -> set of attributes changed on it (:db/retractEntity for a retraction) in the tx log after t."
+  [^js sql since]
+  (reduce (fn [touched {:keys [tx]}]
+            (reduce (fn [touched item]
+                      (let [[op e a] item
+                            id (tx-item-uuid e)
+                            attr (if (= :db/retractEntity op) op a)]
+                        (if (and id attr)
+                          (update touched id (fnil conj #{}) attr)
+                          touched)))
+                    touched
+                    (common/read-transit tx)))
+          {}
+          (storage/fetch-tx-since sql since)))
+
+(defn- subtree-ids
+  "Entity ids of `entity` and everything under it: a page's blocks, or a block's descendants."
+  [db entity]
+  (if (:block/page entity)
+    (loop [pending [entity] ids []]
+      (if-let [e (first pending)]
+        (recur (into (subvec pending 1) (:block/_parent e)) (conj ids (:db/id e)))
+        ids))
+    (cons (:db/id entity) (map :e (d/datoms db :avet :block/page (:db/id entity))))))
+
+(defn- changed-uuids
+  "Every UUID whose indexed text or eligibility may have changed with these tx-log changes."
+  [db touched]
+  (let [ids (mapcat (fn [[id attrs]]
+                      (when-let [entity (d/entity db [:block/uuid id])]
+                        (let [eid (:db/id entity)]
+                          (cond
+                            ;; A renamed entity also changes the text that references or tags it.
+                            (contains? attrs :block/title)
+                            (mapcat #(subtree-ids db (d/entity db %))
+                                    (concat [eid]
+                                            (map :e (d/datoms db :avet :block/refs eid))
+                                            (map :e (d/datoms db :avet :block/tags eid))))
+                            (some feed-subtree-attrs attrs) (subtree-ids db entity)
+                            :else [eid]))))
+                    touched)]
+    (into (set (keys touched))
+          (keep #(:block/uuid (d/entity db %)))
+          ids)))
+
+(defn- feed-page [ids cursor limit]
+  (let [remaining (if cursor (drop-while #(not (pos? (compare (str %) cursor))) ids) ids)
+        selected (vec (take (inc limit) remaining))
+        page (vec (take limit selected))]
+    {:page page
+     :next-cursor (when (> (count selected) limit) (encode-cursor ["uuid" (str (last page))]))}))
+
+(defn- full-feed [db cursor limit]
+  (let [from (some-> cursor parse-uuid)
+        blocks (->> (d/index-range db :block/uuid from nil)
+                    (remove #(= from (:v %)))
+                    (map #(d/entity db (:e %)))
+                    (filter feed-block?)
+                    (take (inc limit))
+                    vec)
+        page (vec (take limit blocks))]
+    {:blocks (mapv feed-block-response page)
+     :removed []
+     :next-cursor (when (> (count blocks) limit)
+                    (encode-cursor ["uuid" (str (:block/uuid (last page)))]))}))
+
+(defn- incremental-feed [db touched cursor limit]
+  (let [ids (sort-by str (changed-uuids db touched))]
+    (when (<= (count ids) max-feed-changes)
+      (let [{:keys [page next-cursor]} (feed-page ids cursor limit)
+            entities (map #(d/entity db [:block/uuid %]) page)]
+        {:blocks (mapv feed-block-response (filter feed-block? entities))
+         :removed (mapv (fn [[id _]] (str id))
+                        (remove (fn [[_ entity]] (feed-block? entity)) (map vector page entities)))
+         :next-cursor next-cursor}))))
+
+(defn- handle-block-changes [{:keys [^js self ^js url db e2ee?]}]
+  (let [sql (.-sql self)
+        params (.-searchParams url)
+        raw-since (.get params "since")
+        raw-epoch (.get params "epoch")
+        since (parse-timestamp raw-since)
+        {:keys [limit raw-cursor cursor]} (pagination-options url)
+        cursor-uuid (when (and (= "uuid" (first cursor)) (parse-uuid (second cursor))) (second cursor))]
+    (cond
+      e2ee? (http/error-response "block changes are unavailable for E2EE graphs" 409)
+      (nil? limit) (http/bad-request "invalid limit")
+      (and raw-cursor (nil? cursor-uuid)) (http/bad-request "invalid cursor")
+      (not= (nil? raw-since) (nil? raw-epoch)) (http/bad-request "since and epoch go together")
+      (= ::invalid since) (http/bad-request "invalid since")
+      :else
+      (let [epoch (feed-epoch! sql)
+            t (storage/get-t sql)
+            feed (cond
+                   (nil? since) (full-feed db cursor-uuid limit)
+                   (or (not= raw-epoch epoch) (> since t) (> (storage/tx-count-since sql since) max-feed-txs)) nil
+                   :else (incremental-feed db (touched-entities sql since) cursor-uuid limit))]
+        (if feed
+          (http/json-response nil (assoc feed :epoch epoch :t t))
+          (http/error-response "changes since that point are no longer available; list again without since" 410))))))
+
 (def ^:private page-handlers
   #{:semantic/pages-list :semantic/pages-create :semantic/pages-blocks :semantic/pages-outline
     :semantic/pages-references :semantic/pages-get
@@ -1979,6 +2148,7 @@
