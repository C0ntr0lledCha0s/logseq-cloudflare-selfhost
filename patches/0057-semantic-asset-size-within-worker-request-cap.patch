diff --git a/deps/db-sync/test/logseq/db_sync/semantic_asset_request_cap_test.cljs b/deps/db-sync/test/logseq/db_sync/semantic_asset_request_cap_test.cljs
new file mode 100644
index 0000000..1e84862
--- /dev/null
+++ b/deps/db-sync/test/logseq/db_sync/semantic_asset_request_cap_test.cljs
@@ -0,0 +1,121 @@
+(ns logseq.db-sync.semantic-asset-request-cap-test
+  "createAsset sends a file in one request through the Worker: this deployment wires no presigned
+  direct upload (patch 0020), and Cloudflare passes a Worker at most 100 MB of request body on the
+  Free and Pro plans. The route must refuse, up front and naming the size and the limit, a file
+  whose request body would be larger than that, and say so in its OpenAPI text, instead of
+  advertising upstream's 200 MiB. The body is the plaintext file, its E2EE Transit package, or
+  either of those base64-encoded, so each transfer form has its own largest file."
+  (:require [cljs.test :refer [async deftest is testing]]
+            [clojure.string :as string]
+            [datascript.core :as d]
+            [logseq.db :as ldb]
+            [logseq.db-sync.test-sql :as test-sql]
+            [logseq.db-sync.worker.handler.sync :as sync-handler]
+            [logseq.db-sync.worker.routes.semantic :as semantic-routes]
+            [logseq.db.sqlite.export :as sqlite-export]
+            [logseq.outliner.page :as outliner-page]
+            [promesa.core :as p]))
+
+(def ^:private limit 100000000)
+
+(defn- make-self [conn puts]
+  (let [bucket #js {:put (fn [key payload _options]
+                           ;; Read the body as R2 would, so a decoding or validating stream runs.
+                           (p/let [_ (.arrayBuffer (js/Response. payload))]
+                             (swap! puts conj key)
+                             #js {}))
+                    :delete (fn [_key] (p/resolved nil))}]
+    #js {:conn conn :sql (test-sql/make-sql) :schema-ready true
+         :env #js {"LOGSEQ_SYNC_ASSETS" bucket "TIMEZONE" "UTC"}}))
+
+(def ^:private encrypted-title
+  "A title in the shape an E2EE graph requires (a Transit [iv ciphertext] package)."
+  (ldb/write-transit-str [(js/Uint8Array. 12) (js/Uint8Array. 16)]))
+
+(defn- upload!
+  "createAsset of a four-byte file that declares `size`, sent as `encoding` on a graph that is
+  E2EE when `e2ee?`."
+  [self page-id {:keys [size encoding e2ee? checksum-char]}]
+  (let [params (js/URLSearchParams.
+                (clj->js (cond-> {:graph-id "graph-1" :file-name "big.pdf" :page-id (str page-id)
+                                  :size (str size) :checksum (apply str (repeat 64 checksum-char))}
+                           encoding (assoc :encoding encoding)
+                           e2ee? (assoc :graph-e2ee "true" :title encrypted-title))))
+        body (if (= "base64" encoding) "AQIDBA==" (js/Uint8Array. #js [1 2 3 4]))]
+    (p/let [response (sync-handler/handle-http
+                      self
+                      (js/Request. (str "http://localhost/semantic/assets?" params)
+                                   #js {:method "POST"
+                                        :headers #js {"content-type" "application/octet-stream"}
+                                        :body (js/Blob. #js [body])}))
+            text (.text response)]
+      {:status (.-status response)
+       :error (some-> (not-empty text) js/JSON.parse (aget "error"))})))
+
+(defn- asset-count [conn]
+  (count (d/datoms @conn :avet :logseq.property.asset/type)))
+
+(def ^:private refused
+  "One file over the limit for each transfer form, with the request body size it needs: the
+  smallest such file, and one far over upstream's 200 MiB."
+  [{:label "raw bytes" :size (inc limit) :body (inc limit)}
+   {:label "raw bytes over upstream's 200 MiB" :size (* 300 1024 1024) :body (* 300 1024 1024)}
+   {:label "base64" :encoding "base64" :size 75000001 :body 100000004}
+   {:label "E2EE package" :e2ee? true :size 74999964 :body 100000003}
+   {:label "E2EE package, base64" :e2ee? true :encoding "base64" :size 56249964 :body 100000004}])
+
+(def ^:private accepted
+  "The largest file for each transfer form, whose request body is at most the limit, and what
+  createAsset answers once the size check passes (the E2EE ones then refuse the four-byte body,
+  which is not an encrypted package)."
+  [{:label "raw bytes" :size limit :status 201}
+   {:label "base64" :encoding "base64" :size 75000000 :status 201}
+   {:label "E2EE package" :e2ee? true :size 74999963 :status 400 :error "invalid encrypted asset body"}
+   {:label "E2EE package, base64" :e2ee? true :encoding "base64" :size 56249963
+    :status 400 :error "invalid encrypted asset body"}])
+
+(deftest create-asset-refuses-a-file-over-the-worker-request-cap-test
+  (async done
+         (-> (p/let [conn (sqlite-export/create-conn)
+                     [_ page-id] (outliner-page/create! conn "Uploads" {})
+                     puts (atom [])
+                     self (make-self conn puts)]
+               (p/loop [n 0]
+                 (when-let [{:keys [label size body] :as entry} (get refused n)]
+                   (p/let [response (upload! self page-id (assoc entry :checksum-char (str n)))]
+                     (testing label
+                       (is (= 400 (:status response)))
+                       (is (= (str "size: a " size "-byte file is sent as a " body "-byte request body"
+                                   ", over the " limit "-byte (100 MB) limit on one upload request")
+                              (:error response)))
+                       (is (empty? @puts) "nothing reached R2")
+                       (is (zero? (asset-count conn)) "no asset block was written"))
+                     (p/recur (inc n))))))
+             (p/catch #(is false (str %)))
+             (p/finally done))))
+
+(deftest create-asset-accepts-the-largest-file-for-each-transfer-form-test
+  (async done
+         (-> (p/let [conn (sqlite-export/create-conn)
+                     [_ page-id] (outliner-page/create! conn "Uploads" {})
+                     puts (atom [])
+                     self (make-self conn puts)]
+               (p/loop [n 0]
+                 (when-let [{:keys [label status error] :as entry} (get accepted n)]
+                   (p/let [response (upload! self page-id (assoc entry :checksum-char (str (+ 5 n))))]
+                     (testing label
+                       (is (= status (:status response)))
+                       (is (= error (:error response))))
+                     (p/recur (inc n))))))
+             (p/catch #(is false (str %)))
+             (p/finally done))))
+
+(deftest create-asset-documents-the-worker-request-cap-test
+  (let [document (semantic-routes/openapi-document "https://issuer.example")
+        operation (get-in document [:paths "/api/v1/graphs/{graph-id}/assets" :post])
+        size (first (filter #(= "size" (:name %)) (:parameters operation)))]
+    (is (= "createAsset" (:operationId operation)))
+    (is (= limit (get-in size [:schema :maximum])))
+    (doseq [text [(:description operation) (:description size)]]
+      (is (not (string/includes? text "200 MiB")))
+      (is (string/includes? text "100 MB")))))
