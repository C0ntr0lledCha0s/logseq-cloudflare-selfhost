@@ -0,0 +1,263 @@
+(ns logseq.db-sync.semantic-json-number-value-test
+  "A bare JSON number given to a property is never a db id over the API (item 33). The handler's
+  resolve-ref-entity read any number as a db id, so on every write path (set, batch set, insert
+  tree, batch insert trees) a node property given 150 stored the entity with db id 150 (a built-in
+  History block) instead of the page titled \"150\"; a text property given another block's value
+  block id stored that block, now shared by two holders, and a text property given 2026 was
+  refused with the generic 'must resolve' error. A date, URL or tags value given a db id was
+  stored as that journal, URL value or class. A text property now stores the number as text, a
+  node property resolves it as a title, and a number that names nothing is refused up front,
+  naming the entry and asking for a UUID, with nothing written. Number and choice properties
+  already took numbers as values (patches 0020 and 0022) and are checked here so they stay so.
+  The graph is made through the handler: the properties topic (node), note (text), due (date),
+  link (url), count (number) and level (text with choices 150 and 7), the tags Client and 2027,
+  and a batch insert that creates the pages 150 and Notes (block A) and the journal 2026-11-06.
+  Block A holds note \"hello\" and link https://example.com, whose value blocks are the decoys."
+  (:require [cljs.test :refer [async deftest is testing]]
+            [clojure.string :as string]
+            [datascript.core :as d]
+            [logseq.db :as ldb]
+            [logseq.db-sync.test-sql :as test-sql]
+            [logseq.db-sync.worker.handler.sync :as sync-handler]
+            [logseq.db.sqlite.export :as sqlite-export]
+            [promesa.core :as p]))
+
+(defn- request!
+  "One semantic API request through the real handler; returns {:status :body}."
+  [self method path body]
+  (p/let [url (str "http://localhost" path (if (string/includes? path "?") "&" "?") "graph-id=graph-1")
+          response (sync-handler/handle-http
+                    self
+                    (js/Request. url (clj->js (cond-> {:method method
+                                                       :headers {"content-type" "application/json"}}
+                                                body (assoc :body (js/JSON.stringify (clj->js body)))))))
+          text (.text response)]
+    {:status (.-status response)
+     :body (when (seq text)
+             (try (js->clj (js/JSON.parse text) :keywordize-keys true)
+                  (catch :default _ text)))}))
+
+(defn- snapshot
+  "What a refused call must leave unchanged: the graph's last tx and its datom count."
+  [conn]
+  {:max-tx (:max-tx @conn) :datoms (count (d/datoms @conn :eavt))})
+
+(defn- notes-child [conn title]
+  (some #(when (= title (:block/title %)) %) (:block/_parent (ldb/get-page @conn "Notes"))))
+
+(defn- held
+  "The entities block `title` on Notes holds for `ident`, as a vector of {:id :title}."
+  [conn title ident]
+  (let [v (get (notes-child conn title) ident)]
+    (mapv (fn [e] {:id (:db/id e)
+                   :title (or (:block/title e) (some-> (:logseq.property/value e) str) (str (:db/ident e)))})
+          (cond (nil? v) [] (set? v) (sort-by :db/id v) :else [v]))))
+
+(defn- seed-graph []
+  (p/let [conn (sqlite-export/create-conn)
+          self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true}
+          prop! (fn [body] (p/let [r (request! self "POST" "/semantic/properties" body)]
+                             (is (= 201 (:status r)) (pr-str body r))
+                             (get-in r [:body :ident])))
+          topic (prop! {:title "topic" :type "node"})
+          note (prop! {:title "note" :type "default"})
+          due (prop! {:title "due" :type "date"})
+          link (prop! {:title "link" :type "url"})
+          count-id (prop! {:title "count" :type "number"})
+          level (prop! {:title "level" :type "default" :choices [{:title "150"} {:title "7"}]})
+          client (request! self "POST" "/semantic/tags" {:title "Client"})
+          _ (is (= 201 (:status client)) (pr-str client))
+          y2027 (request! self "POST" "/semantic/tags" {:title "2027"})
+          _ (is (= 201 (:status y2027)) (pr-str y2027))
+          seeded (request! self "POST" "/semantic/block-trees/batch"
+                           {:entries [{:page "150" :blocks [{:title "p"}]}
+                                      {:page "Notes" :blocks [{:title "A" :properties {note "hello" link "https://example.com"}}]}
+                                      {:page "2026-11-06" :blocks [{:title "j"}]}]})
+          _ (is (= 201 (:status seeded)) (pr-str seeded))
+          a (notes-child conn "A")
+          k #(keyword %)]
+    (is (= "hello" (:block/title (get a (k note)))))
+    (is (= "https://example.com" (:block/title (get a (k link)))))
+    {:conn conn :self self
+     :notes (str (:block/uuid (ldb/get-page @conn "Notes")))
+     :ids {:topic topic :note note :due due :link link :count count-id :level level :tags "block/tags"}
+     :page-150 (:db/id (ldb/get-page @conn "150"))
+     :notes-page (:db/id (ldb/get-page @conn "Notes"))
+     :journal (:db/id (ldb/get-journal-page-by-day @conn 20261106))
+     :note-vblock (:db/id (get a (k note)))
+     :link-vblock (:db/id (get a (k link)))
+     :client (:db/id (d/entity @conn [:block/uuid (uuid (get-in client [:body :uuid]))]))
+     :y2027 (:db/id (d/entity @conn [:block/uuid (uuid (get-in y2027 [:body :uuid]))]))}))
+
+(defn- with-graph [done run]
+  (-> (p/let [graph (seed-graph)] (run graph))
+      (p/catch #(is false (str % (some-> % .-stack))))
+      (p/finally done)))
+
+(def ^:private paths [:set :batch-set :tree :batch-tree])
+
+(def ^:private path-prefix
+  "How each path names the one entry it was given in a refusal."
+  {:set "" :batch-set "entry 0: " :tree "blocks[0]: " :batch-tree "entries[0].blocks[0]: "})
+
+(defn- write-four!
+  "Writes `value` to property `prop` (an ident, or block/tags) through each write path, each on its
+  own block of Notes titled `<path>-<label>`; set and batch set write to a block inserted first.
+  Returns {path {:status :error :title :unchanged?}}, :unchanged? comparing snapshots around the
+  write itself."
+  [{:keys [conn self notes]} prop value label]
+  (p/let [titles (into {} (map (fn [path] [path (str (name path) "-" label)])) paths)
+          made (request! self "POST" "/semantic/block-trees"
+                         {:target-id notes :blocks [{:title (titles :set)} {:title (titles :batch-set)}]})
+          _ (is (= 201 (:status made)) (pr-str made))
+          uuid-of #(str (:block/uuid (notes-child conn %)))
+          calls {:set #(request! self "PUT" (str "/semantic/blocks/" (uuid-of (titles :set))
+                                                 "/properties/" (js/encodeURIComponent prop))
+                                 {:value value})
+                 :batch-set #(request! self "POST" "/semantic/block-properties/batch-set"
+                                       {:entries [{:block-id (uuid-of (titles :batch-set)) :property-id prop :value value}]})
+                 :tree #(request! self "POST" "/semantic/block-trees"
+                                  {:target-id notes :blocks [{:title (titles :tree) :properties {prop value}}]})
+                 :batch-tree #(request! self "POST" "/semantic/block-trees/batch"
+                                        {:entries [{:target-id notes
+                                                    :blocks [{:title (titles :batch-tree) :properties {prop value}}]}]})}]
+    (p/loop [i 0 acc {}]
+      (if (= i (count paths))
+        acc
+        (p/let [path (nth paths i)
+                before (snapshot conn)
+                r ((calls path))]
+          (p/recur (inc i) (assoc acc path {:status (:status r)
+                                            :error (get-in r [:body :error])
+                                            :title (titles path)
+                                            :unchanged? (= before (snapshot conn))})))))))
+
+(defn- ident [graph k] (keyword (get-in graph [:ids k])))
+
+;; Before the fix: 200/201 on every path, holding {:id 150 :title "History block"}.
+(deftest node-property-number-resolves-as-a-title-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn page-150] :as graph}]
+        (p/let [results (write-four! graph (get-in graph [:ids :topic]) 150 "topic-150")]
+          (doseq [path paths :let [{:keys [status title]} (results path)]]
+            (testing (str (name path) ": topic = 150 stores the page titled 150, not entity 150")
+              (is (#{200 201} status) (pr-str (results path)))
+              (is (= [{:id page-150 :title "150"}] (held conn title (ident graph :topic)))))))))))
+
+;; Before the fix: another block's value block id stored that block (shared with block A), and 2026
+;; or 2.5 was refused with 'property value must resolve to an existing entity by UUID, ident, or title'.
+(deftest text-property-number-is-stored-as-text-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn note-vblock page-150] :as graph}]
+        (p/do
+         (p/doseq [[label value] [["vblock" note-vblock] ["2026" 2026] ["page-id" page-150] ["2.5" 2.5]]]
+          (p/let [results (write-four! graph (get-in graph [:ids :note]) value (str "note-" label))]
+            (doseq [path paths :let [{:keys [status title]} (results path)
+                                     stored (held conn title (ident graph :note))]]
+              (testing (str (name path) ": note = " value " stores the text " value)
+                (is (#{200 201} status) (pr-str (results path)))
+                (is (= [(str value)] (mapv :title stored)))
+                (is (not-any? #{note-vblock page-150} (map :id stored)) "never the entity with that db id")))))
+        (is (= "hello" (:block/title (get (notes-child conn "A") (ident graph :note))))
+            "block A's own value is untouched"))))))
+
+(defn- refused-with-uuid-hint
+  "Each path answered 400 naming its entry, the property (`prop-name`) and the number `value`, and
+  asking for a UUID, with nothing written. The generic 'must resolve to an existing entity by UUID,
+  ident, or title' error names neither the property nor the value, so it doesn't pass."
+  [results prop-name value]
+  (doseq [path paths :let [{:keys [status error unchanged?]} (results path)
+                           error (str error)]]
+    (testing (str (name path) ": " prop-name " = " value " is refused up front, naming the entry and asking for a UUID")
+      (is (= 400 status) (pr-str (results path)))
+      (is (string/starts-with? error (path-prefix path)) (pr-str error))
+      (is (string/includes? (string/lower-case error) prop-name) (pr-str error))
+      (is (string/includes? error (str value)) (pr-str error))
+      (is (string/includes? error "UUID") (pr-str error))
+      (is unchanged? "nothing is written"))))
+
+;; Before the fix: a number that is some other entity's db id (the page Notes) was stored as that
+;; entity; one that is no entity's id got the generic 'must resolve' error, with no UUID hint.
+(deftest node-property-number-matching-no-title-is-refused-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn notes-page] :as graph}]
+        (p/doseq [[label value] [["notes-page-id" notes-page] ["999999" 999999]]]
+          (p/let [results (write-four! graph (get-in graph [:ids :topic]) value (str "topic-" label))]
+            (refused-with-uuid-hint results "topic" value)
+            (doseq [path paths]
+              (is (empty? (held conn (:title (results path)) (ident graph :topic))) (name path)))))))))
+
+(deftest batch-set-refusal-names-the-entry-with-the-number-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self notes-page] :as graph}]
+        (p/let [a (str (:block/uuid (notes-child conn "A")))
+                before (snapshot conn)
+                r (request! self "POST" "/semantic/block-properties/batch-set"
+                            {:entries [{:block-id a :property-id (get-in graph [:ids :level]) :value "7"}
+                                       {:block-id a :property-id (get-in graph [:ids :topic]) :value notes-page}]})]
+          (is (= 400 (:status r)) (pr-str r))
+          (is (string/starts-with? (str (get-in r [:body :error])) "entry 1: ") (pr-str r))
+          (is (string/includes? (str (get-in r [:body :error])) "UUID") (pr-str r))
+          (is (= before (snapshot conn)) "entry 0 isn't written either"))))))
+
+;; Before the fix: due = the journal's db id stored that journal; link = another block's URL value
+;; block id stored that block (shared with A); tags = Client's db id tagged the block Client.
+(deftest date-url-and-tags-number-is-not-a-db-id-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn journal link-vblock client] :as graph}]
+        (p/doseq [[k value forbidden] [[:due journal journal]
+                                       [:link link-vblock link-vblock]
+                                       [:tags client client]]]
+          (p/let [results (write-four! graph (get-in graph [:ids k]) value (str (name k) "-" value))]
+            (refused-with-uuid-hint results (name k) value)
+            (doseq [path paths
+                    :let [stored (if (= :tags k)
+                                   (map :db/id (:block/tags (notes-child conn (:title (results path)))))
+                                   (map :id (held conn (:title (results path)) (ident graph k))))]]
+              (is (not-any? #{forbidden} stored) (str (name path) ": " (name k) " never holds entity " forbidden)))))))))
+
+;; A tags value given as a number names a tag by its title, as text does.
+(deftest tags-number-resolves-as-a-class-title-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn y2027] :as graph}]
+        (p/let [results (write-four! graph "block/tags" 2027 "tags-2027")]
+          (doseq [path paths :let [{:keys [status title]} (results path)]]
+            (testing (str (name path) ": tags = 2027 tags the block with the tag titled 2027")
+              (is (#{200 201} status) (pr-str (results path)))
+              (is (contains? (set (map :db/id (:block/tags (notes-child conn title)))) y2027)))))))))
+
+;; Number and choice properties already took a JSON number as a value (patches 0020 and 0022);
+;; these pass before the fix and must still pass after it.
+(deftest number-and-choice-properties-keep-taking-numbers-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn] :as graph}]
+        (p/let [counts (write-four! graph (get-in graph [:ids :count]) 150 "count-150")
+                levels (write-four! graph (get-in graph [:ids :level]) 150 "level-150")]
+          (doseq [path paths]
+            (testing (str (name path) ": count = 150 stores the number 150")
+              (is (#{200 201} (:status (counts path))) (pr-str (counts path)))
+              (is (= ["150"] (mapv :title (held conn (:title (counts path)) (ident graph :count))))))
+            (testing (str (name path) ": level = 150 stores the choice titled 150")
+              (is (#{200 201} (:status (levels path))) (pr-str (levels path)))
+              (is (= ["150"] (mapv :title (held conn (:title (levels path)) (ident graph :level))))))))))))
+
+;; A number that is none of a choice property's choices keeps the choice error, which lists the
+;; valid choices, rather than the title-or-UUID refusal a node property gets.
+(deftest choice-property-number-outside-choices-keeps-the-choice-error-test
+  (async done
+    (with-graph done
+      (fn [graph]
+        (p/let [results (write-four! graph (get-in graph [:ids :level]) 999 "level-999")]
+          (doseq [path paths :let [{:keys [status error unchanged?]} (results path)]]
+            (testing (str (name path) ": level = 999 is refused with the valid choices listed")
+              (is (= 400 status) (pr-str (results path)))
+              (is (string/starts-with? (str error) (path-prefix path)) (pr-str error))
+              (is (string/includes? (str error) "choices (150, 7), got 999") (pr-str error))
+              (is unchanged? "nothing is written"))))))))
