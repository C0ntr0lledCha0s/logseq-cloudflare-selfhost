+(deftest normalize-tx-data-replays-batch-that-re-adds-and-retracts-a-value-test
+  (testing "a batch that resets two classes' extends to another class replays to the same db"
+    ;; Each class: reset extends to Root, then add Org and drop the now-redundant Root. When the
+    ;; batch replayed its temp conn's datoms with their own tx ids, the second class's last Root
+    ;; retract kept an earlier tx id than the add it undid, and normalize-tx-data, which keeps one
+    ;; change per [e a v tx] and sorts by tx, logged "retract Root, then add Root".
+    (let [conn (db-test/create-conn-with-blocks
+                {:classes {:Org {}
+                           :Business {}
+                           :Department {}}})
+          db-before @conn
+          ident (fn [title] (:db/ident (ldb/get-case-page db-before title)))
+          classes (mapv ident ["Business" "Department"])
+          org (ident "Org")
+          reports (atom [])
+          _ (d/listen! conn ::capture #(swap! reports conj %))
+          _ (ldb/batch-transact-with-temp-conn!
+             conn {:outliner-op :batch-set-property}
+             (fn [temp-conn]
+               (doseq [ident classes]
+                 (d/transact! temp-conn [[:db/retract ident :logseq.property.class/extends]
+                                         [:db/add ident :logseq.property.class/extends :logseq.class/Root]])
+                 (d/transact! temp-conn [[:db/add ident :logseq.property.class/extends org]
+                                         [:db/retract ident :logseq.property.class/extends :logseq.class/Root]]))))
+          _ (d/unlisten! conn ::capture)
+          {:keys [db-after tx-data]} (first @reports)
+          replayed (:db-after (d/with db-before (db-normalize/normalize-tx-data db-after db-before tx-data)))
+          extends (fn [db] (mapv #(set (map :db/ident (:logseq.property.class/extends (d/entity db %)))) classes))]
+      (is (= 1 (count @reports)))
+      (is (= [#{:logseq.class/Root} #{:logseq.class/Root}] (extends db-before)))
+      (is (= [#{org} #{org}] (extends db-after)))
+      (is (= (extends db-after) (extends replayed))))))
