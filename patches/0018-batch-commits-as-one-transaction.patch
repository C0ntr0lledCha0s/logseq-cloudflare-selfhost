+(deftest batch-reset-of-two-tags-extends-syncs-to-clients-test
+  ;; A reset removes extends (Logseq puts Root back), then adds the new parent, which drops Root as
+  ;; redundant. Clients replay the logged, normalized tx-data and must end up as the server did.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self]}]
+        (p/let [tag! (fn [title] (p/let [r (request! self "POST" "/semantic/tags" {:title title})]
+                                   (get-in r [:body :uuid])))
+                thing (tag! "Thing")
+                org (tag! "Org")
+                _ (request! self "PUT" (str "/semantic/blocks/" org "/properties/logseq.property.class%2Fextends")
+                            {:value thing})
+                business (tag! "Business")
+                department (tag! "Department")
+                client (d/conn-from-db @conn)
+                logged (atom [])
+                _ (d/listen! conn ::log (fn [{:keys [db-after db-before tx-data]}]
+                                          (swap! logged conj (db-normalize/normalize-tx-data db-after db-before tx-data))))
+                response (request! self "POST" "/semantic/block-properties/batch-set"
+                                   {:isResetExistingValues true
+                                    :entries (mapv (fn [id] {:block-id id :property-id "logseq.property.class/extends"
+                                                             :value [org]})
+                                                   [business department])})
+                _ (d/unlisten! conn ::log)
+                _ (doseq [tx-data @logged] (d/transact! client tx-data))
+                extends (fn [db] (mapv (fn [id] (set (map :block/title (:logseq.property.class/extends
+                                                                         (d/entity db [:block/uuid (uuid id)])))))
+                                       [business department]))]
+          (is (= 200 (:status response)))
+          (is (= [#{"Org"} #{"Org"}] (extends @conn)))
+          (is (= (extends @conn) (extends @client))))))))
diff --git a/deps/db/src/logseq/db.cljs b/deps/db/src/logseq/db.cljs
index c23ffc7ca2..de19a9c6fa 100644
--- a/deps/db/src/logseq/db.cljs
+++ b/deps/db/src/logseq/db.cljs
@@ -297,8 +297,12 @@
       (vreset! *complete? true)
       (let [tx-data @*batch-tx-data]
         (when (and @*complete? (seq tx-data))
-          ;; transact tx-data to `conn` and validate db
-          (transact! conn tx-data (transform-tx-meta tx-meta))))
+          ;; transact tx-data to `conn` and validate db. The temp conn's datoms carry its own tx
+          ;; ids; replay them as plain ops so the batch is one transaction with one tx id, as
+          ;; sync's normalize-tx-data expects of a tx report.
+          (transact! conn
+                     (mapv (fn [d] [(if (:added d) :db/add :db/retract) (:e d) (:a d) (:v d)]) tx-data)
+                     (transform-tx-meta tx-meta))))
       (finally
         (d/unlisten! temp-conn ::temp-conn-batch-tx)
         (reset! temp-conn nil)
