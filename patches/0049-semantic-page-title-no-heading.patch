diff --git a/deps/db-sync/test/logseq/db_sync/semantic_page_title_heading_test.cljs b/deps/db-sync/test/logseq/db_sync/semantic_page_title_heading_test.cljs
new file mode 100644
index 0000000..bc9f389
--- /dev/null
+++ b/deps/db-sync/test/logseq/db_sync/semantic_page_title_heading_test.cljs
@@ -0,0 +1,171 @@
+(ns logseq.db-sync.semantic-page-title-heading-test
+  "A page's, tag's or property's title is a name, not block text, so a leading markdown heading
+  (`#` to `######`, then whitespace) is never turned into :logseq.property/heading on it. Patch
+  0024's heading step ran for any entity updateBlock wrote, so `# New name` on a page stored
+  `New name` with heading 1 on the page itself. A page or tag title can't hold \"#\" (the outliner
+  refuses it, and createPage and createTag answer 400), so every write that renames a page or tag
+  with a heading prefix (updateBlock, updatePage, updateTag) answers 400 naming \"#\" and the
+  title, and changes nothing. A normal block still gets the heading, and a code block keeps its
+  title verbatim."
+  (:require [cljs.test :refer [async deftest is]]
+            [clojure.string :as string]
+            [datascript.core :as d]
+            [logseq.db-sync.test-sql :as test-sql]
+            [logseq.db-sync.worker.handler.sync :as sync-handler]
+            [logseq.db.sqlite.export :as sqlite-export]
+            [logseq.outliner.core :as outliner-core]
+            [logseq.outliner.page :as outliner-page]
+            [promesa.core :as p]))
+
+(defn- request!
+  "One semantic API request through the real handler; returns {:status :body}."
+  [self method path body]
+  (p/let [url (str "http://localhost" path (if (string/includes? path "?") "&" "?") "graph-id=graph-1")
+          response (sync-handler/handle-http
+                    self
+                    (js/Request. url (clj->js (cond-> {:method method
+                                                       :headers {"content-type" "application/json"}}
+                                                body (assoc :body (js/JSON.stringify (clj->js body)))))))
+          text (.text response)]
+    {:status (.-status response)
+     :body (when (seq text)
+             (try (js->clj (js/JSON.parse text) :keywordize-keys true)
+                  (catch :default _ text)))}))
+
+;; Every heading level, a tab after the hashes, and leading whitespace (the app trims it).
+(def heading-titles ["# New name" "## Two" "### Three" "###### Six" "##\tTabbed" "  ## Indented"])
+
+(defn- stored [conn id]
+  (let [e (d/entity @conn [:block/uuid id])]
+    {:title (:block/title e) :heading (:logseq.property/heading e)}))
+
+(defn- with-graph [done run]
+  (-> (p/let [conn (sqlite-export/create-conn)
+              self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true}]
+        (run {:conn conn :self self}))
+      (p/catch #(is false (str "unexpected error: " % (.-stack %))))
+      (p/finally done)))
+
+(defn- refused-unchanged!
+  "Asserts `response` is a 400 naming \"#\" and `title`, and that the entity kept `before` with no heading."
+  [label title response conn id before]
+  (is (= 400 (:status response)) (str label " " (pr-str title) ": answers 400, got " (pr-str response)))
+  (is (string/includes? (str (get-in response [:body :error])) "can't include \"#\"")
+      (str label " " (pr-str title) ": the error names \"#\""))
+  (is (string/includes? (str (get-in response [:body :error])) title)
+      (str label " " (pr-str title) ": the error names the title"))
+  (is (= {:title before :heading nil} (stored conn id))
+      (str label " " (pr-str title) ": the entity keeps its title and gets no heading")))
+
+(defn- rename-cases!
+  "For each heading title, makes a fresh page (or tag, with `class?`) and renames it through `path-of`."
+  [conn self label class? path-of]
+  (p/doseq [[i title] (map-indexed vector heading-titles)]
+    (p/let [before (str (string/replace label "/" " ") " " i)
+            [_ id] (outliner-page/create! conn before (if class? {:class? true} {}))
+            response (request! self "PATCH" (path-of id) {:title title})]
+      (refused-unchanged! label title response conn id before))))
+
+(deftest update-block-on-page-sets-no-heading-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self]}]
+        (rename-cases! conn self "updateBlock/page" false #(str "/semantic/blocks/" %))))))
+
+(deftest update-block-on-tag-sets-no-heading-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self]}]
+        (rename-cases! conn self "updateBlock/tag" true #(str "/semantic/blocks/" %))))))
+
+(deftest update-page-sets-no-heading-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self]}]
+        (rename-cases! conn self "updatePage" false #(str "/semantic/pages/" %))))))
+
+(deftest update-tag-sets-no-heading-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self]}]
+        (rename-cases! conn self "updateTag" true #(str "/semantic/tags/" %))))))
+
+(deftest get-page-shows-no-heading-after-update-block-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self]}]
+        (p/let [[_ id] (outliner-page/create! conn "Shown page" {})
+                _ (request! self "PATCH" (str "/semantic/blocks/" id) {:title "# Shown name"})
+                got (request! self "GET" (str "/semantic/pages/" id) nil)]
+          (is (= 200 (:status got)))
+          (is (not-any? #(= "logseq.property/heading" (:ident %)) (get-in got [:body :properties]))
+              (str "getPage shows no heading property: " (pr-str (get-in got [:body :properties])))))))))
+
+;; A property is written through updateBlock too. Its title is a name: whatever the answer, no
+;; heading lands on it and the prefix is not silently dropped.
+(deftest update-block-on-property-sets-no-heading-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self]}]
+        (p/doseq [[i title] (map-indexed vector heading-titles)]
+          (p/let [before (str "prop title " i)
+                  created (request! self "POST" "/semantic/properties" {:title before :type "default"})
+                  _ (is (= 201 (:status created)) (pr-str created))
+                  id (uuid (get-in created [:body :uuid]))
+                  response (request! self "PATCH" (str "/semantic/blocks/" id) {:title title})
+                  after (stored conn id)]
+            (is (nil? (:heading after)) (str "updateBlock/property " (pr-str title) ": no heading, got " (pr-str after)))
+            (if (= 400 (:status response))
+              (is (= before (:title after)) (str "updateBlock/property " (pr-str title) ": refused, title kept"))
+              (is (= title (:title after))
+                  (str "updateBlock/property " (pr-str title) ": accepted, title stored as sent, got " (pr-str after))))))))))
+
+;; Guard: the refusal reads only a heading prefix, so a plain rename still works on every path.
+(deftest plain-renames-still-work-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self]}]
+        (p/doseq [[label class? path] [["updateBlock/page" false "/semantic/blocks/"]
+                                       ["updateBlock/tag" true "/semantic/blocks/"]
+                                       ["updatePage" false "/semantic/pages/"]
+                                       ["updateTag" true "/semantic/tags/"]]]
+          (p/let [before (str "plain " label)
+                  after (str "Renamed " (string/replace label "/" " "))
+                  [_ id] (outliner-page/create! conn before (if class? {:class? true} {}))
+                  response (request! self "PATCH" (str path id) {:title after})]
+            (is (= 200 (:status response)) (str label ": plain rename answers 200, got " (pr-str response)))
+            (is (= {:title after :heading nil} (stored conn id)) (str label ": plain rename stored"))))
+        (p/let [created (request! self "POST" "/semantic/properties" {:title "plain prop" :type "default"})
+                id (uuid (get-in created [:body :uuid]))
+                response (request! self "PATCH" (str "/semantic/blocks/" id) {:title "Renamed prop"})]
+          (is (= 200 (:status response)) (str "updateBlock/property: plain rename answers 200, got " (pr-str response)))
+          (is (= {:title "Renamed prop" :heading nil} (stored conn id))))))))
+
+;; Controls: block behaviour is unchanged.
+(deftest blocks-keep-heading-behaviour-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self]}]
+        (p/let [[_ page-id] (outliner-page/create! conn "Host" {})
+                blk (random-uuid)
+                code (random-uuid)
+                _ (outliner-core/insert-blocks! conn [{:block/uuid blk :block/title "placeholder"}
+                                                      {:block/uuid code :block/title "placeholder"}]
+                                                (d/entity @conn [:block/uuid page-id])
+                                                {:sibling? false :keep-uuid? true :bottom? true})
+                _ (d/transact! conn [[:db/add [:block/uuid code] :logseq.property.node/display-type :code]])
+                r1 (request! self "PATCH" (str "/semantic/blocks/" blk) {:title "# Block heading"})
+                r2 (request! self "PATCH" (str "/semantic/blocks/" code) {:title "# install\nnpm i"})]
+          (is (= 200 (:status r1)))
+          (is (= {:title "Block heading" :heading 1} (stored conn blk)) "a normal block still gets the heading")
+          ;; The way to remove a heading, as connector_help gives it: a title without a prefix keeps
+          ;; it, and deleting logseq.property/heading removes it.
+          (p/let [kept (request! self "PATCH" (str "/semantic/blocks/" blk) {:title "Plain again"})
+                  _ (is (= 200 (:status kept)))
+                  _ (is (= {:title "Plain again" :heading 1} (stored conn blk)) "no prefix keeps the heading")
+                  removed (request! self "DELETE" (str "/semantic/blocks/" blk "/properties/"
+                                                       (js/encodeURIComponent "logseq.property/heading")) nil)]
+            (is (= 200 (:status removed)) (pr-str removed))
+            (is (= {:title "Plain again" :heading nil} (stored conn blk)) "deleting the heading property removes it"))
+          (is (= 200 (:status r2)))
+          (is (= {:title "# install\nnpm i" :heading nil} (stored conn code)) "a code block stays verbatim"))))))
