-(defn main [& _args]
+(defn- ns-pattern
+  "A regex matching every namespace whose name contains a match for `s`.
+  shadow.test/run-all-tests uses re-matches, so a bare `semantic-choice-values`
+  would match nothing without the surrounding `.*`."
+  [s]
+  (re-pattern (str ".*(?:" s ").*")))
+
+(defn main
+  "Runs every test namespace, or with a first arg, only the namespaces whose
+  name matches it as a regex (e.g. `semantic-choice-values`)."
+  [& args]
   (reset-test-data!)
   (let [test-env (ct/empty-env ::node)]
-    (st/run-all-tests test-env nil)))
+    (st/run-all-tests test-env (some-> (first args) ns-pattern))))
