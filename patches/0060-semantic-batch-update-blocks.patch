+(ns logseq.db-sync.semantic-batch-update-blocks-test
+  "batchUpdateBlocks (LC-137) changes up to 100 block titles in one call and one transaction, each
+  as updateBlock would change it: a `## ` prefix becomes the heading, an unknown #word is escaped,
+  display-type and lang make a code block whose title is stored verbatim. A refused entry refuses
+  the whole call, naming it, and writes nothing; a dry run applies the entries to a throwaway copy."
+  (:require [cljs.test :refer [async deftest is testing]]
+            [clojure.string :as string]
+            [datascript.core :as d]
+            [logseq.db-sync.test-sql :as test-sql]
+            [logseq.db-sync.worker.handler.sync :as sync-handler]
+            [logseq.db.sqlite.export :as sqlite-export]
+            [logseq.outliner.core :as outliner-core]
+            [logseq.outliner.page :as outliner-page]
+            [promesa.core :as p]))
+
+(defn- request!
+  [self method path body]
+  (p/let [url (str "http://localhost" path (if (string/includes? path "?") "&" "?") "graph-id=graph-1")
+          response (sync-handler/handle-http
+                    self
+                    (js/Request. url (clj->js (cond-> {:method method
+                                                       :headers {"content-type" "application/json"}}
+                                                body (assoc :body (js/JSON.stringify (clj->js body)))))))
+          text (.text response)]
+    {:status (.-status response)
+     :body (when (seq text)
+             (try (js->clj (js/JSON.parse text) :keywordize-keys true)
+                  (catch :default _ text)))}))
+
+(defn- with-blocks
+  "A page holding `n` blocks titled b0, b1, … made by the outliner."
+  [done n run]
+  (-> (p/let [conn (sqlite-export/create-conn)
+              [_ page-id] (outliner-page/create! conn "Batch" {})
+              ids (vec (repeatedly n random-uuid))
+              _ (outliner-core/insert-blocks! conn (vec (map-indexed (fn [i id] {:block/uuid id :block/title (str "b" i)}) ids))
+                                              (d/entity @conn [:block/uuid page-id])
+                                              {:sibling? false :keep-uuid? true :bottom? true})
+              self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true}]
+        (run {:conn conn :self self :page-id page-id :ids ids}))
+      (p/catch #(is false (str "unexpected error: " %)))
+      (p/finally done)))
+
+(defn- stored [conn id]
+  (let [e (d/entity @conn [:block/uuid id])]
+    {:title (:block/title e)
+     :heading (:logseq.property/heading e)
+     :display (some-> (:logseq.property.node/display-type e) name)}))
+
+(def path "/semantic/block-updates/batch")
