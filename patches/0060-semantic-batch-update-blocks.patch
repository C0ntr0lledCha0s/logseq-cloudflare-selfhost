+(deftest batch-update-applies-each-entry-as-update-block-would-test
+  (async done
+    (with-blocks done 4
+      (fn [{:keys [conn self ids]}]
+        (p/let [[a b c d*] ids
+                response (request! self "POST" path
+                                   {:entries [{:block-id (str a) :title "Plain rename"}
+                                              {:block-id (str b) :title "## Section"}
+                                              {:block-id (str c) :title "Fix LC-5 and #58 today"}
+                                              {:block-id (str d*) :title "# a comment\nprint(1)" :display-type "code" :lang "python"}]})]
+          (is (= 200 (:status response)) (pr-str (:body response)))
+          (is (= 4 (get-in response [:body :updated])))
+          (is (= {:title "Plain rename" :heading nil :display nil} (stored conn a)))
+          (is (= {:title "Section" :heading 2 :display nil} (stored conn b)) "a ## prefix becomes the heading")
+          (is (= "Fix LC-5 and \\#58 today" (:title (stored conn c))) "an unknown #word is escaped")
+          (is (= {:title "# a comment\nprint(1)" :heading nil :display "code"} (stored conn d*)) "a code title is stored verbatim")
+          (testing "the answer names each block, in entry order, and what each entry escaped"
+            (is (= (map str ids) (map :uuid (get-in response [:body :affected]))))
+            (is (= (map str ids) (map :uuid (get-in response [:body :entries]))))
+            (is (= ["#58"] (get-in response [:body :entries 2 :escaped])))))))))
+
+(deftest batch-update-takes-100-entries-in-one-call-test
+  (async done
+    (with-blocks done 100
+      (fn [{:keys [conn self ids]}]
+        (p/let [response (request! self "POST" path {:entries (map-indexed (fn [i id] {:block-id (str id) :title (str "LC-" i ": renamed")}) ids)})
+                too-many (request! self "POST" path {:entries (map (fn [id] {:block-id (str id) :title "x"}) (conj ids (first ids)))})]
+          (is (= 200 (:status response)) (pr-str (:body response)))
+          (is (= (map #(str "LC-" % ": renamed") (range 100)) (map #(:title (stored conn %)) ids)))
+          (is (= 400 (:status too-many)))
+          (is (string/starts-with? (get-in too-many [:body :error]) "entries:")))))))
+
+(deftest batch-update-refuses-the-whole-call-naming-the-entry-test
+  (async done
+    (with-blocks done 2
+      (fn [{:keys [conn self ids]}]
+        (p/let [[a b] ids
+                missing (request! self "POST" path {:entries [{:block-id (str a) :title "changed"}
+                                                              {:block-id (str (random-uuid)) :title "x"}]})
+                blank (request! self "POST" path {:entries [{:block-id (str a) :title "changed"}
+                                                            {:block-id (str b) :title ""}]})
+                twice (request! self "POST" path {:entries [{:block-id (str a) :title "one"}
+                                                            {:block-id (str a) :title "two"}]})
+                bad-lang (request! self "POST" path {:entries [{:block-id (str a) :title "changed"}
+                                                               {:block-id (str b) :title "x" :lang "python"}]})
+                label (request! self "POST" path {:entries [{:block-id (str a) :title "changed"}
+                                                            {:block-id (str b) :title "x" :target-label "Batch > nothing like it"}]})]
+          (doseq [[label' response status prefix] [["missing block" missing 400 "entry 1:"]
+                                                   ["blank title" blank 400 "entry 1:"]
+                                                   ["a block twice" twice 400 "entry 1:"]
+                                                   ["lang without code" bad-lang 400 "entry 1:"]
+                                                   ["a target-label that doesn't fit" label 409 "entry 1"]]]
+            (is (= status (:status response)) (str label' ": " (pr-str (:body response))))
+            (is (string/starts-with? (str (get-in response [:body :error])) prefix) (str label' ": " (pr-str (:body response)))))
+          (is (= ["b0" "b1"] [(:title (stored conn a)) (:title (stored conn b))]) "nothing was written"))))))
+
+(deftest batch-update-dry-run-changes-nothing-test
+  (async done
+    (with-blocks done 1
+      (fn [{:keys [conn self ids]}]
+        (p/let [response (request! self "POST" path {:dry-run true :entries [{:block-id (str (first ids)) :title "## Would be"}]})]
+          (is (= 200 (:status response)) (pr-str (:body response)))
+          (is (true? (get-in response [:body :dry-run])))
+          (is (= "Would be" (get-in response [:body :entries 0 :title])) "the answer shows what would be stored")
+          (is (= "b0" (:title (stored conn (first ids)))) "the graph is unchanged"))))))
