+(defn- prepare-block-update
+  "updateBlock's checks for `body` ({:title, :display-type?, :lang?}) on `block`, made before
+  anything is written: {:error {:status :error}}, or the plan apply-block-update! writes.
+  display-type and lang (patch 0037) are checked as set_block_property checks them; the title is
+  judged on the block's final type, the body's (or its fence's) or else the stored one. A text
+  block's title that is one fence converts it, unless convert-fences=false; a page's, tag's or
+  property's title is a name, never converted. batchUpdateBlocks (LC-137) runs the same checks."
+  [db block body convert? e2ee?]
+  (let [fields (keep (fn [[k ident]]
+                       (when (contains? body k) [ident (display-value db ident (get body k) block)]))
+                     [[:display-type display-type-ident] [:lang lang-ident]])
+        explicit (into {} (map (fn [[ident prepared]] [ident (:value prepared)])) fields)
+        ;; Only a text block's fence converts: a code, math or quote block's title is its
+        ;; content, as the app's parse-block skips extraction for a block with a display-type.
+        fence (when (and (true? convert?) (not e2ee?) block (= "block" (block-kind block))
+                         (nil? (display-type-ident block)))
+                (fence-display-block (:title body)))
+        ;; update_block doesn't make Query blocks (patch 0050): an advanced query fence stays text.
+        fence (if (= :query (:type fence)) {:kept update-query-fence-reason} fence)
+        converted (when (:type fence) fence)
+        fence-error (when converted
+                      (fence-refusal converted (get explicit display-type-ident) (get explicit lang-ident)))
+        type (or (get explicit display-type-ident) (:type converted))
+        lang (or (get explicit lang-ident) (:lang converted))
+        given (cond-> {} type (assoc display-type-ident type) lang (assoc lang-ident lang))
+        title (if converted (:title converted) (:title body))
+        final-type (or type (some-> block display-type-ident))
+        ;; patch 0050: only a Query block Claude made changes; its value block takes checked text.
+        query-guard (when (and block (non-blank-string? (:title body))) (query-block-refusal db block body))
+        query-holder-id (when (and block (nil? query-guard))
+                          (let [part (query-block-part db block)] (when (:value? part) (:holder part))))
+        refuse (fn [error] {:error {:status 400 :error error}})]
+    (cond
+      (or (nil? block) (not (non-blank-string? (:title body))))
+      (refuse "invalid block-id or title")
+      query-guard {:error query-guard}
+      (= ::invalid convert?) (refuse convert-fences-refusal)
+      (some (comp :error second) fields) (refuse (some (comp :error second) fields))
+      fence-error (refuse fence-error)
+      (and (not e2ee?) (contains? #{"page" "tag" "property"} (block-kind block))
+           (name-heading-refusal (block-kind block) (:title body)))
+      (refuse (name-heading-refusal (block-kind block) (:title body)))
+      (and (some? lang) (not= :code final-type)) (refuse "lang needs display-type code")
+      :else {:block block :body body :type type :lang lang :given given :title title
+             :final-type final-type :query-holder-id query-holder-id :converted converted :fence fence})))
+
+(defn- apply-block-update!
+  "Writes `plan` (from prepare-block-update) inside a transaction on `tx-conn`, and reads it back;
+  returns the prepared title. The type is written first, so the outliner's save sees it and leaves a
+  typed title's `# ` lines alone."
+  [tx-conn {:keys [block body type lang given title final-type query-holder-id]} e2ee?]
+  (when type (set-display-type! tx-conn (:db/id block) type))
+  (when lang (outliner-property/set-block-property! tx-conn (:db/id block) lang-ident lang))
+  (let [prepared (prepare-block-title! tx-conn e2ee? title final-type)]
+    (outliner-core/save-block! tx-conn
+                               (assoc prepared :block/uuid (:block/uuid block))
+                               :encrypted-title? e2ee? :encrypted-name (:name body))
+    (unverified! (keep (fn [[ident value]] (read-back-display @tx-conn (:db/id block) ident value))
+                       given))
+    ;; A Claude-made query is stored as sent and stays Clojure code.
+    (when query-holder-id
+      (unverified! (map (fn [reason] (str "title: " reason))
+                        (read-back-query-block @tx-conn query-holder-id (:title body) true))))
+    prepared))
+
+(defn- block-update-result
+  "What updateBlock answers for one block `plan` wrote, as `db` now has it: its uuid, kind and stored
+  title, what was escaped, its display type, and whether a fence converted or stayed text."
+  [db {:keys [block body converted fence]} prepared e2ee?]
+  (let [stored (d/entity db [:block/uuid (:block/uuid block)])]
+    (cond-> (with-display
+              (with-escaped
+                {:uuid (str (:block/uuid block)) :kind (block-kind block)
+                 ;; The stored title shows what was escaped; E2EE stores the input.
+                 :title (if e2ee? (:title body) (:block/title stored))}
+                prepared)
+              stored)
+      converted (assoc :converted "fence")
+      (:kept fence) (assoc :kept [{:path "title" :reason (:kept fence)}]))))
+
+(defn- batch-update-blocks
+  "batchUpdateBlocks (LC-137): up to 100 title changes, each checked as updateBlock checks one before
+  anything is written, then applied in order in one transaction. A refused entry refuses the call,
+  naming it. A block may be named by one entry only. A dry run writes to a throwaway copy."
+  [^js self conn db body url e2ee? creator]
+  (let [entries (:entries body)
+        dry-run? (dry-run-option body)
+        convert? (convert-fences-option url)]
+    (cond
+      e2ee? (http/error-response "batch title updates are unavailable for E2EE graphs; use updateBlock" 409)
+      (not (and (sequential? entries) (<= 1 (count entries) 100)))
+      (http/bad-request "entries: give 1 to 100 entries, each {block-id, title}")
+      (= ::invalid dry-run?) (http/bad-request "dry-run must be a boolean")
+      (labels-error entries) (http/bad-request (labels-error entries))
+      :else
+      (let [blocks (mapv #(when (map? %) (find-entity db (:block-id %))) entries)
+            first-index (reduce-kv (fn [m i b] (if (and b (not (contains? m (:db/id b)))) (assoc m (:db/id b) i) m)) {} blocks)
+            duplicate (some (fn [[i b]] (when (and b (not= i (get first-index (:db/id b))))
+                                          [i (get first-index (:db/id b))]))
+                            (map-indexed vector blocks))
+            plans (mapv (fn [entry block]
+                          (if (map? entry)
+                            (prepare-block-update db block entry convert? false)
+                            {:error {:status 400 :error "must be an object {block-id, title}"}}))
+                        entries blocks)
+            refused (first (keep-indexed (fn [i plan] (when (:error plan) [i (:error plan)])) plans))]
+        (cond
+          duplicate
+          (http/bad-request (str "entry " (first duplicate) ": block " (:block-id (nth entries (first duplicate)))
+                                 " is already in entry " (second duplicate) "; name each block once"))
+          refused
+          (let [[i {:keys [status error]}] refused]
+            (http/error-response (str "entry " i ": " error) status))
+          :else
+          (let [prepared (volatile! [])
+                write-conn (if dry-run? (dry-run-conn conn) conn)]
+            (answering-unverified
+             #(refusing-labels
+               (fn []
+                 (atomic-write! write-conn creator false :save-block
+                                (fn [tx-conn]
+                                  (check-labels! @tx-conn false (entry-label-checks entries plans :block))
+                                  (vreset! prepared
+                                           (vec (map-indexed
+                                                 (fn [i plan]
+                                                   (try (apply-block-update! tx-conn plan false)
+                                                        (catch :default error
+                                                          (if-let [message (::unverified (ex-data error))]
+                                                            (throw (ex-info (str "entry " i ": " message) {::unverified (str "entry " i ": " message)}))
+                                                            (throw error)))))
+                                                 plans)))))
+                 (when-not dry-run? (broadcast-change! self))
+                 (bulk-write-response
+                  {:updated (count plans)
+                   :entries (mapv (fn [plan p] (block-update-result @write-conn plan p false)) plans @prepared)
+                   :affected (:affected (affected-context @write-conn (map :block plans) false))}
+                  dry-run? 200))))))))))
+
