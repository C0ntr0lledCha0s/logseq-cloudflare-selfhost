+(def ^:private allowed-user-id-pattern
+  #"^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$")
+
+(defn- allowed-user-entries
+  [value]
+  (map string/trim (string/split value #"," -1)))
+
+(defn parse-allowed-users
+  "Parses DB_SYNC_ALLOWED_USERS. `none`, empty or unset means nobody; otherwise
+  every comma-separated entry must be a lowercase UUID, or the list is
+  malformed and allows nobody."
+  [raw]
+  (let [value (some-> raw string/trim)]
+    (if (or (string/blank? value) (= "none" value))
+      {:ids #{} :malformed? false}
+      (let [entries (allowed-user-entries value)]
+        (if (every? #(re-matches allowed-user-id-pattern %) entries)
+          {:ids (set entries) :malformed? false}
+          {:ids #{} :malformed? true})))))
+
+;; The last raw value seen by this isolate and its parsed ids.
+(defonce ^:private *allowed-users (atom nil))
+
+(defn- allowed-user-ids
+  [env]
+  (let [raw (aget env "DB_SYNC_ALLOWED_USERS")
+        cached @*allowed-users]
+    (if (and cached (= raw (:raw cached)))
+      (:ids cached)
+      (let [{:keys [ids malformed?]} (parse-allowed-users raw)]
+        (when malformed?
+          (log/error :db-sync/allowed-users-malformed
+                     {:entries (count (allowed-user-entries (string/trim raw)))}))
+        (reset! *allowed-users {:raw raw :ids ids})
+        ids))))
+
+(defn- allowed-claims
+  [claims env]
+  (when claims
+    (let [sub (aget claims "sub")]
+      (if (and (string? sub) (contains? (allowed-user-ids env) sub))
+        claims
+        (let [email (aget claims "email")]
+          (log/warn :db-sync/user-not-allowed
+                    {:sub sub :email (when (string? email) email)})
+          nil)))))
+
