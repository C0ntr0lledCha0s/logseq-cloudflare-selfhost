+(deftest semantic-refresh-refs-previews-then-applies-test
+  (async done
+    (with-tree-identity-test done
+      (fn [{:keys [conn page-id self]}]
+        (let [decision-id (random-uuid)
+              keep-id (random-uuid)
+              other-page-id (random-uuid)
+              [stale-id clean-id other-id] (repeatedly 3 random-uuid)
+              block (fn [id page title order]
+                      {:block/uuid id :block/title title :block/page [:block/uuid page]
+                       :block/parent [:block/uuid page] :block/order order
+                       :block/created-at 1 :block/updated-at 1})
+              _ (d/transact! conn [{:db/ident :user.class/Decision :block/uuid decision-id
+                                    :block/name "decision" :block/title "Decision" :block/tags :logseq.class/Tag}
+                                   {:db/ident :user.class/Keep :block/uuid keep-id
+                                    :block/name "keep" :block/title "Keep" :block/tags :logseq.class/Tag}
+                                   {:block/uuid other-page-id :block/name "other" :block/title "Other"
+                                    :block/tags :logseq.class/Page :block/created-at 1 :block/updated-at 1}])
+              ;; Titles written before inline tags were handled on write, so still raw text.
+              _ (d/transact! conn [(assoc (block stale-id page-id "Done (PR #15) and #Decision" "a0")
+                                          :block/tags [[:block/uuid keep-id]])
+                                   (block clean-id page-id "Nothing to do" "a1")
+                                   (block other-id other-page-id "Other #Unknown" "a0")])
+              title-of (fn [id] (:block/raw-title (d/entity @conn [:block/uuid id])))
+              tags-of (fn [id] (set (map :block/uuid (:block/tags (d/entity @conn [:block/uuid id])))))
+              refresh! (fn [body]
+                         (p/let [response (sync-handler/handle-http
+                                           self (semantic-json-request "/semantic/refresh-refs?graph-id=graph-1" "POST" body))
+                                 text (.text response)]
+                           [(.-status response) (js->clj (js/JSON.parse text) :keywordize-keys true)]))
+              escaped "Done (PR \\#15) and "]
+          (p/let [[s1 preview] (refresh! {:page-id (str page-id)})
+                  _ (is (= 200 s1))
+                  _ (is (= false (:applied preview)) "previews by default")
+                  _ (is (= [{:uuid (str stale-id) :page-id (str page-id)
+                             :before "Done (PR #15) and #Decision"
+                             :after (str escaped "#Decision")
+                             :tags ["Decision"]}]
+                           (:changed preview))
+                        "only the stale block on the page, shown with tag names")
+                  _ (is (= "Done (PR #15) and #Decision" (title-of stale-id)) "a preview writes nothing")
+                  [s2 applied] (refresh! {:page-id (str page-id) :apply true})
+                  _ (is (= [200 true 1] [s2 (:applied applied) (count (:changed applied))]))
+                  _ (is (= (str escaped "#" (page-ref/->page-ref decision-id)) (title-of stale-id)))
+                  _ (is (= #{keep-id decision-id} (tags-of stale-id)) "existing tags are kept")
+                  _ (is (= "Nothing to do" (title-of clean-id)))
+                  _ (is (= "Other #Unknown" (title-of other-id)) "page scope leaves other pages alone")
+                  [s3 graph-wide] (refresh! {:apply true})
+                  _ (is (= [200 [(str other-id)]] [s3 (mapv :uuid (:changed graph-wide))]))
+                  _ (is (= "Other \\#Unknown" (title-of other-id)))
+                  [s4 again] (refresh! {:apply true})
+                  _ (is (= [200 []] [s4 (:changed again)]) "refreshing twice changes nothing")
+                  e2ee-response (sync-handler/handle-http
+                                 self (semantic-json-request "/semantic/refresh-refs?graph-id=graph-1&graph-e2ee=true"
+                                                             "POST" {:apply true}))]
+            (is (= 409 (.-status e2ee-response)) "E2EE titles are opaque, so there is nothing to refresh")))))))
