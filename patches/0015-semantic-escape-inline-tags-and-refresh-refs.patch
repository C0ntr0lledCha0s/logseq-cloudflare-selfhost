+(deftest semantic-unresolved-inline-tags-are-escaped-test
+  (async done
+    (with-tree-identity-test done
+      (fn [{:keys [conn page-id request self]}]
+        (let [decision-id (random-uuid)
+              _ (d/transact! conn [{:db/ident :user.class/Decision :block/uuid decision-id
+                                    :block/name "decision" :block/title "Decision"
+                                    :block/tags :logseq.class/Tag}])
+              titles ["Done: 8 (PR #15), order-key fix PR #19), 14 (PR #20) and 15 (PR #21), all deployed"
+                      "Fixed in PR#7"
+                      "Untouched: `#15`, [PR #15](https://example.com/pull/15), https://example.com/#frag, C#"
+                      "Known #Decision) and #Unknown"
+                      "## Heading #Unknown"]
+              ids (vec (repeatedly (count titles) random-uuid))
+              tags-of (fn [id] (set (map :block/uuid (:block/tags (d/entity @conn [:block/uuid id])))))
+              title-of (fn [id] (:block/raw-title (d/entity @conn [:block/uuid id])))
+              ref-of (fn [id] (str "#" (page-ref/->page-ref id)))]
+          (p/let [response (request {:target-id (str page-id)
+                                     :blocks (mapv (fn [id title] {:uuid (str id) :title title}) ids titles)})
+                  _ (is (= 201 (.-status response)))
+                  inserted-body (json-body response)
+                  inserted (:blocks inserted-body)
+                  _ (is (= ["#15)" "#19)" "#20)" "#21)"] (:escaped (inserted 0)))
+                        "the response names each escaped tag as the editor reads it")
+                  _ (is (= "Fixed in PR\\#7" (:title (inserted 1))) "the response title is the stored one")
+                  _ (is (not (contains? (inserted 2) :escaped)) "nothing escaped, no escaped key")
+                  _ (is (= ["#Unknown"] (:escaped (inserted 3))))
+                  _ (is (= "Done: 8 (PR \\#15), order-key fix PR \\#19), 14 (PR \\#20) and 15 (PR \\#21), all deployed"
+                           (title-of (ids 0))))
+                  _ (is (= "Fixed in PR\\#7" (title-of (ids 1))) "a tag needs no space before #")
+                  _ (is (= (titles 2) (title-of (ids 2))) "code spans, link labels, URL fragments and C# are not tags")
+                  _ (is (= #{decision-id} (tags-of (ids 3))))
+                  _ (is (= (str "Known " (ref-of decision-id) ") and \\#Unknown") (title-of (ids 3))))
+                  _ (is (= "## Heading \\#Unknown" (title-of (ids 4))))
+                  _ (doseq [id ids]
+                      (is (empty? (editor-tag-names (title-of id)))
+                          (str "the editor would create no tag from " (pr-str (title-of id)))))
+                  _ (doseq [id (pop ids)] (is (empty? (disj (tags-of id) decision-id))))
+                  update-response (sync-handler/handle-http
+                                   self
+                                   (semantic-json-request (str "/semantic/blocks/" (ids 0) "?graph-id=graph-1")
+                                                          "PATCH" {:title "Now PR #9"}))]
+            (is (= 200 (.-status update-response)))
+            (is (= "Now PR \\#9" (title-of (ids 0))))
+            (p/let [body (json-body update-response)]
+              (is (= "Now PR \\#9" (:title body)) "PATCH returns the stored title, not the input")
+              (is (= ["#9"] (:escaped body))))))))))
