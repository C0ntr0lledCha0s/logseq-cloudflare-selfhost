+(defn- refresh-candidates
+  "Body blocks (not pages or property values) of `page`, or of the whole graph, whose stored title
+  could hold an unresolved `#tag` or `[[link]]`, as [eid title] in eid order."
+  [db page]
+  (->> (if page
+         (d/datoms db :avet :block/page (:db/id page))
+         (d/datoms db :aevt :block/page))
+       (map :e)
+       (remove #(seq (d/datoms db :eavt % :logseq.property/created-from-property)))
+       (keep (fn [e]
+               (let [title (:v (first (d/datoms db :eavt e :block/title)))]
+                 (when (and (string? title)
+                            (or (string/includes? title "#") (string/includes? title "[[")))
+                   [e title]))))
+       (sort-by first)))
