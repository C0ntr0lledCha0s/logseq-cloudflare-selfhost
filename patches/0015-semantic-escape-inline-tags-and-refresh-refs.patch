+(defn- refresh-change
+  "What a write of the block's stored title would change today, prepared against `conn`, or nil."
+  [conn [e title]]
+  (let [prepared (prepare-block-title! conn false title)
+        db @conn
+        block (d/entity db e)
+        existing (set (map :db/id (:block/tags block)))
+        added (->> (:block/tags prepared)
+                   (map #(d/entity db %))
+                   (remove #(contains? existing (:db/id %))))]
+    (when (or (not= title (:block/title prepared)) (seq added))
+      (let [show #(db-content/id-ref->title-ref % (map (fn [ref] (d/entity db ref)) (:block/refs prepared)))]
+        {:e e :title title
+         :response {:uuid (str (:block/uuid block))
+                    :page-id (str (get-in block [:block/page :block/uuid]))
+                    :before (show title)
+                    :after (show (:block/title prepared))
+                    :tags (mapv :block/title added)}}))))
+
+(defn- refresh-refs
+  "Re-runs write-time title handling on blocks already in the graph, so inline tags resolve and
+  unknown `#words` are escaped now rather than at the block's next edit. Previews unless `apply`."
+  [conn creator page apply?]
+  (let [db @conn
+        ;; A preview prepares against a copy, so links to missing pages create nothing.
+        scratch (d/conn-from-db db)
+        changes (->> (refresh-candidates db page)
+                     (keep #(refresh-change scratch %))
+                     (take (inc max-limit))
+                     vec)
+        truncated? (> (count changes) max-limit)
+        changes (vec (take max-limit changes))]
+    (when (and apply? (seq changes))
+      (atomic-write! conn creator false :save-block
+                     (fn [tx-conn]
+                       (doseq [{:keys [e title]} changes]
+                         (outliner-core/save-block! tx-conn
+                                                    (assoc (prepare-block-title! tx-conn false title)
+                                                           :block/uuid (:block/uuid (d/entity @tx-conn e))))))))
+    (cond-> {:applied (boolean apply?) :changed (mapv :response changes)}
+      truncated? (assoc :truncated true))))
