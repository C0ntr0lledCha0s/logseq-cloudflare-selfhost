+;; Page selectors (patch 0028): every {page-id}, every target-id and createTask's page-id take a
+;; UUID, an exact or unique case-insensitive page title, or an ISO journal date. The selector graph
+;; holds journals Nov 5th and Nov 6th, 2026; pages Notes, notes2 and 100% Done made
+;; through the API; and, stored as the app or a sync would store them, Projects/Alpha, Kitchen and kitchen (titles
+;; that differ only in case), a page titled 2026-11-06 (Nov 6th's ISO date), a hidden page Hidden and
+;; a page Old in the Recycle bin.
+
+(defn- raw-page [id title & {:as more}]
+  (merge {:block/uuid id :block/name (string/lower-case title) :block/title title
+          :block/tags #{:logseq.class/Page} :block/created-at 1 :block/updated-at 1}
+         more))
+
+(defn- seed-selector-graph []
+  (p/let [conn (sqlite-export/create-conn)
+          bucket #js {:put (fn [_ _ _] (p/resolved #js {})) :delete (fn [_] (p/resolved nil))}
+          self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true
+                    :env #js {"TIMEZONE" "UTC" "LOGSEQ_SYNC_ASSETS" bucket}}
+          [_ nov5] (outliner-page/create! conn journal-title {:journal? true})
+          [_ nov6] (outliner-page/create! conn "Nov 6th, 2026" {:journal? true})
+          created (p/all (map #(request! self "POST" "/semantic/pages" {:title %}) ["Notes" "notes2" "100% Done"]))
+          _ (assert (every? #(= 201 (:status %)) created) (pr-str created))
+          raw (into {} (map (fn [k] [k (random-uuid)])) [:alpha :kitchen :kitchen2 :iso :hidden :old])
+          ;; The API refuses a / in a new page's title, but graphs synced from the app can hold one.
+          _ (d/transact! conn [(raw-page (raw :alpha) "Projects/Alpha")
+                               (raw-page (raw :kitchen) "Kitchen") (raw-page (raw :kitchen2) "kitchen")
+                               (raw-page (raw :iso) "2026-11-06")
+                               (raw-page (raw :hidden) "Hidden" :logseq.property/hide? true)
+                               (raw-page (raw :old) "Old" :logseq.property/deleted-at 1)])
+          block-id (str (random-uuid))
+          tree (request! self "POST" "/semantic/block-trees"
+                         {:target-id (str nov5) :blocks [{:uuid block-id :title "Draft"}]})
+          _ (assert (= 201 (:status tree)) (pr-str tree))]
+    {:conn conn :self self
+     :ids (merge (zipmap [:notes :notes2 :done] (map #(get-in % [:body :uuid]) created))
+                 (update-vals raw str)
+                 {:nov5 (str nov5) :nov6 (str nov6) :draft block-id})}))
+
+(defn- with-selector-graph [done run]
+  (-> (p/let [graph (seed-selector-graph)] (run graph))
+      (p/catch #(is false (str %)))
+      (p/finally done)))
+
+(defn- page-count [conn]
+  (count (filter #(entity-util/page? (d/entity @conn (:e %))) (d/datoms @conn :avet :block/name))))
