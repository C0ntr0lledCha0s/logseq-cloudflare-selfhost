+(deftest snippet-text-kinds-test
+  ;; Every kind of text a snippet is cut from: several lines (first line only, in the snippet and the
+  ;; breadcrumb) and astral characters at the 80 cut (never split). A page's title is its snippet in
+  ;; delete-page-context-test, a reference shown as a title in delete-blocks-context-test.
+  (async done
+    (with-graph done
+      (fn [{:keys [self ids]}]
+        (let [emoji (apply str (repeat 81 "🙂"))]
+          (p/let [tree (request! self "POST" "/semantic/block-trees"
+                                 {:target-id (ids :notes)
+                                  :blocks [{:title "Trip plan\nflights and hotels" :children [{:title "Visa"}]}
+                                           {:title emoji}]})
+                  [trip emoji-block] (map :uuid (get-in tree [:body :blocks]))
+                  visa (get-in tree [:body :blocks 0 :children 0 :uuid])
+                  deleted (request! self "DELETE" "/semantic/blocks" {:block-ids [visa emoji-block]})
+                  page-move (request! self "POST" "/semantic/block-moves"
+                                      {:block-ids [trip] :target-id (ids :agenda) :position "after"})]
+            (is (= [["Notes"] "Trip plan"] ((juxt :breadcrumb :snippet) (get-in tree [:body :affected 0]))))
+            (is (= [["Notes" "Trip plan"] "Visa"] ((juxt :breadcrumb :snippet) (get-in deleted [:body :affected 0])))
+                "an ancestor's breadcrumb entry is its first line too")
+            (is (= (apply str (repeat 80 "🙂")) (get-in deleted [:body :affected 1 :snippet]))
+                "80 characters, not 80 UTF-16 units")
+            (is (= [journal-title ["Meeting"]] ((juxt (comp :title :page) :breadcrumb) (get-in page-move [:body :affected 0 :to])))
+                "a move names the first line of the moved block")
+            (is (= "Trip plan" (get-in page-move [:body :affected 0 :snippet])))))))))
