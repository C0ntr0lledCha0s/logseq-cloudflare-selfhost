+(deftest label-is-a-guard-only-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self ids]}]
+        (p/let [notes (str journal-title " > Notes")
+                ;; A second block reading Notes, under Meeting, which the same label would also fit.
+                other (request! self "POST" "/semantic/block-trees" {:target-id (ids :meeting) :blocks [{:title "Notes"}]})
+                other-id (get-in other [:body :blocks 0 :uuid])
+                elsewhere (request! self "PATCH" (labelled (str "/semantic/blocks/" (ids :agenda)) notes) {:title "Notes moved"})
+                tree (request! self "POST" (labelled "/semantic/block-trees" notes)
+                               {:target-id (ids :agenda) :blocks [{:title "Lost"}]})
+                matched (request! self "PATCH" (labelled (str "/semantic/blocks/" other-id) notes) {:title "Meeting notes"})]
+          (is (= [409 (mismatch notes agenda-path)] (refused elsewhere)) "a label that fits another block never redirects")
+          (is (= [409 (mismatch notes agenda-path)] (refused tree)))
+          (is (= ["Agenda" "Notes"] (map #(:block/title (d/entity @conn [:block/uuid (uuid (ids %))])) [:agenda :notes])))
+          (is (= ["Sam's number" "Contract draft" "Board pack"]
+                 (map :block/title (sort-by :block/order (:block/_parent (d/entity @conn [:block/uuid (uuid (ids :call))]))))))
+          (is (= 200 (:status matched)) (pr-str matched))
+          (is (= ["Meeting notes" "Notes"]
+                 (map #(:block/title (d/entity @conn [:block/uuid (uuid %)])) [other-id (ids :notes)]))
+              "only the block the call names is written, though the label fits both"))))))
