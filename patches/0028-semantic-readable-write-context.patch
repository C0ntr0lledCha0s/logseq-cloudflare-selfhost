+;; Readable write context (patch 0028): what a write touched, named for a reader by its page title,
+;; breadcrumb and a snippet, beside its UUID. The block-changes feed shares feed-text and
+;; feed-ancestors; item 28's audit log is meant to reuse block-context. Delete context is taken from
+;; the snapshot before the delete, since the blocks are gone after it.
+
+(def ^:private context-snippet-length 80)
+(def ^:private context-max-ancestors 5)
+
+(defn- feed-text [entity]
+  (or (db-content/recur-replace-uuid-in-block-title entity) ""))
+
+(defn- feed-ancestors
+  "The block's ancestors below its page, outermost first; with `limit`, only the nearest `limit`."
+  ([block] (feed-ancestors block nil))
+  ([block limit]
+   (let [page-id (:db/id (:block/page block))]
+     (loop [parent (:block/parent block)
+            above ()]
+       (if (or (nil? parent) (= page-id (:db/id parent)) (and limit (>= (count above) limit)))
+         (vec above)
+         (recur (:block/parent parent) (conj above parent)))))))
+
+(defn- context-snippet
+  "The first line of `text`, cut to 80 characters (code points, so an emoji is never split)."
+  [text]
+  (let [line (or (first (string/split-lines (or text ""))) "")
+        chars (js/Array.from line)]
+    (if (> (.-length chars) context-snippet-length)
+      (.join (.slice chars 0 context-snippet-length) "")
+      line)))
+
+(defn- block-context
+  "`entity` named for a reader: {:uuid :kind :page {:uuid :title} :breadcrumb :snippet}. The
+  breadcrumb is the snippets of its five nearest ancestors below the page, outermost first; the
+  snippet is its first line with references shown as titles (a page's is its title). `descendants`,
+  when given, is passed through. Reads only the entity's own snapshot. On an E2EE graph titles and
+  text are encrypted, so they are left out and :e2ee is true."
+  [entity {:keys [e2ee? descendants]}]
+  (when-not entity (throw (ex-info "the block is no longer in the graph" {})))
+  (let [block? (some? (:block/page entity))
+        page (if block? (:block/page entity) entity)]
+    (cond-> {:uuid (uuid-string (:block/uuid entity))
+             :kind (if (ldb/journal? entity) "journal" (block-kind entity))
+             :page (cond-> {:uuid (uuid-string (:block/uuid page))}
+                     (not e2ee?) (assoc :title (:block/title page)))}
+      (not e2ee?) (assoc :breadcrumb (if block?
+                                       (mapv (comp context-snippet feed-text)
+                                             (feed-ancestors entity context-max-ancestors))
+                                       [])
+                         :snippet (context-snippet (if block? (feed-text entity) (:block/title entity))))
+      e2ee? (assoc :e2ee true)
+      (some? descendants) (assoc :descendants descendants))))
+
+(defn- block-location
+  "Where `entity` sits: its context's page and breadcrumb (a move's from and to)."
+  [entity e2ee?]
+  (select-keys (block-context entity {:e2ee? e2ee?}) [:page :breadcrumb]))
+
+(defn- removed?
+  "True when no entity has `id` any more, or it is in the Recycle bin (where page deletes put pages)."
+  [db id]
+  (let [entity (d/entity db [:block/uuid id])]
+    (or (nil? entity) (ldb/recycled? entity))))
+
+(defn- confirm-removed!
+  "Throws when any of `ids` (UUIDs a delete removed) is still in `db`, so a delete never answers
+  success it didn't have. `rejecting` answers it as 500 with the survivors under not-removed."
+  [db ids]
+  (when-let [left (seq (remove #(removed? db %) ids))]
+    (throw (ex-info (str (count left) " of " (count ids) " deleted blocks were not removed")
+                    {:status 500 ::not-removed (mapv str left)}))))
+
+(defn- with-context-or-unavailable
+  "`response` merged with what `read` returns. `read` names what a committed write touched; if it
+  fails, the write stands and the response says the context is unavailable, and why."
+  [response read]
+  (merge response
+         (try (read)
+              (catch :default error
+                {:context "unavailable" :context-reason (or (ex-message error) (str error))}))))
+
+;; A page selector names a page by UUID, by ISO journal date or by title. A UUID resolves as each
+;; caller always did (find-entity or find-visible-entity). A YYYY-MM-DD that is a calendar day reads
+;; the journal through one :block/journal-day datom, and a page whose title is that same text makes it
+;; ambiguous. A title reads the :block/name index once: the pages with exactly that title, else those
+;; with it ignoring case. Hidden and recycled pages never match, nothing is created, and several
+;; matches are refused with each candidate rather than one winning.
+
+(defn- iso-journal-day
+  "The journal day (yyyyMMdd as an integer) `selector` names as an ISO date, or nil when it isn't a
+  YYYY-MM-DD that is on the calendar."
+  [selector]
+  (when-let [[_ y m d] (re-matches #"(\d{4})-(\d{2})-(\d{2})" selector)]
+    (let [[y m d] (map #(js/parseInt % 10) [y m d])
+          date (js/Date. (js/Date.UTC y (dec m) d))]
+      (when (and (= y (.getUTCFullYear date)) (= (dec m) (.getUTCMonth date)) (= d (.getUTCDate date)))
+        (+ (* y 10000) (* m 100) d)))))
+
+(defn- visible-pages [db eids]
+  (->> (distinct eids)
+       (map #(d/entity db %))
+       (filter page?)
+       (remove entity-util/hidden?)
+       (sort-by :db/id)))
+
+(defn- titled-pages
+  "Visible pages titled exactly `title`, or when none is, those titled `title` ignoring case."
+  [db title]
+  (let [named (visible-pages db (map :e (d/datoms db :avet :block/name (common-util/page-name-sanity-lc title))))]
+    (or (seq (filter #(= title (:block/title %)) named)) named)))
+
+(defn- resolve-page-selector
+  "What `selector` names, as {:ok entity}, or a refusal {:status :error} naming `field` (with
+  :candidates on a 409). A UUID, or anything but a non-blank string, goes to `find` as before, and
+  {:ok nil} means it found nothing. On an E2EE graph titles are ciphertext, so only UUIDs resolve."
+  [db selector field {:keys [e2ee? find]}]
+  (cond
+    (or (not (non-blank-string? selector)) (parse-uuid selector)) {:ok (find db selector)}
+    e2ee? {:status 400
+           :error (str field ": page titles and journal dates are unavailable for E2EE graphs; pass the page's UUID")}
+    :else
+    (let [day (iso-journal-day selector)
+          journals (when day (visible-pages db (map :e (d/datoms db :avet :block/journal-day day))))
+          found (vec (distinct (concat journals (titled-pages db selector))))]
+      (case (count found)
+        1 {:ok (first found)}
+        0 {:status 404
+           :error (str field ": " (when day (str "no journal for " selector " and ")) "no page titled \"" selector "\"")}
+        {:status 409
+         :error (str field ": \"" selector "\" names " (count found) " pages: "
+                     (string/join ", " (map #(str "\"" (:block/title %) "\" (" (:block/uuid %) ")") found))
+                     "; pass one of their UUIDs")
+         :candidates (mapv #(hash-map :uuid (uuid-string (:block/uuid %)) :title (:block/title %)) found)}))))
+
+(defn- selector-refusal [{:keys [status error candidates]}]
+  (if candidates
+    (http/json-response nil {:error error :candidates candidates} status)
+    (http/error-response error status)))
+
+(defn- with-page-selector
+  "(f entity) for the page `selector` names (nil when a UUID names nothing, as before), or the
+  selector's refusal as a response."
+  [db e2ee? field selector find f]
+  (let [selected (resolve-page-selector db selector field {:e2ee? e2ee? :find find})]
+    (if (:error selected) (selector-refusal selected) (f (:ok selected)))))
+
+;; A target-label names a write's target for a reader, "Page > parent > ... > block", and the write
+;; checks it against the real target before it changes anything: a guard, never a way to find the
+;; target. The first segment is the page title, ignoring case. The rest match, from the last one
+;; back, the target's first line and then its nearest ancestors; ancestors above the topmost segment
+;; may be left out. Each is a case-insensitive prefix of at least 3 characters of the line it matches,
+;; or the whole line when that is shorter. A page target takes the page title alone. Every label in a
+;; call is checked against the snapshot the write runs on, and any mismatch refuses the whole call.
+
+(def ^:private label-separator " > ")
+(def ^:private label-min-length 3)
+
+(defn- code-point-count [text]
+  (.-length (js/Array.from text)))
+
+(defn- label-text [text]
+  (string/lower-case (string/trim (or text ""))))
+
+(defn- segment-matches?
+  "True when label `segment` fits `line`: a prefix of at least 3 characters, ignoring case, or all
+  of a line shorter than that."
+  [segment line]
+  (let [segment (label-text segment)
+        line (label-text line)]
+    (if (< (code-point-count line) label-min-length)
+      (= segment line)
+      (and (>= (code-point-count segment) label-min-length)
+           (string/starts-with? line segment)))))
+
+(defn- first-line [entity]
+  (or (first (string/split-lines (feed-text entity))) ""))
+
+(defn- label-matches?
+  "True when `label` names `entity` (a page or a block) as section 3.4 of the design says. `segments`
+  is the label split on \" > \"."
+  [entity segments]
+  (let [[page-segment & below] segments
+        block? (some? (:block/page entity))
+        page (if block? (:block/page entity) entity)]
+    (and (= (label-text page-segment) (label-text (:block/title page)))
+         (if-not block?
+           (empty? below)
+           (let [ancestors (feed-ancestors entity (dec (count below)))
+                 lines (map first-line (cons entity (reverse ancestors)))]
+             (and (seq below)
+                  (<= (count below) (count lines))
+                  (every? true? (map segment-matches? (reverse below) lines))))))))
+
+(defn- label-found
+  "How the target reads as a label, page title first: what a mismatch reports was found."
+  [entity]
+  (let [{:keys [page breadcrumb snippet]} (block-context entity {})]
+    (string/join label-separator (if (:block/page entity)
+                                   (concat [(:title page)] breadcrumb [snippet])
+                                   [(:title page)]))))
+
+(defn- label-error
+  "Why `label` doesn't name `target` (an entity, or {:page title} for a page the write will create),
+  or nil when it does."
+  [target label]
+  (let [segments (vec (.split label label-separator))
+        page-title (:page target)]
+    (cond
+      (some string/blank? segments) (str "target-label \"" label "\" has an empty segment")
+      (if page-title
+        (and (= 1 (count segments)) (= (label-text label) (label-text page-title)))
+        (label-matches? target segments))
+      nil
+      :else (str "target-label \"" label "\" does not match target \""
+                 (if page-title page-title (label-found target)) "\""))))
+
+(defn- check-target-labels
+  "nil when each check's label names its target in `db`, else the refusal of the whole call: 409
+  listing every failing entry with what was given and what was found (400 on an E2EE graph, whose
+  titles can't be compared). A check is {:entry index-or-nil :id db-id :label string}, or
+  {:entry :page title :label} for a page the write creates; a check without a label is skipped."
+  [db e2ee? checks]
+  (let [checks (filter :label checks)]
+    (cond
+      (empty? checks) nil
+      e2ee? {:status 400
+             :error "target-label: labels can't be checked on an E2EE graph, where titles are encrypted; leave it out"}
+      :else
+      (when-let [errors (seq (keep (fn [{:keys [entry id page label]}]
+                                     (when-let [error (label-error (if page {:page page} (d/entity db id)) label)]
+                                       (str (when entry (str "entry " entry ": ")) error)))
+                                   checks))]
+        {:status 409 :error (string/join "; " errors)}))))
+
+(defn- check-labels!
+  "Throws the refusal check-target-labels gives, so a write calling this first inside its
+  transaction changes nothing; `rejecting` and `refusing-labels` answer it."
+  [db e2ee? checks]
+  (when-let [refusal (check-target-labels db e2ee? checks)]
+    (throw (ex-info (:error refusal) {::label-refusal refusal}))))
+
+(defn- label-refusal-response [error]
+  (when-let [{:keys [status error]} (::label-refusal (ex-data error))]
+    (http/error-response error status)))
+
+(defn- refusing-labels
+  "Calls `write`, answering a label refusal from inside it; other errors propagate."
+  [write]
+  (try (write)
+       (catch :default error
+         (or (label-refusal-response error) (throw error)))))
+
+(defn- labels-error
+  "Why the labels a call gives are malformed, or nil: `labels`, when given, must be strings, one
+  per block-id; `entries` (batch entries or moves) may each give a string target-label."
+  ([entries]
+   (some (fn [[index entry]]
+           (when (and (map? entry) (contains? entry :target-label) (not (string? (:target-label entry))))
+             (str "entry " index ": target-label must be a string")))
+         (map-indexed vector (when (sequential? entries) entries))))
+  ([labels block-ids]
+   (cond
+     (nil? labels) nil
+     (not (sequential? labels)) "labels must be an array of strings, one per block-id"
+     (not= (count labels) (count block-ids))
+     (str "labels: " (count labels) (if (= 1 (count labels)) " label" " labels") " for " (count block-ids) " block-ids")
+     :else (some (fn [[index label]] (when-not (string? label) (str "labels[" index "]: must be a string")))
+                 (map-indexed vector labels)))))
+
+(defn- target-context
+  "{:target context} of `entity` as `db` now has it."
+  [db entity e2ee?]
+  {:target (block-context (d/entity db (:db/id entity)) {:e2ee? e2ee?})})
+
+(defn- affected-context
+  "{:affected [context]} of each of `entities` as `db` now has them, in order."
+  [db entities e2ee?]
+  {:affected (mapv #(block-context (d/entity db (:db/id %)) {:e2ee? e2ee?}) entities)})
+
+(defn- insert-context
+  "{:target :affected} for an insert under `target`: the target's context, and each top-level block
+  of `nodes` (as insert-tree! answered them) with its descendant count, as `db` now has them. Only
+  the top level is named, so a 50-block tree adds one line, not 50."
+  [db target nodes e2ee?]
+  {:target (block-context (d/entity db (:db/id target)) {:e2ee? e2ee?})
+   :affected (mapv #(block-context (d/entity db [:block/uuid (uuid (:uuid %))])
+                                   {:e2ee? e2ee? :descendants (tree-count (:children %))})
+                   nodes)})
+
+(defn- moved-response
+  "`response` with each moved block's snippet, where it was (`before`: contexts read before the
+  move) and where it is now in `db`. If the read after the move fails, `to` is left out."
+  [response db before e2ee?]
+  (let [affected (mapv #(-> (select-keys % [:uuid :kind :snippet :e2ee])
+                            (assoc :from (select-keys % [:page :breadcrumb])))
+                       before)]
+    (with-context-or-unavailable
+      (assoc response :affected affected)
+      (fn []
+        {:affected (mapv #(assoc % :to (block-location (d/entity db [:block/uuid (uuid (:uuid %))]) e2ee?))
+                         affected)}))))
+
