+(defn- transactions!
+  "Runs `call` and answers [its response, the number of transactions it made on `conn`]."
+  [conn call]
+  (let [count* (atom 0)
+        key (keyword (str "label-tx-" (random-uuid)))]
+    (d/listen! conn key (fn [{:keys [tx-data]}] (when (seq tx-data) (swap! count* inc))))
+    (-> (p/let [response (call)] [response @count*])
+        (p/finally #(d/unlisten! conn key)))))
+
+(deftest label-one-transaction-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self ids journal]}]
+        (p/let [property-id (add-owner! self ids)
+                notes (str journal-title " > Notes")
+                calls [["batchSetBlockProperty"
+                        #(request! self "POST" "/semantic/block-properties/batch-set"
+                                   {:entries [{:block-id (ids :notes) :property-id property-id :value "Bo" :target-label notes}
+                                              {:block-id (ids :agenda) :property-id property-id :value "Bo"
+                                               :target-label agenda-path}]})]
+                       ["batchMoveBlocks"
+                        #(request! self "POST" "/semantic/block-moves/batch"
+                                   {:moves [{:block-ids [(ids :c1)] :target-id (ids :notes) :target-label notes :position "last-child"}
+                                            {:block-ids [(ids :c2)] :target-id journal :target-label journal-title
+                                             :position "first-child"}]})]
+                       ["moveBlocks"
+                        #(request! self "POST" (labelled "/semantic/block-moves" notes)
+                                   {:block-ids [(ids :c3)] :target-id (ids :notes) :position "first-child"})]
+                       ["deleteBlockProperty"
+                        #(request! self "DELETE" (labelled (str "/semantic/blocks/" (ids :flights) "/properties/" property-id)
+                                                           (str notes " > Book flights"))
+                                   nil)]
+                       ["deleteBlock"
+                        #(request! self "DELETE" (labelled (str "/semantic/blocks/" (ids :c1)) (str notes " > Sam's")) nil)]
+                       ["deleteBlocks"
+                        #(request! self "DELETE" "/semantic/blocks"
+                                   {:block-ids [(ids :c2) (ids :ref)]
+                                    :labels [(str journal-title " > Contract") (str journal-title " > [[Meeting]]")]})]]
+                results (in-order (map (fn [[operation call]]
+                                         #(p/let [result (transactions! conn call)] [operation result]))
+                                       calls))]
+          (doseq [[operation [response transactions]] results]
+            (is (= 200 (:status response)) (str operation " " (pr-str response)))
+            (is (= 1 transactions) (str operation ": the label check and the write are one transaction"))))))))
