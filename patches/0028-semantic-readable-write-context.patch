+;; target-label (stage 5): a block-targeted write names its target as "Page > parent > ... > block",
+;; and the server checks it against the real target inside the write before changing anything. The
+;; label is a guard only; any mismatch refuses the whole call with 409 and writes nothing.
+
+(defn- labelled
+  "`path` with `label` as its target-label query parameter, URL-encoded."
+  [path label]
+  (str path (if (string/includes? path "?") "&" "?") "target-label=" (js/encodeURIComponent label)))
+
+(defn- datoms-of
+  "Every datom of `db` with its tx, to compare a graph before and after a call datom for datom."
+  [db]
+  (mapv (juxt :e :a :v :tx) (d/datoms db :eavt)))
+
+(defn- graph-diff
+  "What changed between two snapshots: the datoms only in `before` and only in `after` (empty when
+  the graph is unchanged datom for datom), kept short for a failure message."
+  [before after]
+  (let [a (set (datoms-of before)) b (set (datoms-of after))]
+    {:removed (count (remove b a)) :added (vec (take 5 (remove a b)))}))
+
+(def ^:private unchanged {:removed 0 :added []})
+
+(defn- mismatch
+  "The refusal text for a label that doesn't fit, as the spec words it."
+  ([given found] (str "target-label \"" given "\" does not match target \"" found "\""))
+  ([entry given found] (str "entry " entry ": " (mismatch given found))))
+
+(defn- refused [response] [(:status response) (get-in response [:body :error])])
+
+(defn- add-owner!
+  "An Owner text property, set to Ann on Agenda and Book flights; its UUID."
+  [self ids]
+  (p/let [property (request! self "POST" "/semantic/properties" {:title "Owner" :type "default"})
+          property-id (get-in property [:body :uuid])
+          _ (p/all (map #(request! self "PUT" (str "/semantic/blocks/" (ids %) "/properties/" property-id) {:value "Ann"})
+                        [:agenda :flights]))]
+    property-id))
+
+(def ^:private agenda-path (str journal-title " > Meeting > Agenda"))
+
