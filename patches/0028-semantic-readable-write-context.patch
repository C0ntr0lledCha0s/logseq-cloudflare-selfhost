+(deftest label-openapi-test
+  (let [document (semantic-routes/openapi-document "https://issuer.example")
+        operations (into {} (for [[_ methods] (:paths document)
+                                  [_ operation] methods
+                                  :when (map? operation)]
+                              [(:operationId operation) operation]))
+        body (fn [operation-id] (get-in operations [operation-id :requestBody :content "application/json" :schema :properties]))]
+    (testing "the seven single-target writes take a target-label query parameter"
+      (doseq [operation-id ["insertBlockChildren" "insertBlockTree" "updateBlock" "deleteBlock"
+                            "setBlockProperty" "deleteBlockProperty" "moveBlocks"]]
+        (let [parameter (some #(when (= "target-label" (:name %)) %) (get-in operations [operation-id :parameters]))]
+          (is (= {:in "query" :schema {:type "string"}} (select-keys parameter [:in :schema])) operation-id)
+          (is (string/includes? (str (:description parameter)) "never") operation-id))))
+    (testing "each batch entry takes a target-label"
+      (doseq [[operation-id field] [["batchInsertBlockTrees" :entries] ["batchMoveBlocks" :moves]
+                                    ["batchSetBlockProperty" :entries] ["batchDeleteBlockProperty" :entries]]]
+        (is (= "string" (get-in (body operation-id) [field :items :properties :target-label :type])) operation-id)))
+    (testing "each of them documents the 409 a mismatch answers"
+      (doseq [operation-id ["insertBlockChildren" "insertBlockTree" "updateBlock" "deleteBlock" "setBlockProperty"
+                            "deleteBlockProperty" "moveBlocks" "batchInsertBlockTrees" "batchMoveBlocks"
+                            "batchSetBlockProperty" "batchDeleteBlockProperty" "deleteBlocks"]]
+        (is (string/includes? (get-in operations [operation-id :responses "409" :description]) "target-label") operation-id)))
+    (testing "deleteBlocks takes labels parallel to block-ids"
+      (is (= {:type "array" :items {:type "string"}} (select-keys (:labels (body "deleteBlocks")) [:type :items]))))))
