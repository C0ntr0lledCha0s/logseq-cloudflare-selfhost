+;; Readable write context (patch 0028): what a write touched, named for a reader by its page title,
+;; breadcrumb and a snippet, beside its UUID. The block-changes feed shares feed-text and
+;; feed-ancestors; item 28's audit log is meant to reuse block-context. Delete context is taken from
+;; the snapshot before the delete, since the blocks are gone after it.
+
+(def ^:private context-snippet-length 80)
+(def ^:private context-max-ancestors 5)
+
+(defn- feed-text [entity]
+  (or (db-content/recur-replace-uuid-in-block-title entity) ""))
+
+(defn- feed-ancestors
+  "The block's ancestors below its page, outermost first; with `limit`, only the nearest `limit`."
+  ([block] (feed-ancestors block nil))
+  ([block limit]
+   (let [page-id (:db/id (:block/page block))]
+     (loop [parent (:block/parent block)
+            above ()]
+       (if (or (nil? parent) (= page-id (:db/id parent)) (and limit (>= (count above) limit)))
+         (vec above)
+         (recur (:block/parent parent) (conj above parent)))))))
+
+(defn- context-snippet
+  "The first line of `text`, cut to 80 characters (code points, so an emoji is never split)."
+  [text]
+  (let [line (or (first (string/split-lines (or text ""))) "")
+        chars (js/Array.from line)]
+    (if (> (.-length chars) context-snippet-length)
+      (.join (.slice chars 0 context-snippet-length) "")
+      line)))
+
+(defn- block-context
+  "`entity` named for a reader: {:uuid :kind :page {:uuid :title} :breadcrumb :snippet}. The
+  breadcrumb is the snippets of its five nearest ancestors below the page, outermost first; the
+  snippet is its first line with references shown as titles (a page's is its title). `descendants`,
+  when given, is passed through. Reads only the entity's own snapshot. On an E2EE graph titles and
+  text are encrypted, so they are left out and :e2ee is true."
+  [entity {:keys [e2ee? descendants]}]
+  (when-not entity (throw (ex-info "the block is no longer in the graph" {})))
+  (let [block? (some? (:block/page entity))
+        page (if block? (:block/page entity) entity)]
+    (cond-> {:uuid (uuid-string (:block/uuid entity))
+             :kind (if (ldb/journal? entity) "journal" (block-kind entity))
+             :page (cond-> {:uuid (uuid-string (:block/uuid page))}
+                     (not e2ee?) (assoc :title (:block/title page)))}
+      (not e2ee?) (assoc :breadcrumb (if block?
+                                       (mapv (comp context-snippet feed-text)
+                                             (feed-ancestors entity context-max-ancestors))
+                                       [])
+                         :snippet (context-snippet (if block? (feed-text entity) (:block/title entity))))
+      e2ee? (assoc :e2ee true)
+      (some? descendants) (assoc :descendants descendants))))
+
+(defn- block-location
+  "Where `entity` sits: its context's page and breadcrumb (a move's from and to)."
+  [entity e2ee?]
+  (select-keys (block-context entity {:e2ee? e2ee?}) [:page :breadcrumb]))
+
+(defn- removed?
+  "True when no entity has `id` any more, or it is in the Recycle bin (where page deletes put pages)."
+  [db id]
+  (let [entity (d/entity db [:block/uuid id])]
+    (or (nil? entity) (ldb/recycled? entity))))
+
+(defn- confirm-removed!
+  "Throws when any of `ids` (UUIDs a delete removed) is still in `db`, so a delete never answers
+  success it didn't have. `rejecting` answers it as 500 with the survivors under not-removed."
+  [db ids]
+  (when-let [left (seq (remove #(removed? db %) ids))]
+    (throw (ex-info (str (count left) " of " (count ids) " deleted blocks were not removed")
+                    {:status 500 ::not-removed (mapv str left)}))))
+
+(defn- with-context-or-unavailable
+  "`response` merged with what `read` returns. `read` names what a committed write touched; if it
+  fails, the write stands and the response says the context is unavailable, and why."
+  [response read]
+  (merge response
+         (try (read)
+              (catch :default error
+                {:context "unavailable" :context-reason (or (ex-message error) (str error))}))))
+
+(defn- target-context
+  "{:target context} of `entity` as `db` now has it."
+  [db entity e2ee?]
+  {:target (block-context (d/entity db (:db/id entity)) {:e2ee? e2ee?})})
+
+(defn- affected-context
+  "{:affected [context]} of each of `entities` as `db` now has them, in order."
+  [db entities e2ee?]
+  {:affected (mapv #(block-context (d/entity db (:db/id %)) {:e2ee? e2ee?}) entities)})
+
+(defn- insert-context
+  "{:target :affected} for an insert under `target`: the target's context, and each top-level block
+  of `nodes` (as insert-tree! answered them) with its descendant count, as `db` now has them. Only
+  the top level is named, so a 50-block tree adds one line, not 50."
+  [db target nodes e2ee?]
+  {:target (block-context (d/entity db (:db/id target)) {:e2ee? e2ee?})
+   :affected (mapv #(block-context (d/entity db [:block/uuid (uuid (:uuid %))])
+                                   {:e2ee? e2ee? :descendants (tree-count (:children %))})
+                   nodes)})
+
+(defn- moved-response
+  "`response` with each moved block's snippet, where it was (`before`: contexts read before the
+  move) and where it is now in `db`. If the read after the move fails, `to` is left out."
+  [response db before e2ee?]
+  (let [affected (mapv #(-> (select-keys % [:uuid :kind :snippet :e2ee])
+                            (assoc :from (select-keys % [:page :breadcrumb])))
+                       before)]
+    (with-context-or-unavailable
+      (assoc response :affected affected)
+      (fn []
+        {:affected (mapv #(assoc % :to (block-location (d/entity db [:block/uuid (uuid (:uuid %))]) e2ee?))
+                         affected)}))))
+
