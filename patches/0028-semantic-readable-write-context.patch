+(defn- in-order
+  "Runs each of `calls` (functions answering a promise) after the one before has finished; their results."
+  [calls]
+  (reduce (fn [results call] (p/let [out results result (call)] (conj out result)))
+          (p/resolved [])
+          calls))
+
+(defn- parent-title [conn id]
+  (:block/title (:block/parent (d/entity @conn [:block/uuid (uuid id)]))))
