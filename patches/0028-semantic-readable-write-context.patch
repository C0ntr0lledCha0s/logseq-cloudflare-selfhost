@@ -0,0 +1,430 @@
+(ns logseq.db-sync.semantic-readable-writes-test
+  "Readable write results (patch 0028). Deletes, moves, inserts and property writes answer the page
+  title, breadcrumb (up to the five nearest ancestors below the page) and an 80-character snippet of
+  each block they touched, with references shown as titles. Delete context comes from the snapshot
+  before the delete, and every deleted UUID is read back; survivors answer 500 under not-removed. A
+  context read after a committed write that fails answers context: unavailable and keeps the write.
+  E2EE graphs get context without titles or text.
+
+  The graph is a journal Nov 5th, 2026 holding Meeting > Agenda > a block longer than 80 characters
+  with three children, a block that is only a reference to the page Meeting, Notes > Book flights,
+  and a chain L1 > ... > L7 > Deep leaf."
+  (:require [cljs.test :refer [async deftest is testing]]
+            [clojure.string :as string]
+            [datascript.core :as d]
+            [logseq.db-sync.test-sql :as test-sql]
+            [logseq.db-sync.worker.handler.semantic :as semantic-handler]
+            [logseq.db-sync.worker.handler.sync :as sync-handler]
+            [logseq.db.frontend.entity-util :as entity-util]
+            [logseq.db.sqlite.export :as sqlite-export]
+            [logseq.outliner.core :as outliner-core]
+            [logseq.outliner.page :as outliner-page]
+            [promesa.core :as p]))
+
+(defn- request!
+  "One semantic API request through the real handler; returns {:status :body}."
+  [self method path body]
+  (p/let [url (str "http://localhost" path (if (string/includes? path "?") "&" "?") "graph-id=graph-1")
+          response (sync-handler/handle-http
+                    self
+                    (js/Request. url (clj->js (cond-> {:method method
+                                                       :headers {"content-type" "application/json"}}
+                                                body (assoc :body (js/JSON.stringify (clj->js body)))))))
+          text (.text response)]
+    {:status (.-status response)
+     :body (when (seq text)
+             (try (js->clj (js/JSON.parse text) :keywordize-keys true)
+                  (catch :default _ text)))}))
+
+(def ^:private long-title
+  "Call Sam about the contract renewal before Friday's review meeting with the board, and agree the terms")
+
+(def ^:private long-snippet (subs long-title 0 80))
+
+(def ^:private journal-title "Nov 5th, 2026")
+
+(defn- seed-graph
+  "A fresh graph holding the blocks the namespace docstring names, the handler context to call it
+  through, and each block's UUID by name."
+  []
+  (p/let [conn (sqlite-export/create-conn)
+          bucket #js {:put (fn [_ _ _] (p/resolved #js {})) :delete (fn [_] (p/resolved nil))}
+          self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true
+                    :env #js {"TIMEZONE" "UTC" "LOGSEQ_SYNC_ASSETS" bucket}}
+          [_ journal] (outliner-page/create! conn journal-title {:journal? true})
+          ids (into {} (map (fn [k] [k (str (random-uuid))]))
+                    [:meeting :agenda :call :c1 :c2 :c3 :ref :notes :flights
+                     :l1 :l2 :l3 :l4 :l5 :l6 :l7 :leaf])
+          node (fn [k title & children]
+                 (cond-> {:uuid (ids k) :title title} (seq children) (assoc :children (vec children))))
+          chain (reduce (fn [child k] (node k (string/upper-case (name k)) child))
+                        (node :leaf "Deep leaf")
+                        [:l7 :l6 :l5 :l4 :l3 :l2 :l1])
+          tree (request! self "POST" "/semantic/block-trees"
+                         {:target-id (str journal)
+                          :blocks [(node :meeting "Meeting"
+                                         (node :agenda "Agenda"
+                                               (node :call long-title
+                                                     (node :c1 "Sam's number") (node :c2 "Contract draft")
+                                                     (node :c3 "Board pack"))))
+                                   (node :ref "[[Meeting]]")
+                                   (node :notes "Notes" (node :flights "Book flights"))
+                                   chain]})
+          _ (assert (= 201 (:status tree)) (pr-str tree))]
+    {:conn conn :self self :ids ids :journal (str journal)}))
+
+(defn- with-graph [done run]
+  (-> (p/let [graph (seed-graph)] (run graph))
+      (p/catch #(is false (str %)))
+      (p/finally done)))
