+(deftest label-refusals-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self ids journal]}]
+        (p/let [q4 (request! self "POST" "/semantic/block-trees" {:target-id journal :blocks [{:title "Q4"}]})
+                q4-id (get-in q4 [:body :blocks 0 :uuid])
+                before @conn
+                update! (fn [id label] (request! self "PATCH" (labelled (str "/semantic/blocks/" id) label) {:title "Changed"}))
+                empty-segment (update! (ids :agenda) (str journal-title " >  > Agenda"))
+                empty-label (update! (ids :agenda) "")
+                short-prefix (update! (ids :agenda) (str journal-title " > Ag"))
+                short-snippet (update! q4-id (str journal-title " > Q"))
+                longer (update! (ids :agenda) (str journal-title " > Agendas"))
+                extra (update! (ids :notes) (str journal-title " > Whatever > Notes"))
+                page-prefix (update! (ids :notes) "Nov 5th > Notes")
+                page-only (update! (ids :notes) journal-title)
+                out-of-place (update! (ids :call) agenda-path)
+                block-on-page (request! self "POST" (labelled "/semantic/block-trees" (str journal-title " > Notes"))
+                                        {:target-id journal :blocks [{:title "x"}]})
+                e2ee (request! self "POST" (labelled "/semantic/block-moves?graph-e2ee=true" journal-title)
+                               {:block-ids [(ids :c1)] :target-id journal :position "first-child"})
+                new-page (request! self "POST" "/semantic/block-trees/batch"
+                                   {:entries [{:page "Ideas" :target-label "Idea" :blocks [{:title "One"}]}]})
+                with-entry (request! self "POST" "/semantic/block-moves/batch"
+                                     {:moves [{:block-ids [(ids :c1)] :target-id (ids :notes) :position "first-child"
+                                               :target-label (str journal-title " > No")}]})]
+          (is (= [409 (str "target-label \"" journal-title " >  > Agenda\" has an empty segment")] (refused empty-segment)))
+          (is (= [409 "target-label \"\" has an empty segment"] (refused empty-label)))
+          (is (= [409 (mismatch (str journal-title " > Ag") agenda-path)] (refused short-prefix))
+              "a prefix shorter than 3 characters")
+          (is (= [409 (mismatch (str journal-title " > Q") (str journal-title " > Q4"))] (refused short-snippet))
+              "a snippet under 3 characters must be given in full")
+          (is (= [409 (mismatch (str journal-title " > Agendas") agenda-path)] (refused longer)))
+          (is (= [409 (mismatch (str journal-title " > Whatever > Notes") (str journal-title " > Notes"))] (refused extra))
+              "more segments than the target has levels")
+          (is (= [409 (mismatch "Nov 5th > Notes" (str journal-title " > Notes"))] (refused page-prefix))
+              "the page segment is the whole title")
+          (is (= [409 (mismatch journal-title (str journal-title " > Notes"))] (refused page-only))
+              "a block target needs its own segment")
+          (is (= [409 (mismatch agenda-path (str agenda-path " > " long-snippet))] (refused out-of-place))
+              "the last segment is the target itself")
+          (is (= [409 (mismatch (str journal-title " > Notes") journal-title)] (refused block-on-page))
+              "a page target takes the page-only form")
+          (is (= [400 "target-label: labels can't be checked on an E2EE graph, where titles are encrypted; leave it out"]
+                 (refused e2ee)))
+          (is (= [409 (mismatch 0 "Idea" "Ideas")] (refused new-page))
+              "a page the batch would create takes its own title, in full")
+          (is (= [409 (mismatch 0 (str journal-title " > No") (str journal-title " > Notes"))] (refused with-entry))
+              "a 2-character prefix in a batch entry")
+          (is (= unchanged (graph-diff before @conn)) "no refused call wrote anything"))))))
