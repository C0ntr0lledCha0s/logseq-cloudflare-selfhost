@@ -0,0 +1,177 @@
+(ns logseq.db-sync.semantic-today-tz-test
+  "'Today' is the owner's date, not the Worker's. Workers run in UTC, so for most of a New Zealand
+  morning the UTC date is the day before. Every write that defaults to today's journal (capture,
+  createTask with no page-id, createAsset with no page-id) must use the time zone the Worker is
+  configured with (env TIMEZONE, an IANA zone), whatever the process's own zone is, and say which
+  journal it wrote to (page-id and page-title)."
+  (:require [cljs.test :refer [async deftest is testing]]
+            [clojure.string :as string]
+            [datascript.core :as d]
+            [logseq.db-sync.test-sql :as test-sql]
+            [logseq.db-sync.worker.handler.sync :as sync-handler]
+            [logseq.db.sqlite.export :as sqlite-export]
+            [promesa.core :as p]))
+
+(def ^:private fake-date-ctor
+  "A Date constructor whose no-argument form and Date.now return `fixed`."
+  (js/Function. "RD" "fixed"
+                "const F = function(...a){ return a.length ? new RD(...a) : new RD(fixed); };
+                 F.now = () => fixed; F.parse = RD.parse; F.UTC = RD.UTC; F.prototype = RD.prototype;
+                 return F;"))
+
+(defn- with-clock
+  "Runs `f` with the clock at `iso` and the process time zone set to `process-tz`, then restores
+  both. The process zone stands in for the Worker's (UTC) and for a host that differs from it."
+  [iso process-tz f]
+  (let [real-date js/Date
+        env (.-env js/process)
+        real-tz (.-TZ env)]
+    (set! (.-TZ env) process-tz)
+    (set! js/globalThis.Date (fake-date-ctor real-date (.parse real-date iso)))
+    (p/finally (p/do (f))
+               (fn []
+                 (set! js/globalThis.Date real-date)
+                 (if (some? real-tz)
+                   (set! (.-TZ env) real-tz)
+                   (js-delete env "TZ"))))))
+
+(defn- json-body [^js response]
+  (p/let [text (.text response)]
+    (when (seq text) (js->clj (js/JSON.parse text) :keywordize-keys true))))
+
+(defn- request! [self method path body]
+  (p/let [response (sync-handler/handle-http
+                    self
+                    (js/Request. (str "http://localhost" path
+                                      (if (string/includes? path "?") "&" "?") "graph-id=graph-1")
+                                 (clj->js (cond-> {:method method
+                                                   :headers {"content-type" "application/json"}}
+                                            body (assoc :body (js/JSON.stringify (clj->js body)))))))
+          parsed (json-body response)]
+    {:status (.-status response) :body parsed}))
+
+(defn- upload-asset!
+  ([self] (upload-asset! self nil "a"))
+  ([self page-id checksum-char]
+   (p/let [response (sync-handler/handle-http
+                    self
+                    (js/Request. (str "http://localhost/semantic/assets?graph-id=graph-1"
+                                      "&file-name=photo.png&title=Photo&size=4"
+                                      "&checksum=" (apply str (repeat 64 checksum-char))
+                                      (when page-id (str "&page-id=" page-id)))
+                                 #js {:method "POST"
+                                      :headers #js {"content-type" "application/octet-stream"}
+                                      :body (js/Blob. #js [(js/Uint8Array. #js [1 2 3 4])])}))
+          parsed (json-body response)]
+    {:status (.-status response) :body parsed})))
+
+(defn- stored-page
+  "The page the block `id` was stored on, read from the db rather than from any API response."
+  [conn id]
+  (let [page (:block/page (d/entity @conn [:block/uuid (uuid id)]))]
+    {:day (:block/journal-day page)
+     :title (:block/title page)
+     :uuid (some-> (:block/uuid page) str)}))
+
+(defn- make-self [timezone]
+  (let [bucket #js {:put (fn [_key _payload _options] (p/resolved #js {}))
+                    :delete (fn [_key] (p/resolved nil))}
+        env (cond-> #js {"LOGSEQ_SYNC_ASSETS" bucket}
+              timezone (doto (aset "TIMEZONE" timezone)))]
+    #js {:conn (sqlite-export/create-conn) :sql (test-sql/make-sql) :schema-ready true :env env}))
+
+(defn- write-all-defaults!
+  "Runs the three default-to-today writes on a fresh graph and returns their responses and the
+  pages the db stored them on."
+  [timezone]
+  (p/let [^js self (make-self timezone)
+          conn (.-conn self)
+          task (request! self "POST" "/semantic/tasks" {:title "Morning task"})
+          capture (request! self "POST" "/semantic/capture" {:blocks [{:title "Morning note"}]})
+          asset (upload-asset! self)]
+    {:task task :capture capture :asset asset
+     :pages {:task (some->> (get-in task [:body :uuid]) (stored-page conn))
+             :capture (some->> (get-in capture [:body :blocks 0 :uuid]) (stored-page conn))
+             :asset (some->> (get-in asset [:body :uuid]) (stored-page conn))}}))
+
+(defn- check-today! [label {:keys [task capture asset pages]} day title]
+  (testing label
+    (is (= [201 201 201] (map :status [task capture asset])) "every write succeeds")
+    (doseq [[k response] [[:task task] [:capture capture] [:asset asset]]
+            :let [page (get pages k)]]
+      (testing (name k)
+        (is (= day (:day page)) "stored on the owner's today")
+        (is (= title (:title page)))
+        (is (= (:uuid page) (get-in response [:body :page-id])) "response names the page it wrote to")
+        (is (= title (get-in response [:body :page-title])) "response names the journal's title")))
+    (is (apply = (map :uuid (vals pages))) "all three share one journal page, not a duplicate")))
+
+(def ^:private owner-cases
+  ;; [clock (UTC) process-zone expected-day expected-title what it covers]
+  [["2026-11-05T21:00:00Z" "UTC" 20261106 "Nov 6th, 2026" "10:00 NZDT, UTC is still the day before"]
+   ["2026-11-06T11:30:00Z" "UTC" 20261107 "Nov 7th, 2026" "00:30 NZDT, just past the owner's midnight"]
+   ["2026-07-01T20:00:00Z" "UTC" 20260702 "Jul 2nd, 2026" "08:00 NZST (standard time, +12)"]
+   ["2026-11-05T21:00:00Z" "America/Los_Angeles" 20261106 "Nov 6th, 2026"
+    "a host zone that is neither UTC nor the owner's"]])
+
+(deftest today-is-the-configured-zone-s-date-test
+  (async done
+    (-> (p/loop [cases owner-cases]
+          (when-let [[iso process-tz day title label] (first cases)]
+            (p/let [result (with-clock iso process-tz #(write-all-defaults! "Pacific/Auckland"))]
+              (check-today! (str label " (" iso ", process TZ " process-tz ")") result day title)
+              (p/recur (rest cases)))))
+        (p/catch #(is false (str %)))
+        (p/finally done))))
+
+(deftest today-defaults-to-utc-test
+  (async done
+    (-> (p/let [result (with-clock "2026-11-05T21:00:00Z" "Pacific/Auckland"
+                         #(write-all-defaults! nil))]
+          (check-today! "no TIMEZONE configured: the UTC date, not the process zone's"
+                        result 20261105 "Nov 5th, 2026"))
+        (p/catch #(is false (str %)))
+        (p/finally done))))
+
+(deftest blank-timezone-is-utc-test
+  (async done
+    (-> (p/let [result (with-clock "2026-11-05T21:00:00Z" "Pacific/Auckland"
+                         #(write-all-defaults! "  "))]
+          (check-today! "blank TIMEZONE: the UTC date" result 20261105 "Nov 5th, 2026"))
+        (p/catch #(is false (str %)))
+        (p/finally done))))
+
+(deftest invalid-timezone-is-refused-up-front-test
+  (async done
+    (-> (with-clock
+         "2026-11-05T21:00:00Z" "UTC"
+         #(p/let [^js self (make-self "Mars/Olympus")
+                  conn (.-conn self)
+                  journals-before (count (d/datoms @conn :avet :block/journal-day))
+                  result {:task (request! self "POST" "/semantic/tasks" {:title "Morning task"})
+                          :capture (request! self "POST" "/semantic/capture"
+                                             {:blocks [{:title "Morning note"}]})
+                          :asset (upload-asset! self)}
+                  result (p/all (map (fn [[k v]] (p/let [r v] [k r])) result))
+                  result (into {} result)
+                  ;; A write to a named page needs no 'today', so the setting doesn't block it.
+                  page (request! self "POST" "/semantic/pages" {:title "Inbox"})
+                  page-id (get-in page [:body :uuid])
+                  task (request! self "POST" "/semantic/tasks" {:title "Named page task" :page-id page-id})
+                  asset (upload-asset! self page-id "b")]
+            (doseq [k [:task :capture :asset]]
+              (testing (name k)
+                (is (= 500 (get-in result [k :status])))
+                (is (= "invalid TIMEZONE setting: Mars/Olympus" (get-in result [k :body :error])))))
+            (is (= journals-before (count (d/datoms @conn :avet :block/journal-day)))
+                "no journal page is created")
+            (testing "a task on a named page"
+              (is (= 201 (:status task)))
+              (is (= page-id (get-in task [:body :page-id])))
+              (is (= "Inbox" (get-in task [:body :page-title]))))
+            (testing "an asset on a named page"
+              (is (= 201 (:status asset)))
+              (is (= page-id (get-in asset [:body :page-id])))
+              (is (= "Inbox" (get-in asset [:body :page-title]))))))
+        (p/catch #(is false (str %)))
+        (p/finally done))))
