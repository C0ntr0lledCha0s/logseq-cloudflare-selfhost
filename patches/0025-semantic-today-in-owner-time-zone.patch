+(defn- owner-time-zone
+  "The IANA zone 'today' is worked out in: the Worker's TIMEZONE setting, or UTC when it is unset.
+  The Worker's own clock is always UTC, so its local date is not the owner's. nil when the setting
+  names a zone Intl doesn't know."
+  [^js self]
+  (let [zone (some-> (.-env self) (aget "TIMEZONE") str string/trim)
+        zone (if (seq zone) zone "UTC")]
+    (try (js/Intl.DateTimeFormat. "en-US" #js {:timeZone zone})
+         zone
+         (catch :default _ nil))))
+
+(defn- invalid-time-zone-response [^js self]
+  (http/error-response (str "invalid TIMEZONE setting: " (aget (.-env self) "TIMEZONE")) 500))
+
+(defn- today-journal-day
+  "Today's journal day (yyyymmdd) in `time-zone`, from the current instant."
+  [time-zone]
+  (let [parts (.formatToParts (js/Intl.DateTimeFormat. "en-US" #js {:timeZone time-zone
+                                                                    :year "numeric"
+                                                                    :month "numeric"
+                                                                    :day "numeric"})
+                              (js/Date.))
+        part (fn [part-type]
+               (js/parseInt (.-value (.find parts #(= part-type (.-type %)))) 10))]
+    (+ (* (part "year") 10000) (* (part "month") 100) (part "day"))))
+
+(defn- ensure-today-page! [conn time-zone]
