-          view (or (.get (.-searchParams url) "view") "summary")]
+          view (or (.get (.-searchParams url) "view") "summary")
+          raw-property (.get (.-searchParams url) "property")
+          property (when (and (some? raw-property) (= "signals" view)) (signals-property db raw-property))]
       (cond
         (nil? ids) (http/bad-request "ids must be a comma-separated list of UUIDs")
         (> (count ids) max-batch-size) (http/bad-request (str "at most " max-batch-size " ids"))
         (not (apply distinct? (map string/lower-case ids))) (http/bad-request "duplicate id")
-        (not (contains? #{"summary" "outline"} view)) (http/bad-request "view must be summary or outline")
