-(defn- bulk-read-response [db ids view]
+(def ^:private reference-count-cap
+  "Where the signals view's reference-count stops: semantic search's importance saturates far
+  below it, and a tag page with thousands of referrers would otherwise walk them all."
+  1000)
+
+(defn- capped-referrer-count
+  "(count (referrer-ids db entity attributes)), stopping at reference-count-cap: a lazy walk over
+  each reference attribute's avet datoms that counts distinct visible referrers outside the
+  entity and its own blocks, and reads no further once the cap is reached."
+  [db entity attributes]
+  (let [id (:db/id entity)]
+    (->> attributes
+         (mapcat #(d/datoms db :avet % id))
+         (map :e)
+         (remove #(or (= id %)
+                      (let [referrer (d/entity db %)]
+                        (or (= id (:db/id (:block/page referrer)))
+                            (entity-util/hidden? referrer)))))
+         distinct
+         (take reference-count-cap)
+         count)))
+
+(defn- property-value-titles
+  "An entity's values of `ident` as text, in the order getBlock lists them: a page, node or
+  choice's title, a text or number value's content, a checkbox or datetime as written. nil when
+  the entity has no value."
+  [entity ident]
+  (let [value (get entity ident)]
+    (when (and (some? value) (not (and (coll? value) (empty? value))))
+      (mapv #(str (if (de/entity? %) (db-property/property-value-content %) %))
+            (if (set? value) (sort-by property-value-sort-key value) [value])))))
+
+(defn- signals-response
+  "The signals view of one entity: what semantic search ranks by, and no title or text."
+  [db entity attributes property]
+  (let [status (:db/ident (:logseq.property/status entity))]
+    {:uuid (uuid-string (:block/uuid entity))
+     :updated-at (:block/updated-at entity)
+     :reference-count (capped-referrer-count db entity attributes)
+     :status (when status (string/replace (name status) #"^status\." ""))
+     :property-values (when property
+                        (let [ident (:db/ident property)]
+                          (or (property-value-titles entity ident)
+                              (some-> (:block/page entity) (property-value-titles ident))
+                              [])))}))
+
+(defn- signals-property
+  "getBlocks' property parameter: a visible property, resolved as setBlockProperty's property-id
+  is (ident, UUID or title), but only among properties, so a page or tag ident is not found."
+  [db raw]
+  (let [entity (resolve-property db raw)]
+    (when (property? entity) entity)))
+
+(defn- bulk-read-response [db ids view & [property]]
   (let [entities (map #(find-visible-entity db %) ids)
         found (remove nil? entities)
-        blocks (if (= "outline" view)
+        blocks (case view
+                 "signals"
+                 (let [attributes (reference-attributes db)]
+                   (mapv #(signals-response db % attributes property) found))
+                 "outline"
                  ;; One outline budget for the whole response, as for a single page.
                  (:blocks (reduce (fn [{:keys [budget] :as result} entity]
                                     (let [outline (page-outline db entity budget)]
@@ -4184,14 +4241,18 @@
