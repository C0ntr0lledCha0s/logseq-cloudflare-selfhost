diff --git a/deps/db-sync/test/logseq/db_sync/semantic_signals_view_test.cljs b/deps/db-sync/test/logseq/db_sync/semantic_signals_view_test.cljs
new file mode 100644
index 0000000..b910cbb
--- /dev/null
+++ b/deps/db-sync/test/logseq/db_sync/semantic_signals_view_test.cljs
@@ -0,0 +1,311 @@
+(ns logseq.db-sync.semantic-signals-view-test
+  "getBlocks view=signals returns, per id, only what semantic search ranks by: uuid, updated-at,
+  reference-count (referrers outside the entity's own blocks, hidden ones left out, stopping at
+  1000), the task status and, with `property`, that property's value titles on the entity or else
+  on its page. It returns no title or text, so it answers on an E2EE graph too."
+  (:require [cljs.test :refer [async deftest is testing]]
+            [clojure.string :as string]
+            [datascript.core :as d]
+            [logseq.db-sync.test-sql :as test-sql]
+            [logseq.db-sync.worker.handler.sync :as sync-handler]
+            [logseq.db.sqlite.export :as sqlite-export]
+            [logseq.outliner.property :as outliner-property]
+            [promesa.core :as p]))
+
+(defn- request!
+  "One semantic API request through the real handler; returns {:status :body}."
+  [self method path body]
+  (p/let [url (str "http://localhost" path (if (string/includes? path "?") "&" "?") "graph-id=graph-1")
+          response (sync-handler/handle-http
+                    self
+                    (js/Request. url (clj->js (cond-> {:method method
+                                                       :headers {"content-type" "application/json"}}
+                                                body (assoc :body (js/JSON.stringify (clj->js body)))))))
+          text (.text response)]
+    {:status (.-status response)
+     :body (when (seq text) (js->clj (js/JSON.parse text) :keywordize-keys true))}))
+
+(defn- ident-id [property]
+  (subs (str (:db/ident property)) 1))
+
+(defn- signals-path [ids & [query]]
+  (str "/semantic/blocks?ids=" (string/join "," ids) "&view=signals" query))
+
+(defn- signals! [self ids & [query]]
+  (request! self "GET" (signals-path ids query) nil))
+
+(defn- by-uuid [response]
+  (into {} (map (juxt :uuid identity)) (get-in response [:body :blocks])))
+
+(defn- page [id title & {:as attrs}]
+  (merge {:block/uuid id :block/name (string/lower-case title) :block/title title
+          :block/tags #{:logseq.class/Page} :block/created-at 1 :block/updated-at 1}
+         attrs))
+
+(defn- block [id title page-id parent-id order & {:as attrs}]
+  (merge {:block/uuid id :block/title title :block/order order
+          :block/page [:block/uuid page-id] :block/parent [:block/uuid parent-id]
+          :block/created-at 1 :block/updated-at 1}
+         attrs))
+
+(defn- with-graph
+  "A DB graph with a `Project status` choice property (Active, Archived) and an `about` node property."
+  [done run]
+  (-> (p/let [conn (sqlite-export/create-conn)
+              status (outliner-property/upsert-property!
+                      conn nil {:logseq.property/type :default :db/cardinality :db.cardinality/one}
+                      {:property-name "Project status"})
+              _ (outliner-property/upsert-closed-value! conn (:db/ident status) {:value "Active"})
+              _ (outliner-property/upsert-closed-value! conn (:db/ident status) {:value "Archived"})
+              about (outliner-property/upsert-property!
+                     conn nil {:logseq.property/type :node :db/cardinality :db.cardinality/many}
+                     {:property-name "about"})
+              self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true}]
+        (run {:conn conn :self self :status status :about about}))
+      (p/catch #(is false (str %)))
+      (p/finally done)))
+
+(deftest reference-count-counts-referrers-outside-the-entity-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self about]}]
+        (let [[pricing own other other-ref holder archive hidden-ref recycled
+               target sibling far] (repeatedly 11 random-uuid)
+              about-ident (:db/ident about)
+              pricing-ref [:block/uuid pricing]
+              target-ref [:block/uuid target]]
+          (d/transact! conn [(page pricing "Pricing")
+                             (page other "Other")
+                             (page holder "Holder")
+                             (page archive "Archive" :logseq.property/hide? true)])
+          (d/transact! conn [;; Pricing's own child refers to Pricing: not counted.
+                             (block own "See [[Pricing]]" pricing pricing "a0" :block/refs #{pricing-ref})
+                             (block target "Target" pricing pricing "a1")
+                             ;; A referrer on another page, linking Pricing and holding it as a
+                             ;; property value too: counted once.
+                             (block other-ref "Pricing notes" other other "a0"
+                                    :block/refs #{pricing-ref target-ref} about-ident #{pricing-ref})
+                             ;; A page holding Pricing as a property value: counted.
+                             {:block/uuid holder about-ident #{pricing-ref}}
+                             ;; Hidden referrers: one under a hidden page, one in the Recycle bin.
+                             (block hidden-ref "Old pricing" archive archive "a0" :block/refs #{pricing-ref target-ref})
+                             (block recycled "Deleted pricing" other other "a1"
+                                    :block/refs #{pricing-ref target-ref} :logseq.property/deleted-at 5)
+                             ;; A block's referrers: one on its own page, one on another page.
+                             (block sibling "Sibling of ((target))" pricing pricing "a2" :block/refs #{target-ref})
+                             (block far "Far from ((target))" other other "a2" :block/refs #{target-ref})])
+          (p/let [response (signals! self [pricing target])]
+            (is (= 200 (:status response)) (str (:body response)))
+            (let [blocks (by-uuid response)]
+              (is (= 2 (get-in blocks [(str pricing) :reference-count]))
+                  "the referrer on another page (once, though it links and holds Pricing) and the property holder; not Pricing's own child, nor the hidden or recycled referrer")
+              (is (= 3 (get-in blocks [(str target) :reference-count]))
+                  "a block's referrers on its own page and elsewhere, as referrer-ids counts them; not the hidden or recycled ones"))))))))
+
+(deftest reference-count-stops-at-1000-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self]}]
+        (let [[pricing many quiet] (repeatedly 3 random-uuid)]
+          (d/transact! conn [(page pricing "Pricing") (page many "Many") (page quiet "Quiet")])
+          (d/transact! conn (map-indexed (fn [index id]
+                                           (block id (str "Ref " index) many many (str "a" index)
+                                                  :block/refs #{[:block/uuid pricing]}))
+                                         (repeatedly 1005 random-uuid)))
+          (p/let [response (signals! self [pricing quiet])]
+            (is (= 200 (:status response)) (str (:body response)))
+            (is (= {(str pricing) 1000 (str quiet) 0}
+                   (update-vals (by-uuid response) :reference-count))
+                "1005 referrers count as 1000; an entity no one refers to counts 0")))))))
+
+(deftest status-is-the-task-status-name-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self]}]
+        (let [[tasks done-task canceled todo doing plain] (repeatedly 6 random-uuid)]
+          (d/transact! conn [(page tasks "Tasks")])
+          (d/transact! conn [(block done-task "Ship it" tasks tasks "a0" :logseq.property/status :logseq.property/status.done
+                                    :block/tags #{:logseq.class/Task})
+                             (block canceled "Drop it" tasks tasks "a1" :logseq.property/status :logseq.property/status.canceled
+                                    :block/tags #{:logseq.class/Task})
+                             (block todo "Plan it" tasks tasks "a2" :logseq.property/status :logseq.property/status.todo
+                                    :block/tags #{:logseq.class/Task})
+                             (block doing "Build it" tasks tasks "a3" :logseq.property/status :logseq.property/status.doing
+                                    :block/tags #{:logseq.class/Task})
+                             (block plain "Just a note" tasks tasks "a4")])
+          (p/let [response (signals! self [done-task canceled todo doing plain tasks])]
+            (is (= 200 (:status response)) (str (:body response)))
+            (is (= {(str done-task) "done" (str canceled) "canceled" (str todo) "todo" (str doing) "doing"
+                    (str plain) nil (str tasks) nil}
+                   (update-vals (by-uuid response) :status)))))))))
+
+(deftest property-values-from-the-block-else-its-page-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self status]}]
+        (let [[office plain-page inherits sibling bare page-only] (repeatedly 6 random-uuid)
+              path #(str "/semantic/blocks/" % "/properties/" (js/encodeURIComponent (ident-id status)))]
+          (d/transact! conn [(page office "Office move plan") (page plain-page "Plain")])
+          (d/transact! conn [(block inherits "Pack the desks" office office "a0")
+                             (block sibling "Book the van" office office "a1")
+                             (block bare "Nothing set" plain-page plain-page "a0")
+                             (block page-only "Also nothing" plain-page plain-page "a1")])
+          (p/let [set-page (request! self "PUT" (path office) {:value "Archived"})
+                  set-sibling (request! self "PUT" (path sibling) {:value "Active"})
+                  with-property (signals! self [inherits sibling office bare plain-page]
+                                          (str "&property=" (js/encodeURIComponent (ident-id status))))
+                  by-title (signals! self [inherits] (str "&property=" (js/encodeURIComponent "Project status")))
+                  without (signals! self [inherits sibling office bare])]
+            (is (= [200 200] (mapv :status [set-page set-sibling])) (str (:body set-page) (:body set-sibling)))
+            (is (= 200 (:status with-property)) (str (:body with-property)))
+            (is (= {(str inherits) ["Archived"]
+                    (str sibling) ["Active"]
+                    (str office) ["Archived"]
+                    (str bare) []
+                    (str plain-page) []}
+                   (update-vals (by-uuid with-property) :property-values))
+                "the block's own value, else its page's; the sibling keeps its own; [] when neither has one")
+            (is (= ["Archived"] (get-in (by-uuid by-title) [(str inherits) :property-values]))
+                "property resolves as setBlockProperty's property-id does, by title too")
+            (is (= 200 (:status without)))
+            (is (every? #(contains? % :property-values) (get-in without [:body :blocks])))
+            (is (every? nil? (map :property-values (get-in without [:body :blocks])))
+                "no property: property-values is null")))))))
+
+(defn- set-or-vec
+  "Many values come back in the order getBlock lists them; compare them as a set."
+  [expected actual]
+  (if (< 1 (count expected)) (when actual (vec (sort-by (into {} (map-indexed (fn [i v] [v i])) expected) actual))) actual))
+
+(deftest property-values-for-each-property-type-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self about]}]
+        (p/let [[host target journal] (repeatedly 3 random-uuid)
+                blocks (vec (repeatedly 9 random-uuid))
+                property! (fn [type cardinality title]
+                            (outliner-property/upsert-property!
+                             conn nil {:logseq.property/type type :db/cardinality cardinality}
+                             {:property-name title}))
+                text (property! :default :db.cardinality/one "note")
+                number (property! :number :db.cardinality/one "points")
+                url (property! :url :db.cardinality/one "link")
+                topic (property! :node :db.cardinality/one "topic")
+                due (property! :date :db.cardinality/one "due")
+                when-property (property! :datetime :db.cardinality/one "when")
+                checkbox (property! :checkbox :db.cardinality/one "ticked")
+                _ (d/transact! conn [(page host "Host") (page target "Pricing")
+                                     (page journal "Nov 5th, 2026" :block/journal-day 20261105
+                                           :block/tags #{:logseq.class/Journal})])
+                _ (d/transact! conn (map-indexed (fn [index id] (block id (str "Block " index) host host (str "a" index)))
+                                                 blocks))
+                cases [[text "Call the landlord" ["Call the landlord"]]
+                       [number 5 ["5"]]
+                       [url "https://example.com/plan" ["https://example.com/plan"]]
+                       [topic (str target) ["Pricing"]]
+                       [due (str journal) ["Nov 5th, 2026"]]
+                       [when-property 1700000000000 ["1700000000000"]]
+                       [checkbox true ["true"]]
+                       [about [(str target) (str journal)] ["Pricing" "Nov 5th, 2026"]]
+                       [:logseq.property/priority "high" ["High"]]]
+                writes (p/all (map (fn [id [property value _]]
+                                     (request! self "PUT" (str "/semantic/blocks/" id "/properties/"
+                                                               (js/encodeURIComponent (if (keyword? property)
+                                                                                        (subs (str property) 1)
+                                                                                        (ident-id property))))
+                                               {:value value}))
+                                   blocks cases))
+                reads (p/all (map (fn [id [property _ _]]
+                                    (signals! self [id] (str "&property="
+                                                             (js/encodeURIComponent (if (keyword? property)
+                                                                                      (subs (str property) 1)
+                                                                                      (ident-id property))))))
+                                  blocks cases))]
+          (is (every? #(= 200 (:status %)) writes) (str (mapv :body writes)))
+          (doseq [[[property _ expected] response] (map vector cases reads)]
+            (testing (str (if (keyword? property) property (:logseq.property/type property)))
+              (is (= 200 (:status response)) (str (:body response)))
+              (is (= expected (set-or-vec expected (get-in response [:body :blocks 0 :property-values])))))))))))
