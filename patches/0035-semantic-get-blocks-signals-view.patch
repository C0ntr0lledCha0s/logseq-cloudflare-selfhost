+(deftest signals-shape-missing-and-limits-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self]}]
+        (let [[pricing a b unstamped hidden missing] (repeatedly 6 random-uuid)]
+          (d/transact! conn [(page pricing "Pricing")])
+          (d/transact! conn [(block a "Alpha" pricing pricing "a0" :block/updated-at 1762560000000)
+                             (block b "Beta" pricing pricing "a1" :block/updated-at 1700000000000)
+                             (dissoc (block unstamped "No stamp" pricing pricing "a2") :block/updated-at)
+                             (block hidden "Hidden" pricing pricing "a3" :logseq.property/hide? true)])
+          (p/let [forward (signals! self [a missing b unstamped hidden])
+                  reversed (signals! self [hidden unstamped b missing a])
+                  e2ee (signals! self [a b] "&graph-e2ee=true")
+                  errors (p/all (map #(request! self "GET" % nil)
+                                     [(signals-path (repeatedly 101 random-uuid))
+                                      (signals-path [a (string/upper-case (str a))])
+                                      (signals-path ["not-a-uuid"])]))]
+            (is (= 200 (:status forward)) (str (:body forward)))
+            (is (= [(str a) (str b) (str unstamped)] (mapv :uuid (get-in forward [:body :blocks])))
+                "found entities in request order")
+            (is (= [(str unstamped) (str b) (str a)] (mapv :uuid (get-in reversed [:body :blocks])))
+                "reversed request, reversed response")
+            (is (= [(str missing) (str hidden)] (get-in forward [:body :missing]))
+                "unknown and hidden uuids are missing")
+            (is (= [(str hidden) (str missing)] (get-in reversed [:body :missing])))
+            (is (= (by-uuid forward) (by-uuid reversed)) "each entity's signals don't depend on order")
+            (is (= {(str a) (:block/updated-at (d/entity @conn [:block/uuid a]))
+                    (str b) 1700000000000
+                    (str unstamped) nil}
+                   (update-vals (by-uuid forward) :updated-at)))
+            (is (every? #(= #{:uuid :updated-at :reference-count :status :property-values} (set (keys %)))
+                        (get-in forward [:body :blocks]))
+                "no title, properties, tags or other text")
+            (is (= #{:blocks :missing} (set (keys (:body forward)))))
+            (is (= 200 (:status e2ee)) "the view carries no text, so an E2EE graph answers it")
+            (is (= (select-keys (by-uuid forward) [(str a) (str b)]) (by-uuid e2ee)))
+            (is (= [400 400 400] (mapv :status errors)))
+            (is (= ["at most 100 ids" "duplicate id" "ids must be a comma-separated list of UUIDs"]
+                   (mapv #(get-in % [:body :error]) errors)))))))))
