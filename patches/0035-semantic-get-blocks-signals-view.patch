+(deftest property-refusals-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self status]}]
+        (let [[pricing a] (repeatedly 2 random-uuid)]
+          (d/transact! conn [(page pricing "Pricing")
+                             {:db/ident :user.class/Organization :block/uuid (random-uuid)
+                              :block/name "organization" :block/title "Organization"
+                              :block/tags :logseq.class/Tag}])
+          (d/transact! conn [(block a "A" pricing pricing "a0")])
+          (p/let [refusals (p/all (map #(request! self "GET" % nil)
+                                       [(signals-path [a] "&property=user.property/nope")
+                                        (signals-path [a] (str "&property=" pricing))
+                                        (signals-path [a] "&property=Pricing")
+                                        (signals-path [a] "&property=user.class/Organization")
+                                        (signals-path [a] "&property=logseq.class/Task")
+                                        (str "/semantic/blocks?ids=" a "&view=summary&property=" (js/encodeURIComponent (ident-id status)))
+                                        (str "/semantic/blocks?ids=" a "&view=outline&property=" (js/encodeURIComponent (ident-id status)))
+                                        (str "/semantic/blocks?ids=" a "&property=" (js/encodeURIComponent (ident-id status)))
+                                        (str "/semantic/blocks?ids=" a "&view=tree")]))
+                  ;; Calls the refusals must not catch.
+                  accepted (p/all (map #(request! self "GET" % nil)
+                                       [(str "/semantic/blocks?ids=" a)
+                                        (str "/semantic/blocks?ids=" a "&view=summary")
+                                        (str "/semantic/blocks?ids=" a "&view=outline")
+                                        (signals-path [a])
+                                        (signals-path [a] "&property=logseq.property/status")
+                                        (signals-path [a] "&graph-e2ee=true")]))]
+            (is (= (repeat 9 400) (mapv :status refusals)) (str (mapv :body refusals)))
+            (is (= ["property not found: user.property/nope"
+                    (str "property not found: " pricing)
+                    "property not found: Pricing"
+                    "property not found: user.class/Organization"
+                    "property not found: logseq.class/Task"
+                    "property needs view=signals"
+                    "property needs view=signals"
+                    "property needs view=signals"
+                    "view must be summary, outline or signals"]
+                   (mapv #(get-in % [:body :error]) refusals)))
+            (is (= (repeat 6 200) (mapv :status accepted)) (str (mapv :body accepted)))
+            (is (= [[]] (mapv :property-values (get-in (nth accepted 4) [:body :blocks])))
+                "a built-in property neither the block nor its page has: []")))))))
