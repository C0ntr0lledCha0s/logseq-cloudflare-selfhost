+        (and (some? raw-property) (nil? property)) (http/bad-request (str "property not found: " raw-property))
         (and e2ee? (= "outline" view)) (http/error-response "outlines are unavailable for E2EE graphs" 409)
-        :else (http/json-response nil (bulk-read-response db ids view))))
+        :else (http/json-response nil (bulk-read-response db ids view property))))
 
