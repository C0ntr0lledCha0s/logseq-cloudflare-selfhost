+(defn- held-value-matches?
+  "Whether the value with db id `id` that a block holds for `property` is the one `value` names: by
+  UUID, ident or exact content (a page's title, a text, URL or number value's text, a journal's
+  title). A number property's value may be given as a number or as numeric text. A node value
+  stored in a value block also answers to its target."
+  [db property value id]
+  (let [entity (d/entity db id)
+        target (when (= :node (:logseq.property/type property))
+                 (when-let [target-uuid (and (= (:db/id property) (:db/id (:logseq.property/created-from-property entity)))
+                                             (some-> (:block/title entity) parse-uuid))]
+                   (d/entity db [:block/uuid target-uuid])))
+        text (or (number-text property value) (str value))]
+    (some (fn [e]
+            (or (and (string? value) (common-util/uuid-string? value) (= value (str (:block/uuid e))))
+                (and (string? value) (qualified-keyword? (keyword value)) (= (keyword value) (:db/ident e)))
+                (= text (choice-content e))))
+          (remove nil? [entity target]))))
+
+(defn- prepare-value-delete
+  "For a delete of one value of `property-ident` from `block`: {:value id}, the db id of the one value
+  the block holds that `value` names (held-value-matches?), or {:error reason}. Only the block's own
+  values are searched, so a page or text elsewhere with the same title is never picked. A Tags
+  value the server keeps (kept-tag?) is refused, as the outliner refuses to remove a private tag."
+  [db block property-ident value]
+  (let [property (d/entity db property-ident)
+        label (or (:block/title property) (entity-ident property))
+        matches (when (and (db-property/many? property) (= :db.type/ref (:db/valueType property))
+                           (or (string? value) (number? value)))
+                  (vec (filter #(held-value-matches? db property value %)
+                               (held-property-values db (:db/id block) property-ident))))
+        tag (some->> (first matches) (d/entity db))]
+    (cond
+      (not (and (db-property/many? property) (= :db.type/ref (:db/valueType property))))
+      {:error (str label " doesn't hold several values; omit value to delete the whole property")}
+      (not (or (string? value) (number? value)))
+      {:error "value must be one value: a UUID, ident, title or number"}
+      (empty? matches)
+      {:error (str "the block holds no " label " value " (pr-str (str value)))}
+      (next matches)
+      {:error (str (pr-str (str value)) " names " (count matches) " of the block's " label
+                   " values; name one by UUID")}
+      (and (= :block/tags property-ident) (display-class? db (:db/id tag)))
+      {:error (str (:block/title tag) ": remove it by deleting display-type, not as a tag")}
+      (and (= :block/tags property-ident) (kept-tag? db (:db/id tag)))
+      {:error (str (:block/title tag) " is a built-in tag Logseq sets itself and can't be removed")}
+      :else {:value (first matches)})))
+
+(defn- read-back-value-delete!
