+(defn- kept-tag?
+  "Whether the tag with db id `id` in `db` is one the server never removes from a block's tags: a
+  private tag (ldb/private-tags: Page, Tag, Journal, Property, Asset and the like), which the
+  outliner refuses to remove, or a display class, which only display-type writes (patch 0037)."
+  [db id]
+  (or (contains? ldb/private-tags (:db/ident (d/entity db id))) (display-class? db id)))
+
+(defn- held-property-values
+  "What block `block-id` holds for `property-ident`, read from datoms (a graph uploaded from the app
+  may store a many attribute as cardinality one): db ids for a ref property."
+  [db block-id property-ident]
+  (map :v (d/datoms db :eavt block-id property-ident)))
