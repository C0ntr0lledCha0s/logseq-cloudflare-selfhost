+(ns logseq.db-sync.semantic-delete-property-value-test
+  "Item 38, second pass: deleting a property, or one of its values.
+
+  A whole-property delete of Tags (deleteBlockProperty, batchDeleteBlockProperty) went straight to
+  the outliner's remove-block-property!, which throws a notification for any private tag the block
+  holds. Every page holds Page and every journal holds Journal, so the delete answered 500 with no
+  entry index. A Tags delete keeps the tags the server never removes (ldb/private-tags and the
+  display classes, the kept? rule of set-prepared-tags!): it removes only the user tags and answers
+  200, or refuses 400 naming the entry, and never 500.
+
+  No call removed one value of a many-valued property. Both delete routes take an optional value,
+  resolved as a set value is, and remove only that value. They refuse 400 naming the entry when the
+  property is not cardinality many, the block does not hold the value, the value does not resolve,
+  or (for Tags) the value is a private tag or a display class.
+
+  Pages, tags and properties are made through the API; the journal through outliner-page/create!,
+  as the app makes one; the whiteboard and asset are transacted as the app stores them."
+  (:require [cljs.test :refer [async deftest is testing]]
+            [clojure.string :as string]
+            [datascript.core :as d]
+            [logseq.db-sync.test-sql :as test-sql]
+            [logseq.db-sync.worker.handler.sync :as sync-handler]
+            [logseq.db.sqlite.export :as sqlite-export]
+            [logseq.outliner.page :as outliner-page]
+            [promesa.core :as p]))
+
+(defn- request!
+  "One semantic API request through the real handler; returns {:status :body}."
+  [self method path body]
+  (p/let [url (str "http://localhost" path (if (string/includes? path "?") "&" "?") "graph-id=graph-1")
+          response (sync-handler/handle-http
+                    self
+                    (js/Request. url (clj->js (cond-> {:method method
+                                                       :headers {"content-type" "application/json"}}
+                                                body (assoc :body (js/JSON.stringify (clj->js body)))))))
+          text (.text response)]
+    {:status (.-status response)
+     :body (when (seq text)
+             (try (js->clj (js/JSON.parse text) :keywordize-keys true)
+                  (catch :default _ text)))}))
+
+(defn- snapshot
+  "What a refused call must leave unchanged: the graph's last tx and its datom count."
+  [conn]
+  {:max-tx (:max-tx @conn) :datoms (count (d/datoms @conn :eavt))})
+
+(defn- entity [conn id] (d/entity @conn [:block/uuid (uuid (str id))]))
+
+(defn- tag-titles [conn id]
+  (set (map :block/title (:block/tags (entity conn id)))))
+
+(defn- held-values
+  "The values block `id` holds for `ident`, as comparable data: a number value's number, a date's
+  journal uuid, otherwise the value's title."
+  [conn id ident]
+  (let [v (get (entity conn id) ident)]
+    (set (map (fn [e] (cond
+                        (some? (:logseq.property/value e)) (:logseq.property/value e)
+                        (:block/journal-day e) (str (:block/uuid e))
+                        :else (:block/title e)))
+              (if (or (set? v) (sequential? v)) v (when v [v]))))))
+
+(def ^:private tags-property (js/encodeURIComponent "block/tags"))
+
+(defn- path-ident
+  "A property ident as a path segment: its full name, encoded."
+  [ident]
+  (js/encodeURIComponent (subs (str ident) 1)))
+
+(defn- in-turn
+  "Calls `f` on each of `xs` in turn, each call after the last one settles; resolves to the results."
+  [xs f]
+  (reduce (fn [acc x] (p/let [acc acc r (f x)] (conj acc r))) (p/resolved []) xs))
+
+(defn- delete-property!
+  "deleteBlockProperty on block `id`: the whole property, or with `value`, that one value."
+  ([self id property]
+   (request! self "DELETE" (str "/semantic/blocks/" id "/properties/" property) nil))
+  ([self id property value]
+   (request! self "DELETE" (str "/semantic/blocks/" id "/properties/" property) {:value value})))
+
+(defn- batch-delete! [self entries]
+  (request! self "POST" "/semantic/block-properties/batch-delete" {:entries entries}))
+
+(defn- batch-set! [self entries]
+  (request! self "POST" "/semantic/block-properties/batch-set" {:entries entries}))
+
+(defn- raw-page [id title & {:as more}]
+  (merge {:block/uuid id :block/name (string/lower-case title) :block/title title
+          :block/tags #{:logseq.class/Page} :block/created-at 1 :block/updated-at 1}
+         more))
+
+(def ^:private many-types
+  "Every property type that can be cardinality many, but asset, with the property's title."
+  [["Related" "node"] ["Owners" "default"] ["Sites" "url"] ["Scores" "number"] ["Days" "date"]])
+
+(defn- seed-graph
+  "Tags Project and CourseInstance; a page Course A, a journal, a whiteboard and an asset, each
+  tagged Project and CourseInstance; a plain block and a code block on Course A, tagged the same;
+  pages Alpha and Beta, and a decoy page Gamma; a cardinality-many property of each type in
+  many-types holding two values on the plain block (and Related on Course A too); a
+  cardinality-one node property Lead holding Alpha; and a property page rating."
+  []
+  (p/let [conn (sqlite-export/create-conn)
+          self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true}
+          project (request! self "POST" "/semantic/tags" {:title "Project"})
+          course (request! self "POST" "/semantic/tags" {:title "CourseInstance"})
+          page-r (request! self "POST" "/semantic/pages" {:title "Course A"})
+          page (get-in page-r [:body :uuid])
+          [_ journal] (outliner-page/create! conn "Nov 6th, 2026" {:journal? true})
+          [_ journal-2] (outliner-page/create! conn "Nov 7th, 2026" {:journal? true})
+          [board asset] (repeatedly 2 random-uuid)
+          _ (d/transact! conn [(raw-page board "Board" :block/tags #{:logseq.class/Whiteboard})])
+          _ (d/transact! conn [{:block/uuid asset :block/title "photo" :block/order "a9"
+                                :block/page [:block/uuid (uuid page)] :block/parent [:block/uuid (uuid page)]
+                                :block/tags #{:logseq.class/Asset} :logseq.property.asset/type "png"
+                                :logseq.property.asset/checksum "abc" :logseq.property.asset/size 1
+                                :block/created-at 1 :block/updated-at 1}])
+          [block code-block] [(str (random-uuid)) (str (random-uuid))]
+          tree (request! self "POST" "/semantic/block-trees"
+                         {:target-id page :blocks [{:uuid block :title "Plain block"}
+                                                   {:uuid code-block :title "(+ 1 2)"}]})
+          code (request! self "PUT" (str "/semantic/blocks/" code-block "/properties/"
+                                         (js/encodeURIComponent "logseq.property.node/display-type"))
+                         {:value "code"})
+          tagged (p/all (for [id [page (str journal) (str board) (str asset) block code-block]]
+                          (batch-set! self [{:block-id id :property-id "Tags" :value ["Project"]}
+                                            {:block-id id :property-id "Tags" :value ["CourseInstance"]}])))
+          pages (p/all (for [t ["Alpha" "Beta" "Gamma"]] (request! self "POST" "/semantic/pages" {:title t})))
+          properties (p/all (for [[t type] many-types]
+                              (request! self "POST" "/semantic/properties"
+                                        {:title t :type type :cardinality "db.cardinality/many"})))
+          lead (request! self "POST" "/semantic/properties" {:title "Lead" :type "node"})
+          rating (request! self "POST" "/semantic/properties" {:title "rating" :type "default"})
+          values {"Related" ["Alpha" "Beta"] "Owners" ["Ann" "Bob"] "Sites" ["https://a.example.com" "https://b.example.com"]
+                  "Scores" [3 5] "Days" [(str journal) (str journal-2)]}
+          set-values (p/all (for [[t] many-types]
+                              (batch-set! self [{:block-id block :property-id t :value (get values t)}])))
+          set-page (batch-set! self [{:block-id page :property-id "Related" :value ["Alpha" "Beta"]}
+                                     {:block-id block :property-id "Lead" :value "Alpha"}])
+          setup (concat [project course page-r tree code lead rating set-page] tagged pages properties set-values)]
+    (is (every? #(<= 200 (:status %) 201) setup) (pr-str (remove #(<= 200 (:status %) 201) setup)))
+    {:conn conn :self self :page page :journal (str journal) :journal-2 (str journal-2)
+     :board (str board) :asset (str asset) :block block :code-block code-block
+     :project (get-in project [:body :uuid])
+     :alpha (get-in (first pages) [:body :uuid])
+     :rating (get-in rating [:body :uuid])
+     :idents (into {} (map (fn [[t] r] [t (keyword (get-in r [:body :ident]))]) many-types properties))
+     :lead (keyword (get-in lead [:body :ident]))}))
+
+(defn- with-graph [done run]
+  (-> (p/let [graph (seed-graph)] (run graph))
+      (p/catch #(is false (str % (some-> % .-stack))))
+      (p/finally done)))
+
+(defn- removed-user-tags-or-refused
+  "A whole-property Tags delete on `id` answered either 200, leaving only the `kept` tags, or a
+  400 naming entry `index`, leaving the graph as it was. Never 500."
+  [conn response id kept before index label]
+  (testing label
+    (is (not= 500 (:status response)) (str label ": " (pr-str response)))
+    (case (:status response)
+      200 (is (= kept (tag-titles conn id)) (str label ": only the user tags go"))
+      400 (do (is (string/starts-with? (str (get-in response [:body :error])) (str "entry " index ":"))
+                  (pr-str response))
+              (is (= before (snapshot conn)) (str label ": nothing is written")))
+      (is false (str label ": unexpected " (pr-str response))))))
+
+;; ---------------------------------------------------------------------------------------------
+;; A whole-property Tags delete
+
+(deftest delete-tags-keeps-private-tags-test
+  ;; Every kind of entity that holds a private tag the outliner refuses to remove: a page (Page), a
+  ;; journal (Journal), a whiteboard (Whiteboard), an asset (Asset), a tag (Tag) and a property
+  ;; page (Property), each through the single delete with the property as Tags and as block/tags.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self page journal board asset project rating]}]
+        (p/let [cases [[page #{"Page"} "Tags" "a page"]
+                       [journal #{"Journal"} tags-property "a journal"]
+                       [board #{"Whiteboard"} "Tags" "a whiteboard"]
+                       [asset #{"Asset"} tags-property "an asset"]
+                       [project #{"Tag"} "Tags" "a tag"]
+                       [rating #{"Property"} tags-property "a property page"]]
+                results (in-turn cases
+                                 (fn [[id kept property label]]
+                                   (p/let [before (snapshot conn)
+                                           response (delete-property! self id property)]
+                                     [response id kept before label])))]
+          (doseq [[response id kept before label] results]
+            (removed-user-tags-or-refused conn response id kept before 0 label)))))))
+
+(deftest delete-tags-keeps-display-class-test
+  ;; A code block holds Code-block, a display class the server keeps as set-prepared-tags! does: a
+  ;; Tags delete leaves it with its display type, and removes only Project and CourseInstance.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self code-block]}]
+        (p/let [before (snapshot conn)
+                response (delete-property! self code-block "Tags")]
+          (removed-user-tags-or-refused conn response code-block #{"Code"} before 0 "a code block")
+          (is (= :code (:logseq.property.node/display-type (entity conn code-block)))
+              "the block is still a code block"))))))
+
+(deftest batch-delete-tags-names-the-entry-test
+  ;; A batch whose second entry deletes a journal's Tags: 200 keeping Journal (and the first entry
+  ;; applied), or 400 naming entry 1 with nothing written. Never a 500 without an entry.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self block journal idents]}]
+        (p/let [before (snapshot conn)
+                response (batch-delete! self [{:block-id block :property-id "Related"}
+                                              {:block-id journal :property-id "Tags"}])]
+          (removed-user-tags-or-refused conn response journal #{"Journal"} before 1 "batch, a journal at entry 1")
+          (when (= 200 (:status response))
+            (is (= #{} (held-values conn block (idents "Related"))) "entry 0 applied")))))))
+
+(deftest delete-tags-on-a-plain-block-removes-every-tag-test
+  ;; Guard: a plain block holds no private tag, so a Tags delete removes every tag (as on HEAD).
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self block]}]
+        (p/let [response (delete-property! self block tags-property)]
+          (is (= 200 (:status response)) (pr-str response))
+          (is (= #{} (tag-titles conn block))))))))
+
+(deftest tags-reset-to-one-user-tag-keeps-page-test
+  ;; Guard (acceptance 2, already true since patch 0027): a page that holds a user tag, set up
+  ;; through the API, reset to a single user tag keeps Page.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self page]}]
+        (p/let [response (request! self "POST" "/semantic/block-properties/batch-set"
+                                   {:isResetExistingValues true
+                                    :entries [{:block-id page :property-id "Tags" :value ["CourseInstance"]}]})]
+          (is (= 200 (:status response)) (pr-str response))
+          (is (= #{"Page" "CourseInstance"} (tag-titles conn page))))))))
+
+;; ---------------------------------------------------------------------------------------------
+;; Deleting one value
+
+(deftest delete-one-tag-leaves-the-others-test
+  ;; Removing Project from a page tagged Project and CourseInstance leaves it tagged CourseInstance
+  ;; (and Page), through the single delete by title and the batch by UUID; and likewise on a journal.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self page journal project]}]
+        (p/let [single (delete-property! self page "Tags" "Project")
+                batch (batch-delete! self [{:block-id journal :property-id "block/tags" :value project}])
+                read (request! self "GET" (str "/semantic/blocks/" page) nil)]
+          (is (= 200 (:status single)) (pr-str single))
+          (is (= #{"Page" "CourseInstance"} (tag-titles conn page)) "the page keeps CourseInstance and Page")
+          (is (= 200 (:status batch)) (pr-str batch))
+          (is (= #{"Journal" "CourseInstance"} (tag-titles conn journal)) "the journal keeps CourseInstance and Journal")
+          (is (not (string/includes? (pr-str (:body read)) "\"Project\"")) (str "getBlock no longer shows Project: " (pr-str (:body read))))
+          (is (string/includes? (pr-str (:body read)) "CourseInstance") (str "getBlock shows CourseInstance: " (pr-str (:body read)))))))))
+
+(deftest delete-one-value-of-each-many-type-test
+  ;; For every cardinality-many type, removing one of the block's two values leaves the other.
+  ;; A node value is named by title in the single delete and by UUID in the batch.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self block page journal journal-2 alpha idents]}]
+        (p/let [cases [["Related" "Alpha" #{"Beta"}]
+                       ["Owners" "Ann" #{"Bob"}]
+                       ["Sites" "https://a.example.com" #{"https://b.example.com"}]
+                       ["Scores" 3 #{5}]
+                       ["Days" journal #{journal-2}]]
+                singles (in-turn cases (fn [[t value]] (delete-property! self block (path-ident (idents t)) value)))
+                by-uuid (batch-delete! self [{:block-id page :property-id "Related" :value alpha}])]
+          (doseq [[[t value left] response] (map vector cases singles)]
+            (testing (str t " (" value ")")
+              (is (= 200 (:status response)) (pr-str response))
+              (is (= left (held-values conn block (idents t))) "the other value stays")))
+          (is (= 200 (:status by-uuid)) (pr-str by-uuid))
+          (is (= #{"Beta"} (held-values conn page (idents "Related"))) "by UUID in a batch, Beta stays"))))))
+
+(deftest delete-value-refusals-name-the-entry-test
+  ;; Each refusal answers 400 naming the entry, and writes nothing: a cardinality-one property, a
+  ;; value the block doesn't hold (a real page, Gamma), a value that resolves to nothing, and for Tags
+  ;; a private tag (Page) or a display class (Code-block) as the value.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self block page code-block lead idents]}]
+        (p/let [cases [[block (path-ident lead) "Alpha" "a cardinality-one property" "doesn't hold several values"]
+                       [block "Related" "Gamma" "a value the block does not hold" "holds no Related value \"Gamma\""]
+                       [block "Related" "Nowhere" "a value that does not resolve" "holds no Related value \"Nowhere\""]
+                       [block "Scores" 4 "a number the block does not hold" "holds no Scores value \"4\""]
+                       [page "Tags" "Page" "a private tag" "Page is a built-in tag Logseq sets itself"]
+                       [code-block tags-property "Code" "a display class" "Code: remove it by deleting display-type"]]
+                results (in-turn cases
+                                 (fn [[id property value label reason]]
+                                   (p/let [before (snapshot conn)
+                                           r (delete-property! self id property value)]
+                                     [r before (snapshot conn) label reason])))]
+          (doseq [[response before after label reason] results]
+            (testing label
+              (is (= 400 (:status response)) (pr-str response))
+              (is (string/starts-with? (str (get-in response [:body :error])) "entry 0:") (pr-str response))
+              (is (string/includes? (str (get-in response [:body :error])) reason) (pr-str response))
+              (is (= before after) "nothing is written")))
+          (is (= #{"Alpha" "Beta"} (held-values conn block (idents "Related"))))
+          (is (= #{"Alpha"} (held-values conn block lead))))))))
+
+(deftest batch-delete-value-refusal-names-its-index-test
+  ;; A batch whose second entry names a value the block doesn't hold is refused whole, naming entry 1,
+  ;; and the first entry's value is not removed.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self block page idents]}]
+        (p/let [before (snapshot conn)
+                response (batch-delete! self [{:block-id block :property-id "Related" :value "Alpha"}
+                                              {:block-id page :property-id "Tags" :value "Gamma"}])]
+          (is (= 400 (:status response)) (pr-str response))
+          (is (string/starts-with? (str (get-in response [:body :error])) "entry 1:") (pr-str response))
+          (is (= before (snapshot conn)) "nothing is written")
+          (is (= #{"Alpha" "Beta"} (held-values conn block (idents "Related")))))))))
+
+;; ---------------------------------------------------------------------------------------------
+;; Guards on the new rules (each found by removing the rule and seeing a test fail)
+
+(deftest delete-tags-on-a-page-without-user-tags-is-a-no-op-test
+  ;; A page holding only Page: a Tags delete answers 200 and the page keeps Page.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self]}]
+        (p/let [created (request! self "POST" "/semantic/pages" {:title "Bare"})
+                id (get-in created [:body :uuid])
+                response (delete-property! self id "Tags")]
+          (is (= 200 (:status response)) (pr-str response))
+          (is (= #{"Page"} (tag-titles conn id))))))))
+
+(deftest delete-value-reads-back-through-page-reads-test
+  ;; Removing Project from a page shows in getPage, getPageOutline and listPageBlocks' page, as it
+  ;; does in getBlock; removing Alpha from the page's Related shows too.
+  (async done
+    (with-graph done
+      (fn [{:keys [self page]}]
+        (p/let [_ (delete-property! self page "Tags" "Project")
+                _ (delete-property! self page "Related" "Alpha")
+                reads (p/all (for [path [(str "/semantic/pages/" page) (str "/semantic/pages/" page "/outline")
+                                         (str "/semantic/blocks/" page)]]
+                               (request! self "GET" path nil)))]
+          (doseq [read reads
+                  ;; The page's own tags and properties, not its blocks' (the outline lists those too).
+                  :let [own (pr-str (select-keys (:body read) [:tags :properties]))]]
+            (is (= 200 (:status read)) (pr-str read))
+            (is (not (string/includes? own "Project")) own)
+            (is (string/includes? own "CourseInstance") own)
+            (is (not (string/includes? own "Alpha")) own)
+            (is (string/includes? own "Beta") own)))))))
+
+(deftest delete-value-by-each-form-test
+  ;; A tag named by its ident (Project), a number named as numeric text ("5.0"), and a URL held by two blocks:
+  ;; removing it from one keeps the other's.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self block page project idents]}]
+        (p/let [ident (subs (str (:db/ident (entity conn project))) 1)
+                by-ident (delete-property! self block tags-property ident)
+                by-text (delete-property! self block (path-ident (idents "Scores")) "5.0")
+                shared (batch-set! self [{:block-id page :property-id "Sites" :value ["https://a.example.com"]}])
+                url (delete-property! self block "Sites" "https://a.example.com")]
+          (is (= 200 (:status by-ident)) (pr-str by-ident))
+          (is (= #{"CourseInstance"} (tag-titles conn block)))
+          (is (= 200 (:status by-text)) (pr-str by-text))
+          (is (= #{3} (held-values conn block (idents "Scores"))))
+          (is (= 200 (:status shared)) (pr-str shared))
+          (is (= 200 (:status url)) (pr-str url))
+          (is (= #{"https://b.example.com"} (held-values conn block (idents "Sites"))))
+          (is (= #{"https://a.example.com"} (held-values conn page (idents "Sites"))) "the other holder keeps its URL"))))))
+
+(deftest delete-one-choice-and-last-value-test
+  ;; A many-valued property with choices: removing one choice keeps the other; removing the last
+  ;; value of a property removes the property.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self block idents]}]
+        (p/let [created (request! self "POST" "/semantic/properties"
+                                  {:title "Colours" :type "default" :cardinality "db.cardinality/many"
+                                   :choices [{:title "Red"} {:title "Green"}]})
+                ident (keyword (get-in created [:body :ident]))
+                set-r (batch-set! self [{:block-id block :property-id "Colours" :value ["Red" "Green"]}])
+                one (delete-property! self block "Colours" "Red")
+                _ (delete-property! self block "Related" "Alpha")
+                last-one (delete-property! self block "Related" "Beta")]
+          (is (= 200 (:status set-r)) (pr-str set-r))
+          (is (= 200 (:status one)) (pr-str one))
+          (is (= #{"Green"} (held-values conn block ident)))
+          (is (= 200 (:status last-one)) (pr-str last-one))
+          (is (= #{} (held-values conn block (idents "Related")))))))))
+
+(deftest delete-value-of-a-node-value-block-test
+  ;; A node value stored in a value block whose title is its target's UUID answers to the target's
+  ;; title and UUID.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self page alpha idents]}]
+        (let [related (d/entity @conn (idents "Related"))
+              value-block (random-uuid)
+              page-id (:db/id (entity conn page))]
+          (d/transact! conn [{:block/uuid value-block :block/title alpha :block/order "a8"
+                              :block/page page-id :block/parent page-id
+                              :logseq.property/created-from-property (:db/id related)
+                              :block/created-at 1 :block/updated-at 1}])
+          (d/transact! conn [[:db/retract page-id (idents "Related") (:db/id (entity conn alpha))]
+                             [:db/add page-id (idents "Related") [:block/uuid value-block]]])
+          (p/let [response (delete-property! self page "Related" "Alpha")]
+            (is (= 200 (:status response)) (pr-str response))
+            (is (not (contains? (set (map :db/id (get (entity conn page) (idents "Related"))))
+                                (:db/id (entity conn value-block))))
+                "the value block is no longer held")
+            (is (= #{"Beta"} (held-values conn page (idents "Related"))))))))))
+
+(deftest delete-value-malformed-and-ambiguous-test
+  ;; null, a list and an object as value are refused naming the entry; so is a title two held values
+  ;; share. Nothing is written.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self block idents]}]
+        (p/let [dup (batch-set! self [{:block-id block :property-id "Owners" :value ["Cy" "Cy"]}])
+                cases [[nil "null" "value must be one value"] [["Ann"] "a list" "value must be one value"]
+                       [{:title "Ann"} "an object" "value must be one value"]
+                       ["Cy" "two held values" "\"Cy\" names 2 of the block's Owners values; name one by UUID"]]
+                results (in-turn cases
+                                 (fn [[value label reason]]
+                                   (p/let [before (snapshot conn)
+                                           r (delete-property! self block "Owners" value)]
+                                     [r before (snapshot conn) label reason])))
+                batch (batch-delete! self [{:block-id block :property-id "Owners" :value "Ann"}
+                                           {:block-id block :property-id "Owners" :value nil}])]
+          (is (= 200 (:status dup)) (pr-str dup))
+          (doseq [[response before after label reason] results]
+            (testing label
+              (is (= 400 (:status response)) (pr-str response))
+              (is (string/starts-with? (str (get-in response [:body :error])) "entry 0:") (pr-str response))
+              (is (string/includes? (str (get-in response [:body :error])) reason) (pr-str response))
+              (is (= before after))))
+          (is (= 400 (:status batch)) (pr-str batch))
+          (is (string/starts-with? (str (get-in batch [:body :error])) "entry 1:") (pr-str batch))
+          (is (contains? (held-values conn block (idents "Owners")) "Ann")))))))
+
+(deftest outliner-refusal-names-the-entry-test
+  ;; A built-in tag (Task) that also holds a user tag: the outliner refuses to remove any tag from a
+  ;; built-in node. The single delete and a batch answer 400 naming the entry, not 500.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self block project]}]
+        (let [task (d/entity @conn :logseq.class/Task)
+              project (entity conn project)]
+          (d/transact! conn [[:db/add (:db/id task) :block/tags (:db/id project)]])
+          (p/let [before (snapshot conn)
+                  single (delete-property! self (:block/uuid task) "Tags")
+                  value (delete-property! self (:block/uuid task) "Tags" "Project")
+                  batch (batch-delete! self [{:block-id block :property-id "Related"}
+                                             {:block-id (str (:block/uuid task)) :property-id "Tags"}])]
+            (doseq [[response entry] [[single "entry 0:"] [value "entry 0:"] [batch "entry 1:"]]]
+              (is (= 400 (:status response)) (pr-str response))
+              (is (string/starts-with? (str (get-in response [:body :error])) entry) (pr-str response)))
+            (is (= before (snapshot conn)) "nothing is written")))))))
+
+(deftest delete-value-that-the-outliner-skips-is-not-a-silent-success-test
+  ;; A property set on its own entity: the outliner's delete-property-value! skips a block that is
+  ;; the property, so the value stays. The call must not answer 200 as if it had removed it.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self idents]}]
+        (let [related (d/entity @conn (idents "Related"))]
+          (p/let [set-r (batch-set! self [{:block-id (str (:block/uuid related)) :property-id "Related" :value ["Alpha" "Beta"]}])
+                  held (held-values conn (:block/uuid related) (idents "Related"))
+                  response (delete-property! self (:block/uuid related) "Related" "Alpha")]
+            (is (= 200 (:status set-r)) (pr-str set-r))
+            (is (= #{"Alpha" "Beta"} held))
+            (is (not= 200 (:status response)) (pr-str response))
+            (is (string/includes? (str (pr-str (:body response))) "entry 0: the value was not removed") (pr-str response))))))))
