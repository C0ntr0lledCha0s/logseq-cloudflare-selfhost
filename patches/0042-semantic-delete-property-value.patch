+(defn- held-value-matches?
+  "Whether the value with db id `id` that a block holds for `property` is the one `value` names: by
+  UUID, ident or content (a page's title, a text, URL or number value's text, a journal's title),
+  compared with `same?` (exact, or ignoring case). A UUID names an entity, never text that reads as
+  one. A number property's value may be given as a number or as numeric text. A node value stored in
+  a value block of this property also answers to its target."
+  [db property value id same?]
+  (let [entity (d/entity db id)
+        target (when (= :node (:logseq.property/type property))
+                 (when-let [target-uuid (and (= (:db/id property) (:db/id (:logseq.property/created-from-property entity)))
+                                             (some-> (:block/title entity) parse-uuid))]
+                   (d/entity db [:block/uuid target-uuid])))
+        uuid? (and (string? value) (common-util/uuid-string? value))
+        text (or (number-text property value) (str value))]
+    (some (fn [e]
+            (or (and uuid? (= value (str (:block/uuid e))))
+                (and (string? value) (qualified-keyword? (keyword value)) (= (keyword value) (:db/ident e)))
+                (and (not uuid?) (same? text (choice-content e)))))
+          (remove nil? [entity target]))))
+
+(defn- internal-property?
+  "A built-in property that isn't public (ldb's :logseq.property/public?): Node references, which
+  follow the block's text, and the other properties Logseq keeps for itself."
+  [property]
+  (and (ldb/built-in? property) (not (db-property/public-built-in-property? property))))
+
+(defn- prepare-value-delete
+  "For a delete of one value of `property-ident` from `block`: {:value id}, the db id of the one value
+  the block holds that `value` names (held-value-matches?, by exact content first and then ignoring
+  case, as set resolves a title), or {:error reason}. Only the block's own values are searched, so a
+  page or text elsewhere with the same title is never picked. An internal property is refused, and
+  so is a Tags value the server keeps (kept-tag?), as the outliner refuses to remove a private tag."
+  [db block property-ident value]
+  (let [property (d/entity db property-ident)
+        label (or (:block/title property) (entity-ident property))
+        many-ref? (and (db-property/many? property) (= :db.type/ref (:db/valueType property)))
+        held (when (and many-ref? (or (string? value) (number? value)))
+               (held-property-values db (:db/id block) property-ident))
+        matching (fn [same?] (not-empty (vec (filter #(held-value-matches? db property value % same?) held))))
+        matches (or (matching =) (matching #(= (string/lower-case %1) (string/lower-case %2))))
+        tag (some->> (first matches) (d/entity db))]
+    (cond
+      (not many-ref?)
+      {:error (str label " doesn't hold several values; omit value to delete the whole property")}
+      (internal-property? property)
+      {:error (str label " is internal to Logseq and its values can't be removed one by one"
+                   (when (= :block/refs property-ident) "; edit the block's text to remove a link"))}
+      (not (or (string? value) (number? value)))
+      {:error "value must be one value: a UUID, ident, title or number"}
+      (empty? matches)
+      {:error (str "the block holds no " label " value " (pr-str (str value)))}
+      (next matches)
+      {:error (str (pr-str (str value)) " names " (count matches) " of the block's " label
+                   " values; name one by UUID")}
+      (and (= :block/tags property-ident) (display-class? db (:db/id tag)))
+      {:error (str (:block/title tag) ": remove it by deleting display-type, not as a tag")}
+      (and (= :block/tags property-ident) (kept-tag? db (:db/id tag)))
+      {:error (str (:block/title tag) " is a built-in tag Logseq sets itself and can't be removed")}
+      :else {:value (first matches)})))
+
+(defn- delete-body
+  "deleteBlockProperty's body, read from `request` as {:body b} (b nil when there is none) or
+  {:error reason}. The body takes value alone, so a misspelt or misplaced value, or malformed JSON,
+  is refused rather than read as no value, which would delete the whole property."
+  [request]
+  (p/let [text (.text request)]
+    (if (string/blank? text)
+      {:body nil}
+      (let [body (try (js->clj (js/JSON.parse text) :keywordize-keys true)
+                      (catch :default _ ::malformed))]
+        (cond
+          (= ::malformed body) {:error "body: not valid JSON"}
+          (not (map? body)) {:error "body: give an object with value, or no body"}
+          :else
+          (if-let [unknown (seq (remove #{:value} (keys body)))]
+            {:error (string/join "; " (map #(str (subs (str %) 1) ": not a field; the body takes value"
+                                                 (when (= :target-label %) " (target-label goes in the query)"))
+                                           unknown))}
+            {:body body}))))))
