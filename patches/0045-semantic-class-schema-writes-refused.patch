+(def ^:private class-schema-tools
+  "The class-schema properties a block-property write refuses (item 45), each with the tool that
+  writes it. A batch judges its class checks on the classes and extends it started with, and these
+  writes would skip update_property's and update_tag's own checks."
+  {:logseq.property/classes "update_property (classes)"
+   :logseq.property.class/extends "update_tag (extends)"})
+
+(defn- class-schema-refusal
+  "Why a block-property set naming `property-ident` is refused: a property's classes and a tag's
+  extends are written with update_property and update_tag. nil for any other property."
+  [property-ident]
+  (when-let [tool (get class-schema-tools property-ident)]
+    (str (subs (str property-ident) 1) " can't be set here; use " tool)))
+
+(defn- set-property-refusal
+  "Why a block-property set naming `property-ident` is refused, or nil."
+  [property-ident]
+  (or (stamp-property-refusal property-ident) (class-schema-refusal property-ident)))
+
