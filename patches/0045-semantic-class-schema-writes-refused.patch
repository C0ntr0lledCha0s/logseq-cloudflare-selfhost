+;; Item 45: the class check reads a property's classes and each tag's extends as they were before
+;; the call, so a write that changes them in the same batch as a value judged on them stores an
+;; out-of-class value (or refuses a valid one), and it skips update_property's class checks. A
+;; property's classes are written with update_property (classes) and a tag's extends with
+;; update_tag (extends), so every block-property write path refuses them up front, naming the
+;; entry, and writes nothing: batch-set (with and without reset, in either entry position), a
+;; single set, a batch insert's target properties and an inserted block's properties. The property
+;; is named by ident, by title and by UUID.
+
+(defn- extends-titles [conn id]
+  (set (map :block/title (:logseq.property.class/extends (entity conn id)))))
+
+(defn- class-titles [conn property]
+  (set (map :block/title (:logseq.property/classes (d/entity @conn property)))))
+
+(defn- property-forms
+  "The ways a request names a built-in property: its ident, its title and its UUID."
+  [conn ident]
+  (let [property (d/entity @conn ident)]
+    [["ident" (ident-str ident)] ["title" (:block/title property)] ["UUID" (str (:block/uuid property))]]))
+
+(defn- error-of [response] (str (get-in response [:body :error])))
+
+(defn- refused-naming? [response prefix tool]
+  (and (= 400 (:status response))
+       (string/starts-with? (error-of response) prefix)
+       (string/includes? (error-of response) tool)))
+
+(defn- each-graph
+  "Runs (f graph case) on a fresh graph for each case, one after another."
+  [done cases f]
+  (-> (reduce (fn [chain case] (p/then chain (fn [_] (p/let [g (graph!)] (f g case)))))
+              (p/resolved nil)
+              cases)
+      (p/catch #(is false (str %)))
+      (p/finally done)))
+
+(deftest batch-set-refuses-property-classes-write-test
+  ;; Entry 0 moves for-client from Client to Service under reset, entry 1 sets for-client to Acme (a
+  ;; Client page) by title or UUID. Today this answers 200 and stores Acme outside the new classes.
+  (async done
+    (each-graph done (for [form [:ident :title :uuid] value-form [:title :uuid]] [form value-form])
+      (fn [{:keys [conn self blocks acme for-client fc]} [form value-form]]
+        (let [[label property-id] (some #(when (= (name form) (string/lower-case (first %))) %)
+                                        (property-forms conn :logseq.property/classes))
+              fc-uuid (:block/uuid (d/entity @conn for-client))
+              b0 (first blocks)]
+          (p/let [response (batch-set! self [{:block-id (str fc-uuid) :property-id property-id :value ["Service"]}
+                                             {:block-id (str b0) :property-id fc
+                                              :value (if (= value-form :title) "Acme" (str acme))}]
+                                       {:isResetExistingValues true})]
+            (testing (str "classes named by " label ", value by " (name value-form))
+              (is (refused-naming? response "entry 0: " "update_property") (str (:body response)))
+              (is (nil? (stored conn b0 for-client)) "no out-of-class value is stored")
+              (is (= #{"Client"} (class-titles conn for-client)) "for-client keeps its classes"))))))))
+
+(deftest batch-set-refuses-property-classes-write-any-mode-test
+  ;; Without reset, entry 0 adds Service to for-client's classes and entry 1 uses a Service page:
+  ;; today it is refused for the wrong entry ("entry 1: no #Client object"). With the classes entry
+  ;; second, today the batch answers 200 and rewrites classes. Both are refused naming the classes
+  ;; entry.
+  (async done
+    (each-graph done [:add-first :reset-second]
+      (fn [{:keys [conn self blocks audit acme for-client fc]} mode]
+        (let [fc-uuid (:block/uuid (d/entity @conn for-client))
+              b0 (first blocks)
+              classes {:block-id (str fc-uuid) :property-id "logseq.property/classes" :value ["Service"]}]
+          (p/let [response (case mode
+                             :add-first (batch-set! self [classes {:block-id (str b0) :property-id fc :value (str audit)}])
+                             :reset-second (batch-set! self [{:block-id (str b0) :property-id fc :value (str acme)} classes]
+                                                       {:isResetExistingValues true}))]
+            (testing (name mode)
+              (is (refused-naming? response (if (= mode :add-first) "entry 0: " "entry 1: ") "update_property")
+                  (str (:body response)))
+              (is (nil? (stored conn b0 for-client)) "nothing is stored")
+              (is (= #{"Client"} (class-titles conn for-client)) "for-client keeps its classes"))))))))
+
+(deftest batch-set-refuses-tag-extends-write-test
+  ;; Gamma Ltd is a VIP, so a Client. Entry 0 resets VIP's extends from Client to Service, entry 1
+  ;; sets for-client to Gamma Ltd. Today this answers 200 and stores a page that is no longer a
+  ;; Client object. Without reset, entry 0 makes Service extend Client and entry 1 uses Audit (a
+  ;; Service page): today that is refused for the wrong entry.
+  (async done
+    (each-graph done (for [form [:ident :title :uuid] mode [:reset :add]] [form mode])
+      (fn [{:keys [conn self blocks vip service gamma audit for-client fc]} [form mode]]
+        (let [[label property-id] (some #(when (= (name form) (string/lower-case (first %))) %)
+                                        (property-forms conn :logseq.property.class/extends))
+              [b0 b1] blocks
+              vip-extends (extends-titles conn (:block/uuid vip))
+              service-extends (extends-titles conn (:block/uuid service))]
+          (p/let [tagged (batch-set! self [(tag-entry gamma "VIP")])
+                  response (case mode
+                             :reset (batch-set! self [{:block-id (str (:block/uuid vip)) :property-id property-id :value ["Service"]}
+                                                      {:block-id (str b0) :property-id fc :value "Gamma Ltd"}]
+                                                {:isResetExistingValues true})
+                             :add (batch-set! self [{:block-id (str (:block/uuid service)) :property-id property-id :value ["Client"]}
+                                                    {:block-id (str b1) :property-id fc :value (str audit)}]))]
+            (testing (str "extends named by " label ", " (name mode))
+              (is (= 200 (:status tagged)) (str "Gamma Ltd is a VIP " (:body tagged)))
+              (is (refused-naming? response "entry 0: " "update_tag") (str (:body response)))
+              (is (nil? (stored conn b0 for-client)) "nothing is stored")
+              (is (nil? (stored conn b1 for-client)) "nothing is stored")
+              (is (= vip-extends (extends-titles conn (:block/uuid vip))) "VIP keeps its extends")
+              (is (= service-extends (extends-titles conn (:block/uuid service))) "Service keeps its extends"))))))))
+
+(deftest single-set-refuses-class-schema-writes-test
+  ;; setBlockProperty on the property page sets classes to a plain page (not a class), and on a
+  ;; tag replaces its extends. Today both answer 200, skipping update_property's class checks.
+  (async done
+    (run done
+      (fn [{:keys [conn self vip for-client]}]
+        (let [fc-uuid (:block/uuid (d/entity @conn for-client))
+              vip-extends (extends-titles conn (:block/uuid vip))]
+          (p/let [classes (request! self "PUT" (str "/semantic/blocks/" fc-uuid "/properties/logseq.property%2Fclasses")
+                                    {:value "Acme Ltd"})
+                  extends (request! self "PUT" (str "/semantic/blocks/" (:block/uuid vip)
+                                                    "/properties/logseq.property.class%2Fextends")
+                                    {:value "Service"})]
+            (is (refused-naming? classes "entry 0: " "update_property") (str (:body classes)))
+            (is (= #{"Client"} (class-titles conn for-client)) "for-client keeps its classes")
+            (is (refused-naming? extends "entry 0: " "update_tag") (str (:body extends)))
+            (is (= vip-extends (extends-titles conn (:block/uuid vip))) "VIP keeps its extends")))))))
+
+(deftest batch-insert-refuses-class-schema-writes-test
+  ;; batchInsertBlockTrees: a target's properties add Service to for-client's classes before another
+  ;; entry uses a Service page (today refused for the wrong entry), add Service to VIP's extends
+  ;; (today 201), or an inserted block's properties carry classes (today stored on a plain block).
+  (async done
+    (each-graph done [:target-classes :target-extends :block-classes]
+      (fn [{:keys [conn self page-id vip audit for-client fc]} kind]
+        (let [n0 (random-uuid)
+              fc-uuid (:block/uuid (d/entity @conn for-client))
+              vip-extends (extends-titles conn (:block/uuid vip))]
+          (p/let [response (insert-batch!
+                            self
+                            (case kind
+                              :target-classes [{:target-id (str fc-uuid) :properties {"logseq.property/classes" "Service"}}
+                                               {:target-id (str page-id)
+                                                :blocks [{:uuid (str n0) :title "Inserted" :properties {fc (str audit)}}]}]
+                              :target-extends [{:target-id (str (:block/uuid vip)) :properties {"Extends" "Service"}}]
+                              :block-classes [{:target-id (str page-id)
+                                               :blocks [{:uuid (str n0) :title "Inserted"
+                                                         :properties {"logseq.property/classes" "Client"}}]}]))]
+            (testing (name kind)
+              (is (refused-naming? response (if (= kind :block-classes) "entries[0].blocks[0]" "entries[0]")
+                                   (if (= kind :target-extends) "update_tag" "update_property"))
+                  (str (:body response)))
+              (is (nil? (entity conn n0)) "nothing is inserted")
+              (is (= #{"Client"} (class-titles conn for-client)) "for-client keeps its classes")
+              (is (= vip-extends (extends-titles conn (:block/uuid vip))) "VIP keeps its extends"))))))))
