diff --git a/deps/db-sync/test/logseq/db_sync/semantic_outline_paging_test.cljs b/deps/db-sync/test/logseq/db_sync/semantic_outline_paging_test.cljs
new file mode 100644
index 0000000..e8baad4
--- /dev/null
+++ b/deps/db-sync/test/logseq/db_sync/semantic_outline_paging_test.cljs
@@ -0,0 +1,178 @@
+(ns logseq.db-sync.semantic-outline-paging-test
+  "getPageOutline reads part of a page (LC-135): depth stops the outline after n levels and names
+  each block it doesn't expand with its uuid and how many blocks sit under it; root outlines one
+  block's subtree; limit and cursor page through the top-level blocks (or root's children), never
+  splitting a block; max-chars ends a page of the outline at a block boundary with a next-cursor
+  instead of a result too large to read. With none of them the outline is unchanged."
+  (:require [cljs.test :refer [async deftest is testing]]
+            [clojure.string :as string]
+            [datascript.core :as d]
+            [logseq.db-sync.test-sql :as test-sql]
+            [logseq.db-sync.worker.handler.sync :as sync-handler]
+            [logseq.db.sqlite.export :as sqlite-export]
+            [logseq.outliner.core :as outliner-core]
+            [logseq.outliner.page :as outliner-page]
+            [promesa.core :as p]))
+
+(defn- request!
+  "One semantic API request through the real handler; returns {:status :body}."
+  [self method path body]
+  (p/let [url (str "http://localhost" path (if (string/includes? path "?") "&" "?") "graph-id=graph-1")
+          response (sync-handler/handle-http
+                    self
+                    (js/Request. url (clj->js (cond-> {:method method
+                                                       :headers {"content-type" "application/json"}}
+                                                body (assoc :body (js/JSON.stringify (clj->js body)))))))
+          text (.text response)]
+    {:status (.-status response)
+     :body (when (seq text)
+             (try (js->clj (js/JSON.parse text) :keywordize-keys true)
+                  (catch :default _ text)))}))
+
+(defn- with-page
+  "A page holding the tree `blocks` ({:title :children}), inserted through insertBlockTree."
+  [done blocks run]
+  (-> (p/let [conn (sqlite-export/create-conn)
+              [_ page-id] (outliner-page/create! conn "Paging" {})
+              self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true}
+              inserted (request! self "POST" "/semantic/block-trees" {:target-id (str page-id) :blocks blocks})
+              _ (is (= 201 (:status inserted)) (pr-str (:body inserted)))
+              uuid-of (fn [title] (str (:block/uuid (d/entity @conn (ffirst (d/q '[:find ?b :in $ ?t :where [?b :block/title ?t]]
+                                                                                   @conn title))))))]
+        (run {:conn conn :self self :page-id page-id :uuid-of uuid-of}))
+      (p/catch #(is false (str "unexpected error: " %)))
+      (p/finally done)))
+
+(def tree
+  [{:title "A" :children [{:title "a1"} {:title "a2" :children [{:title "a2x"}]}]}
+   {:title "B"}
+   {:title "C" :children [{:title "c1"}]}])
+
+(defn- outline! [self page-id query]
+  (request! self "GET" (str "/semantic/pages/" page-id "/outline" (when query (str "?" query))) nil))
+
+(deftest outline-without-paging-parameters-is-unchanged-test
+  (async done
+    (with-page done tree
+      (fn [{:keys [self page-id]}]
+        (p/let [{:keys [status body]} (outline! self page-id nil)]
+          (is (= 200 status))
+          (is (= "- A\n  - a1\n  - a2\n    - a2x\n- B\n- C\n  - c1" (:markdown body)))
+          (is (= 7 (:block-count body)))
+          (is (false? (:truncated body)))
+          (is (not (contains? body :next-cursor)))
+          (is (not (contains? body :omitted-blocks))))))))
+
+(deftest outline-depth-names-each-block-it-does-not-expand-test
+  (async done
+    (with-page done tree
+      (fn [{:keys [self page-id uuid-of]}]
+        (p/let [one (outline! self page-id "depth=1")
+                two (outline! self page-id "depth=2")]
+          (testing "depth=1: one line per top-level block, each folded block naming its uuid and count"
+            (is (= 200 (:status one)) (pr-str (:body one)))
+            (is (= (str "- A (+3 blocks: ((" (uuid-of "A") ")))\n- B\n- C (+1 block: ((" (uuid-of "C") ")))")
+                   (get-in one [:body :markdown])))
+            (is (= 3 (get-in one [:body :block-count])))
+            (is (= 4 (get-in one [:body :omitted-blocks])) "every block not shown is counted"))
+          (testing "depth=2 folds only what lies deeper"
+            (is (= (str "- A\n  - a1\n  - a2 (+1 block: ((" (uuid-of "a2") ")))\n- B\n- C\n  - c1")
+                   (get-in two [:body :markdown])))
+            (is (= 1 (get-in two [:body :omitted-blocks])))))))))
+
+(deftest outline-root-reads-one-subtree-test
+  (async done
+    (with-page done tree
+      (fn [{:keys [conn self page-id uuid-of]}]
+        (p/let [whole (outline! self page-id (str "root=" (uuid-of "A")))
+                shallow (outline! self page-id (str "root=" (uuid-of "A") "&depth=1"))
+                [_ other-page] (outliner-page/create! conn "Elsewhere" {})
+                _ (request! self "POST" "/semantic/block-trees" {:target-id (str other-page) :blocks [{:title "far"}]})
+                foreign (outline! self page-id (str "root=" (uuid-of "far")))
+                missing (outline! self page-id (str "root=" (random-uuid)))
+                malformed (outline! self page-id "root=not-a-uuid")]
+          (is (= "- A\n  - a1\n  - a2\n    - a2x" (get-in whole [:body :markdown])) "the root and everything under it")
+          (is (= 4 (get-in whole [:body :block-count])))
+          (is (= (str "- A\n  - a1\n  - a2 (+1 block: ((" (uuid-of "a2") ")))") (get-in shallow [:body :markdown]))
+              "depth counts levels below the root")
+          (doseq [[label response] [["a block on another page" foreign] ["an unknown uuid" missing] ["not a uuid" malformed]]]
+            (is (= 400 (:status response)) label)
+            (is (string/starts-with? (str (get-in response [:body :error])) "root:") (str label ": " (pr-str (:body response))))))))))
+
+(deftest outline-limit-and-cursor-page-through-top-level-blocks-test
+  (async done
+    (with-page done tree
+      (fn [{:keys [self page-id uuid-of]}]
+        (p/let [first-page (outline! self page-id "limit=2")
+                cursor (get-in first-page [:body :next-cursor])
+                second-page (outline! self page-id (str "limit=2&cursor=" (js/encodeURIComponent cursor)))
+                rooted (outline! self page-id (str "root=" (uuid-of "A") "&limit=1"))
+                rooted-next (outline! self page-id (str "root=" (uuid-of "A") "&limit=1&cursor="
+                                                       (js/encodeURIComponent (get-in rooted [:body :next-cursor]))))]
+          (is (= "- A\n  - a1\n  - a2\n    - a2x\n- B" (get-in first-page [:body :markdown])) "a block is never split")
+          (is (string? cursor))
+          (is (= "- C\n  - c1" (get-in second-page [:body :markdown])))
+          (is (not (contains? (:body second-page) :next-cursor)) "the last page has no next-cursor")
+          (testing "with root, the pages are root's children; the root's own line comes on the first page only"
+            (is (= "- A\n  - a1" (get-in rooted [:body :markdown])))
+            (is (= "  - a2\n    - a2x" (get-in rooted-next [:body :markdown])))))))))
+
+(deftest outline-max-chars-ends-at-a-block-boundary-test
+  (async done
+    (with-page done (mapv (fn [i] {:title (str "Block " i " " (apply str (repeat 120 "x")))
+                                   :children [{:title (str "child " i)}]})
+                          (range 10))
+      (fn [{:keys [self page-id]}]
+        (p/let [pages (p/loop [cursor nil acc []]
+                        (p/let [response (outline! self page-id (str "max-chars=200"
+                                                                    (when cursor (str "&cursor=" (js/encodeURIComponent cursor)))))
+                                acc (conj acc response)
+                                next (get-in response [:body :next-cursor])]
+                          (if (and next (< (count acc) 20)) (p/recur next acc) acc)))
+                markdowns (map #(get-in % [:body :markdown]) pages)
+                tiny (outline! self page-id "max-chars=100")]
+          (is (every? #(= 200 (:status %)) pages))
+          (is (every? #(<= (count %) 200) markdowns) "each page stays within max-chars")
+          (is (= (get-in (first pages) [:body :markdown])
+                 (string/join "\n" (take 2 (string/split-lines (get-in (first pages) [:body :markdown])))))
+              "a page ends after a whole top-level block and its children")
+          (is (= 20 (count (mapcat string/split-lines markdowns))) "every block once, across the pages")
+          (is (= (count (distinct (mapcat string/split-lines markdowns))) 20) "none twice")
+          (testing "a first block larger than max-chars is still returned, so paging always moves on"
+            (is (= 200 (:status tiny)))
+            (is (= 2 (count (string/split-lines (get-in tiny [:body :markdown])))))
+            (is (string? (get-in tiny [:body :next-cursor])))))))))
+
+(deftest outline-paging-parameters-are-checked-test
+  (async done
+    (with-page done tree
+      (fn [{:keys [self page-id]}]
+        (p/let [responses (p/all (map #(outline! self page-id %)
+                                      ["depth=0" "depth=x" "depth=51" "limit=0" "limit=201"
+                                       "max-chars=99" "max-chars=1000001" "cursor=garbage"]))]
+          (doseq [[query {:keys [status body]}] (map vector ["depth" "depth" "depth" "limit" "limit" "max-chars" "max-chars" "cursor"]
+                                                      responses)]
+            (is (= 400 status) (str query ": " (pr-str body)))
+            (is (string/starts-with? (str (:error body)) query) (str query ": " (pr-str body)))))))))
+
+(deftest outline-block-budget-gives-a-cursor-test
+  ;; A page past the 2,000-block budget used to answer truncated with no way on. Now the outline stops
+  ;; after the last whole top-level block within the budget and gives a next-cursor.
+  (async done
+    (-> (p/let [conn (sqlite-export/create-conn)
+                [_ page-id] (outliner-page/create! conn "Big" {})
+                page (d/entity @conn [:block/uuid page-id])
+                _ (outliner-core/insert-blocks! conn (mapv (fn [i] {:block/uuid (random-uuid) :block/title (str "b" i)}) (range 2050))
+                                                page {:sibling? false :keep-uuid? true :bottom? true})
+                self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true}
+                first-page (outline! self page-id nil)
+                second-page (outline! self page-id (str "cursor=" (js/encodeURIComponent (get-in first-page [:body :next-cursor]))))
+                lines (concat (string/split-lines (get-in first-page [:body :markdown]))
+                              (string/split-lines (get-in second-page [:body :markdown])))]
+          (is (true? (get-in first-page [:body :truncated])))
+          (is (= 2000 (get-in first-page [:body :block-count])))
+          (is (string? (get-in first-page [:body :next-cursor])))
+          (is (= 50 (get-in second-page [:body :block-count])))
+          (is (= 2050 (count (distinct lines))) "every block once across the two calls"))
+        (p/catch #(is false (str "unexpected error: " %)))
+        (p/finally done))))
