+(defn- outline-descendant-count
+  "How many visible blocks sit under `entity`, at any depth."
+  [db entity]
+  (reduce + 0 (map #(inc (outline-descendant-count db %)) (outline-children db entity))))
+
+(defn- outline-cursor-key [block]
+  [(str (:block/order block)) (str (:block/uuid block))])
+
+(defn- page-outline
+  "A page's (or one root block's) block tree as a markdown outline. With no options it is the whole
+  tree up to `max-blocks`. LC-135: `depth` expands that many levels (below the root, when there is
+  one) and ends each block it doesn't expand with its uuid and the count under it; `root` outlines
+  one block's subtree, its own line first; `limit` and `max-chars` end the outline after a whole
+  top-level block (or root child), and `cursor` resumes after the last one returned. A page of the
+  outline always holds at least one such block, so paging moves on however small max-chars is."
+  ([db page max-blocks] (page-outline db page max-blocks {}))
+  ([db page max-blocks {:keys [depth root limit cursor max-chars]}]
+   (let [n (volatile! 0)
+         omitted (volatile! 0)
+         truncated? (volatile! false)
+         render (fn render [lines block level budget & [line-only?]]
+                  ;; Appends `block` and what it expands to `lines`; returns the lines. Stops adding
+                  ;; blocks once `budget` (a volatile count of blocks left) is spent.
+                  (if (<= @budget 0)
+                    (do (vreset! truncated? true) lines)
+                    (let [indent (apply str (repeat level "  "))
+                          status (some-> (:logseq.property/status block) :block/title)
+                          title (or (db-content/recur-replace-uuid-in-block-title block) "")
+                          typed (outline-typed-text block title (str indent "  "))
+                          ;; A typed block has no heading (patch 0037).
+                          heading (when-not typed (outline-heading-level block))
+                          children (outline-children db block)
+                          fold? (and (not line-only?) depth (seq children) (>= (+ level (if root 0 1)) depth))
+                          hidden (when fold? (outline-descendant-count db block))
+                          line (str indent "- " (when status (str "[" status "] "))
+                                    (when heading (str (apply str (repeat heading "#")) " ")) (or typed title)
+                                    (when fold? (str " (+" hidden (if (= 1 hidden) " block" " blocks")
+                                                     ": ((" (:block/uuid block) ")))")))]
+                      (vswap! budget dec)
+                      (when fold? (vswap! omitted + hidden))
+                      (let [lines (into (conj lines line) (outline-property-lines db block indent))]
+                        (if (or fold? line-only?)
+                          lines
+                          (reduce (fn [lines child] (render lines child (inc level) budget)) lines children))))))
+         container (or root page)
+         base (if root 1 0)
+         units (cond->> (outline-children db container)
+                 cursor (drop-while #(not (pos? (compare (outline-cursor-key %) cursor)))))
+         budget (volatile! max-blocks)
+         head (if (and root (nil? cursor)) (render [] root 0 (volatile! 1) true) [])
+         _ (when (seq head) (vswap! budget dec))
+         result (loop [lines head units units emitted 0 last-unit nil]
+                  (if-let [unit (first units)]
+                    (let [before-n @budget
+                          before-omitted @omitted
+                          unit-lines (render [] unit base budget)
+                          size (count (string/join "\n" (into lines unit-lines)))
+                          over-chars? (and max-chars (pos? emitted) (> size max-chars))
+                          over-blocks? (and (pos? emitted) @truncated?)]
+                      (cond
+                        (or over-chars? over-blocks?)
+                        (do (vreset! budget before-n)
+                            (vreset! omitted before-omitted)
+                            (when over-chars? (vreset! truncated? false))
+                            {:lines lines :last last-unit :more? true})
+                        (and limit (= (inc emitted) limit))
+                        {:lines (into lines unit-lines) :last unit :more? (boolean (seq (rest units)))}
+                        @truncated?
+                        {:lines (into lines unit-lines) :last unit :more? (boolean (seq (rest units)))}
+                        :else
+                        (recur (into lines unit-lines) (rest units) (inc emitted) unit)))
+                    {:lines lines :last last-unit :more? false}))]
+     (vreset! n (- max-blocks @budget))
+     (cond-> {:markdown (string/join "\n" (:lines result))
+              :block-count @n
+              :truncated @truncated?}
+       depth (assoc :omitted-blocks @omitted)
+       (and (:more? result) (:last result)) (assoc :next-cursor (encode-cursor (outline-cursor-key (:last result))))))))
+
+(defn- outline-int-param
+  "The whole number query parameter `name` within [lo, hi], nil when absent, or ::invalid."
+  [url name lo hi]
+  (let [raw (.get (.-searchParams url) name)]
+    (cond
+      (nil? raw) nil
+      (not (re-matches #"\d+" raw)) ::invalid
+      :else (let [v (js/parseInt raw 10)] (if (<= lo v hi) v ::invalid)))))
+
+(defn- outline-options
+  "getPageOutline's paging options from the query (LC-135), or {:error message} naming the parameter."
+  [db page url]
+  (let [params (.-searchParams url)
+        depth (outline-int-param url "depth" 1 50)
+        limit (outline-int-param url "limit" 1 200)
+        max-chars (outline-int-param url "max-chars" 100 1000000)
+        raw-cursor (.get params "cursor")
+        cursor (decode-cursor raw-cursor)
+        raw-root (.get params "root")
+        root-uuid (when raw-root (parse-uuid raw-root))
+        root (when root-uuid (d/entity db [:block/uuid root-uuid]))]
+    (cond
+      (= ::invalid depth) {:error "depth: must be a whole number from 1 to 50"}
+      (= ::invalid limit) {:error "limit: must be a whole number from 1 to 200"}
+      (= ::invalid max-chars) {:error "max-chars: must be a whole number from 100 to 1000000"}
+      (and raw-cursor (nil? cursor)) {:error "cursor: not a cursor this outline gave; pass a next-cursor from the same page and root, or leave it out"}
+      (and raw-root (nil? root-uuid)) {:error (str "root: not a block UUID: " raw-root)}
+      (and raw-root (or (nil? root) (entity-util/hidden? root) (page? root)
+                        (not= (:db/id page) (:db/id (:block/page root)))))
+      {:error (str "root: no visible block " raw-root " on this page")}
+      :else {:depth depth :limit limit :max-chars max-chars :cursor cursor :root root})))
 
