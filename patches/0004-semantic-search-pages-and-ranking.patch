+(deftest semantic-search-filters-pages-and-ranks-them-before-blocks-test
+  (async done
+         (with-memory-sql-async
+           (fn [sql]
+             (storage/init-schema! sql)
+             (let [conn (storage/open-conn sql)
+                   page-id (random-uuid)
+                   other-page-id (random-uuid)
+                   block-id (random-uuid)
+                   _ (d/transact! conn [{:db/ident :logseq.class/Page}
+                                        {:block/uuid page-id
+                                         :block/name "roadmap"
+                                         :block/title "Roadmap"
+                                         :block/tags :logseq.class/Page}
+                                        {:block/uuid other-page-id
+                                         :block/name "roadmap archive"
+                                         :block/title "Roadmap archive"
+                                         :block/tags :logseq.class/Page}
+                                        {:block/uuid block-id
+                                         :block/title "Agree the roadmap"
+                                         :block/page [:block/uuid other-page-id]
+                                         :block/parent [:block/uuid other-page-id]
+                                         :block/order "a0"}])
+                   self #js {:sql sql :conn conn :schema-ready true}
+                   requests [(semantic-json-request "/semantic/search?graph-id=graph-1&q=roadmap" "GET" nil)
+                             (semantic-json-request "/semantic/search?graph-id=graph-1&q=Roadmap&types=pages" "GET" nil)
+                             (semantic-json-request "/semantic/search?graph-id=graph-1&q=roadmap&limit=1" "GET" nil)
+                             (semantic-json-request "/semantic/search?graph-id=graph-1&q=roadmap&types=page" "GET" nil)]]
+               (-> (p/let [responses (p/all (map #(sync-handler/handle-http self %) requests))
+                            bodies (p/all (map json-body responses))
+                            next-response (sync-handler/handle-http
+                                           self
+                                           (semantic-json-request (str "/semantic/search?graph-id=graph-1&q=roadmap&limit=1&cursor="
+                                                                       (js/encodeURIComponent (get-in bodies [2 :next-cursor])))
+                                                                  "GET" nil))
+                            next-body (json-body next-response)]
+                     (is (= [200 200 200 400] (mapv #(.-status %) responses)) (pr-str bodies))
+                     (is (= [[(str page-id) "pages"] [(str other-page-id) "pages"] [(str block-id) "blocks"]]
+                            (mapv (juxt :uuid :resource) (get-in bodies [0 :results]))))
+                     (is (= [(str page-id) (str other-page-id)] (mapv :uuid (get-in bodies [1 :results]))))
+                     (is (= [(str page-id)] (mapv :uuid (get-in bodies [2 :results]))))
+                     (is (= (str other-page-id) (get-in next-body [:results 0 :uuid])))
+                     (is (= "invalid types" (get-in bodies [3 :error]))))
+                   (p/then (fn [] (done)))
+                   (p/catch (fn [error]
+                              (is false (str error))
+                              (done)))))))))
 
