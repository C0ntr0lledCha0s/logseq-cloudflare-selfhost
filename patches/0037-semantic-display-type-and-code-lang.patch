+(deftest edit-stamps-and-one-transaction-test
+  (async done
+    (with-graph done 2
+      (fn [{:keys [conn self ids]}]
+        (let [[a b] ids
+              ops (atom [])]
+          (d/listen! conn ::ops #(swap! ops conj (:outliner-op (:tx-meta %))))
+          (p/let [single (put! self a type-ident "code" :headers stamped)
+                  single-ops @ops
+                  _ (reset! ops [])
+                  batch (batch-set! self [[b type-ident "math"] [a lang-ident "python"]] :headers stamped)
+                  batch-ops @ops
+                  _ (reset! ops [])
+                  deleted (delete! self a type-ident)]
+            (d/unlisten! conn ::ops)
+            (ok? single "single") (ok? batch "batch") (ok? deleted "delete")
+            (is (= 1 (count single-ops)) (str "one transaction: " (pr-str single-ops)))
+            (is (= 1 (count batch-ops)) (str "one transaction: " (pr-str batch-ops)))
+            (is (= 1 (count @ops)) (str "one transaction: " (pr-str @ops)))
+            (doseq [id [a b]]
+              (is (some? (:user.property/claude-editedBy (d/entity @conn [:block/uuid id]))) "stamped"))))))))
