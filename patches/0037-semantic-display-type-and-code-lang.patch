+;; Before the fix Code was written as a tag (and the type was left unset):
+;;   expected: (= 400 (:status response))  actual: 200
+(deftest display-classes-refused-as-tags-test
+  (async done
+    (with-graph done 3
+      (fn [{:keys [conn self ids]}]
+        (let [[text code other] ids]
+          (p/let [example (request! self "POST" "/semantic/tags" {:title "Example"})
+                  example-id (get-in example [:body :uuid])
+                  _ (put! self code type-ident "code")
+                  _ (put! self other type-ident "math")]
+            (p/doseq [[value message] [["Code" "Code: set it with display-type code, not as a tag"]
+                                       ["logseq.class/Math-block" "Math: set it with display-type math, not as a tag"]
+                                       [(str (:block/uuid (d/entity @conn :logseq.class/Quote-block)))
+                                        "Quote: set it with display-type quote, not as a tag"]]]
+              (p/let [before (snapshot conn)
+                      single (put! self text "block/tags" value)
+                      listed (put! self text "block/tags" [example-id value])
+                      batch (batch-set! self [[text "block/tags" example-id] [text "block/tags" value]])]
+                (refused? single (str "Tags: " message) (str value))
+                (refused? listed (str "Tags: " message) (str value " in a list"))
+                (refused? batch (str "entry 1: Tags: " message) (str value " in a batch"))
+                (is (= before (snapshot conn)) "nothing written")))
+            (p/let [held (put! self code "block/tags" ["Code" example-id])
+                    _ (ok? held "a held Code is a no-op")
+                    _ (is (= (typed :code) (select-keys (state conn code) [:type :classes :lang :heading])))
+                    _ (is (some #(= "Example" (:block/title %)) (:block/tags (d/entity @conn [:block/uuid code]))))
+                    reset (put! self code "block/tags" [])
+                    _ (ok? reset "a reset list without Code")
+                    _ (is (= (typed :code) (state conn code)) "Code is kept, as private tags are")
+                    batch-reset (batch-set! self [[other type-ident "math"] [other "block/tags" [example-id]]]
+                                            :reset? true)
+                    _ (ok? batch-reset "a batch reset list without Math")
+                    _ (is (= (typed :math) (state conn other)) "Math is kept")
+                    journal (put! self text "block/tags" "Journal")]
+              (is (= 400 (:status journal)) (pr-str journal))
+              (is (string/includes? (str (get-in journal [:body :error])) "Journal is a built-in tag")
+                  "private tags are still refused"))))))))
