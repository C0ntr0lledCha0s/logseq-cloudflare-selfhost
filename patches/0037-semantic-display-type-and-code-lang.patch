+(defn- display-value
+  "prepare-property-value for display-type and lang: {:value v}, or {:error reason ::entry? true}
+  for a caller to name the entry. Both apply to blocks only. Whether lang's block is code is judged
+  by the caller on the call's final state (lang-error)."
+  [db property-ident value scope]
+  (let [label (if (= display-type-ident property-ident) "display-type" "lang")
+        kind (scope-kind db scope)
+        refuse (fn [reason] {:error (str label ": " reason) ::entry? true})]
+    (cond
+      (not= "block" kind) {:error (str label " applies to blocks, not " (kind-articles kind)) ::entry? true}
+      (= display-type-ident property-ident)
+      (if-let [kw (parse-display-type value)]
+        {:value kw}
+        (refuse (str (pr-str (if (string? value) value (str value))) " is not one of "
+                     (string/join ", " (map name display-type-order)))))
+      (valid-lang? value) {:value value}
+      :else (refuse "must be 1 to 40 characters with no spaces"))))
