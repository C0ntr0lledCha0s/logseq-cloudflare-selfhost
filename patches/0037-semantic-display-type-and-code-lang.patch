+(defn- lang-error
+  "Why a lang write in `writes` ({:block :property-ident :prepared}, in request order) can't be
+  applied: lang needs display-type code, judged on each block's type once every write has applied,
+  as *final-tags* judges tags; else nil."
+  [writes]
+  (let [final (reduce (fn [types {:keys [block property-ident prepared]}]
+                        (cond-> types
+                          (and (= display-type-ident property-ident) (contains? prepared :value))
+                          (assoc (:db/id block) (:value prepared))))
+                      {} writes)]
+    (some (fn [[index {:keys [block property-ident prepared]}]]
+            (when (and (= lang-ident property-ident) (contains? prepared :value)
+                       (not= :code (get final (:db/id block) (display-type-ident block))))
+              (str "entry " index ": lang needs display-type code")))
+          (map-indexed vector writes))))
