+                  listed (request! self "GET" (str "/semantic/pages/" page-id "/blocks") nil)
+                  by-uuid (fn [blocks] (into {} (map (juxt :uuid identity)) blocks))]
+            (doseq [[label blocks] [["getBlocks" (by-uuid (get-in many [:body :blocks]))]
+                                    ["listPageBlocks" (by-uuid (get-in listed [:body :blocks]))]]]
+              (is (= ["code" "python"] ((juxt :display-type :lang) (get blocks (str code)))) label)
+              (is (= ["math" nil] ((juxt :display-type :lang) (get blocks (str math)))) label)
+              (is (not (contains? (get blocks (str math)) :lang)) (str label ": no lang key"))
+              (is (some? (get blocks (str text))) label)
+              (is (not-any? #(contains? (get blocks (str text)) %) [:display-type :lang])
+                  (str label ": a plain block has neither key")))
+            (is (= (typed :code "python") (state conn code)))))))))
