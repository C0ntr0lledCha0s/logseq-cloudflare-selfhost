+      (fn [{:keys [conn self page-id]}]
+        (p/let [before (snapshot conn)
+                existing (request! self "POST" "/semantic/block-trees/batch"
+                                   {:entries [{:target-id (str page-id) :properties {type-ident "code"}
+                                               :blocks [{:title "Example"}]}]})
+                created (request! self "POST" "/semantic/block-trees/batch"
+                                  {:entries [{:page "Example page" :properties {lang-ident "python"}
+                                              :blocks [{:title "Example"}]}]})]
+          (doseq [[label response kind] [["existing page" existing "display-type"] ["new page" created "lang"]]]
+            (is (= 400 (:status response)) (str label ": " (pr-str response)))
+            (is (string/includes? (str (get-in response [:body :error])) (str kind " applies to blocks, not a page"))
+                (str label ": " (pr-str (:body response)))))
+          (is (= before (snapshot conn)) "nothing written"))))))
