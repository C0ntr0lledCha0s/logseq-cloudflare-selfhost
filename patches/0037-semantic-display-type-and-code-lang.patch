diff --git a/deps/db-sync/test/logseq/db_sync/semantic_display_type_test.cljs b/deps/db-sync/test/logseq/db_sync/semantic_display_type_test.cljs
new file mode 100644
index 0000000..a72fac2
--- /dev/null
+++ b/deps/db-sync/test/logseq/db_sync/semantic_display_type_test.cljs
@@ -0,0 +1,499 @@
+(ns logseq.db-sync.semantic-display-type-test
+  "Code, math and quote blocks through the property paths (patch 0037, stage 1). The block type
+  lives in :logseq.property.node/display-type, a keyword property, and JSON can't carry a keyword,
+  so set_block_property and batch_set_block_property refused every value with `should be a Clojure
+  keyword`. They now take \"code\", \"math\" and \"quote\" (also \":code\", trimmed, any case) and
+  write them as the app's client pipeline does: the keyword, the matching class tag (Code-block,
+  Math-block, Quote-block) and none of the other two, lang only on code, and no heading. lang
+  (:logseq.property.code/lang) is 1 to 40 characters with no spaces and needs a final type of code.
+  Both apply to blocks only. The three classes can't be written as tags (one way in, so tag and
+  type can't drift), a held one is a no-op, and a reset tag list keeps it. Deleting the type removes
+  its tag and lang. Every write reads back inside its transaction. Reads report both fields."
+  (:require [cljs.test :refer [async deftest is testing]]
+            [clojure.string :as string]
+            [datascript.core :as d]
+            [logseq.db-sync.test-sql :as test-sql]
+            [logseq.db-sync.worker.handler.semantic :as semantic]
+            [logseq.db-sync.worker.handler.sync :as sync-handler]
+            [logseq.db.sqlite.export :as sqlite-export]
+            [logseq.outliner.core :as outliner-core]
+            [logseq.outliner.page :as outliner-page]
+            [logseq.outliner.property :as outliner-property]
+            [promesa.core :as p]))
+
+(def ^:private actor
+  (js/encodeURIComponent
+   (js/JSON.stringify #js {"sub" "6f2c1a90-5b1e-4c7a-9d3e-2a1b0c9d8e7f"
+                           "cognito:username" "Owner" "email" "owner@example.com"})))
+
+(def ^:private stamped [["x-logseq-sync-actor" actor] ["x-logseq-edit-stamp" "claude"]])
+
+(defn- request!
+  "One semantic API request through the real handler; returns {:status :body}."
+  [self method path body & {:keys [headers]}]
+  (p/let [url (str "http://localhost" path (if (string/includes? path "?") "&" "?") "graph-id=graph-1")
+          js-headers (js/Headers. #js {"content-type" "application/json"})
+          _ (doseq [[k v] headers] (.append js-headers k v))
+          response (sync-handler/handle-http
+                    self
+                    (js/Request. url (clj->js (cond-> {:method method :headers js-headers}
+                                                body (assoc :body (js/JSON.stringify (clj->js body)))))))
+          text (.text response)]
+    {:status (.-status response)
+     :body (when (seq text)
+             (try (js->clj (js/JSON.parse text) :keywordize-keys true)
+                  (catch :default _ text)))}))
+
+(def ^:private type-ident "logseq.property.node/display-type")
+(def ^:private lang-ident "logseq.property.code/lang")
+(def ^:private classes
+  {:code :logseq.class/Code-block :math :logseq.class/Math-block :quote :logseq.class/Quote-block})
+
+(defn- put! [self id property value & opts]
+  (apply request! self "PUT" (str "/semantic/blocks/" id "/properties/" (js/encodeURIComponent property))
+         {:value value} opts))
+
+(defn- delete! [self id property]
+  (request! self "DELETE" (str "/semantic/blocks/" id "/properties/" (js/encodeURIComponent property)) nil))
+
+(defn- batch-set! [self entries & {:keys [reset? headers]}]
+  (request! self "POST" "/semantic/block-properties/batch-set"
+            (cond-> {:entries (mapv (fn [[id property value]]
+                                      {:block-id (str id) :property-id property :value value})
+                                    entries)}
+              reset? (assoc :isResetExistingValues true))
+            :headers headers))
+
+(defn- batch-delete! [self entries]
+  (request! self "POST" "/semantic/block-properties/batch-delete"
+            {:entries (mapv (fn [[id property]] {:block-id (str id) :property-id property}) entries)}))
+
+(defn- state
+  "What a block holds of its type: the keyword, the display classes among its tags, lang, heading."
+  [conn id]
+  (let [e (d/entity @conn [:block/uuid id])]
+    {:type (:logseq.property.node/display-type e)
+     :classes (set (keep #(#{:logseq.class/Code-block :logseq.class/Math-block :logseq.class/Quote-block}
+                           (:db/ident %))
+                         (:block/tags e)))
+     :lang (:logseq.property.code/lang e)
+     :heading (:logseq.property/heading e)}))
+
+(defn- typed [type & [lang]]
+  {:type type :classes (if type #{(classes type)} #{}) :lang lang :heading nil})
+
+(def ^:private plain (typed nil))
+
+(defn- snapshot [conn]
+  {:max-tx (:max-tx @conn) :datoms (count (d/datoms @conn :eavt))})
+
+(defn- with-graph
+  "A page Display with `n` blocks made by the outliner, as the app makes them. `titles` gives the
+  first blocks' titles (the rest are \"placeholder\")."
+  [done n run & {:keys [titles]}]
+  (-> (p/let [conn (sqlite-export/create-conn)
+              [_ page-id] (outliner-page/create! conn "Display" {})
+              ids (vec (repeatedly n random-uuid))
+              _ (when (seq ids)
+                  (outliner-core/insert-blocks! conn (map-indexed (fn [i id]
+                                                                    {:block/uuid id
+                                                                     :block/title (get titles i "placeholder")})
+                                                                  ids)
+                                                (d/entity @conn [:block/uuid page-id])
+                                                {:sibling? false :keep-uuid? true :bottom? true}))
+              self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true
+                        :env #js {"TIMEZONE" "UTC"}}]
+        (run {:conn conn :self self :page-id page-id :ids ids}))
+      (p/catch #(is false (str "unexpected error: " % (some-> % .-stack))))
+      (p/finally done)))
+
+(defn- ok? [response label]
+  (is (= 200 (:status response)) (str label ": " (pr-str (:body response)))))
+
+(defn- refused? [response expected label]
+  (is (= 400 (:status response)) (str label ": " (pr-str (:body response))))
+  (is (= expected (get-in response [:body :error])) label))
+
+;; Before the fix every value was refused by the outliner's keyword check:
+;;   expected: (= 200 (:status response))  actual: 400
+;;   {:error "Node Display Type: \"code\" should be a Clojure keyword"}
+(deftest set-display-type-each-value-test
+  (async done
+    (let [cases [["code" :code type-ident] ["math" :math type-ident] ["quote" :quote type-ident]
+                 [":code" :code type-ident] [" Code " :code "Node Display Type"] [":MATH" :math "Node Display Type"]
+                 ["quote" :quote "Node Display Type"]]]
+      (with-graph done (count cases)
+        (fn [{:keys [conn self ids]}]
+          (p/doseq [[[value expected property] id] (map vector cases ids)]
+            (p/let [response (put! self id property value)
+                    got (request! self "GET" (str "/semantic/blocks/" id) nil)]
+              (ok? response (str (pr-str value) " by " property))
+              (is (= (typed expected) (state conn id))
+                  (str (pr-str value) " by " property ": the keyword and exactly its class tag"))
+              (is (= (name expected) (get-in got [:body :display-type])) (str (pr-str value) ": getBlock reports it"))
+              (is (not (contains? (:body got) :lang)) "no lang was set"))))))))
+
+;; Before the fix: {:error "Node Display Type: \"cod\" should be a Clojure keyword"}
+(deftest set-display-type-refuses-unknown-test
+  (async done
+    (with-graph done 2
+      (fn [{:keys [conn self ids]}]
+        (let [[a b] ids]
+          (p/do
+            (p/doseq [[value shown] [["cod" "cod"] ["" ""] [5 "5"] [":foo/bar" ":foo/bar"] ["codes" "codes"]
+                                     ["::code" "::code"] ["foo/code" "foo/code"] [true "true"] [["code"] "[\"code\"]"]
+                                     ;; A class named by UUID or db id is not a type name either.
+                                     [(str (:block/uuid (d/entity @conn :logseq.class/Code-block)))
+                                      (str (:block/uuid (d/entity @conn :logseq.class/Code-block)))]
+                                     [(:db/id (d/entity @conn :logseq.class/Code-block))
+                                      (str (:db/id (d/entity @conn :logseq.class/Code-block)))]
+                                     ["Code-block" "Code-block"] ["logseq.class/Code-block" "logseq.class/Code-block"]]]
+              (p/let [before (snapshot conn)
+                      single (put! self a type-ident value)
+                      batch (batch-set! self [[b type-ident "code"] [a type-ident value]])]
+                (refused? single (str "entry 0: display-type: " (pr-str shown) " is not one of code, math, quote")
+                          (str "set " (pr-str value)))
+                (refused? batch (str "entry 1: display-type: " (pr-str shown) " is not one of code, math, quote")
+                          (str "batch " (pr-str value)))
+                (is (= before (snapshot conn)) (str (pr-str value) ": nothing written"))
+                (is (= plain (state conn a)) (str (pr-str value) ": the block is unchanged"))))
+            (p/let [response (put! self a type-ident nil)]
+              (refused? response "entry 0: display-type: \"\" is not one of code, math, quote" "null"))))))))
+
+;; Before the fix: {:error "Annotation type: \"x\" should be a Clojure keyword"}
+;; (A user property can't be keyword-typed, so two built-in keyword properties stand in for any.)
+(deftest other-keyword-property-refuses-text-test
+  (async done
+    (with-graph done 1
+      (fn [{:keys [conn self ids]}]
+        (p/let [before (snapshot conn)
+                annotation (put! self (first ids) "logseq.property.pdf/hl-type" "x")
+                align (put! self (first ids) "Asset alignment" ":center")
+                batch (batch-set! self [[(first ids) type-ident "code"] [(first ids) "logseq.property.asset/align" "left"]])]
+          (refused? annotation "Annotation type: takes a keyword; only display-type can be set as text" "by ident")
+          (refused? align "Asset alignment: takes a keyword; only display-type can be set as text" "by title")
+          (refused? batch "entry 1: Asset alignment: takes a keyword; only display-type can be set as text" "batch")
+          (is (= before (snapshot conn))))))))
+
+;; Before the fix: {:error "Node Display Type: \"code\" should be a Clojure keyword"} (a page too).
+(deftest display-type-on-a-page-tag-or-property-refused-test
+  (async done
+    (with-graph done 1
+      (fn [{:keys [conn self page-id ids]}]
+        (let [task (str (:block/uuid (d/entity @conn :logseq.class/Task)))
+              status (str (:block/uuid (d/entity @conn :logseq.property/status)))]
+          (p/doseq [[target kind] [[page-id "a page"] [task "a tag"] [status "a property"]]]
+            (p/let [before (snapshot conn)
+                    single (put! self target type-ident "code")
+                    lang (put! self target lang-ident "python")
+                    batch (batch-set! self [[(first ids) type-ident "code"] [target type-ident "quote"]])]
+              (refused? single (str "entry 0: display-type applies to blocks, not " kind) (str "set on " kind))
+              (refused? lang (str "entry 0: lang applies to blocks, not " kind) (str "lang on " kind))
+              (refused? batch (str "entry 1: display-type applies to blocks, not " kind) (str "batch on " kind))
+              (is (= before (snapshot conn)) (str kind ": nothing written")))))))))
+
+;; Before the fix: code couldn't be set at all, and lang on a text block was stored:
+;;   expected: (= 400 (:status response))  actual: 200
+(deftest lang-needs-code-test
+  (async done
+    (with-graph done 6
+      (fn [{:keys [conn self ids]}]
+        (let [[code1 code2 text math quote code3] ids
+              forty (apply str (repeat 40 "a"))]
+          (p/let [_ (put! self code1 type-ident "code")
+                  _ (put! self code2 type-ident "code")
+                  _ (put! self code3 type-ident "code")
+                  _ (put! self math type-ident "math")
+                  _ (put! self quote type-ident "quote")
+                  mermaid (put! self code1 lang-ident "mermaid")
+                  python (put! self code2 lang-ident "Python")
+                  longest (put! self code3 lang-ident forty)
+                  got (request! self "GET" (str "/semantic/blocks/" code2) nil)]
+            (ok? mermaid "mermaid") (ok? python "Python") (ok? longest "40 characters")
+            (is (= (typed :code "mermaid") (state conn code1)))
+            (is (= (typed :code "Python") (state conn code2)) "case kept")
+            (is (= "Python" (get-in got [:body :lang])) "getBlock reports lang")
+            (is (= "code" (get-in got [:body :display-type])))
+            (p/doseq [[id label] [[text "text"] [math "math"] [quote "quote"]]]
+              (p/let [before (snapshot conn)
+                      single (put! self id lang-ident "python")
+                      batch (batch-set! self [[code1 lang-ident "sql"] [id lang-ident "python"]])]
+                (refused? single "entry 0: lang needs display-type code" (str "lang on " label))
+                (refused? batch "entry 1: lang needs display-type code" (str "batch lang on " label))
+                (is (= before (snapshot conn)) (str label ": nothing written"))))
+            (p/doseq [value ["" "py thon" " python" "python\n" (str forty "a") 5 nil ["python"] true]]
+              (p/let [before (snapshot conn)
+                      single (put! self code1 lang-ident value)
+                      batch (batch-set! self [[code1 lang-ident value]])]
+                (refused? single "entry 0: lang: must be 1 to 40 characters with no spaces" (pr-str value))
+                (refused? batch "entry 0: lang: must be 1 to 40 characters with no spaces" (str "batch " (pr-str value)))
+                (is (= before (snapshot conn)))))
+            (is (= (typed :code "mermaid") (state conn code1)) "refused values left lang as it was")
+            ;; Re-sending the stored lang, alone or in a batch with the type, is a no-op, not a refusal.
+            (p/let [again (put! self code1 lang-ident "mermaid")
+                    batch (batch-set! self [[code1 lang-ident "mermaid"] [code1 type-ident "code"]])]
+              (ok? again "lang re-sent") (ok? batch "lang and type re-sent")
+              (is (= (typed :code "mermaid") (state conn code1))))))))))
+
+;; Final state, in any entry order. Before the fix every entry naming display type was refused:
+;;   {:error "entry 1: Node Display Type: \"code\" should be a Clojure keyword"}
+(deftest batch-lang-and-type-judged-on-final-state-test
+  (async done
+    (with-graph done 4
+      (fn [{:keys [conn self ids]}]
+        (let [[a b c d] ids]
+          (p/let [lang-first (batch-set! self [[a lang-ident "python"] [a type-ident "code"]])
+                  _ (ok? lang-first "lang before type")
+                  _ (is (= (typed :code "python") (state conn a)))
+                  type-first (batch-set! self [[b type-ident "code"] [b lang-ident "sql"]])
+                  _ (ok? type-first "type before lang")
+                  _ (is (= (typed :code "sql") (state conn b)))
+                  ;; Swapped across two blocks: each lang is judged on its own block's final type.
+                  swapped (batch-set! self [[c lang-ident "clojure"] [d type-ident "code"]
+                                            [d lang-ident "bash"] [c type-ident "code"]])
+                  _ (ok? swapped "swapped across blocks")
+                  _ (is (= [(typed :code "clojure") (typed :code "bash")] [(state conn c) (state conn d)]))
+                  ;; A chain whose last type isn't code refuses the lang, whatever came between.
+                  before (snapshot conn)
+                  chain (batch-set! self [[a type-ident "math"] [a lang-ident "rust"] [a type-ident "code"]
+                                          [a type-ident "quote"]])
+                  _ (refused? chain "entry 1: lang needs display-type code" "chain ending in quote")
+                  _ (is (= before (snapshot conn)) "nothing written")
+                  _ (is (= (typed :code "python") (state conn a)))
+                  ;; Reversed: the chain ending in code accepts the lang given first.
+                  reversed (batch-set! self [[a type-ident "quote"] [a lang-ident "rust"] [a type-ident "code"]])
+                  _ (ok? reversed "chain ending in code")
+                  _ (is (= (typed :code "rust") (state conn a)))
+                  ;; Code with lang, then quote: lang is retracted, and the read-back sees none.
+                  to-quote (batch-set! self [[b type-ident "quote"]])]
+            (ok? to-quote "code with lang to quote")
+            (is (= (typed :quote) (state conn b)))))))))
+
+(deftest switch-code-to-quote-test
+  (async done
