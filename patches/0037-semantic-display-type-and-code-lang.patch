+;;   expected: (= (typed :quote) (state conn id))  actual: {:classes #{Code-block Quote-block} ...}
+(deftest held-class-tag-never-re-added-test
+  (async done
+    (with-graph done 1
+      (fn [{:keys [conn self ids]}]
+        (let [id (first ids)]
+          (p/let [_ (put! self id type-ident "code")
+                  single (batch-set! self [[id type-ident "quote"] [id "block/tags" "Code"]])
+                  _ (ok? single "quote, then the held Code")
+                  _ (is (= (typed :quote) (state conn id)))
+                  _ (put! self id type-ident "code")
+                  listed (batch-set! self [[id type-ident "math"] [id "block/tags" ["Code"]]] :reset? true)]
+            (ok? listed "math, then a reset list holding Code")
+            (is (= (typed :math) (state conn id)))))))))
