+;; The operations Claude's tools are generated from carry convert-fences, dry-run on the two single
+;; insert tools, converted and kept in the responses, and the outline's renderings. Before the fix:
+;;   expected: (contains? (params ...) "convert-fences")  actual: false
+(deftest openapi-fence-fields-test
+  (let [document (semantic-routes/openapi-document "https://issuer.example")
+        schemas (get-in document [:components :schemas])
+        tree "/api/v1/graphs/{graph-id}/block-trees"
+        children "/api/v1/graphs/{graph-id}/blocks/{block-id}/children"
+        batch "/api/v1/graphs/{graph-id}/block-trees/batch"
+        capture "/api/v1/graphs/{graph-id}/capture"
+        block "/api/v1/graphs/{graph-id}/blocks/{block-id}"
+        operation (fn [path method] (get-in document [:paths path method]))]
+    (doseq [[path method] [[tree :post] [children :post] [batch :post] [capture :post] [block :patch]]]
+      (is (some #(= {:name "convert-fences" :in "query" :type "boolean" :default true}
+                    {:name (:name %) :in (:in %) :type (get-in % [:schema :type]) :default (get-in % [:schema :default])})
+                (:parameters (operation path method)))
+          (str path ": convert-fences"))
+      (is (string/includes? (:description (operation path method)) "query fences stay text") (str path ": description")))
+    (doseq [path [tree children]]
+      (is (= "boolean" (get-in (operation path :post) [:requestBody :content "application/json" :schema :properties :dry-run :type]))
+          (str path ": dry-run")))
+    (is (= "string" (get-in schemas [:InsertedBlock :properties :converted :type])))
+    (is (= ["code" "math" "quote"] (get-in schemas [:InsertedBlock :properties :display-type :enum])))
+    (doseq [schema [(get-in schemas [:InsertedBlocksResponse :properties])
+                    (get-in schemas [:BatchInsertResponse :properties])
+                    (get-in schemas [:UpdatedBlockResponse :allOf 1 :properties])]]
+      (is (= "#/components/schemas/KeptFences" (get-in schema [:kept :$ref]))))
+    (is (= ["path" "reason"] (get-in schemas [:KeptFences :items :required])))
+    (is (string/includes? (:description (operation "/api/v1/graphs/{graph-id}/pages/{page-id}/outline" :get))
