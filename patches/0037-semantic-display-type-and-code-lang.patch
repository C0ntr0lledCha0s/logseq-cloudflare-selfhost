+;; A display-type entry changes the block's class tag, so a batch's class check sees it as it sees a
+;; tag entry: a property limited to Code takes a block the same batch makes code, and refuses one the
+;; same batch makes math, in either entry order, on batch_set_block_property and on batch insert
+;; entry properties. Before the fix the class check judged the block by its tags before the batch:
+;;   math: expected: (= 400 (:status response))  actual: 200 {:updated 2}, and P held a Math block
+;;   code: expected: (= 200 (:status response))  actual: 400 {:error "entry 1: no #Code object <uuid>"}
+(deftest batch-display-type-seen-by-class-check-test
+  (async done
+    (with-graph done 9
+      (fn [{:keys [conn self ids]}]
+        (let [[holder & blocks] ids
+              [to-math-1 to-math-2 to-math-3 to-math-4 to-code-1 to-code-2 to-code-3 to-code-4] blocks]
+          (p/let [class (d/entity @conn :logseq.class/Code-block)
+                  property (outliner-property/upsert-property!
+                            conn nil {:logseq.property/type :node :db/cardinality :db.cardinality/one}
+                            {:property-name "about-code"})
+                  p-id (subs (str (:db/ident property)) 1)
+                  limited (request! self "PATCH" (str "/semantic/properties/" (js/encodeURIComponent p-id))
+                                    {:classes {:set [(str (:block/uuid class))]}})
+                  _ (ok? limited "about-code is limited to Code")
+                  _ (batch-set! self (mapv (fn [id] [id type-ident "code"]) [to-math-1 to-math-2 to-math-3 to-math-4]))
+                  value-of (fn [] (:block/uuid (get (d/entity @conn [:block/uuid holder]) (:db/ident property))))
+                  set-entries (fn [id type reversed?]
+                                (cond-> [[id type-ident type] [holder p-id (str id)]] reversed? (-> reverse vec)))
+                  insert-entries (fn [id type reversed?]
+                                   (cond-> [{:target-id (str id) :properties {type-ident type}}
+                                            {:target-id (str holder) :properties {p-id (str id)}}]
+                                     reversed? (-> reverse vec)))]
+            (p/doseq [[label send id reversed? index] [["batch set" batch-set! to-math-1 false 1]
+                                                       ["batch set, reversed" batch-set! to-math-2 true 0]
+                                                       ["batch insert" batch-insert! to-math-3 false 1]
+                                                       ["batch insert, reversed" batch-insert! to-math-4 true 0]]]
