+;; A ```query fence is not converted (a Query block needs a query entity), and the call lists it
+;; under kept with its path, in request order. Before the fix: no kept key.
+(deftest query-fence-kept-test
+  (async done
+    (with-graph done 1
+      (fn [{:keys [conn self page-id ids]}]
+        (let [kept (fn [& paths] (mapv #(hash-map :path % :reason kept-reason) paths))]
+          (p/let [single-id (random-uuid)
+                  single (insert-tree! self page-id [{:uuid (str single-id) :title query-fence}])
+                  nested (insert-tree! self page-id [{:title "a" :children [{:title "b"} {:title query-fence}]}])
+                  child (insert-children! self (first ids) [{:title python-fence} {:title query-fence}])
+                  captured (capture! self [{:title query-fence}])
+                  update-id (placeholder! self page-id)
+                  updated (update! self update-id {:title query-fence})]
+            (created? single "single")
+            (is (= (kept "blocks[0]") (get-in single [:body :kept])) "insert_block_tree")
+            (is (= (as-text query-fence) (held conn single-id)) "stored as text")
+            (is (not (contains? (get-in single [:body :blocks 0]) :converted)))
+            (is (= (kept "blocks[0].children[1]") (get-in nested [:body :kept])) "nested")
+            (is (= (kept "blocks[1]") (get-in child [:body :kept])) "insert_block_children: the converted sibling isn't kept")
+            (is (= "fence" (get-in child [:body :blocks 0 :converted])))
+            (is (= (kept "blocks[0]") (get-in captured [:body :kept])) "capture_to_today")
+            (ok? updated "update")
+            (is (= (kept "title") (get-in updated [:body :kept])) "update_block")
+            (is (= (as-text query-fence) (held conn update-id)))
+            (p/doseq [reversed? [false true]]
+              (p/let [entries [{:target-id (str page-id) :blocks [{:title "plain"}]}
+                               {:target-id (str page-id) :blocks [{:title query-fence}]}
+                               {:target-id (str page-id) :blocks [{:title python-fence}]}
+                               {:target-id (str page-id) :blocks [{:title "p" :children [{:title "a"} {:title "b"} {:title query-fence}]}]}]
+                      response (batch-insert! self (cond-> entries reversed? (-> reverse vec)))]
+                (created? response (str "batch, reversed " reversed?))
+                (is (= (if reversed?
+                         (kept "entries[0].blocks[0].children[2]" "entries[2].blocks[0]")
+                         (kept "entries[1].blocks[0]" "entries[3].blocks[0].children[2]"))
+                       (get-in response [:body :kept]))
+                    (str "batch, reversed " reversed? ": each kept fence by its path, in request order"))))))))))
