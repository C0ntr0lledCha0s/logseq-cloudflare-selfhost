+;; Before the fix (properties): {:error "blocks[0]: logseq.property.node/display-type: \"code\" should be
+;; a Clojure keyword"}; (fields) stored as text with heading 1, as above.
+(deftest tree-paths-take-display-type-test
+  (async done
