+;; An explicit display-type (or lang) that disagrees with the fence is refused naming the node, on
+;; insert and update; agreeing values, and values the fence leaves open, are accepted.
+;; Before the fix the fence was ignored, so every case was written:
+;;   expected: (= 400 (:status top))  actual: 201
+(deftest fence-with-explicit-type-test
+  (async done
+    (with-graph done 0
+      (fn [{:keys [conn self page-id]}]
+        (let [math-fence "$$E=mc^2$$"
+              refusals [[python-fence {:display-type "quote"} "fence is code but display-type is \"quote\""]
+                        [python-fence {:display-type "math"} "fence is code but display-type is \"math\""]
+                        [math-fence {:display-type "code"} "fence is math but display-type is \"code\""]
+                        [python-fence {:properties {"Node Display Type" "quote"}} "fence is code but display-type is \"quote\""]
+                        [python-fence {:display-type "code" :lang "sql"} "fence's lang is \"python\" but lang is \"sql\""]
+                        [math-fence {:lang "python"} "lang needs display-type code"]]
+              accepted [[python-fence {:display-type "code"} (as-typed :code "print(1)" "python")]
+                        [python-fence {:display-type " Code " :lang "python"} (as-typed :code "print(1)" "python")]
+                        [python-fence {:lang "python"} (as-typed :code "print(1)" "python")]
+                        ["```\nprint(1)\n```" {:lang "sql"} (as-typed :code "print(1)" "sql")]
+                        [math-fence {:display-type "math"} (as-typed :math "E=mc^2")]
+                        [python-fence {:properties {"Node Display Type" ":code"}} (as-typed :code "print(1)" "python")]]]
+          (p/do
+            (p/doseq [[title fields reason] refusals]
+              (p/let [update-id (placeholder! self page-id)
+                      before (snapshot conn)
+                      top (insert-tree! self page-id [(merge {:title title} fields)])
+                      nested (insert-tree! self page-id [{:title "ok" :children [{:title "a"} (merge {:title title} fields)]}])
+                      batch (batch-insert! self [{:target-id (str page-id) :blocks [{:title "ok"}]}
+                                                 {:target-id (str page-id) :blocks [(merge {:title title} fields)]}])
+                      batch-first (batch-insert! self [{:target-id (str page-id) :blocks [(merge {:title title} fields)]}
+                                                       {:target-id (str page-id) :blocks [{:title "ok"}]}])
+                      updated (when-not (:properties fields) (update! self update-id (merge {:title title} fields)))
+                      label (str (pr-str title) " " (pr-str fields))]
+                (refused? top (str "blocks[0]: " reason) label)
+                (refused? nested (str "blocks[0].children[1]: " reason) (str "nested " label))
+                (refused? batch (str "entries[1].blocks[0]: " reason) (str "batch " label))
+                (refused? batch-first (str "entries[0].blocks[0]: " reason) (str "batch, refused entry first, " label))
+                (when updated (refused? updated reason (str "update " label)))
+                (is (= before (snapshot conn)) (str label ": nothing written"))))
+            (p/doseq [[title fields expected] accepted]
+              (p/let [id (random-uuid)
+                      inserted (insert-tree! self page-id [(merge {:uuid (str id) :title title} fields)])
+                      update-id (placeholder! self page-id)
+                      updated (when-not (:properties fields) (update! self update-id (merge {:title title} fields)))
+                      label (str (pr-str title) " " (pr-str fields))]
+                (created? inserted label)
+                (is (= expected (held conn id)) label)
+                (when updated
+                  (ok? updated (str "update " label))
+                  (is (= expected (held conn update-id)) (str "update " label)))))
+            ;; A block that already has a type is never converted, as the app's parse-block skips
+            ;; extraction for one: a fence or $$ in a code, math or quote block is its content, kept
+            ;; verbatim with the stored type and lang. Before the fix: a markdown code block lost its
+            ;; outer fence and took lang js, and a latex code block became math.
+            (p/let [typed (fn [type lang]
+                            (p/let [id (placeholder! self page-id)
+                                    _ (batch-set! self (cond-> [[id type-ident type]] lang (conj [id lang-ident lang])))]
+                              id))
+                    js-fence "```js\nconsole.log(1)\n```"
+                    mermaid-fence "```mermaid\ngraph TD\n  A-->B\n```"
+                    cases [["code markdown, a ```js fence" "code" "markdown" js-fence {} :code]
+                           ["code markdown, a ```mermaid fence" "code" "markdown" mermaid-fence {} :code]
+                           ["code c, a bare fence" "code" "c" "```\nprint(1)\n```" {} :code]
+                           ["code latex, $$" "code" "latex" "$$x^2$$" {} :code]
+                           ["code, no lang, a ```python fence" "code" nil python-fence {} :code]
+                           ["math, $$" "math" nil "$$x^2$$" {} :math]
+                           ["math, a ```python fence" "math" nil python-fence {} :math]
+                           ["quote, a ```python fence" "quote" nil python-fence {} :quote]
+                           ["quote, $$" "quote" nil "$$x^2$$" {} :quote]
+                           ["code markdown, convert-fences=true" "code" "markdown" js-fence {:query "?convert-fences=true"} :code]
+                           ["code markdown, display-type code given" "code" "markdown" js-fence {:body {:display-type "code"}} :code]
+                           ["quote, display-type code given" "quote" nil python-fence {:body {:display-type "code"}} :code]]]
+              (p/doseq [[label type lang title {:keys [query body]} expected-type] cases]
+                (p/let [id (typed type lang)
+                        response (update! self id (merge {:title title} body) :query query)]
+                  (ok? response label)
+                  (is (not (contains? (:body response) :converted)) (str label ": not converted"))
+                  (is (= (as-typed expected-type title (when (= :code expected-type) lang)) (held conn id)) label))))))))))
+
+;; E2EE titles are ciphertext: never parsed, converted or kept; explicit fields still apply. A real
+;; package can't look like a fence, so the second half STUBS THE PACKAGE CHECK (labelled): plaintext
+;; fences reach the handler on an E2EE graph, and the E2EE guard alone must keep them as text.
+(defn- <encrypt [key value]
+  (p/let [iv (js/crypto.getRandomValues (js/Uint8Array. 12))
+          payload (.encrypt js/crypto.subtle #js {:name "AES-GCM" :iv iv} key
+                            (.encode (js/TextEncoder.) (ldb/write-transit-str value)))]
+    (ldb/write-transit-str [iv (js/Uint8Array. payload)])))
+
+(deftest e2ee-titles-never-parsed-test
+  (async done
+    (with-graph done 0
+      (fn [{:keys [conn self page-id]}]
+        (p/let [key (.generateKey js/crypto.subtle #js {:name "AES-GCM" :length 256} true #js ["encrypt" "decrypt"])
+                fence (<encrypt key python-fence)
+                query (<encrypt key query-fence)
+                x (<encrypt key "x")
+                [a b c] (repeatedly 3 random-uuid)
+                inserted (insert-tree! self page-id [{:uuid (str a) :title fence}
+                                                     {:uuid (str b) :title query}
+                                                     {:uuid (str c) :title x :display-type "code" :lang "python"}]
+                                       :query "?graph-e2ee=true")
+                update-id (placeholder! self page-id)
+                updated (update! self update-id {:title fence} :query "?graph-e2ee=true")]
+          (created? inserted "e2ee insert")
+          (ok? updated "e2ee update")
+          (is (= (as-text fence) (held conn a)) "a package is stored as sent")
+          (is (= (as-text query) (held conn b)))
+          (is (= (as-typed :code x "python") (held conn c)) "explicit fields still apply")
+          (is (= (as-text fence) (held conn update-id)))
+          (is (not (contains? (:body inserted) :kept)) "nothing listed under kept")
+          (is (not-any? :converted (get-in inserted [:body :blocks])))
+          ;; STUB: every title passes as a package, so the fences below are plaintext on an E2EE graph.
+          (p/with-redefs [e2ee-handler/encrypted-package? (constantly true)]
+            (p/let [[d e] (repeatedly 2 random-uuid)
+                    tree (insert-tree! self page-id [{:uuid (str d) :title python-fence} {:uuid (str e) :title query-fence}]
+                                       :query "?graph-e2ee=true")
+                    batch-id (random-uuid)
+                    batch (batch-insert! self [{:target-id (str page-id) :blocks [{:uuid (str batch-id) :title python-fence}]}]
+                                         :query "?graph-e2ee=true")
+                    stub-update (update! self update-id {:title python-fence} :query "?graph-e2ee=true")]
+              (doseq [[label response] [["insert" tree] ["batch" batch] ["update" stub-update]]]
+                (written? response (str "stubbed " label))
+                (is (not (contains? (:body response) :kept)) (str "stubbed " label ": nothing kept")))
+              (is (= (as-text python-fence) (held conn d)) "insert: an E2EE title is never converted")
+              (is (= (as-text query-fence) (held conn e)))
+              (is (= (as-text python-fence) (held conn batch-id)) "batch: never converted")
+              (is (= (as-text python-fence) (held conn update-id)) "update: never converted"))))))))
