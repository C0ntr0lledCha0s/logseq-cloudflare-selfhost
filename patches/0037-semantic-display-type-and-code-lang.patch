+;; STUBS A STEP (labelled): set-display-type! is redefined to add the class tag but skip the
+;; keyword, so the read-back sees a write that didn't store what was asked.
+(deftest read-back-mismatch-rejects-test
+  (async done
+    (with-graph done 2
+      (fn [{:keys [conn self ids]}]
+        (let [[a b] ids
+              before (snapshot conn)]
+          (p/let [[single batch]
+                  (p/with-redefs [semantic/set-display-type!
+                                  (fn [conn block-id _type]
+                                    (outliner-property/set-block-property! conn block-id :block/tags
+                                                                           :logseq.class/Code-block))]
+                    (p/let [single (put! self a type-ident "code")
+                            batch (batch-set! self [[a lang-ident "python"] [a type-ident "code"]])]
+                      [single batch]))]
+            (is (= 500 (:status single)) (pr-str single))
+            (is (= "the write did not store what was asked: entry 0: display-type is not code" (get-in single [:body :error])))
+            (is (= 500 (:status batch)) (pr-str batch))
+            (is (= "the write did not store what was asked: entry 1: display-type is not code" (get-in batch [:body :error])))
+            (is (= before (snapshot conn)) "nothing committed")
+            (is (= [plain plain] [(state conn a) (state conn b)]))))))))
