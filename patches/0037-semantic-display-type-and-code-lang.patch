+                  other-id (get-in other [:body :uuid])]
+            (p/doseq [[type id] (map vector [:code :math :quote] typed-ids)]
+              (p/let [class (d/entity @conn (classes type))
+                      title (str "Typed " (name type))
+                      _ (outliner-core/save-block! conn {:block/uuid id :block/title title})
+                      _ (put! self id type-ident (name type))
+                      property (outliner-property/upsert-property!
+                                conn nil {:logseq.property/type :node :db/cardinality :db.cardinality/one}
+                                {:property-name (str "about-" (name type))})
+                      property-id (subs (str (:db/ident property)) 1)
+                      limited (request! self "PATCH" (str "/semantic/properties/" (js/encodeURIComponent property-id))
+                                        {:classes {:set [(str (:block/uuid class))]}})]
+                (ok? limited (str property-id " is limited to " (:block/title class)))
+                (p/doseq [[label value tag-first?] [["UUID, tag entry first" (str id) true]
+                                                    ["UUID, value entry first" (str id) false]
+                                                    ["title, tag entry first" title true]
+                                                    ["title, value entry first" title false]]]
+                  (p/let [_ (outliner-property/remove-block-property! conn [:block/uuid holder] (:db/ident property))
+                          held (put! self id "block/tags" [other-id])
+                          _ (ok? held (str label ": the block holds Other"))
+                          entries [[id "block/tags" [example-id]] [holder property-id value]]
+                          response (batch-set! self (if tag-first? entries (vec (reverse entries))) :reset? true)
+                          label (str (name type) ", " label)]
+                    (ok? response label)
+                    (is (= id (:block/uuid (get (d/entity @conn [:block/uuid holder]) (:db/ident property))))
+                        (str label ": the value reads back"))
+                    (is (= (typed type) (state conn id)) (str label ": the block keeps its type and class"))
+                    (is (= #{(:block/title class) "Example"}
+                           (set (map :block/title (:block/tags (d/entity @conn [:block/uuid id])))))
+                        (str label ": the reset list replaced Other and kept the class"))))))))))))
