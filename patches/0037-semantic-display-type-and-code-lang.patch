+;; ---------------------------------------------------------------------------------------------
+;; Stage 2: the tree and update paths. insert_block_tree, insert_block_children,
+;; batch_insert_block_trees, capture_to_today and update_block take display-type and lang as fields
+;; and inside a node's properties (the same value twice is accepted, different values are refused
+;; naming the path). Code and math titles are stored exactly as sent: no heading, no # escaping, no
+;; [[ref]] or #tag resolution. Quote titles skip only the heading step.
+
+(def ^:private verbatim "# comment\n#include <stdio.h>\n[[Example]]")
+
+(defn- stored
+  "A block's title and type state, its ref and tag titles, and whether a page Example exists."
+  [conn id]
+  (let [e (d/entity @conn [:block/uuid id])]
+    (assoc (state conn id)
+           :title (:block/title e)
+           :refs (set (map :block/title (:block/refs e)))
+           :tags (set (map :block/title (:block/tags e)))
+           :example-page? (boolean (seq (d/q '[:find ?e :where [?e :block/name "example"]] @conn))))))
+
+(defn- verbatim-code [title & [lang]]
+  (assoc (typed :code lang) :title title :refs #{} :tags #{"Code"} :example-page? false))
+
+(defn- insert-tree! [self target blocks & {:keys [query extra]}]
+  (request! self "POST" (str "/semantic/block-trees" query) (merge {:target-id (str target) :blocks blocks} extra)))
+
+(defn- insert-children! [self target blocks & {:keys [query extra]}]
+  (request! self "POST" (str "/semantic/blocks/" target "/children" query) (merge {:position "append" :blocks blocks} extra)))
+
+(defn- batch-insert! [self entries & {:keys [query extra]}]
+  (request! self "POST" (str "/semantic/block-trees/batch" query) (merge {:entries entries} extra)))
+
+(defn- capture! [self blocks & {:keys [query]}]
+  (request! self "POST" (str "/semantic/capture" query) {:blocks blocks}))
+
+(defn- update! [self id body & {:keys [query]}]
+  (request! self "PATCH" (str "/semantic/blocks/" id query) body))
+
+(defn- created? [response label]
+  (is (= 201 (:status response)) (str label ": " (pr-str (:body response)))))
+
+;; Before the fix the fields were ignored: the block was stored as text, heading-stripped and escaped:
+;;   expected: (= (verbatim-code verbatim "python") (stored conn id))
+;;   actual: {:type nil :classes #{} :lang nil :heading 1 :title "comment\n\\#include <stdio.h>\n[[<uuid>]]"
+;;            :refs #{"Example"} :example-page? true ...}
+(deftest insert-tree-code-verbatim-test
