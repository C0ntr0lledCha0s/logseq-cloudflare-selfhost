+(ns logseq.db-sync.semantic-display-type-test
+  "Code, math and quote blocks through the property paths (patch 0037, stage 1). The block type
+  lives in :logseq.property.node/display-type, a keyword property, and JSON can't carry a keyword,
+  so set_block_property and batch_set_block_property refused every value with `should be a Clojure
+  keyword`. They now take \"code\", \"math\" and \"quote\" (also \":code\", trimmed, any case) and
+  write them as the app's client pipeline does: the keyword, the matching class tag (Code-block,
+  Math-block, Quote-block) and none of the other two, lang only on code, and no heading. lang
+  (:logseq.property.code/lang) is 1 to 40 characters with no spaces and needs a final type of code.
+  Both apply to blocks only. The three classes can't be written as tags (one way in, so tag and
+  type can't drift), a held one is a no-op, and a reset tag list keeps it. Deleting the type removes
+  its tag and lang. Every write reads back inside its transaction. Reads report both fields."
+  (:require [cljs.test :refer [async deftest is testing]]
+            [clojure.string :as string]
+            [datascript.core :as d]
+            [logseq.db :as ldb]
+            [logseq.db-sync.test-sql :as test-sql]
+            [logseq.db-sync.worker.handler.e2ee :as e2ee-handler]
+            [logseq.db-sync.worker.handler.semantic :as semantic]
+            [logseq.db-sync.worker.handler.sync :as sync-handler]
+            [logseq.db-sync.worker.routes.semantic :as semantic-routes]
+            [logseq.db.sqlite.export :as sqlite-export]
+            [logseq.outliner.core :as outliner-core]
+            [logseq.outliner.page :as outliner-page]
+            [logseq.outliner.property :as outliner-property]
+            [promesa.core :as p]))
+
+(def ^:private actor
+  (js/encodeURIComponent
+   (js/JSON.stringify #js {"sub" "6f2c1a90-5b1e-4c7a-9d3e-2a1b0c9d8e7f"
+                           "cognito:username" "Owner" "email" "owner@example.com"})))
+
+(def ^:private stamped [["x-logseq-sync-actor" actor] ["x-logseq-edit-stamp" "claude"]])
+
+(defn- request!
+  "One semantic API request through the real handler; returns {:status :body}."
+  [self method path body & {:keys [headers]}]
+  (p/let [url (str "http://localhost" path (if (string/includes? path "?") "&" "?") "graph-id=graph-1")
+          js-headers (js/Headers. #js {"content-type" "application/json"})
+          _ (doseq [[k v] headers] (.append js-headers k v))
+          response (sync-handler/handle-http
+                    self
+                    (js/Request. url (clj->js (cond-> {:method method :headers js-headers}
+                                                body (assoc :body (js/JSON.stringify (clj->js body)))))))
+          text (.text response)]
+    {:status (.-status response)
+     :body (when (seq text)
+             (try (js->clj (js/JSON.parse text) :keywordize-keys true)
+                  (catch :default _ text)))}))
+
+(def ^:private type-ident "logseq.property.node/display-type")
+(def ^:private lang-ident "logseq.property.code/lang")
+(def ^:private classes
+  {:code :logseq.class/Code-block :math :logseq.class/Math-block :quote :logseq.class/Quote-block})
+
+(defn- put! [self id property value & opts]
+  (apply request! self "PUT" (str "/semantic/blocks/" id "/properties/" (js/encodeURIComponent property))
+         {:value value} opts))
+
+(defn- delete! [self id property]
+  (request! self "DELETE" (str "/semantic/blocks/" id "/properties/" (js/encodeURIComponent property)) nil))
+
+(defn- batch-set! [self entries & {:keys [reset? headers]}]
+  (request! self "POST" "/semantic/block-properties/batch-set"
+            (cond-> {:entries (mapv (fn [[id property value]]
+                                      {:block-id (str id) :property-id property :value value})
+                                    entries)}
+              reset? (assoc :isResetExistingValues true))
+            :headers headers))
+
+(defn- batch-delete! [self entries]
+  (request! self "POST" "/semantic/block-properties/batch-delete"
+            {:entries (mapv (fn [[id property]] {:block-id (str id) :property-id property}) entries)}))
+
+(defn- state
+  "What a block holds of its type: the keyword, the display classes among its tags, lang, heading."
+  [conn id]
+  (let [e (d/entity @conn [:block/uuid id])]
+    {:type (:logseq.property.node/display-type e)
+     :classes (set (keep #(#{:logseq.class/Code-block :logseq.class/Math-block :logseq.class/Quote-block}
+                           (:db/ident %))
+                         (:block/tags e)))
+     :lang (:logseq.property.code/lang e)
+     :heading (:logseq.property/heading e)}))
+
+(defn- typed [type & [lang]]
+  {:type type :classes (if type #{(classes type)} #{}) :lang lang :heading nil})
+
+(def ^:private plain (typed nil))
+
+(defn- snapshot [conn]
+  {:max-tx (:max-tx @conn) :datoms (count (d/datoms @conn :eavt))})
+
+(defn- with-graph
+  "A page Display with `n` blocks made by the outliner, as the app makes them. `titles` gives the
+  first blocks' titles (the rest are \"placeholder\")."
+  [done n run & {:keys [titles]}]
+  (-> (p/let [conn (sqlite-export/create-conn)
+              [_ page-id] (outliner-page/create! conn "Display" {})
+              ids (vec (repeatedly n random-uuid))
+              _ (when (seq ids)
+                  (outliner-core/insert-blocks! conn (map-indexed (fn [i id]
+                                                                    {:block/uuid id
+                                                                     :block/title (get titles i "placeholder")})
+                                                                  ids)
+                                                (d/entity @conn [:block/uuid page-id])
+                                                {:sibling? false :keep-uuid? true :bottom? true}))
+              self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true
+                        :env #js {"TIMEZONE" "UTC"}}]
+        (run {:conn conn :self self :page-id page-id :ids ids}))
+      (p/catch #(is false (str "unexpected error: " % (some-> % .-stack))))
+      (p/finally done)))
