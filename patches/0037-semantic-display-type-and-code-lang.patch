+;; ---------------------------------------------------------------------------------------------
+;; Stage 3: fences. A block whose whole title is one ``` or $$ fence becomes a code or math block on
+;; insert_block_tree, insert_block_children, batch_insert_block_trees, capture_to_today and
+;; update_block, as the app's standalone-display-block does: the trimmed title must start and end
+;; with the fence, and mldoc must read it as exactly one Src or Displayed_Math node. convert-fences
+;; =false keeps the text. A ```query fence stays text and is listed under kept. An explicit type
+;; that disagrees with the fence is refused. E2EE titles are never parsed. The two single insert
+;; tools take dry-run. get_page_outline renders the three types.
+
+(def ^:private python-fence "```python\nprint(1)\n```")
+(def ^:private query-fence "```query\n(task todo)\n```")
+(def ^:private kept-reason "query fences stay text; a Query block is not supported yet")
+
+(def ^:private fields [:type :classes :lang :title :heading])
+
+(defn- as-text [title] {:type nil :classes #{} :lang nil :title title :heading nil})
+
+(defn- as-typed [type title & [lang]]
+  {:type type :classes #{(classes type)} :lang lang :title title :heading nil})
+
+(defn- held [conn id] (select-keys (stored conn id) fields))
+
+(def ^:private converting-fences
+  [["```mermaid" "```mermaid\ngraph TD\n  A-->B\n```" :code "graph TD\n  A-->B" "mermaid"]
+   ["bare ```" "```\nprint(1)\n```" :code "print(1)" nil]
+   ["$$" "$$E=mc^2$$" :math "E=mc^2" nil]
+   ["leading spaces and a trailing newline" "   ```python\nprint(1)\n```\n" :code "print(1)" "python"]
+   ["```Python" "```Python\nprint(1)\n```" :code "print(1)" "Python"]
+   ["a # line, #include and [[Example]]" "```c\n# comment\n#include <stdio.h>\n[[Example]]\n```"
+    :code "# comment\n#include <stdio.h>\n[[Example]]" "c"]])
+
+(defn- placeholder!
+  "A new text block on the page, made through insert_block_tree; its UUID."
+  [self page-id]
+  (p/let [response (insert-tree! self page-id [{:title "placeholder"}])]
+    (uuid (get-in response [:body :blocks 0 :uuid]))))
+
+(defn- written?
+  [response label]
+  (is (contains? #{200 201} (:status response)) (str label ": " (pr-str (:body response)))))
+
+;; Before the fix every fence was stored as text:
+;;   expected: (= (as-typed :code "graph TD\n  A-->B" "mermaid") (held conn id))
+;;   actual: {:type nil :classes #{} :lang nil :title "```mermaid\ngraph TD\n  A-->B\n```" ...}
+(deftest fence-converts-on-each-operation-test
+  (async done
+    (with-graph done 1
+      (fn [{:keys [conn self page-id ids]}]
+        (let [parent (first ids)]
+          (p/doseq [[label title type inner lang] converting-fences]
+            (p/let [[tree-id child-id capture-id batch-id] (repeatedly 4 random-uuid)
+                    tree (insert-tree! self page-id [{:uuid (str tree-id) :title title}])
+                    child (insert-children! self parent [{:uuid (str child-id) :title title}])
+                    captured (capture! self [{:uuid (str capture-id) :title title}])
+                    batch (batch-insert! self [{:target-id (str page-id) :blocks [{:uuid (str batch-id) :title title}]}])
+                    update-id (placeholder! self page-id)
+                    updated (update! self update-id {:title title})]
+              (doseq [[op response id block] [["insert_block_tree" tree tree-id (get-in tree [:body :blocks 0])]
+                                              ["insert_block_children" child child-id (get-in child [:body :blocks 0])]
+                                              ["capture_to_today" captured capture-id (get-in captured [:body :blocks 0])]
+                                              ["batch_insert_block_trees" batch batch-id (get-in batch [:body :entries 0 :blocks 0])]
+                                              ["update_block" updated update-id (:body updated)]]
+                      :let [label (str label ", " op)]]
+                (written? response label)
+                (is (= (as-typed type inner lang) (held conn id)) label)
+                (is (false? (:example-page? (stored conn id))) (str label ": no page made from the code"))
+                (is (= #{} (:refs (stored conn id))) (str label ": no refs"))
+                (is (= ["fence" (name type) lang inner] ((juxt :converted :display-type :lang :title) block))
+                    (str label ": the response marks it converted and reports the type"))
+                (is (not (contains? (:body response) :kept)) (str label ": nothing kept"))))))))))
+
+(def ^:private text-fences
+  [["text before" "Intro\n```python\nprint(1)\n```"]
+   ["text after" "```python\nprint(1)\n```\nAfter"]
+   ["two fences" "```\na\n```\n```\nb\n```"]
+   ["unclosed" "```python\nprint(1)"]
+   ["four backticks" "````\nprint(1)\n````"]
+   ["a ``` inside the body" "```\nprint(1)\n```\n```"]
+   ["$x$" "$x$"]
+   ["$$ then text" "$$E=mc^2$$ and more"]
+   ["two $$" "$$a$$ and $$b$$"]
+   ["a quote line" "> quoted"]
+   ["inline code" "`print(1)`"]])
+
+;; Whole-block only: anything else stays text, on insert and on update. Before the fix these already
