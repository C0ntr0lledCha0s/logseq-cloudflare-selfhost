+                  no-op (delete! self plain-id type-ident)
+                  got (request! self "GET" (str "/semantic/blocks/" a) nil)]
+            (ok? single "delete") (ok? batch "batch delete") (ok? no-op "delete on a plain block")
+            (is (= [plain plain plain plain] (mapv #(state conn %) [a b c plain-id]))
+                "type, class tag and lang removed")
+            (is (not (contains? (:body got) :display-type)))))))))
