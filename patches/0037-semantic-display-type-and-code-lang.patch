+;; Before the fix code couldn't be set, so there was no warning:
+;;   expected: (= [...] (get-in response [:body :warnings]))  actual: nil
+(deftest escape-warning-test
+  (async done
+    (with-graph done 3
+      (fn [{:keys [conn self ids]}]
+        (let [[escaped clean escaped-quote] ids
+              title "\\#include <stdio.h>"
+              warning "title holds \\# escapes from earlier writes; to store it verbatim, call update_block with the title and display-type together"]
+          (d/transact! conn [{:block/uuid escaped :block/title title}
+                             {:block/uuid escaped-quote :block/title title}])
+          (p/let [response (put! self escaped type-ident "code")
+                  _ (is (= [warning] (get-in response [:body :warnings])))
+                  _ (is (= title (:block/title (d/entity @conn [:block/uuid escaped]))) "the title is unchanged")
+                  again (put! self escaped type-ident "math")
+                  quote (put! self escaped-quote type-ident "quote")
+                  plain-response (put! self clean type-ident "code")
+                  batch (batch-set! self [[escaped-quote type-ident "math"]])]
+            (ok? response "converted")
+            (is (not (contains? (:body again) :warnings)) "code to math isn't a conversion from text")
+            (is (not (contains? (:body quote) :warnings)) "quote keeps tag handling")
+            (is (not (contains? (:body plain-response) :warnings)) "no escapes, no warning")
+            (is (= [(str "entry 0: " warning)] (get-in batch [:body :warnings])) "batch names the entry")))))))
