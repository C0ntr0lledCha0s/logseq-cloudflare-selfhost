+(defn- ok? [response label]
+  (is (= 200 (:status response)) (str label ": " (pr-str (:body response)))))
+
+(defn- refused? [response expected label]
+  (is (= 400 (:status response)) (str label ": " (pr-str (:body response))))
+  (is (= expected (get-in response [:body :error])) label))
