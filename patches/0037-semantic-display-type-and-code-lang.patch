+      (fn [{:keys [conn self page-id]}]
+        (let [id (random-uuid)]
+          (p/let [response (insert-tree! self page-id [{:uuid (str id) :title verbatim
+                                                        :display-type "code" :lang "python"}])]
+            (created? response "insert")
+            (is (= (verbatim-code verbatim "python") (stored conn id))
+                "stored :code with lang python and the Code tag, the title byte-equal, no heading, refs or page")
+            (is (= ["code" "python" verbatim]
+                   ((juxt :display-type :lang :title) (get-in response [:body :blocks 0])))
+                "the response reports the stored type, lang and title")
+            (is (nil? (:escaped (get-in response [:body :blocks 0]))) "nothing escaped")))))))
