+;; A page's title is a name: update_block on a page with a fence title renames it, never converts.
+;; A retried fence insert (same uuid) reuses the block and changes nothing.
+(deftest fence-title-on-a-page-and-retried-insert-test
+  (async done
+    (with-graph done 0
+      (fn [{:keys [conn self page-id]}]
+        (p/let [renamed (update! self page-id {:title "$$E=mc^2$$"})
+                id (random-uuid)
+                first-try (insert-tree! self page-id [{:uuid (str id) :title python-fence :display-type "code"}])
+                before (snapshot conn)
+                retry (insert-tree! self page-id [{:uuid (str id) :title python-fence :display-type "code"}])
+                after-retry (snapshot conn)
+                ;; Without display-type the fence alone converts; on a reused block nothing is converted.
+                fence-id (random-uuid)
+                fence-first (insert-tree! self page-id [{:uuid (str fence-id) :title python-fence}])
+                fence-before (snapshot conn)
+                fence-retry (insert-tree! self page-id [{:uuid (str fence-id) :title python-fence}])
+                quiet-retry (insert-tree! self page-id [{:uuid (str fence-id) :title python-fence}]
+                                          :query "?verbose=false")]
+          (ok? renamed "page rename")
+          (is (= {:type nil :classes #{} :title "$$E=mc^2$$"}
+                 (select-keys (held conn page-id) [:type :classes :title]))
+              "the page keeps the title as its name, with no type")
+          (is (not (contains? (:body renamed) :converted)))
+          (created? first-try "first")
+          (created? retry "retry")
+          (is (= (as-typed :code "print(1)" "python") (held conn id)))
+          (is (= (:datoms before) (:datoms after-retry)) "the retry added nothing")
+          (created? fence-first "fence first") (created? fence-retry "fence retry") (created? quiet-retry "quiet retry")
+          (is (= "fence" (get-in fence-first [:body :blocks 0 :converted])) "the first try converted the fence")
+          (is (not (contains? (get-in fence-retry [:body :blocks 0]) :converted)) "a retry converted nothing")
+          (is (not (contains? (get-in quiet-retry [:body :blocks 0]) :converted)) "nor with verbose=false")
+          (is (= (:datoms fence-before) (:datoms (snapshot conn))) "the fence retries added nothing")
+          (is (= (as-typed :code "print(1)" "python") (held conn fence-id))))))))
