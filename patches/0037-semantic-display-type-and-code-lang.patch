+                  math-response (update! self math {:title "$$E=mc^2$$"})
+                  query-response (update! self query {:title query-fence})
+                  again (update! self code {:title "print(1)"})]
+            (doseq [[label response] [["code" code-response] ["math" math-response] ["query" query-response] ["again" again]]]
+              (ok? response label))
