+(defn- read-back-display!
+  "Throws, answered as a 500, when the display write of entry `index` didn't read back."
+  [db index block-id property-ident value]
+  (when (contains? #{display-type-ident lang-ident} property-ident)
+    (when-let [problem (read-back-display db block-id property-ident value)]
+      (unverified! [(str "entry " index ": " problem)]))))
