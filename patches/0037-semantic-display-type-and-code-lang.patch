+;; Class sweep: a typed node's other properties, one per value kind, are set as on any node.
+(defn- check-property-kinds!
+  "Inserts `node` (a typed node without uuid or properties) with one property of each value kind,
+  and checks the block holds `expected` (see held) and every value."
+  [conn self page-id node expected]
+  (p/let [journal (capture! self [{:title "today"}])
+          journal-id (get-in journal [:body :page-id])
+          meeting (request! self "POST" "/semantic/pages" {:title "Meeting"})
+          meeting-id (get-in meeting [:body :uuid])
+          kinds [["Example owner" {:type "default"} "Ann" "Ann"]
+                 ["Example size" {:type "default" :choices [{:title "Small"} {:title "Large"}]} "Large" "Large"]
+                 ["Example site" {:type "url"} "https://sync.example.com" "https://sync.example.com"]
+                 ["Example estimate" {:type "number"} 3 3]
+                 ["Example done" {:type "checkbox"} true true]
+                 ["Example related" {:type "node"} "Meeting" "Meeting"]
+                 ["Example also" {:type "node"} meeting-id "Meeting"]
+                 ["Example day" {:type "date"} journal-id :journal]
+                 ["Example time" {:type "datetime"} 1762560000000 1762560000000]]
+          created (p/all (map (fn [[title schema]] (request! self "POST" "/semantic/properties" (assoc schema :title title))) kinds))
+          id (random-uuid)
+          response (insert-tree! self page-id [(assoc node :uuid (str id)
+                                                      :properties (into {} (map (fn [[title _ value]] [title value])) kinds))])
+          got (request! self "GET" (str "/semantic/blocks/" id) nil)]
+    (is (every? #(= 201 (:status %)) created) (pr-str (remove #(= 201 (:status %)) created)))
+    (created? response "typed node with every kind")
+    (is (= expected (select-keys (stored conn id) (keys expected))))
+    (let [values (into {} (map (juxt :title :value)) (get-in got [:body :properties]))
+          shown (fn [v] (if (map? v) (:title v) v))]
+      (doseq [[title _ _ expected] kinds]
+        (if (= :journal expected)
+          (is (some? (get values title)) (str title ": " (pr-str values)))
+          (is (= expected (shown (get values title))) (str title ": " (pr-str (get values title)))))))))
+
