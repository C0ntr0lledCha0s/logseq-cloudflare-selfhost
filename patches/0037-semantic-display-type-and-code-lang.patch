+(defn- set-display-type!
+  "Makes block `block-id` a `type` (:code, :math or :quote) block as the app's client pipeline would
+  (add-missing-properties-to-typed-display-blocks, which returns early for a server write): the
+  keyword, the matching class tag and neither of the other two, no lang unless code, and no heading,
+  which a typed block doesn't render. Inside the caller's transaction."
+  [conn block-id type]
+  (let [block (d/entity @conn block-id)
+        class (display-type-classes type)]
+    (when (not= type (display-type-ident block))
+      (outliner-property/set-block-property! conn block-id display-type-ident type))
+    (doseq [tag (:block/tags block)
+            :when (and (contains? ldb/node-display-type-classes (:db/ident tag)) (not= class (:db/ident tag)))]
+      (outliner-property/delete-property-value! conn block-id :block/tags (:db/id tag)))
+    (when-not (some #(= class (:db/ident %)) (:block/tags block))
+      (outliner-property/set-block-property! conn block-id :block/tags class))
+    (when (and (not= :code type) (some? (lang-ident block)))
+      (outliner-property/remove-block-property! conn block-id lang-ident))
+    (when (some? (:logseq.property/heading block))
+      (outliner-property/remove-block-property! conn block-id :logseq.property/heading))))
+
+(defn- clear-display-type!
+  "Makes block `block-id` a text block again: no display type, class tag or lang."
+  [conn block-id]
+  (let [block (d/entity @conn block-id)]
+    (when (some? (display-type-ident block))
+      (outliner-property/remove-block-property! conn block-id display-type-ident))
+    (doseq [tag (:block/tags block) :when (contains? ldb/node-display-type-classes (:db/ident tag))]
+      (outliner-property/delete-property-value! conn block-id :block/tags (:db/id tag)))
+    (when (some? (lang-ident block))
+      (outliner-property/remove-block-property! conn block-id lang-ident))))
+
+(defn- read-back-display
+  "Why block `block-id` in `db` doesn't hold what a display write stored, or nil. `property-ident`
+  and `value` are the write (`value` nil for a delete of the type)."
+  [db block-id property-ident value]
+  (let [block (d/entity db block-id)
+        held (set (keep #(ldb/node-display-type-classes (:db/ident %)) (:block/tags block)))
+        stored-type (display-type-ident block)
+        lang (lang-ident block)]
+    (cond
+      (and (= display-type-ident property-ident) (nil? value))
+      (cond
+        (some? stored-type) "display-type was not removed"
+        (seq held) "its display class tag was not removed"
+        (some? lang) "lang was not removed")
+
+      (= display-type-ident property-ident)
+      (cond
+        (not= value stored-type) (str "display-type is not " (name value))
+        (not= #{(display-type-classes value)} held)
+        (str "its display class tag is not " (:block/title (d/entity db (display-type-classes value))))
+        (and (not= :code value) (some? lang)) "lang was not removed"
+        (some? (:logseq.property/heading block)) "heading was not removed")
+
+      (= lang-ident property-ident)
+      (when (not= value lang) (str "lang is not " value)))))
+
