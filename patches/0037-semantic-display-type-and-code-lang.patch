+;; ---------------------------------------------------------------------------------------------
+;; Review round 1.
+
+(def ^:private unverified "the write did not store what was asked: ")
+
+(defn- unverified? [response expected label]
+  (is (= 500 (:status response)) (str label ": " (pr-str (:body response))))
+  (is (= (str unverified expected) (get-in response [:body :error])) label))
+
+;; STUBS A STEP (labelled): set-display-type! is redefined to add the class tag but skip the
+;; keyword. Every tree path and update_block reads the type back in its transaction, so each call
+;; answers 500 naming the node's path, and nothing is committed. Without the read-back each answered
+;; 201 or 200 and stored a block tagged Code with no type.
+(deftest tree-and-update-read-back-mismatch-rejects-test
+  (async done
+    (with-graph done 2
+      (fn [{:keys [conn self page-id ids]}]
+        (let [[parent target] ids
+              code {:title "x = 1" :display-type "code"}]
+          ;; capture_to_today makes today's journal before its write, so it is made first here.
+          (p/let [warm-up (capture! self [{:title "plain"}])
+                  _ (created? warm-up "today's journal")
+                  before (snapshot conn)
+                  responses
+                  (p/with-redefs [semantic/set-display-type!
+                                  (fn [conn block-id _type]
+                                    (outliner-property/set-block-property! conn block-id :block/tags
+                                                                           :logseq.class/Code-block))]
+                    (p/let [top (insert-tree! self page-id [{:title "plain"} code])
+                            nested (insert-tree! self page-id [{:title "plain" :children [{:title "plain"} code]}])
+                            children (insert-children! self parent [code])
+                            batch (batch-insert! self [{:target-id (str page-id) :blocks [{:title "plain"}]}
+                                                       {:target-id (str page-id) :blocks [code]}])
+                            captured (capture! self [code])
+                            updated (update! self target {:title "x = 1" :display-type "code"})
+                            fence (update! self target {:title "```python\nprint(1)\n```"})]
+                      [top nested children batch captured updated fence]))]
+            (doseq [[response expected label]
+                    (map vector responses
+                         ["blocks[1]: display-type is not code"
+                          "blocks[0].children[1]: display-type is not code"
+                          "blocks[0]: display-type is not code"
+                          "entries[1].blocks[0]: display-type is not code"
+                          "blocks[0]: display-type is not code"
+                          "display-type is not code"
+                          "display-type is not code"]
+                         ["insert_block_tree" "insert_block_tree, nested" "insert_block_children"
+                          "batch_insert_block_trees" "capture_to_today" "update_block" "update_block, fence"])]
+              (unverified? response expected label))
+            (is (= before (snapshot conn)) "nothing committed")
+            (is (= [plain plain] [(state conn parent) (state conn target)]))))))))
+
+;; STUBS A STEP (labelled): clear-display-type! is redefined to remove only the keyword, leaving the
+;; class tag and lang. Both delete routes read back, so each answers 500 naming the entry and
+;; commits nothing. Without the read-back each answered {:deleted n} with the block still tagged Code.
+(deftest delete-read-back-mismatch-rejects-test
+  (async done
+    (with-graph done 2
+      (fn [{:keys [conn self ids]}]
+        (let [[a b] ids]
+          (p/let [_ (batch-set! self [[a type-ident "code"] [a lang-ident "python"] [b type-ident "math"]])
+                  before (snapshot conn)
+                  [single batch]
+                  (p/with-redefs [semantic/clear-display-type!
+                                  (fn [conn block-id]
+                                    (outliner-property/remove-block-property! conn block-id :logseq.property.node/display-type))]
+                    (p/let [single (delete! self a type-ident)
+                            batch (batch-delete! self [[a "logseq.property/heading"] [b type-ident]])]
+                      [single batch]))]
+            (unverified? single "entry 0: its display class tag was not removed" "delete")
+            (unverified? batch "entry 1: its display class tag was not removed" "batch delete")
+            (is (= before (snapshot conn)) "nothing committed")
+            (is (= [(typed :code "python") (typed :math)] [(state conn a) (state conn b)]))))))))
+
+;; A batch insert entry's properties on an existing block follow the rule every other path applies:
+;; lang needs display-type code, judged on the block's type once every entry has applied, and the
+;; refusal names the entry. Before the fix these answered 201: lang stored on a text block, or on a
+;; math block, or dropped by the quote type written after it:
