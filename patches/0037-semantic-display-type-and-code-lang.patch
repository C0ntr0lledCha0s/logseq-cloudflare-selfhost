+      (fn [{:keys [conn self page-id ids]}]
+        (let [parent (first ids)
+              cases [["field" {:display-type "code" :lang "python"} "python"]
+                     ["properties by ident, \"code\"" {:properties {type-ident "code" lang-ident "python"}} "python"]
+                     ["properties by ident, \":code\"" {:properties {type-ident ":code"}} nil]
+                     ["properties by title, \"code\"" {:properties {"Node Display Type" "code"}} nil]
+                     ["properties by title, \":code\", lang first" {:properties {lang-ident "mermaid" "Node Display Type" ":code"}} "mermaid"]
+                     ["field and properties agree" {:display-type "code" :lang "sql"
+                                                    :properties {"Node Display Type" " Code " lang-ident "sql"}} "sql"]]]
+          (p/do
+            (p/doseq [[label fields lang] cases]
+              (p/let [[tree-id child-id] [(random-uuid) (random-uuid)]
+                      tree (insert-tree! self page-id [(merge {:uuid (str tree-id) :title verbatim} fields)])
+                      child (insert-children! self parent [(merge {:uuid (str child-id) :title verbatim} fields)])]
+                (created? tree (str "insert_block_tree, " label))
+                (created? child (str "insert_block_children, " label))
+                (is (= (verbatim-code verbatim lang) (stored conn tree-id)) (str "insert_block_tree, " label))
+                (is (= (verbatim-code verbatim lang) (stored conn child-id)) (str "insert_block_children, " label))))
+            (p/let [id (random-uuid)
+                    response (capture! self [{:uuid (str id) :title verbatim :display-type "code" :lang "python"}])]
+              (created? response "capture_to_today")
+              (is (= (verbatim-code verbatim "python") (stored conn id)) "capture_to_today"))))))))
