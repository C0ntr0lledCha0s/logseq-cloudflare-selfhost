+(defn- fence-display-block
+  "What a block titled `title` is when its whole title is one fence: {:type :code :title inner
+  :lang lang} for a ``` fence (lang only when the fence names one), {:type :math :title inner} for
+  a $$ fence, {:kept reason} for a fence that stays text (a query fence, or a language too long to
+  be lang), else nil. As the app: the trimmed title must start and end with ``` or $$ (a string
+  check, so other titles are never parsed), and mldoc must read it as exactly one Src or
+  Displayed_Math node. Unlike the app, a fence of four or more backticks, which mldoc reads as a
+  Src whose language starts with `, stays text. Never call it on an E2EE title, which is
+  ciphertext."
+  [title]
+  (let [text (when (string? title) (string/trim title))]
+    (when (and text (or (re-find #"(?s)^```.*```$" text) (re-find #"(?s)^\$\$.*\$\$$" text)))
+      (let [nodes (fence-ast text)
+            [[kind data]] nodes]
+        (when (= 1 (count nodes))
+          (case kind
+            "Src" (let [lang (not-empty (:language data))]
+                    (cond
+                      (and lang (string/includes? lang "`")) nil
+                      (and lang (= "query" (string/lower-case lang))) {:kept query-fence-reason}
+                      (and lang (not (valid-lang? lang))) {:kept fence-lang-reason}
+                      :else (cond-> {:type :code :title (string/replace (apply str (:lines data)) #"\r?\n$" "")}
+                              lang (assoc :lang lang))))
+            "Displayed_Math" {:type :math :title (string/trim data)}
+            nil))))))
