+;; insert_block_tree and insert_block_children take dry-run as batch_insert_block_trees does: the
+;; preview answers what the real call would, and the graph is unchanged. Before the fix dry-run was
+;; ignored and the blocks were written:
+;;   expected: (= 200 (:status response))  actual: 201
+(deftest dry-run-on-single-inserts-test
+  (async done
+    (with-graph done 1
+      (fn [{:keys [conn self page-id ids]}]
+        (let [parent (first ids)
+              blocks [{:title python-fence} {:title query-fence} {:title "$$E=mc^2$$"}]]
+          (p/do
+            (p/let [before (snapshot conn)
+                    tree (insert-tree! self page-id blocks :extra {:dry-run true})
+                    child (insert-children! self parent blocks :extra {:dry-run true})
+                    batch (batch-insert! self [{:target-id (str page-id) :blocks blocks}] :extra {:dry-run true})]
+              (doseq [[op response preview] [["insert_block_tree" tree (get-in tree [:body :blocks])]
+                                              ["insert_block_children" child (get-in child [:body :blocks])]
+                                              ["batch_insert_block_trees" batch (get-in batch [:body :entries 0 :blocks])]]]
+                (is (= 200 (:status response)) (str op ": " (pr-str (:body response))))
+                (is (true? (get-in response [:body :dry-run])) op)
+                (is (= [["fence" "code" "python" "print(1)"] [nil nil nil query-fence] ["fence" "math" nil "E=mc^2"]]
+                       (mapv (juxt :converted :display-type :lang :title) preview))
+                    (str op ": each preview node reports the conversion"))
+                (is (= [{:path (if (= "batch_insert_block_trees" op) "entries[0].blocks[1]" "blocks[1]") :reason kept-reason}]
+                       (get-in response [:body :kept]))
+                    (str op ": kept")))
+              (is (= before (snapshot conn)) "a dry run writes nothing"))
+            (p/doseq [value ["true" 1 nil]]
+              (p/let [before (snapshot conn)
+                      tree (insert-tree! self page-id blocks :extra {:dry-run value})
+                      child (insert-children! self parent blocks :extra {:dry-run value})]
+                (refused? tree "dry-run must be a boolean" (str "insert_block_tree " (pr-str value)))
+                (refused? child "dry-run must be a boolean" (str "insert_block_children " (pr-str value)))
+                (is (= before (snapshot conn)) (str (pr-str value) ": nothing written"))))
+            (p/let [id (random-uuid)
+                    real (insert-tree! self page-id [{:uuid (str id) :title python-fence}] :extra {:dry-run false})]
+              (created? real "dry-run false writes")
+              (is (= (as-typed :code "print(1)" "python") (held conn id))))))))))
