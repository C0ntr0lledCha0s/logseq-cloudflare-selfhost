+;; COUNTS A STEP (labelled): fence-ast is wrapped to count its calls, and still parses. A title that
+;; doesn't start and end with a fence never reaches mldoc (spec §5: a string check per title, a parse
+;; only for a fence at both ends).
+(deftest only-fenced-titles-reach-the-parser-test
+  (async done
+    (with-graph done 0
+      (fn [{:keys [self page-id]}]
+        (let [calls (atom [])
+              real semantic/fence-ast
+              unfenced ["plain" "```python\nprint(1)" "print(1)\n```" "Intro ```x```" "```x``` outro"
+                        "$$x" "x$$" "`x`" "$x$" "# Heading"]]
+          (p/with-redefs [semantic/fence-ast (fn [text] (swap! calls conj text) (real text))]
+            (p/let [inserted (insert-tree! self page-id (mapv #(hash-map :title %) unfenced))
+                    batch (batch-insert! self [{:target-id (str page-id) :blocks (mapv #(hash-map :title %) unfenced)}])
+                    update-id (placeholder! self page-id)
+                    updated (update! self update-id {:title "```python\nprint(1)"})
+                    _ (is (= [] @calls) "no unfenced title was parsed")
+                    fenced (insert-tree! self page-id [{:title python-fence}])]
+              (created? inserted "unfenced") (created? batch "unfenced batch") (ok? updated "unfenced update")
+              (created? fenced "fenced")
