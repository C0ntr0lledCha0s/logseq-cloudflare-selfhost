+(defn- display-class?
+  "Whether the entity with db id `id` is Code-block, Math-block or Quote-block."
+  [db id]
+  (contains? ldb/node-display-type-classes (:db/ident (d/entity db id))))
+
+(defn- parse-display-type
+  "The display type `value` names (\"code\" or \":code\", trimmed, any case), or nil."
+  [value]
+  (when (string? value)
+    (let [text (string/lower-case (string/trim value))]
+      (display-type-values (keyword (cond-> text (string/starts-with? text ":") (subs 1)))))))
+
+(defn- valid-lang?
+  "A code block's language: 1 to 40 characters with no whitespace, case kept (any CodeMirror mode)."
+  [value]
+  (and (string? value) (<= 1 (count value) 40) (not (re-find #"\s" value))))
