+                  _ (is (= (typed :code "python") (state conn id)))
+                  response (put! self id type-ident "quote")
+                  got (request! self "GET" (str "/semantic/blocks/" id) nil)]
+            (ok? response "code to quote")
+            (is (= (typed :quote) (state conn id)) "lang and Code-block go, Quote-block comes")
+            (is (= "quote" (get-in got [:body :display-type])))
+            (is (not (contains? (:body got) :lang)))
+            (is (not-any? #(= "logseq.class/Code-block" (:ident %)) (get-in got [:body :tags])))))))))
