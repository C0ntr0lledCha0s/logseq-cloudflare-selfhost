+(defn- tag-value-refusal
+  "Why the resolved :block/tags `values` for `scope` (see prepare-property-value) can't hold Tag, or
+  nil. The outliner refuses Tag as a tags value (validate-tags-property), which surfaced as a server
+  error. A page becomes a tag through promotePageToTag, which also gives it the :db/ident a tag
+  needs, so a page is pointed there. A tag already holds Tag, so re-sending it is allowed, and
+  set-prepared-property! doesn't set it again."
+  [db scope values]
+  (let [target (some->> (:db/id scope) (d/entity db))]
+    (when (and (some #{(:db/id (d/entity db :logseq.class/Tag))} values)
+               (not (entity-util/class? target)))
+      (str "Tag marks a page as a tag and can't be set as a value; "
+           (if (page? target)
+             (str "use promote_page_to_tag on page " (:block/uuid target))
+             "use promote_page_to_tag")))))
+
