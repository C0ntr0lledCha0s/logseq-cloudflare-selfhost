+;; The invariants of upstream's convert-page-to-tag-updates-worker-db-atomically, on one tx id, and
+;; a client replaying the sync log sees the same tag.
+(deftest promotion-is-one-transaction-test
+  (async done
+    (with-promotion-graph done
+      (fn [{:keys [conn self recipe]}]
+        (let [client (d/conn-from-db @conn)
+              reports (atom [])
+              db-id (:db/id (entity conn recipe))]
+          (d/listen! conn ::reports
+                     (fn [{:keys [db-after db-before tx-data] :as report}]
+                       (when (seq tx-data)
+                         (swap! reports conj (assoc report :normalized
+                                                    (db-normalize/normalize-tx-data db-after db-before tx-data))))))
+          (p/let [response (promote! self recipe)
+                  _ (d/unlisten! conn ::reports)
+                  _ (doseq [{:keys [normalized]} @reports] (d/transact! client normalized))
+                  tx-data (mapcat :tx-data @reports)
+                  page-datoms (filter #(= db-id (:e %)) tx-data)
+                  tag (d/entity @client [:block/uuid recipe])]
+            (is (= 200 (:status response)) (pr-str response))
+            (is (= 1 (count @reports)) "one transaction")
+            (is (= 1 (count (distinct (map :tx tx-data)))) "one tx id")
+            (is (some #(and (= :db/ident (:a %)) (:added %)) page-datoms) "the ident is added to the page itself")
+            (is (some #(and (= :block/tags (:a %)) (:added %)
+                            (= (:db/id (d/entity @conn :logseq.class/Tag)) (:v %)))
+                      page-datoms)
+                "Tag is added")
+            (is (some #(and (= :block/tags (:a %)) (not (:added %))
+                            (= (:db/id (d/entity @conn :logseq.class/Page)) (:v %)))
+                      page-datoms)
+                "Page is retracted")
+            (is (= [recipe "Recipe" 7 (:db/ident (entity conn recipe))]
+                   [(:block/uuid tag) (:block/title tag) (:block/created-at tag) (:db/ident tag)])
+                "a client replaying the log has the same tag")
+            (is (= #{"Tag" "Food"} (set (map :block/title (:block/tags tag)))))))))))
