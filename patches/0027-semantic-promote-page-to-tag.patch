-(declare find-tag validate-tag-schema write-tag-schema! expected-tag-schema verify-tag-schema!)
+(declare find-tag resolve-tag-selector validate-tag-schema write-tag-schema! expected-tag-schema verify-tag-schema!
+         unverified!)
+
+;; promotePageToTag turns a page into a tag in place, as the app's "Convert to tag" does: the page
+;; keeps its UUID, title, blocks, properties, other tags and references, gains Tag and a :db/ident,
+;; and loses Page. Every refusal is found against the graph first, the conversion is one
+;; atomic-write!, and the tag is read back.
+
+(def ^:private promotion-fields
+  "The body fields promotePageToTag takes; any other is refused."
+  #{:extends})
+
+(defn- promotion-parent-resolver
+  "extends' selector resolver when `page` is being promoted: a tag, as resolve-tag-selector finds
+  it, else the page itself by its UUID or its title ignoring case, so extends-refusal answers that
+  it can't extend itself rather than that no tag has its name."
+  [page]
+  (fn [db selector]
+    (or (resolve-tag-selector db selector)
+        (when (and page (non-blank-string? selector)
+                   (or (and (common-util/uuid-string? selector) (= (uuid selector) (:block/uuid page)))
+                       (= (string/lower-case selector) (:block/name page))))
+          page))))
+
+(defn- promotion-kind
+  "What a visible entity that isn't a plain page is, with its article, for the refusal."
+  [entity]
+  (cond
+    (some #{:logseq.class/Whiteboard} (map :db/ident (:block/tags entity))) "a whiteboard"
+    (asset? entity) "an asset"
+    :else "a block"))
+
+(defn- promotion-refusal
+  "Why the entity `page-id` names (`page`, or nil) can't become a tag: {:status :error}, plus
+  :existing for a tag holding its title, or nil. The app's convert-page-to-tag!
+  (src/main/frontend/handler/db_based/page.cljs:37) refuses a title a tag has, a namespaced page and
+  a built-in; this also refuses a journal, a property, a tag, a recycled page and what isn't a page."
+  [db page-id page]
+  (let [label (when page (str "page-id: \"" (:block/title page) "\" (" (:block/uuid page) ") "))
+        refuse (fn [reason] {:status 400 :error (str label reason)})]
+    (cond
+      (nil? page) {:status 404 :error (str "page-id: no page " page-id)}
+      (entity-util/recycled? page) (refuse "is in the Recycle bin")
+      (entity-util/hidden? page) {:status 404 :error (str "page-id: no page " page-id)}
+      (ldb/journal? page) (refuse "is a journal; journals can't become tags")
+      (ldb/built-in? page) (refuse "is built in")
+      (property? page) (refuse "is a property")
+      (tag? page) {:status 409
+                   :error (str "page-id: \"" (:block/title page) "\" is already a tag (" (:block/uuid page)
+                               "); use update_tag to change it")}
+      (not (ldb/internal-page? page)) (refuse (str "is " (promotion-kind page) ", not a page"))
+      (:block/parent page) (refuse (str "is namespaced under " (:block/title (:block/parent page))))
+      :else
+      ;; The page isn't a tag, so it isn't among these.
+      (when-let [tags (seq (filter tag? (title-holders db (:block/title page))))]
+        {:status 409
+         :error (str label "can't become a tag: "
+                     (string/join ", " (map #(str "tag \"" (:block/title %) "\" (" (:block/uuid %) ")") tags))
+                     " already has the title; nothing was changed. Rename one of them first.")
+         :existing (mapv #(hash-map :uuid (uuid-string (:block/uuid %)) :kind "tag" :title (:block/title %))
+                         tags)}))))
+
+(defn- promote-tx
+  "The app's convert-page-to-tag-tx (src/main/frontend/worker/handler/property.cljs:296), which
+  db-sync doesn't load: build-new-class upserts a unique user.class ident and Tag (and Root as what
+  it extends) onto the page by its UUID, and Page is retracted. The page's other tags are kept.
+  {:tx [...] :ident kw}, or {:error message} when build-new-class refuses the title."
+  [db page]
+  (try
+    (let [class-tx (db-class/build-new-class db {:block/uuid (:block/uuid page)
+                                                 :block/title (:block/title page)
+                                                 :block/created-at (:block/created-at page)})]
+      {:tx [class-tx [:db/retract (:db/id page) :block/tags :logseq.class/Page]]
+       :ident (:db/ident class-tx)})
+    (catch :default error
+      {:error (str "page-id: \"" (:block/title page) "\" (" (:block/uuid page) ") can't become a tag: "
+                   (or (get-in (ex-data error) [:payload :message]) (ex-message error)))})))
+
+(defn- promotion-counts
+  "What a promotion keeps, counted: the page's own blocks (property values left out) and the
+  entities that reference it (as deletePage counts them)."
+  [db page]
+  {:blocks (->> (d/datoms db :avet :block/page (:db/id page))
+                (remove #(seq (d/datoms db :eavt (:e %) :logseq.property/created-from-property)))
+                count)
+   :references (count (referrer-ids db page))})
+
+(defn- verify-promotion!
+  "Re-reads the promoted page by UUID and throws, answered as a 500 by `rejecting`, unless it kept
+  its title, holds Tag and not Page, has an ident, and kept the `counts` taken before the write.
+  Returns the tag. The graph's validation currently refuses a write that leaves a tag without Tag or
+  an ident, or with Page, before this runs; these checks keep that true across an upstream bump."
+  [db page-uuid title counts]
+  (let [tag (d/entity db [:block/uuid page-uuid])
+        tags (set (map :db/ident (:block/tags tag)))
+        after (when tag (promotion-counts db tag))]
+    (unverified!
+     (if-not tag
+       ["the page is missing"]
+       (cond-> []
+         (not= title (:block/title tag)) (conj (str "the title is " (pr-str (:block/title tag))))
+         (not (contains? tags :logseq.class/Tag)) (conj "Tag is missing")
+         (contains? tags :logseq.class/Page) (conj "Page was not removed")
+         (nil? (:db/ident tag)) (conj "the ident is missing")
+         (not= (:blocks counts) (:blocks after))
+         (conj (str "it had " (:blocks counts) " blocks and has " (:blocks after)))
+         (not= (:references counts) (:references after))
+         (conj (str "it had " (:references counts) " references and has " (:references after))))))
+    tag))
+
+(defn- run-promotion
+  "Converts `page` with promote-tx's `tx` and, when `parents` is given, sets what it extends, in one
+  atomic-write! on `conn` (the graph, or a dry-run copy of it), reads both back and returns the
+  response body: the tag as getTag answers it, plus the promoted counts."
+  [conn creator page tx parents]
+  (let [counts (promotion-counts @conn page)
+        page-id (:db/id page)]
+    (atomic-write! conn creator false :save-block
+                   (fn [tx-conn]
+                     (ldb/transact! tx-conn tx)
+                     (write-tag-schema! tx-conn page-id parents nil)))
+    (let [tag (verify-promotion! @conn (:block/uuid page) (:block/title page) counts)]
+      (when parents (verify-tag-schema! @conn (:block/uuid page) (expected-tag-schema page parents nil)))
+      (assoc (tag-detail-response tag) :promoted counts))))
 
