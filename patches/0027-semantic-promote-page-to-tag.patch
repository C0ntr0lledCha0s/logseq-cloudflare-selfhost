+;; The connector generates promote_page_to_tag from this operation: a page UUID in the path, a
+;; dry-run query flag, an optional body whose only field is extends, and the tag plus promoted
+;; counts (and dry-run on a dry run) in the answer.
+(deftest openapi-documents-promotion-test
+  (let [document (semantic-routes/openapi-document "https://issuer.example")
+        operation (get-in document [:paths "/api/v1/graphs/{graph-id}/pages/{page-id}/promote-to-tag" :post])
+        schema (get-in operation [:requestBody :content "application/json" :schema])
+        dry-run (some #(when (= "dry-run" (:name %)) %) (:parameters operation))]
+    (is (= "promotePageToTag" (:operationId operation)))
+    (is (= [{:oauth ["logseq/write"]}] (:security operation)))
+    (is (= ["graph-id" "page-id" "dry-run"] (map :name (:parameters operation))))
+    (is (= ["query" {:type "boolean"}] [(:in dry-run) (:schema dry-run)]))
+    (is (string/includes? (:description dry-run) "writes nothing"))
+    (is (false? (get-in operation [:requestBody :required])) "an empty body promotes the page as it is")
+    (is (= [[:extends] false "object"] [(keys (:properties schema)) (:additionalProperties schema) (:type schema)]))
+    (is (= ["array" {:type "string"} 1] ((juxt :type :items :minItems) (get-in schema [:properties :extends]))))
+    (is (every? #(string/includes? (:description operation) %) ["extends" "dry-run=true"]))
+    (is (= {:type "boolean"}
+           (select-keys (get-in document [:components :schemas :PromotedTagResponse :allOf 1 :properties :dry-run]) [:type])))
+    (is (= "#/components/schemas/PromotedTagResponse"
+           (get-in operation [:responses "200" :content "application/json" :schema :$ref])))
+    (is (= ["blocks" "references"]
+           (get-in document [:components :schemas :PromotedTagResponse :allOf 1 :properties :promoted :required])))
+    (is (every? #(get-in operation [:responses % :description]) ["400" "404" "409"]))))
