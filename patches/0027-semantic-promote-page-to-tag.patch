+(defn- tag-value-refusal
+  "Why the resolved :block/tags `values` for `scope` (see prepare-property-value) can't hold Tag, or
+  nil. The outliner refuses Tag as a tags value (validate-tags-property), which surfaced as a server
+  error. A page becomes a tag through promotePageToTag, which also gives it the :db/ident a tag
+  needs, so a page is pointed there; a tag already holds Tag."
+  [db scope values]
+  (when (some #{(:db/id (d/entity db :logseq.class/Tag))} values)
+    (let [target (some->> (:db/id scope) (d/entity db))]
+      (str "Tag marks a page as a tag and can't be set as a value; "
+           (cond
+             (entity-util/class? target) (str (:block/uuid target) " is already a tag")
+             (page? target) (str "use promote_page_to_tag on page " (:block/uuid target))
+             :else "use promote_page_to_tag")))))
+
 (defn- prepare-property-value
   "Resolves `value` for `property-ident` to {:value v} or {:error reason}. `scope` is the block
   the value is for (an entity, or a map of the :block/tags a new block will have), which limits a
@@ -974,7 +988,8 @@
         (cond
           (some ::error resolved) {:error (some ::error resolved)}
           (every? some? resolved)
-          (if-let [refused (refused-by-type db property values resolved)]
+          (if-let [refused (or (when (= :block/tags property-ident) (tag-value-refusal db scope resolved))
+                               (refused-by-type db property values resolved))]
             (refusal property refused)
             {:value (if many-input? resolved (first resolved))})
