+(defn- set-prepared-tags!
+  "Writes a resolved :block/tags `value` (one id or several) on `block-id`. A tag the block already
+  holds isn't set again, because the outliner refuses Tag even on a tag that holds it. Under reset a
+  list replaces the block's tags, so only the tags it leaves out are removed: removing them all first
+  would remove Page or Tag, which the outliner refuses. So sending a page's or tag's own tags back is
+  a no-op, not a server error."
+  [conn block-id value reset-existing-values?]
+  (let [ids (if (coll? value) value [value])
+        held #(set (map :db/id (:block/tags (d/entity @conn block-id))))]
+    (when (and reset-existing-values? (coll? value))
+      (doseq [id (remove (set ids) (held))]
+        (outliner-property/delete-property-value! conn block-id :block/tags id)))
+    (doseq [id ids :when (not (contains? (held) id))]
+      (if (coll? value)
+        (outliner-property/batch-set-property! conn [block-id] :block/tags id {:entity-id? true})
+        (outliner-property/set-block-property! conn block-id :block/tags id)))))
+
