+;; extends and dry-run (spec 3.3, 3.4). Before stage 3 the body took no fields, so every extends
+;; case answered 400 "unknown field extends", and dry-run=true was ignored, so a dry run promoted
+;; the page for real.
+
+(defn- extends-titles [response] (set (map :title (get-in response [:body :extends]))))
+
+(defn- stored-extends [conn id]
+  (set (map :block/title (:logseq.property.class/extends (entity conn id)))))
+
+(defn- children-of [conn tag-id]
+  (set (map :e (d/datoms @conn :avet :logseq.property.class/extends (:db/id (entity conn tag-id))))))
+
+;; Each way a tag selector can name a parent (title, title in another case, UUID, upper-case UUID,
+;; ident, several parents) sets the parents, which getTag reads back. A parent another parent
+;; already extends is dropped, as updateTag drops it. Without extends the tag extends Root.
+(deftest promote-with-extends-test
+  (async done
+    (-> (p/doseq [[kind extends expected]
+                  [["by title" (fn [_] ["Food"]) #{"Food"}]
+                   ["by title in another case" (fn [_] ["food"]) #{"Food"}]
+                   ["by UUID" (fn [{:keys [food]}] [(str food)]) #{"Food"}]
+                   ["by upper-case UUID" (fn [{:keys [food]}] [(string/upper-case (str food))]) #{"Food"}]
+                   ["by ident" (fn [{:keys [conn food]}] [(subs (str (:db/ident (entity conn food))) 1)]) #{"Food"}]
+                   ["two parents" (fn [_] ["Food" "Cuisine"]) #{"Food" "Cuisine"}]
+                   ["a parent's ancestor is dropped" (fn [_] ["Food" "Italian"]) #{"Italian"}]
+                   ["without extends" nil #{"Root Tag"}]]]
+          (p/let [{:keys [conn self recipe food] :as graph} (seed-promotion-graph)
+                  italian (request! self "POST" "/semantic/tags" {:title "Italian" :extends ["Food"]})
+                  response (promote! self recipe (when extends {:extends (extends graph)}))
+                  got (request! self "GET" (str "/semantic/tags/" recipe) nil)]
+            (testing kind
+              (is (= 201 (:status italian)) (pr-str italian))
+              (is (= 200 (:status response)) (pr-str response))
+              (is (= expected (extends-titles response)) "the response names the parents")
+              (is (= expected (extends-titles got)) "getTag reads them back")
+              (is (= expected (stored-extends conn recipe)))
+              (is (= #{"Tag" "Food"} (tag-titles conn recipe)) "the promotion itself still happened")
+              (is (= {:blocks 3 :references 2} (get-in response [:body :promoted])))
+              (when (contains? expected "Food")
+                (is (contains? (children-of conn food) (:db/id (entity conn recipe))) "Food has the new child")))))
+        (p/catch #(is false (str %)))
+        (p/finally done))))
