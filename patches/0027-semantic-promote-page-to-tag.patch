+;; 0026's extends refusals apply to a page that isn't a tag yet: a hidden built-in tag, the page
+;; itself (it isn't a tag, so the tag resolver alone would answer "no tag"), an empty list, a
+;; selector naming no tag (a page title, a missing UUID), something that isn't a list, and a page
+;; refusal reported with the extends refusal. Nothing is written in any case.
+(deftest promote-extends-refusals-test
+  (async done
+    (with-promotion-graph done
+      (fn [{:keys [conn self recipe diner food]}]
+        (let [{:keys [journal]} (seed-refusal-kinds conn)
+              label (fn [id] (str "page-id: \"" (:block/title (entity conn id)) "\" (" id ") "))
+              missing (random-uuid)]
+          (p/doseq [[kind id extends status error]
+                    [["Tag" recipe ["Tag"] 400 "extends 0: Tag is a built-in tag that other tags can't extend"]
+                     ["Page" recipe ["Food" "Page"] 400 "extends 1: Page is a built-in tag that other tags can't extend"]
+                     ["itself by title" recipe ["Recipe"] 400 "extends 0: Recipe can't extend itself"]
+                     ["itself by title in another case" recipe ["recipe"] 400 "extends 0: Recipe can't extend itself"]
+                     ["itself by UUID" recipe [(str recipe)] 400 "extends 0: Recipe can't extend itself"]
+                     ["itself by upper-case UUID" recipe [(string/upper-case (str recipe))] 400
+                      "extends 0: Recipe can't extend itself"]
+                     ["an empty list" recipe [] 400 "extends: name at least one tag"]
+                     ["an unknown title" recipe ["Food" "Fod"] 400 "extends 1: no tag \"Fod\""]
+                     ["a page's title" recipe ["Diner"] 400 "extends 0: no tag \"Diner\""]
+                     ["a page's UUID" recipe [(str diner)] 400 (str "extends 0: no tag \"" diner "\"")]
+                     ["a missing UUID" recipe [(str missing)] 400 (str "extends 0: no tag \"" missing "\"")]
+                     ["not a list" recipe "Food" 400 "extends: give a list of tag UUIDs, idents or titles"]
+                     ["several refusals" recipe ["Tag" "Recipe" "Fod"] 400
+                      "extends 0: Tag is a built-in tag that other tags can't extend; extends 1: Recipe can't extend itself; extends 2: no tag \"Fod\""]
+                     ["a refused page and a refused extends" journal ["Tag"] 400
+                      (str (label journal) "is a journal; journals can't become tags; "
+                           "extends 0: Tag is a built-in tag that other tags can't extend")]
+                     ["an existing tag and a refused extends: 400 first" food ["Fod"] 400
+                      (str "page-id: \"Food\" is already a tag (" food "); use update_tag to change it; "
+                           "extends 0: no tag \"Fod\"")]
+                     ["a missing page and a refused extends" missing ["Fod"] 400
+                      (str "page-id: no page " missing "; extends 0: no tag \"Fod\"")]]]
+            (p/let [before (snapshot conn)
+                    response (promote! self id {:extends extends})]
+              (testing kind
+                (is (= [status error] [(:status response) (get-in response [:body :error])]) (pr-str response))
+                (is (= before (snapshot conn)) "nothing is written")
+                (is (contains? (tag-titles conn recipe) "Page") "Recipe is still a page")))))))))
+
+;; The parents are read back: a write that doesn't store them answers 500 naming what is missing.
+(deftest promote-extends-read-back-wired-test
+  (async done
+    (with-promotion-graph done
+      (fn [{:keys [self recipe]}]
+        (p/let [response (p/with-redefs [outliner-property/set-block-property!
+                                         (let [real outliner-property/set-block-property!]
+                                           (fn [conn id property value & more]
+                                             (when-not (= :logseq.property.class/extends property)
+                                               (apply real conn id property value more))))]
+                           (promote! self recipe {:extends ["Food"]}))]
+          (is (= [500 "the write did not store what was asked: extends missing Food; extends not removed Root Tag"]
+                 [(:status response) (get-in response [:body :error])])
+              (pr-str response)))))))
+
+;; dry-run=true runs the same validation and write on a throwaway copy, answers the same body with
+;; dry-run: true, and leaves the graph as it was, with or without extends. Nobody is told the graph
+;; changed. dry-run=false promotes for real; any other value is refused.
+(deftest promote-dry-run-test
+  (async done
+    (with-promotion-graph done
+      (fn [{:keys [conn self recipe food]}]
+        (let [sent (atom [])
+              food-children (children-of conn food)]
+          (set! (.-state self) #js {:getWebSockets (fn [] #js [#js {:readyState 1 :send #(swap! sent conj %)}])})
+          (p/let [_ (p/doseq [[kind body expected] [["without extends" nil #{"Root Tag"}]
+                                                    ["with extends" {:extends ["Food"]} #{"Food"}]]]
+                      (p/let [before (snapshot conn)
+                              response (promote! self recipe body "dry-run=true")]
+                        (testing kind
+                          (is (= 200 (:status response)) (pr-str response))
+                          (is (true? (get-in response [:body :dry-run])))
+                          (is (string/starts-with? (str (get-in response [:body :ident])) "user.class/Recipe")
+                              "the ident the tag would get")
+                          (is (= [(str recipe) "Recipe"] [(get-in response [:body :uuid]) (get-in response [:body :title])]))
+                          (is (= {:blocks 3 :references 2} (get-in response [:body :promoted])))
+                          (is (= expected (extends-titles response)))
+                          (is (= before (snapshot conn)) "nothing is written")
+                          (is (= #{"Page" "Food"} (tag-titles conn recipe)) "Recipe is still a page")
+                          (is (nil? (:db/ident (entity conn recipe))))
+                          (is (= food-children (children-of conn food)) "Food has no new child")
+                          (is (empty? @sent) "a dry run changes nothing"))))
+                  before (snapshot conn)
+                  invalid (promote! self recipe nil "dry-run=yes")
+                  _ (is (= [400 "dry-run must be true or false"] [(:status invalid) (get-in invalid [:body :error])])
+                        (pr-str invalid))
+                  _ (is (= before (snapshot conn)) "an invalid flag writes nothing")
+                  real (promote! self recipe {:extends ["Food"]} "dry-run=false")]
+            (is (= 200 (:status real)) (pr-str real))
+            (is (nil? (get-in real [:body :dry-run])) "a real promotion isn't marked dry-run")
+            (is (= #{"Tag" "Food"} (tag-titles conn recipe)))
+            (is (= #{"Food"} (stored-extends conn recipe)))
+            (is (= ["changed"] (map #(aget (js/JSON.parse %) "type") @sent)))))))))
+
+;; A dry run is refused exactly as the real call is, with nothing written.
+(deftest promote-dry-run-refusal-test
+  (async done
+    (with-promotion-graph done
+      (fn [{:keys [conn self recipe food]}]
+        (let [{:keys [journal]} (seed-refusal-kinds conn)
+              label (fn [id] (str "page-id: \"" (:block/title (entity conn id)) "\" (" id ") "))]
+          (p/doseq [[kind id body status error]
+                    [["a journal" journal nil 400 (str (label journal) "is a journal; journals can't become tags")]
+                     ["an existing tag" food nil 409
+                      (str "page-id: \"Food\" is already a tag (" food "); use update_tag to change it")]
+                     ["a refused extends" recipe {:extends ["Recipe"]} 400 "extends 0: Recipe can't extend itself"]
+                     ["a journal with extends" journal {:extends ["Food"]} 400
+                      (str (label journal) "is a journal; journals can't become tags")]
+                     ["dry-run in the body, not the query" recipe {:dry-run true} 400 "unknown field dry-run"]]]
+            (p/let [before (snapshot conn)
+                    real (promote! self id body)
+                    dry (promote! self id body "dry-run=true")]
+              (testing kind
+                (is (= [status error] [(:status dry) (get-in dry [:body :error])]) (pr-str dry))
+                (is (= real dry) "the same refusal as the real call")
+                (is (= before (snapshot conn)) "nothing is written")))))))))
