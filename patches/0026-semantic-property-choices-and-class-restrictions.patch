diff --git a/deps/db-sync/test/logseq/db_sync/semantic_property_schema_test.cljs b/deps/db-sync/test/logseq/db_sync/semantic_property_schema_test.cljs
new file mode 100644
index 0000000..9a231b6
--- /dev/null
+++ b/deps/db-sync/test/logseq/db_sync/semantic_property_schema_test.cljs
@@ -0,0 +1,2136 @@
+(ns logseq.db-sync.semantic-property-schema-test
+  "A property's schema through createProperty, updateProperty and getProperty: its choices read
+  back in editor order with icon and description, and a node property's classes. A value given by
+  UUID, ident or db id is checked against the classes as a title already is, on every write path.
+  The graph has tags Client and Service, Client pages Acme and Bolt, a Service page Audit, and a
+  decoy plain page Acme Ltd."
+  (:require [cljs.test :refer [async deftest is testing]]
+            [clojure.string :as string]
+            [datascript.core :as d]
+            [logseq.db :as ldb]
+            [logseq.db-sync.test-sql :as test-sql]
+            [logseq.db-sync.worker.handler.semantic :as semantic]
+            [logseq.db-sync.worker.handler.sync :as sync-handler]
+            [logseq.db-sync.worker.routes.semantic :as semantic-routes]
+            [logseq.db.common.normalize :as db-normalize]
+            [logseq.db.common.order :as db-order]
+            [logseq.db.frontend.property :as db-property]
+            [logseq.db.sqlite.export :as sqlite-export]
+            [logseq.outliner.core :as outliner-core]
+            [logseq.outliner.property :as outliner-property]
+            [promesa.core :as p]))
+
+(defn- request!
+  "One semantic API request through the real handler; returns {:status :body}."
+  [self method path body]
+  (p/let [url (str "http://localhost" path (if (string/includes? path "?") "&" "?") "graph-id=graph-1")
+          response (sync-handler/handle-http
+                    self
+                    (js/Request. url (clj->js (cond-> {:method method
+                                                       :headers {"content-type" "application/json"}}
+                                                body (assoc :body (js/JSON.stringify (clj->js body)))))))
+          text (.text response)]
+    {:status (.-status response)
+     :body (when (seq text) (js->clj (js/JSON.parse text) :keywordize-keys true))}))
+
+(defn- ident-str [ident] (subs (str ident) 1))
+
+(defn- entity [conn id] (d/entity @conn [:block/uuid id]))
+
+(defn- with-graph
+  [done run]
+  (-> (p/let [conn (sqlite-export/create-conn)
+              self #js {:conn conn :sql (test-sql/make-sql) :schema-ready true}
+              tag! (fn [title] (p/let [r (request! self "POST" "/semantic/tags" {:title title})]
+                                 (entity conn (uuid (get-in r [:body :uuid])))))
+              client (tag! "Client")
+              service (tag! "Service")
+              vip (tag! "VIP")
+              _ (d/transact! conn [[:db/add (:db/id vip) :logseq.property.class/extends (:db/id client)]])
+              page-id (random-uuid)
+              [acme bolt audit acme-ltd zed] (repeatedly 5 random-uuid)
+              blocks (vec (repeatedly 8 random-uuid))
+              page (fn [id title tags]
+                     {:block/uuid id :block/name (string/lower-case title) :block/title title
+                      :block/tags (into #{:logseq.class/Page} tags) :block/created-at 1 :block/updated-at 1})
+              _ (d/transact! conn (concat
+                                   [(page page-id "Notes" [])
+                                    ;; The decoy is created before the Client pages, so a graph-wide
+                                    ;; title lookup would find it first.
+                                    (page acme-ltd "Acme Ltd" [])
+                                    (page acme "Acme" [(:db/id client)])
+                                    (page bolt "Bolt" [(:db/id client)])
+                                    (page audit "Audit" [(:db/id service)])
+                                    (page zed "Zed" [(:db/id vip)])]
+                                   (map-indexed (fn [index id]
+                                                  {:block/uuid id :block/title (str "Block " index)
+                                                   :block/page [:block/uuid page-id]
+                                                   :block/parent [:block/uuid page-id]
+                                                   :block/order (str "a" index)
+                                                   :block/created-at 1 :block/updated-at 1})
+                                                blocks)))
+              for-client (outliner-property/upsert-property!
+                          conn nil {:logseq.property/type :node :db/cardinality :db.cardinality/one}
+                          {:property-name "for-client"})
+              clients (outliner-property/upsert-property!
+                       conn nil {:logseq.property/type :node :db/cardinality :db.cardinality/many}
+                       {:property-name "clients"})
+              grade (outliner-property/upsert-property!
+                     conn nil {:logseq.property/type :default :db/cardinality :db.cardinality/one}
+                     {:property-name "grade"})]
+        (run {:conn conn :self self :page-id page-id :blocks blocks
+              :client client :service service :vip vip
+              :acme acme :bolt bolt :audit audit :acme-ltd acme-ltd :zed zed
+              :for-client (:db/ident for-client) :clients (:db/ident clients) :grade (:db/ident grade)}))
+      (p/catch #(is false (str %)))
+      (p/finally done)))
+
+(defn- property-path [property]
+  (str "/semantic/properties/" (js/encodeURIComponent (ident-str property))))
+
+(defn- value-path [block-id property]
+  (str "/semantic/blocks/" block-id "/properties/" (js/encodeURIComponent (ident-str property))))
+
+(defn- stored [conn id property]
+  (let [value (get (entity conn id) property)]
+    (if (set? value) (set (map :block/uuid value)) (:block/uuid value))))
+
+(defn- class-uuids [conn property]
+  (set (map :block/uuid (:logseq.property/classes (d/entity @conn property)))))
+
+(defn- restrict! [self property mode tags]
+  (request! self "PATCH" (property-path property) {:classes {mode tags}}))
+
+(deftest get-property-lists-choices-in-editor-order-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self]}]
+        (p/let [status (outliner-property/upsert-property!
+                        conn nil {:logseq.property/type :default :db/cardinality :db.cardinality/one}
+                        {:property-name "project-status"})
+                status (:db/ident status)
+                [a b c] (repeatedly 3 random-uuid)
+                ;; Written C, A, B, so datom order is C, A, B; the editor orders by :block/order.
+                _ (outliner-property/upsert-closed-value! conn status {:id c :value "C"})
+                _ (outliner-property/upsert-closed-value! conn status {:id a :value "A"
+                                                                        :icon {:type :emoji :id "rocket"}
+                                                                        :description "The first one"})
+                _ (outliner-property/upsert-closed-value! conn status {:id b :value "B"})
+                _ (d/transact! conn [[:db/add [:block/uuid a] :block/order "a1"]
+                                     [:db/add [:block/uuid b] :block/order "a2"]
+                                     [:db/add [:block/uuid c] :block/order "a3"]])
+                got (request! self "GET" (property-path status) nil)
+                listed (request! self "GET" "/semantic/properties?limit=200" nil)]
+          (is (= 200 (:status got)) (str (:body got)))
+          (is (= ["A" "B" "C"] (mapv :title (get-in got [:body :choices])))
+              "getProperty lists choices in editor order")
+          (is (= [(str a) (str b) (str c)] (mapv :uuid (get-in got [:body :choices]))))
+          (let [first-choice (first (get-in got [:body :choices]))]
+            (is (= {:type "emoji" :id "rocket"} (:icon first-choice)) "a choice's icon reads back")
+            (is (= "The first one" (:description first-choice)) "a choice's description reads back"))
+          (is (not (contains? (second (get-in got [:body :choices])) :icon))
+              "a choice without an icon has none")
+          (is (= ["A" "B" "C"]
+                 (->> (get-in listed [:body :properties])
+                      (some #(when (= (ident-str status) (:ident %)) %))
+                      :choices
+                      (mapv :title)))
+              "listProperties lists them in the same order"))))))
+
+(deftest classes-set-restricts-node-property-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self blocks client service vip acme audit zed for-client clients]}]
+        (let [[b0 b1 b2 b3 b4 b5 b6 b7] blocks
+              audit-id (:db/id (entity conn audit))]
+          (p/let [restricted (restrict! self for-client :set ["Client"])
+                  _ (restrict! self clients :set [(str (:block/uuid client))])
+                  by-title (request! self "PUT" (value-path b0 for-client) {:value "Audit"})
+                  by-uuid (request! self "PUT" (value-path b1 for-client) {:value (str audit)})
+                  by-ident (request! self "PUT" (value-path b2 for-client) {:value (ident-str (:db/ident service))})
+                  by-db-id (request! self "PUT" (value-path b3 for-client) {:value audit-id})
+                  missing (request! self "PUT" (value-path b3 for-client) {:value (str (random-uuid))})
+                  mixed-list (request! self "PUT" (value-path b4 clients) {:value [(str acme) (str audit)]})
+                  accepted (request! self "PUT" (value-path b5 for-client) {:value (str acme)})
+                  inherited (request! self "PUT" (value-path b6 for-client) {:value (str zed)})
+                  accepted-list (request! self "PUT" (value-path b7 clients) {:value [(str acme) (str zed)]})
+                  got (request! self "GET" (property-path for-client) nil)]
+            (is (= 200 (:status restricted)) (str (:body restricted)))
+            (is (= [{:uuid (str (:block/uuid client)) :title "Client" :ident (ident-str (:db/ident client))}]
+                   (get-in restricted [:body :classes]))
+                "updateProperty answers the classes it set")
+            (is (= [(str (:block/uuid client))] (mapv :uuid (get-in got [:body :classes])))
+                "getProperty reads the classes back")
+            (testing "a value that isn't a Client object is refused however it is given"
+              (is (= 400 (:status by-title)) (str (:body by-title)))
+              (is (= "no #Client object titled \"Audit\"" (get-in by-title [:body :error]))
+                  "a title keeps its own wording")
+              (is (= "property value must resolve to an existing entity by UUID, ident, or title"
+                     (get-in missing [:body :error]))
+                  "a UUID that names nothing is not reported as out of class")
+              (is (= 400 (:status by-uuid)) (str (:body by-uuid)))
+              (is (= (str "no #Client object " audit) (get-in by-uuid [:body :error])))
+              (is (= 400 (:status by-ident)) (str (:body by-ident)))
+              (is (string/includes? (str (get-in by-ident [:body :error])) "no #Client object")
+                  (str (:body by-ident)))
+              (is (= 400 (:status by-db-id)) (str (:body by-db-id)))
+              (is (= 400 (:status mixed-list)) (str (:body mixed-list)))
+              (doseq [id [b0 b1 b2 b3]]
+                (is (nil? (stored conn id for-client)) "nothing is stored"))
+              (is (nil? (stored conn b4 clients)) "nothing of a refused list is stored"))
+            (testing "a Client object by UUID is accepted, also through a tag that extends Client"
+              (is (= 200 (:status accepted)) (str (:body accepted)))
+              (is (= acme (stored conn b5 for-client)))
+              (is (= 200 (:status inherited)) (str (:body inherited)))
+              (is (= zed (stored conn b6 for-client)))
+              (is (= 200 (:status accepted-list)) (str (:body accepted-list)))
+              (is (= #{acme zed} (stored conn b7 clients))))
+            (is (some? vip))))))))
+
+(deftest class-check-leaves-other-properties-alone-test
+  ;; The class check runs only for a property with classes: an unrestricted node property and a
+  ;; property with choices resolve UUIDs as before, and a built-in property limited to Page
+  ;; (Assignee) now refuses a block given by UUID, as the app's picker does.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self blocks acme audit for-client]}]
+        (let [[b0 b1 b2 b3] blocks]
+          (p/let [status (outliner-property/upsert-property!
+                          conn nil {:logseq.property/type :default :db/cardinality :db.cardinality/one}
+                          {:property-name "stage"})
+                  status (:db/ident status)
+                  active (random-uuid)
+                  _ (outliner-property/upsert-closed-value! conn status {:id active :value "Active"})
+                  unrestricted (request! self "PUT" (value-path b0 for-client) {:value (str audit)})
+                  choice (request! self "PUT" (value-path b1 status) {:value (str active)})
+                  assignee-block (request! self "PUT" (value-path b2 :logseq.property/assignee) {:value (str (nth blocks 7))})
+                  assignee-page (request! self "PUT" (value-path b3 :logseq.property/assignee) {:value (str acme)})]
+            (is (= 200 (:status unrestricted)) (str (:body unrestricted)))
+            (is (= audit (stored conn b0 for-client)))
+            (is (= 200 (:status choice)) (str (:body choice)))
+            (is (= active (stored conn b1 status)))
+            (is (= 400 (:status assignee-block)) (str (:body assignee-block)))
+            (is (string/includes? (str (get-in assignee-block [:body :error])) "no #Page object")
+                (str (:body assignee-block)))
+            (is (= 200 (:status assignee-page)) (str (:body assignee-page)))
+            (is (= #{acme} (stored conn b3 :logseq.property/assignee)))))))))
+
+(deftest class-check-covers-every-write-path-test
