+(deftest choices-rename-chain-any-order-test
+  ;; A rename may take a title another rename in the same call frees, whatever order the entries
+  ;; come in: the renames are applied so a title is freed before it is taken. For text (ignoring
+  ;; case), number and URL choices alike.
+  (async done
+    (with-choices done
+      (fn [{:keys [conn self status score site]}]
+        (let [active (choice-uuid conn status "Active")
+              done-id (choice-uuid conn status "Done")
+              backlog (choice-uuid conn status "Backlog")]
+          (p/let [chain (choices! self status {:update [{:choice "Backlog" :title "Active"}
+                                                        {:choice "Active" :title "Done2"}]})
+                  after-chain (choice-titles conn status)
+                  chain-ids (mapv #(choice-uuid conn status %) ["Done2" "Done" "Active"])
+                  three (choices! self status {:update [{:choice "Done" :title "Live"}
+                                                        {:choice "Done2" :title "Done"}
+                                                        {:choice (str backlog) :title "done2"}]})
+                  after-three (choice-titles conn status)
+                  three-ids (mapv #(choice-uuid conn status %) ["Done" "Live" "done2"])
+                  ;; titles that differ only in case may swap: neither is held as written
+                  swap-case (choices! self status {:update [{:choice "Done" :title "live"}
+                                                            {:choice "Live" :title "done"}]})
+                  after-swap-case (choice-titles conn status)
+                  ;; a choice given its own title holds it already, and is no cycle
+                  own (choices! self status {:update [{:choice "done2" :title "done2" :description "Parked"}]})
+                  _ (choices! self score {:add [{:title "2"}]})
+                  number (choices! self score {:update [{:choice "1" :title "2"} {:choice "2" :title 3}]})
+                  _ (choices! self site {:add [{:title "https://b.example.com"}]})
+                  url (choices! self site {:update [{:choice "https://a.example.com" :title "https://b.example.com"}
+                                                    {:choice "https://b.example.com" :title "https://c.example.com"}]})]
+            (is (= 200 (:status chain)) (str (:body chain)))
+            (is (= ["Done2" "Done" "Active"] after-chain))
+            (is (= [active done-id backlog] chain-ids)
+                "each renamed choice keeps its UUID")
+            (is (= 200 (:status three)) (str (:body three)))
+            (is (= ["Done" "Live" "done2"] after-three))
+            (is (= [active done-id backlog] three-ids))
+            (is (= 200 (:status swap-case)) (str (:body swap-case)))
+            (is (= ["live" "done" "done2"] after-swap-case))
+            (is (= 200 (:status own)) (str (:body own)))
+            (is (= 200 (:status number)) (str (:body number)))
+            (is (= [2 3] (mapv :value (get-in number [:body :choices]))))
+            (is (= 200 (:status url)) (str (:body url)))
+            (is (= ["https://b.example.com" "https://c.example.com"] (choice-titles conn site)))))))))
+
+(deftest choices-rename-cycle-refused-test
+  ;; Renames that move titles round a cycle (a swap, or three choices in turn) can't be applied one
+  ;; at a time, so the call is refused up front, naming the entry and the cycle, and nothing is written.
+  ;; A number title is held by value: 1.0 is the title 1.
+  (async done
+    (with-choices done
+      (fn [{:keys [conn self status score]}]
+        (let [initial (choice-titles conn status)]
+          (p/let [swap (choices! self status {:update [{:choice "Active" :title "Done"}
+                                                       {:choice "Done" :title "Active"}]})
+                  rotate (choices! self status {:update [{:choice "Active" :title "Done"}
+                                                         {:choice "Done" :title "Backlog"}
+                                                         {:choice "Backlog" :title "Active"}]})
+                  twice (choices! self status {:update [{:choice "Active" :title "Done"}
+                                                        {:choice "Done" :title "Active"}
+                                                        {:choice "active" :icon nil}]})
+                  _ (choices! self score {:add [{:title "2"}]})
+                  number (choices! self score {:update [{:choice "1" :title "2"} {:choice "2" :title "1.0"}]})]
+            (is (= 400 (:status swap)) (str (:body swap)))
+            (is (= (str "choices.update 1: \"Active\" is the title of the choice choices.update 0 renames, and "
+                        "the renames form a cycle (choices.update 0, choices.update 1); rename one of them to a "
+                        "spare title in a separate call first")
+                   (get-in swap [:body :error])))
+            (is (= 400 (:status rotate)) (str (:body rotate)))
+            (is (= (str "choices.update 2: \"Active\" is the title of the choice choices.update 0 renames, and "
+                        "the renames form a cycle (choices.update 0, choices.update 1, choices.update 2); rename one "
+                        "of them to a spare title in a separate call first")
+                   (get-in rotate [:body :error])))
+            (is (= (str "choices.update 2: \"Active\" is already updated in choices.update 0; "
+                        "choices.update 1: \"Active\" is the title of the choice choices.update 0 renames, and "
+                        "the renames form a cycle (choices.update 0, choices.update 1); rename one of them to a "
+                        "spare title in a separate call first")
+                   (get-in twice [:body :error]))
+                "a choice updated twice is named once, and the cycle names its first update")
+            (is (= initial (choice-titles conn status)) "nothing is written")
+            (is (= 400 (:status number)) (str (:body number)))
+            (is (string/includes? (str (get-in number [:body :error])) "the renames form a cycle (choices.update 0, choices.update 1)"))
+            (is (= ["1" "2"] (choice-titles conn score)))))))))
+
