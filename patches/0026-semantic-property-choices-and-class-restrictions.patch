+(deftest choices-add-returns-uuid-and-unique-key-test
+  ;; Upstream keys a new choice after the property's own last choice. 200 blocks keyed after that
+  ;; key (the 0008 shape) mean that key is already held, so the handler must take the next key
+  ;; after the graph's max instead.
+  (async done
+    (with-choices done
+      (fn [{:keys [conn self page-id status quadrant]}]
