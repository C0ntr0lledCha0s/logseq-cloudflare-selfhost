+                  ;; A connected client, to see which calls announce a change.
+                  _ (set! (.-state self) #js {:getWebSockets (fn [] #js [#js {:readyState 1 :send #(swap! sent inc)}])})
+                  before (snapshot conn)
+                  dry (retire! self status ["Backlog"] "dry-run=true")
+                  dry-ack (retire! self status ["Backlog"] "dry-run=true&acknowledge-holders=true")
+                  dry-mixed (request! self "PATCH" (str (property-path status) "?dry-run=true")
+                                      {:title "project-state"
