+  "converted: {values holders}, and on a dry run the mapping: one row per distinct text."
+  [{:keys [values holders]} dry-run?]
+  (cond-> {:converted {:values (count values) :holders (count holders)}}
+    dry-run?
+    (assoc :mapping (mapv (fn [[text rows]]
+                            {:text text
+                             :choice {:uuid (uuid-string (:uuid (:choice (first rows))))
+                                      :title (:text (:choice (first rows)))}
+                             :holders (count (into #{} (mapcat :holders) rows))})
+                          (reduce (fn [groups {:keys [text] :as value}]
+                                    (if-let [i (first (keep-indexed #(when (= text (first %2)) %1) groups))]
+                                      (update-in groups [i 1] conj value)
+                                      (conj groups [text [value]])))
+                                  [] values)))))
