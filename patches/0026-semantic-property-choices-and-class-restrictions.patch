+                                              {:choice (str done-id) :icon nil :description "Finished"}
+                                              {:choice "Backlog" :icon {:type "tabler-icon" :id "inbox"}}]})
+                  after-update (choice-titles conn status)
+                  ordered (choices! self status {:add [{:title "Proposal"}]
+                                                 :order ["proposal" "Backlog" (str done-id) "In progress"]})
+                  got (request! self "GET" (property-path status) nil)]
+            (is (= 200 (:status updated)) (str (:body updated)))
+            (is (= ["In progress" "Done" "Backlog"] after-update) "a rename keeps the choice's place")
+            (is (= active (choice-uuid conn status "In progress")) "and its UUID")
+            (is (= {:type :emoji :id "rocket"} (:logseq.property/icon (entity conn active)))
