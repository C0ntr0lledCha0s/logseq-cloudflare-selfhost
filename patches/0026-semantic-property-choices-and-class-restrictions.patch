+                                    {:choices {:add [{:title "Proposal"}] :retire ["Backlog"]}})
+                  both (retire! self status ["Backlog" "Done" "Active"])
+                  declined (retire! self status ["Backlog"] "acknowledge-holders=false")
+                  invalid (retire! self status ["Backlog"] "acknowledge-holders=yes")
