+(deftest update-tag-extends-replaces-test
+  (async done
+    (with-tags done
+      (fn [{:keys [conn self client service company]}]
+        (let [client-id (:block/uuid client)]
+          (p/let [replaced (request! self "PATCH" (tag-path client-id) {:extends ["Organisation"]})
+                  after-replace (extends-titles conn client-id)
+                  by-ident (request! self "PATCH" (tag-path client-id) {:extends [(ident-str (:db/ident company))]})
+                  after-ident (extends-titles conn client-id)
+                  ;; Organisation is already an ancestor of Company, so the outliner keeps only Company.
+                  redundant (request! self "PATCH" (tag-path client-id) {:extends ["Organisation" "Company"]})
+                  after-redundant (extends-titles conn client-id)
+                  two (request! self "PATCH" (tag-path client-id) {:extends [(str (:block/uuid service)) "company"]})
+                  after-two (extends-titles conn client-id)
+                  empty-list (request! self "PATCH" (tag-path client-id) {:extends []})
+                  not-list (request! self "PATCH" (tag-path client-id) {:extends "Company"})]
+            (is (= 200 (:status replaced)) (str (:body replaced)))
+            (is (= #{"Organisation"} after-replace) "extends replaces the set")
+            (is (= ["Organisation"] (mapv :title (get-in replaced [:body :extends]))))
+            (is (= 200 (:status by-ident)) (str (:body by-ident)))
+            (is (= #{"Company"} after-ident) "an ident names a tag")
+            (is (= 200 (:status redundant)) (str "a redundant ancestor is not a failed write: " (:body redundant)))
+            (is (= #{"Company"} after-redundant))
+            (is (= ["Company"] (mapv :title (get-in redundant [:body :extends]))) "the response shows what is stored")
+            (is (= 200 (:status two)) (str (:body two)))
+            (is (= #{"Service" "Company"} after-two) "a UUID and a title ignoring case both name a tag")
+            (is (= 400 (:status empty-list)) (str (:body empty-list)))
+            (is (= "extends: name at least one tag" (get-in empty-list [:body :error])))
+            (is (= 400 (:status not-list)) (str (:body not-list)))
+            (is (= "extends: give a list of tag UUIDs, idents or titles" (get-in not-list [:body :error])))
+            (is (= #{"Service" "Company"} (extends-titles conn client-id)) "a refused call changes nothing")))))))
+
+(deftest extends-cycle-refused-test
+  (async done
+    (with-tags done
+      (fn [{:keys [conn self client organisation company]}]
+        (p/let [through (request! self "PATCH" (tag-path (:block/uuid organisation)) {:extends ["Service" "Client"]})
+                direct (request! self "PATCH" (tag-path (:block/uuid company)) {:extends ["Client"]})
+                self-extend (request! self "PATCH" (tag-path (:block/uuid client)) {:extends [(str (:block/uuid client))]})
+                with-title (request! self "PATCH" (tag-path (:block/uuid organisation))
+                                     {:title "Org" :extends ["Client"]})]
+          (is (= 400 (:status through)) (str (:body through)))
+          (is (= "extends 1: Client already extends Organisation through Company" (get-in through [:body :error]))
+              "the refusal names the path")
+          (is (= 400 (:status direct)) (str (:body direct)))
+          (is (= "extends 0: Client already extends Company" (get-in direct [:body :error])))
+          (is (= 400 (:status self-extend)) (str (:body self-extend)))
+          (is (= "extends 0: Client can't extend itself" (get-in self-extend [:body :error])))
+          (is (= 400 (:status with-title)) (str (:body with-title)))
+          (is (= "Organisation" (:block/title (entity conn (:block/uuid organisation)))) "nothing changes, not even the title")
+          (is (not (contains? (extends-titles conn (:block/uuid organisation)) "Client")))
+          (is (= #{"Organisation"} (extends-titles conn (:block/uuid company))))
+          (is (= #{"Company"} (extends-titles conn (:block/uuid client)))))))))
+
+(deftest tag-refusals-test
+  (async done
+    (with-tags done
+      (fn [{:keys [conn self client service acme for-client for-service]}]
+        (let [client-id (:block/uuid client)
+              path (tag-path client-id)]
+          (p/let [recycled (outliner-property/upsert-property!
+                            conn nil {:logseq.property/type :default :db/cardinality :db.cardinality/one}
+                            {:property-name "old-notes"})
+                  _ (d/transact! conn [[:db/add (:db/id recycled) :logseq.property/deleted-at 1]])
+                  tag-uuid (request! self "PATCH" path {:properties {:add [(str (:block/uuid service))]}})
+                  tag-ident (request! self "PATCH" path {:properties {:add [(ident-str (:db/ident service))]}})
+                  recycled-one (request! self "PATCH" path {:properties {:add ["old-notes"]}})
+                  unknown (request! self "PATCH" path {:properties {:add ["for-clinet"]}})
+                  hidden (request! self "PATCH" path {:properties {:add ["engagement-partner" "logseq.property/classes"]}})
+                  a-tag (request! self "PATCH" path {:properties {:add ["Service"]}})
+                  not-strings (request! self "PATCH" path {:properties {:add [1]}})
+                  two-modes (request! self "PATCH" path {:properties {:add ["engagement-partner"] :remove ["for-client"]}})
+                  no-mode (request! self "PATCH" path {:properties {}})
+                  not-a-tag (request! self "PATCH" path {:extends ["Acme Ltd"]})
+                  a-property (request! self "PATCH" path {:extends ["for-client"]})
+                  empty-body (request! self "PATCH" path {})
+                  blank-title (request! self "PATCH" path {:title " "})
+                  number-title (request! self "PATCH" path {:title 5 :extends ["Organisation"]})
+                  page-path (request! self "PATCH" (tag-path acme) {:title "Acme Corp"})
+                  create-unknown (request! self "POST" "/semantic/tags" {:title "Team" :extends ["Organisaton"] :properties ["for-clinet"]})
+                  create-not-list (request! self "POST" "/semantic/tags" {:title "Squad" :properties {:add ["for-client"]}})
+                  renamed (request! self "PATCH" path {:title "Customer"})]
+            (is (= 400 (:status unknown)) (str (:body unknown)))
+            (is (= "properties.add 0: no property \"for-clinet\"" (get-in unknown [:body :error])))
+            (is (= 400 (:status hidden)) (str (:body hidden)))
+            (is (= "properties.add 1: no property \"logseq.property/classes\"" (get-in hidden [:body :error]))
+                "a hidden built-in property is not a tag property")
+            (is (= "properties.add 0: no property \"Service\"" (get-in a-tag [:body :error])) "a tag is not a property")
+            (is (= (str "properties.add 0: no property \"" (:block/uuid service) "\"") (get-in tag-uuid [:body :error]))
+                "not by UUID either")
+            (is (= (str "properties.add 0: no property \"" (ident-str (:db/ident service)) "\"") (get-in tag-ident [:body :error]))
+                "nor by ident")
+            (is (= "properties.add 0: no property \"old-notes\"" (get-in recycled-one [:body :error]))
+                "a recycled property is not one")
+            (is (= "properties.add: give a list of property UUIDs, idents or titles" (get-in not-strings [:body :error])))
+            (is (= "properties: give exactly one of set, add or remove" (get-in two-modes [:body :error])))
+            (is (= "properties: give exactly one of set, add or remove" (get-in no-mode [:body :error])))
+            (is (= "extends 0: no tag \"Acme Ltd\"" (get-in not-a-tag [:body :error])) "a page is not a tag")
+            (is (= "extends 0: no tag \"for-client\"" (get-in a-property [:body :error])) "a property is not a tag")
+            (is (= 400 (:status empty-body)) (str (:body empty-body)))
+            (is (= "give at least one of title, extends or properties" (get-in empty-body [:body :error])))
+            (is (= 400 (:status blank-title)) (str (:body blank-title)))
+            (is (= "title: give a title that isn't blank" (get-in blank-title [:body :error])))
+            (is (= "title: give a title that isn't blank" (get-in number-title [:body :error])))
+            (is (= "invalid tag-id or title" (get-in page-path [:body :error])) "a page is not a tag")
+            (is (= "Acme" (:block/title (entity conn acme))))
+            (is (= 400 (:status create-unknown)) (str (:body create-unknown)))
+            (is (= "extends 0: no tag \"Organisaton\"; properties 0: no property \"for-clinet\""
+                   (get-in create-unknown [:body :error]))
+                "every refused entry is named")
+            (is (empty? (d/datoms @conn :avet :block/title "Team")) "a refused create writes nothing")
+            (is (= 400 (:status create-not-list)) (str (:body create-not-list)))
+            (is (= "properties: give a list of property UUIDs, idents or titles" (get-in create-not-list [:body :error])))
+            (is (empty? (d/datoms @conn :avet :block/title "Squad")))
+            (is (= #{for-client for-service} (tag-property-idents conn client-id)) "no refused call changed the tag")
+            (is (= 200 (:status renamed)) (str (:body renamed)))
+            (is (= "Customer" (get-in renamed [:body :title])) "a title-only update still renames")
+            (is (= "Customer" (:block/title (entity conn client-id))))
+            (is (= #{"Company"} (extends-titles conn client-id)) "renaming leaves extends alone")
+            (is (= #{for-client for-service} (tag-property-idents conn client-id)) "and the tag properties")))))))
+
