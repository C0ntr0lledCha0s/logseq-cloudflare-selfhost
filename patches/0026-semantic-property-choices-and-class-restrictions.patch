+            (is (nil? (:logseq.property/icon (entity conn done-id))) "icon null clears it")
+            (is (= "Finished" (some-> (entity conn done-id) :logseq.property/description db-property/property-value-content)))
+            (is (= {:type :tabler-icon :id "inbox"} (:logseq.property/icon (entity conn (choice-uuid conn status "Backlog")))))
+            (is (= 200 (:status ordered)) (str (:body ordered)))
