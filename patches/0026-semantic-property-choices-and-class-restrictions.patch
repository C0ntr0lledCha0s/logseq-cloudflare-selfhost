+;; Tags: extends and tag properties through createTag, updateTag and getTag. The graph adds tags
+;; Organisation and Company, with Client extending Company and Company extending Organisation, and
+;; properties for-service and engagement-partner. Client starts with for-client and for-service as
+;; its tag properties.
+
+(defn- tag-path [tag]
+  (str "/semantic/tags/" (if (uuid? tag) tag (js/encodeURIComponent (ident-str tag)))))
+
+(defn- with-tags
+  [done run]
+  (with-graph done
+    (fn [{:keys [conn self client for-client] :as graph}]
+      (p/let [tag! (fn [title] (p/let [r (request! self "POST" "/semantic/tags" {:title title})]
+                                 (entity conn (uuid (get-in r [:body :uuid])))))
+              organisation (tag! "Organisation")
+              company (tag! "Company")
+              for-service (outliner-property/upsert-property!
+                           conn nil {:logseq.property/type :node :db/cardinality :db.cardinality/one}
+                           {:property-name "for-service"})
+              partner (outliner-property/upsert-property!
+                       conn nil {:logseq.property/type :node :db/cardinality :db.cardinality/one}
+                       {:property-name "engagement-partner"})
+              _ (outliner-property/set-block-property! conn (:db/id company) :logseq.property.class/extends (:db/id organisation))
+              _ (outliner-property/set-block-property! conn (:db/id client) :logseq.property.class/extends (:db/id company))
+              _ (outliner-property/class-add-property! conn (:db/id client) for-client)
+              _ (outliner-property/class-add-property! conn (:db/id client) (:db/ident for-service))]
+        (run (assoc graph
+                    :organisation (entity conn (:block/uuid organisation))
+                    :company (entity conn (:block/uuid company))
+                    :for-service (:db/ident for-service)
+                    :partner (:db/ident partner)))))))
+
+(defn- tag-property-idents [conn tag-uuid]
+  (set (map :db/ident (:logseq.property.class/properties (entity conn tag-uuid)))))
+
+(defn- extends-titles [conn tag-uuid]
+  (set (map :block/title (:logseq.property.class/extends (entity conn tag-uuid)))))
+
+(deftest update-tag-properties-add-keeps-others-test
+  (async done
+    (with-tags done
+      (fn [{:keys [conn self client for-client for-service partner]}]
+        (let [client-id (:block/uuid client)
+              partner-uuid (:block/uuid (d/entity @conn partner))]
+          (p/let [added (request! self "PATCH" (tag-path client-id) {:properties {:add ["engagement-partner"]}})
+                  after-add (tag-property-idents conn client-id)
+                  removed (request! self "PATCH" (tag-path client-id) {:properties {:remove [(ident-str for-service)]}})
+                  after-remove (tag-property-idents conn client-id)
+                  got (request! self "GET" (tag-path client-id) nil)
+                  ;; Adding what is already there, by UUID, changes nothing.
+                  again (request! self "PATCH" (tag-path client-id) {:properties {:add [(str partner-uuid)]}})]
+            (is (= 200 (:status added)) (str (:body added)))
+            (is (= #{for-client for-service partner} after-add) "add keeps the tag's other properties")
+            (is (= #{"for-client" "for-service" "engagement-partner"} (set (map :title (get-in added [:body :properties]))))
+                "updateTag answers the tag's properties")
+            (is (= 200 (:status removed)) (str (:body removed)))
+            (is (= #{for-client partner} after-remove) "remove leaves the others")
+            (is (= #{"for-client" "engagement-partner"} (set (map :title (get-in got [:body :properties]))))
+                "getTag agrees")
+            (is (= ["Company"] (mapv :title (get-in got [:body :extends]))) "getTag shows what the tag extends")
+            (is (= 200 (:status again)) (str (:body again)))
+            (is (= #{for-client partner} (tag-property-idents conn client-id)))))))))
+
+(deftest update-tag-properties-set-keeps-built-ins-test
