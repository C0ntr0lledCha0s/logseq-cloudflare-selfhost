+(deftest choices-write-is-read-back-test
+  ;; The handlers read the property back after the write. A listener that moves the choice titled
+  ;; `title` (one of the property's own) first as soon as the write lands stands in for an outliner that didn't store the order
+  ;; asked: createProperty and updateProperty must answer 500 naming it, not success.
+  (async done
+    (with-choices done
+      (fn [{:keys [conn self status]}]
+        (let [tamper! (fn [property-title title]
+                        (d/listen! conn ::tamper
+                                   (fn [{:keys [db-after tx-data]}]
+                                     (when-let [choice (some->> (d/datoms db-after :avet :block/title title)
+                                                                (map #(d/entity db-after (:e %)))
+                                                                (filter #(= property-title (:block/title (:block/parent %))))
+                                                                (filter :block/closed-value-property)
+                                                                first)]
+                                       (when (seq tx-data)
+                                         (d/unlisten! conn ::tamper)
+                                         (d/transact! conn [[:db/add (:db/id choice) :block/order "0"]]))))))]
+          (tamper! "stage" "Build")
+          (p/let [created (request! self "POST" "/semantic/properties"
+                                    {:title "stage" :choices [{:title "Plan"} {:title "Build"}]})
+                  _ (tamper! "project-status" "Proposal")
+                  updated (choices! self status {:add [{:title "Proposal"}]})]
+            (is (= 500 (:status created)) (str (:body created)))
+            (is (= "the write did not store what was asked: choices not in the order asked: \"Build\", \"Plan\""
+                   (get-in created [:body :error])))
+            (is (= 500 (:status updated)) (str (:body updated)))
+            (is (= (str "the write did not store what was asked: choices not in the order asked: "
+                        "\"Proposal\", \"Active\", \"Done\", \"Backlog\"")
+                   (get-in updated [:body :error])))))))))
