+(deftest extends-built-in-tag-refused-test
+  ;; The app's extends picker hides the private and block-kind built-in tags (Tag, Page, Journal,
+  ;; Query, Template, ...); createTag and updateTag refuse them by title, ident or UUID. A user tag
+  ;; is still allowed.
+  (async done
+    (with-tags done
+      (fn [{:keys [conn self client]}]
+        (let [path (tag-path (:block/uuid client))
+              page-uuid (str (:block/uuid (d/entity @conn :logseq.class/Page)))]
+          (p/let [tag (request! self "PATCH" path {:extends ["Tag"]})
+                  page (request! self "PATCH" path {:extends [page-uuid]})
+                  journal (request! self "PATCH" path {:extends ["logseq.class/Journal"]})
+                  query (request! self "PATCH" path {:extends ["Organisation" "Query"]})
+                  template (request! self "PATCH" path {:extends ["Template"]})
+                  property (request! self "PATCH" path {:extends ["Property"]})
+                  created (request! self "POST" "/semantic/tags" {:title "Diary" :extends ["Page"]})
+                  unchanged (extends-titles conn (:block/uuid client))
+                  user-tag (request! self "PATCH" path {:extends ["Organisation"]})]
+            (is (= 400 (:status tag)) (str (:body tag)))
+            (is (= "extends 0: Tag is a built-in tag that other tags can't extend" (get-in tag [:body :error])))
+            (is (= "extends 0: Page is a built-in tag that other tags can't extend" (get-in page [:body :error])) "by UUID")
+            (is (= "extends 0: Journal is a built-in tag that other tags can't extend" (get-in journal [:body :error])) "by ident")
+            (is (= "extends 1: Query is a built-in tag that other tags can't extend" (get-in query [:body :error])) "a block-kind tag")
+            (is (= "extends 0: Template is a built-in tag that other tags can't extend" (get-in template [:body :error])))
+            (is (= "extends 0: Property is a built-in tag that other tags can't extend" (get-in property [:body :error])))
+            (is (= 400 (:status created)) (str (:body created)))
+            (is (= "extends 0: Page is a built-in tag that other tags can't extend" (get-in created [:body :error])))
+            (is (empty? (d/datoms @conn :avet :block/title "Diary")) "a refused create writes nothing")
+            (is (= #{"Company"} unchanged) "no refused call changed the tag")
+            (is (= 200 (:status user-tag)) (str (:body user-tag)))
+            (is (= #{"Organisation"} (extends-titles conn (:block/uuid client))))))))))
+
+(deftest choices-order-names-the-titles-the-call-leaves-test
+  ;; order names a choice by the title the call leaves it with, so a title a rename frees and an
+  ;; add takes names the new choice; a title the call frees and nothing takes still names its choice.
+  (async done
+    (with-choices done
+      (fn [{:keys [conn self status]}]
+        (let [active (choice-uuid conn status "Active")
+              done-id (choice-uuid conn status "Done")]
+          (p/let [reused (choices! self status {:update [{:choice "Active" :title "Doing"}]
+                                                :add [{:title "Active"}]
+                                                :order ["Active" "Doing" "Done" "Backlog"]})
+                  new-active (choice-uuid conn status "Active")
+                  after-reused (choice-titles conn status)
+                  chain (choices! self status {:update [{:choice "Done" :title "Finished"}
+                                                        {:choice "Doing" :title "Done"}]
+                                               :order ["Done" "Finished" "Active" "Backlog"]})
+                  chain-ids [(choice-uuid conn status "Done") (choice-uuid conn status "Finished")]
+                  freed (choices! self status {:update [{:choice "Backlog" :title "Later"}]
+                                               :order ["Backlog" "Done" "Finished" "Active"]})]
+            (is (= 200 (:status reused)) (str (:body reused)))
+            (is (= ["Active" "Doing" "Done" "Backlog"] after-reused))
+            (is (not= active new-active) "Active is the choice added in the call")
+            (is (= 200 (:status chain)) (str (:body chain)))
+            (is (= [active done-id] chain-ids)
+                "a rename chain is ordered by its final titles")
+            (is (= 200 (:status freed)) (str (:body freed)))
+            (is (= ["Later" "Done" "Finished" "Active"] (choice-titles conn status))
+                "a title the call frees and nothing takes still names its choice")))))))
+
+(deftest convert-values-child-blocks-refused-test
+  ;; Deleting a text value block deletes the blocks under it, which the caller never named, so a
+  ;; value block with child blocks refuses the conversion, dry run included, naming its holder.
+  (async done
+    (with-choices done
+      (fn [{:keys [conn self phase blocks]}]
+        (let [[b0 b1] blocks
+              child (random-uuid)
+              grandchild (random-uuid)]
+          (p/let [_ (hold! self b0 phase "Active")
+                  _ (hold! self b1 phase "Active")
+                  value (entity conn (stored conn b0 phase))
+                  _ (d/transact! conn [{:block/uuid child :block/title "a note" :block/parent (:db/id value)
+                                        :block/page (:db/id (:block/page value)) :block/order "a0"
+                                        :block/created-at 1 :block/updated-at 1}
+                                       {:block/uuid grandchild :block/title "more" :block/parent [:block/uuid child]
+                                        :block/page (:db/id (:block/page value)) :block/order "a0"
+                                        :block/created-at 1 :block/updated-at 1}])
+                  _ (add-choice! conn phase "Active")
+                  before (snapshot conn)
+                  dry (convert! self phase {} "dry-run=true")
+                  real (convert! self phase {})
+                  after (snapshot conn)]
+            (doseq [response [dry real]]
+              (is (= 400 (:status response)) (str (:body response)))
+              (is (= (str "convert_values: " b0 " value \"Active\" has 2 child blocks; move or delete them first")
+                     (get-in response [:body :error]))))
+            (is (true? (= before after)) "nothing was written")
+            (is (some? (entity conn grandchild)) "the child blocks are kept")))))))
+
+(deftest convert-values-default-value-refused-test
+  ;; A text property with a default value: the outliner's delete keeps a lone value block of such a
+  ;; property, and the default would stay text. The conversion is refused, dry run included, and
+  ;; nothing is written.
+  (async done
+    (with-choices done
+      (fn [{:keys [conn self phase blocks]}]
+        (p/let [_ (outliner-property/create-property-text-block! conn (:db/id (d/entity @conn phase))
+                                                                 :logseq.property/default-value "Open" {})
+                _ (hold! self (first blocks) phase "Active")
+                _ (add-choice! conn phase "Active")
+                before (snapshot conn)
+                dry (convert! self phase {:choices {:add [{:title "Open"}]}} "dry-run=true")
+                real (convert! self phase {:choices {:add [{:title "Open"}]}})
+                after (snapshot conn)]
+          (doseq [response [dry real]]
+            (is (= 400 (:status response)) (str (:body response)))
+            (is (= "convert_values: phase has a default value \"Open\"; clear it in the app's property settings first"
+                   (get-in response [:body :error]))))
+          (is (true? (= before after)) "nothing was written"))))))
+
+(deftest convert-values-leaves-empty-placeholder-test
+  ;; Logseq stores its empty placeholder as the value of a block that holds a property's default;
+  ;; a conversion leaves it as it is, as it does a value that is already a choice.
+  (async done
+    (with-choices done
+      (fn [{:keys [conn self phase blocks]}]
+        (let [[b0 b1] blocks]
+          (p/let [_ (hold! self b0 phase "Active")
+                  _ (d/transact! conn [[:db/add (:db/id (entity conn b1)) phase :logseq.property/empty-placeholder]])
+                  active (add-choice! conn phase "Active")
+                  converted (convert! self phase {})]
+            (is (= 200 (:status converted)) (str (:body converted)))
+            (is (= {:values 1 :holders 1} (get-in converted [:body :converted])))
+            (is (= active (stored conn b0 phase)))
+            (is (= :logseq.property/empty-placeholder (:db/ident (get (entity conn b1) phase))))))))))
+
+(deftest built-in-property-classes-refused-test
+  ;; The outliner allows only hide-empty-value and description on a built-in property, and the app
+  ;; disables its tag picker, so its classes can't be set, added to, removed or cleared, named by
+  ;; ident or by UUID, dry run included. A user property's classes still change.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self for-client]}]
+        (let [assignee-uuid (:block/uuid (d/entity @conn :logseq.property/assignee))
+              before (class-uuids conn :logseq.property/assignee)
+              by-uuid (str "/semantic/properties/" assignee-uuid)
+              message "classes: Assignee is a built-in property and its classes can't be changed"]
+          (p/let [set-one (restrict! self :logseq.property/assignee :set ["Client"])
+                  cleared (restrict! self :logseq.property/assignee :set [])
+                  added (restrict! self :logseq.property/assignee :add ["Client"])
+                  removed (restrict! self :logseq.property/assignee :remove ["Page"])
+                  uuid-path (request! self "PATCH" by-uuid {:classes {:set ["Client"]}})
+                  dry (request! self "PATCH" (str (property-path :logseq.property/assignee) "?dry-run=true")
+                                {:classes {:set ["Client"]}})
+                  user (restrict! self for-client :set ["Client"])]
+            (is (seq before) "Assignee is limited to Page")
+            (doseq [response [set-one cleared added removed uuid-path dry]]
+              (is (= 400 (:status response)) (str (:body response)))
+              (is (= message (get-in response [:body :error]))))
+            (is (= before (class-uuids conn :logseq.property/assignee)) "Assignee's classes are unchanged")
+            (is (= 200 (:status user)) (str (:body user)))))))))
+
+(deftest retire-default-value-choice-test
+  ;; A choice that is the property's default value is shown by every block that relies on the
+  ;; default (they hold the empty placeholder), so retiring it is refused like a held choice:
+  ;; 409 naming it unless acknowledge-holders=true, and dry-run and the response say so.
+  (async done
+    (with-choices done
+      (fn [{:keys [conn self status blocks]}]
+        (let [[b0 b1 b2] blocks
+              backlog (choice-uuid conn status "Backlog")
+              done-id (choice-uuid conn status "Done")
+              property-id (:db/id (d/entity @conn status))
+              default (fn [] (:block/uuid (:logseq.property/default-value (d/entity @conn status))))]
+          (p/let [_ (outliner-property/set-block-property! conn property-id :logseq.property/default-value
+                                                           (:db/id (entity conn backlog)))
+                  _ (d/transact! conn [[:db/add (:db/id (entity conn b0)) status :logseq.property/empty-placeholder]])
+                  default-before (default)
+                  refused (retire! self status ["Backlog"])
+                  _ (hold! self b1 status "Done")
+                  with-held (retire! self status ["Done" "Backlog"])
+                  _ (hold! self b2 status "Backlog")
+                  held-and-default (retire! self status ["Backlog"])
+                  _ (request! self "DELETE" (value-path b1 status) nil)
+                  _ (request! self "DELETE" (value-path b2 status) nil)
+                  default-after (default)
+                  titles-after (choice-titles conn status)
+                  before (snapshot conn)
+                  dry (retire! self status ["Backlog"] "dry-run=true")
+                  after-dry (snapshot conn)
+                  real (retire! self status ["Backlog"] "acknowledge-holders=true")]
+            (is (= backlog default-before) "Backlog is the default")
+            (is (= 409 (:status refused)) (str (:body refused)))
+            (is (= (str "choices.retire 0: \"Backlog\" is the property's default value; set acknowledge-holders=true "
+                        "to clear the default, or dry-run=true to preview")
+                   (get-in refused [:body :error])))
+            (is (= [{:choice (str backlog) :title "Backlog" :holders 0 :default true}] (get-in refused [:body :retired])))
+            (is (= 409 (:status with-held)) (str (:body with-held)))
+            (is (= (str "choices.retire 0: \"Done\" is held by 1 block; choices.retire 1: \"Backlog\" is the property's "
+                        "default value; set acknowledge-holders=true to remove them from their holders and clear the "
+                        "default, or dry-run=true to preview")
+                   (get-in with-held [:body :error])))
+            (is (= [{:choice (str done-id) :title "Done" :holders 1}
+                    {:choice (str backlog) :title "Backlog" :holders 0 :default true}]
+                   (get-in with-held [:body :retired]))
+                "only the default is marked")
+            (is (= (str "choices.retire 0: \"Backlog\" is held by 1 block and is the property's default value; "
+                        "set acknowledge-holders=true to remove it from them and clear the default, or dry-run=true to preview")
+                   (get-in held-and-default [:body :error])))
+            (is (= backlog default-after) "no refused call cleared the default")
+            (is (= ["Active" "Done" "Backlog"] titles-after) "or retired a choice")
+            (is (= 200 (:status dry)) (str (:body dry)))
+            (is (= [{:uuid (str backlog) :title "Backlog" :holders 0 :default true}] (get-in dry [:body :retired]))
+                "the dry run says the default is cleared")
+            (is (= before after-dry) "and stores nothing")
+            (is (= 200 (:status real)) (str (:body real)))
+            (is (= [{:uuid (str backlog) :title "Backlog" :holders 0 :default true}] (get-in real [:body :retired])))
+            (is (nil? (entity conn backlog)) "the choice is gone")
+            (is (nil? (default)) "and the property has no default")))))))
