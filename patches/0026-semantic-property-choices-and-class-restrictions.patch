+                  _ (hold! self b1 phase "active")
+                  _ (hold! self b2 phase "Done")
+                  _ (hold! self b3 phase "  Done ")
+                  old (mapv #(stored conn % phase) [b0 b1 b2 b3])
+                  old-ids (mapv #(:db/id (entity conn %)) old)
