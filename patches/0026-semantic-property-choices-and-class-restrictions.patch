+;; Choices: createProperty's choices and updateProperty's choices.add, update and order. The graph
+;; adds project-status (text) with choices Active, Done and Backlog, keyed a0 < a1 < a2, Active and
+;; Done with icons; a decoy property quadrant whose choices Proposal and Active must never count as
+;; project-status's; score (number) with choice 1; and site (URL) with one choice.
+
+(defn- choice-titles [conn property]
+  (mapv (comp str db-property/property-value-content)
+        (sort-by (juxt :block/order :db/id) (:block/_closed-value-property (d/entity @conn property)))))
+
+(defn- choice-uuid [conn property title]
+  (some #(when (= title (str (db-property/property-value-content %))) (:block/uuid %))
+        (:block/_closed-value-property (d/entity @conn property))))
+
+(defn- with-choices
+  [done run]
+  (with-graph done
+    (fn [{:keys [conn] :as graph}]
+      (p/let [property! (fn [title type choices]
+                          (let [ident (:db/ident (outliner-property/upsert-property!
+                                                  conn nil {:logseq.property/type type :db/cardinality :db.cardinality/one}
+                                                  {:property-name title}))]
+                            (doseq [[value icon order] choices]
+                              (let [id (random-uuid)]
+                                (outliner-property/upsert-closed-value! conn ident (cond-> {:id id :value value}
+                                                                                     icon (assoc :icon icon)))
+                                (d/transact! conn [[:db/add [:block/uuid id] :block/order order]])))
+                            ident))
+              status (property! "project-status" :default [["Active" {:type :emoji :id "rocket"} "a0"]
+                                                           ["Done" {:type :emoji :id "check"} "a1"]
+                                                           ["Backlog" nil "a2"]])
+              quadrant (property! "quadrant" :default [["Proposal" nil "a0"] ["Active" nil "a1"]])
+              score (property! "score" :number [["1" nil "a0"]])
+              site (property! "site" :url [["https://a.example.com" nil "a0"]])
+              phase (property! "phase" :default [])]
+        (run (assoc graph :status status :quadrant quadrant :score score :site site :phase phase))))))
+
+(defn- choices! [self property choices]
+  (request! self "PATCH" (property-path property) {:choices choices}))
+
