+(deftest tag-write-is-one-transaction-test
+  (async done
+    (with-tags done
+      (fn [{:keys [conn self client]}]
+        (let [reports (atom [])
+              listen! #(d/listen! conn ::reports (fn [report] (when (seq (:tx-data report)) (swap! reports conj report))))]
+          (listen!)
+          (p/let [created (request! self "POST" "/semantic/tags"
+                                    {:title "Portfolio" :extends ["Organisation"] :properties ["for-client" "for-service"]})
+                  _ (d/unlisten! conn ::reports)
+                  created-reports @reports
+                  _ (reset! reports [])
+                  _ (listen!)
+                  updated (request! self "PATCH" (tag-path (:block/uuid client))
+                                    {:title "Customer" :extends ["Organisation"] :properties {:set ["engagement-partner"]}})
+                  _ (d/unlisten! conn ::reports)
+                  updated-reports @reports]
+            (let [tx-data (mapcat :tx-data created-reports)
+                  tag-id (:db/id (entity conn (uuid (get-in created [:body :uuid]))))
+                  written (fn [tx-data e a] (filter #(and (= e (:e %)) (= a (:a %)) (:added %)) tx-data))]
+              (is (= 201 (:status created)) (str (:body created)))
+              (is (= 1 (count created-reports)) "createTag is one transaction")
+              (is (= 1 (count (distinct (map :tx tx-data)))) "one tx id")
+              (is (= 2 (count (written tx-data tag-id :logseq.property.class/properties)))
+                  "the tag properties are in the tag's own transaction")
+              (is (seq (written tx-data tag-id :logseq.property.class/extends)) "and so is extends")
+              (let [tx-data (mapcat :tx-data updated-reports)
+                    client-id (:db/id client)]
+                (is (= 200 (:status updated)) (str (:body updated)))
+                (is (= 1 (count updated-reports)) "updateTag is one transaction")
+                (is (= 1 (count (distinct (map :tx tx-data)))) "one tx id")
+                (is (seq (written tx-data client-id :block/title)) "the title,")
+                (is (seq (written tx-data client-id :logseq.property.class/extends)) "extends")
+                (is (seq (written tx-data client-id :logseq.property.class/properties)) "and properties land together")))))))))
+
+(deftest tag-schema-read-back-test
+  ;; After a write the tag is read back; extends or tag properties that aren't stored as asked
+  ;; answer 500, naming them, rather than success.
+  (async done
+    (with-tags done
+      (fn [{:keys [conn client organisation company for-client for-service partner]}]
+        (let [verify! #'semantic/verify-tag-schema!
+              uuid-of (fn [ident] (:block/uuid (d/entity @conn ident)))
+              thrown (fn [expected]
+                       (try (verify! @conn (:block/uuid client) expected) nil
+                            (catch :default e (ex-message e))))]
+          (is (nil? (thrown {:extends #{(:block/uuid company)}
+                             :present #{(uuid-of for-client)} :absent #{(uuid-of partner)}}))
+              "what was asked is stored")
+          (is (nil? (thrown {})) "nothing asked, nothing checked")
+          (is (= (str "the write did not store what was asked: extends missing Organisation; "
+                      "extends not removed Company; properties missing engagement-partner; "
+                      "properties not removed for-service")
+                 (thrown {:extends #{(:block/uuid organisation)}
+                          :present #{(uuid-of partner)} :absent #{(uuid-of for-service)}}))))))))
