+(deftest convert-does-not-rely-on-the-outliner-delete-test
+  ;; Today delete-blocks! retracts each old value block whole, which also drops every ref to it. The
+  ;; handler retracts each holder's ref itself, so a conversion stays clean if an upstream bump makes
+  ;; that delete leave refs behind: here a delete that removes only the blocks' own datoms stands in
+  ;; for such an outliner.
+  (async done
+    (let [real outliner-core/delete-blocks!]
+      (set! outliner-core/delete-blocks!
+            (fn [conn blocks _opts]
+              (ldb/transact! conn (vec (for [block blocks
+                                             datom (d/datoms @conn :eavt (:db/id block))]
+                                         [:db/retract (:e datom) (:a datom) (:v datom)])))))
+      (with-choices (fn [] (set! outliner-core/delete-blocks! real) (done))
+        (fn [{:keys [conn self blocks]}]
+          ;; A many property: there a new ref doesn't replace the old one, so only the handler's own
+          ;; retraction removes it.
+          (let [[b0 b1] blocks
+                labels (:db/ident (outliner-property/upsert-property!
+                                   conn nil {:logseq.property/type :default :db/cardinality :db.cardinality/many}
+                                   {:property-name "labels"}))]
+            (p/let [_ (hold! self b0 labels ["Active" "Red"])
+                    _ (hold! self b1 labels ["active"])
+                    old-ids (into #{} (comp (mapcat #(get (entity conn %) labels)) (map :db/id)) [b0 b1])
+                    active (add-choice! conn labels "Active")
+                    red (add-choice! conn labels "Red")
+                    converted (convert! self labels {})]
+              (is (= 3 (count old-ids)))
+              (is (= 200 (:status converted)) (str (:body converted)))
+              (is (= [#{active red} #{active}] (mapv #(stored conn % labels) [b0 b1])))
+              (is (every? #(empty? (d/datoms @conn :avet labels %)) old-ids) "no holder still points at an old value"))))))))
+
+(deftest convert-write-is-read-back-test
+  ;; A conversion whose old value blocks survive the write (an outliner delete that does nothing)
+  ;; answers 500 naming them, not success.
+  (async done
+    (let [real outliner-core/delete-blocks!]
+      (set! outliner-core/delete-blocks! (fn [_conn _blocks _opts] nil))
+      (with-choices (fn [] (set! outliner-core/delete-blocks! real) (done))
+        (fn [{:keys [conn self phase blocks]}]
+          (p/let [_ (hold! self (first blocks) phase "Active")
+                  _ (add-choice! conn phase "Active")
+                  converted (convert! self phase {})]
+            (is (= 500 (:status converted)) (str (:body converted)))
+            (is (= "the write did not store what was asked: text values not converted \"Active\""
+                   (get-in converted [:body :error])))))))))
