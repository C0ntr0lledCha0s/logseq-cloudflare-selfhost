+      (fn [{:keys [conn self organisation for-client]}]
+        (p/let [created (request! self "POST" "/semantic/tags"
+                                  {:title "Portfolio" :extends ["Organisation"] :properties ["for-client"]})
+                id (some-> (get-in created [:body :uuid]) uuid)
+                got (when id (request! self "GET" (tag-path id) nil))
+                plain (request! self "POST" "/semantic/tags" {:title "Plain"})]
+          (is (= 201 (:status created)) (str (:body created)))
+          (is (= [{:uuid (str (:block/uuid organisation)) :title "Organisation"}]
+                 (get-in created [:body :extends]))
+              "createTag answers what the tag extends")
+          (is (= [{:uuid (str (:block/uuid (d/entity @conn for-client))) :title "for-client" :ident (ident-str for-client)}]
+                 (get-in created [:body :properties]))
+              "createTag answers the tag's properties")
+          (is (string? (get-in created [:body :ident])) "createTag answers the full tag")
+          (is (= (:body created) (:body got)) "getTag reads the same back")
+          (is (= #{"Organisation"} (extends-titles conn id)))
+          (is (= #{for-client} (tag-property-idents conn id)))
+          (is (= 201 (:status plain)) (str (:body plain)))
+          (is (= [] (get-in plain [:body :properties])) "a tag with no properties answers []"))))))
