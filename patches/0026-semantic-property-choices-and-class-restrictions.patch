+;; Converting text values to choices: updateProperty's convert_values. Every distinct text value of a
+;; default property is matched to one of the choices the call leaves (after its add, update and
+;; retire): exactly, then ignoring case, both on the trimmed text. Unmatched text refuses the call.
+;; Holders are re-pointed (one ref per holder per choice) and the old value blocks deleted.
+
+(defn- convert! [self property body & [query]]
+  (request! self "PATCH" (str (property-path property) (when query (str "?" query)))
+            (assoc body :convert_values true)))
+
+(defn- add-choice! [conn property title]
+  (let [id (random-uuid)]
+    (outliner-property/upsert-closed-value! conn property {:id id :value title})
+    id))
+
+(defn- read-value
+  "The value getBlock answers for `property` on the block `id`."
+  [self id property]
+  (p/let [got (request! self "GET" (str "/semantic/blocks/" id) nil)]
+    (some #(when (= (ident-str property) (:ident %)) (:value %)) (get-in got [:body :properties]))))
+
+(deftest convert-values-test
