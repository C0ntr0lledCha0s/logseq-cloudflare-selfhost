+(deftest property-schema-read-back-test
+  ;; After a write the property is read back; classes that aren't stored as asked answer 500,
+  ;; naming them, rather than success.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn client service for-client]}]
+        (let [verify! #'semantic/verify-property-schema!
+              property-uuid (:block/uuid (d/entity @conn for-client))
+              thrown (fn [expected]
+                       (try (verify! @conn property-uuid expected) nil
+                            (catch :default e (ex-message e))))]
+          (d/transact! conn [[:db/add (:db/id (d/entity @conn for-client)) :logseq.property/classes (:db/id service)]])
+          (is (nil? (thrown {:classes #{(:block/uuid service)}})) "what was asked is stored")
+          (is (nil? (thrown {})) "nothing asked, nothing checked")
+          (is (= "the write did not store what was asked: classes missing Client; classes not removed Service"
+                 (thrown {:classes #{(:block/uuid client)}}))))))))
