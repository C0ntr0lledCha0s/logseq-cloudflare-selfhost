+                "with acknowledge-holders the dry run answers what the real call does")
+            (is (= (:body dry) (:body dry-ack)) "with or without acknowledge-holders")
+            (is (= 200 (:status dry-mixed)) (str (:body dry-mixed)))
+            (is (= "project-state" (get-in dry-mixed [:body :title])))
