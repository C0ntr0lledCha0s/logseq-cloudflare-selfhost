+;; Property schema writes (createProperty, updateProperty). Every field is checked against the graph
+;; first, keeping the first refusal per entry; any refusal writes nothing. The writes then run in one
+;; atomic-write!, so a call is one tx id, and the property is read back from the graph afterwards.
+
+(defn- refusals-message
+  "Refusals [{:entry :reason}] as `entry: reason`, joined with \"; \"."
+  [refusals]
+  (string/join "; " (map (fn [{:keys [entry reason]}] (str entry ": " reason)) refusals)))
+
+(defn- resolve-tag-selector
+  "The tag a selector names by UUID, ident or title, or nil. Only tags count, so a page with the
+  same title never matches. A title matches exactly, else ignoring case."
+  [db selector]
+  (when (non-blank-string? selector)
+    (let [tag-entity (fn [entity] (when (and entity (tag? entity) (not (entity-util/hidden? entity))) entity))
+          among-tags (fn [datoms] (->> datoms (map #(d/entity db (:e %))) (keep tag-entity) (sort-by :db/id) first))]
+      (or (when (common-util/uuid-string? selector) (tag-entity (d/entity db [:block/uuid (uuid selector)])))
+          (when (qualified-keyword? (keyword selector)) (tag-entity (d/entity db (keyword selector))))
+          (among-tags (d/datoms db :avet :block/title selector))
+          (among-tags (d/datoms db :avet :block/name (string/lower-case selector)))))))
+
+(defn- validate-selectors
+  "Resolves the `selectors` of `field` (classes, classes.add, extends, properties.remove, ...) with
+  `resolve`, each to a `noun` (tag or property): {:ok [entity ...]}, or {:error message} naming each
+  entry that resolves to nothing or that `check` (entity -> reason or nil) refuses."
+  ([db field selectors resolve noun] (validate-selectors db field selectors resolve noun (constantly nil)))
+  ([db field selectors resolve noun check]
+   (if-not (and (sequential? selectors) (every? string? selectors))
+     {:error (str field ": give a list of " noun " UUIDs, idents or titles")}
+     (let [found (mapv #(resolve db %) selectors)
+           refusals (keep-indexed (fn [index [selector entity]]
+                                    (when-let [reason (if entity (check entity) (str "no " noun " " (pr-str selector)))]
+                                      {:entry (str field " " index) :reason reason}))
+                                  (map vector selectors found))]
+       (if (seq refusals) {:error (refusals-message refusals)} {:ok found})))))
+
+(defn- validate-classes
+  "Resolves the tag `selectors` of `field` (classes, classes.add, ...): {:ok [tag ...]}, or
+  {:error message} naming each entry that isn't a tag."
+  [db field selectors]
+  (validate-selectors db field selectors resolve-tag-selector "tag"))
+
+(defn- mode-change
+  "A {set | add | remove: [...]} field (updateProperty's classes, updateTag's properties) as
+  [mode selectors], when it holds exactly one of set, add or remove; else nil."
+  [field]
+  (let [modes (when (map? field) (filterv #(contains? field %) [:set :add :remove]))]
+    (when (and (= 1 (count modes)) (= 1 (count field)))
+      [(first modes) (get field (first modes))])))
+
+(defn- validate-property-classes
+  "Checks a classes field for the property titled `title`, judged on `type`, its type once the call
+  has applied. `mode` is :set, :add or :remove, or nil for createProperty's list (a set).
+  {:ok {:mode :tags}} or {:error message}."
+  [db title type mode selectors]
+  (if (not= :node type)
+    {:error (str "classes: " title " is not a node property")}
+    (let [resolved (validate-classes db (cond-> "classes" mode (str "." (name mode))) selectors)]
+      (if (:error resolved) resolved {:ok {:mode (or mode :set) :tags (:ok resolved)}}))))
+
+(defn- class-tx
+  "The datoms that give the property with db id `property-id`, which has the classes `current`,
+  the classes `mode` asks for. :set retracts what isn't listed."
+  [property-id current mode tags]
+  (let [current-ids (set (map :db/id current))
+        ids (set (map :db/id tags))
+        add (fn [ids] (map #(vector :db/add property-id :logseq.property/classes %) ids))
+        retract (fn [ids] (map #(vector :db/retract property-id :logseq.property/classes %) ids))]
+    (vec (case mode
+           :set (concat (retract (remove ids current-ids)) (add (remove current-ids ids)))
+           :add (add (remove current-ids ids))
+           :remove (retract (filter current-ids ids))))))
+
+(defn- expected-classes
+  "The class UUIDs a property should have after class-tx."
+  [current mode tags]
+  (let [current (set (map :block/uuid current))
+        uuids (set (map :block/uuid tags))]
+    (case mode
+      :set uuids
+      :add (into current uuids)
+      :remove (reduce disj current uuids))))
+
+(defn- out-of-class-count
+  "How many visible holders of `property` hold a value that is an object of none of its classes,
+  which the app's picker and value writes would now refuse; 0 when it has no classes. One :avet
+  scan of the property's datoms."
+  [db property]
+  (let [classes (:logseq.property/classes property)]
+    (if (empty? classes)
+      0
+      (->> (d/datoms db :avet (:db/ident property))
+           (remove (fn [datom] (some #(db-db/class-instance? % (d/entity db (:v datom))) classes)))
+           (map :e)
+           distinct
+           (remove #(entity-util/hidden? (d/entity db %)))
+           count))))
+
+(defn- unverified!
+  "Throws, answered as a 500 by `rejecting`, when a read-back found `problems`."
+  [problems]
+  (when (seq problems)
+    (let [message (str "the write did not store what was asked: " (string/join "; " problems))]
+      (throw (ex-info message {::unverified message})))))
+
+(defn- verify-property-schema!
+  "Re-reads the property from `db` after a write and throws, answered as a 500 by `rejecting`, when
+  what the call asked for isn't stored. `expected` may hold :classes, a set of class UUIDs."
+  [db property-uuid {:keys [classes]}]
+  (let [property (d/entity db [:block/uuid property-uuid])
+        stored (set (map :block/uuid (:logseq.property/classes property)))
+        title (fn [id] (or (:block/title (d/entity db [:block/uuid id])) (str id)))
+        problems (when (and (some? classes) (not= classes stored))
+                   (cond-> []
+                     (seq (remove stored classes))
+                     (conj (str "classes missing " (string/join ", " (map title (remove stored classes)))))
+                     (seq (remove classes stored))
+                     (conj (str "classes not removed " (string/join ", " (map title (remove classes stored)))))))]
+    (unverified! problems)))
+
+;; Tag schema writes (createTag, updateTag) take the same shape: every field is checked against the
+;; graph first, then the tag, what it extends and its tag properties are written in one
+;; atomic-write!, and the tag is read back.
+
+(defn- find-tag
+  "updateTag's tag-id: a tag's UUID or its ident (qualified idents contain /, re-encoded by the
+  connector as patch 0016 does)."
+  [db id]
+  (or (find-entity db id)
+      (when (and (string? id) (qualified-keyword? (keyword id)))
+        (d/entity db (keyword id)))))
+
+(defn- resolve-property-selector
+  "The property a selector names by UUID, ident or title, or nil. Only visible properties count, so
+  a tag, a page or a hidden built-in property never matches."
+  [db selector]
+  (when (non-blank-string? selector)
+    (let [property (resolve-property db selector)]
+      (when (property? property) property))))
+
+(defn- extends-path
+  "The tags `from` extends `to` through, nearest first ([] when directly), or nil when it doesn't
+  extend `to`."
+  [from to]
+  (loop [queue [[from []]]
+         seen #{(:db/id from)}]
+    (when-let [[tag via] (first queue)]
+      (let [parents (:logseq.property.class/extends tag)]
+        (if (some #(= (:db/id to) (:db/id %)) parents)
+          via
+          (let [unseen (remove #(seen (:db/id %)) parents)]
+            (recur (into (vec (rest queue)) (map (fn [parent] [parent (conj via parent)]) unseen))
+                   (into seen (map :db/id unseen)))))))))
+
+(defn- extends-refusal
+  "Why `tag` (nil when creating one) can't extend `parent`: itself, or a tag that already extends
+  it, named with the path."
+  [tag parent]
+  (when tag
+    (if (= (:db/id tag) (:db/id parent))
+      (str (:block/title parent) " can't extend itself")
+      (when-let [via (extends-path parent tag)]
+        (str (:block/title parent) " already extends " (:block/title tag)
+             (when (seq via) (str " through " (string/join ", " (map :block/title via)))))))))
+
+(defn- validate-tag-schema
+  "Checks createTag's or updateTag's extends and properties for `tag` (nil when creating):
+  {:parents [tag ...] :properties {:mode :properties}}, each key only when given, or {:error message}
+  naming every refused entry. extends replaces the tags it extends and names at least one;
+  properties is a list on createTag and exactly one of set, add or remove on updateTag."
+  [db tag body]
+  (let [extends (when (contains? body :extends)
+                  (if (and (sequential? (:extends body)) (empty? (:extends body)))
+                    {:error "extends: name at least one tag"}
+                    (validate-selectors db "extends" (:extends body) resolve-tag-selector "tag"
+                                        #(extends-refusal tag %))))
+        [mode selectors] (if tag (mode-change (:properties body)) [:add (:properties body)])
+        properties (when (contains? body :properties)
+                     (if (nil? mode)
+                       {:error "properties: give exactly one of set, add or remove"}
+                       (validate-selectors db (cond-> "properties" tag (str "." (name mode))) selectors
+                                           resolve-property-selector "property"
+                                           (fn [property]
+                                             (when (and (= :remove mode) (ldb/built-in-class-property? tag property))
+                                               (str (:block/title property) " is built in on " (:block/title tag)
+                                                    " and can't be removed"))))))
+        errors (keep :error [extends properties])]
+    (if (seq errors)
+      {:error (string/join "; " errors)}
+      (cond-> {}
+        extends (assoc :parents (:ok extends))
+        properties (assoc :properties {:mode mode :properties (:ok properties)})))))
+
+(defn- write-tag-schema!
+  "Inside atomic-write!: replaces what the tag with db id `tag-id` extends with `parents`, and changes
+  its tag properties as `mode` asks. :set adds what is missing and removes the rest, except the
+  built-in class properties, which class-remove-property! keeps."
+  [tx-conn tag-id parents {:keys [mode properties]}]
+  (when parents
+    (outliner-property/set-block-property! tx-conn tag-id :logseq.property.class/extends (mapv :db/id parents)))
+  (when mode
+    (let [listed (set (map :db/id properties))
+          current (map :db/id (:logseq.property.class/properties (d/entity @tx-conn tag-id)))]
+      (when (#{:add :set} mode)
+        (doseq [id listed] (outliner-property/class-add-property! tx-conn tag-id id)))
+      (doseq [id (case mode :remove listed :set (remove listed current) :add nil)]
+        (outliner-property/class-remove-property! tx-conn tag-id id)))))
+
+(defn- expected-tag-schema
+  "What `tag` (nil when creating one) should hold after write-tag-schema!: :extends, the UUIDs of
+  `parents` less any another one already extends (the outliner drops those), and the tag property
+  UUIDs that must be :present and :absent."
+  [tag parents {:keys [mode properties]}]
+  (let [ancestors (set (mapcat #(map :db/id (ldb/get-class-extends %)) parents))
+        listed (set (map :block/uuid properties))]
+    (cond-> {}
+      parents (assoc :extends (set (keep #(when-not (ancestors (:db/id %)) (:block/uuid %)) parents)))
+      mode (assoc :present (if (= :remove mode) #{} listed)
+                  :absent (case mode
+                            :add #{}
+                            :remove listed
+                            :set (set (keep #(when-not (or (listed (:block/uuid %)) (ldb/built-in-class-property? tag %))
+                                               (:block/uuid %))
+                                            (:logseq.property.class/properties tag))))))))
+
+(defn- verify-tag-schema!
+  "Re-reads the tag from `db` after a write and throws, answered as a 500 by `rejecting`, when what
+  expected-tag-schema says isn't stored."
+  [db tag-uuid {:keys [extends present absent]}]
+  (let [tag (d/entity db [:block/uuid tag-uuid])
+        stored-extends (set (map :block/uuid (:logseq.property.class/extends tag)))
+        stored (set (map :block/uuid (:logseq.property.class/properties tag)))
+        titles (fn [ids] (string/join ", " (map #(or (:block/title (d/entity db [:block/uuid %])) (str %)) ids)))]
+    (unverified!
+     (cond-> []
+       (and extends (seq (remove stored-extends extends)))
+       (conj (str "extends missing " (titles (remove stored-extends extends))))
+       (and extends (seq (remove extends stored-extends)))
+       (conj (str "extends not removed " (titles (remove extends stored-extends))))
+       (seq (remove stored present))
+       (conj (str "properties missing " (titles (remove stored present))))
+       (seq (filter stored absent))
+       (conj (str "properties not removed " (titles (filter stored absent))))))))
+
