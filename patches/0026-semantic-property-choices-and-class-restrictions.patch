+              built-ins (set (map :db/ident (:logseq.property.class/properties task)))]
+          (p/let [_ (request! self "PATCH" (tag-path task-id) {:properties {:add ["for-service"]}})
+                  set-task (request! self "PATCH" (tag-path task-id) {:properties {:set ["for-client"]}})
+                  set-client (request! self "PATCH" (tag-path (:block/uuid client)) {:properties {:set []}})
+                  remove-built-in (request! self "PATCH" (tag-path task-id)
+                                            {:properties {:remove [(ident-str (first (sort built-ins)))]}})]
+            (is (seq built-ins) "Task has built-in class properties")
+            (is (= 200 (:status set-task)) (str (:body set-task)))
+            (is (= (conj built-ins for-client) (tag-property-idents conn task-id))
+                "set keeps the built-in class properties and leaves exactly the listed user property")
+            (is (= 200 (:status set-client)) (str (:body set-client)))
+            (is (= #{} (tag-property-idents conn (:block/uuid client))) "set [] removes every user property")
+            (is (= 400 (:status remove-built-in)) (str (:body remove-built-in)))
+            (is (string/starts-with? (str (get-in remove-built-in [:body :error])) "properties.remove 0: ")
+                (str (:body remove-built-in)))
+            (is (string/includes? (str (get-in remove-built-in [:body :error])) "built in")
+                "removing a built-in class property is refused, not silently skipped")
+            (is (= (conj built-ins for-client) (tag-property-idents conn task-id)))
+            (is (some? for-service))))))))
