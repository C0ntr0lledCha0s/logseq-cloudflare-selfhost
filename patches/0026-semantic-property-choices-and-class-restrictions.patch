+(deftest retire-does-not-rely-on-the-outliner-delete-test
+  ;; Today delete-closed-value! retracts the whole choice entity, which also drops every ref to it.
+  ;; The handler retracts each holder's datom itself, so the retire stays clean if an upstream bump
+  ;; makes that delete leave refs behind: here a delete that removes only the choice's own datoms
+  ;; stands in for such an outliner. Holders must still lose the value, and the call succeeds.
+  (async done
+    (let [real outliner-property/delete-closed-value!]
+      (set! outliner-property/delete-closed-value!
+            (fn [conn _property-id choice-id]
+              (ldb/transact! conn (mapv (fn [datom] [:db/retract (:e datom) (:a datom) (:v datom)])
+                                        (d/datoms @conn :eavt choice-id)))))
+      (with-choices (fn [] (set! outliner-property/delete-closed-value! real) (done))
+        (fn [{:keys [conn self status blocks]}]
+          (let [[b0 b1] blocks
+                backlog (choice-uuid conn status "Backlog")
+                backlog-id (:db/id (entity conn backlog))]
+            (p/let [_ (hold! self b0 status "Backlog")
+                    _ (hold! self b1 status "Backlog")
+                    retired (retire! self status ["Backlog"] "acknowledge-holders=true")]
+              (is (= 200 (:status retired)) (str (:body retired)))
+              (is (nil? (entity conn backlog)) "the choice is gone")
+              (is (empty? (d/datoms @conn :avet status backlog-id)) "no holder still points at it")
+              (is (nil? (stored conn b0 status)))
+              (is (nil? (stored conn b1 status))))))))))
