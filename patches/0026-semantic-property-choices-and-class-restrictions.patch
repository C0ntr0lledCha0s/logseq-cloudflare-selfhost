+                        "to remove it from them, or dry-run=true to preview")
+                   (get-in refused [:body :error])))
+            (is (= [{:choice (str backlog) :title "Backlog" :holders 2}] (get-in refused [:body :retired])))
+            (is (= 409 (:status both)) (str (:body both)))
+            (is (= (str "choices.retire 0: \"Backlog\" is held by 2 blocks; choices.retire 1: \"Done\" is held by 1 block; "
+                        "set acknowledge-holders=true to remove them from their holders, or dry-run=true to preview")
+                   (get-in both [:body :error]))
+                "every retired choice with holders is named, with its count")
+            (is (= [{:choice (str backlog) :title "Backlog" :holders 2} {:choice (str done-id) :title "Done" :holders 1}]
+                   (get-in both [:body :retired]))
+                "a choice without holders is not listed in the refusal")
+            (is (= 409 (:status declined)) (str (:body declined)))
+            (is (= 400 (:status invalid)) (str (:body invalid)))
+            (is (= "acknowledge-holders must be true or false" (get-in invalid [:body :error])))
+            (is (= 400 (:status invalid-dry)) (str (:body invalid-dry)))
+            (is (= "dry-run must be true or false" (get-in invalid-dry [:body :error])))
+            (is (= before (snapshot conn)) "nothing was written")
+            (is (= backlog (stored conn b0 status)))))))))
