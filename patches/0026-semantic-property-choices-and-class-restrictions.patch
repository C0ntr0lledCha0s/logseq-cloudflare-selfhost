+                  _ (hold! self b2 phase "On hold")
+                  _ (hold! self b3 phase "paused")
+                  _ (add-choice! conn phase "Active")
+                  _ (add-choice! conn phase "Later")
+                  _ (add-choice! conn quadrant "Paused")
+                  _ (hold! self b4 status "Backlog")
+                  before (snapshot conn)
+                  refused (convert! self phase {:choices {:add [{:title "Done"}]}})
+                  retired (convert! self phase {:choices {:add [{:title "Paused"} {:title "On hold"}]
+                                                          :retire ["Active"]}})
+                  renamed (convert! self phase {:choices {:add [{:title "Paused"} {:title "On hold"}]
+                                                          :update [{:choice "Active" :title "Current"}]}})
+                  decoy (convert! self phase {:choices {:add [{:title "On hold"}]}})
+                  both (request! self "PATCH" (property-path phase)
+                                 {:choices {:add [{:title "later"}]} :convert_values true})
+                  after (snapshot conn)]
+            (is (= 400 (:status refused)) (str (:body refused)))
+            (is (= (str "convert_values: no choice matches \"Paused\", \"On hold\", \"paused\"; "
+                        "add them under choices.add in the same call")
+                   (get-in refused [:body :error]))
+                "every unmatched text is listed, in the order the values were made")
+            (is (= (str "convert_values: no choice matches \"Active\"; add them under choices.add in the same call")
+                   (get-in retired [:body :error]))
+                "a choice retired in the same call matches nothing")
+            (is (= (str "convert_values: no choice matches \"Active\"; add them under choices.add in the same call")
+                   (get-in renamed [:body :error]))
+                "nor does a choice's old title once it is renamed")
+            (is (= (str "convert_values: no choice matches \"Paused\", \"paused\"; add them under choices.add in the same call")
+                   (get-in decoy [:body :error]))
+                "Paused on another property doesn't count")
+            (is (= (str "choices.add 0: \"later\" is already a choice on phase; "
+                        "convert_values: no choice matches \"Paused\", \"On hold\", \"paused\"; "
+                        "add them under choices.add in the same call")
+                   (get-in both [:body :error]))
+                "a refused choice and the unmatched texts are named together")
+            (doseq [response [refused retired renamed decoy both]]
+              (is (= 400 (:status response)) (str (:body response))))
+            (is (true? (= before after)) "nothing was written, not even the same call's choices.add")
+            (is (= ["Active" "Later"] (choice-titles conn phase)))))))))
