+;; Retiring choices: updateProperty's choices.retire, with the acknowledge-holders and dry-run query
+;; flags. Holders are counted with one :avet range on the property and the choice; a retire with
+;; holders is refused with 409 unless acknowledge-holders=true, and dry-run=true stores nothing.
+
+(defn- retire! [self property refs & [query]]
+  (request! self "PATCH" (str (property-path property) (when query (str "?" query))) {:choices {:retire refs}}))
+
+(defn- snapshot [conn]
+  (set (map (juxt :e :a :v) (d/datoms @conn :eavt))))
+
+(defn- hold! [self block-id property value]
+  (request! self "PUT" (value-path block-id property) {:value value}))
+
+(defn- pointing-at
+  "Every datom whose value is the db id `id`, on the property `property` or :block/refs."
+  [conn property id]
+  (concat (d/datoms @conn :avet property id) (d/datoms @conn :avet :block/refs id)))
+
