+            (is (= ["Proposal" "Backlog" "Done" "In progress"] (mapv :title (get-in got [:body :choices]))))
+            (is (= ["Proposal" "Backlog" "Done" "In progress"] (choice-titles conn status)))
+            (let [orders (map #(:block/order (entity conn (uuid (:uuid %)))) (get-in got [:body :choices]))]
+              (is (every? #(= 1 (count (d/datoms @conn :avet :block/order %))) orders)
+                  "every reordered choice has a key no other block holds"))))))))
