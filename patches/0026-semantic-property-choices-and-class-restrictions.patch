+                _ (d/transact! conn (map-indexed (fn [index order]
+                                                   {:block/uuid (random-uuid) :block/title (str "Filler " index)
+                                                    :block/page [:block/uuid page-id]
+                                                    :block/parent [:block/uuid page-id]
+                                                    :block/order order
+                                                    :block/created-at 1 :block/updated-at 1})
+                                                 keys))
+                added (choices! self status {:add [{:title "Proposal"} {:title "Review"}]})
+                proposal (choice-uuid conn status "Proposal")
+                review (choice-uuid conn status "Review")]
