+(deftest tag-write-is-read-back-test
+  ;; createTag and updateTag read the tag back after the write. A listener that drops what the write
+  ;; stored as soon as it lands stands in for an outliner that didn't store it: both must answer 500
+  ;; naming what is missing, not success.
+  (async done
+    (with-tags done
+      (fn [{:keys [conn self client]}]
+        (let [tamper! (fn [attribute value-title]
+                        (d/listen! conn ::tamper
+                                   (fn [{:keys [db-after tx-data]}]
+                                     (when-let [datom (some #(when (and (:added %) (= attribute (:a %))
+                                                                        (= value-title (:block/title (d/entity db-after (:v %)))))
+                                                               %)
+                                                            tx-data)]
+                                       (d/unlisten! conn ::tamper)
+                                       (d/transact! conn [[:db/retract (:e datom) attribute (:v datom)]])))))]
+          (tamper! :logseq.property.class/extends "Organisation")
+          (p/let [created (request! self "POST" "/semantic/tags"
+                                    {:title "Portfolio" :extends ["Organisation"] :properties ["for-client"]})
+                  _ (tamper! :logseq.property.class/properties "engagement-partner")
+                  updated (request! self "PATCH" (tag-path (:block/uuid client))
+                                    {:properties {:add ["engagement-partner"]}})
+                  _ (tamper! :logseq.property.class/extends "Organisation")
+                  extended (request! self "PATCH" (tag-path (:block/uuid client)) {:extends ["Organisation"]})]
+            (d/unlisten! conn ::tamper)
+            (is (= 500 (:status created)) (str (:body created)))
+            (is (= "the write did not store what was asked: extends missing Organisation"
+                   (get-in created [:body :error])))
+            (is (= 500 (:status updated)) (str (:body updated)))
+            (is (= "the write did not store what was asked: properties missing engagement-partner"
+                   (get-in updated [:body :error])))
+            (is (= 500 (:status extended)) (str (:body extended)))
+            (is (string/starts-with? (str (get-in extended [:body :error]))
+                                     "the write did not store what was asked: extends missing Organisation"))))))))
