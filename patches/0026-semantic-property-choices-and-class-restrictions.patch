+(deftest choices-write-is-one-transaction-test
+  (async done
+    (with-choices done
+      (fn [{:keys [conn self status]}]
+        (let [client (d/conn-from-db @conn)
+              reports (atom [])
+              listen! #(d/listen! conn ::reports
+                                  (fn [{:keys [db-after db-before tx-data] :as report}]
+                                    (when (seq tx-data)
+                                      (swap! reports conj (assoc report :normalized
+                                                                 (db-normalize/normalize-tx-data db-after db-before tx-data))))))
+              take! (fn [] (d/unlisten! conn ::reports) (let [r @reports] (reset! reports []) r))]
+          (listen!)
+          (p/let [created (request! self "POST" "/semantic/properties"
+                                    {:title "stage" :choices [{:title "Plan" :description "Scoping"} {:title "Build"}]})
+                  created-reports (take!)
+                  _ (listen!)
+                  updated (choices! self status {:update [{:choice "Done" :title "Closed"}]
+                                                 :add [{:title "Proposal"}]
+                                                 :order ["Proposal" "Active" "Closed" "Backlog"]})
+                  updated-reports (take!)
+                  _ (doseq [{:keys [normalized]} (concat created-reports updated-reports)]
+                      (d/transact! client normalized))
+                  stage (keyword (get-in created [:body :ident]))
+                  shape (fn [db property]
+                          (mapv (juxt :block/uuid :block/title :block/order)
+                                (sort-by :block/order (:block/_closed-value-property (d/entity db property)))))]
+            (is (= 201 (:status created)) (str (:body created)))
+            (is (= 1 (count created-reports)) "createProperty with choices is one transaction")
+            (is (= 1 (count (distinct (map :tx (mapcat :tx-data created-reports))))) "one tx id")
+            (is (= 200 (:status updated)) (str (:body updated)))
+            (is (= 1 (count updated-reports)) "update, add and order are one transaction")
+            (is (= 1 (count (distinct (map :tx (mapcat :tx-data updated-reports))))) "one tx id")
+            (is (= ["Proposal" "Active" "Closed" "Backlog"] (choice-titles conn status)))
+            (is (= (shape @conn stage) (shape @client stage)) "a client replaying the log has the same choices")
+            (is (= (shape @conn status) (shape @client status)) "in the same order")))))))
