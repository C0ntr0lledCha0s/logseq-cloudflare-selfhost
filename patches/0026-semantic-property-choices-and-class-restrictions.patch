+(deftest classes-add-and-remove-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self blocks client service audit for-client]}]
+        (let [[b0 b1 b2] blocks]
+          (p/let [_ (restrict! self for-client :set ["Client"])
+                  added (restrict! self for-client :add [(ident-str (:db/ident service))])
+                  by-uuid (request! self "PUT" (value-path b0 for-client) {:value (str audit)})
+                  removed (restrict! self for-client :remove ["Client" (str (:block/uuid service))])
+                  _ (restrict! self for-client :set ["Client"])
+                  refused (request! self "PUT" (value-path b1 for-client) {:value (str audit)})
+                  cleared (restrict! self for-client :set [])
