+(deftest out-of-class-reported-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self blocks acme audit acme-ltd for-client clients]}]
+        (let [[b0 b1 b2 b3 b4 b5 b6] blocks
+              id (fn [uuid] (:db/id (entity conn uuid)))]
+          (p/let [;; A holder the app left empty holds the empty placeholder, which isn't a value
+                  ;; the classes refuse, on either cardinality.
+                  _ (d/transact! conn [[:db/add (id b5) for-client :logseq.property/empty-placeholder]
+                                       [:db/add (id b6) clients :logseq.property/empty-placeholder]])
+                  _ (outliner-property/set-block-property! conn [:block/uuid b0] for-client (id acme))
+                  _ (outliner-property/set-block-property! conn [:block/uuid b1] for-client (id audit))
+                  ;; A recycled holder doesn't count.
+                  _ (outliner-property/set-block-property! conn [:block/uuid b3] for-client (id audit))
+                  _ (d/transact! conn [[:db/add [:block/uuid b3] :logseq.property/deleted-at 1]])
+                  ;; A holder with two out-of-class values counts once.
+                  _ (outliner-property/batch-set-property! conn [(id b4)] clients (id audit) {:entity-id? true})
+                  _ (outliner-property/batch-set-property! conn [(id b4)] clients (id acme-ltd) {:entity-id? true})
+                  many (restrict! self clients :set ["Client"])
+                  restricted (restrict! self for-client :set ["Client"])
+                  service-too (restrict! self for-client :add ["Service"])
+                  cleared (restrict! self for-client :set [])]
+            (is (= 200 (:status restricted)) (str (:body restricted)))
+            (is (= 1 (get-in restricted [:body :out_of_class]))
+                "Audit is counted; Acme, a recycled holder and an empty placeholder are not")
+            (is (= 2 (count (get (entity conn b4) clients))))
+            (is (= 1 (get-in many [:body :out_of_class])) "a holder is counted once")
+            (is (= acme (stored conn b0 for-client)) "existing values stay")
+            (is (= audit (stored conn b1 for-client)) "existing values stay, even out of class")
+            (is (nil? (stored conn b2 for-client)))
+            (is (= 0 (get-in service-too [:body :out_of_class])))
+            (is (= 0 (get-in cleared [:body :out_of_class])) "no classes, nothing out of class")))))))
