+                         [:components :schemas :PropertyResponse :properties])]
+    (is (= "boolean" (get-in request [:convert_values :type])))
+    (is (= ["values" "holders"] (get-in response [:converted :required])))
+    (is (= "array" (get-in response [:mapping :type])))
+    (is (string/includes? (:description operation) "convert_values"))))
