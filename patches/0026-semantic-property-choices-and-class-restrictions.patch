+;; Property schema writes (createProperty, updateProperty). Every field is checked against the graph
+;; first, keeping the first refusal per entry; any refusal writes nothing. The writes then run in one
+;; atomic-write!, so a call is one tx id, and the property is read back from the graph afterwards.
+
+(defn- refusals-message
+  "Refusals [{:entry :reason}] as `entry: reason`, joined with \"; \"."
+  [refusals]
+  (string/join "; " (map (fn [{:keys [entry reason]}] (str entry ": " reason)) refusals)))
+
+(defn- resolve-tag-selector
+  "The tag a selector names by UUID, ident or title, or nil. Only tags count, so a page with the
+  same title never matches. A title matches exactly, else ignoring case."
+  [db selector]
+  (when (non-blank-string? selector)
+    (let [tag-entity (fn [entity] (when (and entity (tag? entity) (not (entity-util/hidden? entity))) entity))
+          among-tags (fn [datoms] (->> datoms (map #(d/entity db (:e %))) (keep tag-entity) (sort-by :db/id) first))]
+      (or (when (common-util/uuid-string? selector) (tag-entity (d/entity db [:block/uuid (uuid selector)])))
+          (when (qualified-keyword? (keyword selector)) (tag-entity (d/entity db (keyword selector))))
+          (among-tags (d/datoms db :avet :block/title selector))
+          (among-tags (d/datoms db :avet :block/name (string/lower-case selector)))))))
+
+(defn- validate-selectors
+  "Resolves the `selectors` of `field` (classes, classes.add, extends, properties.remove, ...) with
+  `resolve`, each to a `noun` (tag or property): {:ok [entity ...]}, or {:error message} naming each
+  entry that resolves to nothing or that `check` (entity -> reason or nil) refuses."
+  ([db field selectors resolve noun] (validate-selectors db field selectors resolve noun (constantly nil)))
+  ([db field selectors resolve noun check]
+   (if-not (and (sequential? selectors) (every? string? selectors))
+     {:error (str field ": give a list of " noun " UUIDs, idents or titles")}
+     (let [found (mapv #(resolve db %) selectors)
+           refusals (keep-indexed (fn [index [selector entity]]
+                                    (when-let [reason (if entity (check entity) (str "no " noun " " (pr-str selector)))]
+                                      {:entry (str field " " index) :reason reason}))
+                                  (map vector selectors found))]
+       (if (seq refusals) {:error (refusals-message refusals)} {:ok found})))))
+
+(defn- validate-classes
+  "Resolves the tag `selectors` of `field` (classes, classes.add, ...): {:ok [tag ...]}, or
+  {:error message} naming each entry that isn't a tag."
+  [db field selectors]
+  (validate-selectors db field selectors resolve-tag-selector "tag"))
+
+(defn- mode-change
+  "A {set | add | remove: [...]} field (updateProperty's classes, updateTag's properties) as
+  [mode selectors], when it holds exactly one of set, add or remove; else nil."
+  [field]
+  (let [modes (when (map? field) (filterv #(contains? field %) [:set :add :remove]))]
+    (when (and (= 1 (count modes)) (= 1 (count field)))
+      [(first modes) (get field (first modes))])))
+
+(defn- validate-property-classes
+  "Checks a classes field for the property titled `title`, judged on `type`, its type once the call
+  has applied. `mode` is :set, :add or :remove, or nil for createProperty's list (a set).
+  {:ok {:mode :tags}} or {:error message}."
+  [db title type mode selectors]
+  (if (not= :node type)
+    {:error (str "classes: " title " is not a node property")}
+    (let [resolved (validate-classes db (cond-> "classes" mode (str "." (name mode))) selectors)]
+      (if (:error resolved) resolved {:ok {:mode (or mode :set) :tags (:ok resolved)}}))))
+
+(defn- class-tx
+  "The datoms that give the property with db id `property-id`, which has the classes `current`,
+  the classes `mode` asks for. :set retracts what isn't listed."
+  [property-id current mode tags]
+  (let [current-ids (set (map :db/id current))
+        ids (set (map :db/id tags))
+        add (fn [ids] (map #(vector :db/add property-id :logseq.property/classes %) ids))
+        retract (fn [ids] (map #(vector :db/retract property-id :logseq.property/classes %) ids))]
+    (vec (case mode
+           :set (concat (retract (remove ids current-ids)) (add (remove current-ids ids)))
+           :add (add (remove current-ids ids))
+           :remove (retract (filter current-ids ids))))))
+
+(defn- expected-classes
+  "The class UUIDs a property should have after class-tx."
+  [current mode tags]
+  (let [current (set (map :block/uuid current))
+        uuids (set (map :block/uuid tags))]
+    (case mode
+      :set uuids
+      :add (into current uuids)
+      :remove (reduce disj current uuids))))
+
+(defn- out-of-class-count
+  "How many visible holders of `property` hold a value that is an object of none of its classes,
+  which the app's picker and value writes would now refuse; 0 when it has no classes. The empty
+  placeholder (a holder the app left empty) is no value, so it isn't counted. One :avet scan of the
+  property's datoms."
+  [db property]
+  (let [classes (:logseq.property/classes property)]
+    (if (empty? classes)
+      0
+      (->> (d/datoms db :avet (:db/ident property))
+           (map (fn [datom] [(:e datom) (d/entity db (:v datom))]))
+           (remove (fn [[_ value]] (= :logseq.property/empty-placeholder (:db/ident value))))
+           (remove (fn [[_ value]] (some #(db-db/class-instance? % value) classes)))
+           (map first)
+           distinct
+           (remove #(entity-util/hidden? (d/entity db %)))
+           count))))
+
+(defn- unverified!
+  "Throws, answered as a 500 by `rejecting`, when a read-back found `problems`."
+  [problems]
+  (when (seq problems)
+    (let [message (str "the write did not store what was asked: " (string/join "; " problems))]
+      (throw (ex-info message {::unverified message})))))
+
+(defn- verify-property-schema!
+  "Re-reads the property from `db` after a write and throws, answered as a 500 by `rejecting`, when
+  what the call asked for isn't stored. `expected` may hold :classes, a set of class UUIDs; :titles,
+  a map of choice UUID to the title it should read; :order, the choice UUIDs in editor order; and
+  :retired, the choices ({:uuid :id :text}) that must be gone, with no holder left pointing at them;
+  and :converted, a conversion's {:values [{:id :text}] :holders {holder-id #{choice-uuid}}}: each old
+  value block gone with no holder pointing at it, and each holder holding its choices."
+  [db property-uuid {:keys [classes titles order retired converted]}]
+  (let [property (d/entity db [:block/uuid property-uuid])
+        stored (set (map :block/uuid (:logseq.property/classes property)))
+        title (fn [id] (or (:block/title (d/entity db [:block/uuid id])) (str id)))
+        content (fn [id] (some-> (d/entity db [:block/uuid id]) choice-content))
+        stored-order (mapv :block/uuid (property-choices property))
+        problems (cond-> []
+                   (and (some? classes) (seq (remove stored classes)))
+                   (conj (str "classes missing " (string/join ", " (map title (remove stored classes)))))
+                   (and (some? classes) (seq (remove classes stored)))
+                   (conj (str "classes not removed " (string/join ", " (map title (remove classes stored)))))
+                   (some (fn [[id t]] (not= t (content id))) titles)
+                   (conj (str "choices missing " (string/join ", " (keep (fn [[id t]] (when (not= t (content id)) (pr-str t)))
+                                                                         (sort-by val titles)))))
+                   (and (some? order) (not= order stored-order))
+                   (conj (str "choices not in the order asked: "
+                              (string/join ", " (map #(pr-str (or (content %) (str %))) stored-order))))
+                   (some #(d/entity db [:block/uuid (:uuid %)]) retired)
+                   (conj (str "choices not retired "
+                              (string/join ", " (keep #(when (d/entity db [:block/uuid (:uuid %)]) (pr-str (:text %))) retired)))))
+        problems (into problems
+                       (keep (fn [{:keys [id text]}]
+                               (let [n (choice-holders db (:db/ident property) id)]
+                                 (when (pos? n)
+                                   (str (pr-str text) " is still held by " n (if (= 1 n) " block" " blocks")))))
+                             retired))
+        unconverted (distinct (keep (fn [{:keys [id text]}]
+                                      (when (or (seq (d/datoms db :eavt id))
+                                                (seq (d/datoms db :avet (:db/ident property) id)))
+                                        (pr-str text)))
+                                    (:values converted)))
+        held (fn [holder] (let [v (get (d/entity db holder) (:db/ident property))]
+                            (set (map :block/uuid (if (set? v) v (some-> v vector))))))
+        unheld (count (remove (fn [[holder uuids]] (every? (held holder) uuids)) (:holders converted)))
+        problems (cond-> problems
+                   (seq unconverted) (conj (str "text values not converted " (string/join ", " unconverted)))
+                   (pos? unheld) (conj (str unheld (if (= 1 unheld) " block doesn't hold its" " blocks don't hold their")
+                                            " new choice")))]
+    (unverified! problems)))
+
+;; Choices (closed values) through createProperty's choices and updateProperty's choices.add, update
+;; and order. Titles are checked before anything is written: duplicates ignoring case, against the
+;; property's own choices only (another property's choice with the same title is no duplicate) and
+;; within the request, and the number or URL a number or URL property needs. Each new or reordered
+;; choice is keyed with db-order/gen-key after the graph's max key (seeded by `handle`), never the
+;; key the outliner takes from the property's own last choice, which another block can hold.
+
+(def ^:private choice-icon-types #{"emoji" "tabler-icon"})
+
+(defn- text? [v]
+  (and (string? v) (not (string/blank? v))))
+
+(defn- choice-text
+  "A choice title as given: text trimmed, or a JSON number as text; nil when blank or neither."
+  [title]
+  (cond
+    (number? title) (str title)
+    (text? title) (string/trim title)
+    :else nil))
+
+(defn- choice-key
+  "What two choice titles of a property of `type` compare by: a number property's numbers, else the
+  text ignoring case."
+  [type text]
+  (if (= :number type)
+    (str (parse-double text))
+    (string/lower-case text)))
+
+(defn- choice-stored
+  "The content a choice of a property of `type` given `text` reads back as."
+  [type text]
+  (if (= :number type) (str (parse-double text)) text))
+
+(defn- choice-title-refusal [type title]
+  (let [text (choice-text title)]
+    (cond
+      (nil? text) "give a title"
+      (and (= :number type) (not (some-> (parse-double text) js/isFinite)))
+      (str (pr-str text) " is not a number")
+      (and (= :url type) (not (db-property-type/url? text)))
+      (str (pr-str text) " is not a URL"))))
+
+(defn- choice-icon
+  "An icon as given, as stored ({:type :emoji :id ...}), nil for null, or ::invalid."
+  [icon]
+  (cond
+    (nil? icon) nil
+    (and (map? icon) (contains? choice-icon-types (:type icon)) (text? (:id icon)))
+    {:type (keyword (:type icon)) :id (:id icon)}
+    :else ::invalid))
+
+(defn- choice-fields-refusal
+  "Why a choice entry's icon or description is refused, or nil."
+  [entry]
+  (cond
+    (= ::invalid (choice-icon (:icon entry))) "icon needs type emoji or tabler-icon and an id"
+    (and (contains? entry :description) (not (text? (:description entry))))
+    "description must be non-blank text"))
+
+(defn- choices-shape-refusal
+  "Why createProperty's choices (a list, `create?`) or updateProperty's ({add, update, order,
+  retire}) has the wrong shape, or nil."
+  [create? choices]
+  (if create?
+    (when-not (sequential? choices) "choices: give a list of choices")
+    (cond
+      (not (and (map? choices) (seq choices) (every? #{:add :update :order :retire} (keys choices))))
+      "choices: give add, update, order or retire"
+      :else
+      (some (fn [k] (when (and (contains? choices k) (not (sequential? (get choices k))))
+                      (str "choices." (name k) ": give a list of "
+                           (if (#{:order :retire} k) "choice UUIDs, idents or titles" "choices"))))
+            [:add :update :order :retire]))))
+
+(defn- choice-holders
+  "How many entities hold the choice with db id `choice-id` as their value for the property
+  `property-ident`: one :avet range."
+  [db property-ident choice-id]
+  (count (distinct (map :e (d/datoms db :avet property-ident choice-id)))))
+
+(defn- validate-choices
+  "Checks createProperty's `choices` (a list; `property` nil) or updateProperty's ({add, update,
+  order, retire}) for the property titled `title`, judged on `type`, its type once the call has
+  applied. {:ok plan} or {:error message} naming every refused entry. The plan is {:add [{:uuid :text
+  :icon :description}] :update [{:uuid :text? :icon? :description?}] :order [uuid ...]? :retire [{:index
+  :uuid :id :text :holders :default?}]?}; a new choice's UUID is chosen here so order can name it. The plan's updates
+  are in the order they apply: a rename after the rename that frees its title. A retired choice
+  must be the property's own, not built in, and not also updated or ordered in the call; its
+  holders are counted here, and it is marked :default when it is the property's default value
+  (which retiring it clears); the handler decides whether they may lose it."
+  [db property title type choices e2ee?]
+  (let [create? (nil? property)
+        shape (choices-shape-refusal create? choices)]
+    (cond
+      (not (contains? db-property-type/closed-value-property-types type))
+      {:error (str "choices: " title " is a " (name type) " property and can't have choices")}
+      e2ee? {:error "choices: not on an E2EE graph, where choice titles would be stored as plain text"}
+      shape {:error shape}
+      :else
+      (let [add-field (if create? "choices" "choices.add")
+            adds (if create? choices (:add choices))
+            existing (if property (property-choices property) [])
+            no-choice (fn [ref] (str "no choice " (pr-str (str ref)) " on " title))
+            refusals (volatile! [])
+            refuse! (fn [entry reason] (vswap! refusals conj {:entry entry :reason reason}))
+            ;; updates
+            updates (vec (map-indexed
+                          (fn [index entry]
+                            (let [field (str "choices.update " index)
+                                  id (when (map? entry) (resolve-choice db property (:choice entry) nil))]
+                              (cond
+                                (not (map? entry)) (refuse! field "give {choice, title?, icon?, description?}")
+                                (nil? id) (refuse! field (no-choice (:choice entry)))
+                                (not (some #(contains? entry %) [:title :icon :description]))
+                                (refuse! field "give title, icon or description")
+                                :else
+                                (if-let [reason (or (when (contains? entry :title) (choice-title-refusal type (:title entry)))
+                                                    (choice-fields-refusal entry))]
+                                  (refuse! field reason)
+                                  {:field field :id id :entry entry}))))
+                          (:update choices)))
+            updates (filterv map? updates)
+            updated-ids (reduce (fn [seen {:keys [field id]}]
+                                  (if-let [earlier (get seen id)]
+                                    (do (refuse! field (str (pr-str (choice-content (d/entity db id)))
+                                                            " is already updated in " earlier))
+                                        seen)
+                                    (assoc seen id field)))
+                                {} updates)
+            renamed (into {} (keep (fn [{:keys [id entry field]}]
+                                     (when (and (contains? entry :title) (= field (get updated-ids id)))
+                                       [id (choice-text (:title entry))]))
+                                   updates))
+            ;; what each existing choice is titled once the call has applied
+            final (mapv (fn [choice] {:id (:db/id choice)
+                                      :text (get renamed (:db/id choice) (choice-content choice))})
+                        existing)
+            _ (doseq [{:keys [id field]} updates
+                      :when (and (renamed id) (= field (get updated-ids id)))]
+                (let [k (choice-key type (renamed id))]
+                  (when (some #(and (not= id (:id %)) (= k (choice-key type (:text %)))) final)
+                    (refuse! field (str (pr-str (renamed id)) " is already a choice on " title)))))
+            ;; The order the updates are applied in. upsert-closed-value! refuses a title another
+            ;; choice still holds (compared exactly, as stored), so a rename runs after the rename of
+            ;; the choice holding its title. Renames whose titles go round a cycle can't be ordered.
+            holder (into {} (keep (fn [{:keys [id field] :as u}]
+                                    (when (and (renamed id) (= field (get updated-ids id)))
+                                      [(choice-content (d/entity db id)) u]))
+                                  updates))
+            state (volatile! {})
+            applied (volatile! [])
+            _ (doseq [u updates]
+                ((fn visit [{:keys [id field] :as u} path]
+                   (when-not (get @state field)
+                     (vswap! state assoc field :visiting)
+                     (when-let [dep (some->> (renamed id) (choice-stored type) (get holder))]
+                       (when (not= id (:id dep))
+                         (if (= :visiting (get @state (:field dep)))
+                           (let [cycle (drop-while #(not= (:field dep) (:field %)) (conj path u))]
+                             (refuse! field (str (pr-str (renamed id)) " is the title of the choice " (:field dep)
+                                                 " renames, and the renames form a cycle ("
+                                                 (string/join ", " (map :field cycle))
+                                                 "); rename one of them to a spare title in a separate call first")))
+                           (visit dep (conj path u)))))
+                     (vswap! state assoc field :done)
+                     (vswap! applied conj u)))
+                 u []))
+            ;; additions
+            given (into {} (keep (fn [{:keys [id field]}]
+                                   (when-let [t (renamed id)] [(choice-key type t) field]))
+                                 updates))
+            taken (set (keep (fn [{:keys [id text]}] (when-not (renamed id) (choice-key type text))) final))
+            additions (loop [index 0 entries adds given given out []]
+                        (if-let [entry (first entries)]
+                          (let [field (str add-field " " index)
+                                reason (if (map? entry)
+                                         (or (choice-title-refusal type (:title entry)) (choice-fields-refusal entry))
+                                         "give {title, icon?, description?}")
+                                text (when-not reason (choice-text (:title entry)))
+                                k (when text (choice-key type text))]
+                            (cond
+                              reason (do (refuse! field reason) (recur (inc index) (rest entries) given out))
+                              (contains? taken k)
+                              (do (refuse! field (str (pr-str text) " is already a choice on " title))
+                                  (recur (inc index) (rest entries) given out))
+                              (contains? given k)
+                              (do (refuse! field (str (pr-str text) " is already given in " (get given k)))
+                                  (recur (inc index) (rest entries) given out))
+                              :else
+                              (recur (inc index) (rest entries) (assoc given k field)
+                                     (conj out (cond-> {:uuid (random-uuid) :text text}
+                                                 (:icon entry) (assoc :icon (choice-icon (:icon entry)))
+                                                 (:description entry) (assoc :description (:description entry)))))))
+                          out))
+            uuid-of (into {} (map (fn [choice] [(:db/id choice) (:block/uuid choice)]) existing))
+            ;; retire: the property's own choices, each once, none built in or also updated
+            retired (reduce
+                     (fn [retired [index ref]]
+                       (let [field (str "choices.retire " index)
+                             id (resolve-choice db property ref nil)
+                             choice (when id (d/entity db id))
+                             text (when choice (choice-content choice))]
+                         (cond
+                           (nil? id) (do (refuse! field (no-choice ref)) retired)
+                           (some #(= id (:id %)) retired) (do (refuse! field (str (pr-str text) " is listed twice")) retired)
+                           (ldb/built-in? choice) (do (refuse! field (str (pr-str text) " is built in and can't be retired")) retired)
+                           (contains? updated-ids id)
+                           (do (refuse! field (str (pr-str text) " is also changed in " (get updated-ids id))) retired)
+                           :else (conj retired (cond-> {:index index :uuid (uuid-of id) :id id :text text
+                                                        :holders (choice-holders db (:db/ident property) id)}
+                                                 ;; blocks that rely on the default show it
+                                                 (= id (:db/id (:logseq.property/default-value property)))
+                                                 (assoc :default true))))))
+                     [] (map-indexed vector (:retire choices)))
+            retired-uuids (set (map :uuid retired))
+            ;; order: a full permutation of the surviving choices and the additions
+            label (merge (into {} (map (fn [{:keys [id text]}] [(uuid-of id) text]) final))
+                         (into {} (map (fn [{:keys [uuid text]}] [uuid text]) additions)))
+            by-key (into {} (map (fn [[u t]] [(choice-key type t) u]) label))
+            order (when (contains? choices :order)
+                    (let [listed (reduce
+                                  (fn [listed [index ref]]
+                                    (let [field (str "choices.order " index)
+                                          ;; the title the call leaves a choice with first, so a title
+                                          ;; a rename frees and an add or rename takes names the new owner
+                                          u (or (when-let [text (choice-text ref)] (get by-key (choice-key type text)))
+                                                (some-> (resolve-choice db property ref nil) uuid-of))]
+                                      (cond
+                                        (nil? u) (do (refuse! field (no-choice ref)) listed)
+                                        (retired-uuids u) (do (refuse! field (str (pr-str (label u)) " is retired in this call")) listed)
+                                        (some #{u} listed) (do (refuse! field (str (pr-str (label u)) " is listed twice")) listed)
+                                        :else (conj listed u))))
+                                  [] (map-indexed vector (:order choices)))
+                          missing (remove (into (set listed) retired-uuids)
+                                          (concat (map (comp uuid-of :db/id) existing) (map :uuid additions)))]
+                      (when (seq missing)
+                        (refuse! "choices.order" (str "missing " (string/join ", " (map (comp pr-str label) missing)))))
+                      listed))]
+        (if (seq @refusals)
+          ;; Named in request order: add, update, order, then retire (sort-by is stable).
+          {:error (refusals-message (sort-by (fn [{:keys [entry]}]
+                                               (cond (string/starts-with? entry "choices.update") 1
+                                                     (string/starts-with? entry "choices.order") 2
+                                                     (string/starts-with? entry "choices.retire") 3
+                                                     :else 0))
+                                             @refusals))}
+          {:ok (cond-> {:add additions
+                        :update (mapv (fn [{:keys [id entry]}]
+                                        (cond-> {:uuid (uuid-of id)}
+                                          (contains? entry :title) (assoc :text (choice-text (:title entry)))
+                                          (contains? entry :icon) (assoc :icon (choice-icon (:icon entry)))
+                                          (contains? entry :description) (assoc :description (:description entry))))
+                                      @applied)}
+                 order (assoc :order order)
+                 (seq retired) (assoc :retire retired))
+           :expected (cond-> {:titles (merge (into {} (map (fn [[id t]] [(uuid-of id) (choice-stored type t)]) renamed))
+                                             (into {} (map (fn [{:keys [uuid text]}] [uuid (choice-stored type text)]) additions)))
+                              :order (or order (into (filterv (complement retired-uuids) (map (comp uuid-of :db/id) existing))
+                                                     (map :uuid additions)))}
+                       (seq retired) (assoc :retired retired))})))))
+
+(defn- apply-choices!
+  "Inside atomic-write!: writes a validate-choices plan for the property with db id `property-id`:
+  each update, then each addition, then the order, then each retirement. upsert-closed-value! builds
+  and edits the choices as the app does; each new choice, and each choice in `order`, then takes a
+  fresh key after the graph's max. A choice update without icon keeps its icon (upsert-closed-value!
+  would drop it). A retired choice's holders lose it first, by explicit retractions, so no ref is
+  left to it whatever delete-closed-value! cleans up; then it is deleted."
+  [tx-conn property-id {:keys [add update order retire]}]
+  (doseq [{:keys [uuid text icon description] :as change} update]
+    (let [choice (d/entity @tx-conn [:block/uuid uuid])]
+      (outliner-property/upsert-closed-value!
+       tx-conn property-id
+       (cond-> {:id uuid
+                :value (or text (:logseq.property/value choice) (:block/title choice))
+                :icon (if (contains? change :icon) icon (:logseq.property/icon choice))}
+         description (assoc :description description)))))
+  (doseq [{:keys [uuid text icon description]} add]
+    (outliner-property/upsert-closed-value! tx-conn property-id (cond-> {:id uuid :value text}
+                                                                  icon (assoc :icon icon)
+                                                                  description (assoc :description description)))
+    (ldb/transact! tx-conn [[:db/add [:block/uuid uuid] :block/order (db-order/gen-key)]]))
+  (when (seq order)
+    (ldb/transact! tx-conn (mapv (fn [uuid] [:db/add [:block/uuid uuid] :block/order (db-order/gen-key)]) order)))
+  (let [property-ident (:db/ident (d/entity @tx-conn property-id))]
+    (doseq [{:keys [id]} retire]
+      (let [held (mapv (fn [datom] [:db/retract (:e datom) property-ident id])
+                       (d/datoms @tx-conn :avet property-ident id))]
+        (when (seq held) (ldb/transact! tx-conn held)))
+      (outliner-property/delete-closed-value! tx-conn property-id id))))
+
+;; Tag schema writes (createTag, updateTag) take the same shape: every field is checked against the
+;; graph first, then the tag, what it extends and its tag properties are written in one
+;; atomic-write!, and the tag is read back.
+
+(defn- find-tag
+  "updateTag's tag-id: a tag's UUID or its ident (qualified idents contain /, re-encoded by the
+  connector as patch 0016 does)."
+  [db id]
+  (or (find-entity db id)
+      (when (and (string? id) (qualified-keyword? (keyword id)))
+        (d/entity db (keyword id)))))
+
+(defn- resolve-property-selector
+  "The property a selector names by UUID, ident or title, or nil. Only visible properties count, so
+  a tag, a page or a hidden built-in property never matches."
+  [db selector]
+  (when (non-blank-string? selector)
+    (let [property (resolve-property db selector)]
+      (when (property? property) property))))
+
+(defn- extends-path
+  "The tags `from` extends `to` through, nearest first ([] when directly), or nil when it doesn't
+  extend `to`."
+  [from to]
+  (loop [queue [[from []]]
+         seen #{(:db/id from)}]
+    (when-let [[tag via] (first queue)]
+      (let [parents (:logseq.property.class/extends tag)]
+        (if (some #(= (:db/id to) (:db/id %)) parents)
+          via
+          (let [unseen (remove #(seen (:db/id %)) parents)]
+            (recur (into (vec (rest queue)) (map (fn [parent] [parent (conj via parent)]) unseen))
+                   (into seen (map :db/id unseen)))))))))
+
+(defn- extends-refusal
+  "Why `tag` (nil when creating one) can't extend `parent`: a built-in tag the app's extends picker
+  hides (ldb/extends-hidden-tags: Tag, Page, Journal, Query, Template, ...), itself, or a tag that
+  already extends it, named with the path."
+  [tag parent]
+  (if (contains? ldb/extends-hidden-tags (:db/ident parent))
+    (str (:block/title parent) " is a built-in tag that other tags can't extend")
+    (when tag
+      (if (= (:db/id tag) (:db/id parent))
+        (str (:block/title parent) " can't extend itself")
+        (when-let [via (extends-path parent tag)]
+          (str (:block/title parent) " already extends " (:block/title tag)
+               (when (seq via) (str " through " (string/join ", " (map :block/title via))))))))))
+
+(defn- validate-tag-schema
+  "Checks createTag's or updateTag's extends and properties for `tag` (nil when creating):
+  {:parents [tag ...] :properties {:mode :properties}}, each key only when given, or {:error message}
+  naming every refused entry. extends replaces the tags it extends and names at least one;
+  properties is a list on createTag and exactly one of set, add or remove on updateTag."
+  [db tag body]
+  (let [extends (when (contains? body :extends)
+                  (if (and (sequential? (:extends body)) (empty? (:extends body)))
+                    {:error "extends: name at least one tag"}
+                    (validate-selectors db "extends" (:extends body) resolve-tag-selector "tag"
+                                        #(extends-refusal tag %))))
+        [mode selectors] (if tag (mode-change (:properties body)) [:add (:properties body)])
+        properties (when (contains? body :properties)
+                     (if (nil? mode)
+                       {:error "properties: give exactly one of set, add or remove"}
+                       (validate-selectors db (cond-> "properties" tag (str "." (name mode))) selectors
+                                           resolve-property-selector "property"
+                                           (fn [property]
+                                             (when (and (= :remove mode) (ldb/built-in-class-property? tag property))
+                                               (str (:block/title property) " is built in on " (:block/title tag)
+                                                    " and can't be removed"))))))
+        errors (keep :error [extends properties])]
+    (if (seq errors)
+      {:error (string/join "; " errors)}
+      (cond-> {}
+        extends (assoc :parents (:ok extends))
+        properties (assoc :properties {:mode mode :properties (:ok properties)})))))
+
+(defn- write-tag-schema!
+  "Inside atomic-write!: replaces what the tag with db id `tag-id` extends with `parents`, and changes
+  its tag properties as `mode` asks. :set adds what is missing and removes the rest, except the
+  built-in class properties, which class-remove-property! keeps."
+  [tx-conn tag-id parents {:keys [mode properties]}]
+  (when parents
+    (outliner-property/set-block-property! tx-conn tag-id :logseq.property.class/extends (mapv :db/id parents)))
+  (when mode
+    (let [listed (set (map :db/id properties))
+          current (map :db/id (:logseq.property.class/properties (d/entity @tx-conn tag-id)))]
+      (when (#{:add :set} mode)
+        (doseq [id listed] (outliner-property/class-add-property! tx-conn tag-id id)))
+      (doseq [id (case mode :remove listed :set (remove listed current) :add nil)]
+        (outliner-property/class-remove-property! tx-conn tag-id id)))))
+
+(defn- expected-tag-schema
+  "What `tag` (nil when creating one) should hold after write-tag-schema!: :extends, the UUIDs of
+  `parents` less any another one already extends (the outliner drops those), and the tag property
+  UUIDs that must be :present and :absent."
+  [tag parents {:keys [mode properties]}]
+  (let [ancestors (set (mapcat #(map :db/id (ldb/get-class-extends %)) parents))
+        listed (set (map :block/uuid properties))]
+    (cond-> {}
+      parents (assoc :extends (set (keep #(when-not (ancestors (:db/id %)) (:block/uuid %)) parents)))
+      mode (assoc :present (if (= :remove mode) #{} listed)
+                  :absent (case mode
+                            :add #{}
+                            :remove listed
+                            :set (set (keep #(when-not (or (listed (:block/uuid %)) (ldb/built-in-class-property? tag %))
+                                               (:block/uuid %))
+                                            (:logseq.property.class/properties tag))))))))
+
+(defn- verify-tag-schema!
+  "Re-reads the tag from `db` after a write and throws, answered as a 500 by `rejecting`, when what
+  expected-tag-schema says isn't stored."
+  [db tag-uuid {:keys [extends present absent]}]
+  (let [tag (d/entity db [:block/uuid tag-uuid])
+        stored-extends (set (map :block/uuid (:logseq.property.class/extends tag)))
+        stored (set (map :block/uuid (:logseq.property.class/properties tag)))
+        titles (fn [ids] (string/join ", " (map #(or (:block/title (d/entity db [:block/uuid %])) (str %)) ids)))]
+    (unverified!
+     (cond-> []
+       (and extends (seq (remove stored-extends extends)))
+       (conj (str "extends missing " (titles (remove stored-extends extends))))
+       (and extends (seq (remove extends stored-extends)))
+       (conj (str "extends not removed " (titles (remove extends stored-extends))))
+       (seq (remove stored present))
+       (conj (str "properties missing " (titles (remove stored present))))
+       (seq (filter stored absent))
+       (conj (str "properties not removed " (titles (filter stored absent))))))))
+
+;; updateProperty's query flags. A retire whose choices have holders is refused with 409 unless
+;; acknowledge-holders=true; dry-run=true runs the whole update on a throwaway copy of the graph and
+;; answers what it would store, as the guarded deletes do.
+(def ^:private property-update-flags ["acknowledge-holders" "dry-run"])
+
+(defn- retire-held-message
+  "The 409 refusal for retired choices (validate-choices' :retire entries) that blocks hold or that
+  are the property's default value."
+  [held]
+  (let [holding (filter (comp pos? :holders) held)]
+    (str (string/join "; " (map (fn [{:keys [index text holders default]}]
+                                  (str "choices.retire " index ": " (pr-str text) " is "
+                                       (string/join " and is "
+                                                    (cond-> []
+                                                      (pos? holders) (conj (str "held by " holders (if (= 1 holders) " block" " blocks")))
+                                                      default (conj "the property's default value")))))
+                                held))
+         "; set acknowledge-holders=true to "
+         (string/join " and " (cond-> []
+                                (seq holding) (conj (if (= 1 (count held)) "remove it from them" "remove them from their holders"))
+                                (some :default held) (conj "clear the default")))
+         ", or dry-run=true to preview")))
+
+;; Converting text values to choices: updateProperty's convert_values. One :avet scan of the property
+;; finds each holder's values. A value block the property made (free text) is matched by its trimmed
+;; text to one of the choices the call leaves (after its add, update and retire): exactly, then
+;; ignoring case. Any text that matches no choice refuses the call, naming all of them, as does a
+;; value that is neither text nor a choice. Values that are already choices are left alone.
+
+(defn- call-choices
+  "The choices the property has once the call's choices plan (validate-choices' result, or nil) has
+  applied, in editor order, as [{:uuid :text}]."
+  [db property choices]
+  (if-let [{:keys [titles order]} (:expected choices)]
+    (mapv (fn [uuid] {:uuid uuid :text (get titles uuid (some-> (d/entity db [:block/uuid uuid]) choice-content))})
+          order)
+    (mapv (fn [choice] {:uuid (:block/uuid choice) :text (choice-content choice)}) (property-choices property))))
+
+(defn- match-choice
+  "The choice ({:uuid :text}) among `targets` that `text` names: its trimmed text exactly, else
+  ignoring case; nil when none does."
+  [targets text]
+  (let [text (string/trim (str text))]
+    (or (some #(when (= text (:text %)) %) targets)
+        (some #(when (= (string/lower-case text) (string/lower-case (:text %))) %) targets))))
+
+(defn- validate-conversion
+  "Checks updateProperty's convert_values for `property`, given the body and the call's choices
+  result. nil when the body doesn't ask for a conversion, else {:ok plan} or {:error message}. The
+  plan is {:values [{:id :text :choice {:uuid :text} :holders #{holder-id}}] :holders {holder-id
+  #{choice-uuid}}}, values in the order they were made."
+  [db property body choices e2ee?]
+  (let [convert (:convert_values body)
+        title (:block/title property)
+        type (get property :logseq.property/type :default)]
+    (cond
+      (not (contains? body :convert_values)) nil
+      (not (boolean? convert)) {:error "convert_values: give true or false"}
+      (not convert) nil
+      (and (:type body) (not= type (keyword (:type body))))
+      {:error "type: change the type and convert values in separate calls"}
+      (not= :default type)
+      {:error (str "convert_values: " title " is a " (name type)
+                   " property; only a default (text) property's values can be converted")}
+      e2ee? {:error "convert_values: not on an E2EE graph, where choice titles would be stored as plain text"}
+      ;; The outliner's delete keeps a lone value block of a property with a default (it re-points
+      ;; holders at the empty placeholder instead), and the default would stay text.
+      (:logseq.property/default-value property)
+      {:error (str "convert_values: " title " has a default value "
+                   (pr-str (str (db-property/property-value-content (:logseq.property/default-value property))))
+                   "; clear it in the app's property settings first")}
+      :else
+      (let [property-ident (:db/ident property)
+            targets (call-choices db property (when (:ok choices) choices))
+            datoms (d/datoms db :avet property-ident)
+            own? (fn [value] (= (:db/id property) (:db/id (:logseq.property/created-from-property value))))
+            choice? (fn [value] (some #(= (:db/id property) (:db/id %)) (:block/closed-value-property value)))
+            [values other] (reduce (fn [[values other] {:keys [e v]}]
+                                     (let [value (d/entity db v)]
+                                       (cond
+                                         (or (choice? value) (= :logseq.property/empty-placeholder (:db/ident value)))
+                                         [values other]
+                                         (own? value) [(update values v (fnil conj #{}) e) other]
+                                         :else [values (conj other [e value])])))
+                                   [(sorted-map) []] datoms)
+            values (mapv (fn [[id holders]]
+                           (let [text (str (db-property/property-value-content (d/entity db id)))]
+                             {:id id :text text :choice (match-choice targets text) :holders holders}))
+                         values)
+            unmatched (distinct (keep #(when-not (:choice %) (:text %)) values))
+            ;; Deleting a value block deletes the blocks under it, which the caller never named.
+            nested (keep (fn [{:keys [id text]}]
+                           (when (seq (:block/_parent (d/entity db id)))
+                             (str "convert_values: " (:block/uuid (:block/parent (d/entity db id))) " value "
+                                  (pr-str text) " has " (count (ldb/get-block-full-children-ids db id))
+                                  " child blocks; move or delete them first")))
+                         values)]
+        (cond
+          (seq nested) {:error (string/join "; " nested)}
+          (seq other)
+          {:error (string/join "; " (map (fn [[e value]]
+                                           (str "convert_values: " (:block/uuid (d/entity db e)) " holds "
+                                                (or (:block/title value) (:block/uuid value))
+                                                ", which isn't a text value of " title))
+                                         other))}
+          (seq unmatched)
+          {:error (str "convert_values: no choice matches " (string/join ", " (map pr-str unmatched))
+                       "; add them under choices.add in the same call")}
+          :else
+          {:ok {:values values
+                :holders (reduce (fn [holders {:keys [choice] :as value}]
+                                   (reduce #(update %1 %2 (fnil conj #{}) (:uuid choice)) holders (:holders value)))
+                                 {} values)}})))))
+
+(defn- convert-values!
+  "Inside atomic-write!, after the call's choices are written: re-points each holder of a converted
+  value block at its choice (one ref per holder per choice), then deletes the old value blocks."
+  [tx-conn property-ident {:keys [values holders]}]
+  (when (seq values)
+    (ldb/transact! tx-conn (vec (concat
+                                 (for [{:keys [id] :as value} values
+                                       holder (:holders value)]
+                                   [:db/retract holder property-ident id])
+                                 (for [[holder uuids] holders
+                                       uuid uuids]
+                                   [:db/add holder property-ident [:block/uuid uuid]]))))
+    (outliner-core/delete-blocks! tx-conn (mapv #(d/entity @tx-conn (:id %)) values) {})))
