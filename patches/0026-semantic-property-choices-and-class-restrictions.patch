+(deftest classes-write-is-one-transaction-test
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self client]}]
+        (let [reports (atom [])]
+          (d/listen! conn ::reports (fn [report] (when (seq (:tx-data report)) (swap! reports conj report))))
+          (p/let [created (request! self "POST" "/semantic/properties"
+                                    {:title "engagement-partner" :type "node" :classes ["Client"]})
+                  _ (d/unlisten! conn ::reports)
+                  tx-data (mapcat :tx-data @reports)
+                  property-id (:db/id (entity conn (uuid (get-in created [:body :uuid]))))]
+            (is (= 201 (:status created)) (str (:body created)))
+            (is (= 1 (count @reports)) "one transaction")
+            (is (= 1 (count (distinct (map :tx tx-data)))) "one tx id")
+            (is (some #(and (= property-id (:e %)) (= :logseq.property/classes (:a %))
+                            (= (:db/id client) (:v %)))
+                      tx-data)
+                "the classes are in the property's own transaction")))))))
+
+(deftest class-selector-resolves-among-tags-test
+  ;; A class is a tag given by UUID, ident or title: a title matches exactly first, then ignoring
+  ;; case, and a recycled tag is not one.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn self service for-client]}]
+        (p/let [shouting (random-uuid)
+                gone (random-uuid)
+                _ (d/transact! conn [{:block/uuid shouting :block/name "client" :block/title "CLIENT"
+                                      :block/tags #{:logseq.class/Tag} :block/created-at 1 :block/updated-at 1}
+                                     {:block/uuid gone :block/name "gone" :block/title "Gone"
+                                      :block/tags #{:logseq.class/Tag} :logseq.property/deleted-at 1
+                                      :block/created-at 1 :block/updated-at 1}])
+                lower (restrict! self for-client :set ["service"])
+                lower-classes (class-uuids conn for-client)
+                exact (restrict! self for-client :set ["CLIENT"])
+                exact-classes (class-uuids conn for-client)
+                recycled (restrict! self for-client :set ["Gone"])]
+          (is (= 200 (:status lower)) (str (:body lower)))
+          (is (= #{(:block/uuid service)} lower-classes) "a title matches a tag ignoring case")
+          (is (= 200 (:status exact)) (str (:body exact)))
+          (is (= #{shouting} exact-classes)
+              "an exact title wins over an older tag whose title differs only by case")
+          (is (= 400 (:status recycled)) (str (:body recycled)))
+          (is (= "classes.set 0: no tag \"Gone\"" (get-in recycled [:body :error]))))))))
+
+(deftest property-schema-read-back-test
+  ;; After a write the property is read back; classes that aren't stored as asked answer 500,
+  ;; naming them, rather than success.
+  (async done
+    (with-graph done
+      (fn [{:keys [conn client service for-client]}]
+        (let [verify! #'semantic/verify-property-schema!
+              property-uuid (:block/uuid (d/entity @conn for-client))
+              thrown (fn [expected]
+                       (try (verify! @conn property-uuid expected) nil
+                            (catch :default e (ex-message e))))]
+          (d/transact! conn [[:db/add (:db/id (d/entity @conn for-client)) :logseq.property/classes (:db/id service)]])
+          (is (nil? (thrown {:classes #{(:block/uuid service)}})) "what was asked is stored")
+          (is (nil? (thrown {})) "nothing asked, nothing checked")
+          (is (= "the write did not store what was asked: classes missing Client; classes not removed Service"
+                 (thrown {:classes #{(:block/uuid client)}}))))))))
