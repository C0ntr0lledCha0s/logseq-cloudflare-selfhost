+        (fn []
+          (p/let [{:keys [self]} (server-graph)
+                  example (page! self "Example")
+                  [a b] (ids 2)
+                  _ (insert! self example [{:uuid a :title " "} {:uuid b :title " "}])
+                  _ (set! outliner-core/delete-blocks! (fn [conn blocks opts] (original conn (vec (butlast blocks)) opts)))
+                  response (apply! self [example] [a b])]
+            (is (= 500 (:status response)) (pr-str response))
+            (is (= [b] (get-in response [:body :not-removed])))
+            (is (string/includes? (str (get-in response [:body :error])) b))))))))
