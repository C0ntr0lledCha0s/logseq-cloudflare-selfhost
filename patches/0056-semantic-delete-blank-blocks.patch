+;; ---------------------------------------------------------------------------------------------
+;; The apply: block-ids re-judged inside one transaction, deleted by one delete-blocks! call
+
+(defn- apply! [self page-ids block-ids & opts]
+  (apply blank! self {:page-ids page-ids :block-ids block-ids} opts))
+
+(defn- listed-ids
+  "The block-ids a dry run of `page-ids` lists, in its order."
+  [self page-ids]
+  (p/let [r (ok! (dry-run! self page-ids) 200)]
+    (vec (mapcat #(map :uuid (:would-delete %)) (get-in r [:body :pages])))))
+
+(defn- live? [db id]
+  (let [entity (d/entity db [:block/uuid (uuid (str id))])]
+    (boolean (and entity (not (:logseq.property/deleted-at entity))))))
+
+(defn- outline
+  "The live blocks on `page` (a uuid string), as {parent [children in :block/order]}, with the page
+  itself keyed :page: what a client shows, so a server and a replayed client compare."
+  [db page]
+  (let [page-eid (:db/id (d/entity db [:block/uuid (uuid page)]))]
+    (->> (d/datoms db :avet :block/page page-eid)
+         (map #(d/entity db (:e %)))
+         (remove :logseq.property/deleted-at)
+         (group-by #(str (:block/uuid (:block/parent %))))
+         (map (fn [[parent blocks]] [(if (= parent page) :page parent) (mapv #(str (:block/uuid %)) (sort-by :block/order blocks))]))
+         (into {}))))
+
+(defn- two-pages!
+  "Pages Example and Projects with blank leaves between blocks of text, none adjacent: e2 and e4 on
+  Example, e7 between two children of e5, p2 (a tab) and p4 (the last block) on Projects. `uuids` is
+  12 uuid strings, so separate graphs can hold the same blocks."
+  [self [e1 e2 e3 e4 e5 e6 e7 e8 p1 p2 p3 p4 :as uuids]]
+  (p/let [example (page! self "Example")
+          projects (page! self "Projects")
+          _ (insert! self example [{:uuid e1 :title "one"} {:uuid e2 :title " "} {:uuid e3 :title "two"} {:uuid e4 :title " "}
+                                   {:uuid e5 :title "three" :children [{:uuid e6 :title "a child"} {:uuid e7 :title " "}
+                                                                       {:uuid e8 :title "another child"}]}])
+          _ (insert! self projects [{:uuid p1 :title "four"} {:uuid p2 :title "\t"} {:uuid p3 :title "five"} {:uuid p4 :title " "}])]
+    {:example example :projects projects :ids (zipmap [:e1 :e2 :e3 :e4 :e5 :e6 :e7 :e8 :p1 :p2 :p3 :p4] uuids)}))
