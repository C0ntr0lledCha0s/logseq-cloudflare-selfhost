+(deftest apply-refusals-test
+  ;; Each refusal names block-ids[i] and writes nothing; a good blank leaf sits at index 0 of each call
+  ;; and survives it. Between the dry run and the apply, blocks are given text, a child, a move to an
+  ;; unlisted page, a referrer and a client editing them; other ids are guessed: a block with text, a
+  ;; blank parent listed with its blank child (either order), a typed, tagged or valued blank block, a
+  ;; blank leaf under Private, a recycled one, the page, a property, a tag, a journal, and malformed,
+  ;; duplicate and unknown ids.
+  (async done
+    (run done
+      (fn []
+        (p/let [{:keys [self sql]} (server-graph)
+                _ (opened! self)
+                _ (ok! (request! self "POST" "/semantic/tags" {:title "Private"}) 201)
+                rating (ok! (request! self "POST" "/semantic/properties" {:title "Rating" :type "default"}) 201)
+                rating-ident (get-in rating [:body :ident])
+                topic (ok! (request! self "POST" "/semantic/tags" {:title "Topic"}) 201)
+                capture (ok! (request! self "POST" "/semantic/capture" {:blocks [{:title "today"}]}) 201)
+                example (page! self "Example")
+                other (page! self "Other")
+                [good texted childed moved worded parent child edited refd task rated coded private-block under-private
+                 recycled valued] (ids 16)
+                _ (insert! self example [{:uuid good :title " "} {:uuid texted :title " "} {:uuid childed :title " "}
+                                         {:uuid moved :title " "} {:uuid worded :title "words"}
+                                         {:uuid parent :title " " :children [{:uuid child :title " "}]}
+                                         {:uuid edited :title " "} {:uuid refd :title " "} {:uuid task :title " "}
+                                         {:uuid rated :title " "} {:uuid coded :title " " :display-type "code"}
+                                         {:uuid private-block :title "a private block" :children [{:uuid under-private :title " "}]}
+                                         {:uuid recycled :title " "} {:uuid valued :title "a valued block"}])
+                [elsewhere] (insert! self other [{:title "on another page"}])
+                listed (listed-ids self [example])
+                ;; After the dry run:
+                _ (ok! (request! self "PATCH" (str "/semantic/blocks/" texted) {:title "now has text"}) 200)
+                _ (insert! self childed [{:title "a new child"}])
+                _ (ok! (request! self "POST" "/semantic/block-moves"
+                                 {:block-ids [moved] :target-id (:uuid elsewhere) :position "after"}) 200)
+                _ (outliner-insert! self other [{:block/uuid (random-uuid) :block/title (str "see ((" refd "))")
+                                                 :block/refs [[:block/uuid (uuid refd)]]}])
+                _ (editing! self edited)
+                _ (set-property! self task "block/tags" ["Task"])
+                _ (set-property! self rated rating-ident "four stars")
+                _ (set-property! self private-block "block/tags" ["Private"])
+                _ (set-property! self valued rating-ident "a value")
+                conn (.-conn self)
+                value-uuid (str (:block/uuid (d/entity @conn (:v (first (d/datoms @conn :eavt (:db/id (d/entity @conn [:block/uuid (uuid valued)]))
+                                                                                     (keyword rating-ident)))))))
+                _ (set-attr! self value-uuid :block/title "")
+                _ (set-attr! self recycled :logseq.property/deleted-at 1)
+                before (written-state sql self)
+                cases [["given text after the dry run" [good texted] 409 "block-ids[1]: no longer blank (it has text)"]
+                       ["given a child after the dry run" [good childed] 409 "block-ids[1]: has children"]
+                       ["moved to an unlisted page after the dry run" [good moved] 409 "block-ids[1]: not on a listed page"]
+                       ["referenced after the dry run" [good refd] 409 "block-ids[1]: referenced"]
+                       ["now being edited in the app" [good edited] 409 "block-ids[1]: being edited in the app"]
+                       ["a guessed block with text" [good worded] 409 "block-ids[1]: no longer blank (it has text)"]
+                       ["a guessed block on another page" [good (:uuid elsewhere)] 409 "block-ids[1]: not on a listed page"]
+                       ["a blank parent listed after its blank child" [good child parent] 409 "block-ids[2]: has children"]
+                       ["a blank parent listed before its blank child" [good parent child] 409 "block-ids[1]: has children"]
+                       ["an empty Task" [good task] 409 "block-ids[1]: not a plain block"]
+                       ["a blank block with a property" [good rated] 409 "block-ids[1]: not a plain block"]
+                       ["an empty Code block" [good coded] 409 "block-ids[1]: not a plain block"]
+                       ["a blank value block" [good value-uuid] 409 "block-ids[1]: not a plain block"]
+                       ["the page itself" [good example] 409 "block-ids[1]: not a plain block"]
+                       ["a property" [good (get-in rating [:body :uuid])] 409 "block-ids[1]: not a plain block"]
+                       ["a tag" [good (get-in topic [:body :uuid])] 409 "block-ids[1]: not a plain block"]
+                       ["a journal page" [good (get-in capture [:body :page-id])] 409 "block-ids[1]: not a plain block"]
+                       ["a blank leaf under a Private block" [good under-private] 409 "block-ids[1]: is Private"]
+                       ["a recycled blank leaf" [good recycled] 404 "block-ids[1]: block not found"]
+                       ["an unknown uuid" [good (str (random-uuid))] 404 "block-ids[1]: block not found"]
+                       ["a title, not a uuid" [good "Example"] 400 "block-ids[1]: not a UUID"]
+                       ["a number" [good 42] 400 "block-ids[1]: not a UUID"]
+                       ["an empty string" [good ""] 400 "block-ids[1]: not a UUID"]
+                       ["a uuid with a space" [good (str " " good)] 400 "block-ids[1]: not a UUID"]
+                       ["a duplicate" [good good] 400 "block-ids[1]: duplicate of block-ids[0]"]
+                       ["a duplicate in another case" [good (string/upper-case good)] 400 "block-ids[1]: duplicate of block-ids[0]"]
+                       ["the first failure is named" [good texted childed] 409 "block-ids[1]: no longer blank (it has text)"]
+                       ["no block-ids" [] 400 "block-ids: 1 to 100 block UUIDs"]
+                       ["101 block-ids" (vec (cons good (ids 100))) 400 "block-ids: 1 to 100 block UUIDs"]]
+                responses (p/all (map (fn [[_ block-ids]] (apply! self [example] block-ids)) cases))
+                after (written-state sql self)
+                good-alone (apply! self [example] [good])]
+          (is (= #{good texted childed moved refd edited child task rated under-private recycled} (set listed))
+              "the dry run listed every blank leaf before it changed")
+          (doseq [[[label _ status prefix] response] (map vector cases responses)]
+            (testing label
+              (is (refused? response status prefix) (pr-str response))))
+          (is (= before after) "no refusal wrote anything")
+          (is (= 200 (:status good-alone)) (str "the good leaf was deletable all along: " (pr-str good-alone))))))))
