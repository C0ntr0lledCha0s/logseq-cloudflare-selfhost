+(deftest apply-rejudges-on-the-transaction-db-test
+  ;; Text typed into a listed block while the apply's body is still arriving. The handler read the
+  ;; graph before it read the body, so only a re-judge on the transaction's db sees the text.
+  (async done
+    (run done
+      (fn []
+        (let [pending (atom nil)
+              controller (atom nil)]
+          (p/let [{:keys [self]} (server-graph)
+                  example (page! self "Example")
+                  [a b] (ids 2)
+                  _ (insert! self example [{:uuid a :title " "} {:uuid b :title " "}])
+                  stream (js/ReadableStream. #js {:start (fn [c] (reset! controller c))})
+                  _ (do (reset! pending (sync-handler/handle-http
+                                         self
+                                         (js/Request. "http://localhost/semantic/blank-blocks/delete?graph-id=graph-1"
+                                                      #js {:method "POST" :body stream :duplex "half"
+                                                           :headers (js/Headers. #js {"content-type" "application/json"
+                                                                                      "x-logseq-sync-actor" actor})})))
+                        nil)
+                  _ (p/delay 20)
+                  _ (d/transact! (.-conn self) [[:db/add [:block/uuid (uuid b)] :block/title "typed meanwhile"]])
+                  _ (do (.enqueue @controller (.encode (js/TextEncoder.)
+                                                       (js/JSON.stringify (clj->js {:page-ids [example] :block-ids [a b]}))))
+                        (.close @controller)
+                        nil)
+                  response @pending
+                  text (.text response)]
+            (is (= 409 (.-status response)) text)
+            (is (string/includes? text "block-ids[1]: no longer blank (it has text)"))
+            (is (live? @(.-conn self) a) "nothing was deleted")))))))
