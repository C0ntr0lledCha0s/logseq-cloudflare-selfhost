+(deftest internal-references-test
+  ;; A blank leaf that an internal ref property targets is referenced, as a link or a property value
+  ;; is: a range comment over two blank leaves (the app puts its Comments area beside the last
+  ;; target, holding :logseq.property.comments/blocks #{a b}, so neither gets a child), a reaction
+  ;; (:logseq.property.reaction/target), a view (:logseq.property/view-for) and a property history
+  ;; entry (:logseq.property.history/block). The dry run keeps them under kept.referenced and lists
+  ;; only the plain blank leaf; an apply that names one refuses the whole call; and an apply of the
+  ;; listed leaf leaves the comment thread in place. Before the fix the dry run listed all six, and
+  ;; deleting a and b deleted the Comments area and the comment under it (outliner delete-blocks'
+  ;; orphaned-range-comments-areas).
+  (async done
+    (run done
+      (fn []
+        (p/let [{:keys [self sql]} (server-graph)
+                _ (opened! self)
+                page (page! self "Example")
+                [a b reacted viewed historied plain] (ids 6)
+                _ (insert! self page [{:uuid a :title " "} {:uuid b :title " "} {:uuid reacted :title " "}
+                                      {:uuid viewed :title " "} {:uuid historied :title " "} {:uuid plain :title " "}])
+                conn (.-conn self)
+                eid #(:db/id (d/entity @conn [:block/uuid (uuid %)]))
+                page-eid (eid page)
+                [area comment reaction view history] (ids 5)
+                _ (d/transact! conn [{:block/uuid (uuid area) :block/title "Comments" :block/parent page-eid
+                                      :block/page page-eid :block/order (db-order/gen-key) :block/created-at 1
+                                      :block/updated-at 1 :block/tags #{:logseq.class/Comments}
+                                      :logseq.property.comments/blocks #{(eid a) (eid b)}}
+                                     {:block/uuid (uuid reaction) :block/created-at 1
+                                      :logseq.property.reaction/emoji-id "+1"
+                                      :logseq.property.reaction/target (eid reacted)}
+                                     {:block/uuid (uuid view) :block/created-at 1
+                                      :logseq.property/view-for (eid viewed)}
+                                     {:block/uuid (uuid history) :block/created-at 1
+                                      :logseq.property.history/block (eid historied)
+                                      :logseq.property.history/property :logseq.property/status}])
+                _ (outliner-insert! self area [{:block/uuid (uuid comment) :block/title "fill these two in before Friday"}])
+                response (ok! (dry-run! self [page]) 200)
+                entry (get-in response [:body :pages 0])
+                before (written-state sql self)
+                refusals (p/all (map #(apply! self [page] [plain %]) [a b reacted viewed historied]))
+                after (written-state sql self)
+                applied (apply! self [page] [plain])]
+          (is (= [plain] (map :uuid (:would-delete entry))) (pr-str entry))
+          (is (= {:has-children 0 :referenced 5 :in-template 0 :being-edited 0} (dissoc (:kept entry) :examples)))
+          (is (= (set (map #(hash-map :uuid % :reason "referenced") [a b reacted viewed historied]))
+                 (set (get-in entry [:kept :examples]))))
+          (doseq [[label response] (map vector ["a range comment's first target" "a range comment's last target"
+                                                "a reaction's target" "a view's block" "a history entry's block"]
+                                        refusals)]
+            (testing label
+              (is (refused? response 409 "block-ids[1]: referenced") (pr-str response))))
+          (is (= before after) "no refusal wrote anything")
+          (is (= 200 (:status applied)) (pr-str applied))
+          (is (not (live? @conn plain)))
+          (is (every? #(live? @conn %) [a b area comment reaction view history])
+              "the comment thread, the reaction, the view and the history entry are still there"))))))
+
+(deftest internal-reference-missing-from-schema-test
+  ;; A graph from an app older than one of those properties (reactions came in schema 65.22) has no
+  ;; schema entry for it, and Datascript refuses an :avet read of an attribute it doesn't index, even
+  ;; when a datom of it, stored as a plain value, holds the blank block's id. The dry run and the
+  ;; apply read only the ones the graph's schema holds as refs, so they still answer.
+  (async done
+    (run done
+      (fn []
+        (p/let [{:keys [self sql]} (server-graph)
+                _ (opened! self)
+                page (page! self "Example")
+                [blank] (ids 1)
+                _ (insert! self page [{:uuid blank :title " "}])
+                conn (.-conn self)
+                _ (d/reset-conn! conn (d/init-db (d/datoms @conn :eavt)
+                                                 (dissoc (d/schema @conn) :logseq.property.reaction/target)
+                                                 {:storage (storage/new-sqlite-storage sql)}))
+                _ (assert (nil? (get (d/schema @conn) :logseq.property.reaction/target)))
+                _ (d/transact! conn [{:block/uuid (random-uuid)
+                                      :logseq.property.reaction/target
+                                      (:db/id (d/entity @conn [:block/uuid (uuid blank)]))}])
+                response (dry-run! self [page])
+                applied (apply! self [page] [blank])]
+          (is (= 200 (:status response)) (pr-str response))
+          (is (= [blank] (map :uuid (get-in response [:body :pages 0 :would-delete]))))
+          (is (= 200 (:status applied)) (pr-str applied)))))))
+
+;; ---------------------------------------------------------------------------------------------
+;; Template slots, recycled referrers and the Recycle bin in remaining-blocks (review round 2)
+
+(deftest template-slots-test
+  ;; A template's blank bullets are placeholders the owner fills in each time the template is used,
+  ;; not leftovers. A blank leaf with an ancestor tagged Template, or tagged with a class that extends
+  ;; Template, is kept as "in a template": a slot directly under the template root, one nested deeper,
+  ;; one under a root tagged with a tag extending Template, and one on a page tagged Template. The dry
+  ;; run lists only the plain blank leaf outside them, and an apply that names a slot refuses the whole
+  ;; call with 409 and writes nothing. Before the fix the dry run listed them all, and the apply
+  ;; deleted the slots.
+  (async done
+    (run done
+      (fn []
+        (p/let [{:keys [self sql]} (server-graph)
+                _ (opened! self)
+                page (page! self "Example")
+                meeting-template (ok! (request! self "POST" "/semantic/tags" {:title "Meeting Template"}) 201)
+                ;; The API refuses a tag extending Template (a built-in tag); the app makes one this way.
+                _ (set-attr! self (get-in meeting-template [:body :uuid]) :logseq.property.class/extends
+                             [:db/ident :logseq.class/Template])
+                [root direct agenda nested other-root extended plain] (ids 7)
+                _ (insert! self page [{:uuid root :title "Weekly review"
+                                       :children [{:uuid direct :title " "}
+                                                  {:uuid agenda :title "Agenda" :children [{:uuid nested :title " "}]}]}
+                                      {:uuid other-root :title "Standup" :children [{:uuid extended :title " "}]}
+                                      {:uuid plain :title " "}])
+                _ (set-property! self root "block/tags" ["Template"])
+                _ (set-property! self other-root "block/tags" ["Meeting Template"])
+                daily (page! self "Daily template")
+                [on-page] (ids 1)
+                _ (insert! self daily [{:uuid on-page :title " "}])
+                _ (set-attr! self daily :block/tags [:db/ident :logseq.class/Template])
+                response (ok! (dry-run! self [page daily]) 200)
+                entry (get-in response [:body :pages 0])
+                daily-entry (get-in response [:body :pages 1])
+                before (written-state sql self)
+                refusals (p/all (concat (map #(apply! self [page] [plain %]) [direct nested extended])
+                                        [(apply! self [page daily] [plain on-page])]))
+                after (written-state sql self)
+                applied (apply! self [page] [plain])]
+          (is (= [plain] (map :uuid (:would-delete entry))) (pr-str entry))
+          (is (= {:has-children 0 :referenced 0 :in-template 3 :being-edited 0} (dissoc (:kept entry) :examples)))
+          (is (= (set (map #(hash-map :uuid % :reason "in a template") [direct nested extended]))
+                 (set (get-in entry [:kept :examples]))))
+          (is (= [] (:would-delete daily-entry)) (pr-str daily-entry))
+          (is (= [{:uuid on-page :reason "in a template"}] (get-in daily-entry [:kept :examples])))
+          (doseq [[label response] (map vector ["a slot directly under the template root" "a slot nested deeper"
+                                                "a slot under a tag that extends Template" "a slot on a page tagged Template"]
+                                        refusals)]
+            (testing label
+              (is (refused? response 409 "block-ids[1]: in a template") (pr-str response))))
+          (is (= before after) "no refusal wrote anything")
+          (is (= 200 (:status applied)) (pr-str applied))
+          (is (not (live? @(.-conn self) plain)))
+          (is (every? #(live? @(.-conn self) %) [root direct agenda nested other-root extended on-page])))))))
+
+(deftest recycled-and-hidden-referrers-test
+  ;; A referrer counts wherever it is: a block in the Recycle bin, a block on a recycled page, a
+  ;; hidden block (hide?) and a recycled Comments area (an internal reference). Restoring the page
+  ;; brings the link back, so a delete would break it. The dry run keeps each blank target as
+  ;; referenced, and an apply that names one refuses the whole call with 409. Before the fix
+  ;; referrer-ids read only visible referrers, so the dry run listed all four and the apply deleted them.
+  (async done
+    (run done
+      (fn []
+        (p/let [{:keys [self sql]} (server-graph)
+                _ (opened! self)
+                page (page! self "Example")
+                old (page! self "Old notes")
+                [by-recycled by-recycled-page by-hidden by-recycled-comment plain] (ids 5)
+                _ (insert! self page [{:uuid by-recycled :title " "} {:uuid by-recycled-page :title " "}
+                                      {:uuid by-hidden :title " "} {:uuid by-recycled-comment :title " "}
+                                      {:uuid plain :title " "}])
+                [recycled-ref page-ref hidden-ref area] (map uuid (ids 4))
+                _ (outliner-insert! self page [{:block/uuid recycled-ref :block/title (str "see [[" by-recycled "]]")
+                                                :block/refs [[:block/uuid (uuid by-recycled)]]}
+                                               {:block/uuid hidden-ref :block/title (str "see [[" by-hidden "]]")
+                                                :block/refs [[:block/uuid (uuid by-hidden)]]}])
+                _ (outliner-insert! self old [{:block/uuid page-ref :block/title (str "see [[" by-recycled-page "]]")
+                                               :block/refs [[:block/uuid (uuid by-recycled-page)]]}])
+                conn (.-conn self)
+                eid #(:db/id (d/entity @conn [:block/uuid (uuid (str %))]))
+                page-eid (eid page)
+                _ (d/transact! conn [{:block/uuid area :block/title "Comments" :block/parent page-eid
+                                      :block/page page-eid :block/order (db-order/gen-key) :block/created-at 1
+                                      :block/updated-at 1 :block/tags #{:logseq.class/Comments}
+                                      :logseq.property.comments/blocks #{(eid by-recycled-comment)}}])
+                _ (set-attr! self recycled-ref :logseq.property/deleted-at 1)
+                _ (set-attr! self old :logseq.property/deleted-at 1)
+                _ (set-attr! self hidden-ref :logseq.property/hide? true)
+                _ (set-attr! self area :logseq.property/deleted-at 1)
+                response (ok! (dry-run! self [page]) 200)
+                entry (get-in response [:body :pages 0])
+                before (written-state sql self)
+                refusals (p/all (map #(apply! self [page] [plain %]) [by-recycled by-recycled-page by-hidden by-recycled-comment]))
+                after (written-state sql self)]
+          (is (= [plain] (map :uuid (:would-delete entry))) (pr-str entry))
+          (is (= 4 (get-in entry [:kept :referenced])) (pr-str entry))
+          (is (= (set (map #(hash-map :uuid % :reason "referenced") [by-recycled by-recycled-page by-hidden by-recycled-comment]))
+                 (set (get-in entry [:kept :examples]))))
+          (doseq [[label response] (map vector ["a referrer in the Recycle bin" "a referrer on a recycled page"
+                                                "a hidden referrer" "a recycled comment thread"]
+                                        refusals)]
+            (testing label
+              (is (refused? response 409 "block-ids[1]: referenced") (pr-str response))))
+          (is (= before after) "no refusal wrote anything"))))))
+
+(deftest remaining-blocks-leaves-out-the-recycle-bin-test
+  ;; A block moved to the Recycle bin keeps its :block/page (as a delete_block of a block leaves it,
+  ;; with deleted-at set), so the page's :block/page datoms still hold it. remaining-blocks counts
+  ;; what the page shows, so the apply's answer leaves it out: Example keeps "one" and "two", not the
+  ;; recycled block or the recycled block's child.
+  (async done
+    (run done
+      (fn []
+        (p/let [{:keys [self]} (server-graph)
+                _ (opened! self)
+                page (page! self "Example")
+                [one blank recycled under two] (ids 5)
+                _ (insert! self page [{:uuid one :title "one"} {:uuid blank :title " "}
+                                      {:uuid recycled :title "recycled" :children [{:uuid under :title "under it"}]}
+                                      {:uuid two :title "two"}])
+                _ (set-attr! self recycled :logseq.property/deleted-at 1)
+                _ (set-attr! self under :logseq.property/deleted-at 1)
+                conn (.-conn self)
+                _ (assert (= (:db/id (d/entity @conn [:block/uuid (uuid page)]))
+                             (:db/id (:block/page (d/entity @conn [:block/uuid (uuid recycled)])))))
+                response (apply! self [page] [blank])]
+          (is (= 200 (:status response)) (pr-str response))
+          (is (= [{:page "Example" :uuid page :deleted 1 :remaining-blocks 2}] (get-in response [:body :pages]))))))))
