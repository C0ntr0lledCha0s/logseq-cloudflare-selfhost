+(deftest apply-deletes-dry-run-ids-test
+  ;; A dry run, then an apply of exactly the ids it listed, reached through handle (which seeds the
+  ;; max order key): the answer counts each page's deletes and the blocks it still holds, the blocks
+  ;; are gone from listPageBlocks, and a re-sent apply finds nothing to delete and writes nothing.
+  ;; Pages are named by uuid, by title and by date; one page has nothing blank; one leaf carries
+  ;; Claude's stamps; on an uploaded graph the app's own blank leaf is deleted the same way.
+  (async done
+    (run done
+      (fn []
+        (p/let [{:keys [self sql]} (server-graph)
+                {:keys [example projects ids]} (two-pages! self (ids 12))
+                [stamped] (insert! self example [{:title " "}] :headers [["x-logseq-edit-stamp" "claude"]])
+                quiet (page! self "Quiet")
+                _ (insert! self quiet [{:title "nothing blank here"}])
+                capture (ok! (request! self "POST" "/semantic/capture" {:blocks [{:title " "}]}) 201)
+                journal (get-in capture [:body :page-id])
+                selectors [example "Projects" (today-iso) "quiet"]
+                listed (listed-ids self selectors)
+                [t0 rows0] (written-state sql self)
+                response (apply! self selectors listed)
+                [t1 rows1] (written-state sql self)
+                example-blocks (ok! (request! self "GET" (str "/semantic/pages/" example "/blocks") nil) 200)
+                again-state (written-state sql self)
+                again (apply! self selectors listed)
+                after-dry-run (ok! (dry-run! self selectors) 200)
+                {uploaded :self app :app} (uploaded-graph)
+                _ (opened! uploaded)
+                app-listed (listed-ids uploaded [app-page])
+                app-apply (apply! uploaded [app-page] app-listed)]
+          (is (= (set (concat (map ids [:e2 :e4 :e7]) [(:uuid stamped)] (map ids [:p2 :p4])
+                              [(get-in capture [:body :blocks 0 :uuid])]))
+                 (set listed)))
+          (is (= 200 (:status response)) (pr-str response))
+          (is (= {:deleted 7
+                  :t t1
+                  :pages [{:page "Example" :uuid example :deleted 4 :remaining-blocks 5}
+                          {:page "Projects" :uuid projects :deleted 2 :remaining-blocks 2}
+                          {:page (get-in capture [:body :page-title]) :uuid journal :deleted 1 :remaining-blocks 0}
+                          {:page "Quiet" :uuid quiet :deleted 0 :remaining-blocks 1}]}
+                 (:body response)))
+          (is (= [(inc t0) (inc rows0)] [t1 rows1]) "one write")
+          (is (not-any? #(string/includes? (:text example-blocks) %) listed) "listPageBlocks no longer shows them")
+          (is (string/includes? (:text example-blocks) (:e1 ids)))
+          (testing "a re-sent apply: nothing is left to delete, and nothing is written"
+            (is (refused? again 404 "block-ids[0]: block not found") (pr-str again))
+            (is (= again-state (written-state sql self))))
+          (is (= 0 (get-in after-dry-run [:body :total])) "a dry run afterwards finds nothing blank")
+          (testing "an uploaded graph: the app's blank leaf goes, its blank parent stays"
+            (is (= [(:leaf app)] app-listed))
+            (is (= 200 (:status app-apply)) (pr-str app-apply))
+            (is (= 1 (get-in app-apply [:body :deleted])))
+            (is (not (live? @(.-conn uploaded) (:leaf app))))
+            (is (live? @(.-conn uploaded) (:parent app)))))))))
