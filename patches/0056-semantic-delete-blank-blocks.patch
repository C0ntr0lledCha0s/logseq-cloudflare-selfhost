+;; ---------------------------------------------------------------------------------------------
+;; Refusals
+
+(defn- refused? [response status prefix]
+  (and (= status (:status response))
+       (string/starts-with? (str (get-in response [:body :error])) prefix)))
+
+(defn- bulk-blocks!
+  "`n` plain blocks on `page`, transacted directly in the outliner's block shape (a fixture shortcut
+  for size; the API inserts the same blocks one request at a time)."
+  [self page n]
+  (let [conn (.-conn self)
+        page-eid (:db/id (d/entity @conn [:block/uuid (uuid page)]))]
+    (d/transact! conn (vec (for [[i order] (map-indexed vector (db-order/gen-n-keys n nil nil))]
+                             {:block/uuid (random-uuid) :block/title (if (even? i) " " (str "block " i))
+                              :block/parent page-eid :block/page page-eid :block/order order
+                              :block/created-at 1 :block/updated-at 1})))))
+
