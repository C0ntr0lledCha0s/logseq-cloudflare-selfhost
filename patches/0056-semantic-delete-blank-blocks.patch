+(ns logseq.db-sync.semantic-delete-blank-blocks-test
+  "deleteBlankBlocks (patch 0056): page resolution, the blank predicate, the dry run and the apply.
+  A call names 1 to 20 pages; any page that doesn't resolve to one visible, plain, non-Private page
+  refuses the whole call naming page-ids[i]. A dry run judges every block on the pages and lists the
+  plain blank leaves (an empty or whitespace title, no children, no tags, nothing but the built-in
+  bookkeeping and Claude's stamps, no referrer, not Private, not being edited) without writing.
+  Blank blocks kept for a reason the caller can act on are counted with examples; blank blocks under
+  Private content are counted only; every other blank-looking block (value blocks, typed blocks,
+  headings, tagged blocks) is left out. An apply takes 1 to 100 block-ids, re-judges each inside one
+  transaction (refusing the whole call naming block-ids[i]), deletes them with one delete-blocks!
+  call (one tx_log row, one tx id) and reads back that they are gone.
+  Graphs sit on a real SQLite store (better-sqlite3) and every call goes through handle-http, on a
+  graph created on the server and on one that arrived through the app's snapshot upload."
+  (:require ["better-sqlite3" :as sqlite3]
+            [cljs.test :refer [async deftest is testing]]
+            [clojure.set :as set]
+            [clojure.string :as string]
+            [datascript.core :as d]
+            [logseq.db.common.order :as db-order]
+            [logseq.db-sync.common :as common]
+            [logseq.db-sync.storage :as storage]
+            [logseq.db-sync.worker.handler.sync :as sync-handler]
+            [logseq.db-sync.worker.presence :as presence]
+            [logseq.db.frontend.schema :as db-schema]
+            [logseq.db.sqlite.create-graph :as sqlite-create-graph]
+            [logseq.outliner.core :as outliner-core]
+            [logseq.outliner.page :as outliner-page]
+            [promesa.core :as p]))
+
+;; The spec's allow-list (section 3.4 step 2): the attributes a plain blank block may hold.
+(def ^:private plain-block-attributes
+  #{:block/uuid :block/parent :block/page :block/order :block/title :block/created-at :block/updated-at
+    :block/tx-id :logseq.property/created-by-ref :user.property/claude-editedBy :user.property/claude-editedAt})
+
+(def ^:private user-a {:user-id "0b7c2f4e-1d3a-4c5b-8e6f-7a9b0c1d2e3f" :email "user-a@example.com" :username "user-a"})
+
+(def ^:private actor
+  (js/encodeURIComponent
+   (js/JSON.stringify #js {"sub" (:user-id user-a) "cognito:username" (:username user-a) "email" (:email user-a)})))
+
+(defn- memory-sql []
+  (let [db (new sqlite3 ":memory:" nil)]
+    #js {:transaction (fn [f] ((.transaction db f)))
+         :exec (fn [sql-str & args]
+                 (let [stmt (.prepare db sql-str)]
+                   (if (string/starts-with? (-> sql-str string/trim string/lower-case) "select")
+                     (.apply (.-all stmt) stmt (to-array args))
+                     (do (.apply (.-run stmt) stmt (to-array args)) nil))))}))
+
+(defn- request!
+  "One semantic API request through the real handler, as user A; returns {:status :body :text}.
+  `headers` adds headers (e.g. Claude's stamp); `e2ee?` marks the graph E2EE as the index does."
+  [self method path body & {:keys [headers e2ee? raw]}]
+  (p/let [url (str "http://localhost" path (if (string/includes? path "?") "&" "?") "graph-id=graph-1"
+                   (when e2ee? "&graph-e2ee=true"))
+          h (js/Headers. #js {"content-type" "application/json" "x-logseq-sync-actor" actor})
+          _ (doseq [[k v] headers] (.set h k v))
+          response (sync-handler/handle-http
+                    self
+                    (js/Request. url (clj->js (cond-> {:method method :headers h}
+                                                raw (assoc :body raw)
+                                                (and body (not raw)) (assoc :body (js/JSON.stringify (clj->js body)))))))
+          text (.text response)]
+    {:status (.-status response)
+     :text text
+     :body (when (seq text) (try (js->clj (js/JSON.parse text) :keywordize-keys true) (catch :default _ text)))}))
+
+(defn- ok! [response status]
+  (p/let [response response]
+    (assert (= status (:status response)) (pr-str response))
+    response))
+
+(defn- blank! [self body & opts]
+  (apply request! self "POST" "/semantic/blank-blocks/delete" body opts))
+
+(defn- dry-run! [self page-ids & opts]
+  (apply blank! self {:page-ids page-ids :dry-run true} opts))
+
+(defn- run [done f]
+  (-> (p/do (f))
+      (p/catch #(is false (str % (some-> % .-stack))))
+      (p/finally done)))
+
+;; ---------------------------------------------------------------------------------------------
+;; Graphs
+
+(defn- server-graph
+  "A graph created on the server itself (never uploaded), not yet opened."
+  []
+  (let [sql (memory-sql)
+        conn (storage/open-conn sql)]
+    (d/transact! conn (sqlite-create-graph/build-db-initial-data "{}"))
+    {:sql sql :self #js {:sql sql :conn nil :schema-ready false :env #js {"TIMEZONE" "UTC"}}}))
+
+(defn- upload-rows
+  "The kvs rows the app uploads for `client`, as <prepare-upload-temp-sqlite! makes them."
+  [client]
+  (let [sql (memory-sql)
+        _ (storage/init-schema! sql)
+        temp (d/conn-from-datoms [] (d/schema @client) {:storage (storage/new-sqlite-storage sql)})]
+    (d/transact! temp (mapv (fn [datom] [:db/add (:e datom) (:a datom) (:v datom)]) (d/datoms @client :eavt))
+                 {:initial-db? true})
+    (mapv (fn [row] [(aget row "addr") (aget row "content") (aget row "addresses")])
+          (.exec sql "select addr, content, addresses from kvs order by addr"))))
+
+(def ^:private app-page "App Notes")
+
+(defn- uploaded-graph
+  "A graph that arrived through the snapshot upload of an app graph, imported by the real handler.
+  Before the upload the app's own outliner made page App Notes with an empty leaf and an empty
+  parent holding a child, as pressing Enter in the app makes them. Returns the uuids it made."
+  []
+  (let [client (d/create-conn db-schema/schema)
+        _ (d/transact! client (sqlite-create-graph/build-db-initial-data "{}"))
+        [_ page-id] (outliner-page/create! client app-page {})
+        [leaf parent child] (repeatedly 3 random-uuid)
+        page (d/entity @client [:block/uuid page-id])
+        _ (outliner-core/insert-blocks! client [{:block/uuid leaf :block/title ""}
+                                                {:block/uuid parent :block/title ""}]
+                                        page {:sibling? false :keep-uuid? true :bottom? true})
+        _ (outliner-core/insert-blocks! client [{:block/uuid child :block/title "an app child"}]
+                                        (d/entity @client [:block/uuid parent]) {:sibling? false :keep-uuid? true})
+        sql (memory-sql)
+        self #js {:sql sql :conn nil :schema-ready false :env #js {"TIMEZONE" "UTC"}}]
+    (#'sync-handler/import-snapshot! self (upload-rows client) true)
+    {:sql sql :self self :app {:page (str page-id) :leaf (str leaf) :parent (str parent) :child (str child)}}))
+
+(defn- opened!
+  "Opens the graph through a read, as any request does, and returns its conn."
+  [self]
+  (p/let [_ (ok! (request! self "GET" "/semantic/pages" nil) 200)]
+    (.-conn self)))
+
+(defn- tx-log-count [sql]
+  (aget (first (.exec sql "select count(*) as n from tx_log")) "n"))
+
+(defn- written-state
+  "What a write would change: t, the tx_log rows and the graph's datoms."
+  [sql self]
+  [(storage/get-t sql) (tx-log-count sql) (count (d/datoms @(.-conn self) :eavt))])
+
+;; ---------------------------------------------------------------------------------------------
+;; Writes used to build fixtures
+
+(defn- page! [self title]
+  (p/let [r (ok! (request! self "POST" "/semantic/pages" {:title title}) 201)]
+    (get-in r [:body :uuid])))
+
+(defn- insert! [self target blocks & opts]
+  (p/let [r (ok! (apply request! self "POST" "/semantic/block-trees" {:target-id (str target) :blocks blocks} opts) 201)]
+    (get-in r [:body :blocks])))
+
+(defn- set-property! [self id ident value]
+  (ok! (request! self "PUT" (str "/semantic/blocks/" id "/properties/" (js/encodeURIComponent ident)) {:value value}) 200))
+
+(defn- outliner-insert!
+  "Blocks made by the real outliner on the server's conn, as an app's synced insert lands: this is
+  how a block with an empty title, a pre-block, a ((ref)) or an embed reaches the graph (the API
+  refuses an empty title and doesn't extract refs; the app's editor gives the outliner its refs).
+  replace-empty-target? is off: inserting several blocks after a blank last block would otherwise
+  put the first one in that block's place, as the app's paste does."
+  [self parent blocks]
+  (let [conn (.-conn self)]
+    (outliner-core/insert-blocks! conn blocks (d/entity @conn [:block/uuid (uuid (str parent))])
+                                  {:sibling? false :keep-uuid? true :bottom? true :replace-empty-target? false})))
+
+(defn- set-attr!
+  "Sets a datom directly on the opened graph (deleted-at, hide?, a tag no write route adds this way)."
+  [self id attr value]
+  (d/transact! (.-conn self) [[:db/add [:block/uuid (uuid (str id))] attr value]]))
+
+(defn- ids [n] (vec (repeatedly n #(str (random-uuid)))))
+
+;; Presence: a socket whose attachment round-trips as the runtime's does.
+(defn- socket []
+  (let [stored (atom nil)]
+    #js {:readyState 1
+         :serializeAttachment (fn [value] (reset! stored (js/structuredClone value)))
+         :deserializeAttachment (fn [] (some-> @stored js/structuredClone))}))
+
+(defn- editing!
+  "A connected client of user A reporting `block` (a uuid string) as the block being edited."
+  [self block]
+  (let [s (socket)]
+    (presence/add-presence! self s user-a)
+    (presence/update-presence! self s {:editing-block-uuid block})
+    s))
+
+(defn- attributes [db id]
+  (set (map :a (d/datoms db :eavt (:db/id (d/entity db [:block/uuid (uuid (str id))]))))))
+
+(defn- referrers [db id]
+  (let [eid (:db/id (d/entity db [:block/uuid (uuid (str id))]))]
+    (set (concat (map :e (d/datoms db :avet :block/refs eid)) (map :e (d/datoms db :avet :block/link eid))))))
+
+;; ---------------------------------------------------------------------------------------------
+;; The allow-list pin (spec section 7, risk 2): every way a plain blank block is made
+
+(deftest plain-block-attributes-test
+  ;; Before patch 0056 there is no such route: the dry runs answer 404.
+  (async done
+    (run done
+      (fn []
+        (p/let [{:keys [self]} (server-graph)
+                page (page! self "Example")
+                [by-api stamped by-outliner] (ids 3)
+                _ (insert! self page [{:uuid by-api :title " "}])
+                _ (insert! self page [{:uuid stamped :title " "}] :headers [["x-logseq-edit-stamp" "claude"]])
+                _ (outliner-insert! self page [{:block/uuid (uuid by-outliner) :block/title ""}])
+                server-db @(.-conn self)
+                server (dry-run! self [page])
+                {uploaded :self app :app} (uploaded-graph)
+                conn (opened! uploaded)
+                upload (dry-run! uploaded [app-page])]
+          (doseq [[label db id] [["made through the API" server-db by-api]
+                                 ["made through the API with Claude's stamp" server-db stamped]
+                                 ["made by the outliner on the server" server-db by-outliner]
+                                 ["made by the app and uploaded" @conn (:leaf app)]]]
+            (testing label
+              (is (seq (attributes db id)))
+              (is (empty? (set/difference (attributes db id) plain-block-attributes))
+                  (str "attributes outside the allow-list: " (pr-str (set/difference (attributes db id) plain-block-attributes))))))
+          (is (contains? (attributes server-db stamped) :user.property/claude-editedBy) "the stamp is on the block")
+          (is (= 200 (:status server)) (pr-str server))
+          (is (= #{by-api stamped by-outliner} (set (map :uuid (get-in server [:body :pages 0 :would-delete])))))
+          (is (= 200 (:status upload)) (pr-str upload))
+          (is (= [(:leaf app)] (map :uuid (get-in upload [:body :pages 0 :would-delete])))))))))
+
+;; ---------------------------------------------------------------------------------------------
+;; The predicate, on one fixture page
+
+(defn- predicate-fixture!
+  "Builds page Example on an opened graph: each case of the spec's decision table. Returns the uuids
+  by role: :delete (would-delete), :has-children, :referenced, :being-edited, :private (counted in
+  skipped-private) and :silent (blank-looking blocks that appear nowhere in the answer)."
+  [self]
+  (p/let [_ (ok! (request! self "POST" "/semantic/tags" {:title "Private"}) 201)
+          rating (ok! (request! self "POST" "/semantic/properties" {:title "Rating" :type "default"}) 201)
+          related (ok! (request! self "POST" "/semantic/properties" {:title "Related" :type "node"}) 201)
+          rating-ident (get-in rating [:body :ident])
+          related-ident (get-in related [:body :ident])
+          page (page! self "Example")
+          [ws nbsp tab zwsp parent child task rated heading code math quote refd embedded linked holder
+           private-block under-private recycled recycled-parent under-recycled edited valued stamped
+           nested-parent nested untitled]
+          (ids 27)
+          _ (insert! self page
+                     [{:uuid ws :title "   "}
+                      {:uuid nbsp :title " "}
+                      {:uuid tab :title "\t"}
+                      {:uuid zwsp :title "​"}
+                      {:uuid parent :title " " :children [{:uuid child :title "a child"}]}
+                      {:uuid task :title " "}
+                      {:uuid rated :title " "}
+                      {:uuid heading :title " "}
+                      {:uuid code :title " " :display-type "code"}
+                      {:uuid math :title " " :display-type "math"}
+                      {:uuid quote :title " " :display-type "quote"}
+                      {:uuid refd :title " "}
+                      {:uuid embedded :title " "}
+                      {:uuid linked :title " "}
+                      {:uuid holder :title "holds a related block"}
+                      {:uuid private-block :title "a private block" :children [{:uuid under-private :title " "}]}
+                      {:uuid recycled :title " "}
+                      {:uuid recycled-parent :title "a recycled block" :children [{:uuid under-recycled :title " "}]}
+                      {:uuid edited :title " "}
+                      {:uuid valued :title "a valued block"}
+                      {:uuid nested-parent :title "a parent block" :children [{:uuid nested :title " "}]}])
+          _ (insert! self page [{:uuid stamped :title " "}] :headers [["x-logseq-edit-stamp" "claude"]])
+          [empty-leaf pre ref-block embed-block] (map uuid (ids 4))
+          _ (outliner-insert! self page [{:block/uuid empty-leaf :block/title ""}
+                                         {:block/uuid pre :block/title "" :block/pre-block? true}
+                                         {:block/uuid ref-block :block/title (str "see ((" refd "))")
+                                          :block/refs [[:block/uuid (uuid refd)]]}
+                                         {:block/uuid embed-block :block/title ""
+                                          :block/link [:block/uuid (uuid embedded)]}])
+          _ (set-property! self task "block/tags" ["Task"])
+          _ (set-property! self private-block "block/tags" ["Private"])
+          _ (set-property! self rated rating-ident "four stars")
+          _ (set-property! self heading "logseq.property/heading" 2)
+          _ (set-property! self holder related-ident linked)
+          _ (set-property! self valued rating-ident "a value")
+          conn (.-conn self)
+          value-block (:v (first (d/datoms @conn :eavt (:db/id (d/entity @conn [:block/uuid (uuid valued)]))
+                                           (keyword rating-ident))))
+          value-uuid (str (:block/uuid (d/entity @conn value-block)))
+          ;; A blank value block: no write route blanks one, so its title is cleared directly.
+          _ (set-attr! self value-uuid :block/title "")
+          ;; A blank choice on the page: made directly, as a closed value is never made by the API here.
+          choice (str (random-uuid))
+          page-eid (:db/id (d/entity @conn [:block/uuid (uuid page)]))
+          _ (d/transact! conn [{:block/uuid (uuid choice) :block/title "" :block/parent page-eid :block/page page-eid
+                                :block/order (db-order/gen-key) :block/created-at 1 :block/updated-at 1
+                                :block/closed-value-property [:db/ident (keyword rating-ident)]}])
+          ;; A block with no title datom at all (made directly: every write route gives one).
+          _ (d/transact! conn [{:block/uuid (uuid untitled) :block/parent page-eid :block/page page-eid
+                                :block/order (db-order/gen-key) :block/created-at 1 :block/updated-at 1}])
+          _ (set-attr! self recycled :logseq.property/deleted-at 1)
+          _ (set-attr! self recycled-parent :logseq.property/deleted-at 1)
+          _ (editing! self edited)]
+    (let [db @conn]
+      ;; The fixture is what it says: each referrer is in place, each typed block is typed.
+      (assert (seq (referrers db refd)) "the ((ref)) is a :block/refs datom")
+      (assert (seq (referrers db embedded)) "the embed is a :block/link datom")
+      (assert (contains? (attributes db code) :logseq.property.node/display-type))
+      (assert (contains? (attributes db pre) :block/pre-block?))
+      (assert (contains? (attributes db value-uuid) :logseq.property/created-from-property))
+      (assert (= "" (:block/title (d/entity db [:block/uuid (uuid value-uuid)])))))
+    {:page page
+     :delete #{ws nbsp tab stamped (str empty-leaf) nested untitled}
+     :parents {nested nested-parent}
+     :has-children #{parent}
+     :referenced #{refd embedded linked}
+     :being-edited #{edited}
+     :private #{under-private}
+     :silent #{zwsp task rated heading code math quote (str pre) (str embed-block) value-uuid choice
+               recycled under-recycled}
+     :untouched #{child}}))
+
+(defn- check-predicate! [response {:keys [page delete parents has-children referenced being-edited private silent untouched]}]
+  (let [answer (:body response)
+        [entry] (:pages answer)
+        examples (get-in entry [:kept :examples])]
+    (is (= 200 (:status response)) (pr-str response))
+    (is (= page (:uuid entry)))
+    (is (= "Example" (:page entry)))
+    (testing "would-delete: empty, untitled, whitespace (spaces, U+00A0 no-break space, U+0009 tab), nested and Claude-stamped leaves"
+      (is (= delete (set (map :uuid (:would-delete entry)))))
+      (is (= (into {} (map (fn [id] [id (get parents id page)])) delete)
+             (into {} (map (juxt :uuid :parent)) (:would-delete entry)))
+          "each names its parent: the page, or the block it is under"))
+    (testing "kept and listed: a blank parent, referenced blanks (a ((ref)), an embed, a node property value) and the block being edited"
+      (is (= {:has-children 1 :referenced 3 :in-template 0 :being-edited 1} (dissoc (:kept entry) :examples)))
+      (is (= (set (concat (map #(hash-map :uuid % :reason "has children") has-children)
+                          (map #(hash-map :uuid % :reason "referenced") referenced)
+                          (map #(hash-map :uuid % :reason "being edited") being-edited)))
+             (set examples))))
+    (testing "a blank leaf under a Private block is counted, never named"
+      (is (= (count private) (:skipped-private entry))))
+    (testing "silent keeps (U+200B zero-width space, an empty Task, a block with a property, a heading, Code, Math, Quote, a value block, a choice, a pre-block, an embed holder, recycled blocks) appear nowhere"
+      (doseq [id (concat private silent untouched)]
+        (is (not (string/includes? (:text response) id)) (str id " is in the answer"))))
+    (is (= (count delete) (:total answer)))
+    (is (= (count delete) (:listed answer)))))
+
