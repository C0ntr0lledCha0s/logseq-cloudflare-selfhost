+                _ (ok! (request! self "PATCH" (str "/semantic/blocks/" (:e5 ids)) {:title "three, edited"}) 200)
+                _ (ok! (request! self "PATCH" (str "/semantic/blocks/" (:e6 ids)) {:title "a child, edited"}) 200)
+                response (blank! self {:page-ids [example projects] :dry-run false
+                                       :block-ids (mapv string/upper-case listed)})]
+          (is (= 200 (:status response)) (pr-str response))
+          (is (= [3 0] (map :deleted (get-in response [:body :pages]))))
