+        (p/let [{:keys [self]} (server-graph)
+                _ (ok! (request! self "POST" "/semantic/tags" {:title "Topic"}) 201)
+                _ (ok! (request! self "POST" "/semantic/tags" {:title "Private"}) 201)
+                rating (ok! (request! self "POST" "/semantic/properties" {:title "Rating" :type "default"}) 201)
+                tagged (page! self "Tagged Page")
+                holding (page! self "Holding Page")
+                dated (page! self "2001-02-03")
