+(deftest apply-replays-on-a-client-copy-test
+  ;; Spec section 7, risk 1: non-adjacent blank leaves on two pages, given in an order unlike the dry
+  ;; run's and with the pages named the other way round, reach the sync log as one transaction with
+  ;; one tx id, and a client replaying the log ends with the server's outline on both pages.
+  ;; Before patch 0056's apply: 501 "apply is not built yet", and no tx_log row.
+  (async done
+    (run done
+      (fn []
+        (p/let [{:keys [self sql]} (server-graph)
+                {:keys [example projects ids]} (two-pages! self (ids 12))
+                {:keys [e2 e4 e7 p2 p4]} ids
+                listed (listed-ids self [example projects])
+                conn (.-conn self)
+                client (d/conn-from-db @conn)
+                t0 (storage/get-t sql)
+                reports (atom [])
+                _ (d/listen! conn ::reports #(swap! reports conj %))
+                response (apply! self [projects example] [p4 e7 e2 p2 e4])
+                _ (d/unlisten! conn ::reports)
+                rows (storage/fetch-tx-since sql t0)
+                _ (doseq [{:keys [tx]} rows] (d/transact! client (common/read-transit tx)))]
+          (is (= [e2 e4 e7 p2 p4] listed) "the dry run lists the five blanks, page by page in outline order")
+          (is (= 200 (:status response)) (pr-str response))
+          (is (= 5 (get-in response [:body :deleted])))
+          (testing "one transaction, one tx id, logged as delete-blocks"
+            (is (= 1 (count rows)) (pr-str (map :outliner-op rows)))
+            (is (= :delete-blocks (:outliner-op (first rows))))
+            (is (= 1 (count @reports)) "one transaction on the graph")
+            (is (= 1 (count (distinct (map :tx (:tx-data (first @reports)))))) "its datoms carry one tx id"))
+          (testing "the server's outline, and the client's replay of the log, on both pages"
+            (is (= (expected-outlines ids) [(outline @conn example) (outline @conn projects)]))
+            (is (= (expected-outlines ids) [(outline @client example) (outline @client projects)]))
+            (is (not-any? #(live? @client %) [e2 e4 e7 p2 p4]) "the blanks are gone on the client too")))))))
+
+(deftest apply-order-permutations-test
+  ;; The same five blanks in the dry run's order, reversed, with two swapped, interleaved across the
+  ;; pages, and with the pages named the other way round: each deletes exactly those blocks in one
+  ;; tx_log row and leaves the same outline.
+  (async done
+    (let [uuids (ids 12)
+          {:keys [e2 e4 e7 p2 p4]} (zipmap [:e1 :e2 :e3 :e4 :e5 :e6 :e7 :e8 :p1 :p2 :p3 :p4] uuids)
+          orders [["the dry run's order" [:example :projects] [e2 e4 e7 p2 p4]]
+                  ["reversed" [:example :projects] [p4 p2 e7 e4 e2]]
+                  ["the first two swapped" [:example :projects] [e4 e2 e7 p2 p4]]
+                  ["interleaved, pages the other way round" [:projects :example] [p2 e2 p4 e4 e7]]]]
+      (run done
+        (fn []
+          (p/doseq [[label page-order block-ids] orders]
+            (p/let [{:keys [self sql]} (server-graph)
+                    {:keys [ids] :as pages} (two-pages! self uuids)
+                    t0 (storage/get-t sql)
+                    response (apply! self (mapv pages page-order) block-ids)
+                    conn (.-conn self)]
+              (testing label
+                (is (= 200 (:status response)) (pr-str response))
+                (is (= 5 (get-in response [:body :deleted])))
+                (is (= (mapv #(get {:example "Example" :projects "Projects"} %) page-order)
+                       (map :page (get-in response [:body :pages])))
+                    "pages answer in request order")
+                (is (= 1 (count (storage/fetch-tx-since sql t0))))
+                (is (= (expected-outlines ids) [(outline @conn (:example pages)) (outline @conn (:projects pages))]))))))))))
