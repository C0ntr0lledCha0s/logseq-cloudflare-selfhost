+;; deleteBlankBlocks (patch 0056) deletes the plain blank leaves on up to 20 named pages: a dry run
+;; lists them, and an apply takes exactly the block-ids a dry run listed. Every page must resolve to
+;; one visible, plain, non-Private page, or the whole call is refused naming page-ids[i], before any
+;; block is read. E2EE graphs are refused: a blank title can't be told from ciphertext there.
+
+(def ^:private max-blank-pages 20)
+(def ^:private max-blank-deletes 100)
+(def ^:private max-blank-scan 10000)
+(def ^:private max-kept-examples 20)
+
+(def ^:private blank-attribute-allow-list
+  "Every attribute a plain blank block may hold: the outliner's bookkeeping, its creator and Claude's
+  two stamps (patch 0034), as blocks made through the API, by the outliner and by the app (then
+  uploaded) hold them. Anything else keeps the block: tags (an empty Task), a property, a display
+  type, a heading, a value block's or choice's owner, pre-block?, a page's name. So does anything
+  new, which is safe but keeps every block holding it; the allow-list test pins the set."
+  #{:block/uuid :block/parent :block/page :block/order :block/title :block/created-at :block/updated-at
+    :block/tx-id :logseq.property/created-by-ref :user.property/claude-editedBy :user.property/claude-editedAt})
+
+(def ^:private blank-body-fields #{:page-ids :dry-run :block-ids})
+
+(def ^:private kept-reasons
+  "The reasons a blank block is kept that the caller can act on, as the dry run names them."
+  {:has-children "has children" :referenced "referenced" :in-template "in a template" :being-edited "being edited"})
+
+(defn- blank-body-error
+  "The first problem with deleteBlankBlocks' body, naming the field, or nil."
+  [body]
+  (let [page-ids (:page-ids body)
+        block-ids (:block-ids body)
+        unknown (when (map? body) (remove blank-body-fields (keys body)))]
+    (cond
+      (not (map? body)) "body: give an object with page-ids"
+      (seq unknown) (string/join "; " (map #(str (subs (str %) 1) ": not a field; the body takes page-ids, dry-run and block-ids")
+                                           unknown))
+      (not (sequential? page-ids)) "page-ids: must be an array of page UUIDs, titles or YYYY-MM-DD dates"
+      (not (<= 1 (count page-ids) max-blank-pages)) (str "page-ids: 1 to " max-blank-pages " pages")
+      :else
+      (or (some (fn [[i selector]]
+                  (when-not (non-blank-string? selector)
+                    (str "page-ids[" i "]: must be a page UUID, title or YYYY-MM-DD date")))
+                (map-indexed vector page-ids))
+          (let [dry-run? (dry-run-option body)]
+            (cond
+              (= ::invalid dry-run?) "dry-run: must be true or false"
+              (and dry-run? (some? block-ids)) "block-ids: a dry run takes no block-ids; it lists them"
+              dry-run? nil
+              (nil? block-ids) "block-ids is required unless dry-run is true"
+              (not (and (sequential? block-ids) (<= 1 (count block-ids) max-blank-deletes)))
+              (str "block-ids: 1 to " max-blank-deletes " block UUIDs")))))))
+
+(defn- whiteboard? [entity]
+  (some #{:logseq.class/Whiteboard} (map :db/ident (:block/tags entity))))
+
+(defn- blank-page-refusal
+  "Why the visible entity a page selector found can't have its blank blocks judged, or nil."
+  [entity private]
+  (cond
+    (whiteboard? entity) "is a whiteboard"
+    (tag? entity) "is a tag"
+    (property? entity) "is a property"
+    (not (page? entity)) "is not a page"
+    (contains? private (:db/id entity)) "is Private"))
+
+(defn- resolve-blank-pages
+  "The pages `selectors` name, in order, as {:pages [entity]}, or the first refusal as
+  {:status :error}, naming page-ids[i] (with :candidates for an ambiguous title). A hidden or
+  recycled page reads as not found. `private` is datalog/private-ids."
+  [db e2ee? private selectors]
+  (if e2ee?
+    {:status 409 :error "blank blocks can't be judged on E2EE graphs: titles are ciphertext"}
+    (reduce (fn [{:keys [pages seen] :as acc} [i selector]]
+              (let [field (str "page-ids[" i "]")
+                    {:keys [ok status error candidates]} (resolve-page-selector db selector field {:find find-visible-entity})
+                    refusal (when ok (blank-page-refusal ok private))]
+                (cond
+                  (= 409 status) (reduced {:status 409 :candidates candidates
+                                           :error (str field ": ambiguous title; " (subs error (+ 2 (count field))))})
+                  (or error (nil? ok)) (reduced {:status 404 :error (str field ": page not found (" (pr-str selector) ")")})
+                  refusal (reduced {:status 400 :error (str field ": " refusal)})
+                  (contains? seen (:db/id ok)) (reduced {:status 400
+                                                         :error (str field ": same page as page-ids[" (get seen (:db/id ok)) "]")})
+                  :else (assoc acc :pages (conj pages ok) :seen (assoc seen (:db/id ok) i)))))
+            {:pages [] :seen {}}
+            (map-indexed vector selectors))))
+
+(defn- blank-scan-refusal
+  "A 422 naming page-ids[i] when page i holds more than max-outline-blocks blocks, or the pages up to
+  it more than max-blank-scan, counted from :block/page datoms before any block is judged; else nil."
+  [db pages]
+  (let [result (reduce (fn [total [i page]]
+                         (let [n (count (d/datoms db :avet :block/page (:db/id page)))
+                               total (+ total n)]
+                           (cond
+                             (> n max-outline-blocks)
+                             (reduced {:status 422 :error (str "page-ids[" i "]: over " max-outline-blocks " blocks")})
+                             (> total max-blank-scan)
+                             (reduced {:status 422 :error (str "page-ids[" i "]: the call is over " max-blank-scan " blocks")})
+                             :else total)))
+                       0
+                       (map-indexed vector pages))]
+    (when (map? result) result)))
+
+(def ^:private internal-block-reference-properties
+  "Logseq's own properties that can point at a content block and that reference-attributes leaves
+  out (it drops internal properties): a range comment's :logseq.property.comments/blocks, a
+  reaction's :logseq.property.reaction/target, a view's :logseq.property/view-for and a property
+  history entry's :logseq.property.history/block. A blank block one of them targets isn't free to
+  delete: outliner delete-blocks! deletes a Comments area whose targets all go, with the comments
+  under it. The other internal ref properties point at pages, properties, classes, users or the
+  Recycle bin's bookkeeping (:block/parent, :block/page, created-by-ref, deleted-by-ref), never at a
+  blank leaf another block depends on, and reading them cost every call a pass over the graph."
+  [:logseq.property.comments/blocks :logseq.property.reaction/target :logseq.property/view-for
+   :logseq.property.history/block])
+
+(defn- blank-reference-attributes
+  "The attributes blank-candidate reads a leaf's referrers from, once a call: reference-attributes
+  without :block/parent and :block/page (blank-candidate judges a child by its own clause first, and
+  only a page is ever a block's page), plus the internal-block-reference-properties the graph's
+  schema holds as refs (an older graph may lack one, and Datascript refuses an :avet read of an
+  attribute it doesn't index)."
+  [db]
+  (into []
+        (comp (remove #{:block/parent :block/page}) (distinct))
+        (concat (reference-attributes db)
+                (filter #(= :db.type/ref (get-in (:schema db) [% :db/valueType]))
+                        internal-block-reference-properties))))
+
+(defn- referenced?
+  "Whether any entity holds `id` in one of `attributes`, read from raw :avet datoms:
+  a referrer counts wherever it is, hidden, Private or in the Recycle bin (restoring a recycled page
+  brings its links back). One index read per attribute for each blank leaf, so the cost follows the
+  candidates, not the graph. A plain blank leaf holds none of these attributes itself (it would not
+  be plain), so a datom found is another entity's."
+  [db id attributes]
+  (some #(seq (d/datoms db :avet % id)) attributes))
+
+(defn- template-root-ids
+  "The entities tagged Template or a tag that extends it (a template's root block, or a page tagged
+  Template): the blank bullets under one are the template's slots, filled in each time it is used."
+  [db]
+  (if-let [template (d/entid db :logseq.class/Template)]
+    (into #{}
+          (comp (mapcat #(d/datoms db :avet :block/tags %)) (map :e))
+          (cons template (db-class/get-structured-children db template)))
+    #{}))
+
+(defn- in-template?
+  "Whether an ancestor of `id` (up to and including its page) is one of `roots` (template-root-ids)."
+  [db id roots]
+  (when (seq roots)
+    (loop [parent (:v (first (d/datoms db :eavt id :block/parent)))]
+      (cond
+        (nil? parent) false
+        (contains? roots parent) true
+        :else (recur (:v (first (d/datoms db :eavt parent :block/parent))))))))
+
+(defn- blank-title? [title]
+  (or (nil? title) (and (string? title) (string/blank? title))))
+
+(defn- blank-candidate
+  "nil when `entity` is a plain blank leaf that may be deleted; else why it is kept: :has-text,
+  :not-plain (an attribute outside blank-attribute-allow-list, which a page, tag, property, asset,
+  tagged block, typed block, value block or choice always holds), :hidden (under a recycled
+  block), :private, :has-children, :referenced, :in-template (a slot under a block or page tagged
+  Template, or a tag extending it) or :being-edited. private-ids holds everything in
+  or under the Recycle bin, so entity-util/hidden? (a walk up the parents, about 0.1 ms a block)
+  runs only for the blocks in it, to tell recycled from Private; hide? marks pages and properties,
+  and a hidden page is refused before any block is judged. A title of
+  whitespace (string/blank?: spaces, tabs, U+00A0) is blank; a zero-width space is not. Attributes
+  are read from :eavt datoms, so an uploaded graph's stored cardinality can't change the answer.
+  `context` holds what a call reads once: :private (datalog/private-ids), :editing
+  (presence/editing-block-uuids), :attributes (blank-reference-attributes: a block a comment thread,
+  reaction, view or history entry targets is referenced too) and :templates (template-root-ids)."
+  [db entity {:keys [private editing attributes templates]}]
+  (let [id (:db/id entity)]
+    (cond
+      (not (blank-title? (:v (first (d/datoms db :eavt id :block/title))))) :has-text
+      (some #(not (contains? blank-attribute-allow-list (:a %))) (d/datoms db :eavt id)) :not-plain
+      (contains? private id) (if (entity-util/hidden? entity) :hidden :private)
+      (seq (d/datoms db :avet :block/parent id)) :has-children
+      (referenced? db id attributes) :referenced
+      (in-template? db id templates) :in-template
+      (contains? editing (:block/uuid entity)) :being-edited)))
+
+(defn- blank-note [total listed]
+  (cond
+    (zero? total) "no blank blocks to delete on these pages"
+    (> total listed) (str "pass these block-ids with dry-run false to delete them; " (- total listed) " more "
+                          (if (= 1 (- total listed)) "wasn't" "weren't") " listed: run the dry run again after the apply")
+    :else "pass these block-ids with dry-run false to delete them"))
+
+(defn- blank-dry-run
+  "The dry run's answer: for each page in request order, the blank leaves it would delete (at most
+  max-blank-deletes across the call), the blank blocks kept for a reason the caller can act on
+  (counted, with the first max-kept-examples), and the blank leaves under Private content (counted
+  only). Every other blank-looking block is left out."
+  [db t pages context]
+  (let [total (volatile! 0)
+        listed (volatile! 0)
+        entries (mapv (fn [page]
+                        (let [kept (volatile! {:has-children 0 :referenced 0 :in-template 0 :being-edited 0})
+                              examples (volatile! [])
+                              would-delete (volatile! [])
+                              private (volatile! 0)]
+                          (doseq [datom (d/datoms db :avet :block/page (:db/id page))
+                                  :let [block (d/entity db (:e datom))
+                                        reason (blank-candidate db block context)]]
+                            (cond
+                              (nil? reason)
+                              (do (vswap! total inc)
+                                  (when (< @listed max-blank-deletes)
+                                    (vswap! listed inc)
+                                    (vswap! would-delete conj {:uuid (uuid-string (:block/uuid block))
+                                                               :parent (uuid-string (:block/uuid (:block/parent block)))})))
+                              (contains? kept-reasons reason)
+                              (do (vswap! kept update reason inc)
+                                  (when (< (count @examples) max-kept-examples)
+                                    (vswap! examples conj {:uuid (uuid-string (:block/uuid block)) :reason (kept-reasons reason)})))
+                              (= :private reason) (vswap! private inc)))
+                          {:page (:block/title page)
+                           :uuid (uuid-string (:block/uuid page))
+                           :would-delete @would-delete
+                           :kept (assoc @kept :examples @examples)
+                           :skipped-private @private}))
+                      pages)]
+    {:dry-run true :t t :total @total :listed @listed :pages entries :note (blank-note @total @listed)}))
+
+(defn- blank-ids-refusal
+  "The first block-ids entry that can't name a block in `db`, as {:status :error} naming
+  block-ids[i]: not a UUID or a duplicate (400, ignoring case), or no visible block (404); else nil.
+  The apply re-reads each inside its transaction: this only answers a malformed list up front."
+  [db block-ids]
+  (let [result (reduce (fn [seen [i id]]
+                         (let [field (str "block-ids[" i "]")
+                               id (when (and (string? id) (parse-uuid id)) (string/lower-case id))]
+                           (cond
+                             (nil? id) (reduced {:status 400 :error (str field ": not a UUID")})
+                             (contains? seen id) (reduced {:status 400 :error (str field ": duplicate of block-ids[" (get seen id) "]")})
+                             (nil? (find-visible-entity db id)) (reduced {:status 404 :error (str field ": block not found")})
+                             :else (assoc seen id i))))
+                       {}
+                       (map-indexed vector block-ids))]
+    (when (:error result) result)))
+
+(def ^:private apply-refusal-reasons
+  "Why an apply refuses a block-ids entry, by blank-candidate's reason or the apply's own checks."
+  {:missing "block not found" :hidden "block not found" :not-plain "not a plain block"
+   :off-page "not on a listed page" :has-text "no longer blank (it has text)" :private "is Private"
+   :has-children "has children" :referenced "referenced" :in-template "in a template"
+   :being-edited "being edited in the app"})
+
+(defn- apply-refusal
+  "Why block-ids[i] (`id`) can't be deleted now, judged on `db` (the transaction's), as
+  {:status :error}, or nil. Its :block/page is read from datoms, as blank-candidate reads, and must
+  be one of `page-eids`."
+  [db page-eids context i id]
+  (let [block (d/entity db [:block/uuid (uuid id)])
+        reason (cond
+                 (nil? (:db/id block)) :missing
+                 (not= "block" (block-kind block)) :not-plain
+                 (not (contains? page-eids (:v (first (d/datoms db :eavt (:db/id block) :block/page))))) :off-page
+                 :else (blank-candidate db block context))]
+    (when reason
+      {:status (if (#{:missing :hidden} reason) 404 409)
+       :error (str "block-ids[" i "]: " (apply-refusal-reasons reason))})))
+
+(defn- remaining-blocks
+  "The blocks `page` still holds that aren't in the Recycle bin."
+  [db page]
+  (count (remove #(some? (:v (first (d/datoms db :eavt (:e %) :logseq.property/deleted-at))))
+                 (d/datoms db :avet :block/page (:db/id page)))))
+
+(defn- apply-blank-deletes!
+  "Deletes the blocks `ids` name (lower-case UUIDs, each found) on `pages`, and answers how many went
+  from each page and what each still holds. Inside one transaction each block is re-read and
+  re-judged on the transaction's db, so text typed, a child added, a move or a reference made since
+  the dry run (or since this request read the graph) refuses the whole call naming block-ids[i]
+  (check-labels!'s refusal shape, which `rejecting` answers); then one delete-blocks! call deletes
+  them all (one tx id, :delete-blocks), and confirm-removed! reads back that they are gone."
+  [^js self conn creator pages ids]
+  (let [page-eids (set (map :db/id pages))
+        deleted (atomic-write! conn creator false :delete-blocks
+                               (fn [tx-conn]
+                                 (let [db @tx-conn
+                                       context {:private (datalog/private-ids db)
+                                                :editing (presence/editing-block-uuids self)
+                                                :attributes (blank-reference-attributes db)
+                                                :templates (template-root-ids db)}
+                                       blocks (mapv #(d/entity db [:block/uuid (uuid %)]) ids)]
+                                   (when-let [refusal (some (fn [[i id]] (apply-refusal db page-eids context i id))
+                                                            (map-indexed vector ids))]
+                                     (throw (ex-info (:error refusal) {::label-refusal refusal})))
+                                   (outliner-core/delete-blocks! tx-conn blocks {})
+                                   (frequencies (map #(:v (first (d/datoms db :eavt (:db/id %) :block/page))) blocks)))))]
+    (broadcast-change! self)
+    (confirm-removed! @conn (map uuid ids))
+    (let [db @conn]
+      {:deleted (count ids)
+       :t (storage/get-t (.-sql self))
+       :pages (mapv (fn [page] {:page (:block/title page)
+                                :uuid (uuid-string (:block/uuid page))
+                                :deleted (get deleted (:db/id page) 0)
+                                :remaining-blocks (remaining-blocks db page)})
+                    pages)})))
+
+(defn- delete-blank-blocks [^js self request conn db e2ee? creator]
+  (p/let [body (body-clj request)]
+    (if-let [error (blank-body-error body)]
+      (http/bad-request error)
+      (let [private (when-not e2ee? (datalog/private-ids db))
+            resolved (resolve-blank-pages db e2ee? private (:page-ids body))
+            refusal (or (when (:error resolved) resolved)
+                        (blank-scan-refusal db (:pages resolved))
+                        (when-not (true? (:dry-run body))
+                          (blank-ids-refusal db (:block-ids body))))]
+        (cond
+          refusal (selector-refusal refusal)
+          (true? (:dry-run body))
+          (http/json-response nil (blank-dry-run db (storage/get-t (.-sql self)) (:pages resolved)
+                                                 {:private private
+                                                  :editing (presence/editing-block-uuids self)
+                                                  :attributes (blank-reference-attributes db)
+                                                  :templates (template-root-ids db)}))
+          :else
+          (rejecting
+           #(http/json-response nil (apply-blank-deletes! self conn creator (:pages resolved)
+                                                          (mapv string/lower-case (:block-ids body))))))))))
+
