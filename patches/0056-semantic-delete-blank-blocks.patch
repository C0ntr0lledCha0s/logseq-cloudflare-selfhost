+                _ (set-property! self holding (get-in rating [:body :ident]) "five")
+                _ (set-property! self (get-in (first leaves) [1 :uuid]) "block/tags" ["Private"])
+                cases [["a page tagged with a user tag, by title in another case" ["tagged page"] tagged]
+                       ["a page holding a property value, by uuid" [holding] holding]
+                       ["a page titled like a date that no journal has" ["2001-02-03"] dated]]
+                responses (p/all (map (fn [[_ selectors]] (dry-run! self selectors)) cases))
+                together (dry-run! self ["Tagged Page" holding "2001-02-03"])
+                not-e2ee (request! self "POST" "/semantic/blank-blocks/delete?graph-e2ee=false"
+                                   {:page-ids [tagged] :dry-run true})]
+          (doseq [[[label _ page] response] (map vector cases responses)]
+            (testing label
+              (is (= 200 (:status response)) (pr-str response))
+              (is (= page (get-in response [:body :pages 0 :uuid])))
