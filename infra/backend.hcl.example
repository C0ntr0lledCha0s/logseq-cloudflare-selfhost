# Copy to backend.hcl (git-ignored) and replace the placeholder.
bucket = "logseq-selfhost-tofu-state"
key    = "logseq-sync/terraform.tfstate"

endpoints = {
  s3 = "https://<ACCOUNT_ID>.r2.cloudflarestorage.com"
}

region = "auto"

skip_credentials_validation = true
skip_region_validation      = true
skip_requesting_account_id  = true
skip_metadata_api_check     = true
skip_s3_checksum            = true

use_path_style = true

# use_lockfile is decided by spike item S4 (R2 conditional-write support).
# use_lockfile = true
