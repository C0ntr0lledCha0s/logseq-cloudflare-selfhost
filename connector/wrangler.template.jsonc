// Account- and host-specific values (name, routes, KV/D1/service bindings) are added by
// scripts/render-connector-wrangler.mjs; do not put them here.
{
  "main": "src/index.ts",
  "compatibility_date": "2026-07-11",
  // global_fetch_strictly_public is required for CIMD client metadata fetches.
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "observability": { "enabled": true },
  // Rebuilds every graph's kb_index cache (KB_INDEX_KV) hourly; src/tools/kb-index.ts treats a
  // cache older than two periods as stale.
  "triggers": { "crons": ["0 * * * *"] }
}
