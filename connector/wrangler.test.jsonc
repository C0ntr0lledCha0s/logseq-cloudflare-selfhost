// Test-only config for the workers pool: dummy bindings, no real ids. The deploy config is
// rendered from wrangler.template.jsonc by scripts/render-connector-wrangler.mjs.
{
  "name": "logseq-connector-test",
  "main": "src/index.ts",
  "compatibility_date": "2026-07-11",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "kv_namespaces": [
    { "binding": "OAUTH_KV", "id": "00000000000000000000000000000000" },
    { "binding": "KB_INDEX_KV", "id": "11111111111111111111111111111111" }
  ],
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "logseq-connector-test",
      "database_id": "00000000-0000-0000-0000-000000000000",
      "migrations_dir": "migrations"
    }
  ],
  // Tests replace SYNC per call (see test/wizard.test.ts); vitest.config.ts backs it with a stub
  // that fails loudly, so nothing reaches a real logseq-sync Worker.
  "services": [{ "binding": "SYNC", "service": "logseq-sync" }],
  // Dummy values only. In production these are Worker secrets.
  "vars": {
    "GITHUB_CLIENT_ID": "test-github-client-id",
    "GITHUB_CLIENT_SECRET": "test-github-client-secret",
    "OWNER_GITHUB_USER_ID": "1001",
    "COOKIE_ENCRYPTION_KEY": "000102030405060708090a0b0c0d0e0f101112131415161718191a1b1c1d1e1f",
    "GRAPH_TOKEN_KEY": "1f1e1d1c1b1a191817161514131211100f0e0d0c0b0a09080706050403020100",
    "CONNECTOR_HOSTNAME": "mcp.example.com"
  }
}
