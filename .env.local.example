# Local secrets for running the deploy from your machine.
# Copy to .env.local (gitignored) and fill in the first two values:
#   cp .env.local.example .env.local && chmod 600 .env.local
# Never commit .env.local. GitHub Actions reads the same names from the
# `production` environment secrets instead.

# Cloudflare API token, with two policies (README 1.1). Account policy:
# Workers Admin; D1 Write + Read; Workers R2 Storage Write + Read; Workers KV
# Storage Write + Read (only used by the optional connector). Zone policy
# on your zone: Workers Routes Write + Read; DNS Write + Read. It is the only
# credential: the R2 S3 credentials (AWS_*/R2_*) are derived from it by
# scripts/with-r2-credentials.sh, so do not add them here. Run tofu or backups locally through the wrapper:
#   set -a && . ./.env.local && set +a && \
#     scripts/with-r2-credentials.sh mise exec -- tofu -chdir=infra plan
CLOUDFLARE_API_TOKEN=
# Cloudflare dashboard → Account home → Account ID.
CLOUDFLARE_ACCOUNT_ID=

# scripts/init-env.sh generates these three (`openssl rand -hex 32` each;
# README step 1.4). If you fill them by hand, use the same command. Store
# TOFU_ENCRYPTION_PASSPHRASE in a password manager: without it the OpenTofu
# state cannot be decrypted. OpenTofu reads it (and the account id) as
# TF_VAR_tofu_encryption_passphrase / TF_VAR_cloudflare_account_id; export
# those after sourcing this file (see the README).
ASSET_LINK_SECRET=
DB_SYNC_ADMIN_TOKEN=
TOFU_ENCRYPTION_PASSPHRASE=

# e.g. sync.example.com — the hostname your clients use. Required.
SYNC_HOSTNAME=

# Optional connector (README section 11). true turns it on for local tofu and deploy runs;
# false, empty or absent means off. GitHub Actions reads the CONNECTOR_ENABLED *variable*
# (not a secret) instead. Keep the two in step: a local tofu run with it off would plan to
# destroy the connector's KV namespace and D1 database, which prevent_destroy refuses.
CONNECTOR_ENABLED=false

# The connector's values. Only needed once you turn it on, and then every one of them is
# required. They are commented out so a fresh
# scripts/init-env.sh run leaves them alone; to add them to an existing .env.local run
# `scripts/init-env.sh --add-missing` (it appends the names this file lacks and never
# rewrites a line), or uncomment and fill them by hand.
# Hostname of the connector worker, e.g. mcp.example.com (bare hostname, never committed).
# CONNECTOR_HOSTNAME=
# Client ID and secret of the GitHub OAuth app that signs you in to the connector.
# GitHub forbids secret names starting with GITHUB_, so the production secrets are
# CONNECTOR_GITHUB_CLIENT_ID and CONNECTOR_GITHUB_CLIENT_SECRET (README 1.8).
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# Your numeric GitHub user id (not your login): only this account may use the connector.
# OWNER_GITHUB_USER_ID=
# 32 random bytes as 64 hex chars each (`openssl rand -hex 32`); init-env.sh generates them.
# Keep them in a password manager: GRAPH_TOKEN_KEY decrypts the graph tokens the connector stores.
# COOKIE_ENCRYPTION_KEY=
# GRAPH_TOKEN_KEY=

# Optional: a logseq_pat_ token for the authenticated smoke-test check. It is just
# whichever of your graph tokens the smoke test should use.
SMOKE_PAT=

# Optional: one PAT per graph, named PAT_<GRAPH> in upper snake case (README
# section 4). Example names only:
# PAT_JOURNAL=
# PAT_WORK=
