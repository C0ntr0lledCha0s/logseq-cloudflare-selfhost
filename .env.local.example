# Local secrets for running the deploy from your machine.
# Copy to .env.local (gitignored) and fill in the first two values:
#   cp .env.local.example .env.local && chmod 600 .env.local
# Never commit .env.local. GitHub Actions reads the same names from the
# `production` environment secrets instead.

# Cloudflare API token (Workers Admin, Workers Routes Write on the zone,
# D1 Write, Workers R2 Storage Write). It is the only credential: the R2 S3
# credentials (AWS_*/R2_*) are derived from it by scripts/with-r2-credentials.sh,
# so do not add them here. Run tofu or backups locally through the wrapper:
#   set -a && . ./.env.local && set +a && \
#     scripts/with-r2-credentials.sh mise exec -- tofu -chdir=infra plan
CLOUDFLARE_API_TOKEN=
# Cloudflare dashboard → Account home → Account ID.
CLOUDFLARE_ACCOUNT_ID=

# Generated during bootstrap with `openssl rand -hex 32`. Leave blank; they
# are filled in for you. Store TOFU_ENCRYPTION_PASSPHRASE in a password
# manager: without it the OpenTofu state cannot be decrypted.
ASSET_LINK_SECRET=
DB_SYNC_ADMIN_TOKEN=
TOFU_ENCRYPTION_PASSPHRASE=

# e.g. sync.example.com — the hostname your clients use. Required.
SYNC_HOSTNAME=

# Optional: a logseq_pat_ token for the authenticated smoke-test check.
SMOKE_PAT=
